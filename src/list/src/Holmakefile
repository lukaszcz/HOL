ifdef POLY
HOLHEAP = ../../num/termination/numheap
endif

EXTRA_CLEANS = selftest.exe list-selftest.log tracked-recipes.log \
  ../tests/tracked-recipes/selftest.exe ../tests/tracked-recipes/.hol/

all: $(DEFAULT_TARGETS) selftest.exe
.PHONY: all

selftest.exe: selftest.uo rich_listTheory.uo
	$(HOLMOSMLC) -o $@ $<

ifeq($(KERNELID),otknl)

all: $(patsubst %Script.sml,%.ot.art,$(wildcard *.sml))

list.art: list.otd

endif

.PHONY: tracked-recipes
tracked-recipes: listSimpsExt.uo
	$(tee $(HOLDIR)/bin/Holmake --no-project --no-cache -j1 \
	  -C ../tests/tracked-recipes check,tracked-recipes.log)

ifdef HOLSELFTESTLEVEL
all: list-selftest.log tracked-recipes

list-selftest.log: selftest.exe
	$(tee ./selftest.exe 2>&1, $@)

endif
