
structure minisatProve :> minisatProve =
struct

local

open Lib boolLib Globals Parse Term Type Thm Drule Conv Feedback FileSys
open dimacsTools satTools SatSolvers satCommonTools minisatParse satConfig
     dpll def_cnf


in

exception SAT_cex of thm
exception SAT_satisfiable of unit

val mk_sat_oracle_thm = mk_oracle_thm "HolSatLib";

val sat_warn = ref true (* control interactive warnings *)
val sat_limit = ref 100
  (* if > sat_limit clauses then interactive warning if using SML prover *)
val _ = register_btrace ("HolSatLib_warn",sat_warn);

val sat_profile = minisatResolve.sat_profile
val _ = register_btrace ("HolSatLib_profile", sat_profile)
fun profile_stage name action input =
    if !sat_profile then
      Profile.profile_with_exn_name ("HolSat(" ^ name ^ ")") action input
    else action input

fun sat_trace message =
    if OS.Process.getEnv "HOL4_SAT_TRACE" = SOME "1" then
      (Feedback.HOL_MESG ("HOL SAT: " ^ message);
       TextIO.flushOut TextIO.stdOut)
    else ()

fun warn ss =
    if !Globals.interactive andalso !sat_warn
    then print ("\nHolSat WARNING: "^ss^
                "\nTo turn off this warning, type: \
                \set_trace \"HolSatLib_warn\" 0; RET\n\n")
    else ()

fun fallback check_sat_model clauseth lfn ntm =
    satTools.observed_internal_solver (fn () =>
      if check_sat_model then DPLL_TAUT (dest_neg ntm)
      else case DPLL_REFUTE lfn clauseth of
          SOME th => th
        | NONE => raise SAT_satisfiable ())

fun replay_proof check_sat_model is_proved sva nr in_name solver vc
                 clauseth lfn ntm proof =
    if is_proved then
        ((case getSolverPostExe solver of (* post-process proof, if required *)
             SOME post_exe => let
               val (fin,fout) = (in_name,in_name^"."^(getSolverName solver))
             in
               ignore(SatProcess.system
                        (getSolverPostRun solver post_exe (fin,fout)))
             end
           | NONE => ());
        sat_trace "resolution replay start";
        (case profile_stage "certificate-replay"
                (replayProof sva nr in_name solver vc clauseth lfn) proof of
             SOME th => (sat_trace "resolution replay done"; th)
           | NONE => (warn "Proof replay failed. Using internal prover.";
                      fallback check_sat_model clauseth lfn ntm)))
                        (*triv prob/unknown err*)
    else mk_sat_oracle_thm([ntm],F)

local
    fun transform_model cnfv lfn model =
        let val model2 =
            if isSome cnfv then
                mapfilter (fn l => let val x = hd(free_vars l)
                                       val y = rbapply lfn x
                                   in if is_var y then subst [x|->y] l
                                      else failwith"" end) model
            else model
        in model2 end
in
fun invoke_solver solver lfn ntm clauseth cnfv vc is_proved
                  check_sat_model svm sva in_name =
    let val nr = Array.length clauseth
    in
      if access(getSolverExe solver,[A_EXEC]) then
        let
          val _ = sat_trace ("solver start clauses=" ^ int_to_string nr)
          val answer = profile_stage "solver"
            (invokeSat solver T (SOME vc) (SOME nr) svm sva) in_name
          val _ = sat_trace "solver done"
          val _ = sat_trace (case answer of
                               SOME _ => "solver result SAT"
                             | NONE => "solver result UNSAT")
        in case answer of
              SOME model => (* returns |- model ==> ~t *)
              let val _ = if is_proved andalso not check_sat_model then
                            raise SAT_satisfiable () else ()
                  val model' = transform_model cnfv lfn model
              in if is_proved then
                   profile_stage "model-check" (satCheck model') ntm
                 else mk_sat_oracle_thm([],mk_imp(list_mk_conj model',ntm)) end
            | NONE    => (* returns ~t |- F *)
                replay_proof check_sat_model is_proved sva nr in_name solver
                             vc clauseth lfn ntm NONE
        end
      else (* do not have execute access to solver binary, or it doesn't exist*)
        (if nr > !sat_limit then
           warn "SAT solver not found. Using slow internal prover."
         else ();
         fallback check_sat_model clauseth lfn ntm)
    end
end

(* cleanup temp files. this won't work fully if we cannot delete files
   generated by the SAT solver *)
fun cleanup_solver_files cleanup_trace solver infile tmpname in_name =
    if isSome infile then ()
    else
      let val solver_name = getSolverName solver in
        clean_files ((if cleanup_trace then ["resolve_trace"] else []) @ [
          in_name,                                          (* CNF *)
          tmpname,(* tmpfile(created by Poly/ML, but not MoscowML) *)
          in_name^"."^solver_name,                (* result/status *)
          in_name^"."^solver_name^".proof",               (* proof *)
          in_name^"."^solver_name^".stats"
        ])
      end
(* then raise exception if countermodel was found,
   else deduce input term from solver's result *)
fun finalise is_cnf th =
    let val res =
            if is_imp(concl th)
            then raise (SAT_cex th)
            else
                if is_cnf
                then (NOT_INTRO(DISCH_ALL th))
                else CONV_RULE NOT_NOT_CONV (NOT_INTRO(DISCH_ALL th))
     in res end

(* convert input to term to CNF and write out DIMACS file               *)
(* if infile is SOME name, then assume name.cnf exists and is_cnf=true  *)
(* if is_cnf, then assume tm \equiv ~s where s is in CNF                *)
(* if CNF conversion found true or false, return theorem directly       *)
exception initexp of thm;
fun initialise check_sat_model infile is_cnf tm =
    let
        fun prepare tm =
            let val (cnfv,vc,lfn,clauses) = to_cnf is_cnf tm
                (* The ordinary explicit-CNF entry historically uses the
                   zero-free-variable shortcut, even for T/F clauses.
                   Counting compound atoms must not change that contract.
                   Proof-only callers instead refute the prepared clauses. *)
                val vc = if check_sat_model andalso is_cnf andalso
                            null (free_vars tm) then 0 else vc
            in (cnfv,vc,lfn,clauses) end
        val (cnfv,vc,svm,sva,tmpname,in_name,ntm,lfn,clauseth) =
            (if isSome infile
             then let val fname = valOf infile
                      val (tm,svm,sva) = genReadDimacs fname
                      val (cnfv,vc,lfn,clauseth) =
                          profile_stage "cnf" prepare (mk_neg tm)
                  in (cnfv,vc,svm,sva,"",fname,mk_neg tm,lfn,clauseth) end
             else let val (cnfv,vc,lfn,clauseth) =
                          profile_stage "cnf" prepare (mk_neg tm)
                      val (tmpname,cnfname,sva,svm) =
                          profile_stage "dimacs"
                            (generateDimacs (SOME vc) tm (SOME clauseth))
                            (SOME (Array.length clauseth))
                  in (cnfv,vc,svm,sva,tmpname,cnfname,mk_neg tm,lfn,clauseth)
                  end)
            handle to_cnf_unsat nottm_thm =>
              (* nottm_thm : |- ~(~tm), peel double-negation to get |- tm *)
              raise initexp (CONV_RULE NOT_NOT_CONV nottm_thm)
    in if vc=0 then
         (* no vars: all 'presimp'-ified conjuncts were either T or F *)
           let val th0 = presimp_conv (dest_neg ntm)
           in if is_F (rhs (concl th0)) then raise SAT_cex (EQF_ELIM th0)
              else raise initexp (EQT_ELIM th0)
           end
       else
         (cnfv,vc,svm,sva,tmpname,in_name,ntm,lfn,clauseth)
    end

val dbg_show_input = ref false;

fun GEN_SAT_WITH check_sat_model conf =
    let val (tm,solver,infile,proof,is_cnf,is_proved) = dest_config conf
        val _ = if !dbg_show_input then (print "\n"; print_term tm; print "\n")
                else ()
        (* ZChaff's fixed-name output is eligible for cleanup only if it
           did not exist before this invocation's callbacks/solver/replay.
           isLink checks the directory entry, including dangling symlinks.
           Ambiguous filesystem errors must not authorize deletion.  Keep
           this local: nested calls must not acquire an outer call's file. *)
        val cleanup_trace = not (isSome infile) andalso
          getSolverName solver = "zchaff" andalso
          ((ignore (isLink "resolve_trace"); false)
           handle OS.SysErr (_, SOME code) =>
                    OS.syserror "ENOENT" = SOME code
                | OS.SysErr _ => false)
        val _ = sat_trace "CNF start"
        val (cnfv,vc,svm,sva,tmpname,in_name,ntm,lfn,clauseth) =
            profile_stage "initialise"
              (initialise check_sat_model infile is_cnf) tm
    in with_cleanup
         (fn () => cleanup_solver_files cleanup_trace solver infile
                                        tmpname in_name)
         (fn () =>
           let
             val _ = sat_trace ("CNF done variables=" ^ int_to_string vc ^
                                " clauses=" ^
                                int_to_string (Array.length clauseth))
             val th = if isSome proof
                      then replay_proof check_sat_model is_proved sva
                             (Array.length clauseth) in_name solver vc
                             clauseth lfn ntm proof
                      else invoke_solver solver lfn ntm clauseth cnfv vc
                             is_proved check_sat_model svm sva in_name
             val res = profile_stage "finalise" (finalise is_cnf) th
             val _ = sat_trace "finalise done"
           in res end) ()
    end
    handle initexp th => th

fun GEN_SAT conf = GEN_SAT_WITH true conf
fun GEN_SAT_PROVE_ONLY conf =
    let
      val checked = set_flag_is_proved true conf
      val th = GEN_SAT_WITH false checked
      (* Unlike the legacy entry, proof-only clients accept only the requested
         closed endpoint, never a partial refutation with residual literals.
         File input replaces the configured term and denotes a CNF problem. *)
      val expected = case get_infile checked of
          NONE => if get_flag_is_cnf checked then mk_neg (get_term checked)
                  else get_term checked
        | SOME name => mk_neg (#1 (genReadDimacs name))
      val (oracles, axioms) = Tag.dest_tag (tag th)
      val _ = null (hyp th) andalso aconv (concl th) expected andalso
        null axioms andalso List.all (fn s => s = "DISK_THM") oracles
        orelse raise mk_HOL_ERR "minisatProve" "GEN_SAT_PROVE_ONLY"
          "checked refutation endpoint/hypotheses/tags mismatch"
    in th end
    handle SAT_cex _ => raise SAT_satisfiable ()

(* default config invokes pre-installed MiniSat 1.14p *)
fun SAT_PROVE tm = GEN_SAT (set_term tm base_config)
fun SAT_PROVE_ONLY tm = GEN_SAT_PROVE_ONLY (set_term tm base_config)
fun SAT_ORACLE tm =
    GEN_SAT ((set_term tm o set_flag_is_proved false) base_config)

(* same functionality for ZChaff, if installed by user *)
val zchaff_config = set_solver zchaff base_config
fun ZSAT_PROVE tm = GEN_SAT (set_term tm zchaff_config)
fun ZSAT_ORACLE tm =
    GEN_SAT ((set_term tm o set_flag_is_proved false) zchaff_config)

end
end
