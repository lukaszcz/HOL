# The Python driver builds/executes private selftest fixtures with hol.state0.
# No production products are built by this directory's targets.
.PHONY: check python-tests

python-tests:
	python3 -B -m unittest discover -s . -p 'test_*.py'
	python3 -B -m unittest discover -s routes -p 'test_*.py'

# A convenience smoke check. Use run_fragments.py --output for kept output.
check:
	tmp=$$(mktemp -d); trap 'rm -rf "$$tmp"' EXIT HUP INT TERM; \
	  python3 -B run_fragments.py --require-baseline-graphs \
	    --output "$$tmp/evidence" && \
	  python3 -B routes/run_routes.py --output "$$tmp/routes"
