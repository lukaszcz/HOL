  "externals": {
    "loading_timing": {
      "status": "runnable_external", "gate_owner": "TASK28, TASK31, TASK33",
      "reason": "Fresh first-import loading.py measures each ordinary library with raw CPU/wall/GC, two calibration pilots and 40 AB/BA pairs of 5 fresh imports, baseline controls and candidate semantic audit binding. Isolated-source timing is not independent loading acceptance; the latter requires clean snapshots.",
      "commands": ["python3 src/simp/tests/performance/loading.py --baseline cccaa27d7099cbadc886983020cbe745db7793f3 --candidate CANDIDATE --module simpLib --pairs 40 --reps 5 --api-audit API_AUDIT_RECEIPT --authorize-measurements --output FRESH_SIMP_LOADING", "python3 src/simp/tests/performance/loading.py --baseline cccaa27d7099cbadc886983020cbe745db7793f3 --candidate CANDIDATE --module congLib --pairs 40 --reps 5 --api-audit API_AUDIT_RECEIPT --authorize-measurements --output FRESH_CONG_LOADING"]
    },
    "loading_audit": {
      "status": "runnable_external", "gate_owner": "TASK28, TASK31, TASK33",
      "reason": "TASK27 already supplies eight fresh-process ordinary load/order scenarios, actual requested/used/loaded paths, callback and exact extension-absence assertions. Rerun it against current sources; a missing fresh receipt is not a missing fixture. This is semantic loading coverage, NOT per-import startup timing or an independent performance acceptance receipt.",
      "commands": ["env API_AUDIT_OUTPUT=FRESH_API_AUDIT_OUTPUT sh src/simp/tests/compatibility/tools/root-wrapper.sh bin/Holmake -C src/simp/tests/api-audit check"]
    },
    "extension_consumer": {
      "status": "runnable_external", "gate_owner": "TASK28, TASK32",
      "reason": "The isolated TASK25 driver and sealed migration patch exist and can validate the final candidate without editing the caller-owned worktree. A new run is required, not a new fixture. This semantic consumer check does not itself supply paired independent-build proof-performance acceptance.",
      "commands": ["python3 src/simp/tests/compatibility/run_task25_consumer.py --consumer-patch src/simp/tests/compatibility/consumer/consumer.patch --simplifier-revision CANDIDATE --output FRESH_CONSUMER_OUTPUT"]
    },
    "independent_build_mode": {
      "status": "runnable_external", "gate_owner": "TASK28, TASK32, TASK33",
      "reason": "The manifest verifier is runnable machinery. It must reject absent or invalid independent build manifests; shared-source attribution never substitutes for clean-build evidence. Actual independent clean snapshot prerequisites remain blocked at the downstream build gates.",
      "commands": ["python3 src/simp/tests/performance/acceptance.py verify-builds BUILD_MANIFEST --candidate CANDIDATE"]
    },
    "extension_suite": {
      "status": "runnable_external", "gate_owner": "TASK28, TASK35, TASK36",
      "reason": "Normal-level extension suites and the strict post-list native suite already exist and remain enabled. Execute them externally to ordinary performance processes. Missing fresh receipts are unmeasured gates, not missing implementation prerequisites and never permission to disable extensions.",
      "commands": ["bin/Holmake --holstate=$PWD/bin/hol.state0 -C src/simp/src -j1 HOLSELFTESTLEVEL=1 all", "bin/Holmake --holstate=$PWD/bin/hol.state0 -C src/simp/tests/native-extension -j1 check-full", "bin/build -t --seq=tools/sequences/upto-parallel", "bin/build -t -F"]
    }
  },
  "blockers": {
    "allocation_prerequisite": {
      "status": "blocked", "gate_owner": "TASK29, TASK33",
      "reason": "Poly/ML 5.9.2 Statistics exposes allocation-area capacity/free space updated by GC, NOT cumulative allocated bytes. This runtime supplies no exact cumulative allocation counter. Reachable words, GC time and the recorded heap snapshots cannot establish cumulative allocation; native reservation-site auditing remains a separate available structural check. A supported counter or version-pinned allocator instrument is the prerequisite, not a missing benchmark row.",
      "commands": ["poly --version", "python3 src/simp/tests/performance/acceptance.py controls --output FRESH_CONTROL_OUTPUT"]
    },
    "rss_prerequisite": {
      "status": "blocked", "gate_owner": "TASK33",
      "reason": "RuntimeMetrics records per-batch Linux VmRSS/VmHWM snapshots and HWM increases, with actual GC counters, before verification. VmHWM includes process startup/loading and all prior batches; it is not an exact batch temporary peak. Exact per-operation peaks require an isolated high-water accounting domain on the independent clean-build processes. No such kernel/cgroup permission or supported runtime counter is established on this host; missing fields stay uncollected, not zero or pass.",
      "commands": ["python3 src/simp/tests/performance/acceptance.py verify-builds BUILD_MANIFEST --candidate CANDIDATE", "/usr/bin/time -v CLEAN_TREE/bin/Holmake -C src/simp/tests/performance -n"]
    },
    "lifetime_prerequisite": {
      "status": "blocked", "gate_owner": "TASK33",
      "reason": "RuntimeMetrics actually collects a controlled simpset REF after releasing its conversion wrapper, with live-holder/full-GC controls. Poly/ML Weak.weak accepts only ref values, not opaque simpsets: this probe cannot detect a global root retaining internal simpset/net objects after that wrapper dies. A supported opaque-object weak/finalizer API or independent runtime-live-heap/global-root accounting is prerequisite for that stronger gate; no unsafe casts or closure introspection are permitted.",
      "commands": ["python3 src/simp/tests/performance/runtime_metrics.py --output FRESH_RUNTIME_SMOKE", "python3 src/simp/tests/performance/acceptance.py verify-builds BUILD_MANIFEST --candidate CANDIDATE"]
    },
    "integer_prerequisite": {
      "status": "blocked", "gate_owner": "TASK32",
      "reason": "Shared sigobj exports contain no intReduce/intLib on this configured baseline environment. Local src/integer/.hol objects are candidate products, not independent baseline dependencies. Need exported independently rebuilt ordinary integer theories/libraries before compiling a real integer proof fixture.",
      "commands": ["BASELINE/bin/Holmake -C BASELINE/src/integer -j1 HOLSELFTESTLEVEL=1 all", "CANDIDATE/bin/Holmake -C CANDIDATE/src/integer -j1 HOLSELFTESTLEVEL=1 all"]
    },
    "real_prerequisite": {
      "status": "blocked", "gate_owner": "TASK32",
      "reason": "Shared sigobj exports contain no realSimps on this configured baseline environment. Existing candidate src/real/.hol products cannot be credited as baseline proof inputs. Need clean ordinary real theory/library exports on each side and a real-valued proof fixture.",
      "commands": ["BASELINE/bin/Holmake -C BASELINE/src/real -j1 HOLSELFTESTLEVEL=1 all", "CANDIDATE/bin/Holmake -C CANDIDATE/src/real -j1 HOLSELFTESTLEVEL=1 all"]
    },
    "independent_routine_prerequisite": {
      "status": "blocked", "gate_owner": "TASK32",
      "reason": "Shared-source fixture compilation is not a clean repository build. Need independently configured immutable baseline/candidate trees, matching toolchain/options, zero stale products, full command/output seals and build manifests before accepting routine timings.",
      "commands": ["BASELINE/bin/build -t --seq=tools/sequences/upto-parallel", "CANDIDATE/bin/build -t --seq=tools/sequences/upto-parallel"]
    },
    "independent_full_prerequisite": {
      "status": "blocked", "gate_owner": "TASK32, TASK36",
      "reason": "As for the routine gate, independent immutable baseline/candidate trees must first be configured with matching toolchains/options and no stale products; shared-source fixture environments are not full-build inputs. Run fresh paired full builds only in those trees. Bare bin/build can reuse a partial sequence, so -F is mandatory; historical receipts are not a substitute for this environment prerequisite.",
      "commands": ["BASELINE/bin/build -t -F", "CANDIDATE/bin/build -t -F"]
    }
  }
