# Machinery/diagnostic isolation only. No final acceptance is implied.
ifndef PERFORMANCE_OUTPUT
PERFORMANCE_OUTPUT = performance-results
endif
ifndef PERFORMANCE_CHECK_OUTPUT
PERFORMANCE_CHECK_OUTPUT = performance-check-results
endif
ifndef PERFORMANCE_BASELINE
PERFORMANCE_BASELINE = cccaa27d7099cbadc886983020cbe745db7793f3
endif
ifndef PERFORMANCE_CANDIDATE
PERFORMANCE_CANDIDATE = HEAD
endif
ifndef MATRIX_SMOKE_SCOPE
MATRIX_SMOKE_SCOPE = small
endif
.PHONY: python-tests diagnostic check matrix-completeness controls smoke
.PHONY: runtime-smoke client-smoke profiler-loss-control
python-tests:
	PYTHONDONTWRITEBYTECODE=1 python3 -B -m unittest discover \
	  -s . -p 'test*.py'
	PYTHONDONTWRITEBYTECODE=1 python3 -B -m unittest discover \
	  -s ../compatibility -p test_runner.py

matrix-completeness:
	python3 -B matrix_schema.py

controls:
	mkdir -p "$(PERFORMANCE_CHECK_OUTPUT)"
	python3 -B acceptance.py controls \
	  --output "$(PERFORMANCE_CHECK_OUTPUT)/controls.json"

# Exclusive-created JSON + sibling .log; never overwrite earlier evidence.
# These shared-heap smokes need a configured tree and an exclusive window.
smoke:
	python3 -B smoke_matrix.py --baseline $(PERFORMANCE_BASELINE) \
	  --candidate $(PERFORMANCE_CANDIDATE) --scope $(MATRIX_SMOKE_SCOPE) \
	  --output "$(PERFORMANCE_CHECK_OUTPUT)/matrix-smoke.json"

client-smoke:
	python3 -B smoke_clients.py --baseline $(PERFORMANCE_BASELINE) \
	  --candidate $(PERFORMANCE_CANDIDATE) --scope small \
	  --output "$(PERFORMANCE_CHECK_OUTPUT)/client-smoke.json"

runtime-smoke:
	python3 -B runtime_metrics.py --baseline $(PERFORMANCE_BASELINE) \
	  --candidate $(PERFORMANCE_CANDIDATE) \
	  --output "$(PERFORMANCE_CHECK_OUTPUT)/runtime-smoke.json"

# Explicit, binary-pinned private-ABI diagnostic; never run implicitly on
# other runtimes. This proves profiler information loss, NOT allocation parity.
profiler-loss-control:
	mkdir -p "$(PERFORMANCE_CHECK_OUTPUT)"
	python3 -B allocation_profiler_probe.py --authorize-runtime-probe \
	  --output "$(PERFORMANCE_CHECK_OUTPUT)/profiler-loss.json"

# Keep real controls before smoke even with a parallel caller. No acceptance
# run, loading experiment or costly full-grid/10000 AC pass is implicit.
check: python-tests
	python3 -B matrix_schema.py
	mkdir -p "$(PERFORMANCE_CHECK_OUTPUT)"
	python3 -B acceptance.py controls \
	  --output "$(PERFORMANCE_CHECK_OUTPUT)/controls.json"
	python3 -B smoke_matrix.py --baseline $(PERFORMANCE_BASELINE) \
	  --candidate $(PERFORMANCE_CANDIDATE) --scope $(MATRIX_SMOKE_SCOPE) \
	  --output "$(PERFORMANCE_CHECK_OUTPUT)/matrix-smoke.json"
	python3 -B smoke_clients.py --baseline $(PERFORMANCE_BASELINE) \
	  --candidate $(PERFORMANCE_CANDIDATE) --scope small \
	  --output "$(PERFORMANCE_CHECK_OUTPUT)/client-smoke.json"

# One recipe keeps baseline variability before reviewed observations even
# when invoked by a parallel caller. Never benchmark alongside other builds.
diagnostic: python-tests
	python3 -B ../compatibility/run_paired.py \
	  --candidate cccaa27d7099cbadc886983020cbe745db7793f3 \
	  --candidate-signature pass --candidate-behavior baseline \
	  --negative-controls --performance-pairs 6 --samples 5 \
	  --batch-seconds 0.25 --output $(PERFORMANCE_OUTPUT)/baseline-control
	python3 -B summarize.py $(PERFORMANCE_OUTPUT)/baseline-control \
	  --output $(PERFORMANCE_OUTPUT)/baseline-summary.json
	python3 -B ../compatibility/run_paired.py --negative-controls \
	  --performance-pairs 6 --samples 5 --batch-seconds 0.25 \
	  --output $(PERFORMANCE_OUTPUT)/reviewed
	python3 -B summarize.py $(PERFORMANCE_OUTPUT)/reviewed \
	  --output $(PERFORMANCE_OUTPUT)/reviewed-summary.json
