# The Python driver installs paired/Holmakefile into each private source tree.
# SignatureCheck.sml is derived there from the immutable complete ABI fixture.
ifndef PAIRED_OUTPUT
PAIRED_OUTPUT = paired-results
endif
.PHONY: check python-tests public-contracts public-baseline-control
python-tests:
	python3 -B -m unittest test_runner test_public_contracts

check: python-tests
	python3 -B run_paired.py --negative-controls --output $(PAIRED_OUTPUT)

# Diagnostic gates: expected reds are recorded, NOT source-compatibility passes.
public-contracts: python-tests
	python3 -B run_paired.py --public-contracts --negative-controls \
	  --candidate HEAD --candidate-signature reject \
	  --candidate-behavior reviewed --output $(PAIRED_OUTPUT)

public-baseline-control: python-tests
	python3 -B run_paired.py --public-contracts --negative-controls \
	  --candidate cccaa27d7099cbadc886983020cbe745db7793f3 \
	  --candidate-signature pass --candidate-behavior baseline \
	  --output $(PAIRED_OUTPUT)
