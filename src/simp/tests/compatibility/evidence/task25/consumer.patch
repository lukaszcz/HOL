diff --git a/src/auto/clasimp/trackedAutoDefaults.sig b/src/auto/clasimp/trackedAutoDefaults.sig
new file mode 100644
index 0000000..78b90ab
--- /dev/null
+++ b/src/auto/clasimp/trackedAutoDefaults.sig
@@ -0,0 +1,50 @@
+signature trackedAutoDefaults =
+sig
+  (* Shared ordinary-policy tracked base, not clasimp's configured default.
+     No ordinary compiled simpset, update log or arbitrary transform is read.
+     The module's initial preparation uses the standard declaration program.
+     Further ordinary local/Proof updates must use this typed path explicitly. *)
+  val base : unit -> simpExtLib.simpset
+  val base_of : Context.t -> simpExtLib.simpset
+  val prepare : trackedSimpDefaults.recipe -> unit
+  val install : trackedSimpDefaults.provider -> Context.t -> Context.t
+
+  (* Explicit ambient declaration capture. theories is in installation order;
+     logged contains caller-supplied typed recipes at their named positions.
+     TypeBase is folded once after declarations and logged recipes. This is
+     a fresh preparation, NOT a mirror of ordinary local state or quotas. *)
+  val declaration_recipe :
+    {theories : string list,
+     logged : (string * trackedSimpDefaults.step list) list,
+     typebase : TypeBasePure.typeBase} -> trackedSimpDefaults.recipe
+
+  (* Consumer declaration inputs, captured at installation, not recovered
+     from compiled sets. Each callback updates this context-owned program
+     together with the provider. Ordinary/local updates are NOT mirrored. *)
+  val add_iff_declarations : string ->
+    (KernelSig.kernelname * Thm.thm) list -> unit
+  val remove_iff_declarations : string list -> unit
+  val declare_bottom_up : simpExtLib.ssfrag -> unit
+
+  (* Explicit fresh control seed: initial_seed, supplied declaration steps,
+     then retained iff/bottom-up inputs in installation order. Call before
+     binding sources or consuming quotas. Getters never run this program. *)
+  val prepare_declarations : trackedSimpDefaults.step list -> unit
+
+  val map_simpset : (simpExtLib.simpset -> simpExtLib.simpset) ->
+                    Context.t -> Context.t
+  val with_simpset_updates : (simpExtLib.simpset -> simpExtLib.simpset) ->
+                            ('a -> 'b) -> 'a -> 'b
+  val with_simpset_updates_tac :
+    (simpExtLib.simpset -> simpExtLib.simpset) ->
+    Abbrev.tactic -> Abbrev.tactic
+  val augment : simpExtLib.ssfrag list -> unit
+  val temp_addsimps : (KernelSig.kernelname * Thm.thm) list -> unit
+  val temp_delsimps : string list -> unit
+
+  (* Eager typed derivation on preparation/update, retrieval-only getters.
+     Provider and derived results travel together through Context.restore.
+     Register before capturing contexts that will use the new getter. *)
+  val make_derived_value : string -> (simpExtLib.simpset -> 'a) ->
+    {get : unit -> 'a, get_of : Context.t -> 'a}
+end
diff --git a/src/auto/clasimp/trackedAutoDefaults.sml b/src/auto/clasimp/trackedAutoDefaults.sml
new file mode 100644
index 0000000..082d662
--- /dev/null
+++ b/src/auto/clasimp/trackedAutoDefaults.sml
@@ -0,0 +1,192 @@
+(* Explicit declaration-input preparation, shared by clasimp and aesop.
+   BasicProvers remains wholly ordinary. No listeners, second simp owner,
+   compiled-set promotion, or first-get reconstruction is installed. *)
+structure trackedAutoDefaults :> trackedAutoDefaults =
+struct
+
+structure D = trackedSimpDefaults
+structure S = simpExtLib
+val ERR = Feedback.mk_HOL_ERR "trackedAutoDefaults"
+
+(* Only the consumer's explicit declaration callbacks populate this program.
+   Keep named iff ingredients before compilation, not fragments extracted
+   from a simpset (which would lose exclusions and actual control state).
+   Newest-first storage; replay below reverses it to installation order. *)
+datatype declaration =
+    IffFragment of string * (KernelSig.kernelname * Thm.thm) list
+  | RemoveIffs of string list
+  | BottomUpFragment of S.ssfrag
+val declaration_slot : declaration list Context.Data.slot = Context.Data.new
+  {name = "trackedAutoDefaults.declarations", empty = [],
+   pp = fn _ => "<tracked auto declaration inputs>"}
+
+fun declaration_steps (IffFragment (name, inputs)) =
+      [D.Fragment (S.named_rewrites_with_names name inputs)]
+  | declaration_steps (RemoveIffs names) =
+      map (D.LocalDelta o D.Remove) names
+  | declaration_steps (BottomUpFragment frag) = [D.Fragment frag]
+
+type derived = UniversalType.t Symtab.table
+val derived_slot : derived Context.Data.slot = Context.Data.new
+  {name = "trackedAutoDefaults.derived", empty = Symtab.empty,
+   pp = fn _ => "<tracked auto defaults>"}
+val derivers : (string * (S.simpset -> UniversalType.t)) list Sref.t =
+  Sref.new []
+
+fun require ctxt =
+  case D.get_of ctxt of
+      SOME provider => provider
+    | NONE => raise ERR "base_of" "Explicit tracked default is not prepared"
+fun base_of ctxt = D.value (require ctxt)
+fun base () = base_of (Context.snapshot ())
+
+fun derive ss = List.foldl
+  (fn ((name, f), table) => Symtab.update (name, f ss) table)
+  Symtab.empty (Sref.value derivers)
+
+fun install provider ctxt =
+  let val table = derive (D.value provider)
+  in Context.Data.put derived_slot table (D.install provider ctxt) end
+
+(* Prepare outside the context mutator: maker/deriver callbacks may read or
+   update unrelated context data. Commit provider and derived table together. *)
+fun prepare recipe =
+  let
+    val provider = D.build recipe
+    val table = derive (D.value provider)
+  in
+    Context.update (Context.Data.put derived_slot table o D.install provider)
+  end
+
+(* Deliberately fresh, and only at the caller's explicit preparation point.
+   In particular, do not replay this program from base/base_of or install. *)
+fun prepare_declarations steps =
+  let
+    val inputs = Context.Data.get declaration_slot (Context.snapshot ())
+    val extras = List.concat (map declaration_steps (List.rev inputs))
+  in prepare (D.initial_recipe (steps @ extras)) end
+
+fun map_simpset f ctxt =
+  let
+    val old = require ctxt
+    val provider = D.map f old
+  in
+    if Portable.pointer_eq (D.value old, D.value provider) then ctxt
+    else install provider ctxt
+  end
+
+fun with_prepared ctxt body x =
+  let
+    val ss = base_of ctxt
+    val table = Context.Data.get derived_slot ctxt
+    val inputs = Context.Data.get declaration_slot ctxt
+  in
+    D.with_updates (fn _ => ss)
+      (Context.Data.with_slot_value declaration_slot inputs
+        (Context.Data.with_slot_value derived_slot table body)) x
+  end
+
+fun with_simpset_updates f body x =
+  with_prepared (map_simpset f (Context.snapshot ())) body x
+
+fun with_simpset_updates_tac f tac goal ctxt =
+  let val updated = map_simpset f ctxt
+  in with_prepared updated (fn c => tac goal c) updated end
+
+fun update f =
+  let
+    val ctxt = map_simpset f (Context.snapshot ())
+    val provider = require ctxt
+    val table = Context.Data.get derived_slot ctxt
+  in
+    Context.update (Context.Data.put derived_slot table o D.install provider)
+  end
+
+(* Install the very inputs captured here and commit them with the provider
+   and derived values. A context rewind restores all three, independently
+   of arbitrary map_simpset/augment/temp_* updates to the current set. *)
+fun declare input =
+  let
+    val ctxt = Context.snapshot ()
+    val provider = D.build
+      {seed = fn () => base_of ctxt, steps = declaration_steps input}
+    val table = derive (D.value provider)
+    val inputs = input :: Context.Data.get declaration_slot ctxt
+  in
+    Context.update
+      (Context.Data.put declaration_slot inputs o
+       Context.Data.put derived_slot table o D.install provider)
+  end
+
+fun add_iff_declarations name inputs = declare (IffFragment (name, inputs))
+fun remove_iff_declarations names = declare (RemoveIffs names)
+fun declare_bottom_up frag = declare (BottomUpFragment frag)
+
+fun augment frags = update
+  (fn ss => List.foldl (fn (frag, ss) => S.++ (ss, frag)) ss frags)
+fun temp_addsimps named = update
+  (fn ss => List.foldl
+    (fn (nth, ss) => S.++ (ss, S.add_named_rwt nth S.empty_ssfrag)) ss named)
+fun temp_delsimps names = update (fn ss => S.-* (ss, names))
+
+fun make_derived_value name f =
+  let
+    val _ = if List.exists (fn (n, _) => n = name) (Sref.value derivers)
+            then raise ERR "make_derived_value" ("Duplicate name: " ^ name)
+            else ()
+    val (inject, project) = UniversalType.embed ()
+    val packed = inject o f
+    val value = packed (base ())
+    val _ = Sref.update derivers (fn fs => fs @ [(name, packed)])
+    val _ = Context.Data.modify derived_slot (Symtab.update (name, value))
+    fun get_of ctxt =
+      case Symtab.lookup (Context.Data.get derived_slot ctxt) name of
+          SOME value => valOf (project value)
+        | NONE => raise ERR "make_derived_value"
+            ("Context predates tracked default registration: " ^ name)
+  in {get = fn () => get_of (Context.snapshot ()), get_of = get_of} end
+
+fun declaration_recipe {theories, logged, typebase} =
+  let
+    fun delta (ThmSetData.ADD nth) = D.Add nth
+      | delta (ThmSetData.REMOVE name) = D.Remove name
+    fun steps thy =
+      D.TheoryBatch (thy, map delta
+        (ThmSetData.theory_data {settype = "simp", thy = thy})) ::
+      List.concat (map #2 (List.filter (fn (name, _) => name = thy) logged))
+  in
+    D.initial_recipe (List.concat (map steps theories) @
+                      D.typebase_steps typebase)
+  end
+
+(* The explicit standard catalog used by this consumer. These are typed
+   declaration ingredients, not BasicProvers's opaque logged closures.
+   Keep optional numeric theories out of this module's dependencies:
+   importing their recipes loads their theories (and changes arithmetic
+   overload preferences) even when the caller has not requested them.
+   Integer/real/word/PMATCH defaults require a supplied declaration_recipe;
+   they are not claimed to be mirrored by this standard provider. *)
+val standard_logged =
+  [("numeral", map D.Fragment
+      [numSimpsExt.REDUCE_ss, numSimpsExt.ARITH_RWTS_ss,
+       numSimpsExt.MOD_ss]),
+   ("pred_set", map D.Fragment
+      [pred_setSimpsExt.SET_SPEC_ss, pred_setSimpsExt.GSPEC_SIMP_ss]),
+   ("list", [D.Fragment listSimpsExt.LIST_EQ_ss])]
+
+val _ =
+  case D.get_of (Context.snapshot ()) of
+      SOME _ => () (* Respect an explicitly supplied typed provider. *)
+    | NONE =>
+        let
+          val names = Theory.ancestry "-"
+          val graph = SymGraph.make
+            (map (fn thy => ((thy, ()), Theory.parents thy)) names)
+          val theories = List.rev (SymGraph.topological_order graph)
+        in
+          prepare (declaration_recipe
+            {theories = theories, logged = standard_logged,
+             typebase = TypeBase.theTypeBase ()})
+        end
+
+end
