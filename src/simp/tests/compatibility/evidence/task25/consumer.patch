+structure seedDefaults :> seedDefaults =
+struct
+
+structure D = trackedSimpDefaults
+
+(* Optional numeric recipes belong here, not in the pre-boss default module:
+   merely loading them imports theories and changes numeric overloads. *)
+val logged =
+  [("numeral", map D.Fragment
+      [numSimpsExt.REDUCE_ss, numSimpsExt.ARITH_RWTS_ss,
+       numSimpsExt.MOD_ss]),
+   ("pred_set", map D.Fragment
+      [pred_setSimpsExt.SET_SPEC_ss, pred_setSimpsExt.GSPEC_SIMP_ss]),
+   ("list", [D.Fragment listSimpsExt.LIST_EQ_ss]),
+   ("integer", [D.Fragment intReduceExt.INT_REDUCE_ss]),
+   ("real", map D.Fragment
+      [realSimpsExt.REAL_REDUCE_ss, realSimpsExt.RMULCANON_ss,
+       realSimpsExt.RMULRELNORM_ss])]
+
+fun prepare () =
+  let
+    val names = Theory.ancestry "-"
+    val graph = SymGraph.make
+      (map (fn thy => ((thy, ()), Theory.parents thy)) names)
+    val theories = List.rev (SymGraph.topological_order graph)
+    val {steps, ...} = trackedAutoDefaults.declaration_recipe
+      {theories = theories, logged = logged,
+       typebase = TypeBase.theTypeBase ()}
+    (* Explicit fresh control seed before any source/quota consumption.
+       Consumer iff and bottom-up declaration inputs are replayed LAST, so
+       parent simp batches cannot override the seed's iff normal forms.
+       No compiled simpset fragments or ordinary update history are read. *)
+  in
+    trackedAutoDefaults.prepare_declarations steps
+  end
+
+end
