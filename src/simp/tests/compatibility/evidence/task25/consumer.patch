index 0000000..ffc063b
--- /dev/null
+++ b/src/auto/clasimp/clasimpNumRecipes.sml
@@ -0,0 +1,85 @@
+(* Explicit tracked recipes for the two opt-in numSimps fragments used by
+   clasimp. numSimps does not expose its SUC filter callback, so reproduce
+   its theorem recipe, not a destructed/compiled ordinary fragment. *)
+structure clasimpNumRecipes :> clasimpNumRecipes =
+struct
+
+open HolKernel boolLib numSyntax
+
+val ARITH_AC_ss = simpExtLib.ac_ss
+  [(arithmeticTheory.ADD_SYM, arithmeticTheory.ADD_ASSOC),
+   (arithmeticTheory.MULT_SYM, arithmeticTheory.MULT_ASSOC)]
+
+val SUC_PRE = UNDISCH
+  (EQT_ELIM (Arith.ARITH_CONV ``0 < m ==> (SUC (PRE m) = m)``))
+
+fun mDISCH t th =
+  if is_eq (concl th) then DISCH t th
+  else
+    let
+      val ant = #1 (dest_imp (concl th))
+      val conjoined = ASSUME (mk_conj (t, ant))
+    in
+      DISCH_ALL (MP (MP (DISCH_ALL th) (CONJUNCT1 conjoined))
+                    (CONJUNCT2 conjoined))
+    end
+
+fun check_for_bads l r =
+  if is_eq l andalso is_eq r andalso is_suc (lhs l) andalso is_suc (rhs l)
+  then raise ERR "SUC_FILTER_ss" "Won't convert SUC-injectivity"
+  else if is_suc l then
+    raise ERR "SUC_FILTER_ss" "Won't convert direct SUC terms"
+  else ()
+
+and ERR function message =
+  Feedback.mk_HOL_ERR "clasimpNumRecipes" function message
+
+fun eliminate_single_SUC th =
+  let
+    val (_, w) = strip_imp (concl th)
+    val (l, r) = dest_eq w
+    val () = check_for_bads l r
+    val lsucs = find_terms (fn t => is_suc t andalso is_var (rand t)) l
+    fun is_v_sucless v t =
+      case dest_term t of
+          COMB (f, x) => if aconv x v then not (aconv f suc_tm)
+                         else is_v_sucless v f orelse is_v_sucless v x
+        | VAR _ => aconv t v
+        | LAMB (_, b) => free_in v t andalso is_v_sucless v b
+        | CONST _ => false
+    val v = rand (valOf (List.find (not o C is_v_sucless l o rand) lsucs))
+    val base_rewrite = INST [mk_var ("m", num) |-> v] SUC_PRE
+    val base_thm = INST [v |-> mk_pre v] th
+  in
+    mDISCH (mk_less (zero_tm, v))
+      (Rewrite.REWRITE_RULE [base_rewrite] base_thm)
+  end handle Option.Option =>
+    raise ERR "eliminate_single_SUC" "No applicable SUC term to eliminate"
+
+fun eliminate_SUCn th =
+  let
+    val (_, w) = strip_imp (concl th)
+    val (l, r) = dest_eq w
+    val () = check_for_bads l r
+    val lsucs = find_terms (fn t => is_suc t andalso is_var (rand t)) l
+    val v = rand (valOf (List.find (is_var o rand) lsucs))
+    val gv = genvar num
+    val asm = mk_eq (mk_suc v, gv)
+  in
+    mDISCH asm (Rewrite.REWRITE_RULE [ASSUME asm] th)
+  end handle Option.Option =>
+    raise ERR "eliminate_SUCn" "No applicable SUC term to eliminate"
+
+fun numfilter (th, bound) =
+  let
+    val newth = repeat eliminate_SUCn (repeat eliminate_single_SUC th)
+  in
+    if aconv (concl newth) (concl th) then [(th, bound)]
+    else [(th, bound), (newth, bound)]
+  end
+
+val SUC_FILTER_ss = simpExtLib.register_frag (simpExtLib.SSFRAG
+  {name = SOME "SUC_FILTER", convs = [], rewrs = [], congs = [],
+   filter = SOME numfilter, ac = [], dprocs = []})
+
+end
