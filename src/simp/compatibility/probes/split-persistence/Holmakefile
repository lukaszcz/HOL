HOLHEAP = $(HOLDIR)/bin/hol.state0
INCLUDES = ../../../src
EXTRA_CLEANS = selftest.exe

# Build dynamic controls, but link only the launcher into the clean heap.
selftest.exe: selftest.uo ../../../src/simpLib.uo ../../../src/boolSimps.uo
	$(HOLMOSMLC) -o $@ $<

SCENARIOS = parent child descendant owned foreign-attribute foreign-set
.PHONY: check
check: splitDescendantTheory.uo selftest.exe
	@status=0; for s in $(SCENARIOS); do \
	  SPLIT_PERSIST_SCENARIO=$$s ./selftest.exe || status=1; \
	done; exit $$status
