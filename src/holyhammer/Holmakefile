all: $(DEFAULT_TARGETS) hhConfig.uo hhProver.uo hhSlice.uo hhEval.uo selftest.exe \
     smoke.exe

hhProver.uo: hhProver.sml hhProver.ui hhConfig.uo

hhSlice.uo: hhSlice.sml hhSlice.ui hhConfig.uo hhProver.uo

hhEval.uo: hhEval.sml hhEval.ui hhConfig.uo hhProver.uo

holyHammer.uo: holyHammer.sml holyHammer.ui hhConfig.uo hhProver.uo

selftest.uo: selftest.sml hhConfig.uo hhProver.uo hhSlice.uo hhEval.uo \
             holyHammer.uo

smoke.uo: smoke.sml hhEval.uo
.PHONY: all

selftest.exe: selftest.uo
	$(HOLMOSMLC) -o $@ $<

smoke.exe: smoke.uo
	$(HOLMOSMLC) -o $@ $<

EXTRA_CLEANS = selftest.exe selftest.log smoke.exe

ifdef HOLSELFTESTLEVEL
all: selftest.log

selftest.log: selftest.exe
	./selftest.exe > $@ 2>&1

endif
