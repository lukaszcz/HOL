all: $(DEFAULT_TARGETS) hhConfig.uo hhProver.uo selftest.exe

hhProver.uo: hhProver.sml hhProver.ui hhConfig.uo

selftest.uo: selftest.sml hhConfig.uo hhProver.uo
.PHONY: all

selftest.exe: selftest.uo
	$(HOLMOSMLC) -o $@ $<

EXTRA_CLEANS = selftest.exe selftest.log

ifdef HOLSELFTESTLEVEL
all: selftest.log

selftest.log: selftest.exe
	./selftest.exe > $@ 2>&1

endif
