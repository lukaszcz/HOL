HOLHEAP = $(HOLDIR)/bin/hol.state0
INCLUDES = $(HOLDIR)/src/auto/rules \
           $(HOLDIR)/src/auto/classical \
           $(HOLDIR)/src/auto/blast \
           $(HOLDIR)/src/auto/linarith \
           $(HOLDIR)/src/simp/src

all: $(DEFAULT_TARGETS) selftest.exe
.PHONY: all

iffTestSupport.uo: clasimpLib.uo
selftest.uo: clasimpLib.uo iffTestSupport.uo

selftest.exe: selftest.uo clasimpLib.uo iffTestSupport.uo
	$(HOLMOSMLC) -o $@ $<

ifdef HOLSELFTESTLEVEL
all: clasimp-selftest.log

clasimp-selftest.log: selftest.exe
	$(tee ./selftest.exe 2>&1,$@)
endif

EXTRA_CLEANS = selftest.exe clasimp-selftest.log
