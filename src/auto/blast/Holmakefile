HOLHEAP = $(HOLDIR)/bin/hol.state0
INCLUDES = $(HOLDIR)/src/auto/rules $(HOLDIR)/src/auto/classical

all: $(DEFAULT_TARGETS) selftest.exe
.PHONY: all

selftest.uo: blastTerm.uo

selftest.exe: selftest.uo blastTerm.uo
	$(HOLMOSMLC) -o $@ $<

ifdef HOLSELFTESTLEVEL
all: blast-selftest.log

blast-selftest.log: selftest.exe
	$(tee ./selftest.exe 2>&1,$@)
endif

EXTRA_CLEANS = selftest.exe blast-selftest.log
