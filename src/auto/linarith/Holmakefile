HOLHEAP = $(HOLDIR)/bin/hol.state0
INCLUDES = $(HOLDIR)/src/auto/rules $(HOLDIR)/src/simp/src

all: $(DEFAULT_TARGETS) selftest.exe
.PHONY: all

linarithSeedTheory.uo: linarithData.uo
linarithNum.uo: linarithSeedTheory.uo
linarithReplay.uo: linarithNum.uo
selftest.uo: linarithReplay.uo

selftest.exe: selftest.uo
	$(HOLMOSMLC) -o $@ $<

ifdef HOLSELFTESTLEVEL
all: linarith-selftest.log

linarith-selftest.log: selftest.exe
	$(tee ./selftest.exe 2>&1,$@)
endif

EXTRA_CLEANS = selftest.exe linarith-selftest.log

ifeq ($(KERNELID),otknl)
all: $(patsubst %Script.sml,%.ot.art,$(wildcard *Script.sml))

endif
