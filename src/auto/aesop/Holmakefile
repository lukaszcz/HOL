HOLHEAP = $(HOLDIR)/bin/hol.state0
INCLUDES = $(HOLDIR)/src/auto/rules \
           $(HOLDIR)/src/auto/classical \
           $(HOLDIR)/src/auto/blast \
           $(HOLDIR)/src/auto/clasimp \
           $(HOLDIR)/src/simp/src

all: $(DEFAULT_TARGETS) selftest.exe
.PHONY: all

selftest.uo: aesopData.uo aesopRule.uo
aesopTree.uo: aesopRule.uo

selftest.uo: aesopTree.uo

selftest.exe: selftest.uo aesopData.uo aesopRule.uo aesopTree.uo
	$(HOLMOSMLC) -o $@ $<

ifdef HOLSELFTESTLEVEL
all: aesop-selftest.log

aesop-selftest.log: selftest.exe
	$(tee ./selftest.exe 2>&1,$@)
endif

EXTRA_CLEANS = selftest.exe aesop-selftest.log
