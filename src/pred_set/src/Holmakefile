ifdef POLY
HOLHEAP = ../../num/termination/numheap
endif

EXTRA_CLEANS = selftest.exe pred_set-selftest.log tracked-recipes.log \
  ../tests/tracked-recipes/selftest.exe ../tests/tracked-recipes/.hol/

all: $(DEFAULT_TARGETS) selftest.exe
.PHONY: all

selftest.exe: selftest.uo PFset_conv.uo pred_setTheory.uo
	$(HOLMOSMLC) -o $@ $<

ifeq ($(KERNELID),otknl)
all: $(patsubst %Script.sml,%.ot.art,$(wildcard *Script.sml))

endif

.PHONY: tracked-recipes
tracked-recipes: pred_setSimpsExt.uo
	$(tee $(HOLDIR)/bin/Holmake --no-project --no-cache -j1 \
	  -C ../tests/tracked-recipes check,tracked-recipes.log)

ifdef HOLSELFTESTLEVEL
all: pred_set-selftest.log tracked-recipes

pred_set-selftest.log: selftest.exe
	$(tee ./selftest.exe 2>&1, $@)
endif
