unsat
((set-logic QF_UF)
(proof
(let (($x28 (= c b)))
 (let ((@x29 (asserted $x28)))
 (let (($x36 (= d c)))
 (let (($x31 (= c d)))
 (let ((@x32 (asserted $x31)))
 (let ((@x41 (trans (mp @x32 (commutativity (= $x31 $x36)) $x36) @x29 (= d b))))
 (let (($x25 (= a b)))
 (let ((@x26 (asserted $x25)))
 (let ((@x48 (trans (monotonicity @x26 @x41 (= (= a d) (= b b))) (rewrite (= (= b b) true)) (= (= a d) true))))
 (let ((@x55 (trans (monotonicity @x48 (= (not (= a d)) (not true))) (rewrite (= (not true) false)) (= (not (= a d)) false))))
 (let (($x33 (= a d)))
 (let (($x34 (not $x33)))
 (let ((@x35 (asserted $x34)))
 (mp @x35 @x55 false))))))))))))))))
