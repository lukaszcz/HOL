(set-logic QF_BV)
(assert (not (and
  (= (bvshl #x01 #x00) #x01)
  (= (bvshl #x01 #x08) #x00)
  (= (bvshl #x01 #x09) #x00)
  (= (bvlshr #x80 #x00) #x80)
  (= (bvlshr #x80 #x08) #x00)
  (= (bvashr #x80 #x08) #xff)
  (= ((_ rotate_left 0) #x81) #x81)
  (= ((_ rotate_left 8) #x81) #x81)
  (= ((_ rotate_left 9) #x81) #x03)
  (= ((_ rotate_right 9) #x81) #xc0)
)))
(check-sat)
(get-proof)
(exit)
