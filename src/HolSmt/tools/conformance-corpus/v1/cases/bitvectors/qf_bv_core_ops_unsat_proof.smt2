(set-logic QF_BV)
(assert (not (and
  (= ((_ extract 7 0) (concat #x12 #x34)) #x34)
  (= (bvand #xaa #x0f) #x0a)
  (= (bvor #xa0 #x0f) #xaf)
  (= (bvxor #xaa #xff) #x55)
  (= (bvnot #x00) #xff)
  (= (bvneg #x01) #xff)
  (= (bvadd #x0f #x01) #x10)
  (= (bvsub #x10 #x01) #x0f)
  (= (bvmul #x10 #x10) #x00)
  (bvult #x01 #x02)
  (bvule #x02 #x02)
  (bvugt #x02 #x01)
  (bvuge #x02 #x02)
  (bvslt #xff #x00)
  (bvsle #xff #xff)
  (bvsgt #x01 #x00)
  (bvsge #x80 #x80)
)))
(check-sat)
(get-proof)
(exit)
