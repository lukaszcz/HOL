(set-logic ALL)
(declare-const xs (Seq Int))
(declare-const ys (Seq Int))
(declare-const s (Set Int))
(declare-const b (Bag Int))
(assert (and
  (= (seq.++ xs ys) xs)
  (= (seq.len xs) 0)
  (= (seq.extract xs 0 1) ys)
  (seq.contains xs ys)
  (set.member 1 (set.insert 1 s))
  (set.subset (set.union s s) (set.intersect s s))
  (set.subset (set.minus s s) s)
  (= (bag.count 1 (bag.union_disjoint b b)) 0)
  (= (bag.count 1 (bag.union_max b b)) 0)
  (= (bag.count 1 (bag.inter_min b b)) 0)
  (= (bag.count 1 (bag.difference_subtract b b)) 0)
))
(exit)
