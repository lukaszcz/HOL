(set-logic QF_SLIA)
(declare-const s String)
(declare-const t String)
(assert (and
  (= (str.++ s t) s)
  (= (str.len s) 0)
  (str.< s t)
  (str.<= s t)
  (= (str.at s 0) t)
  (= (str.substr s 0 1) t)
  (str.prefixof s t)
  (str.suffixof s t)
  (str.contains s t)
  (= (str.indexof s t 0) 0)
  (= (str.replace s t (str.from_code 65)) s)
  (= (str.replace_all s t (str.from_int 7)) s)
  (str.is_digit s)
  (= (str.to_code s) 65)
  (= (str.to_int s) 7)
  (str.in_re s (str.to_re t))
  (str.in_re s (re.++ (str.to_re s) (str.to_re t)))
  (str.in_re s (re.* (str.to_re t)))
  (str.in_re s (re.+ (str.to_re t)))
  (str.in_re s (re.opt (str.to_re t)))
  (str.in_re s (re.union (str.to_re s) re.allchar))
  (str.in_re s (re.inter re.all re.allchar))
  (str.in_re s (re.diff re.all re.none))
  (str.in_re s (re.range s t))
  (str.in_re s ((_ re.^ 2) (str.to_re t)))
  (str.in_re s ((_ re.loop 1 3) (re.union (str.to_re s) re.allchar)))
  (= (str.replace_re s (str.to_re t) s) s)
  (= (str.replace_re_all s (str.to_re t) s) s)
))
(exit)
