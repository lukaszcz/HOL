(set-logic QF_FP)
(declare-const h Float16)
(declare-const a Float32)
(declare-const b Float32)
(declare-const d Float64)
(declare-const q Float128)
(assert (and
  (= (fp.add RNE a b) a)
  (= (fp.sub RTZ a b) b)
  (= (fp.mul RTP a b) a)
  (= (fp.div RTN a b) b)
  (= (fp.fma RNA a b a) b)
  (= (fp.sqrt RTP a) b)
  (= (fp.roundToIntegral RTZ a) a)
  (= (fp.rem a b) a)
  (= (fp.min a b) a)
  (= (fp.max a b) b)
  (= (fp.abs (fp.neg a)) a)
  (fp.leq a b)
  (fp.lt a b)
  (fp.geq b a)
  (fp.gt b a)
  (fp.eq (_ +zero 8 24) (_ -zero 8 24))
  (fp.isZero (_ +zero 8 24))
  (fp.isInfinite (_ +oo 11 53))
  (fp.isInfinite (_ -oo 15 113))
  (fp.isNaN (_ NaN 5 11))
  (fp.isNormal a)
  (fp.isSubnormal a)
  (fp.isNegative a)
  (fp.isPositive a)
  (= (fp #b0 #x00 #b00000000000000000000000) a)
  (= ((_ to_fp 8 24) RNE #x00000000) a)
  (= ((_ to_fp_unsigned 8 24) RNE #x00000000) a)
  (= ((_ fp.to_ubv 8) a) #x00)
  (= ((_ fp.to_sbv 8) a) #x00)
  (= (fp.to_real a) 0.0)
  (= h h)
  (= d d)
  (= q q)
))
(exit)
