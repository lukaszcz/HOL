(set-logic QF_BV)
(declare-const w1 (_ BitVec 1))
(declare-const w2 (_ BitVec 2))
(declare-const w3 (_ BitVec 3))
(declare-const w4 (_ BitVec 4))
(declare-const w8 (_ BitVec 8))
(declare-const w16 (_ BitVec 16))
(declare-const w32 (_ BitVec 32))
(declare-const w64 (_ BitVec 64))
(declare-const w128 (_ BitVec 128))
(assert (= w1 w1))
(assert (= w2 w2))
(assert (= w3 w3))
(assert (= w4 w4))
(assert (= w8 w8))
(assert (= w16 w16))
(assert (= w32 w32))
(assert (= w64 w64))
(assert (= w128 w128))
(assert (= (bvshl #x01 #x08) (bvshl #x01 #x08)))
(assert (= (bvlshr #x80 #x08) (bvlshr #x80 #x08)))
(assert (= (bvashr #x80 #x08) (bvashr #x80 #x08)))
(assert (= (bvudiv #xff #x00) (bvudiv #xff #x00)))
(assert (= (bvurem #xff #x00) (bvurem #xff #x00)))
(assert (= (bvsdiv #x80 #xff) (bvsdiv #x80 #xff)))
(assert (= (concat ((_ extract 7 4) #xab) ((_ extract 3 0) #xab)) #xab))
(assert (= ((_ repeat 2) #b10) #b1010))
(assert (= ((_ zero_extend 2) #b10) #b0010))
(assert (= ((_ sign_extend 2) #b10) #b1110))
(assert (= ((_ rotate_left 1) #b1001) #b0011))
(assert (= ((_ rotate_right 1) #b1001) #b1100))
(assert (= ((_ extract 0 0) #b1) #b1))
(check-sat)
