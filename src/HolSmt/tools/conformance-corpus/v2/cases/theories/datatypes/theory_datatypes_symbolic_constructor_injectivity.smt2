(set-option :produce-proofs true)
(set-logic ALL)
(declare-datatype List ((nil) (cons (head Int) (tail List))))
(declare-const x List)
(declare-const a Int)
(declare-const b Int)
(declare-const l List)
(assert (= (cons a l) (cons b l)))
(assert ((_ is cons) x))
(assert (not (= x (cons (head x) (tail x)))))
(check-sat)
(get-proof)
