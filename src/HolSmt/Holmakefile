INCLUDES = ../hol88 ../integer ../n-bit ../rational ../real ../real/analysis \
           ../res_quan/src ../sort ../string ../floating-point

all: $(DEFAULT_TARGETS) selftest.exe smtfloat-diff.exe
.PHONY: all
selftest.exe: selftest.uo
	$(HOLMOSMLC) -o $@ $<

smtfloat-diff.exe: smtfloat_diff_driver.uo
	$(HOLMOSMLC) -o $@ $<

ifdef HOLSELFTESTLEVEL
ifdef HOL4_SELFTEST_SHARD
HOLSMT_SELFTEST_SHARDS = $(HOL4_SELFTEST_SHARD)
else
HOLSMT_SELFTEST_SHARDS = 0/8 1/8 2/8 3/8 4/8 5/8 6/8 7/8
endif

HOLSMT_SELFTEST_LOGS = $(patsubst %,holsmt-selftest-%.log,\
  $(subst /,-,$(HOLSMT_SELFTEST_SHARDS)))

# The shards are memory-heavy. Keep their individual logs, but chain the
# full matrix so a parallel jobserver cannot run multiple heaps at once.
# Poly/ML's direct runner interprets this configurable cap in MiB.
ifndef HOLSMT_SELFTEST_MAXHEAP
HOLSMT_SELFTEST_MAXHEAP = 2800
endif
holsmt-selftest-1-8.log: holsmt-selftest-0-8.log
holsmt-selftest-2-8.log: holsmt-selftest-1-8.log
holsmt-selftest-3-8.log: holsmt-selftest-2-8.log
holsmt-selftest-4-8.log: holsmt-selftest-3-8.log
holsmt-selftest-5-8.log: holsmt-selftest-4-8.log
holsmt-selftest-6-8.log: holsmt-selftest-5-8.log
holsmt-selftest-7-8.log: holsmt-selftest-6-8.log

all: $(HOLSMT_SELFTEST_LOGS)

ifdef POLY
holsmt-selftest-%.log: selftest.uo smtheap
	$(tee HOL4_SELFTEST_SHARD=$(subst -,/,$*) $(HOLDIR)/bin/hol \
	  --gcthreads=1 --maxheap $(HOLSMT_SELFTEST_MAXHEAP) run \
	  --holstate=$(HOLHEAP) selftest 2>&1,$@)
else
holsmt-selftest-%.log: selftest.exe
	$(tee HOL4_SELFTEST_SHARD=$(subst -,/,$*) ./selftest.exe 2>&1,$@)
endif
endif

EXTRA_CLEANS = selftest.exe smtfloat-diff.exe holsmt-selftest.log \
               $(wildcard holsmt-selftest-*.log)

ifdef HOLBUILD
all: link-to-sigobj
.PHONY: link-to-sigobj
link-to-sigobj: $(DEFAULT_TARGETS)
	$(HOL_LNSIGOBJ)
endif

# Build an smtheap
ifdef POLY
HOLHEAP = smtheap
EXTRA_CLEANS += $(HOLHEAP)

SMT_DEPS = integer/intLib n-bit/blastLib rational/ratTheory

BARE_DEPS = $(patsubst %,../%,$(SMT_DEPS))

DEPS = $(patsubst %,%.uo,$(BARE_DEPS))

all: $(HOLHEAP) smtreplayheap selftest.exe

$(HOLHEAP): $(DEPS) $(dprot $(HOLDIR)/src/real/analysis/realheap)
	$(protect $(HOLDIR)/bin/hol) buildheap $(DEBUG_FLAG) -o $@ \
		-b $(protect $(HOLDIR)/src/real/analysis/realheap) $(BARE_DEPS)

# Repeated proof-driver invocations share the compiled replay libraries.
# Keep solver entry points out: executable/version detection must happen in
# the calling process, not when this reusable heap is built.
REPLAY_DEPS = Z3_ProofReplay CPC_ProofReplay SmtLib_Parser
REPLAY_OBJECTS = $(patsubst %,%.uo,$(REPLAY_DEPS))
EXTRA_CLEANS += smtreplayheap
smtreplayheap: $(HOLHEAP) $(REPLAY_OBJECTS)
	$(protect $(HOLDIR)/bin/hol) buildheap $(DEBUG_FLAG) -o $@ \
		-b $(protect $(HOLHEAP)) $(REPLAY_DEPS)
endif
