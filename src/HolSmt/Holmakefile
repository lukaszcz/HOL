holsmt-selftest-7-8.log: holsmt-selftest-6-8.log

all: $(HOLSMT_SELFTEST_LOGS)

ifdef POLY
# A .uo is a source-loading manifest on Poly/ML, not compiled ML code.
# Restore the own-build replay heap rather than compile it in every shard.
holsmt-selftest-%.log: selftest.uo smtreplayheap
	$(tee HOL4_SELFTEST_SHARD=$(subst -,/,$*) $(HOLDIR)/bin/hol \
	  --gcthreads=1 --maxheap $(HOLSMT_SELFTEST_MAXHEAP) run \
	  --holstate=smtreplayheap selftest 2>&1,$@)
else
holsmt-selftest-%.log: selftest.exe
	$(tee HOL4_SELFTEST_SHARD=$(subst -,/,$*) ./selftest.exe 2>&1,$@)
endif
endif

EXTRA_CLEANS = selftest.exe smtfloat-diff.exe holsmt-selftest.log \
               $(wildcard holsmt-selftest-*.log)

