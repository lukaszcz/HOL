INCLUDES = ../hol88 ../integer ../n-bit ../rational ../real ../real/analysis \
           ../res_quan/src ../sort ../string

all: $(DEFAULT_TARGETS) selftest.exe holsmt-typecheck holsmt-z3-tac
.PHONY: all
selftest.exe: selftest.uo
	$(HOLMOSMLC) -o $@ $<

holsmt-typecheck: typecheck_driver.uo
	printf '%s\n' \
	  '#!/bin/sh' \
	  'set -e' \
	  'if [ "$$#" -ne 2 ] && [ "$$#" -ne 3 ]; then' \
	  '  echo "Usage: $$0 <input.smt2> <logic> [--placeholder-datatypes]" >&2' \
	  '  exit 1' \
	  'fi' \
	  'if [ "$$#" -eq 3 ] && [ "$$3" != "--placeholder-datatypes" ]; then' \
	  '  echo "Usage: $$0 <input.smt2> <logic> [--placeholder-datatypes]" >&2' \
	  '  exit 1' \
	  'fi' \
	  'case "$$1" in' \
	  '  /*) input=$$1 ;;' \
	  '  *) input=$$(pwd)/$$1 ;;' \
	  'esac' \
	  'cd "$$(dirname "$$0")"' \
	  'if [ "$$#" -eq 3 ]; then' \
	  '  extra=$$(printf "%s\n%s\n%s" "$$input" "$$2" "$$3")' \
	  'else' \
	  '  extra=$$(printf "%s\n%s" "$$input" "$$2")' \
	  'fi' \
	  '$(HOLDIR)/bin/hol --gcthreads=1 run --holstate=$(HOLDIR)/src/HolSmt/smtheap --extra "$$extra" typecheck_driver' \
	  > $@
	chmod +x $@

holsmt-z3-tac: z3_tac_driver.uo
	printf '%s\n' \
	  '#!/bin/sh' \
	  'set -e' \
	  'if [ "$$#" -ne 2 ]; then' \
	  '  echo "Usage: $$0 <input.smt2> <logic>" >&2' \
	  '  exit 1' \
	  'fi' \
	  'case "$$1" in' \
	  '  /*) input=$$1 ;;' \
	  '  *) input=$$(pwd)/$$1 ;;' \
	  'esac' \
	  'cd "$$(dirname "$$0")"' \
	  'extra=$$(printf "%s\n%s" "$$input" "$$2")' \
	  'HOL4_Z3_EXECUTABLE=$${HOL4_Z3_EXECUTABLE:-$${Z3:-z3}} $(HOLDIR)/bin/hol --gcthreads=1 run --holstate=$(HOLDIR)/src/HolSmt/smtheap --extra "$$extra" z3_tac_driver' \
	  > $@
	chmod +x $@

ifdef HOLSELFTESTLEVEL
all: holsmt-selftest.log

holsmt-selftest.log: selftest.exe
	$(tee ./selftest.exe 2>&1,$@)
endif

EXTRA_CLEANS = selftest.exe holsmt-typecheck holsmt-z3-tac holsmt-selftest.log

ifdef HOLBUILD
all: link-to-sigobj
.PHONY: link-to-sigobj
link-to-sigobj: $(DEFAULT_TARGETS)
	$(HOL_LNSIGOBJ)
endif

# Build an smtheap
ifdef POLY
HOLHEAP = smtheap
EXTRA_CLEANS += $(HOLHEAP)

SMT_DEPS = integer/intLib n-bit/blastLib rational/ratTheory

BARE_DEPS = $(patsubst %,../%,$(SMT_DEPS))

DEPS = $(patsubst %,%.uo,$(BARE_DEPS))

all: $(HOLHEAP) selftest.exe holsmt-typecheck holsmt-z3-tac

$(HOLHEAP): $(DEPS) $(dprot $(HOLDIR)/src/real/analysis/realheap)
	$(protect $(HOLDIR)/bin/hol) buildheap $(DEBUG_FLAG) -o $@ \
		-b $(protect $(HOLDIR)/src/real/analysis/realheap) $(BARE_DEPS)
endif
