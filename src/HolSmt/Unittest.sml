        \(= (implies a b) (or na b)))))",
      ``((a:bool) ==> b) = (na \/ b)``),
    ("nnf-neg and",
      "((declare-fun a () Bool) (declare-fun b () Bool) \
        \(declare-fun na () Bool) (declare-fun nb () Bool) \
        \(proof (nnf-neg (asserted (= (not a) na)) \
        \(asserted (= (not b) nb)) \
