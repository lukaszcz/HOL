      "((declare-fun a () Bool) \
        \(proof (nnf-pos (asserted (= a a)) (= a a))))",
      ``(a:bool) = a``),
    ("nnf-pos implication premise congruence",
      "((declare-fun a () Bool) (declare-fun b () Bool) \
        \(declare-fun na () Bool) \
