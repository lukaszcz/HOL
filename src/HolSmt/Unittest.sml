  val declarations =
    "(declare-const x (_ FloatingPoint 3 5)) " ^
    "(declare-const y (_ FloatingPoint 3 5)) " ^
    "(declare-const z (_ FloatingPoint 3 5)) "
  val cases = [
    ("fp.div", "(fp.div roundNearestTiesToEven x y)"),
    ("fp.fma", "(fp.fma roundNearestTiesToEven x y z)"),
