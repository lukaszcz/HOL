    "NIA", "NRA", "UF", "UFBV", "UFBVDT", "UFIDL", "UFDT",
    "UFDTLIA", "UFDTLIRA", "UFDTNIA", "UFDTNIRA", "UFLIA", "UFLRA",
    "UFNIA", "UFNRA",
    "QF_ABV", "QF_ALIA", "QF_ALRA", "QF_ANIA", "QF_ANRA",
    "QF_AUFBV", "QF_AUFLIA", "QF_AUFLIRA", "QF_AUFNIA",
    "QF_AUFNIRA", "QF_AX", "QF_BV", "QF_DT", "QF_IDL", "QF_LIA",
