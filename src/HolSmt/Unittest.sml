      ``~((a:bool) /\ b) = (na \/ nb)``),
    ("nnf-neg or",
      "((declare-fun a () Bool) (declare-fun b () Bool) \
        \(declare-fun na () Bool) (declare-fun nb () Bool) \
        \(proof (nnf-neg (asserted (= (not a) na)) \
        \(asserted (= (not b) nb)) \
        \(= (not (or a b)) (and na nb)))))",
      ``~((a:bool) \/ b) = (na /\ nb)``),
    ("nnf-neg implication",
      "((declare-fun a () Bool) (declare-fun b () Bool) \
        \(declare-fun nb () Bool) \
        \(proof (nnf-neg (asserted (= (not b) nb)) \
        \(= (not (implies a b)) (and a nb)))))",
      ``~((a:bool) ==> b) = (a /\ nb)``),
    ("nnf-neg forall",
      "((proof (nnf-neg \
