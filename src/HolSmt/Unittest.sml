      ``~(!x:bool. F) = (?x:bool. T)``),
    ("nnf-neg exists",
      "((proof (nnf-neg \
        \(= (not (exists ((x Bool)) true)) \
        \(forall ((x Bool)) false)))))",
      ``~(?x:bool. T) = (!x:bool. F)``)
  ]
in
  List.app assert_nnf_replays_without_metis cases
end

