  fun run () =
    let
      val oracle_thm =
        Thm.mk_oracle_thm "HolSmtLib" ([], boolSyntax.T)
      (* The checked boundary must not inherit Sanity's mutable policy. *)
      val () = Sanity.accepted_oracles :=
        "HolSmtLib" :: !Sanity.accepted_oracles
