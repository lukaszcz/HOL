      val () = Profile.reset_all ()
      val thm =
        case Z3.Z3_SMT_Prover ([], goal) of
          SolverSpec.UNSAT (SOME thm) => thm
        | SolverSpec.UNSAT NONE =>
            die "FAIL: tiny symbolic add returned UNSAT without a theorem"
