  fun native_reference_with
      (limits:{input_limit:int,output_limit:int,template_limit:int})
      assumptions goal text=
    let
        (* This reference has its own genuine Sources and claims them
           exactly once. The separate Value fixture below owns another
           graph/Source/policy Work; no invocation is reborrowed. *)
        val graph=G.new()val scope=G.root_scope graph
        val sources=S.new graph scope 10000
          {assumptions=assumptions,goal=goal}
        val native_work=W.begin_with_scope_guard graph scope sources
          {limits=limits,work_limit=1000000000}
        val options:F.options=
          {graph=graph,scope=scope,logic="ALL",sources=bindings,
           sorts=Redblackmap.mkDict String.compare,binder_lists=[],
           import_limit=1000000,literal_limit=1000000,binder_limit=1,
           recipe_limits={template_limit=1000000,index_limit=1000000,
             operand_limit=1000000,token_limit=1000000},
           special=fn _=>fn _=>NONE,ascribed=fn _=>fn _=>fn _=>NONE}
        val stream=TextIO.openString text
        fun checked theorem=
          let val allowed=S.assumption_nodes sources
              (* prove_preprocessed_with_work_using already applies the
                 original Source.close_contradiction programme. It returns
                 the public Goal theorem, not its internal F theorem. *)
              val _=S.check_goal sources theorem
          in require "native Boolean changed original Goal/allowed Hyp"
            (Portable.pointer_eq(Thm.concl theorem,
                #2(S.original_goal sources))andalso
             null(Tag.axioms_of(Thm.tag theorem))andalso
             List.all(fn term=>List.exists(fn node=>Portable.pointer_eq
               (term,G.representative graph node))allowed)(Thm.hyp theorem))
          end
        val result=Exn.capture(fn()=>
          let val held=C.parse_graph_packet_with_version options
                (SmtLib_Logics.parsedicts_of_logic "ALL")"1.3.4"stream
              val proof=Exn.capture(fn()=>
                let val preprocessing=GP.discover_from_sources
                      graph scope sources
                      {import_limit=1000000,revisit=false,
                       check_type=fn _=>(),conversion=fn _=>NONE}
                in CPC_GraphProofReplay.prove_preprocessed_with_work_using
                  native_work
                  {graph=graph,scope=scope,sources=sources,
                   preprocessing=preprocessing,
                   proof=SmtLib_GraphProof.proof held,
                   ordinary_limit= #input_limit limits,
                   template_limit= #template_limit limits,force_worker=NONE,
                   worker=fn _=>raise Fail "native Boolean fallback"}end)()
              val cleanup=Exn.capture(fn()=>SmtLib_GraphProof.close held)()
          in case proof of Exn.Exn primary=>raise primary
            | Exn.Res theorem=>(Exn.release cleanup;checked theorem)end)()
        val cleanup=Exn.capture(fn()=>
          (W.close native_work;TextIO.closeIn stream;
           G.close_scope graph scope))()
    in case result of Exn.Exn primary=>raise primary
      | Exn.Res answer=>(Exn.release cleanup;answer)end
