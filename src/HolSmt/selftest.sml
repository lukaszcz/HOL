                        val a=P.original_source (#work e) block (hd ports)
                        val b=P.original_source (#work e) block
                          (hd(tl ports))
                        val joined=P.derive_boolean (#work e) block
                          SmtReplayNamedContext.PolicyConjunction [a,b]
                        val proof=P.derive_boolean (#work e) block
                          SmtReplayNamedContext.PolicyConjunctLeft [joined]
                        val input=P.realization_input_for (#work e) block proof
                        val saved=P.realization_input_data_for (#work e) input
                        val formal= #formal_sources saved
                        val _=require "duplicate formal Source slot collapsed"
                          (length ports=2 andalso Vector.length formal=3
                           andalso #dependencies saved=[1,2] andalso
                           original_tag 0 (#lineage(Vector.sub(formal,1)))
                           andalso original_tag 0
                             (#lineage(Vector.sub(formal,2))))
                    in input end)
                  val (proof,tags,current)=finish e input
                  val goal=S.close_contradiction (#sources e) proof
                  val _=S.check_goal (#sources e) goal
                  val source=G.representative (#graph e)
                    (hd(S.assumption_nodes (#sources e)))
                  val denied=G.representative (#graph e)
                    (S.denied_goal_node (#sources e))
                  fun has term=List.exists
                    (fn actual=>Portable.pointer_eq(actual,term))
                    (Thm.hyp proof)
              in require "native Hyp dedup erased original occurrence tags"
                (length(Thm.hyp proof)=2 andalso has source andalso
                 has denied andalso length(Thm.hyp goal)=1 andalso
                 Term.aconv (hd(Thm.hyp goal)) boolSyntax.F andalso
                 length tags=2 andalso List.all (original_tag 0) tags
                 andalso null current) end)
            end)))
      val _=test "Coincident current and original names retain original tag"
        (fn()=>fixture [boolSyntax.F] boolSyntax.F (fn e=>
          with_packet e "((proof (hypothesis false)))" (fn held=>fn data=>
            let val assertions=graph_assertions e data
                val value=hd assertions
            in direct e held data [(0,value)] (fn block=>
              let val input=original_input e block 0
                  val no_current=W.with_step (#work e) (fn()=>
                    let val ports=P.original_source_ports_for (#work e) block
                        val edge=P.original_source (#work e) block (hd ports)
                    in null(P.source_dependencies_for (#work e) block edge)
                    end)
                  val (_,tags,current)=finish e input
              in require "equal syntax promoted original into current slot"
                (no_current andalso length tags=1 andalso
                 original_tag 0 (hd tags) andalso null current) end)
            end)))
      val _=test "Original denial retains its actual prefix position"
        (fn()=>fixture_with false [boolSyntax.F] boolSyntax.F (fn e=>
          with_packet e "((proof (hypothesis (not false))))"
            (fn held=>fn data=>
            let val value=parsed_root data
            in direct e held data [(1,value)] (fn block=>
              W.with_step (#work e) (fn()=>
                let val port=hd(P.original_source_ports_for (#work e) block)
                    val actual=P.original_source_data_for (#work e) port
                    val edge=P.original_source (#work e) block port
                    val input=P.realization_input_for (#work e) block edge
                    val saved=P.realization_input_data_for (#work e) input
                in require "denial index was reordered or used positive Goal"
                  (#index actual=1 andalso #node actual=
                    S.denied_goal_node (#sources e) andalso
                   #dependencies saved=[1] andalso
                   original_tag 1 (#lineage
                     (Vector.sub(#formal_sources saved,1)))) end)) end)))
      val _=test "Positive goal cannot be adopted as original denial"
        (fn()=>fixture_with false [] boolSyntax.T (fn e=>
          with_packet e "((proof (hypothesis true)))" (fn held=>fn data=>
            let val assertions=graph_assertions e data
                val prior= #total(Count.thm_count ())
                val rejected=refused (fn()=>ignore
                  (P.prepare_with_originals (#work e) (#query e) held
                    {assertions=assertions,originals=[(0,parsed_root data)],
                     roots=[],native_contract= #contract e,
                     check_type=fn _=>()}))
            in require "positive Source was accepted or caused inference"
              (rejected andalso #retired(W.audit_policy(#work e)) andalso
               #total(Count.thm_count ())=prior) end)))
      val _=test "Same printed private variable cannot adopt an original"
        (fn()=>fixture_with false [``original404:bool``] boolSyntax.F
          (fn e=>with_packet e "((proof (hypothesis false)))"
            (fn held=>fn data=>
            let val assertions=graph_assertions e data
                val value=W.with_step (#work e) (fn()=>
                  PV.variable (#context data) (#scope e) G.SolverFlexible
                    ``original404:bool``)
                val prior= #total(Count.thm_count ())
                val rejected=refused (fn()=>ignore
                  (P.prepare_with_originals (#work e) (#query e) held
                    {assertions=assertions,originals=[(0,value)],roots=[],
                     native_contract= #contract e,check_type=fn _=>()}))
            in require "free-ID mismatch was replaced by a spelling match"
              (rejected andalso #retired(W.audit_policy(#work e)) andalso
               #total(Count.thm_count ())=prior) end)))
      val _=test "Warmed original port checks owner and expiry before use"
        (fn()=>fixture_with false [boolSyntax.F] boolSyntax.F (fn e=>
          with_packet e "((proof (hypothesis false)))" (fn held=>fn data=>
            let val value=parsed_root data
            in direct e held data [(0,value)] (fn block=>
              let val port=W.with_step (#work e) (fn()=>
                    let val ports=P.original_source_ports_for (#work e) block
                        val port=hd ports
                        val _=P.original_source_data_for (#work e) port
                    in port end)
                  val _=fixture [] boolSyntax.F (fn foreign=>
                    require "foreign Work adopted a warmed original port"
                      (refused(fn()=>W.with_step (#work foreign) (fn()=>
                        ignore(P.original_source_data_for
                          (#work foreign) port))) andalso
                       #retired(W.audit_policy(#work foreign)) andalso
                       not(#retired(W.audit_policy(#work e)))))
                  val _=P.close block
                  val prior= #total(Count.thm_count ())
                  val rejected=refused(fn()=>W.with_step (#work e) (fn()=>
                    ignore(P.original_source_data_for (#work e) port)))
              in require "expired original port reached cached proof backing"
                (rejected andalso #total(Count.thm_count ())=prior) end)
            end)))
    in () end)
end

local
  structure G = SmtReplayGraph
  structure S = SmtReplaySource
  structure W = SmtReplayInvocationWork
  structure V = SmtLib_GraphSourcePortfolio
  structure GP = SmtLib_GraphPreprocess
  structure T = SmtLib_GraphTranslation
  structure MD = SmtLib_GraphDeclarationMetadata
  structure M = SmtLib_GraphParserMapping
  structure F = SmtLib_GraphFrontend
  structure PV = SmtLib_GraphParserValue
  structure VP = SmtLib_GraphValueProof
  structure Z = Z3_GraphProofParser
  structure ZV = Z3_GraphValueProofParser
  structure Receiver = Z3_OwnedValueNamedReplay
  structure P = SmtReplayOwnedValueProof
  structure NC = SmtReplayNativeContract
  structure RP = SmtReplayResourcePolicy
  type env = {graph:G.graph,scope:G.scope,sources:S.sources,work:W.portfolio,
    query:GP.graph_query,metadata:MD.metadata,contract:NC.contract}
  val cap = RP.AtMost 1000000000
  val native:NC.limits =
    {semantic_limits={input_limit=1000000,output_limit=1000000,
       template_limit=1000000},import_limit=1000000,
     type_work_limit=100000000}
  fun require message yes = if yes then () else raise Fail message
  fun test label action =
    ((Count.counting_thms true;testutils.tprint label;action ();
      Count.counting_thms false;testutils.OK ())
     handle primary=>(Count.counting_thms false;raise primary))
  fun refused action = (action ();false)
    handle Feedback.HOL_ERR _ => true
  fun fixture_with retain assumptions goal action =
    let
      val graph=G.new () val scope=G.root_scope graph
      val sources=S.new graph scope 10000
        {assumptions=assumptions,goal=goal}
      val work=W.begin_with_policy graph scope sources
        {limits={input_limit=cap,output_limit=cap,template_limit=cap},
         work_limit=cap}
      fun run () =
        let
          val contract=NC.capture work native
          val {assumptions,denied}=V.originals_with_policy work
          val validation=V.validate_portfolio_with_policy work
            {assumptions=if retain then assumptions else [],
             goal= #node (S.goal_source sources),
             denied=denied}
          val query=GP.prepare_query_with_policy work
            (GP.from_portfolio_with_policy work validation)
          fun open_view caller node=ignore
            (G.record_opened_view_with_policy graph caller
              (RP.AtMost 10000) node)
          val metadata=T.with_outbound_query_analysis_with_policy work query
            open_view (fn context=>SmtLib.outbound_with_backend_context
              {sequence_emission=false,set_backend=SmtLib.Z3Set,
               bag_backend=SmtLib.Z3ArrayBag,
               has_set_terms=false,has_bag_terms=false} (fn backend=>
              let
                val operations=
                  SmtLib_GraphCarrierOperations.make_with_datatypes context
                    {sequence_emission=false}
                    {term_to_string=fn _=>raise Fail "unexpected formatter"}
                val emission=SmtLib_GraphDispatcher.emit context
                  {operations=operations,regime=SmtLib.FirstOrder,
                   apply_operator=SmtLib.ApplyUnderscore,prefix="value405_",
                   roots=ListPair.zip
                     (List.tabulate (length (#assumptions context)+2,Lib.I),
                      #goal context :: #assumptions context @
                        [#denied context])}
              in SmtLib_GraphDeclarationMetadata.freeze context
                {graph=graph,scope=scope,regime=SmtLib.FirstOrder,
                 backend=backend,operations=operations,emission=emission}
              end))
        in action ({graph=graph,scope=scope,sources=sources,work=work,
          query=query,metadata=metadata,contract=contract}:env) end
      val outcome=Exn.capture run ()
      val cleanup=Exn.capture (fn()=>
        (W.close work;G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary=>raise primary
      | Exn.Res result=>(Exn.release cleanup;result) end
  fun options (e:env):F.value_options =
    {graph= #graph e,scope= #scope e,logic="ALL",sources=[],
     sorts=Redblackmap.mkDict String.compare,binder_lists=[],
     import_limit=cap,literal_limit=cap,binder_limit=RP.AtMost 1,
     recipe_limits={template_limit=cap,index_limit=cap,
       operand_limit=cap,token_limit=cap},
     special=fn _=>fn _=>NONE,ascribed=fn _=>fn _=>fn _=>NONE}
  fun input text =
    let val index=ref 0 in fn()=>
      if !index=String.size text then NONE else
        let val result=String.sub (text,!index)
        in index:= !index+1;SOME result end end
  fun packet (e:env) text =
    Z3_GraphValueProofParser.create_packet_with_policy_from_input
      (#work e) (#query e) (options e) (#metadata e) "4.15.3" (input text)
  fun rule (proof:ZV.proof) id =
    case Redblackmap.find (#steps proof,id) of Z.Rule value=>value
      | _=>raise Fail "expected actual parsed Rule"
  fun fixture assumptions goal=fixture_with true assumptions goal
  fun graph_assertions (e:env) (data:ZV.proof VP.contents) =
    let val current=GP.query_nodes_with_policy_for (#work e) (#query e)
    in W.with_step (#work e) (fn()=>
      let
        val context= #context data
        fun guard ()=(PV.validate context;
          G.validate_scope (#graph e) (#scope e))
        fun tick ()=(guard ();W.spend_policy (#work e) 1)
        fun compare (left,right)=(tick ();Int.compare (left,right))
        val memo=ref (Redblackmap.mkDict compare)
        (* The actual query supplies graph IDs. Copy App DATA with sharing;
           graph_leaf remains restricted to its genuine atomic contract.
           This fixture needs no native query term or binder conversion. *)
        fun copy node=
          let val _=tick () val syntax=G.view (#graph e) node
              val id=G.node_id node
          in case Redblackmap.peek (!memo,id) of
              SOME value=>(PV.usable context (#scope e) value;value)
            | NONE=>
                let val value=case syntax of
                        G.Variable _=>PV.graph_leaf context (#scope e) node
                      | G.Constant _=>PV.graph_leaf context (#scope e) node
                      | G.Application (left,right)=>
                          let val f=copy left val x=copy right
                          in PV.application context (#scope e) (f,x) end
                      | _=>raise Fail "fixture Source needs binder programme"
                    val _=PV.usable context (#scope e) value
                    val _=tick ()
                    val _=memo:=Redblackmap.insert (!memo,id,value)
                in value end
          end
        fun copies []=(guard ();[])
          | copies (node::rest)=(tick ();copy node::copies rest)
      in copies (#assumptions current @ [#denied current]) end)
    end
  (* Referenced current Sources use their actual parsed endpoint object.
     Only absent assertion prototypes (the unused denial here) use copying.
     This isolates Clause's native boundary from prior Source transport. *)
  fun asserted_values (e:env) (data:ZV.proof VP.contents) =
    let val current=GP.query_nodes_with_policy_for(#work e)(#query e)
        val fallback=graph_assertions e data
    in W.with_step(#work e)(fn()=>
      let val context= #context data
          val asserted=Redblackmap.foldl(fn(_,command,result)=>
            case command of Z.Rule{rule,conclusion,...}=>
                if #replay_handler rule="asserted"then
                  #node conclusion::result else result
              | _=>result)[](#steps(#proof data))
          fun actual(node,copied)=
            case List.find(fn value=>
              case PV.corresponds_to_graph_with_policy context
                  (#graph e)(#scope e){value=value,node=node}of
                PV.Corresponding=>true|_=>false)asserted of
              SOME value=>value|NONE=>copied
      in ListPair.map actual
        (#assumptions current@[#denied current],fallback)end)
    end
  fun using (e:env) text assertions callback action =
    let
      val held=packet e text
      val data=W.with_step (#work e) (fn()=>
        VP.contents_with_policy_for (#work e) (#query e) held)
      val sources=assertions e data
      val saved=ref (NONE:Receiver.invocation option)
      val outcome=Exn.capture (fn()=>
        let val prepared=Z3_OwnedValueNamedReplay.prepare_with_policy
              (#work e) (#query e) held
              {assertions=sources,native_contract= #contract e,
               check_type=callback}
            val _=case prepared of Receiver.Prepared value=>saved:=SOME value
              | Receiver.Needs _=>()
        in action held data prepared end) ()
      val cleanup=Exn.capture (fn()=>
        (Option.app Receiver.close (!saved);VP.close held)) ()
    in case outcome of Exn.Exn primary=>raise primary
      | Exn.Res result=>(Exn.release cleanup;result) end
  fun ready (Receiver.Prepared value)=value
    | ready (Receiver.Needs _)=raise Fail "ordinary named programme pending"
  fun run (e:env) saved =
    let fun next ()=case Receiver.replay_next_with_policy (#work e) saved of
          NONE=>() | SOME _=>next ()
    in next () end
  fun root_result (e:env) (data:ZV.proof VP.contents) saved =
    Receiver.step_with_policy_for (#work e) saved (#root (#proof data))
  fun checked (e:env)
      (result:{block:P.block,node:PV.value,edge:P.edge}) =
    W.with_step (#work e) (fn()=>
    let val theorem=P.compact_theorem_for (#work e) (#block result)
          (#edge result)
        val name=P.name (#work e) (#block result) (#node result)
    in require "actual shared receiver lost checked named endpoint"
      (Term.aconv (Thm.concl theorem) name andalso
       null (Tag.axioms_of (Thm.tag theorem)));
       P.source_dependencies_for (#work e) (#block result) (#edge result)
    end)
  (* These two fixtures reference exactly the two actual parsed Sources.
     Complete those checked commands before observing Clause's own boundary.
     Their checked transport, if required, precedes the Clause programme. *)
  fun replay_sources (e:env) (data:ZV.proof VP.contents) saved =
    let
      val proof= #proof data
      val premises= #premises(rule proof(#root proof))
      val _=require "fixture needs two actual ordered Source premises"
        (length premises=2)
      fun replay expected=case Receiver.replay_next_with_policy
          (#work e)saved of
          SOME{id,...}=>require "actual Source command order changed"
            (id=expected)
        | NONE=>raise Fail "actual Source command was not replayed"
    in List.app replay premises end
  val ordinary="((proof (unit-resolution (asserted (or true false)) " ^
    "(asserted (not true)) false)))"
  val alias_text="((proof (let ((alias (or true false))) " ^
    "(unit-resolution (unit-resolution (asserted alias) alias) " ^
    "(asserted (not alias)) false))))"
  val alias_boundary="((proof (unit-resolution " ^
    "(asserted (or (let ((alias (or true false))) alias) false)) " ^
    "(asserted (not false)) true)))"
  val clause=boolSyntax.mk_disj(boolSyntax.T,boolSyntax.F)
  fun positions(e:env)ports=W.with_step(#work e)(fn()=>
    List.map(#index o P.source_data_for(#work e))ports)
in
  val _=run_postlude 405 "owned-value-recorded-unit-resolution-6" (fn()=>
    let
      val _=test "Actual parsed unit resolution uses fixed native programme"
        (fn()=>fixture [clause,boolSyntax.mk_neg boolSyntax.T] boolSyntax.F
          (fn e=>using e ordinary graph_assertions(fn _=>())
            (fn _=>fn data=>fn prepared=>
            let val saved=ready prepared val before_count=Count.thm_count()
                val _=run e saved val after_count=Count.thm_count()
                val result=root_result e data saved
                val ports=checked e result
                val again=root_result e data saved
            in require "Clause worker or exact current Source lineage lost"
              (positions e ports=[0,1] andalso
               #DISJ_CASES after_count> #DISJ_CASES before_count andalso
               #NOT_ELIM after_count> #NOT_ELIM before_count andalso
               #CCONTR after_count> #CCONTR before_count andalso
               Portable.pointer_eq(#edge result,#edge again) andalso
               not(#retired(W.audit_policy(#work e))))end)))
      val _=test "Whole OR-valued lexical alias retains recorded boundary"
        (fn()=>fixture [clause,boolSyntax.mk_neg clause] boolSyntax.F
          (fn e=>using e alias_text graph_assertions(fn _=>())
            (fn _=>fn data=>fn prepared=>
            let val saved=ready prepared val _=run e saved
                val result=root_result e data saved
            in require "alias constructor replaced its real Source atom"
              (positions e(checked e result)=[0,1] andalso
               not(#retired(W.audit_policy(#work e))))end)))
      val _=test "Recorded alias cannot silently acquire raw OR fallback"
        (fn()=>fixture [boolSyntax.mk_disj(clause,boolSyntax.F),
            boolSyntax.mk_neg boolSyntax.F] boolSyntax.F
          (fn e=>using e alias_boundary asserted_values(fn _=>())
            (fn _=>fn data=>fn prepared=>
            let val saved=ready prepared
                val _=replay_sources e data saved
                val prior=Count.thm_count()
                val observed=ref "no HOL_ERR"
                val exact=(ignore(Receiver.replay_next_with_policy
                  (#work e)saved);false)handle Feedback.HOL_ERR detail=>
                  (observed:=Feedback.message_of detail;
                   !observed="ordered resolution leaves an unmatched literal")
                val unchanged=Count.thm_count()=prior
                val retired= #retired(W.audit_policy(#work e))
            in require ("recorded boundary: "^ !observed^
              "; no Clause effects="^Bool.toString unchanged^
              "; retired="^Bool.toString retired)
              (exact andalso unchanged andalso retired)end)))
      val _=test "Foreign Work precedes completed Clause packet backing"
        (fn()=>fixture [clause,boolSyntax.mk_neg boolSyntax.T] boolSyntax.F
          (fn held=>using held ordinary graph_assertions(fn _=>())
            (fn packet=>fn data=>fn prepared=>
            let val saved=ready prepared val _=run held saved
                val _=ignore(root_result held data saved)
                val _=VP.close packet
            in fixture [] boolSyntax.F(fn expected=>
              let val prior=Count.thm_count()
                  val exact=(ignore(Receiver.replay_next_with_policy
                    (#work expected)saved);false)
                    handle Feedback.HOL_ERR detail=>
                      Feedback.message_of detail="different original Work"
              in require "foreign Work touched expired Clause or held owner"
                (exact andalso Count.thm_count()=prior andalso
                 #retired(W.audit_policy(#work expected))andalso
                 not(#retired(W.audit_policy(#work held))))end)end)))
      val _=test "Warmed completed Clause queue still rejects packet expiry"
        (fn()=>fixture [clause,boolSyntax.mk_neg boolSyntax.T] boolSyntax.F
          (fn e=>using e ordinary graph_assertions(fn _=>())
            (fn packet=>fn _=>fn prepared=>
            let val saved=ready prepared val _=run e saved
                val _=require "completed Clause queue changed"(not
                  (Option.isSome(Receiver.replay_next_with_policy
                    (#work e)saved)))
                val _=VP.close packet val prior=Count.thm_count()
                val expired=refused(fn()=>ignore
                  (Receiver.replay_next_with_policy(#work e)saved))
            in require "empty cached queue revived dead actual packet"
              (expired andalso Count.thm_count()=prior andalso
               #retired(W.audit_policy(#work e)))end)))
      val _=test "Clause Type callback Primary precedes every native rule"
        (fn()=>fixture [clause,boolSyntax.mk_neg boolSyntax.T] boolSyntax.F
          (fn e=>let val armed=ref false val calls=ref 0
                    exception Primary of int
              in using e ordinary asserted_values
                (fn _=>if !armed then
                  (calls:= !calls+1;raise Primary 405)else())
                (fn _=>fn data=>fn prepared=>
                let val saved=ready prepared
                    val _=replay_sources e data saved
                    val _=armed:=true
                    val prior=Count.thm_count()
                    val exact=(ignore(Receiver.replay_next_with_policy
                      (#work e)saved);false)handle Primary n=>n=405
                in require "Clause callback was masked or native rule ran"
                  (exact andalso !calls=1 andalso Count.thm_count()=prior
                   andalso
                   #retired(W.audit_policy(#work e))andalso
                   (G.validate_scope(#graph e)(#scope e);true))end)end))
    in ()end)
end

