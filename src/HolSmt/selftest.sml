            (fn _ => fn context =>
              let val binder = (#genvar context) Type.bool
                  val _ = child := Option.map #scope
                    ((#graph_node context) binder)
                  val bad = copy context
                    (fn () => (calls := !calls+1;raise Primary token))
              in ignore (F.string_presence bad [binder]) end) end)
    in () end)
