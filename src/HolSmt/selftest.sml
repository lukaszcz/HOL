        val np=boolSyntax.mk_neg p val nq=boolSyntax.mk_neg q
        val assumptions=if text=whole then
            [clause,boolSyntax.mk_neg clause]
          else if text=compound then
            [boolSyntax.mk_neg clause,clause,clause]
          else if text=negative then[boolSyntax.mk_neg clause,p]
          else if duplicates then[clause,np,nq,clause]else[clause,np,nq]
        val goal=boolSyntax.mk_conj(boolSyntax.T,boolSyntax.T)
        val s=S.new_with_policy g r RP.Uncapped
