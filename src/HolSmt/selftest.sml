  fun fixture theorem limit policy =
    let val g = G.new () val s = G.root_scope g
        val sources = S.new g s 50000
          {goal = boolSyntax.T,assumptions = [boolSyntax.T]}
        val imported = G.import g s limit (Thm.concl theorem)
