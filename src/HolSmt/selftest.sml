  fun setup_cap text template callback:env=
    let
      val p=Term.mk_var("cpc_not_not_p",Type.bool)
      val q=Term.mk_var("cpc_not_not_q",Type.bool)
      val conjunction=boolSyntax.mk_conj(p,boolSyntax.mk_conj(q,p))
      val implication=boolSyntax.mk_imp(p,p)
      fun nn term=boolSyntax.mk_neg(boolSyntax.mk_neg term)
      val qe=boolSyntax.mk_eq(q,boolSyntax.F)
      val ei=boolSyntax.mk_eq(implication,nn implication)
      val sf=boolSyntax.mk_eq(implication,boolSyntax.F)
      val atoms=List.tabulate(64,fn index=>
        Term.mk_var("cpc_not_not_big_"^Int.toString index,Type.bool))
      fun join [last]=last
        | join(first::rest)=boolSyntax.mk_conj(first,join rest)
        | join []=raise Fail "empty actual large Boolean fixture"
      val big=join atoms
      val rows=[nn boolSyntax.F,nn conjunction,nn conjunction,
        nn p,boolSyntax.mk_neg p,qe,ei,sf,nn big]
      val goal=boolSyntax.mk_conj(boolSyntax.T,boolSyntax.T)
      val g=G.new()val r=G.root_scope g
      val s=S.new_with_policy g r RP.Uncapped{goal=goal,assumptions=rows}
      val limits:RP.semantic_policy={input_limit=RP.Uncapped,
        output_limit=RP.Uncapped,template_limit=RP.Uncapped}
      val w=W.begin_with_policy g r s{limits=limits,work_limit=RP.Uncapped}
      val n=NC.capture w{semantic_limits={input_limit=100000,
        output_limit=100000,template_limit=template},
        import_limit=1000000,type_work_limit=10000000}
      val options:Front.policy_options={graph=g,scope=r,logic="ALL",
        sources=[("p",p),("q",q),("qe",qe),("ei",ei),("sf",sf),
          ("big",big)],sorts=Redblackmap.mkDict String.compare,
        binder_lists=[],import_limit=RP.Uncapped,
        literal_limit=RP.Uncapped,binder_limit=RP.Uncapped,
        recipe_limits={template_limit=RP.Uncapped,index_limit=RP.Uncapped,
          operand_limit=RP.Uncapped,token_limit=RP.Uncapped},
        special=fn _=>fn _=>NONE,ascribed=fn _=>fn _=>fn _=>NONE}
      val stream=TextIO.openString text
      val parsed=Exn.capture(fn()=>
        Parser.parse_graph_packet_with_version_with_policy options
          (SmtLib_Logics.parsedicts_of_logic "ALL")"1.3.4"stream)()
      val _=TextIO.closeIn stream val packet=Exn.release parsed
      val gp=W.with_step w(fn()=>
        let val{assumptions,denied}=F.originals_with_policy w
            val portfolio=F.validate_portfolio_with_policy w
              {assumptions=assumptions,goal= #node(S.goal_source s),
               denied=denied}
        in GP.from_portfolio_with_policy w portfolio end)
      val request:E.request={packet=packet,preprocessing=gp,profiles=[],
        check_type=callback,ordinal=70}
    in{g=g,r=r,s=s,w=w,n=n,request=request}end
