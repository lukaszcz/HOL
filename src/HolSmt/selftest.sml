            in require "metadata lost declarations or retained expired ops"
              (count=length terms andalso count>0 andalso
               not (null (MD.type_records value)) andalso
               null (S.assumption_nodes (#sources e))) end))
      val _ = test "Injected String and FP missing sorts use native rules"
        (fn () => fixture
          ``(smtstring$str_inj s = smtstring$str_inj t) /\
