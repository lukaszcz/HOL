                    (fn () => (calls := !calls+1;raise Primary token))
                  val store = Store.create context {prefix="metadata_primary_"}
                  val terms = (#record_encoding (#operations store))
                    (#empty_terms store,
                     {input=binder,smt_symbol="generic",arity=0})
              in metadata e bad backend SmtLib.FirstOrder
                {types=empty_types (),symbols=[],roots=[],
                 encodings=(#encodings store) terms} end)
            (fn e => fn outcome =>
              let val exact = case outcome of Exn.Exn (Primary actual) =>
                      Portable.pointer_eq (actual,token) | _ => false
                  val closed = case !child of SOME scope =>
                      Option.isSome (error (fn () =>
                        G.validate_scope (#graph e) scope)) | NONE => false
              in require "metadata changed Primary or leaked recipe binders"
                (exact andalso !calls=1 andalso closed andalso
                 #retired (W.audit_policy (#work e))) end) end)
    in () end)
end

