    ":rule scope :premises (@b)))"
  fun setup text input output callback:env=
    let
      val g=G.new()val r=G.root_scope g
      val s=S.new_with_policy g r RP.Uncapped
        {goal=boolSyntax.T,assumptions=[]}
      val policy:RP.semantic_policy={input_limit=RP.Uncapped,
        output_limit=RP.Uncapped,template_limit=RP.Uncapped}
      val w=W.begin_with_policy g r s
        {limits=policy,work_limit=RP.Uncapped}
      val native=NC.capture w
        {semantic_limits={input_limit=input,output_limit=output,
          template_limit=100000},import_limit=1000000,
         type_work_limit=10000000}
      val frame=Scope.root_with_policy w
      val stream=TextIO.openString text
      val loaded=Exn.capture(fn()=>
        Parser.parse_graph_packet_with_version_with_policy(options g r)
          (SmtLib_Logics.parsedicts_of_logic "ALL")"1.3.4"stream)()
      val _=TextIO.closeIn stream val packet=Exn.release loaded
      val(source,target)=case #commands(Packet.proof packet)of
          [Parser.GraphAssumePush(_,a),
           Parser.GraphStep{step={conclusion=SOME b,...},pop=false},
           Parser.GraphStep{pop=true,...}]=>
             (#node a,#node b)
        | _=>raise Fail "actual parsed specialization command shape differs"
      val gp=W.with_step w(fn()=>
        let val{assumptions,denied}=F.originals_with_policy w
            val portfolio=F.validate_portfolio_with_policy w
              {assumptions=assumptions,goal= #node(S.goal_source s),
               denied=denied}
        in GP.from_portfolio_with_policy w portfolio end)
      val owner=Native.begin_with_policy w native
        {packet=packet,preprocessing=gp,profiles=[],check_type=callback}
      val frontier=P.prepare_scoped_original_realization_frontier_with_policy w
        {frame=frame,roots=[source,target],additional_sources=[source],
         closed_facts=[],conversions=[]}
      val block=W.with_step w(fn()=>
        let val tables=P.prepare_owned_realization_tables_with_policy w
              frontier
            val plan=P.prepare_native_realization_freeze_with_policy w
              {tables=tables,contract=native,profiles=[],ordinal=0,
               check_type=fn _=>()}
        in P.freeze_owned_realization_tables_with_policy w plan end)
      val edge=W.with_step w(fn()=>P.source block 1)
    in {g=g,r=r,s=s,w=w,native=native,frame=frame,block=block,
      packet=packet,owner=owner,source=source,target=target,edge=edge}end
  fun prepare(e:env)=Native.prepare_specialize_with_policy(#w e)(#owner e)
