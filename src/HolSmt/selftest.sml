      val list = List.foldr (fn (b,tail) => G.application graph scope
        (G.application graph scope (cons,b),tail)) empty_list bits
      val head = G.constant graph scope (Term.rator
        (bitstringSyntax.mk_v2w (listSyntax.mk_nil Type.bool,index)))
    in G.application graph scope (head,list) end
  fun family_in graph scope suffix reverse depth malformed aliases =
    let
      val index = fcpSyntax.mk_numeric_type (Arbnum.fromInt 3)
      val word_type = wordsSyntax.mk_word_type index
      val atom = Term.mk_var ("fresh_public_anchor" ^ suffix,word_type)
      fun grow 0 value = value
        | grow n value = grow (n-1) (wordsSyntax.mk_word_add (value,value))
      val anchor = imported graph scope (grow depth atom)
