        Type.compare (hol_type,``:bool option``)=EQUAL) declarations of
        SOME {constructors,...} => constructors
      | NONE => raise Fail "Value option declaration missing" end
  fun constructor e expected =
    case List.find
      (fn {constructor,...}:SmtLib.parser_datatype_constructor =>
        Term.same_const constructor expected) (constructors e) of
        SOME info => info | NONE => raise Fail "Value constructor missing"
  fun some e = constructor e optionSyntax.some_tm
  fun selector e = case #selectors (some e) of
