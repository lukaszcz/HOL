    | theorem(Solver.ReplayNeeds{invocation,...})=
        (Solver.close invocation;raise Fail "actual replay needs a programme")
    | theorem(Solver.RealizationNeeds{invocation,...})=
        (Solver.close invocation;raise Fail "actual realization is unfinished")
    | theorem _=raise Fail "configured solver did not check the contradiction"
  fun file_text path=
    let val input=TextIO.openIn path
        val outcome=Exn.capture(fn()=>TextIO.inputN(input,4097))()
        val cleanup=Exn.capture TextIO.closeIn input
    in case outcome of Exn.Exn primary=>raise primary
      | Exn.Res text=>(Exn.release cleanup;
          require "fixed solver query exceeds its bounded fixture oracle"
            (String.size text<=4096);text)end
  fun test label action=
    let val trace= !Library.trace
        val _=Library.trace:=0
        val _=Count.counting_thms true
        val outcome=Exn.capture(fn()=>
          (testutils.tprint label;action();testutils.OK()))()
        val _=Count.counting_thms false
        val _=Library.trace:=trace
    in Exn.release outcome end
