        (* The actual nested body is fully recorded. A separate genuine
           discovery below issues extra profiles at its real body frame;
           this does not claim an opaque target binder can be constructed. *)
        val term=``(\x:bool. (\y:bool. y) x)=(\x:bool. (\y:bool. y) x)``
