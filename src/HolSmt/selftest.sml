  fun text_clause []="false"
    | text_clause [value]=value
    | text_clause(value::rest)="(or "^value^" "^text_clause rest^")"
  fun term_clause []=boolSyntax.F
    | term_clause [value]=value
    | term_clause(value::rest)=disj(value,term_clause rest)
  fun positive label assumptions text =
    (native_reference assumptions goal text;
     fixture assumptions goal(fn e=>using e text(fn _=>())
       (fn _=>fn _=>fn prepared=>
         let val result=proved(Final.finish_with_policy(#work e)
               (ready prepared))
             val _=checked e(#theorem result)
         in require(label^": original Goal/source lineage changed")
           (not(Term.aconv(Thm.concl(#theorem result))boolSyntax.F)andalso
            not(null(#dependencies result)))end)))
  type cnf_case={rule:string,whole:string,argument:Term.term,
    index:int option,literals:(string * Term.term)list}
  fun cnf_test({rule,whole,argument,index,literals}:cnf_case)=
    let
      val clause=text_clause(List.map #1 literals)
      val term=term_clause(List.map #2 literals)
      val extra=case index of NONE=>""|SOME n=>" "^Int.toString n
      val text="((assume @negative (not "^clause^")) "^
        "(step @clause "^clause^" :rule "^rule^" :args ("^whole^
        extra^")) (step @done false :rule contra "^
        ":premises (@clause @negative)))"
    in test("Actual "^rule^" matches native and closes original Goal")
      (fn()=>positive rule[neg term]text)end
  fun pos(text,term)=(text,term)
  fun not_(text,term)=("(not "^text^")",neg term)
  val pp=("p",p)val qq=("q",q)val rr=("r",r)
