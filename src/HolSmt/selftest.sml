    handle Feedback.HOL_ERR detail => SOME
      (Feedback.top_structure_of detail,Feedback.top_function_of detail,
       Feedback.message_of detail)
  fun owned action =
    let
      val graph = G.new () val scope = G.root_scope graph
      val sources = S.new graph scope 10000
        {assumptions=[boolSyntax.T,boolSyntax.T],goal=goal}
      val work = W.begin_with_policy graph scope sources
        {limits={input_limit=cap,output_limit=cap,template_limit=cap},
         work_limit=cap}
      fun run () =
        let val {assumptions,denied} = V.originals_with_policy work
            val validation = V.validate_portfolio_with_policy work
              {assumptions=assumptions,goal= #node (S.goal_source sources),
               denied=denied}
            val query = GP.prepare_query_with_policy work
              (GP.from_portfolio_with_policy work validation)
        in action ({graph=graph,scope=scope,sources=sources,
          work=work,query=query}:env) end
      val result = Exn.capture run ()
      val cleanup = Exn.capture (fn () =>
        (W.close work;G.close_scope graph scope)) ()
    in case result of Exn.Exn primary => raise primary
      | Exn.Res answer => (Exn.release cleanup;answer) end
  fun options (e:env) =
    {graph= #graph e,scope= #scope e,logic="ALL",sources=[],
     sorts=Redblackmap.mkDict String.compare,binder_lists=[],
     import_limit=cap,literal_limit=cap,binder_limit=cap,
     recipe_limits={template_limit=cap,index_limit=cap,
       operand_limit=cap,token_limit=cap},
     special=fn _ => fn _ => NONE,
     ascribed=fn _ => fn _ => fn _ => NONE}
  fun description policy =
    {solver=case policy of F.Z3 => "Z3" | F.CPC => "cvc5",
     version=case policy of F.Z3 => "4.15.3" | F.CPC => "1.3.4",
     policy=policy,reserved_names=[]}
  fun mapping (e:env) token depth =
    let fun opening caller node = ignore
          (G.record_opened_view_with_policy (#graph e) caller
            (RP.AtMost 10000) node)
    in T.with_outbound_query_analysis_with_policy (#work e) (#query e)
      opening (fn context =>
        let val store = Store.create context {prefix="value_frontend_"}
            val operations = #operations store
            val value = if depth<0 then
                #1 ((#strip_comb context) (#goal context))
              else
                let val binder = (#genvar context) Type.bool
                    val conjunction = (#constant context)
                      boolSyntax.conjunction
                    fun shared 0 = binder
                      | shared n = let val child = shared (n-1) in
                          (#mk_comb context)
                            ((#mk_comb context) (conjunction,child),child) end
                in (#list_mk_abs context) ([binder],shared depth) end
            val terms = (#term_insert operations)
              (#empty_terms store,(#ordinary_key operations) (value,1),token)
        in M.freeze context
          {graph= #graph e,scope= #scope e,regime=SmtLib.FirstOrder,
           types=Redblackmap.mkDict Type.compare,
           symbols=(#symbols store) terms} end)
    end
  fun factory (e:env) mapping = MB.create (#work e)
