        val closure=G.closure_child_binder graph scope (#child d)
        val captured=G.binder_closure_data graph scope closure
        val child=G.binder_closure_body graph scope closure
        val body= #body captured val frame= #body_frame captured
        val profiles=if opaque then
          let val z=Term.mk_var ("effective_profile_z",Type.bool)
              val retained=Term.mk_abs(z,boolSyntax.mk_neg z)
              val q=Term.mk_var ("effective_profile_q",Type.bool)
              val beta=Term.mk_comb(Term.mk_abs(q,q),boolSyntax.T)
              val wrapper=boolSyntax.mk_conj
                (boolSyntax.mk_eq(retained,retained),beta)
              val imported=G.import_with_policy graph frame
                (RP.AtMost(IntInf.fromInt(#import_limit limits))) wrapper
              val discovery=W.with_step work (fn()=>
                G.discover_partial_with_policy graph frame
