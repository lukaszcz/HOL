      (List.null(Thm.hyp proof)andalso
       Portable.pointer_eq(Thm.concl proof,G.representative(#g e)node)andalso
       Term.aconv left(G.representative(#g e)(#source e))andalso
       Term.aconv right(G.representative(#g e)(#target e))andalso
       List.null(Tag.axioms_of(Thm.tag proof)))end
