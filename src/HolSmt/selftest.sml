           Portable.pointer_eq(right,
             G.representative(#g e)(#target actual))andalso
           Portable.pointer_eq(Core.native_contract_with_policy_for
             (#w e)result,#native e)andalso null(Thm.hyp theorem))
    in (actual,theorem)end
