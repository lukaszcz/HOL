               #head (#encoding (hd definitions))= #head event andalso
               null (MD.term_declarations value)) end))
      val _ = test "Extra shared70 roots share a DAG and keep duplicates"
        (fn () => fixture boolSyntax.T
          (fn e => fn context => fn _ =>
            let val conjunction = (#constant context) boolSyntax.conjunction
                fun shared 0 = #goal context
                  | shared depth = let val child = shared (depth-1) in
                      application context conjunction [child,child] end
                val current = shared 70
                val (result,stats) = G.with_node_statistics
                  (#graph e) (#scope e) (fn () =>
                    SmtLib_GraphParserMapping.freeze_with_inputs context
                      {graph= #graph e,scope= #scope e,
                       regime=SmtLib.FirstOrder,
                       types=empty_types (),symbols=[],
                       inputs=[current,current]})
                val original = M.freeze context
                  {graph= #graph e,scope= #scope e,regime=SmtLib.FirstOrder,
