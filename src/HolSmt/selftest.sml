         work_limit=cap}
      fun run () =
        let
          val contract=NC.capture work native
          val {assumptions,denied}=V.originals_with_policy work
          val validation=V.validate_portfolio_with_policy work
            {assumptions=if retain then assumptions else [],
             goal= #node (S.goal_source sources),
             denied=denied}
          val query=GP.prepare_query_with_policy work
            (GP.from_portfolio_with_policy work validation)
          fun open_view caller node=ignore
            (G.record_opened_view_with_policy graph caller
              (RP.AtMost 10000) node)
          val metadata=T.with_outbound_query_analysis_with_policy work query
            open_view (fn context=>SmtLib.outbound_with_backend_context
              {sequence_emission=false,set_backend=SmtLib.Z3Set,
               bag_backend=SmtLib.Z3ArrayBag,
               has_set_terms=false,has_bag_terms=false} (fn backend=>
              let
                val operations=
                  SmtLib_GraphCarrierOperations.make_with_datatypes context
                    {sequence_emission=false}
                    {term_to_string=fn _=>raise Fail "unexpected formatter"}
                val emission=SmtLib_GraphDispatcher.emit context
                  {operations=operations,regime=SmtLib.FirstOrder,
                   apply_operator=SmtLib.ApplyUnderscore,
                   prefix="scoped_child423_",
                   roots=ListPair.zip
                     (List.tabulate (length (#assumptions context)+2,Lib.I),
                      #goal context :: #assumptions context @
                        [#denied context])}
              in SmtLib_GraphDeclarationMetadata.freeze context
                {graph=graph,scope=scope,regime=SmtLib.FirstOrder,
                 backend=backend,operations=operations,emission=emission}
              end))
        in action ({graph=graph,scope=scope,sources=sources,work=work,
          query=query,metadata=metadata,contract=contract}:env) end
      val outcome=Exn.capture run ()
      val cleanup=Exn.capture (fn()=>
        (W.close work;G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary=>raise primary
      | Exn.Res result=>(Exn.release cleanup;result) end
  fun options (e:env):F.value_options =
    {graph= #graph e,scope= #scope e,logic="ALL",sources=[],
     sorts=Redblackmap.mkDict String.compare,binder_lists=[],
     import_limit=cap,literal_limit=cap,binder_limit=RP.AtMost 1,
     recipe_limits={template_limit=cap,index_limit=cap,
       operand_limit=cap,token_limit=cap},
     special=fn _=>fn _=>NONE,ascribed=fn _=>fn _=>fn _=>NONE}
  fun input text =
    let val index=ref 0 in fn()=>
      if !index=String.size text then NONE else
        let val result=String.sub (text,!index)
        in index:= !index+1;SOME result end end
  fun packet (e:env) text =
    Z3_GraphValueProofParser.create_packet_with_policy_from_input
      (#work e) (#query e) (options e) (#metadata e) "4.15.3" (input text)
  fun rule (proof:ZV.proof) id =
    case Redblackmap.find (#steps proof,id) of Z.Rule value=>value
      | _=>raise Fail "expected actual parsed Rule"
  fun fixture assumptions goal=fixture_with true assumptions goal
  fun graph_assertions (e:env) (data:ZV.proof VP.contents) =
    let val current=GP.query_nodes_with_policy_for (#work e) (#query e)
    in W.with_step (#work e) (fn()=>
      let
        val context= #context data
        fun guard ()=(PV.validate context;
          G.validate_scope (#graph e) (#scope e))
        fun tick ()=(guard ();W.spend_policy (#work e) 1)
        fun compare (left,right)=(tick ();Int.compare (left,right))
        val memo=ref (Redblackmap.mkDict compare)
        (* The actual query supplies graph IDs. Copy App DATA with sharing;
           graph_leaf remains restricted to its genuine atomic contract.
           This fixture needs no native query term or binder conversion. *)
        fun copy node=
          let val _=tick () val syntax=G.view (#graph e) node
              val id=G.node_id node
          in case Redblackmap.peek (!memo,id) of
              SOME value=>(PV.usable context (#scope e) value;value)
            | NONE=>
                let val value=case syntax of
                        G.Variable _=>PV.graph_leaf context (#scope e) node
                      | G.Constant _=>PV.graph_leaf context (#scope e) node
                      | G.Application (left,right)=>
                          let val f=copy left val x=copy right
                          in PV.application context (#scope e) (f,x) end
                      | _=>raise Fail "fixture Source needs binder programme"
                    val _=PV.usable context (#scope e) value
                    val _=tick ()
                    val _=memo:=Redblackmap.insert (!memo,id,value)
                in value end
          end
        fun copies []=(guard ();[])
          | copies (node::rest)=(tick ();copy node::copies rest)
      in copies (#assumptions current @ [#denied current]) end)
    end
  fun using (e:env) text callback action =
    let
      val held=packet e text
      val saved=ref(NONE:Final.invocation option)
      val outcome=Exn.capture(fn()=>
        let
          val data=W.with_step (#work e) (fn()=>
            VP.contents_with_policy_for (#work e) (#query e) held)
          val assertions=graph_assertions e data
          val prepared=Final.prepare_with_quantified_binders_with_policy
            (#work e) (#query e) held
            {assertions=assertions,native_contract= #contract e,
             profiles=[],check_type=callback}
          val _=case prepared of Final.Prepared owner=>saved:=SOME owner
            | _=>()
        in action held data prepared end) ()
      val cleanup=Exn.capture(fn()=>case !saved of
          SOME owner=>Final.close owner | NONE=>VP.close held) ()
    in case outcome of Exn.Exn primary=>raise primary
      | Exn.Res result=>(Exn.release cleanup;result)end
  fun ready (Final.Prepared owner)=owner
    | ready (Final.ReplayNeeds _)=raise Fail "unexpected replay programme"
  fun proved (Final.Proved result)=result
    | proved (Final.RealizationNeeds _)=
        raise Fail "unexpected original Source realization programme"
  fun canonical_hyp (e:env) theorem =
    let val allowed=S.assumption_nodes (#sources e)
    in List.all(fn term=>List.exists(fn node=>Portable.pointer_eq
      (term,G.representative (#graph e) node))allowed)(Thm.hyp theorem)end
  fun checked (e:env) theorem =
    (S.check_goal (#sources e) theorem;
     require "finalizer did not retain exact original Goal/canonical Hyp"
       (Portable.pointer_eq(Thm.concl theorem,
          #2(S.original_goal (#sources e)))andalso canonical_hyp e theorem
        andalso null(Tag.axioms_of(Thm.tag theorem))))
  fun quant sort body left right=
    "(quant-intro (proof-bind (lambda ((x " ^ sort ^ ")) " ^ body ^
    ")) (= (lambda ((a " ^ sort ^ ")) " ^ left ^
    ") (lambda ((b " ^ sort ^ ")) " ^ right ^ ")))"
  val bool_quant=quant "Bool" "(refl (= x x))" "a" "b"
  val int_quant=quant "Int" "(refl (= x x))" "a" "b"
  fun alias_quant body="(quant-intro (proof-bind " ^
    "(lambda ((x Bool)) " ^ body ^ ")) p)"
  fun shared_target body="(let ((f (lambda ((a Bool)) a))) " ^
    "(let ((p (= f f))) " ^ body ^ "))"
  fun certificate body="((proof " ^ body ^ "))"
  fun inspecting (e:env) text action=
    let val held=packet e text
        val outcome=Exn.capture(fn()=>
          let val data=W.with_step(#work e)(fn()=>
                VP.contents_with_policy_for(#work e)(#query e)held)
          in action held data end)()
        val cleanup=Exn.capture VP.close held
    in case outcome of Exn.Exn primary=>raise primary
      | Exn.Res value=>(Exn.release cleanup;value)end
  fun lower (e:env) held (data:ZV.proof VP.contents) contract callback=
    Binder.prepare(#work e)(#query e)held
      {id= #root(#proof data),native_contract=contract,check_type=callback}
  fun lower_ready(Binder.Prepared plan)=plan
    | lower_ready _=raise Fail "unexpected scoped child requirement"
  fun closed (e:env) held data=
    Binder.execute(#work e)
      (lower_ready(lower e held data(#contract e)(fn _=>())))
  fun law_data (e:env) receipt=W.with_step(#work e)(fn()=>
    Binder.data_for(#work e)receipt)
  fun root_target (data:ZV.proof VP.contents)=
    #node(#conclusion(rule(#proof data)(#root(#proof data))))
  fun target_abs (data:ZV.proof VP.contents) target=
    case PV.view(#context data)target of PV.Application(partial,right)=>
      (case PV.view(#context data)partial of PV.Application(_,left)=>
        (left,right)|_=>raise Fail "missing equality left")
    | _=>raise Fail "missing actual target equality"
  (* The shared parser creates the actual Bind/origin. The generic
     packet API promises ownership DATA, not inference authenticity, so
     this negative publishes one changed typed child conclusion containing
     a SECOND genuine local Bound ID. No copied frame/Scope is adopted. *)
  fun second_bound_packet (e:env) text=
    let
      val version=Z3_Proof.resolve_version "4.15.3"
      val tokenizer=SmtLib_Parser.make_proof_input_tokenizer(input text)
      val description=Z.policy_description version
      val offending=ref(NONE:G.node option)
      fun parse(factory:SmtLib_GraphValueTranslation.session)=
        let val context= #context factory
            val observations:PV.value Z.policy_observations=
              {type_of=PV.type_of context,same_identity=op=,
               guard_alias_scope=fn(scope,value)=>
                 PV.usable context scope value,
               alias_entry=fn(scope,value)=>
                 {key=PV.key context value,visible=fn()=>
                   (PV.usable context scope value;true)}}
            fun complete tokens=
              case(SOME(tokens())handle SmtLib_Parser.ProofEOF=>NONE)of
                  NONE=>()|SOME _=>raise Fail "trailing fixture proof"
            fun publish {reader:F.value_reader,proof:ZV.proof,
                requested_version=_,close}=
              let
                val binding_and_body=Redblackmap.foldl
                  (fn(_,entry,found)=>case found of SOME _=>found
                    | NONE=>case entry of Z.Bind{binding,body,...}=>
                        SOME(binding,body)|_=>NONE)NONE(#steps proof)
                val(binding,body)=valOf binding_and_body
                val original=F.scoped_session_origin binding
                val owner=F.scoped_origin_owner original
                val child= #scope owner
                val local_bound=PV.fresh_bound context child
                  (Term.mk_var("second_local_bound",Type.bool))
                val cursor=PV.proof_term context local_bound
                val reference=valOf(PV.proof_graph_reference context cursor)
                val local_node=G.closure_child_node(#graph e)
                  (#scope reference)(#child reference)
                val annotation=case binding of
                    F.ScopedSession{variables=[value],...}=>value
                  | _=>raise Fail "expected one actual annotation"
                val annotated=valOf(PV.proof_graph_reference context
                  (PV.proof_term context annotation))
                val annotated_node=G.closure_child_node(#graph e)
                  (#scope annotated)(#child annotated)
                val _=require "fixture did not create a second Bound ID"
                  (local_node<>annotated_node andalso
                   (case G.view(#graph e)local_node of
                      G.Variable(G.Bound,_)=>true|_=>false)andalso
                   G.node_scope(#graph e)local_node=child)
                val _=offending:=SOME local_node
                val {rule,premises,conclusion,arguments,metadata,
                    accepts_bind}=rule proof body
                val head=case PV.view context(#node conclusion)of
                    PV.Application(partial,_)=>
                      (case PV.view context partial of
                          PV.Application(head,_)=>head
                        | _=>raise Fail "actual refl Eq head missing")
                  | _=>raise Fail "actual refl Eq body missing"
                val partial=PV.application context child(head,local_bound)
                val node=PV.application context child(partial,local_bound)
                val changed:F.value_term={node=node,scope=child,
                  occurrence= #occurrence conclusion,binder_blocks=[]}
                val step=Z.Rule{rule=rule,premises=premises,
                  conclusion=changed,arguments=arguments,metadata=metadata,
                  accepts_bind=accepts_bind}
                val changed_proof:ZV.proof={root= #root proof,
                  steps=Redblackmap.insert(#steps proof,body,step),
                  vars= #vars proof,z3_version= #z3_version proof,
                  close= #close proof}
                fun collect(_,entry,(terms,bindings))=case entry of
                    Z.Rule{conclusion,arguments,...}=>
                      (conclusion::arguments@terms,bindings)
                  | Z.Bind{binding,...}=>(terms,binding::bindings)
                  | Z.Alias _=>(terms,bindings)
                val(terms,bindings)=Redblackmap.foldl collect([],[])
                  (#steps changed_proof)
                val _=require "changed syntax used a different parser"
                  (Portable.pointer_eq(#backend reader,
                    #backend(#reader(#session factory))))
              in {proof=changed_proof,terms=terms,bindings=bindings,
                close=close}:ZV.proof VP.parsed end
        in Z.create_using_with_policy_token_factory_for_backend observations
          publish(fn _=>fn _=>fn _=> #session factory)(options e)
          "4.15.3"(fn()=>tokenizer)complete end
      val held=VP.create(#work e)(#query e)
        {options=options e,metadata= #metadata e,description=description,
         requested_version="4.15.3",tokens=tokenizer}parse
    in(held,valOf(!offending))end
  fun demanded body left right=
    certificate("(let ((p (= (lambda ((a Bool)) " ^ left ^
      ") (lambda ((b Bool)) " ^ right ^ ")))) " ^
      "(let ((@q " ^ alias_quant body ^ ")) " ^
      "(unit-resolution (asserted (not true)) " ^
      "(mp @q (iff-true @q (= p true)) true) false)))")
  fun complete (e:env) text check=
    using e text(fn _=>())(fn _=>fn _=>fn prepared=>
      let val owner=ready prepared
          val result=proved(Final.finish_with_policy(#work e)owner)
          val _=checked e(#theorem result)
      in check result end)
  fun general (e:env) held (data:ZV.proof VP.contents) contract callback=
    Binder.prepare_general(#work e)(#query e)held
      {id= #root(#proof data),native_contract=contract,check_type=callback}
  fun raw_child body left right=certificate
    (quant "Bool" body left right)
  val trans_child="(trans (refl (= x x)) " ^
    "(symm (refl (= x x)) (= x x)) (= x x))"
  val congruence_child="(monotonicity (refl (= x x)) " ^
    "(= (not x) (not x)))"
  val boolean_child="(iff-true (refl (= x x)) (= (= x x) true))"
  val clause_child="(iff-true (unit-resolution " ^
    "(rewrite (or true false)) (rewrite (not false)) true) " ^
    "(= true true))"
in
  (* The directory keeps design stage423; root assigns the actual next
     contiguous regression ordinal when the complete engine is sealed. *)
  val _=run_postlude 426 "owned-value-scoped-child-programmes-11"(fn()=>
    let
      val _=test "Parsed transitive child closes constructors before ABS"
