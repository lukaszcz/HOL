        val cleanup = Exn.capture VP.close held
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res result => (Exn.release cleanup;result) end
  val bound_text =
    "((proof (proof-bind (lambda ((x Bool)) (asserted (or x false))))))"
  fun binding e held = W.with_step (#work (e:env)) (fn () =>
    let val proof = #proof (contents e held)
