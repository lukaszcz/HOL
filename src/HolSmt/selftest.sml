  fun open_child (e:env) owner =
    let val factory = Owned.factory_for (#work e) owner
        val opened = W.with_step (#work e) (fn () =>
          B.open_binders (#backend factory) (B.root (#backend factory))
            [("guard_x","guard_x",Type.bool)])
    in (factory,opened,valOf (#origin opened)) end
  fun using_saved e text action =
    let val held = packet e text
        val outcome = Exn.capture (fn () => action held) ()
        val released = Exn.capture VP.close held
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res value => (Exn.release released;value) end
  fun with_direct e extra action =
    let val owner = direct e extra
        val outcome = Exn.capture action owner
        val released = Exn.capture Owned.close owner
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res value => (Exn.release released;value) end
