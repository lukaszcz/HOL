        {limits={input_limit=512,output_limit=output,template_limit=512},
         work_limit=10000000}
      val outcome = Exn.capture (fn () =>
        let val input = SmtLib_GraphPreprocess.discover_from_sources
              graph scope sources {import_limit=512,revisit=false,
                check_type=fn _ => (),conversion=fn _ => NONE}
            val positive = #node (G.import graph scope 512 target)
            val e:env = {graph=graph,scope=scope,sources=sources,work=work,
              input=input,positive=positive,denied=S.denied_goal_node sources,
              hypothesis=hypothesis,variable=variable,closed=closed}
        in observe e (Exn.capture action e) end) ()
      val cleanup = Exn.capture (fn () =>
        (W.close work;G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res value => (Exn.release cleanup;value) end
  fun located (e:env) node:F.term =
    {node=node,scope= #scope e,binder_blocks=[],
     occurrence=SmtLib_Parser.ConstructionOccurrence
       {value=node,role=SmtLib_Parser.ConstructionAtom,
        token="@forced-small",children=[]}}
  fun registered name = case CPC_Proof.lookup_rule "1.3.4" name of
      SOME rule => rule | NONE => raise Fail "forced fixture rule absent"
  fun command e id premises target = Q.GraphStep
    {pop=false,step={id=id,rule=registered "trust",premises=premises,
      conclusion=SOME (located e target),args=[Q.GraphTerm (located e target)],
      raw_conclusion=NONE,raw_args=[]}}
  fun certificate (e:env) =
    let val graph = #graph e and scope = #scope e
        val head = G.constant graph scope boolSyntax.conjunction
        val truth = G.constant graph scope boolSyntax.T
        val wide = G.application graph scope
          (G.application graph scope (head,#positive e),truth)
        val repeated = List.tabulate (30,fn _ => "@need")
    in {commands=[Q.GraphAssume ("@denied",located e (#denied e)),
         command e "@need" [] (#positive e),
         (* This later candidate has the universal body as its endpoint,
            but depends on the very obligation being closed. It cannot be
            selected as an independent GEN witness before forced fallback. *)
         command e "@echo" ["@need"] (#positive e),
         command e "@wide" repeated wide,
         command e "@finish" ["@wide","@denied","@echo"]
           (G.constant graph scope boolSyntax.F)],cvc_version="1.3.4"}
         :Q.graph_proof end
  fun worker (e:env) calls (request,inputs) =
    let val _ = calls := !calls+1
        val request:CPC_Proof.step = request
        val target = valOf (#conclusion request)
        fun assumed (term:CPC_Proof.located_term) = Thm.ASSUME (#term term)
        val proof = case #id request of
            "@need" => Thm.SPEC (#variable e) (Thm.ASSUME (#hypothesis e))
          | "@echo" => assumed (hd inputs)
          | "@wide" => Thm.CONJ (assumed (hd inputs)) boolTheory.TRUTH
          | "@finish" =>
              (case inputs of [positive,negative,echo] =>
                 Thm.CONJUNCT1 (Thm.CONJ
                   (Thm.MP (Thm.NOT_ELIM (assumed negative))
                     (Thm.CONJUNCT1 (assumed positive))) (assumed echo))
               | _ => raise Fail "forced fixture final arity")
          | _ => raise Fail "forced fixture unknown command"
    in (proof,target) end
  fun force (e:env) calls action (request,_) =
    let val _ = calls := !calls+1
        val _ = action ()
        val proof = if #closed e then
            Thm.GEN (#variable e) (Thm.REFL (#variable e))
          else
            let val source = hd (S.assumption_nodes (#sources e))
            in Thm.CONJUNCT1
              (Thm.ASSUME (G.representative (#graph e) source)) end
    in (proof,valOf (#conclusion (request:CPC_Proof.step))) end
  fun run e local_calls forced action =
    R.check_contradiction_preprocessed_observed_with_work_using
