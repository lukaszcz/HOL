  fun setup kind=
    let val graph=G.new() val scope=G.root_scope graph
        val sources=S.new_with_policy graph scope RP.Uncapped
          {goal=boolSyntax.T,assumptions=[]}
        val work=W.begin_with_policy graph scope sources
          {limits=metadata,work_limit=RP.Uncapped}
        val native=NC.capture work native_limits
        val raw=Raw.execute_with_policy(Raw.prepare_with_policy
          (Raw.begin_with_policy work
            {native_contract=native,check_type=fn _=>()}))
        val catalogue=K.execute_with_policy(K.prepare_with_policy
          (K.begin_with_policy work raw {check_type=fn _=>()}))
        val owner=M.begin_canonical_with_policy work catalogue
        val schemas=M.compile_with_policy owner
        val (stock,target)=case kind of
            RealPower=>(realTheory.REAL_POW_LT,``0r < (1r pow (n:num))``)
          | IntegerCancellation=>(HolSmtTheory.NUM_TO_INT_GUARDED,
              ``integer$int_of_num (Num (0:int))``)
        val candidates=List.filter(fn schema=>Portable.pointer_eq
          (#2(M.stock_origin_with_policy schema),stock)) schemas
        val imported=G.import_with_policy graph scope
          (RP.AtMost 100000) target
        val opened=G.record_opened_view_with_policy graph scope
          (RP.AtMost 100000) (#node imported)
        val child=G.closure_root graph scope (#node opened)
        fun choose []=raise Fail "actual fixed canonical instance missing"
          | choose(schema::rest)=case M.prepare_with_policy owner
              {policy_schema=schema,caller=scope,traversal=scope,
               target=child} of
                M.PolicyMatched matched=>matched
              | _=>choose rest
        val instance=M.instantiate_with_policy(choose candidates)
          {check_type=fn _=>()}
    in {graph=graph,scope=scope,sources=sources,work=work,native=native,
      catalogue=catalogue,instance=instance,frame=Scope.root_with_policy work,
      kind=kind}:fixture end
  fun condition (e:fixture) native ordinal=
    let val work= #work e val graph= #graph e val scope= #scope e
        val actual=M.instance_condition_with_policy_for work (#instance e) 0
        val theorem=case #kind e of
            RealPower=>Drule.EQT_INTRO realTheory.REAL_LT_01
          | IntegerCancellation=>computeLib.EVAL_CONV
              (G.representative graph (#node actual))
        val schema=C.checked_graph_schema graph scope
          {theorem=theorem,holes=[],operands=[],template_limit=100000}
        val source=C.graph_schema_source schema
        val _=require "condition schema is not the actual instance antecedent"
          (source= #node actual)
        val converted=C.graph_conversion graph scope false
          (fn node=>if node=source then SOME schema else NONE) source
        val plan=Core.prepare_in_scope_with_policy work
          {frame= #frame e,conversion=converted,ordinal=ordinal,
           native_contract=native,profiles=[],check_type=fn _=>()}
        val result=Core.execute_with_policy work plan
        val header=Core.conversion_description_with_policy_for work result
        val _=require "condition Core result is not actual antecedent to T"
          (#source header= #node actual andalso
           Portable.pointer_eq(G.representative graph (#target header),
             boolSyntax.T))
    in result end
  fun owner (e:fixture) check_type=Q.begin_with_policy (#work e)
    (#catalogue e) {profiles=[],check_type=check_type}
  fun prepare (e:fixture) q ordinal conditions=Q.prepare_owned_with_policy q
    {frame= #frame e,instance= #instance e,conditions=conditions,
     ordinal=ordinal}
  fun checked_result (e:fixture) result=
    let val work= #work e
        val conversion=W.with_step work (fn()=>
          Q.conversion_with_policy_for work result)
        val target=M.instance_target_with_policy_for work (#instance e)
        val _=P.validate_conversion_for work conversion
        val _=P.validate_conversion_with_policy (#graph e) (#scope e)
          RP.Uncapped conversion
        val _=require "conditional conversion changed its actual matcher LHS"
          (P.conversion_source conversion= #node target)
        val converted=W.with_step work(fn()=>C.graph_leaf_with_policy work
          {frame= #frame e,conversion=conversion,
           observe=fn()=>W.spend_policy work 1})
        val actual=Core.execute_with_policy work
          (Core.prepare_in_scope_with_policy work
            {frame= #frame e,conversion=converted,ordinal=12,
             native_contract= #native e,profiles=[],check_type=fn _=>()})
        val theorem=Core.theorem_with_policy_for work actual
        val(left,right)=boolSyntax.dest_eq(Thm.concl theorem)
        val header=Core.conversion_description_with_policy_for work actual
    in null(Thm.hyp theorem) andalso null(Tag.axioms_of(Thm.tag theorem))
      andalso #source header= #node target andalso
      Portable.pointer_eq(left,G.representative (#graph e) (#node target))
      andalso Portable.pointer_eq(right,
        G.representative (#graph e) (P.conversion_target conversion))
      andalso Portable.pointer_eq(Core.native_contract_with_policy_for work
        actual,#native e) andalso null(S.assumption_nodes(#sources e)) end
