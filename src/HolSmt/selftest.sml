    Z3_GraphValueProofParser.create_packet_with_policy_from_input
      (#work e) (#query e) (options e) (#metadata e) "4.15.3" (input text)
  fun rule (proof:ZV.proof) id =
    case Redblackmap.find (#steps proof,id) of Z.Rule value=>value
      | _=>raise Fail "expected actual parsed Rule"
  fun fixture aliases assumptions goal=
    fixture_with true aliases assumptions goal
  (* Actual current assertions, with original Source authority still
     authenticated by the receiver. Each fixed operand is bounded at16. *)
  fun graph_assertions (e:env) (data:ZV.proof VP.contents) =
    W.with_step(#work e)(fn()=>
      let val(original,goal)=S.original_goal(#sources e)
      in List.map(PV.import(#context data)(#scope e)(RP.AtMost 16))
        (original @ [boolSyntax.mk_neg goal])end)
  fun using (e:env) text callback action =
    let
      val held=packet e text
      val saved=ref(NONE:Final.invocation option)
      val outcome=Exn.capture(fn()=>
        let
          val data=W.with_step (#work e) (fn()=>
            VP.contents_with_policy_for (#work e) (#query e) held)
          val assertions=graph_assertions e data
          val prepared=Final.prepare_with_owned_programmes_with_policy
            (#work e) (#query e) held
            {assertions=assertions,native_contract= #contract e,
             profiles= #profiles e,check_type=callback}
          val _=case prepared of Final.Prepared owner=>saved:=SOME owner
            | _=>()
        in action held data prepared end) ()
      val cleanup=Exn.capture(fn()=>case !saved of
          SOME owner=>Final.close owner | NONE=>VP.close held) ()
    in case outcome of Exn.Exn primary=>raise primary
      | Exn.Res result=>(Exn.release cleanup;result)end
  fun need_name (Receiver.CurrentSourceTransport _)="CurrentSourceTransport"
    | need_name (Receiver.OriginalSourceProgramme _)="OriginalSourceProgramme"
    | need_name (Receiver.SourceOpening _)="SourceOpening"
    | need_name (Receiver.ScopedBinding _)="ScopedBinding"
    | need_name (Receiver.ResolutionProgramme _)="ResolutionProgramme"
    | need_name (Receiver.SpecializationProgramme _)="SpecializationProgramme"
    | need_name (Receiver.BinderAdmission _)="BinderAdmission"
    | need_name (Receiver.SpecializationAdmission missing)=
        (case missing of
           SmtReplayOwnedValueSpecialize.RetainedOriginalSource _=>
             "Specialization.RetainedOriginalSource"
         | SmtReplayOwnedValueSpecialize.AtomicFalseOperand _=>
             "Specialization.AtomicFalseOperand"
         | SmtReplayOwnedValueSpecialize.SourceInstance _=>
             "Specialization.SourceInstance"
         | SmtReplayOwnedValueSpecialize.ArgumentProgramme _=>
             "Specialization.ArgumentProgramme"
         | SmtReplayOwnedValueSpecialize.SourceProfile _=>
             "Specialization.SourceProfile"
         | SmtReplayOwnedValueSpecialize.RetainedOperand _=>
             "Specialization.RetainedOperand")
  fun ready (Final.Prepared owner)=owner
    | ready (Final.ReplayNeeds missing)=
        (print ("OWNED420_NEEDS " ^
           String.concatWith "," (List.map need_name missing) ^ "\n");
         raise Fail "unexpected replay programme")
  fun proved (Final.Proved result)=result
    | proved (Final.RealizationNeeds _)=
        raise Fail "unexpected original Source realization programme"
  fun canonical_hyp (e:env) theorem =
    let val allowed=S.assumption_nodes (#sources e)
    in List.all(fn term=>List.exists(fn node=>Portable.pointer_eq
      (term,G.representative (#graph e) node))allowed)(Thm.hyp theorem)end
  fun checked (e:env) theorem =
    (S.check_goal (#sources e) theorem;
     require "finalizer did not retain exact original Goal/canonical Hyp"
       (Portable.pointer_eq(Thm.concl theorem,
          #2(S.original_goal (#sources e)))andalso canonical_hyp e theorem
        andalso null(Tag.axioms_of(Thm.tag theorem))))
  fun quant sort body left right=
    "(quant-intro (proof-bind (lambda ((x " ^ sort ^ ")) " ^ body ^
    ")) (= (lambda ((a " ^ sort ^ ")) " ^ left ^
    ") (lambda ((b " ^ sort ^ ")) " ^ right ^ ")))"
  val bool_quant=quant "Bool" "(refl (= x x))" "a" "b"
  val int_quant=quant "Int" "(refl (= x x))" "a" "b"
  fun alias_quant body="(quant-intro (proof-bind " ^
    "(lambda ((x Bool)) " ^ body ^ ")) p)"
  fun shared_target body="(let ((f (lambda ((a Bool)) a))) " ^
    "(let ((p (= f f))) " ^ body ^ "))"
  fun certificate body="((proof " ^ body ^ "))"
  fun inspecting (e:env) text action=
    let val held=packet e text
        val outcome=Exn.capture(fn()=>
          let val data=W.with_step(#work e)(fn()=>
                VP.contents_with_policy_for(#work e)(#query e)held)
          in action held data end)()
        val cleanup=Exn.capture VP.close held
    in case outcome of Exn.Exn primary=>raise primary
      | Exn.Res value=>(Exn.release cleanup;value)end
  val a=Term.mk_var("owned420_a",Type.bool)
  val b=Term.mk_var("owned420_b",Type.bool)
  val goal=Term.mk_var("owned420_goal",Type.bool)
  val alias=boolSyntax.mk_disj(a,b)
  val x=Term.mk_var("owned420_x",Type.bool)
  val universal=boolSyntax.mk_forall(x,alias)
  val bindings=[("a",a),("b",b),("alias",alias),("U",universal)]
  val assumptions=[universal,boolSyntax.mk_neg alias]
  fun retained target body=
    "(let ((@q ((_ quant-inst false) (or (not U) " ^ target ^ ")))) " ^
    "(let ((@c (unit-resolution @q (asserted U) " ^ target ^ "))) " ^
    body ^ "))"
  fun bound child body=shared_target
    ("(let ((@b " ^ alias_quant child ^ ")) " ^
     "(let ((@t (mp @b (iff-true @b (= p true)) true))) " ^ body ^ "))")
  val identity="(refl (= x x))"
  val binder_text=certificate(bound identity
    "(unit-resolution (asserted (not true)) @t false)")
  val retained_text=certificate(retained "(or a b)"
    "(unit-resolution (asserted (not alias)) @c false)")
  val combined_text=certificate(bound identity(retained "(or a b)"
    "(unit-resolution (asserted (not alias)) @c @t false)"))
  fun exact_goal e {theorem,dependencies}=(checked e theorem;
    require "closed witnesses were relabeled as original Sources"
      (dependencies=[P.Current 0,P.Current 1]andalso
       length(Thm.hyp theorem)=2))

  val nontrivial_child="(trans (refl (= x x)) " ^
    "(symm (refl (= x x)) (= x x)) (= x x))"
  val general_combined=certificate(bound nontrivial_child
    (retained "(or a b)"
      "(unit-resolution (asserted (not alias)) @c @t false)"))
in
  (* Root assigns the next genuine contiguous ordinal; the original420
     controls remain byte-exact in their already integrated group. *)
  val _=run_postlude 427 "owned-general-child-retained-raw-1"(fn()=>
    test "General child retained App SPEC and raw clause share original Goal"
      (fn()=>fixture bindings assumptions goal(fn e=>
        let val prior=Count.thm_count()
        in using e general_combined(fn _=>())
          (fn _=>fn _=>fn preparation=>
            let val owner=ready preparation
                val result=proved(Final.finish_with_policy(#work e)owner)
                val current=Count.thm_count()
                val _=exact_goal e result
            in require "combined actual child/SPEC/raw programme bypassed"
              (#ABS current= #ABS prior+1 andalso
               #SPEC current= #SPEC prior+1 andalso
               #TRANS current> #TRANS prior andalso
               not(#retired(W.audit_policy(#work e))))end)end)))
end


