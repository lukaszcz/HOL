      val options:F.policy_options={graph=g,scope=r,logic="ALL",
        sources=[("p",p),("q",q),("z",z),("alias",alias)],
        sorts=Redblackmap.mkDict String.compare,binder_lists=[],
        import_limit=RP.Uncapped,literal_limit=RP.Uncapped,
        binder_limit=RP.Uncapped,
        recipe_limits={template_limit=RP.Uncapped,index_limit=RP.Uncapped,
          operand_limit=RP.Uncapped,token_limit=RP.Uncapped},
        special=fn _=>fn _=>NONE,ascribed=fn _=>fn _=>fn _=>NONE}
      val session=F.create_session_with_policy options
        {solver="Z3",version="4.15.3",policy=F.Z3,reserved_names=[]}
        (fn()=>raise Fail "unexpected resolution reader call")
      fun parse text=
        let val stream=TextIO.openString text
            val result=Exn.capture(#parse_from session)
              (Parser.make_proof_stream_tokenizer stream)
            val _=TextIO.closeIn stream
        in Exn.release result end
      val parsed=List.map parse texts val wanted=parse target
      val s=S.new_with_policy g r RP.Uncapped
        {goal=boolSyntax.T,assumptions=List.map
          (fn(value:F.term)=>G.representative g(#node value))parsed}
      val policy:RP.semantic_policy={input_limit=RP.Uncapped,
        output_limit=RP.Uncapped,template_limit=RP.Uncapped}
      val w=W.begin_with_policy g r s
        {limits=policy,work_limit=RP.Uncapped}
      (* These named compact programmes have template role. Tiny input /
         output limits may not become an expanded whole-Source cutoff. *)
      val nc=NC.capture w{semantic_limits={input_limit=1,
        output_limit=1,template_limit=1000000},import_limit=1000000,
        type_work_limit=type_limit}
      val frame=Scope.root_with_policy w
      val occurrences=List.map(C.discover_recorded_with_policy w frame)parsed
      val target=C.discover_target_with_policy w frame wanted
      val roots= #node wanted::List.concat(List.map
        (C.roots_with_policy_for w)(target::occurrences))
      val frontier=P.prepare_scoped_original_realization_frontier_with_policy
        w{frame=frame,roots=roots,additional_sources=[],closed_facts=[],
          conversions=[]}
      val block=W.with_step w(fn()=>
        let val tables=P.prepare_owned_realization_tables_with_policy
              w frontier
            val plan=P.prepare_native_realization_freeze_with_policy w
              {tables=tables,contract=nc,profiles=[],ordinal=0,
               check_type=fn _=>()}
        in P.freeze_owned_realization_tables_with_policy w plan end)
      val edges=W.with_step w(fn()=>List.tabulate(List.length parsed,
        P.source block))
      val inputs=ListPair.mapEq(fn(saved,edge)=>
        C.from_source_with_policy w block saved edge)(occurrences,edges)
    in{g=g,r=r,s=s,w=w,nc=nc,frame=frame,block=block,
