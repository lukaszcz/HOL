    "(step @last false :rule not_not_elim :premises (@nn) :args (0)))"
  val inferred="((assume @nn (not (not (and p q p)))) "^
    "(assume @e qe) "^
    "(step @selected :rule not_not_elim :premises (@nn)) "^
    "(step @q q :rule and_elim :premises (@selected) :args (1)) "^
    "(step @last false :rule eq_resolve :premises (@q @e)))"
