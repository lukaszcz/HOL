     source aliases have no G raw metric, so this oracle checks their actual
     small retained term under the same hard64 visitor. Never used below
     by the large Mapping test or by production parser construction. *)
  fun native_raw (e:env) node =
    let val raw = G.representative (#graph e) node
    in case SmtReplayImport.bounded_raw_size 64 raw of
        SOME _ => raw
      | NONE => raise Fail "native small grammar oracle exceeded64" end
  (* Only the named SMALL fixtures below use this oracle. The large test
     never invokes it. The hard unfolded64 bound precedes every constructor. *)
  fun value_raw context value =
    let val remaining = ref 64
        fun raw value =
          let val _ = require "value small grammar oracle exceeded64"
                (!remaining>0)
              val _ = remaining := !remaining-1
          in case PV.view context value of
              PV.Constant atom => atom | PV.Variable (_,atom) => atom
            | PV.Application (function,argument) =>
                Term.mk_comb (raw function,raw argument)
            | PV.Abstraction {binder,body,...} =>
                Term.mk_abs (raw binder,raw body)
            | PV.RetainedGraph =>
                raise Fail "small grammar oracle unexpectedly retained native"
          end
    in raw value end
