    let val g=G.new () val r=G.root_scope g
        val s=S.new_with_policy g r RP.Uncapped
          {goal=goal,assumptions=assumptions}
        val w=W.begin_with_policy g r s
          {limits=limits,work_limit=RP.Uncapped}
        val prepared=Producer.prepare_compact_native_stage_with_policy
          w (request input callback) {import_limit=RP.Uncapped}
        val native=Producer.native_contract_with_policy_for w prepared
    in {g=g,r=r,s=s,w=w,prepared=prepared,native=native} end
  fun start g r s w native callback=
    let val view=G.record_opened_view_with_policy g r (RP.AtMost 100000)
          (hd(S.assumption_nodes s))
        val owner=T.begin_with_policy w
          {native_contract=native,profiles=[],check_type=callback,
           scope_opened=fn _=>()}
    in (owner,view) end
  fun run term wanted=
    let val e=setup boolSyntax.T [term] 100000 (fn _=>())
        val w= #w e
        val (owner,view)=start (#g e) (#r e) (#s e) w (#native e) (fn _=>())
        val result=valOf(T.run_recursive_scope_beta_assumption_with_policy
          owner {occurrence=1,view=SOME view})
        val target=T.target_with_policy_for w owner result
        val conversion=T.source_conversion_with_policy_for w owner result
        val _=P.validate_conversion_for w conversion
    in require "scoped traversal lost canonical original Source"
      (P.conversion_source conversion=hd(S.assumption_nodes(#s e)) andalso
       P.conversion_target conversion=target andalso
       Term.aconv (G.representative (#g e) target) wanted andalso
       not(#retired(W.audit_policy w))) end
