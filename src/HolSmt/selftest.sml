        val node = recorded g s (Thm.concl theorem)
        val law = P.record_closed g s
          {node = node,theorem = theorem,template_limit = limit,
           check_type = fn _ => ()}
        val operand = #node (G.import g s limit boolSyntax.T)
        val primary = ref ()
        fun callback _ = (calls := !calls+1;G.close_scope g s;
          if failure then raise Primary primary else ())
        val refused = (ignore (P.specialize_closed law
            {operands = [operand,operand],check_type = callback});false)
          handle Feedback.HOL_ERR _ => not failure
            | Primary token => failure andalso token = primary
    in ensure "retired SPEC scope allowed later callbacks or masked primary"
      (refused andalso !calls = 1) end
