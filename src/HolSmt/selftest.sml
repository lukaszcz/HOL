  val _=run_postlude 413 "shared-value-cpc-public-finalization-8"(fn()=>
    let
      val _=test "Actual CPC receiver reaches the exact non-atomic Goal"
        (fn()=>fixture[double]goal(fn e=>
          let val final_phase=ref(SOME(Count.thm_count()))
          in using e ordinary
          (fn _=>final_phase:=SOME(Count.thm_count()))
          (fn _=>fn _=>fn prepared=>
            let val owner=ready prepared val prior=Count.thm_count()
                val _=final_phase:=NONE
                val result=proved(Final.finish_with_policy(#work e)owner)
                val after_count=Count.thm_count()
                val last=case !final_phase of SOME count=>count
                  | NONE=>raise Fail "actual final Goal Type callback absent"
                val _=checked e(#theorem result)
                val actual=G.representative(#graph e)
                  (hd(S.assumption_nodes(#sources e)))
            in require "CPC finalizer bypassed original Source/Goal proof"
              (#dependencies result=[P.Current 0]andalso
               length(Thm.hyp(#theorem result))=1 andalso
               Term.aconv actual double andalso
               not(Term.aconv actual boolSyntax.F)andalso
               #CCONTR after_count> #CCONTR prior andalso
               #CCONTR after_count= #CCONTR last+1 andalso
               #SYM after_count= #SYM last andalso
               #EQ_MP after_count= #EQ_MP last andalso
               #total after_count= #total last+1 andalso
               not(#retired(W.audit_policy(#work e))))end)end))
      val _=test "Shared CPC introductions retain their real Source lineage"
        (fn()=>fixture[double]goal(fn e=>using e introduced(fn _=>())
          (fn _=>fn _=>fn prepared=>
            let val result=proved(Final.finish_with_policy(#work e)
