  structure G=SmtReplayGraph
  structure S=SmtReplaySource
  structure W=SmtReplayInvocationWork
  structure RP=SmtReplayResourcePolicy
  structure NC=SmtReplayNativeContract
  val cap=10000
  val policy:RP.semantic_policy={input_limit=RP.Uncapped,
    output_limit=RP.Uncapped,template_limit=RP.Uncapped}
  val ordinary:NC.limits=
    {semantic_limits={input_limit=cap,output_limit=cap,template_limit=cap},
     import_limit=cap,type_work_limit=2000000}
  type fixture={g:G.graph,r:G.scope,s:S.sources,w:W.portfolio,
    contract:NC.contract,binder:G.node,body:G.node,frame:G.scope,
    profiles:G.policy_opaque_profile list,term:Term.term}
  fun require text yes=if yes then () else raise Fail text
  fun test label action=(testutils.tprint label;action();testutils.OK())
  fun message action=(ignore(action());NONE)
    handle Feedback.HOL_ERR detail=>SOME(Feedback.message_of detail)
  (* Prior genuine graph/profile construction is an explicit bounded test
     prerequisite, not credit against the later invocation/native contract. *)
  fun setup rigid closed limits:fixture=
    let val g=G.new() val r=G.root_scope g
        val s=S.new_with_policy g r RP.Uncapped
          {goal=boolSyntax.T,assumptions=[]}
        val x=Term.mk_var("profiled_fv_x",Type.bool)
        val frame=G.new_scope g r []
        val binder=G.variable g frame G.Bound x
        val body_frame=G.new_scope g frame [(x,binder)]
        val z=Term.mk_var("profiled_fv_z",Type.bool)
        val term=Term.mk_abs(z,boolSyntax.mk_neg(if closed then z else x))
        val origin=if rigid then r else body_frame
        val body= #node(G.import_with_policy g origin
          (RP.AtMost(IntInf.fromInt cap)) term)
        val q=Term.mk_var("profiled_fv_q",Type.bool)
        val beta=Term.mk_comb(Term.mk_abs(q,q),boolSyntax.T)
        val wrapper=boolSyntax.mk_conj(boolSyntax.mk_eq(term,term),beta)
        val raw=G.import_with_policy g origin
          (RP.AtMost(IntInf.fromInt cap)) wrapper
        val discovery=G.discover_partial_with_policy g origin
          {original= #node raw,maximum=RP.AtMost(IntInf.fromInt cap),
           scan_limit=RP.AtMost 2000000,step=fn()=>()}
        val profiles=G.partial_profiles_with_policy g origin discovery
        val _=require "fixture did not retain genuine opaque body"
          (case G.view g body of G.OpaqueRetained=>true | _=>false)
        val _=require "fixture has no genuine metric profile"
          (not(null profiles))
        val w=W.begin_with_policy g r s {limits=policy,work_limit=RP.Uncapped}
        val contract=NC.capture w limits
    in {g=g,r=r,s=s,w=w,contract=contract,binder=binder,body=body,
        frame=body_frame,profiles=profiles,term=term} end
  fun construct(e:fixture) maximum available extra=
    W.with_step (#w e) (fn()=>
      let val limits=NC.for_work (#w e) (#contract e)
          fun step()=(NC.validate_for (#w e) (#contract e);
            W.spend_policy (#w e) 1;extra();
            NC.validate_for (#w e) (#contract e))
      in G.recorded_abstraction_with_profile_policy (#g e) (#r e)
        {maximum=maximum,native_limit= #output_limit(#semantic_limits limits),
         type_work_limit= #type_work_limit limits,binder= #binder e,
         body= #body e,body_frame= #frame e,profiles=available,step=step} end)
  fun positive closed=
    let val e=setup false closed ordinary
        val result=construct e RP.Uncapped (#profiles e) (fn()=>())
        val data=G.binder_closure_data (#g e) (#r e)
          (G.binder_closure (#g e) (#r e) result)
        val wanted=Term.mk_abs(G.representative (#g e) (#binder e),#term e)
    in require "profiled binder lost actual body/frame or native term"
      (#body data= #body e andalso #body_frame data= #frame e andalso
       #binder data= #binder e andalso
       Term.aconv(G.representative (#g e) result) wanted andalso
       not(#retired(W.audit_policy (#w e)))) end
in
  val _ = run_postlude 285 "policy-profiled-binder-free-variables-8" (fn () =>
    let
  val _=test "Profiled binder constructs a genuine closed opaque body"
