              val token = ref () val calls = ref 0 val child = ref NONE
          in fixture boolSyntax.T
            (fn e => fn context => fn backend =>
              let val binder = (#genvar context) Type.bool
                  val _ = child := Option.map #scope
                    ((#graph_node context) binder)
