                   maximum=RP.AtMost(IntInf.fromInt
                     (#template_limit(#semantic_limits limits))),
                   scan_limit=RP.AtMost(IntInf.fromInt(#type_work_limit limits)),
                   step=fn()=>W.spend_policy work 1})
          in G.partial_profiles_with_policy graph frame discovery end else []
        val theorem=Thm.BETA_CONV(G.representative graph body)
        val right=case G.view graph body of G.Application(_,argument)=>argument
          | _=>raise Fail "fixture body not actual beta application"
        val (a,b)=boolSyntax.dest_eq(Thm.concl theorem)
        val _=require "fixture canonical body endpoint association"
          (Portable.pointer_eq(a,G.representative graph body) andalso
           Portable.pointer_eq(b,G.representative graph right))
        val head=G.constant graph frame (Term.rator(Term.rator(Thm.concl theorem)))
        val equation=G.application graph frame
          (G.application graph frame (head,body),right)
        val fact=P.record_closed_with_policy_profiles graph frame
          {node=equation,theorem=theorem,template_limit=RP.Uncapped,
           profiles=profiles,check_type=fn _=>()}
    in {graph=graph,scope=scope,sources=sources,work=work,native=contract,
        admission=admission,fact=fact,body=body,right=right,frame=frame,
        child=child,profiles=profiles,theorem=theorem} end
