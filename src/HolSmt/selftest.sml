(* The paid Z3 entry owns a real caller handoff before its pre callback. *)
local
  structure A = SmtReplayOriginalAcquisition
  structure G = SmtReplayGraph
  structure S = SmtReplaySource
  structure W = SmtReplayInvocationWork
  structure NC = SmtReplayNativeContract
  structure RP = SmtReplayResourcePolicy
  structure F = SmtLib_GraphSourcePortfolio
  structure GP = SmtLib_GraphPreprocess
  structure CG = SmtCheckedGraph
  val ample = 20000000
  val cap = RP.AtMost (IntInf.fromInt ample)
  val native : NC.limits =
    {semantic_limits={input_limit=ample,output_limit=ample,
       template_limit=ample},import_limit=ample,type_work_limit=ample}
  fun begin work_limit =
    let val owned : A.request =
          {construction_limits={import_limit=cap,literal_limit=cap,
             binder_limit=cap,recipe_limits={template_limit=cap,
               index_limit=cap,operand_limit=cap,token_limit=cap}},
           semantic_limits={input_limit=cap,output_limit=cap,
             template_limit=cap},work_limit=work_limit,
           native_limits={semantic_limits={input_limit=cap,
             output_limit=cap,template_limit=cap},import_limit=cap,
             type_work_limit=cap}}
    in CG.begin_children_first_boolean_application
      {owned=owned,native=native}
      {function=boolSyntax.negation,argument=boolSyntax.F} end
  fun require message yes = if yes then () else raise Fail message
  fun test label action =
    (testutils.tprint label;action ();testutils.OK ())
  fun hol_error action =
    (ignore (action ());NONE)
    handle Feedback.HOL_ERR detail => SOME (Feedback.message_of detail)
  type held_owner = (W.portfolio * G.graph * G.scope) option ref
  fun remember (held : held_owner) work sources =
    let val {graph,scope} = S.owner_for_scope_guard sources
    in held := SOME (work,graph,scope) end
  fun discover held calls work contract sources =
    (calls := !calls + 1;
     remember held work sources;
     W.with_step work (fn () =>
       let val _ = NC.validate_for work contract
           val {assumptions,denied} = F.originals_with_policy work
           val portfolio = F.validate_portfolio_with_policy work
             {assumptions=assumptions,goal= #node (S.goal_source sources),
              denied=denied}
       in GP.from_portfolio_with_policy work portfolio end))
  fun options calls () : CG.policy_replay_options =
    (calls := !calls + 1;
     {profiles=[],check_type=fn _ => (),ordinal=0})
  fun lifetime (held : held_owner) = case !held of
      NONE => false
    | SOME (work,graph,scope) =>
        let val retired = #retired (W.audit_policy work)
            val closed = (G.validate_scope graph scope;false)
              handle Feedback.HOL_ERR _ => true
            (* Observe the actual owner before cleaning a failed control. *)
            val _ = W.close work
            val _ = G.close_scope graph scope handle _ => ()
        in retired andalso closed end
  fun invoke handoff callback prepare_options goal =
    Z3.Z3_SMT_Caller_Owned_Source_Paid_Prover_With_Policy
      {handoff=handoff,discover=callback,prepare_options=prepare_options} goal
in
  val _ = run_postlude 342 "paid-z3-wrapper-handoff-cleanup-4" (fn () =>
    if not (Z3.is_configured ()) then
