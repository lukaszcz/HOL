  fun fixture_with unmatched negative wide inspect =
    let
      val variable = ``actual_dependency_p:bool``
      val universal = boolSyntax.mk_forall (variable,variable)
      val premise = boolSyntax.mk_conj (universal,boolSyntax.T)
      val graph = G.new () val scope = G.root_scope graph
      val sources = S.new graph scope 512
        {assumptions=[premise,premise],goal=variable}
      val work = W.begin_with_scope_guard graph scope sources
        {limits={input_limit=512,output_limit=512,template_limit=512},
         work_limit=10000000}
      val local_calls = ref 0 val forced = ref 0
      val forced_live = ref false
      val outcome = Exn.capture (fn () =>
        let
          val input = SmtLib_GraphPreprocess.discover_from_sources
            graph scope sources {import_limit=512,revisit=false,
              check_type=fn _ => (),conversion=fn _ => NONE}
          fun imported term = #node (G.import graph scope 512 term)
          val positive = imported variable
          val h = imported universal
          val target = if negative then h else positive
          val source = hd (S.assumption_nodes sources)
          val denied = S.denied_goal_node sources
          val result_node = if wide then G.application graph scope
              (G.application graph scope
                (G.constant graph scope boolSyntax.conjunction,positive),
               G.constant graph scope boolSyntax.T)
            else target
          fun located node:F.term =
            {node=node,scope=scope,binder_blocks=[],
             occurrence=SmtLib_Parser.ConstructionOccurrence
               {value=node,role=SmtLib_Parser.ConstructionAtom,
                token="@actual-dependency",children=[]}}
          fun registered name = case CPC_Proof.lookup_rule "1.3.4" name of
              SOME rule => rule | NONE => raise Fail "missing fixture rule"
          fun command id rule premises node = Q.GraphStep
            {pop=false,step={id=id,rule=registered rule,premises=premises,
              conclusion=SOME (located node),
              args=if rule="trust" then [Q.GraphTerm (located node)] else [],
              raw_conclusion=NONE,raw_args=[]}}
          val proof:Q.graph_proof =
            {cvc_version="1.3.4",commands=
              [Q.GraphAssume ("@source",located source),
               Q.GraphAssume ("@denied",located denied),
               command "@need" "trust" [] target,
               command "@proved" "bool"
                 (if unmatched orelse negative then ["@need"]
                  else ["@source","@need"]) h]
              @ (if wide then [command "@wide" "trust"
                  (List.tabulate (30,fn _ => "@need")) result_node] else [])
              @ [command "@finish" "trust"
                   [if wide then "@wide" else "@need","@denied"]
                   (G.constant graph scope boolSyntax.F)]}
          fun assumed (term:CPC_Proof.located_term) = Thm.ASSUME (#term term)
          fun worker (request,inputs) =
            let val request:CPC_Proof.step = request
                val _ = local_calls := !local_calls+1
                val from_h = Thm.SPEC variable (Thm.ASSUME universal)
                val theorem = case #id request of
                    "@need" => if negative then
                        Thm.ASSUME universal else from_h
                  | "@wide" =>
                      let val incoming = assumed (hd inputs)
                          val p = if negative then Thm.SPEC variable incoming
                            else incoming
                      in Thm.CONJ p boolTheory.TRUTH end
                  | "@finish" =>
                      (case inputs of [incoming,denial] =>
                         let val incoming = assumed incoming
                             val p = if wide then Thm.CONJUNCT1 incoming
                               else if negative then Thm.SPEC variable incoming
                               else incoming
                         in Thm.MP (Thm.NOT_ELIM (assumed denial)) p end
                       | _ => raise Fail "final fixture arity")
                  | _ => raise Fail "unexpected native fixture worker"
            in (theorem,valOf (#conclusion request)) end
          fun force (request,_) =
            let val _ = forced := !forced+1
                val _ = forced_live := not (#retired (W.audit work))
                val theorem = Thm.CONJUNCT1
                  (Thm.ASSUME (G.representative graph source))
            in (theorem,valOf
              (#conclusion (request:CPC_Proof.step))) end
          val result = Exn.capture (fn () =>
            R.check_contradiction_preprocessed_observed_with_work_using work
              {graph=graph,scope=scope,sources=sources,preprocessing=input,
               proof=proof,ordinary_limit=512,template_limit=512,
               worker=worker,force_worker=SOME force}) ()
        in inspect {graph=graph,scope=scope,sources=sources,work=work,
          result=result,forced= !forced,forced_live= !forced_live,
          local_calls= !local_calls} end) ()
      val cleanup = Exn.capture (fn () =>
        (W.close work;G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res value => (Exn.release cleanup;value) end
  fun fixture negative wide inspect =
