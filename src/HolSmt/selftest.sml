           Portable.pointer_eq (H.typed_theorem instance,theorem) andalso
           Portable.pointer_eq (H.selected_original instance,theorem) andalso
           null (H.substitution instance) andalso
           !calls = length (#typed_annotations metadata) andalso !calls > 1
           andalso H.charged p <= cap andalso
           #input_limit (W.semantic_limits w) = 5 andalso
           not (#retired (W.audit w)))
        val charged = #charged (W.audit w)
        val rejected = refuses (fn () => H.execute plan)
    in ensure "identity instance plan reissued or charged second execution"
      (rejected andalso #charged (W.audit w) = charged) end
  fun carrier term fixed =
    let val g = G.new () val s = G.root_scope g
        val sources = S.new g s 50000 {goal = term,assumptions = [term]}
        val view = G.record_opened_view g s 50000
          (hd (S.assumption_nodes sources))
        val imported = G.import g s cap (Thm.concl fixed)
        val opened = G.record_opened_view g s cap (#node imported)
        val law = P.record_closed_from_import g s
