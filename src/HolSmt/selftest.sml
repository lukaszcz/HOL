  (* Independent native proofs are confined to these small fixtures. Both
     endpoint views are genuine checked graph registrations. *)
  fun conversion (e:env) scope source prove =
    let val graph = #graph e
        val raw = G.representative graph source
        val theorem = prove raw
        val (left,right) = boolSyntax.dest_eq (Thm.concl theorem)
        val target = #node (G.import_with_policy graph scope RP.Uncapped right)
        val theorem = Thm.TRANS (Thm.ALPHA raw left)
          (Thm.TRANS theorem (Thm.ALPHA right
            (G.representative graph target)))
        val source_view = G.record_opened_view_with_policy graph scope
          RP.Uncapped source
        val target_view = G.record_opened_view_with_policy graph scope
          RP.Uncapped target
        val receipt = P.record_conversion_with_policy graph scope
          {source=source,source_view=source_view,target=target,
           target_view=target_view,theorem=theorem,
           template_limit=RP.Uncapped,check_type=fn _ => ()}
    in {receipt=receipt,target=target,theorem=theorem} end
  fun paired (e:env) =
    let val positive = conversion e (#scope e)
          (#node (S.goal_source (#sources e))) EVAL
        val negative = conversion e (#scope e)
          (S.denied_goal_node (#sources e))
          (fn _ => Thm.AP_TERM boolSyntax.negation (#theorem positive))
    in (positive,negative) end
  fun realize (e:env) value target =
    let val work = #work e
        val preprocessing = GP.from_portfolio_with_policy work value
        val frontier = GP.prepare_final_frontier_with_policy work
          preprocessing {roots=[]}
        val tables = W.with_step work (fn () =>
          P.prepare_owned_realization_tables_with_policy work frontier)
        val preparation = W.with_step work (fn () =>
          P.prepare_native_realization_freeze_with_policy work
            {tables=tables,contract= #contract e,profiles=[],ordinal=0,
             check_type=fn _ => ()})
        val block = W.with_step work (fn () =>
          P.freeze_owned_realization_tables_with_policy work preparation)
        val assemble = GP.assembler_with_policy work preprocessing block
        val edge = case assemble target of SOME edge => edge
          | NONE => raise Fail "transported query fact was not assembled"
        val proof = W.with_step work (fn () =>
          P.policy_source_realization_theorem_for work
            (P.execute_realization_with_policy work
              (P.prepare_realization_with_policy work block target edge)))
    in (preprocessing,proof) end
