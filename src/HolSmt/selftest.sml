                (operations (Type.--> (intSyntax.int_ty,Type.bool)))
                L.FirstOrder () 1 "ranked"
              val ranked_order = List.rev (!trace)
              val _ = trace := []
              val _ = metadata (operations Type.bool)
                L.FirstOrder () 0 "atomic"
              val atomic_order = List.rev (!trace)
              val _ = trace := []
              val malformed = (ignore (metadata (operations Type.bool)
                L.FirstOrder () 1 "malformed");false)
                handle Feedback.HOL_ERR _ => true
          in require "sort override skipped a prior observation or type error"
            (ranked_order=["type","recorded"] andalso
             atomic_order=["string","float","type","recorded"] andalso
             #domain_sorts ranked=["Captured"] andalso
             #range_sort ranked="Result" andalso malformed andalso
             List.rev (!trace)=["type"]) end)
      val _ = test "Injected sorts and HO declaration syntax remain shared"
        (fn () =>
          let val types = Redblackmap.mkDict Type.compare
              val native = L.outbound_term_declaration_operations
                L.FirstOrder types
              val operations =
                {type_of= #type_of native,
                 is_injected_string= #is_injected_string native,
                 is_injected_float= #is_injected_float native,
                 recorded_sorts=fn _ => NONE,
                 sort_of_type=fn _ =>
                   raise Fail "injected result used a residual sort"}
              val string = metadata operations L.FirstOrder
                ``str_inj (metadata_string_source:string)`` 0 "injected_s"
              val floating = metadata operations L.FirstOrder
                ``(smtfp_intro (metadata_float:(4,3) binary_ieee$float)
                    : (4,3) smtfp)`` 0 "injected_f"
              val ho = L.outbound_term_declaration_text
                (L.HigherOrder L.Standard27) "native_constant" [] "Bool"
              val array = L.outbound_term_declaration_text
                (L.HigherOrder L.Z3LambdaArray) "array_constant" [] "Bool"
          in require "injected sort or declaration syntax changed"
            (#range_sort string="String" andalso
             #range_sort floating="(_ FloatingPoint 3 5)" andalso
             ho="(declare-const native_constant Bool)\n" andalso
             array="(declare-fun array_constant () Bool)\n") end)
      val _ = test "RegLan feature alone does not invent a string record"
        (fn () =>
          let val (regex_flags,regex) = check_advanced L.FirstOrder false
                ``!metadata_regex:smtstring$reglan. T``
              val (_,strings) = check_advanced L.FirstOrder true
                ``!metadata_native_string:smtstring$smtstr. T``
              val L.LogicFeatures {strings=regex_feature,...} = regex_flags
              val _ = List.app (fn regime =>
                ignore (check_advanced regime false
                  ``(metadata_set:num -> bool) UNION metadata_set_other =
                    metadata_set_other UNION metadata_set``))
                [L.FirstOrder,L.HigherOrder L.Standard27,
                 L.HigherOrder L.Z3LambdaArray]
          in require "Unicode feature conflated RegLan and string presence"
            (regex_feature andalso not (has_theory "UnicodeStrings" regex)
             andalso has_theory "UnicodeStrings" strings andalso
             has_theory "UnicodeStrings RegLan" regex) end)
      val _ = test "Metadata callback Primary escapes before later callbacks"
        (fn () =>
          let exception Primary of unit ref
              val token = ref () val trace = ref ([]:string list)
              fun note event = trace := event :: !trace
              val operations =
                {type_of=fn () => (note "type";Type.bool),
                 is_injected_string=fn () => (note "string";false),
                 is_injected_float=fn () =>
                   (note "float";raise Primary token),
                 recorded_sorts=fn _ => (note "recorded";NONE),
                 sort_of_type=fn _ => (note "sort";"Bool")}
              val exact = (ignore (metadata operations
                L.FirstOrder () 0 "primary");false)
                handle Primary actual => Portable.pointer_eq (actual,token)
          in require "metadata caught Primary or observed later query data"
            (exact andalso List.rev (!trace)=["string","float"]) end)
    in () end)
end

local
  structure G = SmtReplayGraph
  structure S = SmtReplaySource
  structure W = SmtReplayInvocationWork
  structure V = SmtLib_GraphSourcePortfolio
