      val _ = test "Synthesized emod observations retain exact durable IDs"
        (fn () => fixture boolSyntax.T
          (fn e => fn context => fn backend =>
            let val current = application context
                  ((#constant context) intSyntax.divides_tm)
                  [integer context 2,integer context 7]
            in #1 (emit e context backend SmtLib.FirstOrder current) end)
          (fn _ => fn outcome =>
            let val value = Exn.release outcome val mapping = MD.mapping value
                val emod = Term.prim_mk_const {Thy="integer",Name="emod"}
                fun matches (event:MD.encoding) =
                  case #atomic_head event of SOME atom =>
