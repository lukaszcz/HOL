             Portable.pointer_eq (Thm.concl theorem,raw e (#p e)) andalso
             length (Thm.hyp theorem)=1 andalso
             Portable.pointer_eq (hd (Thm.hyp theorem),raw e (#p e)) andalso
             null (Tag.axioms_of (Thm.tag theorem))) end))
      val _ = test "Exact prospective Context refuses before native freeze"
        (fn () => owned (fn e =>
          let val truth = G.constant (#graph e) (#scope e) boolSyntax.T
              val huge = List.foldl (fn (_,node) => conjunction e node node)
                truth (List.tabulate (70,fn n => n))
              val prepared = plan e [] [] [huge]
              val prior = Count.thm_count ()
              val footprint = P.source_cut_rule_footprint_for
                (#work e) prepared
              val message = failure (fn () => ignore
                (P.freeze_source_cut_rule_plan (#work e) prepared))
          in require "unfit Context minted proof effects or renewed Work"
            (#raw footprint>IntInf.fromInt cap andalso
             message=SOME "compact context exceeds template bound" andalso
             Count.thm_count ()=prior andalso retired e) end))
      val _ = test "Closed law rejects a reordered actual premise chain"
        (fn () => owned (fn e =>
          let val (_,fact,_) = identity e [#p e,#q e] (#p e)
              val prior = Count.thm_count ()
              val message = failure (fn () => ignore
                (P.prepare_closed_law_spine (#work e)
                  {frame= #frame e,fact=fact,premises=[#q e,#p e],
                   target= #p e}))
          in require "ordered endpoints were guessed from Boolean types"
            (message=SOME
               "ordered law premise or implication head differs" andalso
             Count.thm_count ()=prior andalso retired e) end))
      val _ = test "Closed law requires its exact current target endpoint"
        (fn () => owned (fn e =>
          let val (_,fact,_) = identity e [#p e] (#p e)
              val message = failure (fn () => ignore
                (P.prepare_closed_law_spine (#work e)
                  {frame= #frame e,fact=fact,premises=[#p e],target= #q e}))
          in require "closed theorem certified a different assertion"
            (message=SOME "law target differs" andalso retired e) end))
      val _ = test "Expected Work precedes stale held closed-law backing"
        (fn () => owned (fn held =>
          let val (_,_,spine) = identity held [#p held] (#p held)
              val _ = close held
          in owned (fn expected =>
            let val message = failure (fn () => ignore
                  (P.closed_law_spine_data_for (#work expected) spine))
            in require "foreign law guard activated or retired its owner"
              (message=SOME "different original Work" andalso
               retired expected andalso not (retired held)) end) end))
      val _ = test "Independent ordinary demand dominates a law operand cut"
        (fn () => owned (fn e =>
          let val truth = G.constant (#graph e) (#scope e) boolSyntax.T
              val big = List.foldl (fn (_,node) => conjunction e node node)
                truth (List.tabulate (4,fn n => n))
              val (_,fact,spine) = identity e [big] big
              val small = P.source_cut_rule_footprint_for (#work e)
                (plan e [spine] [] [])
              val ordinary = P.source_cut_rule_footprint_for (#work e)
                (plan e [spine] [] [big])
              val same_fact = P.prepare_source_cut_rule_law_plan (#work e)
                {frame= #frame e,roots=[],additional_sources=[],
                 closed_facts=[fact],conversions=[],receipts=[],targets=[],
                 boolean=false,congruence=false,laws=[spine]}
              val explicit = P.source_cut_rule_footprint_for
                (#work e) same_fact
          in require "closed-law metadata erased an actual ordinary demand"
            (#raw ordinary> #raw small andalso #raw explicit> #raw ordinary
             andalso not (retired e)) end))
      val _ = test "Zero-premise captured law retains no Source hypothesis"
        (fn () => owned (fn e =>
          let val truth = G.constant (#graph e) (#scope e) boolSyntax.T
              val (_,fact,spine) = capture e [] truth boolTheory.TRUTH
              val value = P.freeze_source_cut_rule_plan (#work e)
                (plan e [spine] [] [])
              val block = P.source_cut_block_for (#work e) value
              val edge = W.with_step (#work e) (fn () => P.closed block fact)
              val receipt = P.realize_source_cut_receipt (#work e) value
                truth edge
              val theorem = P.source_realization_theorem_for (#work e) receipt
          in require "closed proof was relabelled as an original Source"
            (null (Thm.hyp theorem) andalso
             S.assumption_nodes (#sources e)=[#p e,#p e] andalso
             Portable.pointer_eq (Thm.concl theorem,raw e truth)) end))
      val _ = test "Exact closed capture imposes no artificial half cap"
        (fn () => owned (fn e =>
          let
            val truth = G.constant (#graph e) (#scope e) boolSyntax.T
            val (node,proof) = List.foldl (fn (_,(node,proof)) =>
              (conjunction e node node,Thm.CONJ proof proof))
              (truth,boolTheory.TRUTH) (List.tabulate (7,fn n => n))
            val proof = align e node proof
            val raw = raw e node
            val _ = require "full-law boundary fixture no longer separates"
              (I.bounded_raw_size cap raw=SOME 509 andalso
               not (Option.isSome
                 (I.bounded_raw_size cap (boolSyntax.mk_eq (raw,raw)))))
            val prior = Count.thm_count () val calls = ref 0
            val fact = W.with_step (#work e) (fn () =>
              P.record_closed_exact (#graph e) (#scope e)
                {node=node,theorem=proof,template_limit=cap,
                 check_type=fn _ => calls := !calls+1})
          in require "exact capture ran avoidable alignment or lost policies"
            (Count.thm_count ()=prior andalso !calls>0 andalso
             Portable.pointer_eq (P.closed_original fact,proof)) end))
      val _ = test "Plan use and selected prefixes retain authentic syntax"
        (fn () => List.app (fn bad_prefix => owned (fn e =>
          let val (_,_,spine) = identity e [#p e] (#p e)
          in if bad_prefix then
              let val prior = Count.thm_count ()
                  val message = failure (fn () => ignore
                    (P.closed_law_spine_prefix_for (#work e) spine 2))
              in require "prefix invented an uncaptured implication shell"
                (message=SOME "actual shell prefix exceeds captured law"
                 andalso Count.thm_count ()=prior andalso retired e) end
            else
              let val prepared = plan e [spine] [] []
                  val _ = P.freeze_source_cut_rule_plan (#work e) prepared
                  val prior = Count.thm_count ()
                  val message = failure (fn () => ignore
                    (P.freeze_source_cut_rule_plan (#work e) prepared))
              in require "a used plan minted another native block"
                (message=SOME "plan already used" andalso
                 Count.thm_count ()=prior andalso retired e) end
          end)) [false,true])
    in () end)
end


