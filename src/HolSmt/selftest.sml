      val options : SmtLib_GraphFrontend.options =
        {graph = graph,scope = scope,logic = "ALL",
         sources = [("p",p),("q",q)],
         sorts = Redblackmap.mkDict String.compare,binder_lists = [],
         import_limit = 512,literal_limit = 512,binder_limit = 512,
         recipe_limits = {template_limit = 512,index_limit = 512,
           operand_limit = 512,token_limit = 512},
         special = fn _ => fn _ => NONE,
         ascribed = fn _ => fn _ => fn _ => NONE}
      val input = TextIO.openString text
