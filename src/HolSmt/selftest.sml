              val _ = require "private epoch canary already exists"
                (not (List.exists (fn term =>
                  #Thy (Term.dest_thy_const term)= #Thy declaration)
                  (Term.decls (#Name declaration))))
              val atom = Term.prim_new_const declaration Type.bool
              val identity = #Name (Term.dest_thy_constid atom)
              val held = ref true val initial = Term.term_epoch ()
              fun retire () = if !held then
                let val current = Term.prim_mk_const declaration
                    val _ = require "epoch canary identity was replaced"
                      (KernelSig.id_compare
                        (identity,#Name (Term.dest_thy_constid current))=EQUAL)
                in Term.prim_delete_const declaration;held := false end
                else ()
              val outcome = Exn.capture (fn () => fixture boolSyntax.T
                (fn e => fn context => fn backend =>
                  metadata e context backend SmtLib.FirstOrder
                    {types=empty_types (),symbols=[],encodings=[],roots=[]})
                (fn _ => fn result =>
