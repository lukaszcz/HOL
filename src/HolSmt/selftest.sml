    require "closed witnesses were relabeled as original Sources"
      (dependencies=[P.Current 0,P.Current 1]andalso
       length(Thm.hyp theorem)=2))
in
  val _=run_postlude 420 "owned-z3-composed-programmes-8"(fn()=>
    let
      val _=test "Actual Bind iff-true MP enters raw proof and original Goal"
