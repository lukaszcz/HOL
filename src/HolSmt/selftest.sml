  fun ensure text yes = if yes then testutils.OK () else testutils.die text
  fun recorded g s term =
    if Term.is_abs term then #node (G.admit_binder g s limit term)
    else if Term.is_comb term then
      let val (f,x) = Term.dest_comb term
      in G.application g s (recorded g s f,recorded g s x) end
    else #node (G.import g s limit term)
  fun record_case failure =
    let val g = G.new () val s = G.root_scope g val calls = ref 0
        val theorem = markerTheory.Abbrev_def
        val node = recorded g s (Thm.concl theorem)
        val _ = ensure "record fixture needs multiple type callbacks"
          (length (G.reachable g [node]) >= 2)
        val primary = ref ()
        fun callback _ = (calls := !calls+1;G.close_scope g s;
          if failure then raise Primary primary else ())
        val refused = (ignore (P.record_closed g s
            {node = node,theorem = theorem,template_limit = limit,
             check_type = callback});false)
          handle Feedback.HOL_ERR _ => not failure
            | Primary token => failure andalso token = primary
    in ensure "retired record scope allowed later callbacks or masked primary"
      (refused andalso !calls = 1) end
