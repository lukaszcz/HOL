  fun type_nodes ty=
    let fun pending [] count=count
          | pending([]::rest)count=pending rest count
          | pending((ty::tail)::rest)count=
            if Type.is_vartype ty then pending(tail::rest)(count+1)
            else let val{Args,...}=Type.dest_thy_type ty
                 in pending(Args::tail::rest)(count+1)end
    in pending[[ty]](0:IntInf.int)end
  fun syntax_metric term=
    let fun pending [] totals=totals
          | pending(term::rest)(r,i,a)=
            let val ann=type_nodes(Term.type_of term)
            in if Term.is_abs term then
                 let val(v,body)=Term.dest_abs term
                 in pending(body::rest)(r+1,i+2,
                      a+ann+type_nodes(Term.type_of v))end
               else if Term.is_comb term then
                 let val(left,right)=Term.dest_comb term
                 in pending(left::right::rest)(r+1,i+1,a+ann)end
               else pending rest(r+1,i+1,a+ann)end
        val(r,i,a)=pending[term](0:IntInf.int,0:IntInf.int,0:IntInf.int)
    in {raw=r,inclusive=i,annotations=a}:P.source_scalar_metrics end
