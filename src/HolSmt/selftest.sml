                {semantic_limits={input_limit=if which=0 then 20 else 1000000,
                   output_limit=if which=1 then 32 else 1000000,
                   template_limit=if which=2 then 32 else 1000000},
                 import_limit=512,type_work_limit=100000000}
          in fixture_after false native
            (fn e => fn outcome =>
