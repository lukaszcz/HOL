                val actual_true=W.with_step(#work e)(fn()=>
                  case #commands(#proof data)of
                    [C.GraphAssume(id,term)]=>
                      id="@t"andalso
                      (case PV.proof_view(#context data)
                          (PV.proof_term(#context data)(#node term))of
                         PV.ProofConstant atom=>
                           Term.same_const atom boolSyntax.T
