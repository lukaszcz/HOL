        val recipe=case #recipe actual of SOME value=>value
          | NONE=>raise Fail "actual changed raw Source recipe missing"
        val result=Core.execute_with_policy(#w e)
          (Core.prepare_in_scope_with_policy(#w e)
            {frame= #frame actual,conversion=recipe,
             ordinal=T.carrier_normalization_ordinal_with_policy_for
               (#w e)(#holder e),native_contract= #native e,
             profiles= #profiles e,check_type=fn _=>()})
        val theorem=Core.theorem_with_policy_for(#w e)result
        val endpoints=Core.conversion_description_with_policy_for(#w e)result
        val(left,right)=boolSyntax.dest_eq(Thm.concl theorem)
        val _=require "Core lost actual complete Source endpoints or NC"
          (#source endpoints= #source actual andalso
           #target endpoints= #target actual andalso
           #source actual= #node(#original actual)andalso
           Portable.pointer_eq(left,
