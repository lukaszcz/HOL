          (calls:= !calls+1;raise Primary token)else())
        val owner=begin_owner e val _=through e owner 2
        val _=armed:=true val prior=Count.thm_count()
        val exact=(ignore(next e owner);false)
          handle Primary held=>Portable.pointer_eq(held,token)
        val first=exact andalso !calls=1 andalso Count.thm_count()=prior
          andalso #retired(W.audit_policy(#w e))
        val run=ref false val entered=ref 0
        val old_block=ref(NONE:P.block option)
        val payer=ref(NONE:W.portfolio option)
        val f=setup direct false false(fn _=>if !run then
          (entered:= !entered+1;case(!payer,!old_block)of
             (SOME w,SOME block)=>P.retire_policy_block_for w block
           | _=>raise Fail "actual callback owner was not installed")else())
        val other=begin_owner f val _=through f other 2
        val actual=E.step_with_policy_for(#w f)other "@e"
        val _=old_block:=SOME(#block actual)val _=payer:=SOME(#w f)
        val _=run:=true val count=Count.thm_count()
        val denied=refused(fn()=>next f other)
    in require "eq_resolve callback changed Primary or escaped old liveness"
      (first andalso denied=SOME "block already realized"andalso
       !entered=1 andalso Count.thm_count()=count andalso
       #retired(W.audit_policy(#w f)))end)
  val _=require "CPC policy equality coverage differs from six"
    (!active_counter_controls=6)
    in () end)
