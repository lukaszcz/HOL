  type environment={g:G.graph,r:G.scope,s:S.sources,w:W.portfolio,
    n:NC.contract}
  fun setup goal assumptions:environment=
    let val g=G.new() val r=G.root_scope g
        val s=S.new_with_policy g r RP.Uncapped
          {goal=goal,assumptions=assumptions}
        val w=W.begin_with_policy g r s
          {limits=policy,work_limit=RP.Uncapped}
        val n=NC.capture w
          {semantic_limits={input_limit=1,output_limit=100000,
            template_limit=8192},import_limit=1000000,
           type_work_limit=4000000}
    in {g=g,r=r,s=s,w=w,n=n}end
  fun freeze(e:environment) ordinal frontier=
    let val w= #w e
        val tables=W.with_step w(fn()=>
          P.prepare_owned_realization_tables_with_policy w frontier)
        val plan=W.with_step w(fn()=>
          P.prepare_native_realization_freeze_with_policy w
            {tables=tables,contract= #n e,profiles=[],ordinal=ordinal,
             check_type=fn _=>()})
    in W.with_step w(fn()=>
      P.freeze_owned_realization_tables_with_policy w plan)end
  fun rule w b opcode operands=W.with_step w(fn()=>
    P.execute_primitive_with_policy w
      (P.prepare_primitive_with_policy w b opcode operands))
  fun finish w b target edge=W.with_step w(fn()=>
    P.execute_realization_with_policy w
      (P.prepare_realization_with_policy w b target edge))
  fun reflexive(e:environment) frame scope node=
    let val g= #g e val w= #w e
        val term=G.representative g node
        val operator=Term.rator(Term.rator(boolSyntax.mk_eq(term,term)))
        val head=G.constant g scope operator
        val equality=G.application g scope(G.application g scope(head,node),
          node)
        val frontier=W.with_step w(fn()=>
          P.prepare_realization_frontier_with_policy w
            {frame=frame,roots=[equality],closed_facts=[],conversions=[]})
        val b=freeze e 0 frontier
        val ctor=W.with_step w(fn()=>P.constructor_with_policy w b equality)
        val reverse=rule w b P.Symmetry [ctor]
        val same=rule w b(P.ReflexiveName node)[]
        val proof=rule w b P.EqualityMP [reverse,same]
    in (equality,finish w b equality proof)end
  fun root_receipt()=
    let val e=setup boolSyntax.T []
        val node=G.constant(#g e)(#r e)boolSyntax.T
        val frame=Scope.root_with_policy(#w e)
        val(equality,receipt)=reflexive e frame (#r e)node
    in (e,equality,receipt)end
