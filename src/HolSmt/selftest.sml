      val function = ``source_rule_congruence_f:num->num``
      val premise = boolSyntax.mk_eq (left,right)
      val conclusion = boolSyntax.mk_eq
        (Term.mk_comb (function,left),Term.mk_comb (function,right))
      val sources = S.new graph root cap
        {goal=boolSyntax.T,assumptions=[premise,premise]}
      val work = W.begin graph root sources
        {limits={input_limit=100,output_limit=100,template_limit=cap},
         work_limit=10000000}
      val frame = Scope.root work
      val input = hd (S.assumption_nodes sources)
      val target = #node (G.import graph root cap conclusion)
      val old = P.prepare_needed_sources_with_work work
        {frame=frame,roots=[input],additional_sources=[],
         closed_facts=[],conversions=[]}
      val edge = W.with_step work (fn () => P.source old 0)
      val incoming = P.realize_source_owned_receipt work old input edge
      val value = P.prepare_source_cut_rule_block work
        {frame=frame,roots=[],additional_sources=[],closed_facts=[],
         conversions=[],receipts=[incoming],targets=[target],
         boolean=false,congruence=true}
      val block = P.source_cut_block_for work value
      val edge = P.source_cut_edge_for work value incoming
      val result = W.with_step work (fn () =>
        R.equality_rule graph block "cong" target [(input,edge)])
      val outgoing = P.realize_source_cut_receipt work value target result
      val theorem = P.source_realization_theorem_for work outgoing
      val valid = Portable.pointer_eq
          (Thm.concl theorem,G.representative graph target) andalso
        length (Thm.hyp theorem)=1 andalso
        Portable.pointer_eq (hd (Thm.hyp theorem),
          G.representative graph input) andalso
        null (Tag.axioms_of (Thm.tag theorem))
      val _ = W.close work
    in ensure "congruence invented a leaf proof or lost original Source"
      valid end

    in () end)
end

