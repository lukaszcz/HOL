  fun require message yes = if yes then () else raise Fail message
  fun fixture_sources_after assumptions goal observe action =
    let
      val graph = G.new () val scope = G.root_scope graph
      val sources = S.new graph scope 512
        {assumptions=assumptions,goal=goal}
      val work = W.begin_with_scope_guard graph scope sources
        {limits={input_limit=100,output_limit=100,template_limit=512},
         work_limit=10000000}
      val outcome = Exn.capture (fn () =>
        let val input = GP.discover_from_sources graph scope sources
              {import_limit=512,revisit=false,check_type=fn _ => (),
               conversion=fn _ => NONE}
            val e:env = {graph=graph,scope=scope,sources=sources,work=work,
              input=input,p=hd (S.assumption_nodes sources),
              denied=S.denied_goal_node sources}
        in observe e (Exn.capture action e) end) ()
      val cleanup = Exn.capture (fn () =>
        (W.close work;G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res result => (Exn.release cleanup;result) end
  fun fixture_after observe action =
    let val p = ``bounded_cpc_p:bool``
    in fixture_sources_after [p,p] p observe action end
  fun fixture action = fixture_after (fn _ => Exn.release) action
  fun located (e:env) node:F.term =
    {node=node,scope= #scope e,binder_blocks=[],
     occurrence=SmtLib_Parser.ConstructionOccurrence
       {value=node,role=SmtLib_Parser.ConstructionAtom,
        token="@bounded-fixture",children=[]}}
  fun registered name = case CPC_Proof.lookup_rule "1.3.4" name of
      SOME rule => rule | NONE => raise Fail "missing fixed CPC fixture rule"
  fun step e id rule premises target pop = Q.GraphStep
    {pop=pop,step={id=id,rule=registered rule,premises=premises,
      conclusion=SOME (located e target),args=[],raw_conclusion=NONE,
      raw_args=[]}}
  fun proof (e:env) count scoped =
    let
      val graph = #graph e and scope = #scope e
      val truth = G.constant graph scope boolSyntax.T
      val conjunction = G.constant graph scope boolSyntax.conjunction
      val q = #node (G.import graph scope 512 ``bounded_cpc_q:bool``)
      val initial = if scoped then q else #p e
      val initial_id = if scoped then "@local" else "@p"
      fun chain 0 current id result = (current,id,List.rev result)
        | chain remaining current id result =
          let val index = count-remaining
              val next_id = "@conj" ^ Int.toString index
              val next = G.application graph scope
                (G.application graph scope (conjunction,current),truth)
              val command = step e next_id "trust" [id] next false
          in chain (remaining-1) next next_id (command::result) end
      val (last,last_id,commands) = chain count initial initial_id []
      val prefix = [Q.GraphAssume ("@p",located e (#p e)),
        Q.GraphAssume ("@n",located e (#denied e))]
      val (middle,premises) = if not scoped then
          (commands,[last_id,"@n"])
        else
          let val implication = G.constant graph scope boolSyntax.implication
              val closed = G.application graph scope
                (G.application graph scope (implication,q),last)
          in (Q.GraphAssumePush ("@local",located e q)::commands @
               [step e "@scope" "scope" [last_id] closed true],
              ["@p","@n","@scope"]) end
      val finish = step e "@finish" "trust" premises
        (G.constant graph scope boolSyntax.F) false
      val proof:Q.graph_proof =
        {commands=prefix @ middle @ [finish],cvc_version="1.3.4"}
    in (proof,last) end
  fun worker count scoped calls (request,inputs) =
    let
      val _ = calls := !calls+1
      val conclusion = case #conclusion (request:CPC_Proof.step) of
          SOME term => term | NONE => raise Fail "fixture target absent"
      fun assumed (term:CPC_Proof.located_term) = Thm.ASSUME (#term term)
      fun first 0 theorem = theorem
        | first n theorem = first (n-1) (Thm.CONJUNCT1 theorem)
      val theorem = if #id request<>"@finish" then
          (case inputs of [input] => Thm.CONJ (assumed input) boolTheory.TRUTH
           | _ => raise Fail "fixture conjunction premise arity")
        else if scoped then
          (case inputs of [positive,negative,closed] =>
             Thm.CONJUNCT1 (Thm.CONJ
               (Thm.MP (Thm.NOT_ELIM (assumed negative)) (assumed positive))
               (assumed closed))
           | _ => raise Fail "fixture scoped final premise arity")
        else
          (case inputs of [chain,negative] =>
             Thm.MP (Thm.NOT_ELIM (assumed negative))
               (first count (assumed chain))
           | _ => raise Fail "fixture final premise arity")
    in (theorem,conclusion) end
  fun run e count scoped wrap =
    let val (certificate,last) = proof e count scoped
        val calls = ref 0
        val result =
          R.check_contradiction_preprocessed_observed_with_work_using
            (#work e) {graph= #graph e,scope= #scope e,sources= #sources e,
              preprocessing= #input e,proof=certificate,ordinary_limit=512,
              template_limit=512,worker=wrap (worker count scoped calls),
              force_worker=NONE}
    in (result,!calls,last) end
  fun checked (e:env)
      (result:{theorem:Thm.thm,statistics:R.observed_statistics}) =
    let val theorem = #theorem result
        val hypotheses = Thm.hyp theorem
        val allowed = S.assumption_nodes (#sources e) @ [#denied e]
    in require "bounded CPC changed original proof or ordered Sources"
      (Term.aconv (Thm.concl theorem) boolSyntax.F andalso
       null (Tag.axioms_of (Thm.tag theorem)) andalso
       List.all (fn hypothesis => List.exists (fn node =>
         Portable.pointer_eq (hypothesis,G.representative (#graph e) node))
         allowed) hypotheses andalso length hypotheses=2 andalso
       S.assumption_nodes (#sources e)=[#p e,#p e] andalso
       not (#retired (W.audit (#work e)))) end
  fun test label action =
    (testutils.tprint label;action ();testutils.OK ())
