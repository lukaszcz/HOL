                  | Exn.Res _ => "returned"
                val message =
                  "paid profile-end lost primary or transferred owner" ^
                  " exact=" ^ Bool.toString exact ^
                  " calls=" ^ Int.toString (!calls) ^
                  " prepared=" ^ Int.toString (!prepared) ^
                  " hooks=" ^ Int.toString (!hooks) ^
                  " closed=" ^ Bool.toString closed ^
                  " actual=" ^ actual
            in require message
              (exact andalso !calls = 1 andalso !prepared = 1 andalso
               !hooks = 1 andalso closed) end)
        val _ = test "Paid Z3 discovery Primary closes actual handoff owner"
          (fn () =>
