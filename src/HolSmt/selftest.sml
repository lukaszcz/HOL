            (Option.isSome refused andalso Count.thm_count()=prior andalso
             #retired(W.audit_policy(#work e)))end))
      val _=test "Paid lifetime observes revision after initial payer"
        (fn()=>fixture(fn e=>
          let val held=warm e val prior=Count.thm_count()
              val baseline=stable e held val armed=ref true
              val _=(#pay_hook e):=fn _=>if !armed then
                (armed:=false;publish e boolSyntax.conjunction)else()
              val changed=observed e held
              val _=(#pay_hook e):=fn _=>()
              val _=stable e held
          in require "pre-payer revision incorrectly authorized warm hit"
            (not(!armed) andalso
             #charged changed> #charged baseline+4 andalso
             Count.thm_count()=prior andalso live e)end))
      val _=test "Paid lifetime refreshes revision after miss payer"
        (fn()=>fixture(fn e=>
          let val held=warm e val prior=Count.thm_count()
              val _=run e(fn()=>publish e boolSyntax.conjunction)
              datatype payer_phase=CommonPayer | MissPayer | Complete
              val phase=ref CommonPayer
              val _=(#pay_hook e):=fn _=>case !phase of
                  CommonPayer=>phase:=MissPayer
                | MissPayer=>
                    (phase:=Complete;publish e boolSyntax.disjunction)
                | Complete=>raise Fail "unexpected extra lifetime payer"
              val _=validate e held
              val _=(#pay_hook e):=fn _=>()
              val _=stable e held
          in require "miss retained revision before real branch payer"
            (!phase=Complete andalso Count.thm_count()=prior andalso
             live e)end))
      val _=test "Terminal owner publication cannot bless old leaf scan"
        (fn()=>fixture(fn e=>
          let val held=warm e val calls=ref 0
              val prior=Count.thm_count()
              val _=(#owner_hook e):=fn()=>
                (calls:= !calls+1;if !calls=2 then
                  publish e boolSyntax.conjunction else())
              val _=validate e held
              val _=(#owner_hook e):=fn()=>()
              val miss=observed e held
              val _=stable e held
          in require "terminal owner callback minted an unvalidated stamp"
            (!calls=2 andalso #node_accesses(#stats miss)>0 andalso
             Count.thm_count()=prior andalso live e)end))
      val _=test "Warm paid lifetime retains context and Type expiry"
        (fn()=>
          let
            val _=fixture(fn e=>
              let val held=warm e val prior=Count.thm_count()
                  val _=PV.close(#context e)
                  val refused=error(fn()=>validate e held)
              in require "closed actual context revived paid metadata"
                (Option.isSome refused andalso Count.thm_count()=prior
                 andalso #retired(W.audit_policy(#work e)))end)
            val declaration={Thy="paid_lifetime41",Tyop="owned"}
            val _=require "paid lifetime Type canary already exists"
              (not(Option.isSome(Type.op_arity declaration)))
            val _=Type.prim_new_type declaration 0
            val own_type=Type.mk_thy_type
              {Thy= #Thy declaration,Tyop= #Tyop declaration,Args=[]}
            val identity= #Tyop(Type.dest_thy_typeid own_type)
            val active=ref true
            fun retire()=if !active then
              let val current=Type.mk_thy_type
                    {Thy= #Thy declaration,Tyop= #Tyop declaration,Args=[]}
                  val _=require "owned Type canary identity changed"
                    (KernelSig.id_compare(identity,
                      #Tyop(Type.dest_thy_typeid current))=EQUAL)
              in Type.prim_delete_type declaration;active:=false end else()
            val result=Exn.capture(fn()=>fixture(fn e=>
              let val held=warm e val _=retire()
                  val prior=Count.thm_count()
                  val refused=error(fn()=>validate e held)
              in require "warm paid token ignored actual Type retirement"
                (Option.isSome refused andalso Count.thm_count()=prior
                 andalso #retired(W.audit_policy(#work e)))end))()
            val cleanup=Exn.capture retire()
          in case result of Exn.Exn primary=>raise primary
            | Exn.Res answer=>(Exn.release cleanup;answer)end)
      val _=test "Legacy Idle validation stays separate from paid action"
        (fn()=>fixture(fn e=>
          let val legacy=run e(fn()=>PV.prepare_lifetime_guard(#context e)
                {remaining_work=fn()=>W.remaining_policy(#work e),
                 scopes=[#scope e],values=[#value e]})
              val _=run e(fn()=>W.spend_policy(#work e)
                (PV.lifetime_guard_work legacy))
              val prior=Count.thm_count()
              val _=PV.validate_lifetime_guard legacy
              val held=warm e
              val refused=error(fn()=>PV.validate_paid_lifetime_guard held)
          in require "new paid entry silently borrowed an Idle allowance"
            (refused=SOME("SmtReplayInvocationWork","admit",
               "no owned work action")andalso
             Count.thm_count()=prior andalso
             #retired(W.audit_policy(#work e)))end))
      val _=test "Failed legacy preparation adds no new cleanup callback"
        (fn()=>
          let
            fun attempt paid=fixture(fn e=>
              let
                val context=PV.create
                  {graph= #graph e,scope= #scope e,
                   validate=fn()=>W.validate_policy(#work e)(#graph e)
                     (#scope e)(#sources e)limits,
                   spend=W.spend_policy(#work e),
                   retire=fn()=>W.close(#work e)}
                val foreign=run e(fn()=>PV.literal context(#scope e)
                  (RP.AtMost 1)boolSyntax.T)
                val prior=Count.thm_count()
                val refused=error(fn()=>run e(fn()=>
                  if paid then ignore(PV.prepare_paid_lifetime_guard
                    (#context e)
                    {remaining_work=fn()=>W.remaining_policy(#work e),
                     scopes=[#scope e],values=[foreign]})
                  else ignore(PV.prepare_lifetime_guard(#context e)
                    {remaining_work=fn()=>W.remaining_policy(#work e),
                     scopes=[#scope e],values=[foreign]})))
                val count= !(#retire_calls e)
                val _=PV.close context
                val _=require "bad-context preparation performed inference"
                  (Count.thm_count()=prior andalso
                   #retired(W.audit_policy(#work e)))
              in (refused,count)end)
            val ordinary=attempt false val paid=attempt true
          in require "new wrapper repeated failed legacy cleanup sequence"
            (Option.isSome(#1 ordinary)andalso #2 ordinary>0 andalso
             ordinary=paid)end)
    in ()end
end

