  fun rewritten (F.QueryRewritten value) = value
    | rewritten (F.QueryNeeds _) = raise Fail "supported body query kept Needs"
  fun raw (e:env) node =
    let val term = G.representative (#graph e) node
    in require "body query fixture exceeded bounded native oracle"
      (Option.isSome (SmtReplayImport.bounded_raw_size 256 term));term end
  val last_phase = ref "not-started"
  fun report (e:env) label =
    ((case OS.Process.getEnv "HOL4_HOLSMT_REPLAY_DIAGNOSTICS" of
        SOME "1" =>
          let val audit = W.audit_policy (#work e)
          in print ("FINITE_COMPOSITE_WORK phase=" ^ label ^
            " charged=" ^ IntInf.toString (#charged audit) ^
            " retired=" ^ Bool.toString (#retired audit) ^ "\n") end
      | _ => ()) handle _ => ())
  fun phase e label = (last_phase := label;report e label)
  fun diagnosed e action = action () handle primary =>
    (report e ("primary@" ^ !last_phase);raise primary)
  fun current (e:env) validation = W.with_step (#work e) (fn () =>
    V.current_facts_with_policy_for (#work e) validation)
  fun realize (e:env) preprocessing target =
    let
      val work = #work e
      val frontier = GP.prepare_final_frontier_with_policy work
        preprocessing {roots=[]}
      val _ = phase e "denial.frontier"
      val tables = W.with_step work (fn () =>
        P.prepare_owned_realization_tables_with_policy work frontier)
      val _ = phase e "denial.tables"
      val freeze = W.with_step work (fn () =>
        let val ordinal = W.unused_policy_ordinal work
              {role=W.FinalFreeze,minimum=393}
        in P.prepare_native_realization_freeze_with_policy work
          {tables=tables,contract= #contract e,profiles=[],ordinal=ordinal,
           check_type=fn _ => ()} end)
      val _ = phase e "denial.freeze-plan"
      val block = W.with_step work (fn () =>
        P.freeze_owned_realization_tables_with_policy work freeze)
      val _ = phase e "denial.block"
      val edge = case GP.assembler_with_policy work preprocessing block target
          of SOME value => value
          | NONE => raise Fail "query denial unassembled"
      val _ = phase e "denial.assembled"
    in W.with_step work (fn () =>
      P.policy_source_realization_theorem_for work
        (P.execute_realization_with_policy work
          (P.prepare_realization_with_policy work block target edge))) end
  fun expected () =
    let val lambda = abstraction boolSyntax.T
    in boolSyntax.mk_eq (lambda,lambda) end
  fun result_at condition e prepared opening bindings =
    let val _ = phase e "root.before"
        val output = rewritten (execute e prepared opening bindings)
        val _ = phase e "root.applied"
        val facts = current e (#validation output)
        val _ = phase e "root.current"
        val proof = realize e (#preprocessing output)
          (V.endpoint (#denied facts))
        val _ = phase e "denial.realized"
        val lambda = abstraction condition
        val expected_goal = boolSyntax.mk_eq (lambda,lambda)
    in require "actual root erasure changed Goal/denial or original Sources"
      (Term.aconv (raw e (#goal facts)) expected_goal andalso
       Term.aconv (Thm.concl proof) (boolSyntax.mk_neg expected_goal) andalso
       null (#assumptions facts) andalso
       Portable.pointer_eq (V.original_sources (#validation output),
         #sources e) andalso
       GP.source_nodes (#preprocessing output)=
         S.assumption_nodes (#sources e) @
           [S.denied_goal_node (#sources e)]);
       (output,facts,proof) end
  fun result e prepared opening bindings =
    result_at boolSyntax.T e prepared opening bindings
  fun frames (e:env) (prepared:prepared) =
    let
      val description = W.with_step (#work e) (fn () =>
        F.body_description_with_policy_for (#work e)
          (hd (#bodies prepared)))
      val root = Scope.root_with_policy (#work e)
      val child = G.closure_root (#graph e) (#scope e)
        (#node (#binder description))
      val body = Scope.body_with_policy (#work e) root child
      val owner = Scope.description_with_policy_for (#work e) body
    in (body,#scope owner) end
  fun plan (e:env) frame source target check =
    C.prepare_with_policy (#work e)
      {frame=frame,source=source,target=target,native_contract= #contract e,
       profiles=[],ordinal=396,check_type=check}
  fun actual (C.Prepared value) = value
    | actual C.DifferentShape = raise Fail "same-leaf shape was not planned"
  fun total () = #total (Count.thm_count ())
  val composite =
    ``FINITE (({}:num -> bool) DELETE finite_query_element)``
  fun require_composite_markers () =
    let
      val subject = pred_setSyntax.dest_finite composite
      val (empty,_) = pred_setSyntax.dest_delete subject
      val lambda = abstraction composite
      val goal = boolSyntax.mk_eq (lambda,lambda)
      val {sets,...} = SmtLib.outbound_collection_markers ([composite],goal)
      val reports = ref ([]:Term.term SmtLib.outbound_finite_report list)
      val policy = SmtLib.outbound_backend_selection_with_finite_trace
        SmtLib.outbound_term_backend_selection_operations
        (fn report => reports := report :: !reports)
      val evidence = (#finite_sets policy) [composite]
      val all_finite = List.all ((#finite_set_term policy) evidence) sets
      fun branch term = case List.find (fn report =>
            Term.aconv (#subject report) term) (!reports) of
