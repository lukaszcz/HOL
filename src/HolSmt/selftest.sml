  fun legacy(e:env)index known=
    let val d=C.projected_rule_for (#work e)(projected e index)
        val original= #theorem d
        val first=Drule.EQT_ELIM(Drule.EQT_INTRO original)
        fun finish [] result=result
          | finish((ants,th)::rest)result=
              finish rest(List.foldl(fn(a,t)=>Thm.DISCH a t)th ants::result)
        fun canon acc []=finish acc []
          | canon acc((ants,th)::rest)=
            let val term=Thm.concl th
            in if boolSyntax.is_conj term then
                 canon acc((ants,Thm.CONJUNCT1 th)::
                   (ants,Thm.CONJUNCT2 th)::rest)
               else if boolSyntax.is_imp_only term then
                 let val(ant,body)=boolSyntax.dest_imp_only term
                 in if boolSyntax.is_conj ant then
                      let val(a,b)=boolSyntax.dest_conj ant
                          val next=Thm.DISCH a(Thm.DISCH b
                            (Thm.MP th(Thm.CONJ(Thm.ASSUME a)(Thm.ASSUME b))))
                      in canon acc((ants,next)::rest)end
                    else if boolSyntax.is_disj ant then
                      let val(a,b)=boolSyntax.dest_disj ant
                          val left=Thm.DISCH a
                            (Thm.MP th(Thm.DISJ1(Thm.ASSUME a)b))
                          val right=Thm.DISCH b
                            (Thm.MP th(Thm.DISJ2 a(Thm.ASSUME b)))
                      in canon acc((ants,left)::(ants,right)::rest)end
                    else if boolSyntax.is_exists ant then
                      let val(v,part)=boolSyntax.dest_exists ant
                          val avoid=case known of SOME values=>values
                            | NONE=>Thm.thm_frees th
                          val chosen=Term.variant avoid v
                          val instance=Term.subst[{redex=v,residue=chosen}]part
                          val next=Thm.DISCH instance
                            (Thm.MP th(Thm.EXISTS(ant,chosen)
                              (Thm.ASSUME instance)))
                      in canon acc((ants,next)::rest)end
                    else if Term.is_const body andalso
                        Term.same_const body boolSyntax.F then
                      canon((ants,Thm.NOT_INTRO th)::acc)rest
                    else canon acc((ant::ants,Drule.UNDISCH th)::rest)end
               else if boolSyntax.is_forall term then
                 canon acc((ants,Drule.SPEC_ALL th)::rest)
               else if boolSyntax.is_res_forall term then
                 raise Fail "restricted-forall oracle is not selected"
               else canon((ants,th)::acc)rest end
    in canon[][([],first)]end
