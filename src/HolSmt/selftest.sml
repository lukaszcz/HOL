  fun require message yes = if yes then () else raise Fail message
  fun test label action =
    ((Count.counting_thms true;testutils.tprint label;action ();
      Count.counting_thms false;testutils.OK ())
     handle primary => (Count.counting_thms false;raise primary))
  fun fixture modern action =
    let
      val graph = G.new () val scope = G.root_scope graph
      val sources = S.new graph scope 100000
        {assumptions=[boolSyntax.T,boolSyntax.T],goal=boolSyntax.T}
      val work = if modern then W.begin_with_policy graph scope sources
          {limits={input_limit=RP.AtMost 100000,
             output_limit=RP.AtMost 100000,template_limit=RP.AtMost 100000},
           work_limit=RP.AtMost 1000000000}
        else W.begin graph scope sources
          {limits={input_limit=100000,output_limit=100000,
             template_limit=100000},work_limit=20000000}
      fun frame fact =
        let val (_,predicate) = G.closure_application_children graph scope
              (G.closure_root graph scope (P.closed_node fact))
        in #body_frame (G.binder_closure_data graph scope
          (G.closure_child_binder graph scope predicate)) end
      fun run () =
        if modern then
          let val contract = NC.capture work
                {semantic_limits={input_limit=100000,output_limit=100000,
                   template_limit=100000},import_limit=100000,
                 type_work_limit=10000000}
              val catalogue = C.execute_with_policy
                (C.prepare_with_policy (C.begin_with_policy work
                  {native_contract=contract,check_type=fn _ => ()}))
              fun canonical callback =
                let val preparing = ref true
                    val owner = N.begin_with_policy work catalogue
                      {check_type=fn ty => callback (!preparing,ty)}
                    val prior = Count.thm_count ()
                    val plan = N.prepare_with_policy owner
                    val _ = require "policy profile performed native proof"
                      (Count.thm_count ()=prior)
                    val _ = preparing := false
                in N.originals_with_policy (N.execute_with_policy plan) end
          in action {graph=graph,scope=scope,work=work,
            original=C.originals_with_policy catalogue,
            frame=frame (hd (C.checked_rules_with_policy catalogue)),
            run=canonical} end
        else
          let val catalogue = C.execute
                (C.prepare (C.begin work {check_type=fn _ => ()}))
              fun canonical callback =
                let val preparing = ref true
                    val owner = N.begin work catalogue
                      {check_type=fn ty => callback (!preparing,ty)}
                    val prior = Count.thm_count ()
                    val plan = SmtLib_GraphNumericCanonical.prepare owner
                    val _ = require "legacy profile performed native proof"
                      (Count.thm_count ()=prior)
                    val _ = preparing := false
                in N.originals (N.execute plan) end
          in action {graph=graph,scope=scope,work=work,
            original=C.originals catalogue,
            frame=frame (hd (C.checked_rules catalogue)),run=canonical} end
      val outcome = Exn.capture run ()
      val cleanup = Exn.capture (fn () =>
        (W.close work;G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res result => (Exn.release cleanup;result) end
  fun reference (e:env) = List.concat (List.map (fn rule =>
    List.map #1 (Cond_rewr.mk_cond_rewrs
      (rule,BoundedRewrites.UNBOUNDED))) (#original e))
