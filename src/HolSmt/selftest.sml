  fun require message yes = if yes then () else raise Fail message
  fun fixture closed output observe action =
    let
      val variable = ``forced_cpc_p:bool``
      val target = if closed then boolSyntax.mk_eq (variable,variable)
        else variable
      val hypothesis = boolSyntax.mk_forall (variable,target)
      val premise = if closed then boolSyntax.T else
        boolSyntax.mk_conj (hypothesis,boolSyntax.T)
      val graph = G.new () val scope = G.root_scope graph
      val sources = S.new graph scope 512
        {assumptions=[premise,premise],goal=target}
