                val _=checked e(#theorem result)
            in require "CPC finalizer changed ordered actual dependencies"
              (#dependencies result=[P.Current 0]andalso
               length(Thm.hyp(#theorem result))=1)end)))
      val _=test "A pending CPC queue remains inert and caller-owned"
        (fn()=>fixture[double]goal(fn e=>
          let val held=packet e
                ("((assume @a (not (not false))) "^
                 "(step @b false :rule not_not_elim :premises (@a)) "^
                 "(step @later false :rule trust))")
              val data=W.with_step(#work e)(fn()=>
