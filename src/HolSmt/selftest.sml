    in () end)
end

(* Scoped collection analysis visits a query DAG, not its expanded tree. *)
local
  structure G = SmtReplayGraph
  structure S = SmtReplaySource
  structure W = SmtReplayInvocationWork
  structure V = SmtLib_GraphSourcePortfolio
  structure GP = SmtLib_GraphPreprocess
  structure Q = SmtLib_GraphQueryAnalysis
  structure T = SmtLib_GraphTranslation
  structure RP = SmtReplayResourcePolicy
  fun require text yes = if yes then () else raise Fail text
  fun test label action =
    (testutils.tprint label;action ();testutils.OK ())
  fun error action =
    (ignore (action ());NONE)
    handle Feedback.HOL_ERR detail => SOME (Feedback.message_of detail)
  type env = {graph:G.graph,scope:G.scope,sources:S.sources,
    work:W.portfolio,query:GP.graph_query,goal:G.node,markers:G.node list}
  fun owned_assumptions assumptions goal markers action =
    let val graph = G.new () val scope = G.root_scope graph
        val sources = S.new graph scope 10000
          {assumptions=assumptions,goal=goal}
        val markers = List.map
          (fn term => #node (G.import graph scope 10000 term)) markers
        val cap = RP.AtMost 1000000000
        val work = W.begin_with_policy graph scope sources
          {limits={input_limit=cap,output_limit=cap,template_limit=cap},
           work_limit=cap}
        fun prepare () =
          let val {assumptions,denied} = V.originals_with_policy work
              val goal = #node (S.goal_source sources)
              val portfolio = V.validate_portfolio_with_policy work
                {assumptions=assumptions,goal=goal,denied=denied}
              val query = GP.prepare_query_with_policy work
                (GP.from_portfolio_with_policy work portfolio)
          in action ({graph=graph,scope=scope,sources=sources,work=work,
            query=query,goal=goal,markers=markers}:env) end
        val outcome = Exn.capture prepare ()
        val cleanup = Exn.capture (fn () =>
          (W.close work;G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res answer => (Exn.release cleanup;answer) end
  fun owned goal markers action = owned_assumptions [] goal markers action
  fun arity (e:env) node =
    SmtLib.outbound_constant_arity (G.representative (#graph e) node)
  fun open_view (e:env) scope node = ignore
    (G.record_opened_view_with_policy (#graph e) scope (RP.AtMost 10000) node)
  fun analyse (e:env) = Q.analyse_collections_with_policy (#work e) (#query e)
    {collections= #markers e,declared_const_arity=arity e,
     open_opaque=open_view e}
  val collection_type = Type.--> (Type.bool,Type.bool)
  val function_type = Type.--> (collection_type,Type.bool)
  val f = Term.mk_var ("query_analysis_f",function_type)
  val set = Term.mk_var ("query_analysis_set",collection_type)
  val ordinary = Term.mk_var ("query_analysis_array",collection_type)
  val x = Term.mk_var ("query_analysis_x",Type.bool)
  fun apply function argument = Term.mk_comb (function,argument)
  fun native (e:env) = T.analyse_native_query_with_policy
    (#work e) (#query e) (open_view e)
  fun raw_positions (e:env) binders inventory =
    let
      val graph = #graph e
      fun insert (position:Q.scoped_node,nodes) =
        if List.exists (fn node => node = #node position) nodes then nodes
        else nodes @ [#node position]
      val actual_binders = List.foldl insert [] (List.filter
        (fn (position:Q.scoped_node) => case G.view graph (#node position) of
           G.Variable (G.Bound,_) => true | _ => false)
        inventory)
      val _ = require "marker oracle lost an actual binder frame"
        (length actual_binders = length binders)
      val substitutions = ListPair.map
        (fn (node,raw) => {redex=G.representative graph node,residue=raw})
        (actual_binders,binders)
      fun raw (position:Q.scoped_node) =
        Term.subst substitutions (G.representative graph (#node position))
    in raw end
  fun marker_oracle (e:env) binders goal (result:Q.native_result) =
    let val raw = raw_positions e binders
          (#inventory (#set_analysis result))
        val expected = SmtLib.outbound_collection_markers ([],goal)
    in ListPair.allEq (fn (left,right) => Term.aconv left right)
         (List.map raw (#sets result),#sets expected) andalso
       ListPair.allEq (fn (left,right) => Term.aconv left right)
         (List.map raw (#bags result),#bags expected) andalso
       Portable.pointer_eq (W.original_sources (#work e),#sources e) andalso
       null (S.assumption_nodes (#sources e)) andalso
       #node (S.goal_source (#sources e)) = #goal e
    end
  fun number_oracle (e:env) binders assumptions goal
      (result:Q.native_result) =
    let val raw = raw_positions e binders
          (#inventory (#set_analysis result))
    in ListPair.allEq (fn (left,right) => Term.aconv left right)
         (List.map raw (#raw_numbers result),
          SmtLib.outbound_raw_number_markers (assumptions,goal)) andalso
       Portable.pointer_eq (W.original_sources (#work e),#sources e) andalso
       length (S.assumption_nodes (#sources e)) = length assumptions andalso
       #node (S.goal_source (#sources e)) = #goal e
    end
  val integer = Term.mk_var ("graph_num_z",intSyntax.int_ty)
  val other_integer = Term.mk_var ("graph_num_w",intSyntax.int_ty)
  val third_integer = Term.mk_var ("graph_num_v",intSyntax.int_ty)
  fun number term = apply intSyntax.Num_tm term
  fun direct term = boolSyntax.mk_eq (number term,numSyntax.zero_tm)
  fun coerced term = boolSyntax.mk_eq
    (apply intSyntax.int_injection (number term),term)
in
