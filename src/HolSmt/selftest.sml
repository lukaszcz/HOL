  fun setup_limits native axiom extra_terms text callback:env=
    let
      val g=G.new()val r=G.root_scope g
      val s=S.new_with_policy g r RP.Uncapped
        {goal=boolSyntax.T,assumptions=[axiom]}
      val policy:RP.semantic_policy={input_limit=RP.Uncapped,
        output_limit=RP.Uncapped,template_limit=RP.Uncapped}
      val w=W.begin_with_policy g r s
        {limits=policy,work_limit=RP.Uncapped}
      val n=NC.capture w native
      val original=hd(S.assumption_nodes s)
      (* Direct unchanged Boolean-forall discovery returns NONE and no
         profiles. A real beta branch causes traversal of the unchanged
         equality branch, retaining its actual original opaque Abs leaf.
         This is setup payload, not a new engine first-admission claim. *)
      val trigger_var=Term.mk_var("policy_receiver_profile_trigger",Type.bool)
      val trigger=Term.mk_comb
        (Term.mk_abs(trigger_var,trigger_var),boolSyntax.T)
      val witness=boolSyntax.mk_conj(trigger,boolSyntax.mk_eq
        (G.representative g original,G.representative g original))
      val wrapper=G.import_with_policy g r RP.Uncapped witness
      val discovery=G.discover_partial_with_policy g r
        {original= #node wrapper,maximum=RP.Uncapped,
         scan_limit=RP.AtMost 10000,step=fn()=>()}
      val profiles=G.partial_profiles_with_policy g r discovery
      val opaque=case G.view g original of G.Application(_,node)=>node
        | _=>raise Fail "actual original forall application missing"
      val _=case G.view g opaque of G.OpaqueRetained=>()
        | _=>raise Fail "actual original opaque forall Abs missing"
      val _=require "actual original Root opaque Abs profile missing"
        (List.exists(fn profile=>Option.isSome
          (G.opaque_profile_for_node_with_policy g r opaque profile))profiles)
      val _=List.app(G.validate_policy_opaque_profile g)profiles
      val options:Front.policy_options=
        {graph=g,scope=r,logic="ALL",
         sources=("policy_axiom",G.representative g original)::
           extra_terms,
         sorts=Redblackmap.mkDict String.compare,binder_lists=[],
         import_limit=RP.Uncapped,literal_limit=RP.Uncapped,
         binder_limit=RP.Uncapped,
         recipe_limits={template_limit=RP.Uncapped,index_limit=RP.Uncapped,
           operand_limit=RP.Uncapped,token_limit=RP.Uncapped},
         special=fn _=>fn _=>NONE,ascribed=fn _=>fn _=>fn _=>NONE}
      val stream=TextIO.openString text
