                (options e) (description policy)
                (fn () => raise Fail "unused input")
          in action held native values end)
        val result = Exn.capture run ()
        val cleanup = Exn.capture (#close held) ()
    in case result of Exn.Exn primary => raise primary
      | Exn.Res answer => (Exn.release cleanup;answer) end
  fun parse parse_from text =
    let val input = TextIO.openString text
