      val(partial,_)=Q.application_children_with_policy expected goal
      val(_,original)=Q.application_children_with_policy expected partial
      val admission=if not rehome then original else
        let
          val data=Q.describe_with_policy_for expected original
          val term=G.representative g (#node data)
          val declared=G.new_scope g r []
          val imported=G.import_with_policy g declared RP.Uncapped term
          val opened=G.record_opened_view_with_policy g declared
            (RP.AtMost 1000000)(#node imported)
          val moved=G.rehome g r (#node opened)
          val target= #node moved
          val proof=Thm.ALPHA term (G.representative g target)
          val operator=Term.rator(Term.rator(Thm.concl proof))
          val head=G.constant g r operator
          val equation=G.application g r
            (G.application g r(head,#node data),target)
          val wrapper=P.record_generated_equality_with_policy_scoped_profiles
            g r {node=equation,theorem=proof,template_limit=RP.Uncapped,
              profiles=[],check_type=fn _=>()}
        in Q.generated_scoped_with_policy expected original wrapper end
      val data=Q.describe_with_policy_for expected admission
      val closure=G.closure_child_binder g r (#child data)
      val captured=G.binder_closure_data g r closure
      val frame=Scope.root_with_policy w
      val body_frame=Scope.body_with_policy w frame (#child data)
      val scope= #body_frame captured
      val source= #body captured
      val converted=if not rewrite then
          C.graph_identity g scope {observe=fn _=>()}source
        else let
          val operand=case G.view g source of G.Application(_,inner)=>
              (case G.view g inner of G.Application(_,node)=>node
               | _=>raise Fail "actual double negation operand missing")
            | _=>raise Fail "actual double negation source missing"
          val hole=Term.mk_var("core_lambda_hole",Type.bool)
          val theorem=Thm.SPEC hole(Thm.CONJUNCT1 boolTheory.NOT_CLAUSES)
          val schema=C.checked_graph_schema g scope
            {theorem=theorem,holes=[hole],operands=[operand],
             template_limit=1000000}
          val _=require "Core body schema did not match actual binder body"
            (C.graph_schema_source schema=source)
        in C.graph_conversion g scope false
          (fn node=>if node=source then SOME schema else NONE)source end
      val plan=Core.prepare_in_scope_with_policy w
