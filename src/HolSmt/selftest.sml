  fun profile term=
    let val graph=G.new()val scope=G.root_scope graph
        val node= #node(G.import_with_policy graph scope cap term)
        val q=Term.mk_var("needed_heads_beta_q",Type.bool)
        val beta=Term.mk_comb(Term.mk_abs(q,q),boolSyntax.T)
        val wrapper=boolSyntax.mk_conj(boolSyntax.mk_eq(term,term),beta)
        val imported=G.import_with_policy graph scope cap wrapper
        val discovery=G.discover_partial_with_policy graph scope
          {original= #node imported,maximum=cap,
           scan_limit=RP.AtMost 2000000,step=fn()=>()}
        val tokens=G.partial_profiles_with_policy graph scope discovery
        val saved=case List.find(fn token=>
            #node(G.opaque_profile_data_with_policy graph scope token)=node)
            tokens of SOME token=>token|NONE=>
              raise Fail "genuine discovery did not retain actual body"
    in {graph=graph,scope=scope,node=node,saved=saved}end
  (* Independent test oracle only, outside the passive metadata window.
     The production getter does not rescan Terms or reopen native bodies. *)
  fun constants term=
    if Term.is_comb term then
      let val(f,x)=Term.dest_comb term in constants f @ constants x end
    else if Term.is_abs term then
      constants(SmtReplayImport.count_body term)
    else if Term.is_const term then [term]else []
  fun same_terms left right=
    List.all(fn term=>List.exists(fn held=>
      Portable.pointer_eq(term,held))right)left andalso
    List.all(fn term=>List.exists(fn held=>
      Portable.pointer_eq(term,held))left)right
  fun portfolio ()=
    let val graph=G.new()val scope=G.root_scope graph
        val sources=S.new_with_policy graph scope RP.Uncapped
          {goal=boolSyntax.T,assumptions=[boolSyntax.T,boolSyntax.T]}
        val work=W.begin_with_policy graph scope sources
          {limits=limits,work_limit=RP.Uncapped}
        val validation=W.with_step work(fn()=>
          let val {assumptions,denied}=F.originals_with_policy work
          in F.validate_portfolio_with_policy work
            {assumptions=assumptions,goal= #node(S.goal_source sources),
             denied=denied}end)
    in {graph=graph,scope=scope,sources=sources,work=work,
        validation=validation}end
