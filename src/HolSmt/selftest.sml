      val originals = S.new graph scope limit
        {goal = G.representative graph public_goal,assumptions = []}
      val denied = S.denied_goal_node originals
      val false_node = G.constant graph scope boolSyntax.F
      val sources = [anchor_source,packed_source,packed_source] @
        alias_sources @ [denied]
      val current_vector = vector graph scope index
        (List.tabulate (3,fn i => bit graph scope (2-i) anchor))
      val current_packed = stored anchor current_vector
      val roots = [false_node,public_goal,denied,current_packed] @ sources
