                val _=VP.close held val prior=Count.thm_count()
                val denied=refused(fn()=>W.with_step(#work e)(fn()=>
                  ignore(Clause.raw_data_for(#work e)factory batch)))
            in require "raw alias plan outlived its authentic packet"
              (denied andalso Count.thm_count()=prior andalso
               #retired(W.audit_policy(#work e)))end)))
    in ()end)
