  structure G = SmtReplayGraph
  structure S = SmtReplaySource
  structure W = SmtReplayInvocationWork
  structure V = SmtLib_GraphSourcePortfolio
  structure GP = SmtLib_GraphPreprocess
  structure Q = SmtLib_GraphQueryAnalysis
  structure T = SmtLib_GraphTranslation
  structure F = SmtLib_GraphFrontend
  structure MD = SmtLib_GraphDeclarationMetadata
  structure M = SmtLib_GraphParserMapping
  structure RP = SmtReplayResourcePolicy
  type env = {graph:G.graph,scope:G.scope,work:W.portfolio,
    sources:S.sources,query:GP.graph_query,metadata:MD.metadata,
    operand:G.node,options:F.policy_options}
  fun require message yes = if yes then () else raise Fail message
  fun test label action =
    (testutils.tprint label;action ();testutils.OK ())
  fun error action = (action ();NONE)
    handle Feedback.HOL_ERR detail => SOME (Feedback.message_of detail)
  val source_goal = ``(metadata_option_value:bool option) = SOME T``
  val cap = RP.AtMost 1000000000
  val description =
    {solver="Z3",version="4.15.3",policy=F.Z3,reserved_names=[]}
  fun owned action =
    let
      val graph = G.new () val scope = G.root_scope graph
      val sources = S.new graph scope 10000
        {assumptions=[],goal=source_goal}
      val work = W.begin_with_policy graph scope sources
        {limits={input_limit=cap,output_limit=cap,template_limit=cap},
         work_limit=cap}
      fun run () =
        let
          val {assumptions,denied} = V.originals_with_policy work
          val validation = V.validate_portfolio_with_policy work
            {assumptions=assumptions,
             goal= #node (S.goal_source sources),denied=denied}
          val query = GP.prepare_query_with_policy work
            (GP.from_portfolio_with_policy work validation)
          fun open_view caller node = ignore
            (G.record_opened_view_with_policy graph caller
              (RP.AtMost 10000) node)
          val (metadata,operand) =
            T.with_outbound_query_analysis_with_policy work query open_view
              (fn context => SmtLib.outbound_with_backend_context
                {sequence_emission=false,set_backend=SmtLib.Z3Set,
                 bag_backend=SmtLib.Z3ArrayBag,
                 has_set_terms=false,has_bag_terms=false}
                (fn backend =>
                  let val operations =
                        SmtLib_GraphCarrierOperations.make_with_datatypes
                          context {sequence_emission=false}
                          {term_to_string=fn _ =>
                            raise Fail "unexpected datatype formatter"}
                      val emission = SmtLib_GraphDispatcher.emit context
                        {operations=operations,regime=SmtLib.FirstOrder,
                         apply_operator=SmtLib.ApplyUnderscore,
                         prefix="datatype_metadata_",
                         roots=[(0,#goal context)]}
                      val metadata = MD.freeze context
                        {graph=graph,scope=scope,regime=SmtLib.FirstOrder,
                         backend=backend,operations=operations,
                         emission=emission}
                      val (_,operands) = (#strip_comb context) (#goal context)
                      val operand = case operands of value::_ =>
                            (case (#graph_node context) value of
                               SOME {node,...} => node
                             | NONE => raise Fail "source variable is recipe")
                        | _ => raise Fail "source equality lost operands"
                  in (metadata,operand) end))
          val options:F.policy_options =
            {graph=graph,scope=scope,logic="ALL",sources=[],
             sorts=Redblackmap.mkDict String.compare,binder_lists=[],
             import_limit=cap,literal_limit=cap,binder_limit=cap,
             recipe_limits={template_limit=cap,index_limit=cap,
               operand_limit=cap,token_limit=cap},
             special=fn _ => fn _ => NONE,
             ascribed=fn _ => fn _ => fn _ => NONE}
        in action ({graph=graph,scope=scope,work=work,sources=sources,
          query=query,metadata=metadata,operand=operand,options=options}:env)
        end
      val outcome = Exn.capture run ()
      val cleanup = Exn.capture (fn () =>
        (W.close work;G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res answer => (Exn.release cleanup;answer) end
  fun types (e:env) = M.types (MD.mapping (#metadata e))
  fun schemas e = SmtLib.parser_datatype_declarations_from_types (types e)
  fun option_info e =
    case List.find (fn {hol_type,...}:SmtLib.parser_datatype_declaration =>
        Type.compare (hol_type,``:bool option``)=EQUAL) (schemas e) of
        SOME info => info | NONE => raise Fail "option declaration missing"
  fun constructor e expected =
    case List.find (fn {constructor,...}:SmtLib.parser_datatype_constructor =>
        Term.same_const constructor expected)
        (#constructors (option_info e)) of
        SOME result => result | NONE => raise Fail "constructor missing"
  fun declarations (e:env) =
    [{token="value",node= #operand e,arity=F.Exact 0}]
  fun session (e:env) =
    SmtLib_GraphTranslation.create_metadata_query_session_with_policy
      (#work e) (#query e) (#options e)
      {metadata= #metadata e,declarations=declarations e}
      description (fn () => raise Fail "unused parser token supplier")
  fun alignment (e:env) =
    T.create_metadata_alignment_session_with_policy
      (#work e) (#query e) (#options e)
      {metadata= #metadata e,declarations=declarations e}
      description (fn () => raise Fail "unused parser token supplier")
  fun parse (held:F.session) text =
    let val input = TextIO.openString text
        val outcome = Exn.capture (#parse_from held)
          (SmtLib_Parser.make_proof_stream_tokenizer input)
        val cleanup = Exn.capture TextIO.closeIn input
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res answer => (Exn.release cleanup;answer) end
  fun small (e:env) node =
    case G.unfolded_nodes (#graph e) G.RawNodes 256 node of
        SOME _ => G.representative (#graph e) node
      | NONE => raise Fail "small datatype oracle exceeded its real bound"
  fun option_value e = small e (#operand e)
  fun some_text e argument =
    "(" ^ #token (constructor e optionSyntax.some_tm) ^ " " ^ argument ^ ")"
  fun none_text e = #token (constructor e optionSyntax.none_tm)
  fun tester_text e token argument =
    "((_ is " ^ token ^ ") " ^ argument ^ ")"
  fun selector e = case #selectors (constructor e optionSyntax.some_tm) of
      [(name,_)] => name | _ => raise Fail "option selector shape changed"
  fun reachable (e:env) root =
    let val seen = ref (Redblackset.empty Int.compare)
        fun visit [] = ()
          | visit (current::rest) =
              if Redblackset.member (!seen,G.node_id current) then visit rest
              else
                let val _ = require "small branch oracle exceeded its bound"
                      (Redblackset.numItems (!seen)<256)
                    val _ = seen := Redblackset.add (!seen,G.node_id current)
                    val children = case G.view (#graph e) current of
                        G.Application (left,right) => [left,right]
                      | G.AdmittedBinder {binder,body,...} => [binder,body]
                      | _ => []
                in visit (children @ rest) end
        val _ = visit [root]
        fun collect [] acc = acc
          | collect (current::rest) acc =
              if List.exists (fn held => held=current) acc then
                collect rest acc
              else let val children = case G.view (#graph e) current of
                       G.Application (left,right) => [left,right]
                     | G.AdmittedBinder {binder,body,...} => [binder,body]
                     | _ => []
                   in collect (children @ rest) (current::acc) end
    in collect [root] [] end
