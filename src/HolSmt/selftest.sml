                (exact andalso !calls=1 andalso
                 #SPEC(Count.thm_count())= #SPEC prior andalso
                 #retired(W.audit_policy(#work e)))end))end)
      val _=test "Packet retirement fences a warmed CLOSED witness getter"
        (fn()=>owned(fn e=>parsed e(fn held=>fn _=>fn source=>
          fn argument=>fn target=>
            let val plan=lower_ready(prepare_lower e held source argument
                  target(#profiles e)(fn _=>()))
                val receipt=Specialize.execute(#work e)plan
                val _=lower_data e receipt
                val _=VP.close held
                val prior=Count.thm_count()
                val denied=refused(fn()=>ignore(lower_data e receipt))
            in require "closed witness ignored expired packet owner"
              (denied andalso Count.thm_count()=prior andalso
               #retired(W.audit_policy(#work e)))end)))
    in ()end)
end


