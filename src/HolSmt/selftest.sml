    "(assume-push @h p) "^
    "(step-pop @s (=> p p) :rule scope :premises (@h)) "^
    "(step @nn (not (not (=> p p))) :rule eq_resolve "^
      ":premises (@s @e)) "^
    "(step @selected (=> p p) :rule not_not_elim :premises (@nn)) "^
    "(assume @refreeze ei) "^
    "(step @last false :rule eq_resolve :premises (@selected @sf)))"
