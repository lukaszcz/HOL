                   occurrence=SmtLib_Parser.ConstructionOccurrence
                     {value=selected,
                      role=SmtLib_Parser.ConstructionApplication,token="and",
                      children=[#occurrence (located e r),
                        #occurrence (located e q)]}}
                val (wide,_) = proof e 40 false
                val commands = List.take (#commands wide,
                  List.length (#commands wide)-1)
                val select = Q.GraphStep
                  {pop=false,step={id="@select",rule=registered "bool",
                   premises=["@p","@a"],conclusion=SOME selected_term,
                   args=[],raw_conclusion=NONE,raw_args=[]}}
                val extract = Q.GraphStep
                  {pop=false,step={id="@selected",rule=registered "and_elim",
                   premises=["@select"],conclusion=SOME (located e q),
                   args=[Q.GraphIndex 1],raw_conclusion=NONE,raw_args=[]}}
                val finish = step e "@finish" "trust"
                  ["@p","@conj39","@selected","@n"]
                  (G.constant graph scope boolSyntax.F) false
                val certificate:Q.graph_proof =
                  {commands=commands @
                    [Q.GraphAssume ("@a",located e assumption),
                     select,extract,finish],cvc_version="1.3.4"}
                val calls = ref 0
                fun local_worker (request:CPC_Proof.step,inputs) =
                  if #id request<>"@finish" then
                    worker 40 false calls (request,inputs) else
                  let
                    val _ = calls := !calls+1
                    fun assumed (value:CPC_Proof.located_term) =
                      Thm.ASSUME (#term value)
                    val result = case inputs of
                        [source,chain,positive,negative] =>
                          Thm.CONJUNCT1 (Thm.CONJ
                            (Thm.MP (Thm.NOT_ELIM (assumed negative))
                              (assumed positive))
                            (Thm.CONJ (assumed source) (assumed chain)))
                      | _ => raise Fail "Boolean final premise arity"
                  in (result,valOf (#conclusion request)) end
                val result =
                  R.check_contradiction_preprocessed_observed_with_work_using
                    (#work e)
                    {graph=graph,scope=scope,sources= #sources e,
                     preprocessing= #input e,proof=certificate,
                     ordinary_limit=512,template_limit=512,
                     worker=local_worker,force_worker=NONE}
                val theorem = #theorem result
                val allowed = originals @ [#denied e]
                (* Preserve the exact small counterexample independently
                   of the median split chosen for the wide certificate. *)
                val frame = SmtReplayOwnedScopeReceipt.root (#work e)
                fun plan receipts targets boolean =
                  P.prepare_source_cut_rule_plan (#work e)
                    {frame=frame,roots=[],additional_sources=[],
                     closed_facts=[],conversions=[],receipts=receipts,
                     targets=targets,boolean=boolean,congruence=false}
                val original_plan = plan [] [#p e] false
                val original_block = P.freeze_source_cut_rule_plan
                  (#work e) original_plan
                val original_native =
                  P.source_cut_block_for (#work e) original_block
                val original_edge = W.with_step (#work e)
                  (fn () => P.source original_native 0)
                val cut = P.realize_source_cut_receipt (#work e)
                  original_block (#p e) original_edge
                val missing = plan [cut] [q] true
