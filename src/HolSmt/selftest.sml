local
  structure G = SmtReplayGraph
  structure S = SmtReplaySource
  structure W = SmtReplayInvocationWork
  structure P = SmtReplayProof
  structure Scope = SmtReplayOwnedScopeReceipt
  structure NC = SmtReplayNativeContract
  structure RP = SmtReplayResourcePolicy
  val p = Term.mk_var ("fixed_mp_p",Type.bool)
  val q = Term.mk_var ("fixed_mp_q",Type.bool)
  val law = boolSyntax.mk_imp (p,q)
  type env = {graph:G.graph,scope:G.scope,sources:S.sources,
    work:W.portfolio,block:P.block,policy:bool,closed:bool ref,
    law:G.node,target:G.node}
  datatype instruction = Finite of P.primitive_plan
    | Policy of P.policy_primitive_plan
  fun require message yes = if yes then () else raise Fail message
  fun test label action =
    ((Count.counting_thms true;testutils.tprint label;action ();
      Count.counting_thms false;testutils.OK ())
     handle primary => (Count.counting_thms false;raise primary))
  fun error action = (ignore (action ());NONE)
    handle Feedback.HOL_ERR detail => SOME (Feedback.message_of detail)
  fun owned policy assumptions action =
    let
      val graph = G.new () val scope = G.root_scope graph
      val sources = S.new graph scope 256 {assumptions=assumptions,goal=q}
      val work = if policy then W.begin_with_policy graph scope sources
          {limits={input_limit=RP.AtMost 256,output_limit=RP.AtMost 256,
             template_limit=RP.AtMost 512},work_limit=RP.AtMost 10000000}
        else W.begin_with_scope_guard graph scope sources
          {limits={input_limit=256,output_limit=256,template_limit=512},
           work_limit=10000000}
      val closed = ref false
      fun run () =
        let
          val block = if policy then
              let
                val contract = NC.capture work
                  {semantic_limits={input_limit=256,output_limit=256,
                     template_limit=512},import_limit=256,
                   type_work_limit=1000000}
                val frontier =
                  P.prepare_original_realization_frontier_with_policy work
                    {roots=[],closed_facts=[],conversions=[]}
                val tables = W.with_step work (fn () =>
                  P.prepare_owned_realization_tables_with_policy work frontier)
                val freeze = W.with_step work (fn () =>
                  P.prepare_native_realization_freeze_with_policy work
                    {tables=tables,contract=contract,profiles=[],ordinal=392,
                     check_type=fn _ => ()})
              in W.with_step work (fn () =>
                P.freeze_owned_realization_tables_with_policy work freeze) end
            else P.prepare_needed_sources_with_work work
              {frame=Scope.root work,roots=[],additional_sources=[],
               closed_facts=[],conversions=[]}
          val e:env = {graph=graph,scope=scope,sources=sources,work=work,
            block=block,policy=policy,closed=closed,
            law=hd (S.assumption_nodes sources),
            target= #node (S.goal_source sources)}
        in action e end
      val outcome = Exn.capture run ()
      val cleanup = Exn.capture (fn () =>
        (W.close work;if !closed then () else G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res value => (Exn.release cleanup;value) end
  fun both assumptions action =
    List.app (fn policy => owned policy assumptions action) [false,true]
  fun prepare (e:env) recipe edges =
    if #policy e then Policy
      (P.prepare_primitive_with_policy (#work e) (#block e) recipe edges)
    else Finite (P.prepare_primitive (#work e) (#block e) recipe edges)
  fun execute work (Finite plan) = P.execute_primitive work plan
    | execute work (Policy plan) = P.execute_primitive_with_policy work plan
  fun rule e recipe edges =
    execute (#work (e:env)) (prepare e recipe edges)
  fun expanded (e:env) = W.with_step (#work e) (fn () =>
    let val constructor = if #policy e then
          P.constructor_with_policy (#work e) (#block e) (#law e)
        else P.constructor (#block e) (#law e)
    in rule e P.EqualityMP
      [constructor,P.source (#block e) 0] end)
  fun inputs (e:env) index =
    let val first = expanded e
        val second = W.with_step (#work e) (fn () =>
          P.source (#block e) index)
    in [first,second] end
  fun planned (e:env) index =
    let val edges = inputs e index
    in W.with_step (#work e) (fn () => prepare e P.ImplicationMP edges) end
  fun realize (e:env) edge = if #policy e then
      W.with_step (#work e) (fn () =>
        P.policy_source_realization_theorem_for (#work e)
          (P.execute_realization_with_policy (#work e)
            (P.prepare_realization_with_policy (#work e)
              (#block e) (#target e) edge)))
    else P.source_realization_theorem_for (#work e)
      (P.realize_source_owned_receipt (#work e) (#block e) (#target e) edge)
  fun retired (e:env) = #retired (W.audit_policy (#work e))
  fun close (e:env) =
    (G.close_scope (#graph e) (#scope e);#closed e := true)
  fun raw (e:env) node = G.representative (#graph e) node
in
  val _ = run_postlude 392 "fixed-implication-original-source-6" (fn () =>
    let
      val _ = test "Both fixed MP modes realize only actual original premises"
        (fn () => both [law,p] (fn e =>
          let
            val edges = inputs e 1
            val (edge,statistics) = SmtReplayRuleObservation.with_statistics
              (fn () => W.with_step (#work e)
                (fn () => rule e P.ImplicationMP edges))
            val proof = realize e edge
            (* Full policy realization witnesses its entire Source prefix;
               the finite sparse receipt witnesses only the used leaves. *)
            val originals = List.map (raw e)
              (S.assumption_nodes (#sources e) @
               (if #policy e then [S.denied_goal_node (#sources e)] else []))
            val checks =
              [Portable.pointer_eq (Thm.concl proof,raw e (#target e)),
               Term.aconv (Thm.concl proof) q,
               length (Thm.hyp proof)=(if #policy e then 3 else 2),
               List.all (fn hyp => List.exists
                 (fn term => Portable.pointer_eq (hyp,term)) originals)
                 (Thm.hyp proof),
               null (Tag.axioms_of (Thm.tag proof)),
               #selected_returns statistics=1,
               #two_premise_returns statistics=1,
               #theorem_operand_edges statistics=2,not (retired e),
               not (List.exists (fn hyp => Term.aconv hyp q)
                 (Thm.hyp proof))]
            val _ = if List.all (fn yes => yes) checks then () else
              print ("fixed MP policy=" ^ Bool.toString (#policy e) ^
                " checks [endpoint,Goal,Hyp count,Hyp pointers,tag," ^
                "returns,arity,edges,live,no Goal Hyp]=" ^
                String.concatWith "," (List.map Bool.toString checks) ^
                "\n")
          in require "fixed MP changed endpoint, Hyp, tag or native route"
            (List.all (fn yes => yes) checks)
          end))
      val _ = test "A duplicate Source retains its actual selected occurrence"
        (fn () => both [law,p,p] (fn e =>
          let
            val instruction = planned e 2
            val edge = W.with_step (#work e) (fn () =>
              execute (#work e) instruction)
            val prefix = W.with_step (#work e) (fn () =>
              P.sources (#block e))
            val occurrences = W.with_step (#work e) (fn () =>
              List.filter (fn index => index < length prefix)
                (P.dependencies (#block e) edge))
            val proof = realize e edge
          in require "equal Source nodes merged their actual MP provenance"
            (occurrences=[0,2] andalso
             prefix=S.assumption_nodes (#sources e) @
               [S.denied_goal_node (#sources e)] andalso
             length (Thm.hyp proof)=(if #policy e then 3 else 2) andalso
             List.all (fn hyp => List.exists (fn node =>
               Portable.pointer_eq (hyp,raw e node))
               (if #policy e then prefix else
                 S.assumption_nodes (#sources e))) (Thm.hyp proof) andalso
             not (List.exists (fn hyp => Term.aconv hyp q)
               (Thm.hyp proof)) andalso
             Portable.pointer_eq (Thm.concl proof,raw e (#target e))) end))
      val _ = test "Negation is not an actual implication constructor"
        (fn () => both [boolSyntax.mk_neg p,p] (fn e =>
          let
            val edges = inputs e 1
            val prior = Count.thm_count ()
            val no = error (fn () => W.with_step (#work e)
              (fn () => ignore (prepare e P.ImplicationMP edges)))
          in require "negation was reclassified as a fixed MP rule"
            (Option.isSome no andalso Count.thm_count ()=prior andalso
             retired e) end))
      val _ = test "A different actual premise cannot prove the Goal"
        (fn () => both [law,q] (fn e =>
          let val instruction = planned e 1
              val no = error (fn () => W.with_step (#work e)
                (fn () => ignore (execute (#work e) instruction)))
          in require "MP inferred its antecedent from a target label"
            (Option.isSome no andalso retired e andalso
             S.assumption_nodes (#sources e)<>[]) end))
      val _ = test "Expected Work precedes stale fixed MP plan backing"
        (fn () => List.app (fn policy => owned policy [law,p] (fn held =>
          let val instruction = planned held 1 val _ = close held
          in owned policy [law,p] (fn expected =>
            let val prior = Count.thm_count ()
                val no = error (fn () => W.with_step (#work expected)
                  (fn () => ignore (execute (#work expected) instruction)))
            in require "foreign MP plan activated or retired its held owner"
              (no=SOME "different original Work" andalso
               Count.thm_count ()=prior andalso retired expected andalso
               not (retired held)) end) end)) [false,true])
      val _ = test "A checked MP plan executes once in either Work mode"
        (fn () => both [law,p] (fn e =>
          let val instruction = planned e 1
              val _ = W.with_step (#work e) (fn () =>
                execute (#work e) instruction)
              val prior = Count.thm_count ()
              val no = error (fn () => W.with_step (#work e)
                (fn () => ignore (execute (#work e) instruction)))
          in require "used MP plan repeated an admitted native operation"
            (no=SOME (if #policy e then "used plan"
                       else "plan already executed") andalso
             Count.thm_count ()=prior andalso retired e) end))
    in () end)
end

local
  structure G = SmtReplayGraph
  structure S = SmtReplaySource
  structure W = SmtReplayInvocationWork
  structure V = SmtLib_GraphSourcePortfolio
  structure GP = SmtLib_GraphPreprocess
  structure E = SmtLib_GraphQueryEmission
  structure F = SmtLib_GraphFiniteQueryTransport
  structure Body = SmtLib_GraphFiniteBinderLaw
  structure O = SmtLib_GraphCheckedQueryOpening
  structure B = SmtLib_GraphBackendSelection
  structure P = SmtReplayProof
  structure NC = SmtReplayNativeContract
  structure RP = SmtReplayResourcePolicy
  type env = {graph:G.graph,scope:G.scope,sources:S.sources,work:W.portfolio,
    validation:V.validation,query:GP.graph_query,contract:NC.contract}
  type prepared = {preparation:F.preparation,bodies:F.body_plan list,
    plan:F.body_query_plan,backend:B.transport}
  val finite = ``FINITE (finite_query_body_set:num -> bool)``
  val x = Term.mk_var ("finite_query_body_x",intSyntax.int_ty)
  val target = SOME {solver="cvc5",version=SOME "1.3.4"}
  val options:SmtLib_TranslationEmissions.options =
    {policy=fn _ => NONE,dialect=SmtLib.Standard27,
     apply_operator=SmtLib.ApplyUnderscore,get_proof=true,target=target}
  val limits:NC.limits =
    {semantic_limits={input_limit=1000000,output_limit=1000000,
       template_limit=1000000},import_limit=1000000,
     type_work_limit=100000000}
  fun abstraction condition = Term.mk_abs (x,
    boolSyntax.mk_cond (condition,x,intSyntax.mk_negated x))
  fun require message yes = if yes then () else raise Fail message
  fun test label action =
    ((Count.counting_thms true;testutils.tprint label;action ();
      Count.counting_thms false;testutils.OK ())
     handle primary => (Count.counting_thms false;raise primary))
  fun error action = (ignore (action ());NONE)
    handle Feedback.HOL_ERR detail => SOME (Feedback.message_of detail)
  fun fixture_after assumptions condition observe action =
    let
      val graph = G.new () val scope = G.root_scope graph
      val lambda = abstraction condition
      val sources = S.new_with_policy graph scope RP.Uncapped
        {assumptions=assumptions,goal=boolSyntax.mk_eq (lambda,lambda)}
      val work = W.begin_with_policy graph scope sources
        {limits={input_limit=RP.Uncapped,output_limit=RP.Uncapped,
           template_limit=RP.Uncapped},work_limit=RP.AtMost 1000000000}
      fun run () =
        let
          val contract = NC.capture work limits
          val validation = W.with_step work (fn () =>
            let val {assumptions,denied} = V.originals_with_policy work
            in V.validate_portfolio_with_policy work
              {assumptions=assumptions,
               goal= #node (S.goal_source sources),denied=denied} end)
          val query = GP.prepare_query_with_policy work
            (GP.from_portfolio_with_policy work validation)
          val e:env = {graph=graph,scope=scope,sources=sources,work=work,
            validation=validation,query=query,contract=contract}
        in observe e (Exn.capture action e) end
      val outcome = Exn.capture run ()
      val cleanup = Exn.capture (fn () =>
        (W.close work;G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res result => (Exn.release cleanup;result) end
  fun fixture assumptions condition =
    fixture_after assumptions condition (fn _ => Exn.release)
  fun opener (e:env) caller node = ignore
    (G.record_opened_view_with_policy (#graph e) caller
      (RP.AtMost 1000000) node)
  fun prepare (e:env) callback =
    let
      val rows = ref ([]:O.opening list)
      fun open_view caller node =
        let val source = G.record_opened_view_with_policy (#graph e) caller
              (RP.AtMost 1000000) node
        in if caller= #scope e andalso #node source<>node andalso
            not (List.exists (fn row => #original row=node) (!rows)) then
            rows := {scope=caller,original=node,opened= #node source}:: !rows
          else () end
      val prepared:prepared =
        SmtLib_GraphQueryEmission.prepare_finite_body_query (#work e)
          {query= #query e,validation= #validation e,options=options,
           open_opaque=open_view,native_contract= #contract e,ordinal=393,
           check_type=callback}
      val _ = B.with_transported_context_with_policy (#work e)
        (#backend prepared) (#query e) (opener e) (fn (_,backend) =>
          require "fixture requires actual original native Set mode"
            (#set_backend ((#snapshot backend) ())=SmtLib.CVC5NativeSet))
    in (prepared,List.rev (!rows)) end
  fun open_query (e:env) rows =
    SmtLib_GraphCheckedQueryOpening.transport_with_conversions_with_policy
      (#work e) {validation= #validation e,openings=rows,
        native_contract= #contract e,profiles=[],ordinal=393,
        check_type=fn _ => ()}
  fun bindings (e:env) (prepared:prepared) (opening:O.opened_query) =
    List.map (fn plan =>
      case SmtLib_GraphFiniteBinderLaw.execute_conditioned_with_policy
          (#work e) plan {validation= #validation opening,profiles=[]} of
        Body.Conditional {fact,condition,source,target,evidence} =>
          {plan=plan,fact=fact,condition=condition,source=source,target=target,
           evidence=evidence}:F.body_binding
      | _ => raise Fail "supported body did not produce a genuine root law")
      (#bodies prepared)
  fun execute (e:env) (prepared:prepared) opening bindings =
    SmtLib_GraphFiniteQueryTransport.execute_body_query_with_policy
      (#work e) (#plan prepared) {opening=opening,bindings=bindings}
  fun rewritten (F.QueryRewritten value) = value
    | rewritten (F.QueryNeeds _) = raise Fail "supported body query kept Needs"
  fun raw (e:env) node =
    let val term = G.representative (#graph e) node
    in require "body query fixture exceeded bounded native oracle"
      (Option.isSome (SmtReplayImport.bounded_raw_size 256 term));term end
  fun current (e:env) validation = W.with_step (#work e) (fn () =>
    V.current_facts_with_policy_for (#work e) validation)
  fun realize (e:env) preprocessing target =
    let
      val work = #work e
      val frontier = GP.prepare_final_frontier_with_policy work
        preprocessing {roots=[]}
      val tables = W.with_step work (fn () =>
        P.prepare_owned_realization_tables_with_policy work frontier)
      val freeze = W.with_step work (fn () =>
        let val ordinal = W.unused_policy_ordinal work
