      val _ = TextIO.closeIn input
      val packet = Exn.release parsed
    in {graph = graph,scope = scope,sources = sources,work = work,
      preprocessing = preprocessing,packet = packet,goal = goal,
      assumptions = assumptions} end
  fun close (e:env) = (Q.close (#packet e);W.close (#work e))
  fun run (e:env) =
    Z3_GraphProofReplay.check_proof_with_ground_definition_packet_with_work
      (#work e) (#graph e) (#scope e)
      {sources = #sources e,preprocessing = #preprocessing e,
       packet = #packet e,template_limit = 512}
  fun clean theorem = null (Tag.axioms_of (Thm.tag theorem)) andalso
    List.all (fn tag => tag = "DISK_THM")
      (#1 (Tag.dest_tag (Thm.tag theorem)))
  fun good (e:env) theorem =
    Portable.pointer_eq (Thm.concl theorem,#goal e) andalso clean theorem
    andalso List.all (fn hypothesis => List.exists (fn original =>
      Term.aconv hypothesis original) (#assumptions e)) (Thm.hyp theorem)
    andalso #charged (W.audit (#work e)) > 0
  fun script token reversed unused duplicate =
    let
      val target = if reversed then "(= " ^ token ^ " private!0)"
        else "(= private!0 " ^ token ^ ")"
      val forward = if reversed then "@d1" else
        "(symm @d1 (= " ^ token ^ " private!0))"
      val backward = if reversed then
        "(monotonicity @d2 (= (not " ^ token ^ ") (not private!0)))"
        else "(symm (monotonicity @d2 (= (not private!0) (not " ^
          token ^ "))) (= (not " ^ token ^ ") (not private!0)))"
      val second = if duplicate then "(intro-def " ^ target ^ ")"
        else "@d1"
      val extra = if unused then
        "(declare-fun unused!0 () Bool) " else ""
      val hidden = if unused then
        "(let ((@unused (intro-def (= unused!0 q)))) " else ""
      val finish_hidden = if unused then ")" else ""
    in "((declare-fun private!0 () Bool) " ^ extra ^ "(proof " ^
      "(let ((@d1 (intro-def " ^ target ^ "))) " ^
      "(let ((@d2 " ^ second ^ ") ) " ^ hidden ^
      "(unit-resolution (mp (asserted " ^ token ^ ") " ^ forward ^
      " private!0) (mp (asserted (not " ^ token ^ ")) " ^ backward ^
      " (not private!0)) false)" ^ finish_hidden ^ "))))" end
  fun checked assumptions goal text =
    let val e = setup (G.new ()) assumptions goal text
        val theorem = run e
        val _ = S.check_goal (#sources e) theorem
        val valid = good e theorem andalso List.length (Thm.hyp theorem) = 1
        val _ = close e
    in valid andalso #retired (W.audit (#work e)) end
