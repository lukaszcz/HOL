        P.prepare_policy_sparse_freeze_with_profiles work
          {tables=tables,contract= #contract e,profiles=[],
           check_type=fn _ => ()})
      val block = W.with_step work (fn () =>
        P.execute_policy_sparse_freeze work freeze)
      val edge = case GP.assembler_sparse_with_policy work
          preprocessing block target of SOME value => value
        | NONE => raise Fail "body law unassembled"
    in W.with_step work (fn () =>
      let val plan = P.prepare_policy_sparse_realization work block
            {target=target,edge=edge}
          val result = P.execute_policy_sparse_realization work plan
      in #theorem (P.policy_sparse_result_for work result) end) end
