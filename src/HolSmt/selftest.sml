              val assertions=asserted_values e data
              val calls=ref 0 val prior=Count.thm_count()
              val result=Final.prepare_with_policy(#work e)(#query e)held
                {assertions=assertions,native_contract= #contract e,
                 profiles=[],check_type=fn _=>calls:= !calls+1}
              val alive=W.with_step(#work e)(fn()=>
                (ignore(VP.contents_with_policy_for
                   (#work e)(#query e)held);true))
              val _=VP.close held
          in require "pending CPC queue executed or adopted caller packet"
            (!calls=0 andalso Count.thm_count()=prior andalso alive andalso
             not(#retired(W.audit_policy(#work e)))andalso
             (case result of Final.ReplayNeeds
                [Receiver.RuleProgramme{id,rule,pop}]=>
                  id="@later"andalso #replay_handler rule="trust"andalso
                  not pop|_=>false))end))
      val _=test "The CPC public finalizer is consumed once only"
        (fn()=>fixture[double]goal(fn e=>using e ordinary(fn _=>())
          (fn _=>fn _=>fn prepared=>
            let val owner=ready prepared
                val result=proved(Final.finish_with_policy(#work e)owner)
                val _=checked e(#theorem result)
                val prior=Count.thm_count()
                val rejected=refused(fn()=>ignore
                  (Final.finish_with_policy(#work e)owner))
            in require "CPC public closure replayed a completed invocation"
              (rejected andalso Count.thm_count()=prior andalso
               #retired(W.audit_policy(#work e)))end)))
      val _=test "Foreign Work precedes a completed CPC packet's backing"
        (fn()=>fixture[double]goal(fn held=>using held ordinary(fn _=>())
          (fn _=>fn _=>fn prepared=>
            let val owner=ready prepared
                val result=proved(Final.finish_with_policy(#work held)owner)
                val _=checked held(#theorem result)
            in fixture[]boolSyntax.F(fn expected=>
              let val prior=Count.thm_count()
                  val exact=(ignore(Final.finish_with_policy
                    (#work expected)owner);false)
                    handle Feedback.HOL_ERR detail=>
                      Feedback.message_of detail="different original Work"
              in require "foreign Work activated the held closed packet"
                (exact andalso Count.thm_count()=prior andalso
                 #retired(W.audit_policy(#work expected))andalso
                 not(#retired(W.audit_policy(#work held))))end)end)))
      val _=test "CPC Type callback preserves exact Primary before inference"
        (fn()=>fixture[double]goal(fn e=>
          let val held=packet e introduced
              val data=W.with_step(#work e)(fn()=>
                VP.contents_with_policy_for(#work e)(#query e)held)
              val assertions=asserted_values e data
              exception Primary of unit ref val token=ref() val calls=ref 0
              val prior=Count.thm_count()
              val exact=(ignore(Final.prepare_with_policy(#work e)(#query e)
                held{assertions=assertions,native_contract= #contract e,
                  profiles=[],check_type=fn _=>(calls:= !calls+1;
                    raise Primary token)});false)
