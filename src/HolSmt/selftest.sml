      val _=test "Expired CPC packet fences a warmed prepared invocation"
        (fn()=>fixture[double]goal(fn e=>using e ordinary(fn _=>())
          (fn held=>fn _=>fn prepared=>
            let val owner=ready prepared val _=VP.close held
