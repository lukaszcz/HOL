            in require "mapping expanded sharing or lost topological order"
              (length nodes=142 andalso length applications=140 andalso
               visits<=142 andalso List.all prior nodes) end))
      val _ = test "Mapping failure preserves Primary and construction cleanup"
        (fn () =>
          let exception Primary of unit ref
              val token = ref () val calls = ref 0 val child = ref NONE
          in fixture
            (fn e => fn context =>
              let val binder = (#genvar context) Type.bool
                  val _ = child := Option.map #scope
                    ((#graph_node context) binder)
                  val symbols = commit context (#goal context) 0
                    ([],"Bool") NONE
