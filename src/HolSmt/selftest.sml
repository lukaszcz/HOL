(* BEGIN REPLAY GRAPH UNIFIER MIGRATION TESTS *)
val _ = let
  open SmtReplayGraph SmtReplayUnify
  val graph = SmtReplayGraph.new ()
  val scope = SmtReplayGraph.root_scope graph
  val rigid = SmtReplayGraph.variable graph scope RigidSource
    (Term.mk_var ("dag_unify_rigid",Type.bool))
  val flexible = SmtReplayGraph.variable graph scope SolverFlexible
    (Term.mk_var ("dag_unify_flexible",Type.bool))
  val conjunction = SmtReplayGraph.constant graph scope boolSyntax.conjunction
  fun shared 0 node = node
    | shared depth node =
        let val child = shared (depth-1) node in
          SmtReplayGraph.application graph scope
            (SmtReplayGraph.application graph scope (conjunction,child),child)
        end
  val target = shared 80 rigid
  fun unify left right = SmtReplayUnify.unify graph
    {scope = scope,flexible = [flexible],equations = [(left,right)]}
  fun check message success = if success then testutils.OK ()
    else testutils.die message
in
  testutils.tprint "Replay unification occurs check preserves shared DAGs";
  check "shared assignment lost its owned graph residue"
    (case unify flexible target of
       Unified result =>
         (case SmtReplayUnify.assignments result of
            [{variable,residue}] => variable = flexible andalso residue = target
          | _ => false)
     | _ => false);
  testutils.tprint "Replay unification rejects a cyclic shared substitution";
  check "shared cyclic assignment escaped its occurs check"
    (case unify flexible (shared 80 flexible) of
       NoMatch OccursCheck => true | _ => false);
  testutils.tprint "Replay unification skips equal shared subgraphs";
  check "equal shared graph acquired a solver assignment"
    (case unify target target of
       Unified result => List.null (SmtReplayUnify.assignments result)
     | _ => false)
end
(* END REPLAY GRAPH UNIFIER MIGRATION TESTS *)

