        val(left,right)=boolSyntax.dest_eq b
        val _=if #complete d andalso
            Type.compare(Term.type_of left,Type.bool)=EQUAL andalso
            Type.compare(Term.type_of right,Type.bool)=EQUAL then ()else
          raise Fail "actual current completed consequent is not bool EQ"
        val v=case #decision d of P.ConditionalSingleton term=>term
          | _=>raise Fail "actual current scalar singleton is absent"
        val(f,arg)=Term.dest_comb c
        val md=metadata e(refine e token)
        val _=if Term.term_eq arg v andalso Term.is_var v andalso
            (Term.is_var f orelse Term.is_const f)andalso
            member v(#condition_variables md)andalso
            not(member v(#equation_variables md))andalso
            not(member v(#native_hypothesis_variables md))then ()else
          raise Fail "actual condition differs from selected scalar VAR"
    in(d,v,c,b)end
