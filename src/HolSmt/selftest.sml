  fun expected () =
    let val lambda = abstraction boolSyntax.T
    in boolSyntax.mk_eq (lambda,lambda) end
  fun result_at condition e prepared opening bindings =
    let val output = rewritten (execute e prepared opening bindings)
        val facts = current e (#validation output)
        val proof = realize e (#preprocessing output)
          (V.endpoint (#denied facts))
        val actual_goal = raw e (#goal facts)
        fun bounded_text term =
          case SmtReplayImport.bounded_raw_size 256 term of
              SOME _ => Parse.term_to_string term
            | NONE => "<diagnostic term exceeds 256 nodes>"
        val lambda = abstraction condition
        val expected_goal = boolSyntax.mk_eq (lambda,lambda)
        val checks =
          [Term.aconv actual_goal expected_goal,
           Term.aconv (Thm.concl proof) (boolSyntax.mk_neg expected_goal),
           null (#assumptions facts),
           Portable.pointer_eq (V.original_sources (#validation output),
             #sources e),
           GP.source_nodes (#preprocessing output)=
             S.assumption_nodes (#sources e) @
               [S.denied_goal_node (#sources e)]]
        val _ = if List.all (fn yes => yes) checks then () else
          print ("whole finite query checks [Goal,denial,assumptions," ^
            "Sources,prefix]=" ^
            String.concatWith "," (List.map Bool.toString checks) ^
            "\nGoal=" ^ bounded_text actual_goal ^
            "\ndenial=" ^ bounded_text (Thm.concl proof) ^ "\n")
    in require "actual root erasure changed Goal/denial or original Sources"
      (List.all (fn yes => yes) checks);
       (output,facts,proof) end
  fun result e prepared opening bindings =
    result_at boolSyntax.T e prepared opening bindings
