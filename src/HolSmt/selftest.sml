  fun ensure why yes = if yes then testutils.OK () else raise Fail why
  fun refuses f = (ignore (f ());false) handle Feedback.HOL_ERR _ => true
  fun setup assumptions goal policy opened : fixture =
    let val graph=G.new () val root=G.root_scope graph
        val sources=S.new graph root cap
          {assumptions=assumptions,goal=goal}
        val work=W.begin graph root sources
          {limits={input_limit=cap,output_limit=cap,template_limit=cap},
           work_limit=20000000}
        val traversal=T.begin work
          {check_type=fn _ => (),scope_opened=fn _ => ()}
