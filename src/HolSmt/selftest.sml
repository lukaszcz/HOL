          scope_opened=opened}
    in {graph=graph,root=root,sources=sources,work=work,
      transfer=transfer,owner=owner} end
  fun plain assumptions goal = setup assumptions goal
    (fn _ => ()) (fn _ => ())
  fun query (e:fixture) = Q.execute (Q.prepare (#owner e))
  fun good (e:fixture) theorem =
    Portable.pointer_eq (Thm.concl theorem,
      #2 (S.original_goal (#sources e))) andalso
    null (Tag.axioms_of (Thm.tag theorem)) andalso
    List.all (fn oracle => oracle="DISK_THM")
      (#1 (Tag.dest_tag (Thm.tag theorem))) andalso
    List.all (fn h => List.exists (fn node => Portable.pointer_eq
      (h,G.representative (#graph e) node))
      (S.assumption_nodes (#sources e))) (Thm.hyp theorem)
  fun prepare_solver (e:fixture) q =
    let val d=Q.description_for (#work e) q
        val scope= #scope (Scope.description_for (#work e) (#frame d))
        val n=N.description_for (#work e) (#transfer e)
        val original=Tactical.prove (#original (#source n),
          bossLib.SIMP_TAC boolSimps.bool_ss [] THEN numLib.ARITH_TAC)
        val transferred=Thm.EQ_MP
          (N.transfer_theorem_for (#work e) (#transfer e)) original
        val canonical=Thm.EQ_MP (#bridge (#target n)) transferred
        fun strip theorem =
          if boolSyntax.is_forall (Thm.concl theorem) then
            let val (variable,_)=boolSyntax.dest_forall (Thm.concl theorem)
            in strip (Thm.SPEC variable theorem) end
          else if boolSyntax.is_imp (Thm.concl theorem) then
            let val (assumption,_)=boolSyntax.dest_imp (Thm.concl theorem)
            in strip (Thm.MP theorem (Thm.ASSUME assumption)) end
          else theorem
        val local_proof=strip canonical
        val actual_asms=List.map (G.representative (#graph e)) (#assumptions d)
        val closed=List.foldr (fn (a,th) => Thm.DISCH a th)
          local_proof actual_asms
        (* Canonical GEN variables are Bound nodes whose fresh printed
           names need not be lexical import keys. Build this test law from
           the exact authenticated query nodes, never re-import those names. *)
        val implication=G.constant (#graph e) scope boolSyntax.implication
        val law_node=List.foldr (fn (a,b) => G.application (#graph e) scope
          (G.application (#graph e) scope (implication,a),b))
          (#goal d) (#assumptions d)
        val statement=G.representative (#graph e) law_node
        val canonical=Thm.EQ_MP
          (Thm.ALPHA (Thm.concl closed) statement) closed
        val law=W.with_step (#work e) (fn () =>
          P.record_closed (#graph e) scope
            {node=law_node,theorem=canonical,template_limit=cap,
             check_type=fn _ => ()})
        val block=Q.freeze_for (#work e) q
          {roots=[law_node],closed_facts=[law],conversions=[]}
        val prefix=P.sources block
        val offset=length (S.assumption_nodes (#sources e))+1
        fun use [] node edge =
              if node= #goal d then edge
              else raise Fail "fixture local conclusion changed"
          | use (assumption::rest) node edge =
              let val tail=case G.view (#graph e) node of
                    G.Application (head,tail) =>
                      (case G.view (#graph e) head of
                         G.Application (_,left) =>
                           if left=assumption then tail
                           else raise Fail "fixture local implication changed"
                       | _ => raise Fail "fixture implication head")
                  | _ => raise Fail "fixture implication"
                  val index=offset+length (#assumptions d)-length rest-1
                  val constructor=P.constructor block node
                  val source=P.source block index
                  val next=P.compose block
                    (fn [law,equality,assumed] =>
                      Thm.MP (Thm.EQ_MP equality law) assumed
                     | _ => raise Fail "fixture MP arity")
                    [edge,constructor,source]
              in use rest tail next end
        val contradiction=W.with_step (#work e) (fn () =>
          let val positive=use (#assumptions d) law_node
                (P.closed block law)
        val denied=P.source block (offset+length (#assumptions d))
        val negation=P.constructor block (#denied d)
        val bottom=G.constant (#graph e) scope boolSyntax.F
        val definition=P.definition block bottom
        val contradiction=P.compose block
          (fn [pos,neg,eqneg,eqfalse] =>
            Thm.EQ_MP (Thm.SYM eqfalse)
              (Thm.MP (Thm.NOT_ELIM (Thm.EQ_MP eqneg neg)) pos)
           | _ => raise Fail "fixture contradiction arity")
          [positive,denied,negation,definition]
          in contradiction end)
    in (block,contradiction,prefix,d) end
  fun finish e q =
    let val (block,edge,prefix,d)=prepare_solver e q
        val theorem=Q.close_for (#work e) q block edge
    in (theorem,prefix,d) end
