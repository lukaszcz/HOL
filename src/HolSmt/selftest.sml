      val graph = G.new () val scope = G.root_scope graph
      val body = boolSyntax.mk_cond
        (boolSyntax.mk_conj (finite_s,finite_t),x,boolSyntax.mk_neg x)
      val abstraction = Term.mk_abs (x,body)
      val goal = boolSyntax.mk_eq (abstraction,abstraction)
      val _ = require "lambda law fixture exceeded its native oracle bound"
        (Option.isSome (SmtReplayImport.bounded_raw_size 128 goal))
      val sources = S.new_with_policy graph scope RP.Uncapped
        {assumptions=[finite_s,finite_t],goal=goal}
      val view = G.record_opened_view_with_policy graph scope
        (RP.AtMost 10000) (#node (S.goal_source sources))
      val work = W.begin_with_policy graph scope sources
        {limits={input_limit=RP.Uncapped,output_limit=RP.Uncapped,
           template_limit=RP.Uncapped},work_limit=RP.AtMost 1000000000}
      fun run () =
        let
          val contract = NC.capture work native
          val frame = Scope.root_with_policy work
          val expected = {graph=graph,scope=scope,sources=sources,work=work}
          val focus = A.initial_goal_with_policy work {view=SOME view}
          val (partial,_) = A.application_children_with_policy expected focus
          val (_,admission) =
            A.application_children_with_policy expected partial
          val descriptor = A.describe_with_policy_for expected admission
          val closure = G.closure_child_binder graph scope (#child descriptor)
          val captured = G.binder_closure_data graph scope closure
          val body_frame =
            Scope.body_with_policy work frame (#child descriptor)
          fun arguments current inputs = case G.view graph current of
              G.Application (head,argument) =>
                arguments head (argument::inputs)
            | _ => inputs
          val condition = case arguments (#body captured) [] of
              [condition,_,_] => condition
            | _ => raise Fail "fixture body lost its conditional"
          val (body1,body2) = case arguments condition [] of
              [first,second] => (first,second)
            | _ => raise Fail "fixture condition lost its conjunction"
          val e:env = {graph=graph,scope=scope,sources=sources,work=work,
            contract=contract,frame=frame,body_frame=body_frame,
            body_scope= #body_frame captured,body= #body captured,
            binder= #binder captured,admission=admission,
            body1=body1,body2=body2,
            condition1=hd (S.assumption_nodes sources),
            condition2=hd (tl (S.assumption_nodes sources))}
          val outcome = Exn.capture action e
        in observe e outcome end
      val outcome = Exn.capture run ()
      val cleanup = Exn.capture (fn () =>
        (W.close work;G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res value => (Exn.release cleanup;value) end
  fun fixture action = fixture_after limits (fn _ => Exn.release) action
  fun raw (e:env) node = G.representative (#graph e) node
  fun app (e:env) scope atom operands =
    List.foldl (fn (argument,head) =>
      G.application (#graph e) scope (head,argument))
      (G.constant (#graph e) scope atom) operands
  fun equation (e:env) = app e (#body_scope e)
    (Term.rator (Term.rator (boolSyntax.mk_eq (boolSyntax.T,boolSyntax.T))))
    [#body e,#binder e]
  fun context (e:env) frame callback = D.create_with_policy (#work e)
    {frame=frame,native_contract= #contract e,profiles=[],ordinal=381,
     check_type=callback}
  fun body_program (e:env) callback = W.with_step (#work e) (fn () =>
    let
      val ctx = context e (#body_frame e) callback
      val target = equation e
      val law = D.schema_with_policy (#work e) ctx
        {theorem=body_law,premises=[#body1 e,#body2 e],target=target}
      val first = D.evidence_with_policy (#work e) ctx (#body1 e)
      val second = D.evidence_with_policy (#work e) ctx (#body2 e)
      val result = D.apply_with_policy (#work e) ctx
        {law=law,premises=[first,second],target=target}
    in (ctx,result) end)
