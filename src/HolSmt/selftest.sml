      {proof = proof,template_limit = 10000,
       local_law = fn _ => (#calls f := !(#calls f)+1;NONE),
       nnf = fn _ => (#calls f := !(#calls f)+1;NONE)}
  val cpc_text = "((assume @a p) (assume @n (not p)) " ^
    "(step @false false :rule contra :premises (@a @n)))"
  val z3_text =
    "((proof (unit-resolution (asserted p) (asserted (not p)) false)))"
