  type env = {graph:G.graph,scope:G.scope,sources:S.sources,
    work:W.portfolio,query:GP.graph_query,metadata:MD.metadata}
  val cap = RP.AtMost 1000000000
  val goal = ``(value_datatype_option:bool option) = SOME T``
  fun require message yes = if yes then () else raise Fail message
  fun test label action =
    (testutils.tprint label;action ();testutils.OK ())
  fun error action = (action ();NONE)
    handle Feedback.HOL_ERR detail => SOME (Feedback.message_of detail)
  fun owned action =
    let
      val graph = G.new () val scope = G.root_scope graph
      val sources = S.new graph scope 10000 {assumptions=[],goal=goal}
      val work = W.begin_with_policy graph scope sources
        {limits={input_limit=cap,output_limit=cap,template_limit=cap},
         work_limit=cap}
      fun run () =
        let
          val {assumptions,denied} = V.originals_with_policy work
          val validation = V.validate_portfolio_with_policy work
            {assumptions=assumptions,goal= #node (S.goal_source sources),
             denied=denied}
          val query = GP.prepare_query_with_policy work
            (GP.from_portfolio_with_policy work validation)
          fun open_view caller node = ignore
            (G.record_opened_view_with_policy graph caller
              (RP.AtMost 10000) node)
          val metadata = T.with_outbound_query_analysis_with_policy work
            query open_view (fn context => SmtLib.outbound_with_backend_context
              {sequence_emission=false,set_backend=SmtLib.Z3Set,
               bag_backend=SmtLib.Z3ArrayBag,
               has_set_terms=false,has_bag_terms=false}
              (fn backend =>
                let
                  val operations =
                    SmtLib_GraphCarrierOperations.make_with_datatypes context
                      {sequence_emission=false}
                      {term_to_string=fn _ =>
                        raise Fail "unexpected Value datatype formatter"}
                  val emission = SmtLib_GraphDispatcher.emit context
                    {operations=operations,regime=SmtLib.FirstOrder,
                     apply_operator=SmtLib.ApplyUnderscore,
                     prefix="value_datatype_",roots=[(0,#goal context)]}
                in SmtLib_GraphDeclarationMetadata.freeze context
                  {graph=graph,scope=scope,regime=SmtLib.FirstOrder,
                   backend=backend,operations=operations,emission=emission}
                end))
        in action ({graph=graph,scope=scope,sources=sources,work=work,
          query=query,metadata=metadata}:env) end
      val outcome = Exn.capture run ()
      val cleanup = Exn.capture (fn () =>
        (W.close work;G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res result => (Exn.release cleanup;result) end
  fun options (e:env) : F.value_options =
    {graph= #graph e,scope= #scope e,logic="ALL",sources=[],
     sorts=Redblackmap.mkDict String.compare,binder_lists=[],
     import_limit=cap,literal_limit=cap,binder_limit=RP.AtMost 1,
     recipe_limits={template_limit=cap,index_limit=cap,
       operand_limit=cap,token_limit=cap},
     special=fn _ => fn _ => NONE,
     ascribed=fn _ => fn _ => fn _ => NONE}
  fun description policy =
    {solver=case policy of F.Z3 => "Z3" | F.CPC => "cvc5",
     version=case policy of F.Z3 => "4.15.3" | F.CPC => "1.3.4",
     policy=policy,reserved_names=[]}
  fun source_token (e:env) =
    case List.find (fn {symbol,...}:MD.term_declaration =>
      Type.compare (#hol_type symbol,``:bool option``)=EQUAL andalso
      #arity symbol=M.Exact 0) (MD.term_declarations (#metadata e)) of
        SOME {symbol,...} => #token symbol
      | NONE => raise Fail "actual emitted option source symbol missing"
  (* Only the SMALL named cases use this oracle, never the shared70 test.
     Charge an unfolded64 counter before every native reconstruction. *)
  fun small context value =
    let val remaining = ref 64
        fun raw value =
          let val _ = require "small Value datatype oracle exceeded64"
                (!remaining>0)
              val _ = remaining := !remaining-1
          in case PV.view context value of
              PV.Variable (_,atom) => atom | PV.Constant atom => atom
            | PV.Application (function,argument) =>
                Term.mk_comb (raw function,raw argument)
            | PV.Abstraction {binder,body,...} =>
                Term.mk_abs (raw binder,raw body)
            | PV.RetainedGraph =>
                raise Fail "small Value datatype oracle retained raw syntax"
          end
    in raw value end
  fun unique context root =
    let val seen = ref (Redblackset.empty Int.compare)
        fun walk [] result = List.rev result
          | walk (value::rest) result =
              let val key = PV.key context value in
                if Redblackset.member (!seen,key) then walk rest result
                else let
                  val _ = seen := Redblackset.add (!seen,key)
                  val children = case PV.view context value of
                      PV.Application (left,right) => [left,right]
                    | PV.Abstraction {binder,body,...} => [binder,body]
                    | _ => []
                in walk (children @ rest) (value::result) end
              end
    in walk [root] [] end
  fun atomic (e:env) value : F.value_term =
    {node=value,scope= #scope e,binder_blocks=[],
     occurrence=SmtLib_Parser.ConstructionOccurrence
       {value=value,role=SmtLib_Parser.ConstructionAtom,
        token="@Value-fixture",children=[]}}

  fun input text =
    let val next = ref 0 in fn () =>
      if !next=String.size text then NONE else
        let val value = String.sub (text,!next)
        in next:= !next+1;SOME value end end
  fun packet (e:env) text =
    CPC_GraphValueProofParser.create_packet_with_policy_from_input
      (#work e) (#query e) (options e) (#metadata e) "1.3.4" (input text)
  fun contents (e:env) held =
    VP.contents_with_policy_for (#work e) (#query e) held
  fun using_packet (e:env) text action =
    let val held = packet e text
        val outcome = Exn.capture (fn () => W.with_step (#work e)
          (fn () => action held (contents e held))) ()
        val cleanup = Exn.capture VP.close held
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res result => (Exn.release cleanup;result) end
  fun datatype_text (e:env) =
    let val types = M.types (MD.mapping (#metadata e))
        val name = valOf (Redblackmap.peek (types,``:bool option``))
        val declarations = SmtLib.parser_datatype_declarations_from_types types
        val constructors = case List.find
          (fn {hol_type,...}:SmtLib.parser_datatype_declaration =>
            Type.compare (hol_type,``:bool option``)=EQUAL) declarations of
              SOME {constructors,...} => constructors
            | NONE => raise Fail "CPC actual option schema missing"
        fun constructor ({token,selectors,...}:
            SmtLib.parser_datatype_constructor) =
          "(" ^ token ^ String.concat (List.map (fn (selector,ty) =>
            (require "option selector field changed"
               (Type.compare (ty,Type.bool)=EQUAL);
             " (" ^ selector ^ " Bool)")) selectors) ^ ")"
    in "(declare-datatype " ^ name ^ " (" ^
      String.concatWith " " (List.map constructor constructors) ^ ")) " end
  fun native_options (e:env) : F.policy_options =
    {graph= #graph e,scope= #scope e,logic="ALL",sources=[],
     sorts=Redblackmap.mkDict String.compare,binder_lists=[],
     import_limit=cap,literal_limit=cap,binder_limit=cap,
     recipe_limits={template_limit=cap,index_limit=cap,
       operand_limit=cap,token_limit=cap},
     special=fn _ => fn _ => NONE,
     ascribed=fn _ => fn _ => fn _ => NONE}
  fun native_small (e:env) node =
    let val raw = G.representative (#graph e) node in
      case SmtReplayImport.bounded_raw_size 64 raw of SOME _ => raw
        | NONE => raise Fail "CPC native small oracle exceeded64" end
  fun same_term e context (left:F.term,right:F.value_term) =
    Term.aconv (native_small e (#node left)) (small context (#node right))
  fun same_argument e context (left,right) = case (left,right) of
      (C.GraphTerm a,C.GraphTerm b) => same_term e context (a,b)
    | (C.GraphList a,C.GraphList b) =>
        ListPair.allEq (same_argument e context) (a,b)
    | (C.GraphIndex a,C.GraphIndex b) => a=b
    | (C.GraphSort a,C.GraphSort b) => Type.compare (a,b)=EQUAL
    | (C.GraphHint a,C.GraphHint b) => a=b
    | _ => false
  fun same_command e context (left,right) = case (left,right) of
      (C.GraphAssume (a,x),C.GraphAssume (b,y)) =>
        a=b andalso same_term e context (x,y)
    | (C.GraphAssumePush (a,x),C.GraphAssumePush (b,y)) =>
        a=b andalso same_term e context (x,y)
    | (C.GraphStep {step=a,pop=x},C.GraphStep {step=b,pop=y}) =>
        x=y andalso #id a= #id b andalso #rule a= #rule b andalso
        #premises a= #premises b andalso
        #raw_conclusion a= #raw_conclusion b andalso
        #raw_args a= #raw_args b andalso
        (case (#conclusion a,#conclusion b) of (NONE,NONE) => true
          | (SOME a,SOME b) => same_term e context (a,b) | _ => false)
        andalso ListPair.allEq (same_argument e context) (#args a,#args b)
    | _ => false
  fun with_context e action = using_packet e "((assume @base true))"
    (fn _ => fn current => action (#context current))
  fun scalar context scope term = PV.literal context scope cap term
  fun natural context maximum value =
    case PV.natural_index_with_policy context maximum value of
        PV.NaturalIndex value => value
      | _ => raise Fail "expected natural scalar"
