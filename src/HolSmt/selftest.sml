                    let val rejected = case outcome of Exn.Exn primary =>
                            message primary=
                              SOME "query declaration lifetime changed"
                          | _ => false
                    in require "presence used an epoch-stale empty inventory"
                      (rejected andalso
                       #retired (W.audit_policy (#work e))) end)
                  (fn _ => fn context =>
