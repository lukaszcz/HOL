      | _ => raise Fail "actual typed proof root lost Bind" end)
  fun scoped e held parent child =
    SmtLib_GraphValueProof.binding_scope_with_policy
      (#work (e:env)) (#query e) held parent child
  fun direct (e:env) extra =
    SmtReplayOwnedParserValue.create (#work e)
