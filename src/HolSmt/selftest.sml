  fun quant sort body left right=
    "(quant-intro (proof-bind (lambda ((x " ^ sort ^ ")) " ^ body ^
    ")) (= (lambda ((a " ^ sort ^ ")) " ^ left ^
    ") (lambda ((b " ^ sort ^ ")) " ^ right ^ ")))"
  val bool_quant=quant "Bool" "(refl (= x x))" "a" "b"
  val int_quant=quant "Int" "(refl (= x x))" "a" "b"
  fun alias_quant body="(quant-intro (proof-bind " ^
    "(lambda ((x Bool)) " ^ body ^ ")) p)"
  fun shared_target body="(let ((f (lambda ((a Bool)) a))) " ^
    "(let ((p (= f f))) " ^ body ^ "))"
