       operand_limit = 1024,token_limit = 4096}}
  type fixture = {invocation : C.invocation,original : Abbrev.goal,
    sources : S.sources,p : Term.term}
  fun setup () : fixture =
    let
      val p = Term.mk_var ("invocation_original_p",Type.bool)
      val goal = boolSyntax.mk_conj (p,boolSyntax.T)
      val original = ([goal,goal],goal)
      val retained = ref NONE
      fun discover sources =
        let
          val _ = retained := SOME sources
          val graph = S.owning_graph sources
          val scope = S.owning_scope sources
          val hole = Term.mk_var ("invocation_schema_hole",Type.bool)
          val law = Thm.CONJUNCT1 (Thm.CONJUNCT2
            (Thm.SPEC hole boolTheory.AND_CLAUSES))
          fun conversion node = case G.view graph node of
              G.Application (inner,right) =>
                (case (G.view graph inner,G.view graph right) of
                  (G.Application (head,left),G.Constant _) =>
                    if Term.same_const (G.representative graph head)
                        boolSyntax.conjunction andalso
                      Term.same_const (G.representative graph right) boolSyntax.T
                    then SOME (K.checked_graph_schema graph scope
                      {theorem = law,holes = [hole],operands = [left],
                       template_limit = 10000}) else NONE
                | _ => NONE)
            | _ => NONE
        in GP.discover_from_sources graph scope sources
          {import_limit = 10000,revisit = false,check_type = fn _ => (),
           conversion = conversion} end
      val invocation = C.prepare_original limits discover original
      val sources = valOf (!retained)
    in {invocation = invocation,original = original,sources = sources,p = p}
    end
  fun with_fixture action =
    let val f = setup ()
        fun finish () = C.close_original (#invocation f)
        val result = action f handle primary =>
          ((finish () handle _ => ());raise primary)
    in finish ();result end
