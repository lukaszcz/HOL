    (fn node => (node,view graph scope node))
    (List.map #node (S.reconciliation_sources sources) @ replay)
  fun prepare graph scope sources replay opened raw binder steps types =
    H.prepare graph scope {sources = sources,replay = replay,views = opened,
      admission = {raw_limit = raw,binder_limit = binder,step_limit = steps,
                   check_type = types}}
  fun case_data assumption hyp =
    let val graph = G.new () val scope = G.root_scope graph
        val sources = S.new graph scope maximum
          {goal = hyp,assumptions = [assumption]}
        val positive = #node (G.import graph scope maximum hyp)
