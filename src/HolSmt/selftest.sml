        val original=F.originals_with_policy w
    in {g=g,r=r,s=s,w=w,n=n,original=original} end
  type environment={g:G.graph,r:G.scope,s:S.sources,w:W.portfolio,
    n:NC.contract,original:{assumptions:F.fact list,denied:F.fact}}
  fun imported (e:environment) term=
    #node(G.import_with_policy (#g e) (#r e) RP.Uncapped term)
  fun validate (e:environment) assumptions=
    GP.from_portfolio_with_policy (#w e)
      (F.validate_portfolio_with_policy (#w e)
        {assumptions=assumptions,goal= #node(S.goal_source(#s e)),
         denied= #denied(#original e)})
  fun freeze_at ordinal (e:environment) validation=
    let val w= #w e
        val f=GP.prepare_final_frontier_with_policy w validation {roots=[]}
        val t=W.with_step w (fn()=>
          P.prepare_owned_realization_tables_with_policy w f)
        val p=W.with_step w (fn()=>
          P.prepare_native_realization_freeze_with_policy w
            {tables=t,contract= #n e,profiles=[],ordinal=ordinal,
             check_type=fn _=>()})
    in W.with_step w (fn()=>
      P.freeze_owned_realization_tables_with_policy w p) end
  fun freeze e validation=freeze_at 0 e validation
  fun realize (e:environment) validation block node=
    let val edge=valOf(GP.assembler_with_policy (#w e) validation block node)
    in W.with_step (#w e) (fn()=>
      P.policy_source_realization_theorem_for (#w e)
        (P.execute_realization_with_policy (#w e)
          (P.prepare_realization_with_policy (#w e) block node edge))) end
  fun checked (e:environment) node theorem=
    Portable.pointer_eq(Thm.concl theorem,G.representative (#g e) node)
    andalso null(Tag.axioms_of(Thm.tag theorem)) andalso
    List.all(fn hypothesis=>List.exists(fn source=>
      Portable.pointer_eq(hypothesis,G.representative (#g e) source))
      (S.assumption_nodes(#s e)@[S.denied_goal_node(#s e)]))
      (Thm.hyp theorem)
  fun double_negative (e:environment) operand=
    let val g= #g e val r= #r e
        val hole=Term.mk_var("complete_graph_hole",Type.bool)
        val schema=C.checked_graph_schema g r
          {theorem=Thm.SPEC hole (Thm.CONJUNCT1 boolTheory.NOT_CLAUSES),
           holes=[hole],operands=[operand],template_limit=100000}
        val source=C.graph_schema_source schema
    in C.graph_conversion g r false
      (fn node=>if node=source then SOME schema else NONE) source end
  fun transported (e:environment) operand=
    F.transport (#g e) (#r e) (double_negative e operand)
      (hd(#assumptions(#original e)))
