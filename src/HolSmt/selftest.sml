                val block = P.freeze_source_cut_rule_plan (#work e) complete
                val native = P.source_cut_block_for (#work e) block
                val incoming = P.source_cut_edge_for (#work e) block cut
                val edge = W.with_step (#work e) (fn () =>
                  SmtReplayRules.boolean_rule graph native q
                    [(#p e,incoming),(assumption,P.source native 1)])
                val projected = P.realize_source_cut_receipt
                  (#work e) block q edge
                val projected =
                  P.source_realization_theorem_for (#work e) projected
              in require "Boolean premise gates or Source lineage changed"
                (Term.aconv (Thm.concl theorem) boolSyntax.F andalso
                 null (Tag.axioms_of (Thm.tag theorem)) andalso
                 length (Thm.hyp theorem)=3 andalso
                 List.all (fn hypothesis => List.exists (fn node =>
                   Portable.pointer_eq
                     (hypothesis,G.representative graph node)) allowed)
                   (Thm.hyp theorem) andalso
                 S.assumption_nodes (#sources e)=originals andalso
                 List.nth (originals,0)=List.nth (originals,2) andalso
                 Portable.pointer_eq
                   (Thm.concl projected,G.representative graph q) andalso
                 List.all (fn hypothesis => List.exists (fn node =>
                   Portable.pointer_eq
                     (hypothesis,G.representative graph node)) originals)
                   (Thm.hyp projected) andalso
                 #final_inst_calls (#proofs (#statistics result))>1 andalso
                 !calls=41 andalso not (#retired (W.audit (#work e))))
              end) end)
    in () end)
end



local
  structure G = SmtReplayGraph
