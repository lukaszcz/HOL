  fun recorded g s term =
    if Term.is_abs term then #node (G.admit_binder g s limit term)
    else if Term.is_comb term then
      let val (f,x) = Term.dest_comb term
      in G.application g s (recorded g s f,recorded g s x) end
    else imported g s term
  fun plan g s theorem = P.record_closed g s
    {node = recorded g s (Thm.concl theorem),theorem = theorem,
     template_limit = limit,check_type = fn _ => ()}
  type fixture = {graph : G.graph,scope : G.scope,sources : S.sources,
    validation : V.validation,law : P.closed_fact,p : Term.term,
    goal : G.node,assumption : Term.term}
  fun fixture () : fixture =
    let
      val g = G.new () val s = G.root_scope g
      val p = Term.mk_var ("recorded_quantified_original_p",Type.bool)
      val assumption = Term.mk_comb
        (Term.prim_mk_const {Thy = "marker",Name = "Abbrev"},p)
      val sources = S.new g s limit {goal = p,assumptions = [assumption]}
      val pn = imported g s p
      val law = plan g s markerTheory.Abbrev_def
      val {theorem,holes} = P.specialize_closed law
        {operands = [pn],check_type = fn _ => ()}
      val schema = C.checked_graph_schema g s
        {theorem = theorem,holes = holes,operands = [pn],
         template_limit = limit}
      val _ = if refuses (fn () => G.reserve_names g holes) andalso
          refuses (fn () => G.reserve_schema_holes g
            [(hd holes,G.constant g s boolSyntax.F)]) andalso
          refuses (fn () => G.reserve_schema_holes g
            [(Term.mk_var (#1 (Term.dest_var (hd holes)),intSyntax.int_ty),pn)])
        then () else raise Fail "schema placeholder ownership check weakened"
      val original = F.original g s sources 0
      val conversion = C.graph_conversion g s false
        (fn current => if current = F.endpoint original then SOME schema
                       else NONE) (F.endpoint original)
      val derived = F.transport g s conversion original
      val auxiliary = F.recorded_closed g s law
      val instance = F.specialize_recorded g s
        {law = law,operands = [pn],template_limit = limit,
         check_type = fn _ => ()}
      val validation = V.from_portfolio (F.validate g s sources
        {assumptions = [derived,auxiliary,instance],goal = pn,
         denied = F.original g s sources 1,template_limit = limit})
    in {graph = g,scope = s,sources = sources,validation = validation,
        law = law,p = p,goal = pn,assumption = assumption} end
  fun original (f : fixture) theorem =
    (S.check_goal (#sources f) theorem;
     ensure "auxiliary or specialized assertion entered original Hyp"
       (Portable.pointer_eq (Thm.concl theorem,
          #2 (S.original_goal (#sources f))) andalso
        List.all (fn hyp => List.exists (fn n => Portable.pointer_eq
          (hyp,G.representative (#graph f) n))
          (S.assumption_nodes (#sources f))) (Thm.hyp theorem)))
  fun manual (f : fixture) =
    let val g = #graph f val s = #scope f val v = #validation f
        val falsehood = G.constant g s boolSyntax.F
        val block = P.freeze_with_closed g
          {scope = s,sources = V.source_nodes v,
           roots = falsehood :: V.roots v,closed_facts = V.closed_facts v,
           template_limit = limit}
        val assemble = V.assembler v block
        fun fact n = (n,case assemble n of SOME edge => edge
          | NONE => raise Fail "missing quantified dependency")
        val edge = R.assemble g block {rule = "rewrite",target = falsehood,
          premises = List.map fact (V.processed_assumptions v @
            [V.processed_denied_goal v])}
        val contradiction = P.realize block falsehood edge
    in original f (S.close_contradiction (#sources f) contradiction) end
  fun options (f : fixture) : Front.options =
    {graph = #graph f,scope = #scope f,logic = "ALL",sources = [("p",#p f)],
