                  (#profiles e)(fn _=>raise Fail "non-source callback")
                val needed=case prepared of Specialize.Needs rows=>
                  List.exists(fn Specialize.RetainedOriginalSource _=>true
                    |_=>false)rows|_=>false
            in require "retained shape adopted an unauthenticated Source"
              (needed andalso Count.thm_count()=prior)end)))
      val _=test "Incompatible original universal declines before names"
        (fn()=>let val n=Term.mk_var("specialize408_nat",numSyntax.num)
            val source=boolSyntax.mk_forall(n,boolSyntax.mk_eq(n,n))
          in fixture[source]boolSyntax.F(fn e=>parsed e
            (fn held=>fn _=>fn source=>fn argument=>fn target=>
              let val prior=Count.thm_count()
                  val prepared=prepare_lower e held source argument target
                    (#profiles e)(fn _=>raise Fail "bad binder Type callback")
                  val needed=case prepared of Specialize.Needs rows=>
                    List.exists(fn Specialize.SourceInstance _=>true
                      |_=>false)rows|_=>false
              in require "incompatible original reached native freeze"
                (needed andalso Count.thm_count()=prior andalso
                 not(#retired(W.audit_policy(#work e))))end))end)
      val _=test "Wrong argument remains DATA without touching SPEC"
        (fn()=>owned(fn e=>parsed e(fn held=>fn data=>fn source=>
          fn _=>fn target=>
            let val argument=W.with_step(#work e)(fn()=>PV.literal
                  (#context data)(#scope e)(RP.AtMost 1)boolSyntax.T)
                val prior=Count.thm_count()
                val prepared=prepare_lower e held source argument target
                  (#profiles e)(fn _=>raise Fail "wrong argument callback")
                val needed=case prepared of Specialize.Needs rows=>
                  List.exists(fn Specialize.AtomicFalseOperand _=>true
                    |_=>false)rows|_=>false
            in require "unsupported argument became native specialization"
              (needed andalso Count.thm_count()=prior)end)))
      val _=test "Actual operand and Type caps precede native block effects"
        (fn()=>List.app(fn(input_limit,type_limit)=>owned(fn e=>parsed e
          (fn held=>fn _=>fn source=>fn argument=>fn target=>
            let val tiny=NC.capture(#work e)
                  {semantic_limits={input_limit=input_limit,output_limit=128,
                     template_limit=128},import_limit=128,
                   type_work_limit=type_limit}
                val prior=Count.thm_count()val calls=ref 0
                val denied=refused(fn()=>ignore(Specialize.prepare(#work e)
                  (#query e)held{source=source,arguments=[argument],
                    target=target,profiles= #profiles e,native_contract=tiny,
                    check_type=fn _=>calls:= !calls+1}))
            in require "oversized source reached native names or Type callback"
              (denied andalso !calls=0 andalso Count.thm_count()=prior
               andalso #retired(W.audit_policy(#work e)))end)))
          [(1,1000000),(128,1)])
      val _=test "Foreign Work cannot activate a genuine saved SPEC plan"
        (fn()=>owned(fn held=>owned(fn current=>parsed held
          (fn packet=>fn _=>fn source=>fn argument=>fn target=>
            let val plan=lower_ready(prepare_lower held packet source
                  argument target(#profiles held)(fn _=>()))
                val prior=Count.thm_count()
                val denied=refused(fn()=>ignore
                  (Specialize.execute(#work current)plan))
            in require "foreign Work read or charged held plan backing"
              (denied andalso Count.thm_count()=prior andalso
               #retired(W.audit_policy(#work current))andalso
               not(#retired(W.audit_policy(#work held))))end))))
      val _=test "Type callback Primary remains exact before any SPEC"
        (fn()=>let exception Primary of unit ref val token=ref()
          in owned(fn e=>parsed e(fn held=>fn _=>fn source=>
            fn argument=>fn target=>
              let val calls=ref 0
                  val plan=lower_ready(prepare_lower e held source argument
                    target(#profiles e)(fn _=>
                      (calls:= !calls+1;raise Primary token)))
                  val prior=Count.thm_count()
                  val exact=(ignore(Specialize.execute(#work e)plan);false)
