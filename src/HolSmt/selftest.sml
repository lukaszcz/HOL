                val exact = (CV.create_packet_with_policy_from_input
                  (#work e) (#query e) (options e) (#metadata e) "1.3.4"
                  (fn () => case source () of SOME c => SOME c
                    | NONE => raise Primary token);false)
                  handle Primary actual => Portable.pointer_eq (actual,token)
                val _ = G.validate_scope (#graph e) (#scope e)
            in require "CPC EOF Primary changed or retained Work"
              (exact andalso #retired (W.audit_policy (#work e))) end) end)
      val _ = test "Owner and expired scalar guard precede cached DATA"
        (fn () => owned (fn held =>
          let val saved = packet held "((assume @a true))"
              val scalar_value = W.with_step (#work held) (fn () =>
                let val context = #context (contents held saved)
                    val value = scalar context (#scope held) ``7:int``
                    val _ = natural context cap value
                in (context,value) end)
