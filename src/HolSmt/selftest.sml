  fun quant_setup text callback:quant_env=
    let
      val twice=false val input=100000 val output=100000
      val x=Term.mk_var("z3_quant_x",Type.bool)
      val y=Term.mk_var("z3_quant_y",Type.bool)
      val u=if twice then boolSyntax.mk_forall(x,
          boolSyntax.mk_forall(y,boolSyntax.mk_conj(x,y)))
        else boolSyntax.mk_forall(x,x)
      val first=if twice then boolSyntax.mk_conj(boolSyntax.T,boolSyntax.F)
        else boolSyntax.T
      val q1=boolSyntax.mk_disj(boolSyntax.mk_neg u,first)
      val q2=boolSyntax.mk_disj(boolSyntax.mk_neg u,boolSyntax.F)
      val bad1=boolSyntax.mk_eq(q1,boolSyntax.F)
      val bad2=boolSyntax.mk_eq(q2,bad1)
      val p=Term.mk_var("z3_raw_quant_p",Type.bool)
      val q=Term.mk_var("z3_raw_quant_q",Type.bool)
      val clause=boolSyntax.mk_disj(p,q)
      val assumptions=[clause,boolSyntax.mk_neg p,boolSyntax.mk_neg q,clause]
      val goal=boolSyntax.mk_conj(boolSyntax.T,boolSyntax.T)
      val g=G.new()val r=G.root_scope g
      val s=S.new_with_policy g r RP.Uncapped
        {goal=goal,assumptions=assumptions}
      val policy:RP.semantic_policy={input_limit=RP.Uncapped,
        output_limit=RP.Uncapped,template_limit=RP.Uncapped}
      val w=W.begin_with_policy g r s
        {limits=policy,work_limit=RP.Uncapped}
      val nc=NC.capture w{semantic_limits={input_limit=input,
        output_limit=output,template_limit=100000},import_limit=1000000,
        type_work_limit=10000000}
      val original=G.import_with_policy g r RP.Uncapped u
      val a=G.import_with_policy g r RP.Uncapped q1
      val b=G.import_with_policy g r RP.Uncapped q2
      (* Real prior discovery: changed trigger forces retention of this
         SAME universal's opaque Abs. This setup is not first admission. *)
      val z=Term.mk_var("z3_quant_profile_trigger",Type.bool)
      val trigger=Term.mk_comb(Term.mk_abs(z,z),boolSyntax.T)
      val wrapper=G.import_with_policy g r RP.Uncapped
        (boolSyntax.mk_conj(trigger,boolSyntax.mk_eq(u,u)))
      val discovery=G.discover_partial_with_policy g r
        {original= #node wrapper,maximum=RP.Uncapped,
         scan_limit=RP.AtMost 100000,step=fn()=>()}
      val profiles=G.partial_profiles_with_policy g r discovery
      val opaque=case G.view g(#node original)of G.Application(_,body)=>body
        | _=>raise Fail "actual universal application missing"
      val _=require "genuine original universal profile not retained"
        (List.exists(fn p=>Option.isSome
          (G.opaque_profile_for_node_with_policy g r opaque p))profiles)
      val _=List.app(G.validate_policy_opaque_profile g)profiles
      val options:Front.policy_options={graph=g,scope=r,logic="ALL",
        sources=[("U",u),("q1",q1),("q2",q2),
          ("bad1",bad1),("bad2",bad2),("p",p),("q",q)],
        sorts=Redblackmap.mkDict String.compare,binder_lists=[],
        import_limit=RP.Uncapped,literal_limit=RP.Uncapped,
        binder_limit=RP.Uncapped,
        recipe_limits={template_limit=RP.Uncapped,index_limit=RP.Uncapped,
          operand_limit=RP.Uncapped,token_limit=RP.Uncapped},
        special=fn _=>fn _=>NONE,ascribed=fn _=>fn _=>fn _=>NONE}
      val stream=TextIO.openString text
      val parsed=Exn.capture(fn()=>
        Parser.create_packet_with_policy options "4.15.3"stream)()
      val _=TextIO.closeIn stream val packet=Exn.release parsed
      val gp=W.with_step w(fn()=>
        let val{assumptions,denied}=F.originals_with_policy w
            val portfolio=F.validate_portfolio_with_policy w
              {assumptions=assumptions,goal= #node(S.goal_source s),
               denied=denied}
        in GP.from_portfolio_with_policy w portfolio end)
      val request:E.request={packet=packet,preprocessing=gp,
        profiles=profiles,check_type=callback,ordinal=90}
