  fun root_ports(e:env)(data:ZV.proof VP.contents)=
    W.with_step(#work e)(fn()=>
      let
        val context= #context data
        val row=rule(#proof data)(#root(#proof data))
        val statement= #node(#conclusion row)
        val(partial,target)=case PV.view context statement of
            PV.Application pair=>pair
          | _=>raise Fail "actual quant-inst statement is not App"
        val(_,left)=case PV.view context partial of
            PV.Application pair=>pair
          | _=>raise Fail "actual quant-inst statement has no OR head"
        val(_,source)=case PV.view context left of
            PV.Application pair=>pair
          | _=>raise Fail "actual quant-inst source is not negated"
        val arguments=List.map #node(#arguments row)
      in {source=source,target=target,arguments=arguments}end)
  fun direct_options(e:env)callback {source,target,arguments}=
    {source=source,target=target,arguments=arguments,
     profiles= #profiles e,native_contract= #contract e,
     check_type=callback}
