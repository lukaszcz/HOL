        let val opened = G.record_opened_view_with_policy (#graph e) caller
              (RP.AtMost 1000000) node
        in if caller= #scope e andalso #node opened<>node andalso
            not (List.exists (fn row => #original row=node) (!rows)) then
            rows := {scope=caller,original=node,opened= #node opened}:: !rows
          else () end
    in T.with_outbound_query_analysis_with_policy (#work e) (#query e)
      open_view (fn context =>
        SmtLib_GraphFiniteQueryTransport.prepare_with_bodies (#work e)
          context
          {validation= #validation e,
           operations=SmtLib_GraphCarrierOperations.make_with_datatypes
             context {sequence_emission=false}
             {term_to_string=fn _ => raise Fail "unexpected body formatter"},
           target=SOME {solver="cvc5",version=SOME "1.3.4"},
           emit_sequences=false,native_contract= #contract e,ordinal=388,
           check_type=callback}
          (fn selection => fn preparation => fn bodies =>
            let val _ = check_native selection
                val transport = B.capture_transport (#work e) (#query e)
                  context selection
                val body = case bodies of [one] => one
                  | _ => raise Fail "shared binder lost its single body plan"
            in {body=body,openings=List.rev (!rows),transport=transport,
              preparation=preparation} end)) end
  fun prepare e callback = prepare_using
    (fn selection => require "fixture requires actual native Set mode"
      (#set_backend selection=SmtLib.CVC5NativeSet)) e callback
  fun prepare_bag e callback = prepare_using
    (fn selection => require "fixture requires actual native Bag mode"
      (#bag_backend selection=SmtLib.CVC5NativeBag)) e callback
