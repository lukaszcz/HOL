  val q = ``source_bearing_receipt_q:bool``
  val cap = 256
  type env = {graph:G.graph,root:G.scope,sources:S.sources,work:W.portfolio,
    frame:Scope.receipt,block:P.block,target:G.node,extra:G.node}
  fun setup graph : env =
    let val root = G.root_scope graph
        val sources = S.new graph root cap
          {goal = p,assumptions = [p,p]}
        val work = W.begin graph root sources
          {limits = {input_limit = 100,output_limit = 100,
             template_limit = cap},work_limit = 10000000}
        val frame = Scope.root work
        val target = hd (S.assumption_nodes sources)
        val extra = #node (G.import graph root cap q)
        val block = P.prepare_needed_sources_with_work work
          {frame = frame,roots = [target,extra],additional_sources = [extra],
