        val error=message(fn()=>construct e RP.Uncapped (#profiles e)(fn()=>()))
    in require "native Type/model gate was a metadata allowance"
      (Option.isSome error andalso #retired(W.audit_policy (#w e))) end)
  val _=test "Profiled binder cannot obtain FV authority from a missing profile"
    (fn()=>let val e=setup false true ordinary
        val error=message(fn()=>construct e RP.Uncapped [] (fn()=>()))
    in require "missing genuine profile became a native FV bound"
      (error=SOME "opaque body lacks genuine policy profile") end)
  val _=test "Scoped metric follows actual new binder body frame"
    (fn()=>let val e=setup false true ordinary
        val result=construct e RP.Uncapped (#profiles e)(fn()=>())
        val legacy=message(fn()=>G.prepare_profiled_metric (#g e)(#r e)
          {node=result,profiles= #profiles e})
        val metric=G.prepare_scoped_profiled_metric (#g e)(#r e)
          {node=result,profiles= #profiles e}
        val data=G.profiled_metric_data (#g e)(#r e) metric
        val oracle=valOf(SmtReplayImport.bounded_raw_size cap
          (G.representative (#g e) result))
    in require "profile issuer was used as requester or scoped geometry changed"
      (Option.isSome legacy andalso #node data=result andalso
       #raw data=IntInf.fromInt oracle andalso not(null(#types data))) end)
  val _=test "Profiled binder preserves callback Primary and retires Work"
    (fn()=>let exception Primary of unit ref
        val marker=ref() val e=setup false true ordinary val calls=ref 0
        val same=(ignore(construct e RP.Uncapped (#profiles e)
          (fn()=>(calls:= !calls+1;raise Primary marker)));false)
          handle Primary actual=>Portable.pointer_eq(actual,marker)
