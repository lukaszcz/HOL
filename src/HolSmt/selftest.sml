      frame = frame,block = block,target = target,extra = extra} end
  fun edge (e:env) = W.with_step (#work e) (fn () =>
    (P.validate_block_for (#work e) (#block e);P.source (#block e) 0))
  fun execute (e:env) = P.realize_source_owned_receipt (#work e)
    (#block e) (#target e) (edge e)
  fun ensure why yes = if yes then testutils.OK () else raise Fail why
  fun clean theorem = null (Tag.axioms_of (Thm.tag theorem)) andalso
    List.all (fn value => value = "DISK_THM")
      (#1 (Tag.dest_tag (Thm.tag theorem)))
  fun exact (e:env) receipt =
    let val data = P.source_realization_data_for (#work e) receipt
        val theorem = P.source_realization_theorem_for (#work e) receipt
        val expected = G.representative (#graph e) (#target e)
    in Portable.pointer_eq (#original_sources data,#sources e) andalso
      Portable.pointer_eq (#frame data,#frame e) andalso
      #root data = #root e andalso #scope data = #root e andalso
      #target data = #target e andalso #template_limit data = cap andalso
      #source_occurrences data = [(0,#target e),(1,#target e)] andalso
      Portable.pointer_eq (Thm.concl theorem,expected) andalso clean theorem
      andalso (case Thm.hyp theorem of [hypothesis] =>
        Portable.pointer_eq (hypothesis,expected) | _ => false)
    end
