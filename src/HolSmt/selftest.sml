            in (result,original,#node_creations stats) end)
          (fn _ => fn outcome =>
            let val ({mapping,inputs},original,created) = Exn.release outcome
                val entries = M.entries mapping
            in require "extra root froze unfolded syntax or changed old freeze"
              (length entries=142 andalso created=0 andalso
               length inputs=2 andalso hd inputs=hd (tl inputs) andalso
               null (M.declarations mapping) andalso
               null (M.entries original)) end))
      val _ = test "Variable observations stay DATA without definitions"
        (fn () => fixture boolSyntax.T
          (fn e => fn context => fn backend =>
            let val variable = (#genvar context) Type.bool
                val store = Store.create context {prefix="metadata_generic_"}
                val terms = (#record_encoding (#operations store))
                  (#empty_terms store,
                   {input=variable,smt_symbol="generic",arity=0})
                val emission:D.result = {types=empty_types (),symbols=[],
                  roots=[],encodings=(#encodings store) terms}
            in metadata e context backend SmtLib.FirstOrder emission end)
          (fn _ => fn outcome =>
            let val value = Exn.release outcome val mapping = MD.mapping value
                val event = case MD.encodings value of [event] => event
                  | _ => raise Fail "generic encoding observation disappeared"
                val observed = case #form (M.entry mapping (#head event)) of
                    M.FreeVariable {kind=G.Bound,...} => true | _ => false
            in require "generic observation became a constant or permission"
              (observed andalso #input event= #head event andalso
               null (MD.definitions value) andalso
               null (M.declarations mapping)) end))
      val _ = test "All durable accessors guard scope lifetime even when empty"
        (fn () => fixture boolSyntax.T
          (fn e => fn context => fn backend =>
            metadata e context backend SmtLib.FirstOrder
              {types=empty_types (),symbols=[],encodings=[],roots=[]})
          (fn e => fn outcome =>
            let val value = Exn.release outcome
                val calls = accessors value
                val _ = List.app (fn f => f ()) calls
                val _ = G.close_scope (#graph e) (#scope e)
