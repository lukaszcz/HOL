local
  structure G = SmtReplayGraph
  structure S = SmtReplaySource
  structure W = SmtReplayInvocationWork
  structure P = SmtReplayProof
  type env = {graph:G.graph,scope:G.scope,sources:S.sources,work:W.portfolio}
  fun require message yes = if yes then () else raise Fail message
  fun test label action =
    (testutils.tprint label;action ();testutils.OK ())
  fun fixture allowance action =
    let val graph = G.new () val scope = G.root_scope graph
        val sources = S.new graph scope 16
          {assumptions=[],goal=boolSyntax.T}
        val work = W.begin graph scope sources
          {limits={input_limit=16,output_limit=16,template_limit=10000},
           work_limit=allowance}
        val outcome = Exn.capture action
          {graph=graph,scope=scope,sources=sources,work=work}
        val cleanup = Exn.capture
          (fn () => (W.close work;G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res answer => (Exn.release cleanup;answer) end
  fun shared (e:env) depth =
    let val yes = #node (S.goal_source (#sources e))
        val conjunction = G.constant (#graph e) (#scope e)
          boolSyntax.conjunction
        fun grow 0 current levels = (current,levels,conjunction)
          | grow count current levels =
              let val partial = G.application (#graph e) (#scope e)
                    (conjunction,current)
                  val next = G.application (#graph e) (#scope e)
                    (partial,current)
              in grow (count-1) next ((next,partial)::levels) end
    in grow depth yes [] end
  fun frontier (e:env) roots =
    P.prepare_original_realization_frontier (#work e)
      {roots=roots,closed_facts=[],conversions=[]}
  fun diagnostic action = (action ();NONE)
    handle Feedback.HOL_ERR detail => SOME
      (Feedback.top_structure_of detail,Feedback.top_function_of detail,
       Feedback.message_of detail)
  val exhausted = SOME ("SmtReplayInvocationWork","admit",
    "original cumulative work allowance exhausted")
in
  val _ = run_postlude 361 "indexed-realization-frontier-4" (fn () =>
    let
      val _ = test "Shared frontier keeps exact DFS under the original10m"
        (fn () => fixture 10000000 (fn e =>
          let val (root,levels,conjunction) = shared e 2500
              val sources = #sources e val work = #work e
              val yes = #node (S.goal_source sources)
              val denied = S.denied_goal_node sources
              val negative = case G.view (#graph e) denied of
                  G.Application (head,operand) =>
                    (require "denied fixture operand changed" (operand=yes);
                     head)
                | _ => raise Fail "denied fixture is not an application"
              val ordered = case levels of [] => raise Fail "empty fixture"
                | (top,partial)::rest => top::partial::conjunction::
                    List.foldr (fn ((node,prefix),tail) => node::prefix::tail)
                      [] rest
              val roots = [root,root,yes]
              val plan = frontier e roots
              val actual = P.realization_frontier_data_for work plan
              val audit = W.audit work
          in require "frontier expanded sharing, reordered DFS or lost Work"
            (#roots actual=roots andalso #sources actual=[denied] andalso
             #reachable actual=[denied,negative,yes] @ ordered andalso
             length (#reachable actual)=5004 andalso null (#atoms actual)
             andalso #charged audit>0 andalso #charged audit<10000000
             andalso not (#retired audit)) end))
      val _ = test "Foreign equal node IDs cannot hide behind seen membership"
        (fn () => fixture 10000000 (fn held =>
          fixture 10000000 (fn foreign =>
            let val atom = Term.mk_var ("frontier_collision",Type.bool)
                val own = G.variable (#graph held) (#scope held)
