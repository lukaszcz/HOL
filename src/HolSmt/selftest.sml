        {limits = {input_limit = 100,output_limit = 100,
           template_limit = 512},work_limit = 10000000}
      val preprocessing = GP.discover_from_sources graph scope sources
        {import_limit = 512,revisit = false,check_type = fn _ => (),
         conversion = fn _ => NONE}
