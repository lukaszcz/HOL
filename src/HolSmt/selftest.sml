                  SmtLib_GraphCarrierOperations.make_with_datatypes context
                    {sequence_emission=false}
                    {term_to_string=fn _=>raise Fail "unexpected formatter"}
                val emission=SmtLib_GraphDispatcher.emit context
                  {operations=operations,regime=SmtLib.FirstOrder,
                   apply_operator=SmtLib.ApplyUnderscore,prefix="value406_",
                   roots=ListPair.zip
                     (List.tabulate (length (#assumptions context)+2,Lib.I),
                      #goal context :: #assumptions context @
                        [#denied context])}
              in SmtLib_GraphDeclarationMetadata.freeze context
                {graph=graph,scope=scope,regime=SmtLib.FirstOrder,
                 backend=backend,operations=operations,emission=emission}
              end))
        in action ({graph=graph,scope=scope,sources=sources,work=work,
          query=query,metadata=metadata,contract=contract,
          preprocessing=preprocessing}:env) end
      val outcome=Exn.capture run ()
      val cleanup=Exn.capture (fn()=>
        (W.close work;G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary=>raise primary
      | Exn.Res result=>(Exn.release cleanup;result) end
  val p=Term.mk_var("raw419_p",Type.bool)
  val q=Term.mk_var("raw419_q",Type.bool)
  val r=Term.mk_var("raw419_r",Type.bool)
  val goal=Term.mk_var("raw419_goal",Type.bool)
  val alias=boolSyntax.mk_disj(p,q)
  val np=boolSyntax.mk_neg p val nq=boolSyntax.mk_neg q
  val nr=boolSyntax.mk_neg r
  val bindings=[("p",p),("q",q),("r",r),("alias",alias)]
  fun options (e:env):F.value_options =
    {graph= #graph e,scope= #scope e,logic="ALL",sources=bindings,
     sorts=Redblackmap.mkDict String.compare,binder_lists=[],
     import_limit=cap,literal_limit=cap,binder_limit=RP.AtMost 1,
     recipe_limits={template_limit=cap,index_limit=cap,
       operand_limit=cap,token_limit=cap},
     special=fn _=>fn _=>NONE,ascribed=fn _=>fn _=>fn _=>NONE}
  fun input text =
    let val index=ref 0 in fn()=>
      if !index=String.size text then NONE else
        let val result=String.sub (text,!index)
        in index:= !index+1;SOME result end end
  fun packet (e:env) text =
    Z3_GraphValueProofParser.create_packet_with_policy_from_input
      (#work e) (#query e) (options e) (#metadata e) "4.15.3" (input text)
  fun rule (proof:ZV.proof) id =
    case Redblackmap.find (#steps proof,id) of Z.Rule value=>value
      | _=>raise Fail "expected actual parsed Rule"
  fun fixture assumptions goal=fixture_with true assumptions goal
  fun graph_assertions (e:env) (data:ZV.proof VP.contents) =
    let val current=GP.query_nodes_with_policy_for (#work e) (#query e)
    in W.with_step (#work e) (fn()=>
      let
        val context= #context data
        fun guard ()=(PV.validate context;
          G.validate_scope (#graph e) (#scope e))
        fun tick ()=(guard ();W.spend_policy (#work e) 1)
        fun compare (left,right)=(tick ();Int.compare (left,right))
        val memo=ref (Redblackmap.mkDict compare)
        (* The actual query supplies graph IDs. Copy App DATA with sharing;
           graph_leaf remains restricted to its genuine atomic contract.
           This fixture needs no native query term or binder conversion. *)
        fun copy node=
          let val _=tick () val syntax=G.view (#graph e) node
              val id=G.node_id node
          in case Redblackmap.peek (!memo,id) of
              SOME value=>(PV.usable context (#scope e) value;value)
            | NONE=>
                let val value=case syntax of
                        G.Variable _=>PV.graph_leaf context (#scope e) node
                      | G.Constant _=>PV.graph_leaf context (#scope e) node
                      | G.Application (left,right)=>
                          let val f=copy left val x=copy right
                          in PV.application context (#scope e) (f,x) end
                      | _=>raise Fail "fixture Source needs binder programme"
                    val _=PV.usable context (#scope e) value
                    val _=tick ()
                    val _=memo:=Redblackmap.insert (!memo,id,value)
                in value end
          end
        fun copies []=(guard ();[])
          | copies (node::rest)=(tick ();copy node::copies rest)
      in copies (#assumptions current @ [#denied current]) end)
    end
  fun using (e:env) text callback action =
    let
      val held=packet e text
      val saved=ref(NONE:Final.invocation option)
      val outcome=Exn.capture(fn()=>
        let
          val data=W.with_step (#work e) (fn()=>
            VP.contents_with_policy_for (#work e) (#query e) held)
          val assertions=graph_assertions e data
          val prepared=Final.prepare_with_raw_resolution_with_policy
            (#work e) (#query e) held
            {assertions=assertions,native_contract= #contract e,
             profiles=[],check_type=callback}
          val _=case prepared of Final.Prepared owner=>saved:=SOME owner
            | _=>()
        in action held data prepared end) ()
      val cleanup=Exn.capture(fn()=>case !saved of
          SOME owner=>Final.close owner | NONE=>VP.close held) ()
    in case outcome of Exn.Exn primary=>raise primary
      | Exn.Res result=>(Exn.release cleanup;result)end
  fun ready (Final.Prepared owner)=owner
    | ready (Final.ReplayNeeds _)=raise Fail "unexpected replay programme"
  fun proved (Final.Proved result)=result
    | proved (Final.RealizationNeeds _)=
        raise Fail "unexpected original Source realization programme"
  fun canonical_hyp (e:env) theorem =
    let val allowed=S.assumption_nodes (#sources e)
    in List.all(fn term=>List.exists(fn node=>Portable.pointer_eq
      (term,G.representative (#graph e) node))allowed)(Thm.hyp theorem)end
  fun checked (e:env) theorem =
    (S.check_goal (#sources e) theorem;
     require "finalizer did not retain exact original Goal/canonical Hyp"
       (Portable.pointer_eq(Thm.concl theorem,
          #2(S.original_goal (#sources e)))andalso canonical_hyp e theorem
        andalso null(Tag.axioms_of(Thm.tag theorem))))
  val ordinary="((proof (unit-resolution (asserted alias) " ^
    "(asserted (not p)) (asserted (not q)) false)))"
  val nested="((proof (unit-resolution " ^
    "(asserted (or (let ((inside (or p q))) inside) r)) " ^
    "(asserted (not p)) (asserted (not q)) (asserted (not r)) false)))"
  val compound="((proof (unit-resolution (asserted (not alias)) " ^
    "(asserted (or p q)) (asserted (or p q)) false)))"
  val unmatched="((proof (unit-resolution (asserted alias) " ^
    "(asserted (not p)) false)))"
  fun native (e:env) text=
    let val opts:F.policy_options={graph= #graph e,scope= #scope e,
          logic="ALL",sources=bindings,
          sorts=Redblackmap.mkDict String.compare,binder_lists=[],
          import_limit=cap,literal_limit=cap,binder_limit=RP.AtMost 1,
          recipe_limits={template_limit=cap,index_limit=cap,
            operand_limit=cap,token_limit=cap},
          special=fn _=>fn _=>NONE,ascribed=fn _=>fn _=>fn _=>NONE}
        val stream=TextIO.openString text
        val outcome=Exn.capture(fn()=>
          Z3_GraphProofParser.create_packet_with_policy opts "4.15.3"stream)()
        val _=TextIO.closeIn stream val parsed=Exn.release outcome
        val owner=Z3_PolicyGraphProofReplay.begin_raw_with_policy(#work e)
          (#contract e){packet=parsed,preprocessing= #preprocessing e,
            profiles=[],check_type=fn _=>(),ordinal=419}
        fun replay()=case Native.replay_next_with_policy(#work e)owner of
            NONE=>()|SOME _=>replay()
        val _=replay()
        val proof=Native.finish_with_policy(#work e)owner
        val _=checked e proof
    in proof end
  fun final assumptions text=
    fixture assumptions goal(fn e=>using e text(fn _=>())
      (fn _=>fn _=>fn prepared=>
        let val owner=ready prepared
            val result=proved(Final.finish_with_policy(#work e)owner)
            val _=checked e(#theorem result)
        in #theorem result end))
  fun same_hyp left right=length left=length right andalso
    List.all(fn term=>List.exists(Term.aconv term)right)left
  fun parsed (e:env) text action=
    let val held=packet e text
        val outcome=Exn.capture(fn()=>
          let val data=W.with_step(#work e)(fn()=>
                VP.contents_with_policy_for(#work e)(#query e)held)
              val assertions=graph_assertions e data
          in action held data assertions end)()
        val cleanup=Exn.capture VP.close held
    in case outcome of Exn.Exn primary=>raise primary
      | Exn.Res result=>(Exn.release cleanup;result)end
  fun ready_receiver(Receiver.Prepared saved)=saved
    | ready_receiver(Receiver.Needs _)=raise Fail "raw programme pending"
  fun run e saved=
    let fun next()=case Receiver.replay_next_with_policy(#work(e:env))saved
          of NONE=>()|SOME _=>next()
    in next()end
  fun actual_rule (data:ZV.proof VP.contents) id=
    case Redblackmap.find(#steps(#proof data),id)of Z.Rule fields=>fields
      | _=>raise Fail "actual rule expected"
  fun raw_batch (e:env) held (data:ZV.proof VP.contents)=
    W.with_step(#work e)(fn()=>
      let val factory=SmtReplayValueClause.create(#work e)(#query e)held
          val root=actual_rule data(#root(#proof data))
          val ids= #premises root
          val(head,units)=case ids of first::rest=>(first,rest)
            | []=>raise Fail "actual unit-resolution premises absent"
          val batch=SmtReplayValueClause.discover_raw(#work e)factory
            {head= #conclusion(actual_rule data head),
             units=List.map(fn id=> #conclusion(actual_rule data id))units,
             target= #conclusion root}
      in (factory,batch)end)
in
  val _=run_postlude 419 "checked-raw-atom-congruence-5"(fn()=>
    let
      val _=test "Compound raw aliases retain the same original native Goal"
        (fn()=>let val assumptions=[boolSyntax.mk_neg alias,alias,alias]
            val reference=fixture assumptions goal(fn e=>native e compound)
            val proof=final assumptions compound
          in require "compound atom transport changed native Source support"
            (Term.aconv(Thm.concl proof)(Thm.concl reference)andalso
             same_hyp(Thm.hyp proof)(Thm.hyp reference))end)
      val _=test "Raw atom aliases execute checked constructor congruence"
        (fn()=>fixture[boolSyntax.mk_neg alias,alias,alias]goal(fn e=>
          parsed e compound(fn held=>fn data=>fn assertions=>
            let
              val(factory,batch)=raw_batch e held data
              val aliases=W.with_step(#work e)(fn()=>
                #atom_aliases(Clause.raw_data_for(#work e)factory batch))
              val distinct=W.with_step(#work e)(fn()=>
                List.exists(fn(a,b)=>PV.proof_key(#context data)a <>
                  PV.proof_key(#context data)b)aliases)
              val _=require "fixture has no distinct genuine syntax aliases"
                (not(null aliases)andalso distinct)
              val saved=ready_receiver
                (Receiver.prepare_with_raw_resolution_with_policy
                  (#work e)(#query e)held{assertions=assertions,
                    native_contract= #contract e,profiles=[],
                    check_type=fn _=>()})
              fun sources []=()
                | sources(id::rest)=
                    (case Receiver.replay_next_with_policy(#work e)saved of
                        SOME entry=>
                          (require "actual Source replay order changed"
                             (#id entry=id);sources rest)
                      | NONE=>raise Fail "actual Source prefix absent")
              val outcome=Exn.capture(fn()=>
                let val root=actual_rule data(#root(#proof data))
                    val _=sources(#premises root)
                    val prior=Count.thm_count()
                    val result=Receiver.replay_next_with_policy(#work e)saved
                    val after=Count.thm_count()
                in require "raw DATA alias was used without checked proof"
                  (Option.isSome result andalso #MK_COMB after> #MK_COMB prior
                   andalso #TRANS after> #TRANS prior andalso
                   not(#retired(W.audit_policy(#work e))))end)()
              val _=Receiver.close saved
            in Exn.release outcome end)))
      val _=test "Whole target aliases receive checked compact transport"
        (fn()=>let
            val text="((proof (let ((x (unit-resolution " ^
              "(asserted (or alias r)) (asserted (not r)) (or p q)))) " ^
              "(unit-resolution (asserted (not alias)) x false))))"
            val assumptions=[boolSyntax.mk_disj(alias,r),nr,
              boolSyntax.mk_neg alias]
            val reference=fixture assumptions goal(fn e=>native e text)
            val proof=final assumptions text
          in require "canonical target alias lost its actual constructor law"
            (Term.aconv(Thm.concl proof)(Thm.concl reference)andalso
             same_hyp(Thm.hyp proof)(Thm.hyp reference))end)
      val _=test "Different operand order is not an atomic alias permission"
        (fn()=>let
            val text="((proof (unit-resolution (asserted (not alias)) " ^
              "(asserted (or q p)) false)))"
          in fixture[boolSyntax.mk_neg alias,boolSyntax.mk_disj(q,p)]goal
            (fn e=>parsed e text(fn held=>fn _=>fn assertions=>
              let val prior=Count.thm_count()val calls=ref 0
                  val message=(ignore
                    (Receiver.prepare_with_raw_resolution_with_policy
                      (#work e)(#query e)held{assertions=assertions,
                        native_contract= #contract e,profiles=[],
                        check_type=fn _=>calls:= !calls+1});NONE)
                    handle Feedback.HOL_ERR error=>
                      SOME(Feedback.message_of error)
              in require "metadata alias merged unequal actual App operands"
                (message=SOME "raw resolution unmatched literal"andalso
                 !calls=0 andalso Count.thm_count()=prior andalso
                 #retired(W.audit_policy(#work e)))end))end)
      val _=test "Raw atom aliases expire with their actual parser packet"
        (fn()=>fixture[boolSyntax.mk_neg alias,alias,alias]goal(fn e=>
          parsed e compound(fn held=>fn data=>fn _=>
            let val(factory,batch)=raw_batch e held data
                val _=W.with_step(#work e)(fn()=>
                  require "alias lifetime fixture did not warm genuine DATA"
                    (not(null(#atom_aliases
