          query=query,metadata=metadata,contract=contract}:env) end
      val outcome=Exn.capture run ()
      val cleanup=Exn.capture (fn()=>
        (W.close work;G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary=>raise primary
      | Exn.Res result=>(Exn.release cleanup;result) end
  fun options (e:env):F.value_options =
    {graph= #graph e,scope= #scope e,logic="ALL",sources=[],
     sorts=Redblackmap.mkDict String.compare,binder_lists=[],
     import_limit=cap,literal_limit=cap,binder_limit=RP.AtMost 1,
     recipe_limits={template_limit=cap,index_limit=cap,
       operand_limit=cap,token_limit=cap},
     special=fn _=>fn _=>NONE,ascribed=fn _=>fn _=>fn _=>NONE}
  fun input text =
    let val index=ref 0 in fn()=>
      if !index=String.size text then NONE else
        let val result=String.sub (text,!index)
        in index:= !index+1;SOME result end end
  fun packet (e:env) text =
    CPC_GraphValueProofParser.create_packet_with_policy_from_input
      (#work e) (#query e) (options e) (#metadata e) "1.3.4" (input text)
  fun graph_assertions (e:env) (data:CV.proof VP.contents) =
    let val current=GP.query_nodes_with_policy_for (#work e) (#query e)
    in W.with_step (#work e) (fn()=>
      let
        val context= #context data
        fun guard ()=(PV.validate context;
          G.validate_scope (#graph e) (#scope e))
        fun tick ()=(guard ();W.spend_policy (#work e) 1)
        fun compare (left,right)=(tick ();Int.compare (left,right))
        val memo=ref (Redblackmap.mkDict compare)
        (* The actual query supplies graph IDs. Copy App DATA with sharing;
           graph_leaf remains restricted to its genuine atomic contract.
           This fixture needs no native query term or binder conversion. *)
        fun copy node=
          let val _=tick () val syntax=G.view (#graph e) node
              val id=G.node_id node
          in case Redblackmap.peek (!memo,id) of
              SOME value=>(PV.usable context (#scope e) value;value)
            | NONE=>
                let val value=case syntax of
                        G.Variable _=>PV.graph_leaf context (#scope e) node
                      | G.Constant _=>PV.graph_leaf context (#scope e) node
                      | G.Application (left,right)=>
                          let val f=copy left val x=copy right
                          in PV.application context (#scope e) (f,x) end
                      | _=>raise Fail "fixture Source needs binder programme"
                    val _=PV.usable context (#scope e) value
                    val _=tick ()
                    val _=memo:=Redblackmap.insert (!memo,id,value)
                in value end
          end
        fun copies []=(guard ();[])
          | copies (node::rest)=(tick ();copy node::copies rest)
      in copies (#assumptions current @ [#denied current]) end)
    end
  fun fixture assumptions goal=fixture_with true assumptions goal
  fun asserted_values (e:env) (data:CV.proof VP.contents) =
    let val current=GP.query_nodes_with_policy_for(#work e)(#query e)
        val fallback=graph_assertions e data
    in W.with_step(#work e)(fn()=>
      let val context= #context data
          val asserted=List.mapPartial(fn C.GraphAssume(_,term)=>
              SOME(#node term)|_=>NONE)(#commands(#proof data))
          fun actual(node,copied)=case List.find(fn value=>
              case PV.corresponds_to_graph_with_policy context
                  (#graph e)(#scope e){value=value,node=node}of
                PV.Corresponding=>true|_=>false)asserted of
              SOME value=>value|NONE=>copied
      in ListPair.map actual
        (#assumptions current@[#denied current],fallback)end)
    end
  fun using (e:env) text assertions callback action =
    let
      val held=packet e text
      val data=W.with_step (#work e) (fn()=>
        VP.contents_with_policy_for (#work e) (#query e) held)
      val sources=assertions e data
      val saved=ref (NONE:Receiver.invocation option)
      val outcome=Exn.capture (fn()=>
        let val prepared=CPC_OwnedValueNamedReplay.prepare_with_policy
              (#work e) (#query e) held
              {assertions=sources,native_contract= #contract e,
               check_type=callback}
            val _=case prepared of Receiver.Prepared value=>saved:=SOME value
              | Receiver.Needs _=>()
        in action held data prepared end) ()
      val cleanup=Exn.capture (fn()=>
        (Option.app Receiver.close (!saved);VP.close held)) ()
    in case outcome of Exn.Exn primary=>raise primary
      | Exn.Res result=>(Exn.release cleanup;result) end
  fun ready (Receiver.Prepared value)=value
    | ready (Receiver.Needs _)=raise Fail "ordinary named programme pending"
  fun run (e:env) saved =
    let fun next ()=case Receiver.replay_next_with_policy (#work e) saved of
          NONE=>() | SOME _=>next ()
    in next () end
  fun root_result(e:env)(data:CV.proof VP.contents)saved =
    let val id=case List.last(#commands(#proof data))of
            C.GraphAssume(id,_)=>id|C.GraphAssumePush(id,_)=>id
          | C.GraphStep{step,...}=> #id step
    in Receiver.step_with_policy_for(#work e)saved id end
  fun finish(e:env)
      (result:{block:P.block,node:PV.value,edge:P.edge}) =
    let val input=W.with_step(#work e)(fn()=>
          P.realization_input_for(#work e)(#block result)(#edge result))
        val plan=case Real.prepare(#work e)input{check_type=fn _=>()}of
            Real.Prepared plan=>plan
          | Real.Needs _=>raise Fail "CPC actual Source realization pending"
        val result=Real.execute(#work e)plan
        val frame=Scope.root_with_policy(#work e)
    in W.with_step(#work e)(fn()=>
      let val theorem=Real.contradiction_for(#work e)result
          val dependencies=Real.current_dependencies_for(#work e)result
          val _=S.check_contradiction(#sources e)theorem
          fun guard()=ignore(Real.contradiction_for(#work e)result)
          val close=SmtReplayGoalClose.prepare
            {work= #work e,contract= #contract e,
             native=NC.for_work(#work e)(#contract e),sources= #sources e,
             graph= #graph e,scope= #scope e,frame=frame,proof=theorem,
             guard=guard,profiles=[],check_type=fn _=>(),
             error=fn message=>Fail message,
             type_weight=fn ceiling=>N.type_weight_using
               (W.spend_policy(#work e))(fn message=>Fail message)ceiling,
             counter=Goal.type_counter(fn()=>Fail "unfinished Type child")}
          val goal=Goal.execute(#work e)close
      in (theorem,dependencies,goal)end)end
  val double = boolSyntax.mk_neg(boolSyntax.mk_neg boolSyntax.F)
  val text = "((assume @a (not (not false))) "^
    "(step @b false :rule not_not_elim :premises (@a)))"
  val introduced =
    "((assume @a (not (not false))) "^
    "(step @t true :rule and_intro :premises ()) "^
    "(step @one (not (not false)) :rule and_intro :premises (@a)) "^
    "(step @both (and true true (not (not false))) "^
      ":rule and_intro :premises (@t @t @one)) "^
    "(step @picked (not (not false)) :rule and_elim "^
      ":premises (@both) :args (2)) "^
    "(step @done false :rule not_not_elim :premises (@picked)))"
  fun original_result(e:env) data saved =
    let val (theorem,dependencies,goal)=finish e(root_result e data saved)
        val assumptions=S.assumption_nodes(#sources e)
        val _=S.check_contradiction(#sources e)theorem
    in require "actual CPC Source/Goal realization changed its lineage"
      (dependencies=[0]andalso length(Thm.hyp goal)=1 andalso
       Term.aconv(Thm.concl goal)``cpc_simple_goal410:bool``andalso
       null(Tag.axioms_of(Thm.tag goal))andalso
       List.all(fn hypothesis=>List.exists(fn node=>
         Portable.pointer_eq(hypothesis,G.representative(#graph e)node))
         assumptions)(Thm.hyp goal)andalso
       not(#retired(W.audit_policy(#work e))))end
  fun before_names(e:env) certificate wanted =
    let val held=packet e certificate
        val data=W.with_step(#work e)(fn()=>
          VP.contents_with_policy_for(#work e)(#query e)held)
        val assertions=asserted_values e data
        val calls=ref 0 val prior=Count.thm_count()
        val exact=(ignore(Receiver.prepare_with_policy(#work e)(#query e)held
          {assertions=assertions,native_contract= #contract e,
           check_type=fn _=>calls:= !calls+1});false)
          handle Feedback.HOL_ERR detail=>Feedback.message_of detail=wanted
        val _=VP.close held
    in require "invalid fixed CPC programme ran before metadata decline"
      (exact andalso !calls=0 andalso Count.thm_count()=prior andalso
       #retired(W.audit_policy(#work e)))end
