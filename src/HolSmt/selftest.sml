(* Five staged genuine fixed-name controls; no ordinal or launch. *)
local
  structure P=SmtReplayProof
  structure G=SmtReplayGraph
  structure S=SmtReplaySource
  structure W=SmtReplayInvocationWork
  structure Scope=SmtReplayOwnedScopeReceipt
  structure B=SmtLib_GraphBackend
  structure Rules=SmtReplayRuleObservation
  type env={graph:G.graph,root:G.scope,work:W.portfolio,block:P.block,
    node:G.node,close_child:unit -> unit}
  fun require text yes=if yes then()else raise Fail text
  fun test label action=
    ((Count.counting_thms true;testutils.tprint label;action();
      Count.counting_thms false;testutils.OK())
     handle primary=>(Count.counting_thms false;raise primary))
  fun refused action=(action();false)handle Feedback.HOL_ERR _=>true
  fun setup child ty:env=
    let
      val graph=G.new()val root=G.root_scope graph
      val sources=S.new graph root 256
        {assumptions=[],goal=boolSyntax.T}
      val work=W.begin_with_scope_guard graph root sources
        {limits={input_limit=256,output_limit=256,template_limit=256},
         work_limit=20000000}
      val parent=Scope.root work
      val(scope,frame,close_child)=if child then
          let val backend=B.graphs{graph=graph,scope=root,
                import_limit=256,literal_limit=256,binder_limit=256}
              val opened=B.open_binders backend(B.root backend)
                [("type_identity_x","type_identity_x",Type.bool)]
          in(valOf(#scope opened),Scope.binding work parent
            (valOf(#origin opened)),#close opened)end
        else(root,parent,fn()=>())
      val node= #node(G.import graph scope 256
        (Term.mk_var("type_identity_operand",ty)))
      val block=W.with_step work(fn()=>P.freeze_owned_tables work
        {frame=frame,roots=[node],closed_facts=[],conversions=[]})
    in {graph=graph,root=root,work=work,block=block,node=node,
      close_child=close_child}end
  fun fixture child ty action=
    let val e=setup child ty
        val outcome=Exn.capture action e
        val cleanup=Exn.capture(fn()=>
          (W.close(#work e);G.close_scope(#graph e)(#root e)))()
    in case outcome of Exn.Exn primary=>raise primary
      | Exn.Res value=>(Exn.release cleanup;value)end
  fun named(e:env)=W.with_step(#work e)
    (fn()=>P.name(#block e)(#node e))
  fun checked(e:env) proof=W.with_step(#work e)
    (fn()=>P.checked(#block e)proof)
  fun symmetric(e:env) edge=W.with_step(#work e)(fn()=>
    let val plan=P.prepare_primitive(#work e)(#block e)P.Symmetry[edge]
    in P.theorem(#block e)(P.execute_primitive(#work e)plan)end)
  fun nested 0=Type.bool
    | nested n=Type.mk_type("fun",[Type.bool,nested(n-1)])
  exception Primary of unit ref
in
  fun run_fixed_name_Type_identity_controls()=
    let
      val _=test "Fixed guard authentic identical Type keeps one REFL"
        (fn()=>fixture false(nested 8)(fn e=>
          let
            val variable=named e
            val exact_type=Portable.pointer_eq(Term.type_of variable,
              G.type_of(#graph e)(#node e))
            val(theorem,counts)=Rules.with_statistics(fn()=>
              W.with_step(#work e)(fn()=>
                let val plan=P.prepare_primitive(#work e)(#block e)
                      (P.ReflexiveName(#node e))[]
                in P.theorem(#block e)
                  (P.execute_primitive(#work e)plan)end))
          in require "authentic identity changed endpoint, Hyp or worker"
            (exact_type andalso null(Thm.hyp theorem)andalso
             Term.aconv(Thm.concl theorem)
               (boolSyntax.mk_eq(variable,variable))andalso
             #selected_returns counts=1 andalso
             #theorem_operand_edges counts=0 andalso
             not(#retired(W.audit(#work e))))end))
      val _=test "Distinct equal Type reaches actual fixed SYM fallback"
        (fn()=>
          let val first=Type.mk_vartype "'type_identity_distinct"
              val second=Type.mk_vartype "'type_identity_distinct"
          in fixture false first(fn e=>
            let
              val variable=named e
              val name= #1(Term.dest_var variable)
              val clone=Term.mk_var(name,second)
              val distinct=not(Portable.pointer_eq
                (Term.type_of variable,Term.type_of clone))
              (* checked retains a genuine edge but uses its own ordinary
                 guard. Only prepare_primitive below enters the changed
                 fixed_names_member, before its sole actual SYM. *)
              val edge=checked e(Thm.REFL clone)
              val(theorem,counts)=Rules.with_statistics(fn()=>
                symmetric e edge)
            in require "distinct equal Type lost real fixed-rule support"
              (distinct andalso null(Thm.hyp theorem)andalso
               Term.aconv(Thm.concl theorem)(boolSyntax.mk_eq(clone,clone))
               andalso #selected_returns counts=1 andalso
               #theorem_operand_edges counts=1 andalso
               not(#retired(W.audit(#work e))))end)end)
      val _=test "Ordinary checked gate still rejects a wrong Type"
        (fn()=>fixture false Type.bool(fn e=>
          let val variable=named e
              val name= #1(Term.dest_var variable)
              val wrong=Term.mk_var(name,
                Type.mk_type("fun",[Type.bool,Type.bool]))
              val rejected=refused(fn()=>ignore
                (checked e(Thm.REFL wrong)))
          (* This is the genuine earlier adoption gate, not purported
             direct coverage of the new fixed-member identity branch. *)
          in require "wrong Type entered the genuine fixed proof block"
            (rejected andalso #retired(W.audit(#work e)))end))
      val _=test "Fixed identity preserves actual Binding retirement"
        (fn()=>fixture true Type.bool(fn e=>
          let val variable=named e
              val edge=checked e(Thm.REFL variable)
              val _=(#close_child e)()
              val prior=Count.thm_count()
              val rejected=refused(fn()=>ignore(symmetric e edge))
          in require "retired Binding reached fixed SYM or kept Work live"
            (rejected andalso Count.thm_count()=prior andalso
             #retired(W.audit(#work e)))end))
      val _=test "Actual fixed prepare preserves owning action Primary"
        (fn()=>fixture false Type.bool(fn e=>
          let val token=ref()
              val exact=(W.with_step(#work e)(fn()=>
                let val _=P.prepare_primitive(#work e)(#block e)
                      (P.ReflexiveName(#node e))[]
                in raise Primary token end);false)
                handle Primary actual=>Portable.pointer_eq(actual,token)
          in require "fixed preparation replaced Primary or renewed Work"
            (exact andalso #retired(W.audit(#work e)))end))
    in()end
end

val _=run_postlude 432 "fixed-name-physical-Type-identity-5"
  run_fixed_name_Type_identity_controls

