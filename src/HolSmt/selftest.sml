      open_view (fn context =>
        SmtLib_GraphFiniteQueryTransport.prepare (#work e) context
        {validation= #validation e,
         operations=SmtLib_GraphCarrierOperations.make_with_datatypes context
           {sequence_emission=false}
           {term_to_string=fn _ => raise Fail "unexpected finite formatter"},
         target=SOME {solver="cvc5",version=SOME "1.3.4"},
         emit_sequences=false,native_contract= #contract e,ordinal=0,
         check_type=callback}) end
  fun ready (F.Ready plan) = plan
    | ready (F.Needs _) = raise Fail "small finite programme has unmet ports"
  fun execute e = F.execute (#work (e:env)) (ready (prepare e (fn _ => ())))
  fun raw (e:env) node = G.representative (#graph e) node
  fun same left right = Term.aconv left right
  fun nodes (e:env) value =
    V.processed_nodes_with_policy_for (#work e) value
  fun realize (e:env) value target =
    let
      val work = #work e
      val preprocessing = GP.from_portfolio_with_policy work value
      val frontier = GP.prepare_final_frontier_with_policy work
        preprocessing {roots=[]}
      val tables = W.with_step work (fn () =>
        P.prepare_owned_realization_tables_with_policy work frontier)
      val preparation = W.with_step work (fn () =>
        P.prepare_native_realization_freeze_with_policy work
          {tables=tables,contract= #contract e,profiles=[],ordinal=0,
           check_type=fn _ => ()})
      val block = W.with_step work (fn () =>
        P.freeze_owned_realization_tables_with_policy work preparation)
      val edge = case GP.assembler_with_policy work preprocessing block target
          of SOME edge => edge | NONE => raise Fail "finite fact unassembled"
    in W.with_step work (fn () =>
      P.policy_source_realization_theorem_for work
        (P.execute_realization_with_policy work
          (P.prepare_realization_with_policy work block target edge))) end
  val finite_s = ``FINITE (finite_transport_s:num -> bool)``
  val finite_t = ``FINITE (finite_transport_t:num -> bool)``
  fun small_conditional (e:env) =
    let
      val graph = #graph e val scope = #scope e val work = #work e
      val expected = {graph=graph,scope=scope,sources= #sources e,work=work}
      (* Bounded TEST-only ALPHA bridges first transport the actual current
         positive goal AND retained denial. A recorded opening by itself
         does not redirect the original graph parent's opaque child IDs. *)
      fun conversion source target theorem =
        let val left = G.representative graph source
            val right = G.representative graph target
            val _ = require "small opening oracle exceeded fixture bound"
              (Option.isSome (SmtReplayImport.bounded_raw_size 96 left)
               andalso Option.isSome
                 (SmtReplayImport.bounded_raw_size 96 right))
            val (a,b) = boolSyntax.dest_eq (Thm.concl theorem)
            val proof = Thm.TRANS (Thm.ALPHA left a)
              (Thm.TRANS theorem (Thm.ALPHA b right))
            val receipt = P.record_conversion_with_policy graph scope
              {source=source,target=target,theorem=proof,
               source_view=G.record_opened_view_with_policy graph scope
                 (RP.AtMost 100000) source,
               target_view=G.record_opened_view_with_policy graph scope
                 (RP.AtMost 100000) target,
               template_limit=RP.Uncapped,check_type=fn _ => ()}
        in {receipt=receipt,theorem=proof} end
      val old_goal = #node (S.goal_source (#sources e))
      val opened = G.record_opened_view_with_policy graph scope
        (RP.AtMost 100000) old_goal
      val positive = conversion old_goal (#node opened) (#bridge opened)
      val negation = G.constant graph scope boolSyntax.negation
      val new_denied = G.application graph scope (negation,#node opened)
      val negative = conversion (S.denied_goal_node (#sources e)) new_denied
        (Thm.AP_TERM boolSyntax.negation (#theorem positive))
      val current = V.transport_query_with_policy work (#validation e)
        {assumptions=[{occurrence=0,conversion=NONE}],
         goal=SOME (#receipt positive),denied=SOME (#receipt negative)}
      val goal = W.with_step work (fn () =>
        A.current_query_with_policy work current A.CurrentGoal)
      val (partial,_) = A.application_children_with_policy expected goal
      val (_,admission) = A.application_children_with_policy expected partial
      val data = A.describe_with_policy_for expected admission
      val closure = G.closure_child_binder graph scope (#child data)
      val captured = G.binder_closure_data graph scope closure
      val frame = #body_frame captured val body = #body captured
      val binder = #binder captured
      val equality = Thm.BETA_CONV (G.representative graph body)
      val head = G.constant graph frame
        (Term.rator (Term.rator (Thm.concl equality)))
      val equation = G.application graph frame
        (G.application graph frame (head,body),binder)
      val condition = G.constant graph frame boolSyntax.T
      val implication = G.constant graph frame boolSyntax.implication
      val statement = G.application graph frame
        (G.application graph frame (implication,condition),equation)
      val theorem = Thm.DISCH boolSyntax.T equality
      val canonical = Thm.EQ_MP
        (Thm.ALPHA (Thm.concl theorem)
          (G.representative graph statement)) theorem
      val fact = P.record_closed_with_policy graph frame
        {node=statement,theorem=canonical,template_limit=RP.Uncapped,
         check_type=fn _ => ()}
    in (admission,fact) end
