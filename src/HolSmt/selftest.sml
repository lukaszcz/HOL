(* Strict SolverSpec observers retain cancellation and cleanup ownership. *)
local
  fun check name okay =
    (testutils.tprint name;
     if okay then testutils.OK () else raise Fail name)
  fun no_file path = not (OS.FileSys.access (path, []))
    handle _ => false
  fun clean paths = List.all no_file paths

  fun sat (Exn.Res (SolverSpec.SAT NONE)) = true
    | sat _ = false
  fun interrupted (Exn.Exn Interrupt) = true
    | interrupted _ = false
  fun timed_out (Exn.Exn (Timeout.TIMEOUT _)) = true
    | timed_out _ = false
  fun failed wanted (Exn.Exn (Fail actual)) = wanted = actual
    | failed _ _ = false

  val goal = ([], boolSyntax.T)
  (* /bin/true accepts SolverSpec's input argument; shell redirection
     creates the output. No SMT solver, CVC entry, or theorem is involved. *)
  fun exercise strict stop problem cleanup_fails =
    let
      val events = ref ([] : string list)
      val paths = ref ([] : string list)
      val output_exists = ref false
      fun mark event = events := !events @ [event]
      fun pre _ = (mark "pre"; ((), []))
      fun command () = (mark "command-stem"; "/bin/true ")
      fun capture _ key stage source =
        (paths := key :: source :: !paths;
         mark ("capture-" ^ stage);
         if stage = "output" then
           output_exists := OS.FileSys.access (source, [])
         else ();
         if stage = stop then
           (case problem of SOME exn => raise exn | NONE => ())
         else ())
      fun post () _ = (mark "post"; SolverSpec.SAT NONE)
      fun validate _ _ _ = mark "validate"
      fun complete () =
        (mark "complete";
         if cleanup_fails then raise Fail "cleanup" else ())
      val result = Exn.capture (fn () =>
        if strict then
          SolverSpec.make_solver_with_capture_command_and_completion_strict
            validate complete (SOME capture) pre command post goal
        else
          SolverSpec.make_solver_with_capture_command_and_completion
            validate complete (SOME capture) pre command post goal) ()
    in (result, !events, !paths, !output_exists) end

in
  val _ = run_postlude 337 "strict-solver-capture-cleanup-5" (fn () =>
    let
      val saved_trace = !Library.trace
      val _ = Library.trace := 0
      val outcome = Exn.capture (fn () =>
        let
  val (input_cancel, input_events, input_paths, input_output) =
    exercise true "input" (SOME Interrupt) true
  val _ = check "strict input Interrupt stops before output and post"
    (interrupted input_cancel andalso
     input_events = ["pre", "command-stem", "capture-input",
       "complete"] andalso not input_output andalso clean input_paths)

  val (output_cancel, output_events, output_paths, output_ready) =
    exercise true "output"
      (SOME (Timeout.TIMEOUT Time.zeroTime)) true
  val _ = check "strict output Timeout stops before post"
    (timed_out output_cancel andalso
     output_events = ["pre", "command-stem", "capture-input",
       "capture-output", "complete"] andalso output_ready andalso
     clean output_paths)

  val (ordinary_error, ordinary_events, ordinary_paths,
       ordinary_output) =
    exercise true "input" (SOME (Fail "observer")) false
  val _ = check "strict nonterminal capture remains observational"
    (sat ordinary_error andalso
     ordinary_events = ["pre", "command-stem", "capture-input",
       "capture-output", "post", "complete"] andalso
     ordinary_output andalso clean ordinary_paths)

  val (legacy_cancel, legacy_events, legacy_paths, legacy_output) =
    exercise false "input" (SOME Interrupt) false
  val _ = check "ordinary observer retains non-strict behavior"
    (sat legacy_cancel andalso
     legacy_events = ["pre", "command-stem", "capture-input",
       "capture-output", "post", "complete"] andalso
     legacy_output andalso clean legacy_paths)

  val pre_events = ref ([] : string list)
  fun pre_failure _ =
    (pre_events := "pre" :: !pre_events;
     raise Fail "pre-primary")
  val pre_result = Exn.capture (fn () =>
    SolverSpec.make_solver_with_capture_command_and_completion_strict
      (fn _ => fn _ => fn _ => ())
      (fn _ => pre_events := "complete" :: !pre_events)
      NONE pre_failure (fn _ => "/bin/true ")
      (fn _ => fn _ => SolverSpec.SAT NONE) goal) ()
  val _ = check "pre failure has no retained completion artifact"
    (failed "pre-primary" pre_result andalso !pre_events = ["pre"])

        in () end) ()
      val _ = Library.trace := saved_trace
    in Exn.release outcome end)
end

