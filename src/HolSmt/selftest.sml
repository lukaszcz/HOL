        {target = child,retain = [child]}) end
  fun conversion (e : fixture) receipt change =
    let
      val data = X.describe_for (expected e) receipt
      val original = #original data
      (* Deliberately proved alternative equation, not a policy claim:
         |- (!x. inv x = (&1 / x)) = (inv = ($/ &1)). *)
      val step = if change andalso Portable.pointer_eq
          (original,realTheory.REAL_INV_1OVER) then
        Conv.REWR_CONV (Conv.GSYM boolTheory.FUN_EQ_THM) (Thm.concl original)
        else Thm.REFL (Thm.concl original)
      val target_term = boolSyntax.rhs (Thm.concl step)
      val imported = G.import (#graph e) (#scope e) cap target_term
      val opened = G.record_opened_view (#graph e) (#scope e) cap (#node imported)
      val old_bridge = Thm.TRANS (#bridge (#imported data))
        (#bridge (#opened data))
      val new_bridge = Thm.TRANS (#bridge imported) (#bridge opened)
      val equality = Thm.TRANS (Thm.SYM old_bridge)
        (Thm.TRANS step new_bridge)
      val old_node = #node (#opened data) val new_node = #node opened
      val leaf = P.record_conversion (#graph e) (#scope e)
        {source = old_node,source_view = identity_view e old_node,
         target = new_node,target_view = identity_view e new_node,
         theorem = equality,template_limit = cap,check_type = fn _ => ()}
      val tape = W.with_step (#work e) (fn () =>
        CG.graph_leaf (#graph e) (#scope e)
          {conversion = leaf,template_limit = cap,
           observe = fn () => W.spend (#work e) 1})
      val result = Core.execute (#work e) (Core.prepare (#work e)
        {conversion = tape,ordinal = next e,check_type = fn _ => ()})
    in D.adopt_compact
      (D.start_auxiliary (#work e) {law = receipt}) result end
  fun complete_batch (e : fixture) pending change =
    List.map (fn selected =>
      let val receipt = law e selected
          val converted = conversion e receipt change
      in N.normalize_result pending
        {law = receipt,conversion = converted,ordinal = next e} end)
      (N.pending_selections pending)
  fun finish (e : fixture) pending change =
    let val completed = complete_batch e pending change
    in case N.resume pending completed of N.Complete result => result
      | N.NeedsNormalization more => finish e more change end
