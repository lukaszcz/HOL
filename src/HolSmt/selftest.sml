  fun parse source =
    let val position = ref 0
        fun input () = if !position = String.size source then NONE else
          let val character = String.sub (source,!position)
          in position := !position+1;SOME character end
        val next = P.make_proof_input_tokenizer input
        val term = P.parse_term next (SmtLib_Logics.parsedicts_of_logic "ALL")
        val ended = (next ();false) handle P.ProofEOF => true
    in require "store output has trailing SMT tokens" ended;term end
