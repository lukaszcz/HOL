            let val prior = Count.thm_count ()
                val refused = failure (fn () =>
                  Law.record_with_policy (#work expected)
                    {frame= #frame expected,
                     native_contract= #contract expected,
                     conversion= #conversion held,profiles=[],ordinal=1,
                     check_type=fn _ => raise Fail "foreign callback"})
            in require "foreign receipt backing hid its immutable owner"
              (refused=SOME "different expected original receipt" andalso
               Count.thm_count ()=prior andalso retired expected andalso
               not (retired held)) end) end))
      val _ = test "Input output and template caps precede new record effects"
        (fn () => List.app (fn which =>
