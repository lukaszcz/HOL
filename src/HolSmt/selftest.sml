    "(assume @p p) (assume @nr (not r)) "^
    "(step @pr (= p r) :rule trans :premises (@equal @other)) "^
    "(step @r r :rule eq_resolve :premises (@pr @p)) "^
    "(step @done false :rule contra :premises (@r @nr)))"
  val cong_text=
    "((assume @equal (= p q)) (assume @negative (not (= (f p) (f q)))) "^
    "(step @lifted (= (f p) (f q)) :rule cong "^
       ":premises (@equal) :args ((f p))) "^
    "(step @done false :rule contra :premises (@lifted @negative)))"
  val ho_text=
    "((assume @operators (= f g)) (assume @equal (= p q)) "^
    "(assume @negative (not (= (f p) (g q)))) "^
    "(step @lifted (= (f p) (g q)) :rule ho_cong "^
      ":premises (@operators @equal)) "^
    "(step @done false :rule contra :premises (@lifted @negative)))"
  fun native_reference_with
      (limits:{input_limit:int,output_limit:int,template_limit:int})
      assumptions goal text=
    let
        (* This reference has its own genuine Sources and claims them
           exactly once. The separate Value fixture below owns another
           graph/Source/policy Work; no invocation is reborrowed. *)
        val graph=G.new()val scope=G.root_scope graph
        val sources=S.new graph scope 10000
          {assumptions=assumptions,goal=goal}
        val native_work=W.begin_with_scope_guard graph scope sources
          {limits=limits,work_limit=1000000000}
        val options:F.options=
          {graph=graph,scope=scope,logic="ALL",sources=bindings,
           sorts=Redblackmap.mkDict String.compare,binder_lists=[],
           import_limit=1000000,literal_limit=1000000,binder_limit=1,
           recipe_limits={template_limit=1000000,index_limit=1000000,
             operand_limit=1000000,token_limit=1000000},
           special=fn _=>fn _=>NONE,ascribed=fn _=>fn _=>fn _=>NONE}
        val stream=TextIO.openString text
        fun checked theorem=
          let val allowed=S.assumption_nodes sources
              (* prove_preprocessed_with_work_using already applies the
                 original Source.close_contradiction programme. It returns
                 the public Goal theorem, not its internal F theorem. *)
              val _=S.check_goal sources theorem
          in require "native Boolean changed original Goal/allowed Hyp"
            (Portable.pointer_eq(Thm.concl theorem,
                #2(S.original_goal sources))andalso
             null(Tag.axioms_of(Thm.tag theorem))andalso
             List.all(fn term=>List.exists(fn node=>Portable.pointer_eq
               (term,G.representative graph node))allowed)(Thm.hyp theorem))
          end
        val result=Exn.capture(fn()=>
          let val held=C.parse_graph_packet_with_version options
                (SmtLib_Logics.parsedicts_of_logic "ALL")"1.3.4"stream
              val proof=Exn.capture(fn()=>
                let val preprocessing=GP.discover_from_sources
                      graph scope sources
                      {import_limit=1000000,revisit=false,
                       check_type=fn _=>(),conversion=fn _=>NONE}
                in CPC_GraphProofReplay.prove_preprocessed_with_work_using
                  native_work
                  {graph=graph,scope=scope,sources=sources,
                   preprocessing=preprocessing,
                   proof=SmtLib_GraphProof.proof held,
                   ordinary_limit= #input_limit limits,
                   template_limit= #template_limit limits,force_worker=NONE,
                   worker=fn _=>raise Fail "native Boolean fallback"}end)()
              val cleanup=Exn.capture(fn()=>SmtLib_GraphProof.close held)()
          in case proof of Exn.Exn primary=>raise primary
            | Exn.Res theorem=>(Exn.release cleanup;checked theorem)end)()
        val cleanup=Exn.capture(fn()=>
          (W.close native_work;TextIO.closeIn stream;
           G.close_scope graph scope))()
    in case result of Exn.Exn primary=>raise primary
      | Exn.Res answer=>(Exn.release cleanup;answer)end
  fun native_reference assumptions goal text=
    native_reference_with (#semantic_limits native) assumptions goal text
  fun positive assumptions text expected = fixture assumptions goal(fn e=>
    using e text(fn _=>())(fn _=>fn _=>fn prepared=>
      let val owner=ready prepared val prior=Count.thm_count()
          val result=proved(Final.finish_with_policy(#work e)owner)
          val _=checked e(#theorem result)
      in require "CPC equality bypassed actual Source/Goal proof or lineage"
        (#dependencies result=expected andalso
         not(Term.aconv(Thm.concl(#theorem result))boolSyntax.F)andalso
         #CCONTR(Count.thm_count())> #CCONTR prior andalso
         List.all(fn term=>not(Term.aconv term boolSyntax.F))assumptions
         andalso not(#retired(W.audit_policy(#work e))))end))
  fun before_names(e:env) certificate wanted =
    let val held=packet e certificate
        val data=W.with_step(#work e)(fn()=>
          VP.contents_with_policy_for(#work e)(#query e)held)
        val assertions=asserted_values e data
        val calls=ref 0 val prior=Count.thm_count()
        val exact=(ignore(Final.prepare_with_policy(#work e)(#query e)held
          {assertions=assertions,native_contract= #contract e,
           profiles=[],check_type=fn _=>calls:= !calls+1});false)
          handle Feedback.HOL_ERR detail=>Feedback.message_of detail=wanted
        val _=VP.close held
    in require "wrong equality endpoint reached naming or changed Primary"
      (exact andalso !calls=0 andalso Count.thm_count()=prior andalso
       #retired(W.audit_policy(#work e)))end
  fun pending_checked geometry(e:env) certificate handler =
    let val held=packet e certificate
        val data=W.with_step(#work e)(fn()=>
          VP.contents_with_policy_for(#work e)(#query e)held)
        val assertions=asserted_values e data
        val geometry_ok=geometry e data assertions
        val calls=ref 0 val prior=Count.thm_count()
        val result=Final.prepare_with_policy(#work e)(#query e)held
          {assertions=assertions,native_contract= #contract e,
           profiles=[],check_type=fn _=>calls:= !calls+1}
        val alive=W.with_step(#work e)(fn()=>
          (ignore(VP.contents_with_policy_for
            (#work e)(#query e)held);true))
        val _=VP.close held
    in require "missing equality programme executed or adopted packet"
      (geometry_ok andalso alive andalso !calls=0 andalso
       Count.thm_count()=prior andalso
       not(#retired(W.audit_policy(#work e)))andalso
       (case result of Final.ReplayNeeds
           [Receiver.RuleProgramme{rule,...}]=> #replay_handler rule=handler
         | _=>false))end
  fun pending e certificate handler=
    pending_checked(fn _=>fn _=>fn _=>true)e certificate handler
  fun reglan_geometry(e:env)(data:CV.proof VP.contents) assertions=
    W.with_step(#work e)(fn()=>
      let val context= #context data
          fun cursor value=PV.proof_term context value
          fun language_relation value=
            case PV.proof_view context(cursor value)of
              PV.ProofApplication(partial,right)=>
                (case PV.proof_view context partial of
                   PV.ProofApplication(head,left)=>
                     (case PV.proof_view context head of
                        PV.ProofConstant atom=>
                          Term.same_const atom SmtRegLanProve.equiv_tm
                          andalso Type.compare(PV.proof_type_of context left,
                            SmtRegLanProve.reglan_ty)=EQUAL
                          andalso Type.compare(PV.proof_type_of context right,
                            SmtRegLanProve.reglan_ty)=EQUAL
                      | _=>false)
                 | _=>false)
            | _=>false
      in case (#commands(#proof data),assertions)of
          ([C.GraphAssume(id,source),_,C.GraphStep{step,...}],first::_)=>
            id="@languages"andalso language_relation(#node source)andalso
            PV.proof_key context(cursor first)=
              PV.proof_key context(cursor(#node source))andalso
            (case #conclusion step of
               SOME target=>language_relation(#node target)|NONE=>false)
        | _=>false end)

