      (#work e) (#query e) opening action end
  fun insert (store:Store.interface) terms (name,value,rank) =
    let val operations = #operations store
        val key = (#ordinary_key operations) (value,rank)
    in (#term_insert operations) (terms,key,name) end
  fun freeze (e:env) regime build = borrow e (fn context =>
    let val store = Store.create context {prefix="parser_value_"}
        val terms = build context store
    in SmtLib_GraphParserMapping.freeze context
      {graph= #graph e,scope= #scope e,regime=regime,
       types=Redblackmap.mkDict Type.compare,symbols=(#symbols store) terms}
    end)
  fun declaration mapping token =
    case List.find (fn (entry:M.declaration) => #token entry=token)
        (M.declarations mapping) of
