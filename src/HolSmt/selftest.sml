          in fixture [] (boolSyntax.mk_conj (small,huge)) (fn e =>
            let
              val old = current e (#validation e)
              val (partial,retained) = case G.view (#graph e) (#goal old) of
                  G.Application pair => pair
                | _ => raise Fail "retained diamond root lost its argument"
              val changed = case G.view (#graph e) partial of
                  G.Application (_,operand) => operand
                | _ => raise Fail "changed sibling lost its argument"
              val row = opening e (lambda e changed)
              val oversized = case G.unfolded_nodes_with_policy (#graph e)
