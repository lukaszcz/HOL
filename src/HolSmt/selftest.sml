    {rule=rule,whole= #1 whole,argument= #2 whole,index=index,
     literals=literals}
  val cnf_cases=[
    row "cnf_implies_neg1" implies NONE[pos pp,pos implies],
    row "cnf_implies_neg2" implies NONE[not_ qq,pos implies],
    row "cnf_implies_pos" implies NONE[not_ pp,pos qq,not_ implies],
    row "cnf_and_pos" and_ (SOME 0)[pos pp,not_ and_],
    row "cnf_and_neg" and_ NONE[pos and_,not_ pp,not_ qq],
    row "cnf_or_neg" or_ (SOME 1)[pos or_,not_ qq],
    row "cnf_or_pos" or_ NONE[not_ or_,pos pp,pos qq],
    row "cnf_equiv_neg1" equiv NONE[pos pp,pos qq,pos equiv],
    row "cnf_equiv_neg2" equiv NONE[not_ pp,not_ qq,pos equiv],
    row "cnf_equiv_pos1" equiv NONE[not_ pp,pos qq,not_ equiv],
    row "cnf_equiv_pos2" equiv NONE[pos pp,not_ qq,not_ equiv],
    row "cnf_xor_pos1" xor_ NONE[not_ xor_,pos pp,pos qq],
    row "cnf_xor_pos2" xor_ NONE[not_ xor_,not_ pp,not_ qq],
    row "cnf_xor_neg1" xor_ NONE[pos xor_,not_ pp,pos qq],
    row "cnf_xor_neg2" xor_ NONE[pos xor_,pos pp,not_ qq],
    row "cnf_ite_pos1" ite NONE[not_ ite,not_ rr,pos pp],
    row "cnf_ite_pos2" ite NONE[not_ ite,pos rr,pos qq],
    row "cnf_ite_pos3" ite NONE[not_ ite,pos pp,pos qq],
    row "cnf_ite_neg1" ite NONE[pos ite,not_ rr,not_ pp],
    row "cnf_ite_neg2" ite NONE[pos ite,pos rr,not_ qq],
    row "cnf_ite_neg3" ite NONE[pos ite,not_ pp,not_ qq]]
  val alias_text=
    "((assume @equation (= (f p) (f q))) "^
    "(assume @source (f p)) (assume @negative (not (f q))) "^
    "(step @q (f q) :rule eq_resolve :premises (@source @equation)) "^
    "(step @done false :rule contra :premises (@q @negative)))"
  val trans_alias_text=
    "((assume @pq (= (f p) (f q))) "^
    "(assume @rq (= (f r) (f q))) (assume @p (f p)) "^
    "(assume @negative (not (f r))) "^
    "(step @pr (= (f p) (f r)) :rule trans :premises (@pq @rq)) "^
    "(step @r (f r) :rule eq_resolve :premises (@pr @p)) "^
    "(step @done false :rule contra :premises (@r @negative)))"
  type ordinary_case={label:string,assumptions:Term.term list,text:string}
  val ordinary_cases:ordinary_case list=[
    {label="bool",assumptions=[imp(p,q),p,neg q],
     text="((assume @imp (=> p q)) (assume @p p) "^
       "(assume @negative (not q)) (step @q q :rule bool "^
       ":premises (@imp @p)) "^
       "(step @done false :rule contra :premises (@q @negative)))"},
    {label="false_intro",assumptions=[neg p,p],
     text="((assume @negative (not p)) (assume @p p) "^
       "(step @equal (= p false) :rule false_intro "^
       ":premises (@negative)) (step @done false :rule eq_resolve "^
       ":premises (@p @equal)))"},
    {label="false_elim",assumptions=[eq(p,boolSyntax.F),p],
     text="((assume @equal (= p false)) (assume @p p) "^
       "(step @negative (not p) :rule false_elim :premises (@equal)) "^
       "(step @done false :rule contra :premises (@p @negative)))"},
    {label="true_intro",assumptions=[p,neg p],
     text="((assume @p p) (assume @negative (not p)) "^
       "(step @equal (= p true) :rule true_intro :premises (@p)) "^
       "(step @again p :rule true_elim :premises (@equal)) "^
       "(step @done false :rule contra :premises (@again @negative)))"},
    {label="true_elim",assumptions=[eq(p,boolSyntax.T),neg p],
     text="((assume @equal (= p true)) (assume @negative (not p)) "^
       "(step @p p :rule true_elim :premises (@equal)) "^
       "(step @done false :rule contra :premises (@p @negative)))"},
    {label="process_scope",assumptions=[imp(p,imp(q,r)),p,q,neg r],
     text="((assume @chain (=> p (=> q r))) (assume @p p) "^
       "(assume @q q) (assume @negative (not r)) "^
       "(step @scope (=> (and p q) r) :rule process_scope "^
       ":premises (@chain) :args (r)) (step @r r :rule bool "^
       ":premises (@scope @p @q)) "^
       "(step @done false :rule contra :premises (@r @negative)))"},
    {label="factoring",assumptions=[disj(p,disj(p,q)),neg p,neg q],
     text="((assume @clause (or p p q)) (assume @np (not p)) "^
       "(assume @nq (not q)) (step @factored (or p q) :rule factoring "^
       ":premises (@clause)) (step @q q :rule resolution "^
       ":premises (@factored @np)) "^
       "(step @done false :rule resolution :premises (@q @nq)))"},
    {label="reordering",assumptions=[disj(p,q),neg p,neg q],
     text="((assume @clause (or p q)) (assume @np (not p)) "^
       "(assume @nq (not q)) (step @reordered (or q p) "^
       ":rule reordering :premises (@clause)) (step @q q :rule resolution "^
       ":premises (@reordered @np)) "^
       "(step @done false :rule resolution :premises (@q @nq)))"},
    {label="resolution",assumptions=[disj(p,q),neg p,neg q],
     text="((assume @clause (or p q)) (assume @np (not p)) "^
       "(assume @nq (not q)) (step @q q :rule resolution "^
       ":premises (@clause @np)) "^
       "(step @done false :rule resolution :premises (@q @nq)))"},
    {label="chain_m_resolution",assumptions=[disj(p,q),neg p,neg q],
     text="((assume @clause (or p q)) (assume @np (not p)) "^
       "(assume @nq (not q)) (step @done false :rule chain_m_resolution "^
       ":premises (@clause @np @nq) "^
       ":args (false (@list true true) (@list p q))))"}]
  fun ordinary_test({label,assumptions,text}:ordinary_case)=
    test("Actual "^label^" matches native and closes original Goal")
