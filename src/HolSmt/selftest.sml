               #retired(W.audit_policy(#work e)))end)))
      val _=test "A genuine true root cannot pass contradiction finalization"
        (fn()=>fixture[boolSyntax.T]goal(fn e=>using e
          "((assume @t true))"(fn _=>())
          (fn _=>fn data=>fn prepared=>
            let
                val owner=ready prepared
