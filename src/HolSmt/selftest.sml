    in W.with_step (#work e) (fn () =>
      P.freeze_owned_realization_tables_with_policy (#work e) freeze) end
  fun failure action = (action ();NONE)
    handle Feedback.HOL_ERR detail => SOME (Feedback.message_of detail)
