              val calls = ref 0 val prior = Count.thm_count ()
              val denied = failure (fn () =>
                transport e [incorrect] (fn _ => calls := !calls+1))
          in require "malformed opening reached a proof or callback"
            (denied=SOME (if wrong_frame then
               "opening is outside the query frame"
             else "different registered opening endpoint") andalso
             !calls=0 andalso Count.thm_count ()=prior andalso retired e)
          end)) [false,true])
      val _ = test "Actual opaque native admission precedes proof effects"
        (fn () => fixture_after
          {semantic_limits={input_limit=1,output_limit=1,
             template_limit=100000},import_limit=1,type_work_limit=10000000}
          [] small (fn e => fn outcome =>
            let val rejected = case outcome of
                  Exn.Exn (Feedback.HOL_ERR _) => true | _ => false
            in require "tiny existing native contract did not reject"
              (rejected andalso retired e) end)
          (fn e =>
            let val row = opening e
                  (lambda e (#goal (current e (#validation e))))
                val prior = Count.thm_count () val calls = ref 0
                val caught = Exn.capture (fn () =>
                  transport e [row] (fn _ => calls := !calls+1)) ()
                val _ = require "opaque admission failed after native effects"
                  (!calls=0 andalso Count.thm_count ()=prior)
            in ignore (Exn.release caught) end))
      val _ = test "Retiring callback preserves Primary before root cleanup"
        (fn () =>
          let exception Primary of unit ref
              val token = ref () val calls = ref 0
          in fixture_after limits [] small
            (fn e => fn outcome =>
              let val exact = case outcome of Exn.Exn (Primary actual) =>
                    Portable.pointer_eq (actual,token) | _ => false
                  val _ = G.validate_scope (#graph e) (#scope e)
              in require "opening Primary changed or outlived original Work"
                (exact andalso !calls=1 andalso retired e) end)
            (fn e =>
              let val row = opening e
                    (lambda e (#goal (current e (#validation e))))
                  val child = case G.view (#graph e) (#opened row) of
                      G.AdmittedBinder {frame,...} => frame
                    | _ => raise Fail "fixture lost its admitted body"
                  val prior = Count.thm_count ()
                  val caught = Exn.capture (fn () => transport e [row]
                    (fn _ => (calls := !calls+1;
                      G.close_scope (#graph e) child;raise Primary token))) ()
                  val _ = require "callback ran after native proof effects"
                    (Count.thm_count ()=prior)
              in ignore (Exn.release caught) end) end)
      val _ = test "Unused ordinal DATA leaves duplicate admission intact"
        (fn () => fixture [] boolSyntax.T (fn e =>
          let
            val work = #work e
            val (chosen,repeated,other,after) = W.with_step work (fn () =>
              let
                val high = case Int.maxInt of SOME maximum => maximum
                  | NONE => 17
                fun issue index =
                  let val token = W.reserve_policy work
                        {role=W.FinalFreeze,ordinal=index,amount=1}
                  in W.consume_policy work token 1 end
                val _ = issue high
                val chosen = W.unused_policy_ordinal work
                  {role=W.FinalFreeze,minimum=0}
                val repeated = W.unused_policy_ordinal work
                  {role=W.FinalFreeze,minimum=0}
                val _ = issue chosen
                val other = W.unused_policy_ordinal work
                  {role=W.ClosedRecord,minimum=0}
                val after = W.unused_policy_ordinal work
                  {role=W.FinalFreeze,minimum=0}
                val _ = require "overflow skipped an actual available gap"
                  (chosen=(case Int.maxInt of SOME _ => 0 | NONE => 18))
              in (chosen,repeated,other,after) end)
            val denied = failure (fn () => W.with_step work (fn () =>
              ignore (W.reserve_policy work
                {role=W.FinalFreeze,ordinal=chosen,amount=1})))
          in require "unused ordinal query reserved credit or reset names"
            (chosen=repeated andalso other=0 andalso after<>chosen andalso
             denied=SOME "future role already issued" andalso retired e)
          end))
    in () end)
end


local
  structure G = SmtReplayGraph
  structure S = SmtReplaySource
  structure W = SmtReplayInvocationWork
  structure P = SmtReplayProof
  structure V = SmtLib_GraphSourcePortfolio
  structure GP = SmtLib_GraphPreprocess
  structure Scope = SmtReplayOwnedScopeReceipt
  structure A = SmtReplayFocusAdmission
  structure Lambda = SmtReplayOwnedLambda
  structure Law = SmtLib_GraphConditionalLambdaLaw
  structure NC = SmtReplayNativeContract
  structure RP = SmtReplayResourcePolicy
  type env = {graph:G.graph,scope:G.scope,sources:S.sources,work:W.portfolio,
    frame:Scope.receipt,body_frame:Scope.receipt,body_scope:G.scope,
    contract:NC.contract,condition:G.node,
    conversion:Lambda.conditional_policy_conversion}
  val finite = ``FINITE (conditional_record_set:num -> bool)``
  val x = Term.mk_var ("conditional_record_x",Type.bool)
  val limits:NC.limits =
    {semantic_limits={input_limit=1000000,output_limit=1000000,
       template_limit=1000000},import_limit=512,type_work_limit=100000000}
  fun require message yes = if yes then () else raise Fail message
  fun test label action =
    ((Count.counting_thms true;testutils.tprint label;action ();
      Count.counting_thms false;testutils.OK ())
     handle primary => (Count.counting_thms false;raise primary))
  fun fixture_after local_condition native observe action =
    let
      val graph = G.new () val scope = G.root_scope graph
      val body = boolSyntax.mk_cond (finite,x,boolSyntax.mk_neg x)
      val abstraction = Term.mk_abs (x,body)
      val goal = boolSyntax.mk_eq (abstraction,abstraction)
      val _ = require "conditional record fixture exceeded oracle bound"
        (Option.isSome (SmtReplayImport.bounded_raw_size 128 goal))
      val sources = S.new_with_policy graph scope RP.Uncapped
        {assumptions=[finite],goal=goal}
      val opened = G.record_opened_view_with_policy graph scope
        (RP.AtMost 10000) (#node (S.goal_source sources))
      val work = W.begin_with_policy graph scope sources
        {limits={input_limit=RP.Uncapped,output_limit=RP.Uncapped,
           template_limit=RP.Uncapped},work_limit=RP.AtMost 1000000000}
      fun run () =
        let
          val contract = NC.capture work native
          val frame = Scope.root_with_policy work
          val expected = {graph=graph,scope=scope,sources=sources,work=work}
          val goal = A.initial_goal_with_policy work {view=SOME opened}
          val (partial,_) = A.application_children_with_policy expected goal
          val (_,admission) =
            A.application_children_with_policy expected partial
          val descriptor = A.describe_with_policy_for expected admission
          val closure = G.closure_child_binder graph scope (#child descriptor)
          val captured = G.binder_closure_data graph scope closure
          val body_scope = #body_frame captured
          val body_frame =
            Scope.body_with_policy work frame (#child descriptor)
          fun arguments current inputs = case G.view graph current of
              G.Application (head,argument) =>
                arguments head (argument::inputs)
            | _ => inputs
          val condition = if local_condition then
              (case arguments (#body captured) [] of
                 [condition,_,_] => condition
               | _ => raise Fail "conditional fixture lost its body")
            else hd (S.assumption_nodes sources)
          val antecedent = G.representative graph condition
          val original = G.representative graph (#body captured)
          (* Bounded TEST oracle only; production385 accepts no raw theorem.
             DISCH produces a real clean closed conditional body proof. *)
          val _ = require "conditional body oracle exceeded native bound"
            (Option.isSome (SmtReplayImport.bounded_raw_size 128 original))
          val reduced = simpLib.SIMP_CONV boolSimps.bool_ss
            [Thm.ASSUME antecedent] original
          val (left,right) = boolSyntax.dest_eq (Thm.concl reduced)
          val equality = Thm.TRANS (Thm.ALPHA original left)
            (Thm.TRANS reduced
              (Thm.ALPHA right (G.representative graph (#binder captured))))
          val equation = G.application graph body_scope
            (G.application graph body_scope
              (G.constant graph body_scope
                (Term.rator (Term.rator (Thm.concl equality))),
               #body captured),#binder captured)
          val statement = G.application graph body_scope
            (G.application graph body_scope
              (G.constant graph body_scope boolSyntax.implication,condition),
             equation)
          val theorem = Thm.DISCH antecedent equality
          val canonical = Thm.EQ_MP
            (Thm.ALPHA (Thm.concl theorem)
              (G.representative graph statement)) theorem
          val fact = P.record_closed_with_policy graph body_scope
            {node=statement,theorem=canonical,template_limit=RP.Uncapped,
             check_type=fn _ => ()}
          val converted = Lambda.execute_conditional_with_policy
            (Lambda.prepare_conditional_admitted_with_policy
              {graph=graph,scope=scope,sources=sources,work=work,ordinal=0,
               admission=admission,body_fact=fact,native_contract=contract,
               profiles=[],check_type=fn _ => ()})
          val e:env = {graph=graph,scope=scope,sources=sources,work=work,
            frame=frame,body_frame=body_frame,body_scope=body_scope,
            contract=contract,condition=condition,conversion=converted}
        in observe e (Exn.capture action e) end
      val outcome = Exn.capture run ()
      val cleanup = Exn.capture (fn () =>
        (W.close work;G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res value => (Exn.release cleanup;value) end
  fun fixture action =
    fixture_after false limits (fn _ => Exn.release) action
  fun record (e:env) ordinal callback =
    SmtLib_GraphConditionalLambdaLaw.record_with_policy (#work e)
      {frame= #frame e,native_contract= #contract e,
       conversion= #conversion e,profiles=[],ordinal=ordinal,
       check_type=callback}
  fun failure action = (ignore (action ());NONE)
    handle Feedback.HOL_ERR detail => SOME (Feedback.message_of detail)
  fun retired (e:env) = #retired (W.audit_policy (#work e))
  fun realize (e:env) fact =
    let
      val work = #work e
      val (validation,target) = W.with_step work (fn () =>
        let
          val originals = V.originals_with_policy work
          val law = V.scoped_recorded_closed_with_policy work (#frame e) fact
          val target = case G.view (#graph e) (V.endpoint law) of
              G.Application (_,equality) => equality
            | _ => raise Fail "conditional law lost its conclusion"
          val asserted = V.apply_with_policy work
            {law=law,premises= #assumptions originals,target=target}
          val validation = V.validate_portfolio_with_policy work
            {assumptions=[asserted],
             goal= #node (S.goal_source (#sources e)),
             denied= #denied originals}
        in (validation,target) end)
      val preprocessing = GP.from_portfolio_with_policy work validation
      val frontier = GP.prepare_final_frontier_with_policy work
        preprocessing {roots=[]}
      val tables = W.with_step work (fn () =>
        P.prepare_owned_realization_tables_with_policy work frontier)
      val freeze = W.with_step work (fn () =>
        P.prepare_native_realization_freeze_with_policy work
          {tables=tables,contract= #contract e,profiles=[],ordinal=2,
           check_type=fn _ => ()})
      val block = W.with_step work (fn () =>
        P.freeze_owned_realization_tables_with_policy work freeze)
      val edge = case GP.assembler_with_policy work preprocessing block target
          of SOME edge => edge | NONE => raise Fail "lambda law not assembled"
    in W.with_step work (fn () =>
      P.policy_source_realization_theorem_for work
        (P.execute_realization_with_policy work
          (P.prepare_realization_with_policy work block target edge))) end
in
  val _ = run_postlude 385 "recorded-authentic-conditional-lambda-law-8"
    (fn () =>
    let
      val _ = test "Authentic lambda receipt records a parent-visible law"
        (fn () => fixture (fn e =>
          let
            val fact = record e 1 (fn _ => ())
            val theorem = P.closed_original fact
            val (condition,_) = boolSyntax.dest_imp (Thm.concl theorem)
            val proof = realize e fact
            val old_goal = G.representative (#graph e)
              (#node (S.goal_source (#sources e)))
          in require "recorded law changed its condition or Source authority"
            (null (Thm.hyp theorem) andalso Term.aconv condition finite andalso
             Portable.pointer_eq (condition,
               G.representative (#graph e) (#condition e)) andalso
             List.exists (fn hyp => Term.aconv hyp finite) (Thm.hyp proof)
             andalso not (List.exists (fn hyp => Term.aconv hyp old_goal)
               (Thm.hyp proof)) andalso not (retired e)) end))
      val _ = test "Fresh recording retains the endpoint and duplicate fence"
        (fn () => fixture (fn e =>
          let val first = record e 1 (fn _ => ())
              val second = record e 2 (fn _ => ())
              val _ = P.validate_closed_fact_in_scope_with_policy_for (#work e)
                {frame= #frame e,fact=first}
              val _ = P.validate_closed_fact_in_scope_with_policy_for (#work e)
                {frame= #frame e,fact=second}
              val exact = P.closed_node first=P.closed_node second andalso
                Term.aconv (Thm.concl (P.closed_original first))
                  (Thm.concl (P.closed_original second))
              val read_only = W.with_step (#work e) (fn () =>
                let val first = W.unused_policy_ordinal (#work e)
                      {role=W.ClosedRecord,minimum=1}
                    val second = W.unused_policy_ordinal (#work e)
                      {role=W.ClosedRecord,minimum=1}
                in first=3 andalso second=first end)
              val duplicate = failure (fn () => W.with_step (#work e) (fn () =>
                W.reserve_policy (#work e)
                  {role=W.ClosedRecord,ordinal=1,amount=1}))
          in require "fresh DATA mutated the ledger or bypassed duplicate use"
            (exact andalso read_only andalso
             duplicate=SOME "future role already issued" andalso retired e)
