            val operator=rule work b(P.ReflexiveName(#conjunction env))[]
            val atom=rule work b(P.ReflexiveName(#truth env))[]
            fun depth 0 edge=edge
              | depth n edge=
                  let val partial=rule work b P.Congruence[operator,edge]
                      val both=rule work b P.Congruence[partial,edge]
                  in depth(n-1)both end
            val huge=depth 6 atom
            val compact=Thm.concl(theorem work b huge)
            val measured=profile work b compact
            val _=ignore(profile work b compact)
            val count=Count.thm_count ()
            val denied=refuses(fn()=>W.with_step work(fn()=>
              ignore(P.prepare_primitive_with_policy work b
                P.Congruence[operator,huge])))
          in require "warm syntax bypassed actual513 raw template refusal"
            (#raw measured=509 andalso denied andalso
             Count.thm_count ()=count andalso
             #retired(W.audit_policy work))end)
    in ()end)
end;


