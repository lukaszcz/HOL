  type env = {graph:G.graph,scope:G.scope,sources:S.sources,work:W.portfolio,
    query:GP.graph_query,metadata:MD.metadata,contract:NC.contract,
    profiles:G.policy_opaque_profile list}
  val cap = RP.AtMost 1000000000
  val native:NC.limits =
    {semantic_limits={input_limit=1000000,output_limit=1000000,
       template_limit=1000000},import_limit=1000000,
     type_work_limit=100000000}
  fun require message yes = if yes then () else raise Fail message
  fun test label action =
    ((Count.counting_thms true;testutils.tprint label;action ();
      Count.counting_thms false;testutils.OK ())
     handle primary=>(Count.counting_thms false;raise primary))
  fun refused action = (action ();false)
    handle Feedback.HOL_ERR _ => true
  fun fixture_with retain assumptions goal action =
    let
      val graph=G.new () val scope=G.root_scope graph
      val sources=S.new graph scope 10000
        {assumptions=assumptions,goal=goal}
      val work=W.begin_with_policy graph scope sources
        {limits={input_limit=cap,output_limit=cap,template_limit=cap},
         work_limit=cap}
      fun run () =
        let
          val contract=NC.capture work native
          (* A genuine prior discovery records the fixed original binder.
             These measured profiles do not admit the later SPEC programme. *)
          val marker=Term.mk_var("specialize408_trigger",Type.bool)
          val trigger=Term.mk_comb(Term.mk_abs(marker,marker),boolSyntax.T)
          (* Scan the original lambda outside its quantifier. A Nat
             quantifier would otherwise force opening instead of retention. *)
          val abstraction=Term.rand(hd assumptions)
          val wrapped=boolSyntax.mk_conj(trigger,
            boolSyntax.mk_eq(abstraction,abstraction))
          val imported=G.import_with_policy graph scope(RP.AtMost 128)wrapped
          val discovered=W.with_step work(fn()=>
            G.discover_partial_with_policy graph scope
              {original= #node imported,maximum=RP.AtMost 128,
               scan_limit=RP.AtMost 100000,
               step=fn()=>W.spend_policy work 1})
          val profiles=G.partial_profiles_with_policy graph scope discovered
          val original_binder=case G.view graph
              (hd(S.assumption_nodes sources))of
              G.Application(_,operand)=>operand
            | _=>raise Fail "fixed universal lost its original lambda"
          val _=require "fixed original universal has no genuine profile"
            (List.exists(fn profile=>
              #node(G.opaque_profile_data_with_policy graph scope profile)=
                original_binder)profiles)
          val {assumptions,denied}=V.originals_with_policy work
          val validation=V.validate_portfolio_with_policy work
            {assumptions=if retain then assumptions else [],
             goal= #node (S.goal_source sources),
             denied=denied}
          val query=GP.prepare_query_with_policy work
            (GP.from_portfolio_with_policy work validation)
          fun open_view caller node=ignore
            (G.record_opened_view_with_policy graph caller
              (RP.AtMost 10000) node)
          val metadata=T.with_outbound_query_analysis_with_policy work query
            open_view (fn context=>SmtLib.outbound_with_backend_context
              {sequence_emission=false,set_backend=SmtLib.Z3Set,
               bag_backend=SmtLib.Z3ArrayBag,
               has_set_terms=false,has_bag_terms=false} (fn backend=>
              let
                val operations=
                  SmtLib_GraphCarrierOperations.make_with_datatypes context
                    {sequence_emission=false}
                    {term_to_string=fn _=>raise Fail "unexpected formatter"}
                val emission=SmtLib_GraphDispatcher.emit context
                  {operations=operations,regime=SmtLib.FirstOrder,
                   apply_operator=SmtLib.ApplyUnderscore,prefix="value406_",
                   roots=ListPair.zip
                     (List.tabulate (length (#assumptions context)+2,Lib.I),
                      #goal context :: #assumptions context @
                        [#denied context])}
              in SmtLib_GraphDeclarationMetadata.freeze context
                {graph=graph,scope=scope,regime=SmtLib.FirstOrder,
                 backend=backend,operations=operations,emission=emission}
              end))
        in action ({graph=graph,scope=scope,sources=sources,work=work,
          query=query,metadata=metadata,contract=contract,
          profiles=profiles}:env) end
      val outcome=Exn.capture run ()
      val cleanup=Exn.capture (fn()=>
        (W.close work;G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary=>raise primary
      | Exn.Res result=>(Exn.release cleanup;result) end
  fun options (e:env):F.value_options =
    {graph= #graph e,scope= #scope e,logic="ALL",
     sources=[("U",hd(#1(S.original_goal(#sources e))))],
     sorts=Redblackmap.mkDict String.compare,binder_lists=[],
     import_limit=cap,literal_limit=cap,binder_limit=RP.AtMost 1,
     recipe_limits={template_limit=cap,index_limit=cap,
       operand_limit=cap,token_limit=cap},
     special=fn _=>fn _=>NONE,ascribed=fn _=>fn _=>fn _=>NONE}
  fun input text =
    let val index=ref 0 in fn()=>
      if !index=String.size text then NONE else
        let val result=String.sub (text,!index)
        in index:= !index+1;SOME result end end
  fun packet (e:env) text =
    Z3_GraphValueProofParser.create_packet_with_policy_from_input
      (#work e) (#query e) (options e) (#metadata e) "4.15.3" (input text)
  fun rule (proof:ZV.proof) id =
    case Redblackmap.find (#steps proof,id) of Z.Rule value=>value
      | _=>raise Fail "expected actual parsed Rule"
  fun fixture assumptions goal=fixture_with true assumptions goal
  (* Only two fixed small original test terms are imported. No native
     term is recovered from a large query, Value closure or parser body. *)
  fun graph_assertions (e:env) (data:ZV.proof VP.contents) =
    W.with_step(#work e)(fn()=>
      let val context= #context data
          val original=hd(#1(S.original_goal(#sources e)))
          val source=PV.import context(#scope e)(RP.AtMost 16)original
          val denial=PV.import context(#scope e)(RP.AtMost 16)
            (boolSyntax.mk_neg boolSyntax.F)
      in [source,denial]end)
  fun using (e:env) text callback action =
    let
      val held=packet e text
      val saved=ref(NONE:Final.invocation option)
      val outcome=Exn.capture(fn()=>
        let
          val data=W.with_step (#work e) (fn()=>
            VP.contents_with_policy_for (#work e) (#query e) held)
          val assertions=graph_assertions e data
          val prepared=Final.prepare_with_specialization_with_policy
            (#work e) (#query e) held
            {assertions=assertions,native_contract= #contract e,
             profiles= #profiles e,check_type=callback}
          val _=case prepared of Final.Prepared owner=>saved:=SOME owner
            | _=>()
        in action held data prepared end) ()
      val cleanup=Exn.capture(fn()=>case !saved of
          SOME owner=>Final.close owner | NONE=>VP.close held) ()
    in case outcome of Exn.Exn primary=>raise primary
      | Exn.Res result=>(Exn.release cleanup;result)end
  fun ready (Final.Prepared owner)=owner
    | ready (Final.ReplayNeeds _)=raise Fail "unexpected replay programme"
  fun proved (Final.Proved result)=result
    | proved (Final.RealizationNeeds _)=
        raise Fail "unexpected original Source realization programme"
  fun canonical_hyp (e:env) theorem =
    let val allowed=S.assumption_nodes (#sources e)
    in List.all(fn term=>List.exists(fn node=>Portable.pointer_eq
      (term,G.representative (#graph e) node))allowed)(Thm.hyp theorem)end
  fun checked (e:env) theorem =
    (S.check_goal (#sources e) theorem;
     require "finalizer did not retain exact original Goal/canonical Hyp"
       (Portable.pointer_eq(Thm.concl theorem,
          #2(S.original_goal (#sources e)))andalso canonical_hyp e theorem
        andalso null(Tag.axioms_of(Thm.tag theorem))))
  val variable=Term.mk_var("specialize408_original",Type.bool)
  val universal=boolSyntax.mk_forall(variable,variable)
  val quant_text="((proof (unit-resolution " ^
    "((_ quant-inst false) (or (not U) false)) (asserted U) false)))"
  fun owned action=fixture [universal] boolSyntax.F action
  fun parsed e action=
    let val held=packet e quant_text
        val outcome=Exn.capture(fn()=>
          let val data=W.with_step(#work e)(fn()=>
                VP.contents_with_policy_for(#work e)(#query e)held)
              val context= #context data
              val (source,argument,target)=W.with_step(#work e)(fn()=>
                let val source=PV.import context(#scope e)(RP.AtMost 16)
                      (hd(#1(S.original_goal(#sources e))))
                    val argument=PV.literal context(#scope e)(RP.AtMost 1)
                      boolSyntax.F
                    val _=require "atomic F lost actual retained backing"
                      (Option.isSome(PV.proof_graph_reference context
                        (PV.proof_term context argument)))
                in (source,argument,argument)end)
          in action held data source argument target end)()
        val cleanup=Exn.capture VP.close held
    in case outcome of Exn.Exn primary=>raise primary
      | Exn.Res result=>(Exn.release cleanup;result)end
  fun prepare_lower (e:env) held source argument target profiles callback=
    Specialize.prepare(#work e)(#query e)held
      {source=source,arguments=[argument],target=target,
       profiles=profiles,native_contract= #contract e,check_type=callback}
  fun lower_ready(Specialize.Prepared plan)=plan
    | lower_ready(Specialize.Needs _)=raise Fail "fixed SPEC needs programme"
  fun lower_data (e:env) receipt=W.with_step(#work e)(fn()=>
    Specialize.data_for(#work e)receipt)
in
  val _=run_postlude 408 "owned-value-quantifier-specialization-10"(fn()=>
    let
      val _=test "Parsed quant-inst and resolution force the only Source U"
        (fn()=>owned(fn e=>let val before_prepare=Count.thm_count()
          in using e quant_text(fn _=>())
          (fn _=>fn _=>fn prepared=>
            let val owner=ready prepared
                val before_finish=Count.thm_count()
                val result=proved(Final.finish_with_policy(#work e)owner)
                val _=checked e(#theorem result)
            in require "quant-inst did not close exact Goal through U"
              (Term.same_const(Thm.concl(#theorem result))boolSyntax.F andalso
               length(Thm.hyp(#theorem result))=1 andalso
               #dependencies result=[P.Current 0]andalso
               #SPEC before_finish= #SPEC before_prepare+1)end)end))
      val _=test "Preparation is metadata; the authentic SPEC executes once"
        (fn()=>owned(fn e=>parsed e(fn held=>fn _=>fn source=>
          fn argument=>fn target=>
            let val prior=Count.thm_count()
                val plan=lower_ready(prepare_lower e held source argument
                  target(#profiles e)(fn _=>()))
                val prepared=Count.thm_count()
                val receipt=Specialize.execute(#work e)plan
                val data=lower_data e receipt
                val first=Count.thm_count()
                val _=lower_data e receipt
                val _=lower_data e receipt
                val witness=W.with_step(#work e)(fn()=>
                  SmtReplayProof.closed_original(#fact data))
                val expected=boolSyntax.mk_imp(universal,boolSyntax.F)
            in require "closed SPEC witness lost admission or stable lifetime"
              (prepared=prior andalso #SPEC first= #SPEC prior+1 andalso
               Count.thm_count()=first andalso null(Thm.hyp witness)andalso
               Term.aconv(Thm.concl witness)expected andalso
               #original_occurrences data=[0])end)))
      val _=test "Missing original profile remains Needs without native prefix"
        (fn()=>owned(fn e=>parsed e(fn held=>fn _=>fn source=>
          fn argument=>fn target=>
            let val prior=Count.thm_count()
                val prepared=prepare_lower e held source argument target[]
                  (fn _=>raise Fail "missing profile reached callback")
                val needed=case prepared of Specialize.Needs rows=>
                  List.exists(fn Specialize.SourceProfile _=>true
                    |_=>false)rows|_=>false
            in require "missing profile admitted or retired metadata Work"
              (needed andalso Count.thm_count()=prior andalso
               not(#retired(W.audit_policy(#work e))))end)))
      val _=test "A non-original retained atom cannot become a universal law"
        (fn()=>owned(fn e=>parsed e(fn held=>fn data=>fn _=>
          fn argument=>fn target=>
            let val source=W.with_step(#work e)(fn()=>PV.literal
                  (#context data)(#scope e)(RP.AtMost 1)boolSyntax.T)
                val prior=Count.thm_count()
