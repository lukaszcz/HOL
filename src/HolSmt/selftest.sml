  type env={graph:G.graph,scope:G.scope,work:W.portfolio,
    contract:NC.contract,sources:S.sources,truth:G.node,
    fact:P.closed_fact,block:P.policy_sparse_block,closed:bool ref}
  val limits={input_limit=RP.Uncapped,output_limit=RP.Uncapped,
    template_limit=RP.Uncapped}
  fun require message yes=if yes then ()else raise Fail message
  fun test label action=
    ((Count.counting_thms true;testutils.tprint label;action();
      Count.counting_thms false;testutils.OK())
     handle primary=>(Count.counting_thms false;raise primary))
  fun message action=(ignore(action());NONE)
    handle Feedback.HOL_ERR detail=>SOME(Feedback.message_of detail)
  fun native work=NC.capture work
    {semantic_limits={input_limit=512,output_limit=512,template_limit=512},
     import_limit=1000000,type_work_limit=1000000}
  fun prepare work contract facts callback=
    let val frontier=P.prepare_original_realization_frontier_with_policy
          work{roots=[],closed_facts=facts,conversions=[]}
        val tables=W.with_step work(fn()=>
          P.prepare_owned_realization_tables_with_policy work frontier)
    in W.with_step work(fn()=>P.prepare_policy_sparse_freeze work
      {tables=tables,contract=contract,check_type=callback})end
  fun fixture action=
    let
      val graph=G.new()val scope=G.root_scope graph
      val sources=S.new_with_policy graph scope RP.Uncapped
        {assumptions=[boolSyntax.T,boolSyntax.T],
         goal=Term.mk_var("sparse_source_goal",Type.bool)}
      val work=W.begin_with_policy graph scope sources
        {limits=limits,work_limit=RP.AtMost 100000000}
      val contract=native work
      val truth=hd(S.assumption_nodes sources)
      val canonical=G.representative graph truth
      val proof=Thm.EQ_MP(Thm.ALPHA(Thm.concl boolTheory.TRUTH)canonical)
        boolTheory.TRUTH
      val fact=P.record_closed_with_policy graph scope
        {node=truth,theorem=proof,template_limit=RP.Uncapped,
         check_type=fn _=>()}
      val freeze=prepare work contract[fact](fn _=>())
      val block=W.with_step work(fn()=>
        P.execute_policy_sparse_freeze work freeze)
      val closed=ref false
      val e:env={graph=graph,scope=scope,work=work,contract=contract,
        sources=sources,truth=truth,fact=fact,block=block,closed=closed}
      val result=Exn.capture action e
      val cleanup=Exn.capture(fn()=>
        (W.close work;if !closed then ()else G.close_scope graph scope))()
    in case result of Exn.Exn primary=>raise primary
      | Exn.Res answer=>(Exn.release cleanup;answer)end
  fun inside(e:env)action=W.with_step(#work e)action
  fun original(e:env)index=inside e(fn()=>
    P.policy_sparse_source_for(#work e)(#block e)index)
  fun closed(e:env)=inside e(fn()=>
    P.policy_sparse_closed_for(#work e)(#block e)(#fact e))
  fun plan(e:env)edge=inside e(fn()=>
    P.prepare_policy_sparse_realization(#work e)(#block e)
      {target= #truth e,edge=edge})
  fun execute(e:env)saved=inside e(fn()=>
    P.execute_policy_sparse_realization(#work e)saved)
  fun data(e:env)saved=inside e(fn()=>
    P.policy_sparse_result_for(#work e)saved)
  fun live(e:env)=not(#retired(W.audit_policy(#work e)))
  fun clean proof=null(Tag.axioms_of(Thm.tag proof))andalso
    List.all(fn oracle=>oracle="DISK_THM")
      (#1(Tag.dest_tag(Thm.tag proof)))
  fun exact(e:env)proof=Portable.pointer_eq(Thm.concl proof,
    G.representative(#graph e)(#truth e))andalso clean proof
