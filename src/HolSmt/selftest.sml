        | M.Constant term => term
        | M.FreeVariable {lexical,...} => lexical
        | M.BoundSlot slot =>
            (case List.find (fn (held,_) => held=slot) environment of
               SOME (_,term) => term | NONE => raise Fail "unbound slot")
        | M.Application (left,right) =>
            Term.mk_comb (walk environment left,walk environment right)
        | M.Abstraction {slot,lexical,body} =>
            Term.mk_abs (lexical,walk ((slot,lexical)::environment) body)
        end
    in walk [] root end
