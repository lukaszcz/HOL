                (calls := !calls+1;if !calls=1024 then
                  (G.close_scope (#graph e) (#frame e);raise Primary token)
                 else ()));false)
                handle Primary actual => Portable.pointer_eq (actual,token)
              val _ = G.validate_scope (#graph e) (#scope e)
