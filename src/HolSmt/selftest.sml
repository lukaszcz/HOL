(* Supplier proof parsing requires a complete suffix before publishing. *)
local
  structure P = SmtLib_Parser
  structure Z = Z3_GraphProofParser
  structure G = SmtReplayGraph
  structure F = SmtLib_GraphFrontend
  structure Q = SmtLib_GraphProof
  structure RP = SmtReplayResourcePolicy
  fun require text yes = if yes then () else raise Fail text
  fun test label action =
    (testutils.tprint label; action (); testutils.OK ())
  fun supplier text =
    let val index = ref 0 val eof = ref 0
        fun input () =
          if !index = String.size text then (eof := !eof + 1; NONE)
          else let val c = String.sub (text, !index)
               in index := !index + 1; SOME c end
    in (input, index, eof) end
  fun owned action =
    let val graph = G.new () val scope = G.root_scope graph
        val cap = RP.AtMost 64
        val options : F.policy_options =
          {graph = graph, scope = scope, logic = "ALL", sources = [],
           sorts = Redblackmap.mkDict String.compare, binder_lists = [],
           import_limit = cap, literal_limit = cap, binder_limit = cap,
           recipe_limits = {template_limit = cap, index_limit = cap,
             operand_limit = cap, token_limit = cap},
           special = fn _ => fn _ => NONE,
           ascribed = fn _ => fn _ => fn _ => NONE}
        val result = Exn.capture (fn () => action (graph, options)) ()
        val cleanup = Exn.capture (fn () => G.close_scope graph scope) ()
    in case result of Exn.Exn primary => raise primary
      | Exn.Res answer => (Exn.release cleanup; answer) end
  fun packet held action =
    let val result = Exn.capture (fn () => action held) ()
        val cleanup = Exn.capture (fn () => Q.close held) ()
    in case result of Exn.Exn primary => raise primary
      | Exn.Res answer => (Exn.release cleanup; answer) end
  fun hol_error action =
    (ignore (action ()); NONE)
    handle Feedback.HOL_ERR detail => SOME (Feedback.message_of detail)
  val complete = "((proof (asserted false)))"
in
  val _ = run_postlude 336 "supplier-z3-proof-readers-5" (fn () =>
    let
      val _ = test "Generic supplier keeps stream quoted-token grammar"
        (fn () =>
          let val text = "(|with space| |slash\\name| \"x\"\"y\")"
              val (input, _, eof) = supplier text
              val next = P.make_proof_input_tokenizer input
              val stream = TextIO.openString text
              val old = P.make_proof_stream_tokenizer stream
              fun take 0 tokens = []
                | take n tokens = tokens () :: take (n - 1) tokens
              val fresh = take 5 next
              val legacy = Exn.capture (take 5) old
              val _ = TextIO.closeIn stream
              val ended = (next (); false) handle P.ProofEOF => true
              val again = (next (); false) handle P.ProofEOF => true
          in require "generic supplier changed grammar or repeated EOF I/O"
            (fresh = Exn.release legacy andalso
             List.nth (fresh, 1) = "with space" andalso
             List.nth (fresh, 2) = "slash\\name" andalso
             P.proof_quoted_symbol_token (List.nth (fresh, 1)) = NONE
             andalso P.proof_string_token (List.nth (fresh, 3)) =
               SOME "x\"y" andalso ended andalso again andalso !eof = 1)
          end)
      val _ = test "Supplier packet consumes complete proof and comment EOF"
        (fn () => owned (fn (graph, options) =>
          List.app (fn suffix =>
            let val text = complete ^ suffix
                val (input, index, eof) = supplier text
                val held = Z.create_packet_with_policy_from_input
                  options "4.15.3" input
            in packet held (fn actual =>
              let val proof = Q.proof actual
                  val node = case Redblackmap.find
                      (#steps proof, #root proof) of
                      Z.Rule {conclusion, ...} => #node conclusion
                    | _ => raise Fail "asserted proof root changed"
              in require "supplier packet escaped before genuine suffix EOF"
                (!index = String.size text andalso !eof = 1 andalso
                 Term.aconv (G.representative graph node) boolSyntax.F)
              end) end) ["", " \n\t; trailing comment", ";comment\n "]))
      val _ = test "Supplier packet rejects junk and malformed trailing token"
        (fn () => owned (fn (_, options) =>
          List.app (fn suffix =>
            let val (input, _, _) = supplier (complete ^ suffix)
                val no = hol_error (fn () => packet
                  (Z.create_packet_with_policy_from_input
                    options "4.15.3" input) (fn _ => ()))
            in require "trailing proof syntax was published"
              (Option.isSome no) end)
            [" junk", " ()", " |unterminated", " \"unterminated"]))
      val _ = test "Supplier truncation and forged EOF cannot publish packet"
        (fn () => owned (fn (_, options) =>
          let val (input, _, _) = supplier
                (String.substring (complete, 0, String.size complete - 1))
              val truncated =
                (ignore (Z.create_packet_with_policy_from_input
                  options "4.15.3" input); false)
                handle P.ProofEOF => true
              val forged = hol_error (fn () =>
                Z.create_packet_with_policy_from_input options "4.15.3"
                  (fn () => raise P.ProofEOF))
          in require "truncation or supplier exception forged completion"
            (truncated andalso forged = SOME "supplier raised parser EOF")
          end))
      val _ = test "Supplier translation forwarder preserves legacy prefix API"
        (fn () => owned (fn (_, options) =>
          let val (translation, _) = SmtLib.goal_to_SmtLib_translation
                (SOME "ALL") ([], boolSyntax.F)
              val text = complete ^ " ;supplier suffix"
              val (input, index, eof) = supplier text
              open Z3_ProofParser
              val held =
      parse_graph_translation_packet_with_version_with_policy_from_input
                  options translation "4.15.3" input
              val _ = packet held (fn _ => require
                "translation forwarder skipped supplier completion"
                (!index = String.size text andalso !eof = 1))
              val stream = TextIO.openString (complete ^ " trailing")
              val old = Exn.capture (fn () => packet
                (Z.create_packet_with_policy options "4.15.3" stream)
                (fn _ => ())) ()
              val _ = TextIO.closeIn stream
          in Exn.release old end))
