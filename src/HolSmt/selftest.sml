  fun setup shape native : fixture =
    let
      val graph = G.new () val scope = G.root_scope graph
      val x = Term.mk_var ("conditional_lambda_x",Type.bool)
      val y = Term.mk_var ("conditional_lambda_y",Type.bool)
      val finite = ``FINITE (conditional_lambda_set:num -> bool)``
      val condition = case shape of Finite => finite
        | BoundCondition => x | LexicalCollision => x
        | LongCondition =>
          List.foldl (fn (_,tail) => boolSyntax.mk_conj (finite,tail))
            finite (List.tabulate (30,fn n => n))
      val beta = Term.mk_comb (Term.mk_abs (y,y),x)
      val body = case shape of Finite =>
            boolSyntax.mk_cond (condition,x,boolSyntax.mk_neg x)
        | _ => beta
      val abstraction = Term.mk_abs (x,body)
      val sources = S.new_with_policy graph scope RP.Uncapped
        {assumptions=[condition],
         goal=boolSyntax.mk_eq (abstraction,abstraction)}
      val view = G.record_opened_view_with_policy graph scope
        (RP.AtMost 10000) (#node (S.goal_source sources))
      val work = W.begin_with_policy graph scope sources
        {limits={input_limit=RP.Uncapped,output_limit=RP.Uncapped,
           template_limit=RP.Uncapped},work_limit=RP.AtMost 100000000}
      val contract = NC.capture work native
      val expected = {graph=graph,scope=scope,sources=sources,work=work}
      val goal = A.initial_goal_with_policy work {view=SOME view}
      val (partial,_) = A.application_children_with_policy expected goal
      val (_,admission) = A.application_children_with_policy expected partial
      val data = A.describe_with_policy_for expected admission
      val closure = G.closure_child_binder graph scope (#child data)
      val captured = G.binder_closure_data graph scope closure
      val frame = #body_frame captured
      val body = #body captured val binder = #binder captured
      val condition = case shape of BoundCondition => binder
        | _ => #node (G.import_with_policy graph scope (RP.AtMost 10000)
            condition)
      val antecedent = G.representative graph condition
      val original = G.representative graph body
      val raw = case shape of Finite =>
            simpLib.SIMP_CONV boolSimps.bool_ss
              [Thm.ASSUME antecedent] original
        | _ => Thm.BETA_CONV original
      val (left,right) = boolSyntax.dest_eq (Thm.concl raw)
      val equality = Thm.TRANS (Thm.ALPHA original left)
        (Thm.TRANS raw (Thm.ALPHA right (G.representative graph binder)))
      val head = G.constant graph frame
        (Term.rator (Term.rator (Thm.concl equality)))
      val equation = G.application graph frame
        (G.application graph frame (head,body),binder)
      val implication = G.constant graph frame boolSyntax.implication
      val statement = G.application graph frame
        (G.application graph frame (implication,condition),equation)
      val closed = Thm.DISCH antecedent equality
      val canonical = Thm.EQ_MP
        (Thm.ALPHA (Thm.concl closed)
          (G.representative graph statement)) closed
      val fact = P.record_closed_with_policy graph frame
        {node=statement,theorem=canonical,template_limit=RP.Uncapped,
         check_type=fn _ => ()}
    in {graph=graph,scope=scope,sources=sources,work=work,native=contract,
      admission=admission,fact=fact,condition=condition,
      source= #node captured,binder=binder,frame=frame} end
  fun expected (e:fixture) =
    {graph= #graph e,caller= #scope e,scope= #scope e,
     sources= #sources e,work= #work e}
  fun prepare (e:fixture) callback =
