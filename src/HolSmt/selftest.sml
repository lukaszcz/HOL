  fun direct(e:env)target action=inspecting e(qtext target)(fn held=>
    fn data=>action held data(root_ports e data))
  fun live(e:env)=not(#retired(W.audit_policy(#work e)))
  fun absent(e:env)(data:ZV.proof VP.contents)target=
    W.with_step(#work e)(fn()=>case PV.proof_graph_reference(#context data)
      (PV.proof_term(#context data)target)of NONE=>true|_=>false)
  fun shared_text depth=
    let fun wrap 0 body=body
          | wrap n body=wrap(n-1)
              ("(let ((k" ^ Int.toString n ^ " (and k" ^
                Int.toString(n-1) ^ " k" ^ Int.toString(n-1) ^ "))) " ^
               body ^ ")")
    in "(let ((k0 a)) " ^ wrap depth("k" ^ Int.toString depth) ^ ")"end
