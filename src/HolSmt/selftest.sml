  fun factory (e:env) mapping =
    SmtLib_GraphParserMappingBackend.create (#work e)
      {graph= #graph e,scope= #scope e,mapping=mapping,
       import_limit=RP.AtMost 10000,literal_limit=RP.AtMost 10000,
       binder_limit=RP.AtMost 1}
  fun with_factory (e:env) mapping action =
    let val held = factory e mapping
        val outcome = Exn.capture (fn () => W.with_step (#work e)
          (fn () => action held)) ()
        val cleanup = Exn.capture (#close held) ()
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res answer => (Exn.release cleanup;answer) end
  fun source_mapping e regime = freeze e regime (fn context => fn store =>
    let val (function,_) = (#strip_comb context) (#goal context)
    in insert store (#empty_terms store) ("function",function,1) end)
  fun lambda_mapping e depth = freeze e SmtLib.FirstOrder
    (fn context => fn store =>
      let val bound = (#genvar context) Type.bool
          val conjunction = (#constant context) boolSyntax.conjunction
          fun shared 0 = bound
            | shared n = let val child = shared (n-1) in
                (#mk_comb context)
                  ((#mk_comb context) (conjunction,child),child) end
          val value = (#list_mk_abs context) ([bound],shared depth)
      in insert store (#empty_terms store) ("lambda",value,1) end)
  fun reachable context root =
    let val seen = ref (Redblackset.empty Int.compare)
        fun visit [] = ()
          | visit (current::rest) =
              let val id = PV.key context current in
                if Redblackset.member (!seen,id) then visit rest else
                  let val _ = seen := Redblackset.add (!seen,id)
                      val children = case PV.view context current of
                          PV.Application (left,right) => [left,right]
                        | PV.Abstraction {binder,body,...} => [binder,body]
                        | _ => []
                  in visit (children @ rest) end
              end
    in visit [root];Redblackset.numItems (!seen) end
