  structure W = SmtReplayWrapperSession
  structure D = SmtReplaySourceConsumerSession
  structure Q = SmtLib_GraphProof
  structure F = SmtLib_GraphFrontend
  type fixture =
    {graph : G.graph,scope : G.scope,sources : S.sources,
     validation : GP.validation,session : W.session,original : Abbrev.goal,
     canonical : Term.term list,options : F.options,calls : int ref}
  fun ensure message yes =
    if yes then testutils.OK () else testutils.die message
  fun refuses action = (action ();false) handle Feedback.HOL_ERR _ => true
  fun setup () : fixture =
    let
      val graph = G.new () val scope = G.root_scope graph
      val p = Term.mk_var ("session_original_p",Type.bool)
      val q = Term.mk_var ("session_original_q",Type.bool)
      val goal = boolSyntax.mk_conj (p,boolSyntax.T)
      val original = ([goal,goal],goal)
      val sources = S.new graph scope 10000
        {goal = goal,assumptions = #1 original}
      val hole = Term.mk_var ("session_schema_hole",Type.bool)
      val law = Thm.CONJUNCT1 (Thm.CONJUNCT2
        (Thm.SPEC hole boolTheory.AND_CLAUSES))
      fun conversion node = case G.view graph node of
          G.Application (inner,right) =>
            (case (G.view graph inner,G.view graph right) of
              (G.Application (head,left),G.Constant _) =>
                if Term.same_const (G.representative graph head)
                    boolSyntax.conjunction andalso
                  Term.same_const (G.representative graph right) boolSyntax.T
                then SOME (K.checked_graph_schema graph scope
                  {theorem = law,holes = [hole],operands = [left],
                   template_limit = 10000}) else NONE
            | _ => NONE)
        | _ => NONE
      val validation = GP.discover_from_sources graph scope sources
        {import_limit = 10000,revisit = false,check_type = fn _ => (),
         conversion = conversion}
      val session = D.prepare sources original validation
      val canonical = List.map (G.representative graph)
        (S.assumption_nodes sources)
      val options : F.options =
        {graph = graph,scope = scope,logic = "ALL",sources = [("p",p),("q",q)],
         sorts = Redblackmap.mkDict String.compare,binder_lists = [],
         import_limit = 10000,literal_limit = 10000,binder_limit = 10000,
         recipe_limits = {template_limit = 10000,index_limit = 1024,
           operand_limit = 1024,token_limit = 4096},
         special = fn _ => fn _ => NONE,
         ascribed = fn _ => fn _ => fn _ => NONE}
    in {graph = graph,scope = scope,sources = sources,validation = validation,
        session = session,original = original,canonical = canonical,
        options = options,calls = ref 0} end
  fun with_fixture action =
    let val f = setup ()
        fun cleanup () = (W.close (#session f) handle _ => ())
        val result = action f handle primary => (cleanup ();raise primary)
    in cleanup ();result end
  fun cpc (f : fixture) script action =
    let
      val input = TextIO.openString script
      val packet = CPC_ProofParser.parse_graph_packet_with_version
        (#options f) (SmtLib_Logics.parsedicts_of_logic "ALL") "1.3.4" input
        handle primary => (TextIO.closeIn input;raise primary)
      fun cleanup () =
        ((Q.close packet handle _ => ());
         (TextIO.closeIn input handle _ => ()))
      val result = action (Q.proof packet)
        handle primary => (cleanup ();raise primary)
    in cleanup ();result end
  fun z3 (f : fixture) script action =
    let
      val input = TextIO.openString script
      val packet = Z3_GraphProofParser.create_packet (#options f) "4.15.3"
        input handle primary => (TextIO.closeIn input;raise primary)
      fun cleanup () =
        ((Q.close packet handle _ => ());
         (TextIO.closeIn input handle _ => ()))
      val result = action (Q.proof packet)
        handle primary => (cleanup ();raise primary)
    in cleanup ();result end
  fun cpc_run (f : fixture) session proof =
