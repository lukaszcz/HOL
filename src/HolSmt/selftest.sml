    {semantic_limits={input_limit=1000000,output_limit=1000000,
       template_limit=1000000},import_limit=1000000,
     type_work_limit=100000000}
  fun abstraction condition = Term.mk_abs (x,
    boolSyntax.mk_cond (condition,x,intSyntax.mk_negated x))
  fun require message yes = if yes then () else raise Fail message
  fun test label action =
    ((Count.counting_thms true;testutils.tprint label;action ();
      Count.counting_thms false;testutils.OK ())
     handle primary => (Count.counting_thms false;raise primary))
  fun error action = (ignore (action ());NONE)
    handle Feedback.HOL_ERR detail => SOME (Feedback.message_of detail)
  fun fixture_after assumptions condition observe action =
    let
      val graph = G.new () val scope = G.root_scope graph
      val lambda = abstraction condition
      val sources = S.new_with_policy graph scope RP.Uncapped
        {assumptions=assumptions,goal=boolSyntax.mk_eq (lambda,lambda)}
      val work = W.begin_with_policy graph scope sources
        {limits={input_limit=RP.Uncapped,output_limit=RP.Uncapped,
           template_limit=RP.Uncapped},work_limit=RP.AtMost 1000000000}
      fun run () =
        let
          val contract = NC.capture work limits
          val validation = W.with_step work (fn () =>
            let val {assumptions,denied} = V.originals_with_policy work
            in V.validate_portfolio_with_policy work
              {assumptions=assumptions,
               goal= #node (S.goal_source sources),denied=denied} end)
          val query = GP.prepare_query_with_policy work
            (GP.from_portfolio_with_policy work validation)
          val e:env = {graph=graph,scope=scope,sources=sources,work=work,
            validation=validation,query=query,contract=contract}
        in observe e (Exn.capture action e) end
      val outcome = Exn.capture run ()
      val cleanup = Exn.capture (fn () =>
        (W.close work;G.close_scope graph scope)) ()
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res result => (Exn.release cleanup;result) end
  fun fixture assumptions condition =
    fixture_after assumptions condition (fn _ => Exn.release)
  fun opener (e:env) caller node = ignore
    (G.record_opened_view_with_policy (#graph e) caller
      (RP.AtMost 1000000) node)
  fun prepare (e:env) callback =
    let
      val rows = ref ([]:O.opening list)
      fun open_view caller node =
        let val source = G.record_opened_view_with_policy (#graph e) caller
              (RP.AtMost 1000000) node
        in if caller= #scope e andalso #node source<>node andalso
            not (List.exists (fn row => #original row=node) (!rows)) then
            rows := {scope=caller,original=node,opened= #node source}:: !rows
          else () end
      val prepared:prepared =
        SmtLib_GraphQueryEmission.prepare_finite_body_query (#work e)
          {query= #query e,validation= #validation e,options=options,
           open_opaque=open_view,native_contract= #contract e,ordinal=393,
           check_type=callback}
      val _ = B.with_transported_context_with_policy (#work e)
        (#backend prepared) (#query e) (opener e) (fn (_,backend) =>
          require "fixture requires actual original native Set mode"
            (#set_backend ((#snapshot backend) ())=SmtLib.CVC5NativeSet))
    in (prepared,List.rev (!rows)) end
  fun open_query (e:env) rows =
    SmtLib_GraphCheckedQueryOpening.transport_with_conversions_with_policy
