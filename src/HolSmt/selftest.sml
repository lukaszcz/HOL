                    Feedback.message_of detail="condition outside parent frame"
                | _ => false
            in require "private body condition escaped with a root law"
              (rejected andalso retired e) end)
          (fn e =>
            let val prior = Count.thm_count () val calls = ref 0
                val caught = Exn.capture (fn () =>
                  record e 1 (fn _ => calls := !calls+1)) ()
                val _ = require "private condition failed after native work"
                  (!calls=0 andalso Count.thm_count ()=prior)
            in Exn.release caught end))
      val _ = test "Same Work cannot substitute a second native contract"
        (fn () => fixture (fn e =>
          let val other = NC.capture (#work e) limits
              val prior = Count.thm_count () val calls = ref 0
              val refused = failure (fn () => Law.record_with_policy (#work e)
                {frame= #frame e,native_contract=other,
                 conversion= #conversion e,profiles=[],ordinal=1,
                 check_type=fn _ => calls := !calls+1})
          in require "same-value native contract replaced the original token"
            (refused=SOME "different original native contract" andalso
             !calls=0 andalso Count.thm_count ()=prior andalso retired e) end))
      val _ = test "Wrong Work precedes a stale conditional receipt"
        (fn () => fixture (fn held =>
          let val _ = G.close_scope (#graph held) (#body_scope held)
