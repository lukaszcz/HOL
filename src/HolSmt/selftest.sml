(* Postlude execution is partitioned separately from the functional list.
   Private local declarations still initialize in every shard. *)
val postlude_seen = ref 0
val postlude_attempted = ref 0
val postlude_failed = ref 0
fun run_postlude ordinal label action =
  let
    val _ = if ordinal = !postlude_seen then () else
      raise Fail ("postlude dispatch order changed: " ^ label)
    val _ = postlude_seen := !postlude_seen + 1
  in
    if ordinal mod shard_n <> shard_k then () else
      let
        val _ = postlude_attempted := !postlude_attempted + 1
        val failed_before = !postlude_failed
        val _ = print ("HOL4_POSTLUDE_START " ^ label ^ "\n")
        val _ = TextIO.flushOut TextIO.stdOut
        fun failed primary =
          let
            val _ = if keep_going then SmtLib.include_theorems := true else ()
            val message = "postlude " ^ label ^ ": " ^ exnMessage primary
            val _ = postlude_failed := !postlude_failed + 1
            val _ = print ("HOL4_POSTLUDE_END " ^ label ^ " FAIL " ^
              message ^ "\n")
            val _ = TextIO.flushOut TextIO.stdOut
          in
            if keep_going then failures := message :: !failures
            else raise primary
          end
        fun executing () =
          let
            val old_mode = !testutils.diemode
            fun restore () = testutils.diemode := old_mode
            val _ = if keep_going then
              testutils.diemode := testutils.FailException else ()
          in
            ((action () before restore ()) handle primary =>
              (restore ();raise primary))
          end
        val _ = (executing () handle primary => failed primary)
        val _ = if !postlude_failed = failed_before then
          (print ("HOL4_POSTLUDE_END " ^ label ^ " PASS\n");
           TextIO.flushOut TextIO.stdOut) else ()
      in () end
  end
