  fun through(e:env)owner count=
    if count=0 then ()else
      (require "actual command ended early"(Option.isSome(next e owner));
       through e owner(count-1))
  fun observed(e:env)owner id wanted=
    let val actual=E.step_with_policy_for(#w e)owner id
        val equal=Term.aconv(G.representative(#g e)(#node actual))wanted
        val exact=W.with_step(#w e)(fn()=>Portable.pointer_eq
          (Thm.concl(P.theorem(#block actual)(#edge actual)),
           P.name(#block actual)(#node actual)))
    in require "inferred target lost actual node/proof association"
      (equal andalso exact)end
  fun quantified body=
    let val x=Term.mk_var("policy_receiver_x",Type.bool)
    in boolSyntax.mk_forall(x,body x)end
