  fun require text yes=if yes then () else raise Fail text
  fun test label action=(testutils.tprint label;action ();testutils.OK ())
  fun message action=(action ();NONE) handle Feedback.HOL_ERR detail=>
    SOME(Feedback.message_of detail)
  val metadata:RP.semantic_policy={input_limit=RP.Uncapped,
    output_limit=RP.Uncapped,template_limit=RP.Uncapped}
  fun setup assumptions=
    let val g=G.new () val r=G.root_scope g
        val s=S.new_with_policy g r RP.Uncapped
          {goal=boolSyntax.T,assumptions=assumptions}
        val w=W.begin_with_policy g r s
          {limits=metadata,work_limit=RP.Uncapped}
        val n=NC.capture w
          {semantic_limits={input_limit=1,output_limit=1,template_limit=8192},
           import_limit=1000000,type_work_limit=4000000}
    in (g,r,s,w,n) end
  fun freeze w n frontier=
    let val tables=W.with_step w (fn()=>
          P.prepare_owned_realization_tables_with_policy w frontier)
        val plan=W.with_step w (fn()=>
          P.prepare_native_realization_freeze_with_policy w
            {tables=tables,contract=n,profiles=[],ordinal=0,
             check_type=fn _=>()})
    in W.with_step w (fn()=>
      P.freeze_owned_realization_tables_with_policy w plan) end
  fun rule w b opcode premises=W.with_step w (fn()=>
    P.execute_primitive_with_policy w
      (P.prepare_primitive_with_policy w b opcode premises))
  fun finish w b target edge=W.with_step w (fn()=>
    P.execute_realization_with_policy w
      (P.prepare_realization_with_policy w b target edge))
  fun equality term=
    let val(g,r,s,w,n)=setup []
        val target= #node(G.import_with_policy g r RP.Uncapped
          (boolSyntax.mk_eq(term,term)))
        val(_,leaf)=case G.view g target of G.Application pair=>pair
          | _=>raise Fail "actual equality missing"
        val frame=Scope.root_with_policy w
        val frontier=W.with_step w (fn()=>
          P.prepare_realization_frontier_with_policy w
            {frame=frame,roots=[target],closed_facts=[],conversions=[]})
        val b=freeze w n frontier
        val ctor=W.with_step w (fn()=>P.constructor_with_policy w b target)
        val reverse=rule w b P.Symmetry [ctor]
        val reflexive=rule w b (P.ReflexiveName leaf) []
        val edge=rule w b P.EqualityMP [reverse,reflexive]
        val receipt=finish w b target edge
    in (g,r,s,w,n,target,leaf,receipt) end
  fun bridge w receipt=W.with_step w (fn()=>
    P.conversion_from_policy_source_realization_for w receipt)
