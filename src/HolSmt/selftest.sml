        let
          val raw_calls = ref 0 val pretty_calls = ref 0
          (* This is a SMALL-fixture native oracle, never an emitter path.
             Both counters must stay zero for the depth70 Boolean DAG. *)
          fun small_raw input =
            let val count = ref 0
                val variables = ref ([]:(Q.carrier * Term.term) list)
                fun variable current = case List.find
                    (fn (saved,_) => (#same context) (saved,current))
                    (!variables) of
                    SOME (_,raw) => raw
                  | NONE =>
                      let val raw = Term.genvar ((#type_of context) current)
                      in variables := (current,raw):: !variables;raw end
                fun walk current =
                  let val _ = if !count < 96 then count := !count+1 else
                        raise Fail "small dispatcher oracle exceeds96nodes"
                  in case (#view context) current of
                      Q.VariableView _ => variable current
                    | Q.ConstantView raw => raw
                    | Q.ApplicationView (left,right) =>
                        Term.mk_comb (walk left,walk right)
                    | Q.AbstractionView (binder,body) =>
                        Term.mk_abs (walk binder,walk body)
                  end
                val _ = raw_calls := !raw_calls+1
            in walk input end
          val operations =
            SmtLib_GraphCarrierOperations.make_with_datatypes context
              {sequence_emission=true}
              {term_to_string=fn current =>
                (pretty_calls := !pretty_calls+1;
                 Hol_pp.term_to_string (small_raw current))}
        in (operations,raw_calls,pretty_calls) end
      fun dispatch context operations roots = SmtLib_GraphDispatcher.emit
        context {operations=operations,regime=SmtLib.FirstOrder,
          apply_operator=SmtLib.ApplyUnderscore,prefix="graph_emit_",
          roots=roots}
      (* Interpret the REAL parser's linear LET syntax into the borrowed
         carrier. Let values use the incoming environment; repeated bound
         occurrences reuse its immutable carrier. No source HOL tree is
         reified, compared or expanded. The output visit limit is explicit. *)
      fun parsed_carrier (context:Q.outbound_context) limit source =
        let val visits = ref 0
            fun walk environment raw =
              let val _ = if !visits < limit then visits := !visits+1 else
                    raise Fail "parsed dispatcher output lost linear sharing"
              in if boolSyntax.is_let raw then
                   let val (function,value) = boolSyntax.dest_let raw
                       val (variable,body) = Term.dest_abs function
                       val argument = walk environment value
                   in walk ((variable,argument)::environment) body end
                 else if Term.is_var raw then
                   (case List.find (fn (variable,_) =>
                       Term.aconv variable raw) environment of
                      SOME (_,current) => current
                    | NONE => raise Fail "parsed output has a free variable")
                 else if Term.is_const raw then (#constant context) raw
                 else if Term.is_comb raw then
                   let val (left,right) = Term.dest_comb raw
                   in (#mk_comb context)
                     (walk environment left,walk environment right) end
                 else raise Fail "unexpected parser output abstraction"
              end
        in (walk [] (parse source),!visits) end
