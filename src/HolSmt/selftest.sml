                     retire ();ignore (F.string_presence context [])))) ()
              val cleanup = Exn.capture retire ()
          in case outcome of Exn.Exn primary => raise primary
            | Exn.Res result => (Exn.release cleanup;result) end)
      val _ = test "Inventory Primary closes the child and stays exact"
        (fn () =>
          let exception Primary of unit ref
              val token = ref () val calls = ref 0 val child = ref NONE
          in fixture_after [] boolSyntax.T
            (fn e => fn outcome =>
              let val exact = case outcome of Exn.Exn (Primary actual) =>
                      Portable.pointer_eq (actual,token) | _ => false
                  val closed = case !child of SOME scope => refused
