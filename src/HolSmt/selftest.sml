      val bs = List.tabulate (3,fn i => G.fresh_flexible_variable graph scope
        (Term.mk_var ("fresh_packed_bit" ^ suffix ^ Int.toString i,Type.bool)))
      val selected = case malformed of 1 => List.take (bs,2)
        | 2 => bs @ [hd bs] | 3 => [hd bs,hd bs,List.last bs]
        | 4 => [G.constant graph scope boolSyntax.T,
                 List.nth (bs,1),List.last bs] | _ => bs
      val packed = vector graph scope index selected
      fun stored left right = if reverse then equation graph scope right left
        else equation graph scope left right
      val anchor_source = stored word anchor
      val packed_source = stored word packed
      val extras = if not aliases then [] else List.tabulate (3,fn i =>
        G.fresh_flexible_variable graph scope
          (Term.mk_var ("fresh_alias" ^ suffix ^ Int.toString i,Type.bool)))
      val alias_sources = if not aliases then [] else List.concat
        (List.tabulate (3,fn i => [stored (List.nth (bs,i))
          (List.nth (extras,i)),stored (List.nth (extras,i))
          (bit graph scope (2-i) word)]))
      (* No original equation directly defines b_i = word_bit k. Alias
         chains exercise a real SCC; the plain case has a trivial metadata
