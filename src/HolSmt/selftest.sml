  val la=Term.mk_var("cpc_equality_la417",SmtRegLanProve.reglan_ty)
  val lb=Term.mk_var("cpc_equality_lb417",SmtRegLanProve.reglan_ty)
  fun shared_native 0=p
    | shared_native n=let val child=shared_native(n-1)
      in boolSyntax.mk_conj(child,child)end
  val compound8=boolSyntax.mk_conj(p,
    boolSyntax.mk_disj(shared_native 8,r))
  val bindings=[("p",p),("q",q),("r",r),("f",f),("g",g),
    ("la",la),("lb",lb),
    ("and_alias",boolSyntax.mk_conj(p,q)),
    ("mixed_alias",boolSyntax.mk_conj(p,boolSyntax.mk_disj(q,r))),
    ("repeat_alias",boolSyntax.mk_conj(p,p)),("compound8",compound8)]
  fun options (e:env):F.value_options =
