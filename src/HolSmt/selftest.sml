      null(Tag.axioms_of(Thm.tag theorem)) andalso
      Portable.pointer_eq(Thm.concl theorem,
        G.representative (#g e) (C.graph_equality converted)) andalso
      Portable.pointer_eq(#graph data,#g e) andalso #root data= #r e
      andalso #scope data= #r e andalso
      Portable.pointer_eq(#sources data,#s e) andalso
      #source data=C.graph_source converted andalso
