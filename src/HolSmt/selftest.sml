            val goal = ``bounded_cpc_q:bool``
          in fixture_sources_after [uf,original,uf] goal
            (fn _ => Exn.release) (fn (e:env) =>
              let
                val graph = #graph e and scope = #scope e
                val originals = S.assumption_nodes (#sources e)
                val assumption = List.nth (originals,1)
                val q = #node (G.import graph scope 512 goal)
                val r = #node (G.import graph scope 512 ``bounded_cpc_r:bool``)
                val conjunction = G.constant graph scope boolSyntax.conjunction
                val selected = G.application graph scope
                  (G.application graph scope (conjunction,r),q)
                val selected_term:F.term =
