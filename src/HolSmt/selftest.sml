     import_limit=cap,literal_limit=cap,binder_limit=RP.AtMost 1}
  fun paired (e:env) policy action =
    let val frozen = mapping e "f" ~1 val held = factory e frozen
        fun run () = W.with_step (#work e) (fn () =>
          let val native = F.create_configured_session_with_policy
