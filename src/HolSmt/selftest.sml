        val outcome = Exn.capture TextIO.inputAll input
        val cleanup = Exn.capture TextIO.closeIn input
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res value => (Exn.release cleanup;value) end
  fun gone path = not (OS.FileSys.access (path,[]))
    handle _ => false
  val fragments = "(assert " :: List.tabulate (2048,fn _ => "x ") @ [")\n"]
  val document = D.concat (List.map D.text fragments)
  val expected_input = String.concat fragments
  val goal = ([],boolSyntax.T)
  val streamed_solver =
    SolverSpec.make_solver_with_capture_command_and_completion_writer_strict
  fun exercise streamed writer_failure capture_failure cleanup_failure =
    let
      val events = ref ([]:string list)
      val paths = ref ([]:string list)
      val observed = ref ([]:string list)
      val calls = ref 0
      val sink = ref (fn (_:string) => ())
      fun mark event = events := !events @ [event]
      fun writer output =
        (mark "write";sink := output;
         case writer_failure of SOME primary =>
           (output "prefix";raise primary)
         | NONE => D.render (fn fragment =>
             (calls := !calls+1;output fragment)) document)
      fun pre_writer _ = (mark "pre";((),writer))
      fun pre_list _ = (mark "pre";((),fragments))
      (* This checks process IO only, not an SMT result or theorem. *)
      fun command () = (mark "command";"/bin/cat ")
      fun capture _ key stage source =
        (mark stage;paths := key::source:: !paths;
         observed := read source :: !observed;
         if stage="input" then Option.app (fn exn => raise exn)
           capture_failure else ())
      fun post () _ = (mark "post";SolverSpec.SAT NONE)
      fun complete () =
        (mark "complete";if cleanup_failure then raise Fail "cleanup" else ())
      fun validate _ _ _ = raise Fail "unexpected theorem validation"
      val outcome = Exn.capture (fn () =>
        if streamed then
          streamed_solver
            validate complete (SOME capture) pre_writer command post goal
        else
          SolverSpec.make_solver_with_capture_command_and_completion_strict
            validate complete (SOME capture) pre_list command post goal) ()
    in {outcome=outcome,events= !events,paths= !paths,
      observed=List.rev (!observed),calls= !calls,sink= !sink} end
  fun sat (Exn.Res (SolverSpec.SAT NONE)) = true | sat _ = false
  fun expired action = (action "late";false)
    handle Feedback.HOL_ERR detail =>
      Feedback.top_structure_of detail="SolverSpec" andalso
      Feedback.top_function_of detail="write_input" andalso
      Feedback.message_of detail="solver input writer expired"
