  structure MD = SmtLib_GraphDeclarationMetadata
  structure RP = SmtReplayResourcePolicy
  type env = {graph:G.graph,scope:G.scope,sources:S.sources,work:W.portfolio}
  fun require message yes = if yes then () else raise Fail message
  fun test label action =
    (testutils.tprint label;action ();testutils.OK ())
  fun error action = (action ();NONE)
    handle Feedback.HOL_ERR detail => SOME (Feedback.message_of detail)
  fun fixture goal build inspect =
    let
      val graph = G.new () val scope = G.root_scope graph
      val sources = S.new graph scope 10000
        {assumptions=[],goal=goal}
      val cap = RP.AtMost 1000000000
      val work = W.begin_with_policy graph scope sources
        {limits={input_limit=cap,output_limit=cap,template_limit=cap},
         work_limit=cap}
      val e:env = {graph=graph,scope=scope,sources=sources,work=work}
      fun run () =
        let val {assumptions,denied} = V.originals_with_policy work
            val portfolio = V.validate_portfolio_with_policy work
              {assumptions=assumptions,
               goal= #node (S.goal_source sources),denied=denied}
            val query = GP.prepare_query_with_policy work
              (GP.from_portfolio_with_policy work portfolio)
            fun open_view caller node = ignore
              (G.record_opened_view_with_policy graph caller
                (RP.AtMost 10000) node)
        in T.with_outbound_query_analysis_with_policy work query open_view
          (fn context => SmtLib.outbound_with_backend_context
            {sequence_emission=false,set_backend=SmtLib.Z3Set,
             bag_backend=SmtLib.Z3ArrayBag,
             has_set_terms=false,has_bag_terms=false}
            (fn backend => build e context backend)) end
      val outcome = Exn.capture run ()
      val inspected = Exn.capture (fn () => inspect e outcome) ()
      val cleanup = Exn.capture (fn () =>
        (W.close work;G.close_scope graph scope)) ()
    in case inspected of Exn.Exn primary => raise primary
      | Exn.Res result => (Exn.release cleanup;result) end
  fun context_with (context:Q.outbound_context) view step :
      Q.outbound_context =
    {analysis= #analysis context,goal= #goal context,
     assumptions= #assumptions context,denied= #denied context,
     view=view,type_of= #type_of context,same= #same context,
     free_variables= #free_variables context,strip_comb= #strip_comb context,
     is_set= #is_set context,is_bag= #is_bag context,
     is_raw_number= #is_raw_number context,
     contextual_argument= #contextual_argument context,
     graph_node= #graph_node context,key= #key context,
     semantic_key= #semantic_key context,
     collection_terms= #collection_terms context,constant= #constant context,
     mk_comb= #mk_comb context,genvar= #genvar context,
     list_mk_abs= #list_mk_abs context,step=step}
  (* A bounded TEST oracle only. The shared 70-level control never calls it.
     Only authenticated atomic graph leaves reach G.representative here. *)
  fun native graph mapping root =
    let
      val _ = require "small oracle received a large mapping"
        (length (M.entries mapping) <= 96)
      val remaining = ref 96
      fun walk environment id =
        let val _ = if !remaining > 0 then remaining := !remaining-1
              else raise Fail "small oracle expanded beyond its bound"
        in case #form (M.entry mapping id) of
          M.ExistingGraph reference =>
            let val node = M.reference_node mapping reference
                val _ = case G.view graph node of
                    G.Variable _ => () | G.Constant _ => ()
                  | _ => raise Fail "mapping retained a whole graph alias"
            in G.representative graph node end
        | M.Constant term => term
        | M.FreeVariable {lexical,...} => lexical
        | M.BoundSlot slot =>
            (case List.find (fn (held,_) => held=slot) environment of
               SOME (_,term) => term | NONE => raise Fail "unbound slot")
        | M.Application (left,right) =>
            Term.mk_comb (walk environment left,walk environment right)
        | M.Abstraction {slot,lexical,body} =>
            Term.mk_abs (lexical,walk ((slot,lexical)::environment) body)
        end
    in walk [] root end

  fun operations context =
    SmtLib_GraphCarrierOperations.make_with_datatypes context
      {sequence_emission=false}
      {term_to_string=fn _ => raise Fail "unexpected metadata formatter"}
  fun metadata e context backend regime emission =
    SmtLib_GraphDeclarationMetadata.freeze context
      {graph= #graph (e:env),scope= #scope e,regime=regime,
       backend=backend,operations=operations context,emission=emission}
  fun emit e context backend regime current =
    let val emission = SmtLib_GraphDispatcher.emit context
          {operations=operations context,regime=regime,
           apply_operator=SmtLib.ApplyUnderscore,prefix="graph_metadata_",
           roots=[(0,current)]}
    in (metadata e context backend regime emission,emission) end
  fun empty_types () = Redblackmap.mkDict Type.compare
  fun application (context:Q.outbound_context) head arguments =
    List.foldl (fn (argument,function) =>
      (#mk_comb context) (function,argument)) head arguments
  fun integer context value =
    (#mk_integer (T.outbound_builtin_operations context))
      (Arbint.fromInt value)
  fun same_type_records left right =
    let fun describe (SmtLib.TypeDeclaration {smt_name,declaration,...}) =
              (smt_name,declaration)
          | describe (SmtLib.DatatypeDeclaration
              {smt_names,declaration,...}) =
              (String.concatWith "," smt_names,declaration)
          | describe _ = raise Fail "non-type record in type metadata"
    in List.map describe left=List.map describe right end
  fun check_descriptions graph regime value =
    let val mapping = MD.mapping value val types = M.types mapping
        val ops = SmtLib.outbound_term_declaration_operations regime types
        fun check ({symbol,domain_sorts,range_sort,declaration}:
            MD.term_declaration) =
          let val raw = native graph mapping (#value symbol)
              val expected = SmtLib.outbound_term_declaration_metadata ops
                regime ((raw,#rank symbol),#token symbol)
          in require "durable declaration differs from native small oracle"
            (domain_sorts= #domain_sorts expected andalso
             range_sort= #range_sort expected andalso
             declaration= #declaration expected) end
    in List.app check (MD.term_declarations value) end
  fun accessors value =
    [fn () => MD.validate value,fn () => ignore (MD.mapping value),
     fn () => ignore (MD.type_records value),
     fn () => ignore (MD.term_declarations value),
     fn () => ignore (MD.encodings value),
     fn () => ignore (MD.definitions value)]
in
  val _ = run_postlude 370 "durable-graph-declaration-metadata-8" (fn () =>
    let
      val _ = test "Actual declarations retain grouped types and typed values"
        (fn () => fixture ``f (SOME (x:'a)) = NONE``
          (fn e => fn context => fn backend =>
            let val (value,emission) = emit e context backend SmtLib.FirstOrder
                  (#goal context)
                val _ = check_descriptions (#graph e) SmtLib.FirstOrder value
                val _ = require "shared native type-record order changed"
                  (same_type_records (MD.type_records value)
                    (SmtLib.outbound_type_declaration_records
                      SmtLib.FirstOrder (#types emission)))
            in (value,length (#symbols emission)) end)
          (fn e => fn outcome =>
            let val (value,count) = Exn.release outcome
