  val ne_conj_validation_fee=3*ne_conj_payer_fee+
    IntInf.fromInt(2*ncc_guard_group+ncc_fact_group)
  datatype nc_effect_context=NativeConstructorEffects of
    {work:W.portfolio,guard:unit->unit,allowance:nc_aux_allowance,
     cache:source_eqt_cache_read,
     current:nc_origin ref,proof:Thm.thm option ref,
     candidates:(Term.term*nc_origin)list ref,
     conj:(nc_conj_cache*Scope.receipt*closed_fact)option,
     pending:(Thm.thm*nc_origin*nc_origin*Term.term)option ref}
  val ne_prefix_fee=length
    ["prepare entry","mode branch","cache prepare call","cache guard call",
     "origin query call","origin result","cache cell","stored cell",
