  fun ne_guard(NativeConstructorEffects{allowance,...})=
    nc_aux_guard allowance
  fun ne_take(NativeConstructorEffects{allowance,...})amount=
    nc_take_aux allowance amount
  fun ne_cache_guard(value as NativeConstructorEffects{work,cache,...})=
    eqc_inside_guard_using work cache(fn()=>
      (ne_take value ne_cache_guard_fee;W.spend work 0))
  fun ne_stored expected guard evidence=
    let fun loop value=
          (guard();W.spend expected(IntInf.toInt ne_lookup_fee);
           case value of SCELeaf(SourceRuleRecipe
               {constructor_origins,source_effect_origins,...})=>
                 (case source_effect_origins of SOME origin=>
                    (true,SOME origin)|NONE=>(false,constructor_origins))
             | SCEApplied{constructor_origins,effect_origins,...}=>
                 (case effect_origins of SOME origin=>(true,SOME origin)
                   | NONE=>(false,constructor_origins))
             | SCEProjected{value,...}=>loop value)
    in loop evidence end
  fun ne_prepare expected guard closing frame steps hypotheses evidence=
    let val _=guard()val _=W.spend expected(ne_model_fee+ne_prefix_fee)
        val enabled=Option.isSome closing
        val combine=case closing of NONE=>false
          | SOME(SCRConjEnvelope{required,...})=> !required
        val dispatch=IntInf.fromInt ne_dispatch_fee*(4*steps+8)
        val total=if enabled then dispatch+nc_aux_consume_fee+
          IntInf.fromInt ne_create_fee+nc_aux_consume_fee+
          (2*steps+3)*ne_step_fee+
          (hypotheses+steps+1)*ne_row_fee+
          (hypotheses+steps+2)*(hypotheses+steps+2)*ne_lookup_fee+
          (hypotheses+2)*ne_final_fee+2*steps*ne_cache_guard_fee+
          (if combine then steps*(ne_conj_fee+ne_conj_validation_fee)else 0)
          else dispatch+nc_aux_consume_fee
        val seed=if enabled then
          let val cache=eqc_prepare_inside expected
              val _=eqc_inside_guard expected cache
              val(_,stored)=ne_stored expected guard evidence
              val conj=if combine then
                let val held=prepare_conj_cache_inside expected
                    val actual=case closing of
                        SOME(SCRConjEnvelope{fact,...})=> !fact
                      | NONE=>NONE
                in case actual of NONE=>NONE
                  | SOME fact=>SOME(held,frame,fact)end else NONE
          in SOME(cache,stored,conj)end else NONE
    in(total,dispatch,seed)end
  fun ne_admit expected guard allowance dispatch seed=
    (nc_take_aux allowance(dispatch+nc_aux_consume_fee);
     case seed of NONE=>(nc_close_aux allowance;NONE)
     | SOME(cache,stored,conj)=>
         (nc_take_aux allowance
            (IntInf.fromInt ne_create_fee+nc_aux_consume_fee);
          SOME(NativeConstructorEffects{work=expected,guard=guard,
            allowance=allowance,cache=cache,current=ref NCDeferred,
            proof=ref NONE,candidates=ref [],
            conj=conj,pending=ref NONE},stored)))
  fun ne_begin NONE _ _=()
    | ne_begin(SOME((value as NativeConstructorEffects
        {current,proof,candidates,...}),stored))evidence
        (data:sce_snapshot)=
      let val _=ne_take value(ne_step_fee)
          val target= #target data val actual= #proof data
          val _=case stored of NONE=>(current:=nc_seed target;
                candidates:=[])
            | SOME held=>
                if Portable.pointer_eq(#proof held,actual)andalso
                  Portable.pointer_eq(#target held,target)then
                  (current:= #conclusion held;candidates:= #hyp held)
                else raise ERR "native_constructor_effects"
                  "actual incoming proof portfolio changed"
          val _=proof:=SOME actual
      in ne_guard value end
  fun ne_lookup value pending term fallback=
    let fun loop []=fallback
          | loop((actual,origin)::rest)=
              (ne_take value(ne_lookup_fee);
               if Portable.pointer_eq(actual,term)then origin
                 else loop rest)
    in loop pending end
  fun ne_assumption NONE _ _=()
    | ne_assumption(SOME((value as NativeConstructorEffects
        {current,proof,candidates,...}),_))before_proof condition=
      let val _=ne_take value(ne_row_fee)
          val _=case !proof of SOME held=>
              if Portable.pointer_eq(held,before_proof)then ()else
                raise ERR "native_constructor_effects"
                  "actual assumption predecessor changed"
            | NONE=>raise ERR "native_constructor_effects" "no predecessor"
          val origin=if nc_known(!current)then
              NCSelected(condition,!current)else nc_seed condition
          val _=candidates:=(condition,origin):: !candidates
      in ne_guard value end
  fun ne_before NONE _ _=()
    | ne_before(SOME((value as NativeConstructorEffects
        {proof,...}),_))action before_proof=
      (ne_take value ne_step_fee;
       case !proof of SOME held=>
           if Portable.pointer_eq(held,before_proof)then
             (case action of SCRPredicateTruth=>ne_cache_guard value
               | _=>())else raise ERR "native_constructor_effects"
                 "actual native input changed"
         | NONE=>raise ERR "native_constructor_effects" "no input proof")
  (* Actual existing DISCH/destructor ports, never a public schema input. *)
  fun ne_conj_before NONE _ _ _ _ _ _ _=()
    | ne_conj_before(SOME((value as NativeConstructorEffects
        {work,current,proof,candidates,conj,pending,...}),_))
        before_proof body ant law first second third=
      let val _=ne_take value ne_conj_fee
          val _=pending:=NONE
          val _=case !proof of SOME held=>
              if Portable.pointer_eq(held,before_proof)andalso
                  Portable.pointer_eq(Thm.concl held,body)then ()else
                raise ERR "native_constructor_effects"
                  "actual combining predecessor changed"
            | NONE=>raise ERR "native_constructor_effects" "no predecessor"
          val ant_origin=ne_lookup value(!candidates)ant(nc_seed ant)
          fun debit amount=
            (ne_take value(ne_conj_payer_fee+IntInf.fromInt amount);
             W.spend work 0)
          val _=case conj of NONE=>()
            | SOME(cache,frame,fact)=>
                let val NCConjCache{law=ports,origin,...}=cache
                    val _=case fact of PolicyRealizedClosedFact _=>
                          raise ERR "native_constructor_effects"
                            "policy fact requires policy law programme"
                        | _=>()
                    val ClosedFact{original,...}=fact
                    val same=Portable.pointer_eq(law,#proof ports)andalso
                      Portable.pointer_eq(original,#proof ports)andalso
                      Portable.pointer_eq(first,#first ports)andalso
                      Portable.pointer_eq(second,#second ports)andalso
                      Portable.pointer_eq(third,#third ports)
                in if same then
                    (ignore(conj_cache_fact_for_inside_using work cache
                       frame fact debit);
                     if nc_known ant_origin andalso nc_known(!current)then
                       pending:=SOME(before_proof,ant_origin,!current,
                         #statement origin)else ())
                   else ()end
      in ne_guard value end
  fun ne_after NONE _ _ _=()
    | ne_after(SOME((value as NativeConstructorEffects
        {current,proof,cache,candidates,pending,...}),_))
        action before_proof after=
      let val _=ne_take value(ne_step_fee)
          val _=case !proof of SOME held=>
              if Portable.pointer_eq(held,before_proof)then ()else
                raise ERR "native_constructor_effects"
                  "actual native predecessor changed"
            | NONE=>raise ERR "native_constructor_effects" "no predecessor"
          val old= !current val target=Thm.concl after
          val origin=case action of
              SCRNative(SCEClauseNative SRCondition)=>
                if nc_known old then NCSelected(target,old)else NCDeferred
            | SCRPredicateTruth=>
                (ne_cache_guard value;
                 if nc_known old then
                   let val SourceEqtCacheRead{ports,...}=cache
                   in NCEqtEffect(target,old,#statement ports)end
                 else NCDeferred)
            | SCRConjClose(_,condition,false)=>
                let val ant=ne_lookup value(!candidates)condition
                      (nc_seed condition)
                in if nc_known ant andalso nc_known old then
                    NCImplication(target,ant,old)else NCDeferred end
            | SCRConjClose(_,_,true)=>
                (case !pending of SOME(parent,ant,body,law)=>
                   if Portable.pointer_eq(parent,before_proof)then
                     NCConjCloseEffect(target,ant,body,law)
                   else NCDeferred
                 | NONE=>NCDeferred)
            | _=>NCDeferred
          val _=current:=origin val _=proof:=SOME after
      in ne_guard value end
  fun ne_finish NONE _=NONE
    | ne_finish(SOME((value as NativeConstructorEffects
        {current,proof,candidates,allowance,...}),_))(snapshot:nc_proof)=
      let val _=ne_take value(ne_final_fee)
          val _=case !proof of SOME held=>
              if Portable.pointer_eq(held,#proof snapshot)then ()else
                raise ERR "native_constructor_effects"
                  "actual result proof changed"
            | NONE=>raise ERR "native_constructor_effects" "no result proof"
          fun rows []=[]
            | rows((term,fallback)::rest)=
                let val _=ne_take value(ne_final_fee)
                    val origin=ne_lookup value(!candidates)term fallback
                in(term,origin)::rows rest end
          val hypotheses=rows(#hyp snapshot)
          val result={proof= #proof snapshot,target= #target snapshot,
            conclusion= !current,hyp=hypotheses,events= #events snapshot}
          val _=ne_guard value val _=nc_close_aux allowance
      in SOME(result:nc_proof)end

  (* A CURRENT unary snapshot keeps its own proof/conclusion. Only an exact
     native Hyp pointer may inherit an earlier constructor witness. *)
  val nh_dispatch_fee=length
    ["NONE mode dispatch","prefix call dispatch","future subtotal call",
     "future subtotal sum","admit mode dispatch","old dispatch consume",
     "old close guard",
     "result mode dispatch","final carry call"]
  val nh_tick_fee=length
    ["tick entry","group sum","integer conversion","consume addition",
     "allowance call","return"]
  val nh_model_fee=length
    ["model entry","cost helper definition","model return"]+
    4*length["cost argument","consume-fee read","tick-group sum",
      "integer conversion","cost addition","cost return"]+
    3*length["cardinality increment"]+4*length["product"]+
    3*length["subtotal addition"]
  val nh_prefix_fee=length
    ["entry","guard call","payer call","current data call",
     "stored portfolio call","result pair","option dispatch",
     "proof projection","actual proof projection","proof comparison",
     "target projection","actual target projection","target comparison",
     "identity branch","failure branch","guard call","return"]
  val nh_finish_fee=length
    ["entry","tick helper definition","allowance call","snapshot pattern",
     "seed option dispatch","alias helper definition",
     "reverse helper definition","row helper definition",
     "held Hyp projection","row call","result proof field",
     "result target field","result conclusion field","result Hyp field",
     "result events field","result record","result option",
     "allowance close call","return option dispatch","return branch",
     "return"]
  val nh_row_fee=length
    ["row entry","allowance call","list dispatch","pair pattern",
     "alias scan call","origin result","old origin known dispatch",
     "origin branch","pair construction","list cons",
     "tail projection","tail call","nil branch","reverse call"]
  val nh_alias_fee=length
    ["alias entry","allowance call","list dispatch","pair pattern",
     "pointer comparison","identity branch","origin known dispatch",
     "unsupported disjunction","answer replacement","tail projection",
     "tail call","nil branch","unsupported branch","result publication"]
  val nh_reverse_fee=length
    ["reverse entry","allowance call","list dispatch","head projection",
     "tail projection","list cons","tail call","nil branch","return"]
  fun nh_prepare expected guard evidence=
    let val _=guard()val _=W.spend expected nh_prefix_fee
        val data=sce_data expected evidence
        val(_,stored)=ne_stored expected guard evidence
        val _=case stored of NONE=>()|SOME(held:nc_proof)=>
          if Portable.pointer_eq(#proof data,#proof held)andalso
              Portable.pointer_eq(#target data,#target held)then ()else
            raise ERR "native_hyp_carry" "actual incoming portfolio changed"
        val _=guard()
    in stored end
  fun nh_subtotal initial_H final_H=
    let fun cost group=nc_aux_consume_fee+IntInf.fromInt(nh_tick_fee+group)
    in cost nh_finish_fee+(final_H+1)*cost nh_row_fee+
      final_H*(initial_H+1)*cost nh_alias_fee+
      (final_H+1)*cost nh_reverse_fee end
  fun nh_finish allowance seed
      ({proof,target,conclusion,hyp,events}:nc_proof):nc_proof option=
    let fun tick group=nc_take_aux allowance
          (nc_aux_consume_fee+IntInf.fromInt(nh_tick_fee+group))
        val _=tick nh_finish_fee
        val initial=case seed of NONE=>[]|SOME(held:nc_proof)=> #hyp held
        fun aliases pending actual answer unsupported=
          (tick nh_alias_fee;
           case pending of []=>if unsupported then NCDeferred else answer
           |(term,origin)::rest=>
             if Portable.pointer_eq(term,actual)then
               aliases rest actual origin
                 (unsupported orelse not(nc_known origin))
             else aliases rest actual answer unsupported)
        fun reverse pending held=
          (tick nh_reverse_fee;case pending of []=>held
           |value::rest=>reverse rest(value::held))
        fun rows pending held=
          (tick nh_row_fee;case pending of []=>reverse held []
           |(actual,old)::rest=>
             let val inherited=aliases initial actual NCDeferred false
                 val origin=if nc_known old then old else inherited
             in rows rest((actual,origin)::held)end)
        val result={proof=proof,target=target,conclusion=conclusion,
          hyp=rows hyp [],events=events}
        val _=nc_close_aux allowance
    in case seed of NONE=>NONE|SOME _=>SOME(result:nc_proof)end

  fun execute_source_canonical_clause expected
      (plan as SCRClausePlan
        {evidence,frame,graph,caller,children,initial,
        instructions,terminal,result,conditions,types,binders,check_type,
        used,permutative,origin,future,condition_origins,closing,...})=
    sr_fail expected (fn()=>
      (scr_clause_guard expected plan;
       if !used then raise ERR "execute_source_condition_rule" "consumed"
         else ();
       W.with_step expected (fn()=>
       let
         val _=scr_clause_guard expected plan val _=used:=true
         fun guarded operation=
           (scr_clause_guard expected plan;
            let val value=operation()
            in scr_clause_guard expected plan;value end)
         fun materialize(SRCaptured ty)=guarded(fn()=>ty)
           | materialize(SRArrow(a,b))=
               let val left=materialize a val right=materialize b
               in guarded(fn()=>Type.mk_thy_type
                 {Thy="min",Tyop="fun",Args=[left,right]})end
         (* The opaque ready phase completed every retained policy. *)
         val variables=List.map(fn(id,name,ty)=>
           (id,guarded(fn()=>Term.mk_var(name,ty))))binders
         fun bound id=case List.find(fn(old,_)=>old=id)variables of
             SOME(_,term)=>term | _=>raise ERR "execute_source_condition_rule"
               "missing lexical binder"
         val _=W.spend expected nc_model_fee
         fun capture_tick amount=(scr_clause_guard expected plan;
           W.spend expected amount)
         fun capture_trees held total=
           (capture_tick nc_walk_fee;case held of []=>total
            | SRTree{raw,...}::rest=>capture_trees rest(total+raw))
         fun capture_steps held total (count:IntInf.int)=
           (capture_tick nc_walk_fee;case held of []=>(total,count)
            | (action,SRTree{raw,...},_)::rest=>
              let val extra=case action of SCRDischarge(SRTree{raw,...})=>raw
                    | SCRNative(SCEClauseNative(SRSpec
                        (SRTree{raw,...})))=>raw
                    | SCRNative(SCEClauseConditionForall
                        (SRTree{raw,...}))=>raw
                    | SCRNative(SCEClauseAnteExists(SRTree{raw,...}))=>raw
                    | _=>0
                  val aligned=case closing of NONE=>raw | SOME _=>0
              in capture_steps rest(total+aligned+extra)(count+1)end)
         fun capture_binders held (count:IntInf.int)=
           (capture_tick nc_walk_fee;case held of []=>count
            | _::rest=>capture_binders rest(count+1))
         fun capture_card theorem=
           (capture_tick nc_card_fee;
            IntInf.fromInt(HOLset.numItems(Thm.hypset theorem)))
         val _=capture_tick nc_model_fee
         val capture_data=sce_data expected evidence
         val initial_H=capture_card(#proof capture_data)
         val borrowed_H=capture_card boolTheory.EQ_CLAUSES
         val _=if borrowed_H=0 then ()else raise ERR "constructor_capture"
           "fixed Boolean bootstrap Hyp is not closed"
         val _=case closing of NONE=>() | SOME(SCRConjEnvelope{fact,...})=>
           (case !fact of NONE=>() | SOME law=>
             if capture_card(closed_original law)=0 then ()else raise ERR
               "constructor_capture" "fixed closing law Hyp is not closed")
         val(step_events,capture_steps_count)=capture_steps instructions 0 0
         val condition_events=capture_trees conditions 0
         val binder_count=capture_binders binders 0
         val _=capture_tick nc_model_fee
         val SRTree{raw=initial_events,...}=initial
         val SRTree{raw=result_events,...}=result
         val capture_initial=case closing of NONE=>initial_events | SOME _=>0
         (* Both modes emit result once; added conditions occur AFTER the
            snapshot but remain in the prepaid complete capture schedule. *)
         val capture_events=capture_initial+step_events+result_events+
           condition_events
         val capture_H=initial_H+2*capture_steps_count
         val _=capture_tick nh_dispatch_fee
         val canonical_hyp_seed=case closing of NONE=>
             nh_prepare expected(fn()=>scr_clause_guard expected plan)evidence
           | SOME _=>NONE
         val canonical_hyp_total=case closing of NONE=>
             (capture_tick nh_model_fee;nh_subtotal initial_H capture_H)
           | SOME _=>0
         val(effect_total,effect_dispatch,effect_seed)=
           ne_prepare expected(fn()=>scr_clause_guard expected plan)
             closing frame capture_steps_count capture_H evidence
         val(capture,effect_allowance)=nc_prepare_combined_allowance expected
           (fn()=>scr_clause_guard expected plan)capture_events
           binder_count capture_H(effect_total+canonical_hyp_total)
         val native_effects=case closing of NONE=>
             (nc_take_aux effect_allowance
                (effect_dispatch+nc_aux_consume_fee);
              nc_aux_guard effect_allowance;NONE)
           | SOME _=>ne_admit expected
               (fn()=>scr_clause_guard expected plan)effect_allowance
               effect_dispatch effect_seed
         val _=nc_take capture nc_log_fee
         val constructor_log=ref[] : nc_log
         fun emit_result(SRTree {shape,...})=case shape of
             SRAtom term=>nc_atom_result capture constructor_log term
           | SRBound(id,_)=>nc_atom_result capture constructor_log(bound id)
           | SRFresh(name,ty)=>nc_atom_result capture constructor_log
               (guarded(fn()=>
               case List.find(fn SCEFutureArgument
                   {name=held,ty=actual,...}=>
                 name=held andalso Type.compare(ty,actual)=EQUAL)future of
                 SOME(SCEFutureArgument {child,...})=>
                   (case !child of SOME argument=>
                      G.representative graph
                        (G.closure_child_node graph
                          (#scope(Scope.description_for expected frame))
                          argument)
                    | NONE=>raise ERR "canonical_future"
                        "argument has not been bound")
               | NONE=>raise ERR "canonical_future"
                   "quoted argument identity changed"))
           | SRLam(id,_,body)=>
               let val child as (term,_)=emit_result body
               in nc_binding_result false capture constructor_log
                 variables id child
                 (guarded(fn()=>Term.mk_abs(bound id,term)))end
           | SRApp(SRTree {shape=SRAtom h,...},
               (argument as SRTree {shape=SRLam(id,_,body),...}))=>
               if Term.is_const h andalso
                   Term.same_const h boolSyntax.universal then
                 let val child as (term,_)=emit_result body
                 in nc_binding_result true capture constructor_log
                   variables id child
                   (guarded(fn()=>
                     boolSyntax.mk_forall(bound id,term)))end
               else let val child as (term,_)=emit_result argument
                    in nc_application_result capture constructor_log
                      (h,nc_head capture h)child
                      (guarded(fn()=>Term.mk_comb(h,term)))end
           | SRApp(SRTree {shape=SRApp
               (SRTree {shape=SRAtom h,...},a),...},b)=>
               if Term.is_const h andalso
                   Term.same_const h boolSyntax.equality then
                 let val l as (left,_)=emit_result a
                     val r as (right,_)=emit_result b
                 in nc_equality_result capture constructor_log l r
                   (guarded(fn()=>boolSyntax.mk_eq(left,right)))end
               else let val child as (argument,_)=emit_result a
                        val l as (operator,_)=nc_application_result capture
                          constructor_log(h,nc_head capture h)child
                          (guarded(fn()=>Term.mk_comb(h,argument)))
                        val r as (operand,_)=emit_result b
                    in nc_application_result capture constructor_log l r
                     (guarded(fn()=>
                       Term.mk_comb(operator,operand)))end
           | SRApp(a,b)=>let val l as (left,_)=emit_result a
                            val r as (right,_)=emit_result b
               in nc_application_result capture constructor_log l r
                 (guarded(fn()=>Term.mk_comb(left,right)))end
         fun emit tree= #1(emit_result tree)
         fun align term theorem=
           if Portable.pointer_eq(Thm.concl theorem,term) then theorem
           else let val bridge=guarded(fn()=>
                      SmtReplayRuleObservation.ALPHA(Thm.concl theorem)term)
             in guarded(fn()=>SmtReplayRuleObservation.EQ_MP bridge theorem)
             end
         val d=sce_data expected evidence
         val _=ne_begin native_effects evidence d
         val initial=case closing of NONE=>align(emit initial)(#proof d)
           | SOME _=> #proof d
         fun play [] theorem=theorem
           | play((action,next,_)::rest)theorem=
               let val before_proof=theorem
                   val _=ne_before native_effects action before_proof
                   val theorem=case action of SCRDischarge condition=>
                     let val term=emit condition
                     in guarded(fn()=>SmtReplayRuleObservation.DISCH
                       term theorem)end
                   | SCRPredicateTruth=>
                       guarded(fn()=>Drule.EQT_INTRO theorem)
                   | SCRConjClose(condition,term,combine)=>
                       let val discharged=guarded(fn()=>
                             SmtReplayRuleObservation.DISCH term theorem)
                       in if not combine then discharged else
                         let val SCRConjEnvelope{first,second,third,fact,...}=
                               case closing of SOME data=>data | NONE=>
                                 raise ERR "predicate_conditional"
                                   "missing genuine closing envelope"
                             val law=case !fact of SOME value=>
                                   closed_original value | NONE=>raise ERR
                                 "predicate_conditional" "law was not admitted"
                             val(p,qr)=boolSyntax.dest_imp_only
                               (Thm.concl discharged)
                             val(q,r)=boolSyntax.dest_imp_only qr
                             val _=ne_conj_before native_effects
                               before_proof qr p law first second third
                             val instance=guarded(fn()=>
                               SmtReplayRuleObservation.INST
                                 [{redex=first,residue=p},
                                  {redex=second,residue=q},
                                  {redex=third,residue=r}]law)
                         in guarded(fn()=>SmtReplayRuleObservation.MP
                           instance discharged)end end
                   | SCRNative native=>(case native of
                     SCEClauseNative(SRSpec arg)=>
                     let val term=emit arg
                     in guarded(fn()=>
                       SmtReplayRuleObservation.SPEC term theorem)end
                   | SCEClauseNative(SRConjunct left)=>
                     guarded(fn()=>if left then
                       SmtReplayRuleObservation.CONJUNCT1 theorem else
                       SmtReplayRuleObservation.CONJUNCT2 theorem)
                   | SCEClauseNative SRCondition=>
                       let val condition= #1
                             (boolSyntax.dest_imp(Thm.concl theorem))
                           val _=ne_assumption native_effects theorem condition
                           val premise=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME condition)
                       in guarded(fn()=>
                         SmtReplayRuleObservation.MP theorem premise)end
                   | SCEClauseTruth=>guarded(fn()=>Drule.EQT_ELIM theorem)
                   | SCEClauseAnteConj=>
                       let val(ant,_)=boolSyntax.dest_imp_only
                             (Thm.concl theorem)
                           val(a,b)=boolSyntax.dest_conj ant
                           val pa=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME a)
                           val pb=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME b)
                           val both=guarded(fn()=>
                             SmtReplayRuleObservation.CONJ pa pb)
                           val body=guarded(fn()=>
                             SmtReplayRuleObservation.MP theorem both)
                           val right=guarded(fn()=>
                             SmtReplayRuleObservation.DISCH b body)
                       in guarded(fn()=>
                         SmtReplayRuleObservation.DISCH a right)end
                   | SCEClauseAnteDisj left=>
                       let val(ant,_)=boolSyntax.dest_imp_only
                             (Thm.concl theorem)
                           val(a,b)=boolSyntax.dest_disj ant
                           val selected=if left then a else b
                           val assumption=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME selected)
                           val either=guarded(fn()=>if left then
                             SmtReplayRuleObservation.DISJ1 assumption b
                             else SmtReplayRuleObservation.DISJ2 a assumption)
                           val body=guarded(fn()=>
                             SmtReplayRuleObservation.MP theorem either)
                       in guarded(fn()=>
                         SmtReplayRuleObservation.DISCH selected body)end
                   | SCEClauseSymmetry=>guarded(fn()=>
                       SmtReplayRuleObservation.SYM theorem)
                   | SCEClauseConditionForall argument=>
                       let val(ant,_)=boolSyntax.dest_imp_only
                             (Thm.concl theorem)
                           val variable=emit argument
                           val quantified=guarded(fn()=>
                             boolSyntax.mk_forall(variable,ant))
                           val assumption=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME quantified)
                           val condition=guarded(fn()=>
                             SmtReplayRuleObservation.SPEC variable assumption)
                           val result=guarded(fn()=>
                             SmtReplayRuleObservation.MP theorem condition)
                       in guarded(fn()=>
                         SmtReplayRuleObservation.DISCH quantified result)end
                   | SCEClauseAnteExists argument=>
                       let val(ant,_)=boolSyntax.dest_imp_only
                             (Thm.concl theorem)
                           val(v,body)=boolSyntax.dest_exists ant
                           val witness=emit argument
                           val instance=guarded(fn()=>Term.subst
                             [{redex=v,residue=witness}]body)
                           val assumption=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME instance)
                           val existential=guarded(fn()=>
                             Thm.EXISTS(ant,witness)assumption)
                           val result=guarded(fn()=>
                             SmtReplayRuleObservation.MP theorem existential)
                       in guarded(fn()=>
                         SmtReplayRuleObservation.DISCH instance result)end
                   | SCEClauseNotIntro=>guarded(fn()=>
                       Thm.NOT_INTRO theorem))
                   val _=ne_after native_effects action before_proof theorem
               in play rest(case closing of NONE=>align(emit next)theorem
                    | SOME _=>theorem)end
         val body=play instructions initial
         val proof=body
         val proof=case closing of NONE=>align(emit result)proof
           | SOME _=>proof
         val _=case closing of NONE=>() | SOME(SCRConjEnvelope
             {expected,required,fact,...})=>
           let val base_tag=Tag.merge(Thm.tag boolTheory.EQ_CLAUSES)
                 (Thm.tag(#proof d))
               val actual_tag=if !required then case !fact of
                   SOME law=>Tag.merge(Thm.tag(closed_original law))base_tag
                 | NONE=>raise ERR "predicate_conditional" "missing actual law"
                 else base_tag
           in if ListPair.allEq Portable.pointer_eq(Thm.hyp proof,!expected)
                 andalso Tag.dest_tag(Thm.tag proof)=Tag.dest_tag actual_tag
                 andalso guarded(fn()=>Term.aconv(Thm.concl proof)(emit result))
             then ()else raise ERR "predicate_conditional"
               "native endpoint, actual Hyp removal or full Tag changed"end
         val _=if clean proof then () else
           raise ERR "execute_source_condition_rule" "proof provenance"
         val constructor_snapshot=nc_snapshot_priced capture constructor_log
           (case closing of NONE=>true|SOME _=>false)proof
         val actual_effects=case closing of NONE=>
             nh_finish effect_allowance canonical_hyp_seed constructor_snapshot
           | SOME _=>ne_finish native_effects constructor_snapshot
         val value=SCEApplied {work=expected,frame=frame,parents=[evidence],
           proof=proof,target=Thm.concl proof,names= #names d,rows= #rows d,
           origin=origin,constructor_origins=SOME constructor_snapshot,
           effect_origins=actual_effects,realized=ref NONE}
         val arguments=List.map(fn SCEFutureArgument {child,...}=>
           case !child of SOME argument=>argument | NONE=>raise ERR
             "canonical_future" "missing retained argument")future
         val fixed_children=case closing of NONE=>[] | SOME
             (SCRConjEnvelope{fact,...})=>case !fact of NONE=>[] | SOME law=>
               [guarded(fn()=>G.closure_root graph caller(closed_node law))]
         val retained=SCEProjected {work=expected,graph=graph,caller=caller,
           children=arguments@children@fixed_children,value=value,
           permutative=SOME permutative}
         val added=ListPair.map(fn(tree,origin)=>(emit tree,origin))
           (conditions,condition_origins)
         val _=nc_close_allowance capture
         val _=sce_guard expected retained
       in (retained,added) end)))


  datatype source_canonical_frontier=CanonicalConjunction
    | CanonicalAntecedentConjunction | CanonicalAntecedentDisjunction
    | CanonicalAntecedentExistential | CanonicalCondition
    | CanonicalImpFalse | CanonicalForall | CanonicalRestrictedForall
    | CanonicalTerminal
  datatype source_canonical_step=CanonicalConjunct of bool
    | CanonicalAntecedentConj | CanonicalAntecedentDisj of bool
    | CanonicalUndisch | CanonicalNotIntro | CanonicalFinish
  datatype source_canonical_future=CanonicalExists | CanonicalUniversals
  datatype source_canonical_state=SCState of
    {work:W.portfolio,evidence:source_condition_evidence,
     ants:(Term.term*sce_origin_tree) list,finished:bool,
     syntax:Term.term,syntax_ants:Term.term list}
  datatype sc_phase=SCPrepared | SCAdmitting | SCAdmitted
    | SCConsumed | SCDead
  datatype source_canonical_plan=SCPlan of
    {work:W.portfolio,parent:source_canonical_state option,
     raw:scr_clause_plan,ants:(Term.term*sce_origin_tree) list,
     finish:bool,phase:sc_phase ref,syntax:Term.term,
     syntax_ants:Term.term list}
  datatype source_canonical_ready=SCReady of source_canonical_plan
  fun sc_state_guard expected(SCState {work,evidence,...})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work)then ()else
         raise ERR "canonical_state" "foreign expected Work";
       sce_guard expected evidence))
  fun sc_plan_guard expected(SCPlan {work,parent,raw,phase,...})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work)then ()else
         raise ERR "canonical_plan" "foreign expected Work";
       if !phase=SCDead then raise ERR "canonical_plan" "retired"else ();
       Option.app(sc_state_guard expected)parent;
       scr_clause_guard expected raw))
  fun sc_operation expected(SCPlan {work,phase,...})operation=
    if Portable.pointer_eq(expected,work)then
      (operation()handle primary=>
        (phase:=SCDead;W.close expected;raise primary))
    else (W.close expected;raise ERR "canonical_plan" "foreign expected Work")
  fun sc_open expected(state as SCState {finished,...})=
    (sc_state_guard expected state;
     if finished then raise ERR "canonical_state" "already finished"else ())
  (* Authentic bounded syntax only. No external raw theorem, Hyp portfolio
     or caller lexical map is accepted or adopted by this path. *)
  fun sc_syntax_bound expected frame cap term=
    let fun tick n=(Scope.validate_lifetime_for expected frame;
          W.spend expected n)
    in case SmtReplayImport.bounded_raw_size cap term of
         SOME n=>tick n | NONE=>raise ERR "canonical_syntax"
           "current syntax exceeds original raw allowance";
       case SmtReplayImport.bounded_binder_size cap term of
         SOME n=>tick n | NONE=>raise ERR "canonical_syntax"
           "current syntax exceeds original binder allowance"end
  fun sc_capture_anchor expected evidence=
    sr_fail expected(fn()=>W.with_step expected(fn()=>
      let val d=sce_data expected evidence
          val limits=W.semantic_limits expected
          val frame= #frame d
          fun live()=(sce_guard expected evidence;
            Scope.validate_lifetime_for expected frame)
          fun guard operation=
            (live();let val answer=operation()in live();answer end)
          fun anchor value=
            (sce_guard expected value;
             case value of SCEProjected {value,...}=>anchor value
               | SCELeaf(SourceRuleRecipe {plan=SourceRulePlan
                   {source,instructions=[],terminal=SourceTruth,...},...})=>
                   let val _=source_realization_guard expected source
                       val SourceRealization {graph,target,...}=source
                   in guard(fn()=>G.representative graph target)end
               | SCEApplied {parents=[parent],target,...}=>
                   let val previous= #target(sce_data expected parent)
                       val _=sc_syntax_bound expected frame
                         (#template_limit limits)previous
                   in if guard(fn()=>Term.aconv target previous)then
                        anchor parent else raise ERR "canonical_syntax"
                          "transformed assertion needs authentic syntax"end
               | _=>raise ERR "canonical_syntax"
                   "current assertion has no retained graph syntax anchor")
          val original=anchor evidence
          val _=sc_syntax_bound expected frame(#output_limit limits)original
          val(lhs,rhs)=guard(fn()=>boolSyntax.dest_eq(#target d))
          val _=if Term.is_const rhs andalso
              Term.same_const rhs boolSyntax.T andalso
              guard(fn()=>Term.aconv lhs original)then ()else
            raise ERR "canonical_syntax" "anchor is not this assertion"
          val _=live()
      in original end))
  fun sc_shadow_step expected state raw step syntax ants=
    sr_fail expected(fn()=>W.with_step expected(fn()=>
      let fun guarded operation=
            (sc_state_guard expected state;scr_clause_guard expected raw;
             let val result=operation()
             in sc_state_guard expected state;
               scr_clause_guard expected raw;result end)
          val(result,held)=guarded(fn()=>case step of
              CanonicalConjunct left=>
                let val(a,b)=boolSyntax.dest_conj syntax
                in(if left then a else b,ants)end
            | CanonicalAntecedentConj=>
                let val(ant,body)=boolSyntax.dest_imp_only syntax
                    val(a,b)=boolSyntax.dest_conj ant
                in(boolSyntax.mk_imp(a,boolSyntax.mk_imp(b,body)),ants)end
            | CanonicalAntecedentDisj left=>
                let val(ant,body)=boolSyntax.dest_imp_only syntax
                    val(a,b)=boolSyntax.dest_disj ant
                in(boolSyntax.mk_imp(if left then a else b,body),ants)end
            | CanonicalUndisch=>
                let val(ant,body)=boolSyntax.dest_imp_only syntax
                in(body,ant::ants)end
            | CanonicalNotIntro=>
                (boolSyntax.mk_neg(#1(boolSyntax.dest_imp_only syntax)),ants)
            | CanonicalFinish=>
                (List.foldl(fn(ant,body)=>boolSyntax.mk_imp(ant,body))
                  syntax ants,[]))
          val SCRClausePlan {frame,...}=raw
          val _=sc_syntax_bound expected frame
            (#output_limit(W.semantic_limits expected))result
      in(result,held)end))
  fun sc_shadow_future expected state raw operation quotations syntax=
    sr_fail expected(fn()=>W.with_step expected(fn()=>
      let fun guarded action=
            (sc_state_guard expected state;scr_clause_guard expected raw;
             let val answer=action()
             in sc_state_guard expected state;
               scr_clause_guard expected raw;answer end)
          val variables=List.map(fn(name,ty)=>guarded(fn()=>
            Term.mk_var(name,ty)))quotations
          val result=case(operation,variables)of(CanonicalExists,[variable])=>
                let val(ant,body)=guarded(fn()=>
                      boolSyntax.dest_imp_only syntax)
                    val(v,part)=guarded(fn()=>boolSyntax.dest_exists ant)
                    val instance=guarded(fn()=>Term.subst
                      [{redex=v,residue=variable}]part)
                in guarded(fn()=>boolSyntax.mk_imp(instance,body))end
            | (CanonicalUniversals,variables)=>
                (* Synthetic proof is bounded quotation DATA only. Its
                   hypothesis and every SPEC conclusion are reserved by
                   the raw plan before this public kernel programme. No
                   proof or Hyp from here is adopted as Source evidence. *)
                let val temporary=guarded(fn()=>Thm.ASSUME syntax)
                    val specialized=guarded(fn()=>
                      Drule.SPECL variables temporary)
                in guarded(fn()=>Thm.concl specialized)end
            | _=>raise ERR "canonical_syntax" "quoted syntax frontier differs"
          val SCRClausePlan {frame,...}=raw
          val _=sc_syntax_bound expected frame
            (#output_limit(W.semantic_limits expected))result
      in result end))
  fun sc_check_shadow expected(state as SCState {evidence,...})syntax=
    sr_fail expected(fn()=>W.with_step expected(fn()=>
      let val _=sc_state_guard expected state
          val d=sce_data expected evidence
          val cap= #output_limit(W.semantic_limits expected)
          val _=sc_syntax_bound expected (#frame d)cap syntax
          val _=sc_syntax_bound expected (#frame d)cap(#target d)
          val _=if Term.aconv syntax(#target d)then ()else
            raise ERR "canonical_syntax" "shadow changed actual proof meaning"
          val _=sc_state_guard expected state
      in ()end))
  fun prepare_source_canonical_start expected {evidence,check_type}=
    sr_fail expected(fn()=>
      let val raw=prepare_source_canonical_clause expected
            {evidence=evidence,steps=[EvidenceAssertion],pending=[],
             finish=false,check_type=check_type,future=[],kind=NONE}
          val syntax=sc_capture_anchor expected evidence
          val value=SCPlan {work=expected,parent=NONE,raw=raw,
            ants=[],finish=false,phase=ref SCPrepared,
            syntax=syntax,syntax_ants=[]}
          val _=sc_plan_guard expected value
      in value end)
  fun source_canonical_current_for expected
      (state as SCState {evidence,...})=
    (sc_state_guard expected state;evidence)
  fun source_canonical_frontier_for expected
      (state as SCState {evidence,...})=
    sr_fail expected(fn()=>
      (sc_open expected state;
       W.with_step expected(fn()=>
         let fun guarded operation=
               (sc_state_guard expected state;W.spend expected 1;
                let val value=operation()
                in sc_state_guard expected state;value end)
             val term= #target(sce_data expected evidence)
             fun constant value=Term.is_const value andalso
               Term.same_const value boolSyntax.F
             val result=if boolSyntax.is_conj term then CanonicalConjunction
               else if boolSyntax.is_imp_only term then
                 let val(ant,body)=guarded(fn()=>
                       boolSyntax.dest_imp_only term)
                 in if boolSyntax.is_conj ant then
                      CanonicalAntecedentConjunction
                    else if boolSyntax.is_disj ant then
                      CanonicalAntecedentDisjunction
                    else if boolSyntax.is_exists ant then
                      CanonicalAntecedentExistential
                    else if constant body then CanonicalImpFalse
                    else CanonicalCondition end
               else if boolSyntax.is_forall term then CanonicalForall
               else if boolSyntax.is_res_forall term then
                 CanonicalRestrictedForall else CanonicalTerminal
             val _=sc_state_guard expected state
         in result end)))
  fun prepare_source_canonical_step expected
      {state=state as SCState {evidence,ants,syntax,syntax_ants,...},
       step,check_type}=
    sr_fail expected(fn()=>
      let val _=sc_open expected state
          val frontier=source_canonical_frontier_for expected state
          val(steps,finish)=case(step,frontier)of
              (CanonicalConjunct left,CanonicalConjunction)=>
                ([EvidenceStep(SourceConjunct left)],false)
            | (CanonicalAntecedentConj,CanonicalAntecedentConjunction)=>
                ([EvidenceAntecedentConj],false)
            | (CanonicalAntecedentDisj left,CanonicalAntecedentDisjunction)=>
                ([EvidenceAntecedentDisj left],false)
            | (CanonicalUndisch,CanonicalCondition)=>
                ([EvidenceStep SourceCondition],false)
            | (CanonicalNotIntro,CanonicalImpFalse)=>
                ([EvidenceImpFalse],false)
            | (CanonicalFinish,CanonicalTerminal)=>([],true)
            | _=>raise ERR "canonical_step" "step is not the actual frontier"
          val raw=prepare_source_canonical_clause expected
            {evidence=evidence,steps=steps,pending=ants,finish=finish,
             check_type=check_type,future=[],kind=NONE}
          val(next,held)=sc_shadow_step expected state raw
            step syntax syntax_ants
          val value=SCPlan {work=expected,parent=SOME state,raw=raw,
            ants=ants,finish=finish,phase=ref SCPrepared,
            syntax=next,syntax_ants=held}
          val _=sc_plan_guard expected value
      in value end)
  fun prepare_source_canonical_future expected
      {state=state as SCState {evidence,ants,syntax,syntax_ants,...},
       operation,quotations,
       check_type}=
    sr_fail expected(fn()=>
      let val _=sc_open expected state
          val frontier=source_canonical_frontier_for expected state
          val kind=case(operation,frontier,quotations)of
              (CanonicalExists,CanonicalAntecedentExistential,[_])=>SCRExists
            | (CanonicalUniversals,CanonicalForall,_::_)=>SCRSpecs
            | _=>raise ERR "canonical_future" "actual future frontier differs"
          val future=List.map(fn(name,ty)=>SCEFutureArgument
            {name=name,ty=ty,child=ref NONE})quotations
          val raw=prepare_source_canonical_clause expected
            {evidence=evidence,steps=[],pending=ants,finish=false,
             check_type=check_type,future=future,kind=SOME kind}
          val next=sc_shadow_future expected state raw
            operation quotations syntax
          val value=SCPlan {work=expected,parent=SOME state,raw=raw,
            ants=ants,finish=false,phase=ref SCPrepared,
            syntax=next,syntax_ants=syntax_ants}
          val _=sc_plan_guard expected value
      in value end)
  fun admit_source_canonical_plan expected
      (value as SCPlan {raw=SCRClausePlan {types,check_type,...},phase,...})=
    sc_operation expected value(fn()=>
      (sc_plan_guard expected value;
       if !phase=SCPrepared then ()else raise ERR "canonical_admit"
         "plan already admitted or consumed";
       phase:=SCAdmitting;
       W.with_step expected(fn()=>
         let fun guarded operation=
               (sc_plan_guard expected value;
                let val answer=operation()
                in sc_plan_guard expected value;answer end)
             fun materialize(SRCaptured ty)=guarded(fn()=>ty)
               | materialize(SRArrow(a,b))=
                   let val left=materialize a val right=materialize b
                   in guarded(fn()=>Type.mk_thy_type
                     {Thy="min",Tyop="fun",Args=[left,right]})end
             val actual=List.map materialize types
             val _=List.app(fn ty=>guarded(fn()=>check_type ty))actual
             val _=sc_plan_guard expected value
             val _=phase:=SCAdmitted
         in SCReady value end)))
  fun source_canonical_arguments_for expected
      (SCReady(value as SCPlan
        {raw=SCRClausePlan {frame,future,...},phase,...}))=
    sc_operation expected value(fn()=>
      (sc_plan_guard expected value;
       if !phase=SCAdmitted then ()else raise ERR "canonical_arguments"
         "ready is unavailable";
       {frame=frame,arguments=List.map
         (fn SCEFutureArgument {name,ty,...}=>(name,ty))future}))
  fun execute_source_canonical_plan expected
      {ready=SCReady(value as SCPlan
        {raw=raw as SCRClausePlan {frame,graph,future,...},
         ants,finish,phase,syntax,syntax_ants,...}),arguments}=
    sc_operation expected value(fn()=>
      (sc_plan_guard expected value;
       if !phase=SCAdmitted then ()else raise ERR "canonical_execute"
         "ready already consumed";
       W.with_step expected(fn()=>
         let val _=sc_plan_guard expected value
             val scope= #scope(Scope.description_for expected frame)
             val _=if length future=length arguments then ()else
               raise ERR "canonical_execute" "exact quoted argument count"
             fun bind(SCEFutureArgument {child,...},argument)=
               (if Option.isSome(!child)then raise ERR "canonical_execute"
                  "argument already bound"else ();
                child:=SOME argument)
             val _=ListPair.app bind(future,arguments)
             val _=List.app(fn held=>
               sce_future_guard graph scope(SOME held))future
             val _=sc_plan_guard expected value
         in ()end);
       let val(evidence,added)=execute_source_canonical_clause expected raw
           val _=sc_plan_guard expected value
           val _=phase:=SCConsumed
           val result=SCState {work=expected,evidence=evidence,
             ants=if finish then []else added@ants,finished=finish,
             syntax=syntax,syntax_ants=syntax_ants}
           val _=sc_state_guard expected result
           val _=sc_check_shadow expected result syntax
       in result end))
  fun source_canonical_finished_for expected
      (state as SCState {evidence,finished,...})=
    sr_fail expected(fn()=>
      (sc_state_guard expected state;
       if finished then evidence else raise ERR "canonical_finished"
         "actual stock antecedent stack is not discharged"))

  fun source_canonical_syntax_for expected
      (state as SCState {evidence,syntax,...})=
    (sc_state_guard expected state;
     {frame= #frame(sce_data expected evidence),statement=syntax})

  datatype source_restricted_plan=SCRestrictedPlan of
    {work:W.portfolio,parent:source_canonical_state,frame:Scope.receipt,
     law:Thm.thm,types:Type.hol_type list,check_type:Type.hol_type -> unit,
     prospective:Term.term,phase:sc_phase ref}
  datatype source_restricted_ready=SCRestrictedReady of source_restricted_plan
  fun sc_restricted_guard expected(SCRestrictedPlan
      {work,parent,frame,law,phase,...})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work)then ()else raise ERR
         "restricted_forall" "foreign expected Work";
       sc_state_guard expected parent;
       Scope.validate_lifetime_for expected frame;
       if !phase=SCDead then raise ERR "restricted_forall" "retired"else ();
       if null(Thm.hyp law) andalso clean law andalso
           Term.uptodate_term(Thm.concl law)then ()else raise ERR
         "restricted_forall" "fixed closed law changed"))
  fun sc_restricted_operation expected(value as SCRestrictedPlan
      {work,phase,...})operation=
    if Portable.pointer_eq(expected,work)then
      (operation()handle primary=>
        (phase:=SCDead;W.close expected;raise primary))
    else(W.close expected;raise ERR "restricted_forall" "foreign Work")
  fun prepare_source_canonical_restricted_forall expected
      {state=state as SCState {evidence,syntax,...},check_type}=
    sr_fail expected(fn()=>W.with_step expected(fn()=>
      let val _=sc_open expected state
          val d=sce_data expected evidence val frame= #frame d
          val limits=W.semantic_limits expected
          val output= #output_limit limits val template= #template_limit limits
          val budget=ref(0:IntInf.int)
          val policies=ref([]:Type.hol_type list)
          fun live()=(sc_state_guard expected state;
            Scope.validate_lifetime_for expected frame)
          fun tick n=(live();W.spend expected n)
          fun guarded operation=
            (live();let val answer=operation()in live();answer end)
          fun bounded cap term=
            (case SmtReplayImport.bounded_raw_size cap term of
               SOME n=>tick n | NONE=>raise ERR "restricted_quote"
                 "original raw allowance";
             case SmtReplayImport.bounded_binder_size cap term of
               SOME n=>tick n | NONE=>raise ERR "restricted_quote"
                 "original binder allowance")
          fun typ ty=
            (tick 1;policies:=ty:: !policies;
             if Type.is_vartype ty then
               (tick(String.size(Type.dest_vartype ty));1)
             else let val {Thy,Tyop,Args}=Type.dest_thy_type ty
                      val _=tick(String.size Thy+String.size Tyop)
                  in 1+List.foldl(fn(arg,n)=>n+typ arg)0 Args end)
          fun metrics term=
            let val _=tick 1 val annotations=typ(Term.type_of term)
            in if Term.is_abs term then
                let val(v,b)=Term.dest_abs term
                    val binder=typ(Term.type_of v)
                    val(r,i,a)=metrics b
                in(1+r,2+i,annotations+binder+a)end
              else if Term.is_comb term then
                let val(f,x)=Term.dest_comb term
                    val(r,i,a)=metrics f val(s,j,b)=metrics x
                in(1+r+s,1+i+j,annotations+a+b)end
              else(1,1,annotations)end
          fun record cap hypotheses result=
            let val _=bounded cap result
                fun cost term=
                  let val _=bounded template term val(r,i,a)=metrics term
                  in IntInf.fromInt(r+i+a)end
                val amount=List.foldl(fn(term,n)=>n+cost term)0
                  (result::hypotheses)
                val _=budget:= !budget+amount
            in if !budget<=remaining expected then ()else raise ERR
              "restricted_quote" "original cumulative Work"end
          val initial= #target d
          val _=bounded output initial val _=bounded output syntax
          val _=if guarded(fn()=>boolSyntax.is_res_forall initial) andalso
              guarded(fn()=>Term.aconv initial syntax)then ()else raise ERR
            "restricted_quote" "actual frontier is not restricted forall"
          val law=boolTheory.RES_FORALL_THM
          val lawterm=guarded(fn()=>Thm.concl law)
          val _=if null(Thm.hyp law) andalso clean law then ()else raise ERR
            "restricted_quote" "fixed helper is not closed cleanly"
          val _=bounded template lawterm
          val(v,guard,_)=guarded(fn()=>boolSyntax.dest_res_forall initial)
          val(_,predicate)=guarded(fn()=>Term.dest_comb initial)
          val domain=guarded(fn()=>Term.type_of v)
          val typed=guarded(fn()=>Term.inst
            [{redex=Type.alpha,residue=domain}]lawterm)
          val _=bounded template typed
          fun spec argument term=
            let val(_,abstraction)=guarded(fn()=>Term.dest_comb term)
                val application=guarded(fn()=>
                  Term.mk_comb(abstraction,argument))
                val _=record template []application
            in guarded(fn()=>Term.beta_conv application)end
          val once=spec guard typed val helper=spec predicate once
          val(left,generalized)=guarded(fn()=>boolSyntax.dest_eq helper)
          val _=if guarded(fn()=>Term.aconv left initial)then ()else
            raise ERR "restricted_quote" "fixed law does not match frontier"
          val(variable,body)=guarded(fn()=>boolSyntax.dest_forall generalized)
          val(ant,redex)=guarded(fn()=>boolSyntax.dest_imp_only body)
          val contracted=guarded(fn()=>Term.beta_conv redex)
          val point=guarded(fn()=>boolSyntax.mk_imp(ant,contracted))
          val result=guarded(fn()=>boolSyntax.mk_forall(variable,point))
          fun eq(a,b)=guarded(fn()=>boolSyntax.mk_eq(a,b))
          val hypotheses=guarded(fn()=>Thm.hyp(#proof d))
          (* G.import's recursive application/abstraction bridges also
             have typed equality headers. Quote every fixed-law subterm
             reflexive operand, including function-typed prefixes. *)
          fun bridges term=
            (record template [](eq(term,term));
             if Term.is_abs term then
               let val(v,b)=guarded(fn()=>Term.dest_abs term)
               in bridges v;bridges b end
             else if Term.is_comb term then
               let val(f,x)=guarded(fn()=>Term.dest_comb term)
               in bridges f;bridges x end else ())
          val _=bridges lawterm
          val _=record template []lawterm
          val _=record template []typed val _=record template []once
          val _=record template []helper
          val _=record template [](eq(redex,contracted))
          val _=record template [](eq(body,point))
          val(all_head,abstraction)=guarded(fn()=>Term.dest_comb generalized)
          val(partial,_)=guarded(fn()=>Term.dest_comb body)
          val _=record template [](eq(partial,partial))
          val _=record template [](eq(all_head,all_head))
          val next_abs=guarded(fn()=>Term.mk_abs(variable,point))
          val _=record template [](eq(abstraction,next_abs))
          val _=record template [](eq(generalized,result))
          val _=record template [](eq(initial,result))
          (* Opened import law bridge, local conversion ALPHA bridges and
             their TRANS/EQ_MP footprints remain template operands. *)
          val _=List.app(fn term=>
            (record template [](eq(term,term));
             record template [](eq(term,term))))[lawterm,initial,result]
          val _=record output hypotheses result
          val _=record output [initial]initial
          val _=record output [initial]result
          val _=record template []syntax
          val _=record template [](eq(syntax,syntax))
          val _=pay expected(!budget)
          val _=live()
      in SCRestrictedPlan {work=expected,parent=state,frame=frame,law=law,
        types=List.rev(!policies),check_type=check_type,
        prospective=result,phase=ref SCPrepared}end))
  fun admit_source_canonical_restricted_forall expected
      (value as SCRestrictedPlan {types,check_type,phase,...})=
    sc_restricted_operation expected value(fn()=>
      (sc_restricted_guard expected value;
       if !phase=SCPrepared then ()else raise ERR
         "restricted_admit" "already admitted or consumed";
       phase:=SCAdmitting;
       W.with_step expected(fn()=>
         List.app(fn ty=>(sc_restricted_guard expected value;
           check_type ty;sc_restricted_guard expected value))types);
       phase:=SCAdmitted;sc_restricted_guard expected value;
       SCRestrictedReady value))
  fun execute_source_canonical_restricted_forall expected
      (SCRestrictedReady(value as SCRestrictedPlan
        {parent=parent as SCState {evidence,ants,syntax,syntax_ants,...},
         frame,law,prospective,phase,...}))=
    sc_restricted_operation expected value(fn()=>
      (sc_restricted_guard expected value;
       if !phase=SCAdmitted then ()else raise ERR
         "restricted_execute" "not admitted or already consumed";
       phase:=SCConsumed;
       W.with_step expected(fn()=>
       let val d=sce_data expected evidence
           val sd=Scope.description_for expected frame
           val graph= #graph sd val scope= #scope sd
           val cap= #template_limit(W.semantic_limits expected)
           fun guarded operation=
             (sc_restricted_guard expected value;
              let val answer=operation()
              in sc_restricted_guard expected value;answer end)
           (* This private fixed helper is imported/opened only after the
              complete conversion/Hyp/types portfolio and policies. *)
           val imported=guarded(fn()=>G.import graph scope cap(Thm.concl law))
           val opened=guarded(fn()=>G.record_opened_view graph scope cap
             (#node imported))
           val fact=guarded(fn()=>record_closed_from_import graph scope
             {node= #node opened,theorem=law,template_limit=cap,
              check_type=fn _=>()})
           val _=guarded(fn()=>validate_closed_fact graph scope cap fact)
           val held=guarded(fn()=>G.closure_root graph scope(#node opened))
           val conv=Conv.THENC(Conv.REWR_CONV(closed_original fact),
             Conv.QUANT_CONV(Conv.RAND_CONV Thm.BETA_CONV))
           val proof=guarded(fn()=>Conv.CONV_RULE conv(#proof d))
           val _=if guarded(fn()=>Term.aconv(Thm.concl proof)prospective)
               andalso clean proof then ()else raise ERR
             "restricted_execute" "quoted native conversion differs"
           (* Exact stock native syntax only; this bounded synthetic
              theorem is discarded, never adopted as Source authority. *)
           val temporary=guarded(fn()=>Thm.ASSUME syntax)
           val quoted=guarded(fn()=>Conv.CONV_RULE conv temporary)
           val next_syntax=guarded(fn()=>Thm.concl quoted)
           val _=sc_syntax_bound expected frame
             (#output_limit(W.semantic_limits expected))next_syntax
           val _=if guarded(fn()=>Term.aconv next_syntax
               (Thm.concl proof))then ()else raise ERR
             "restricted_execute" "stock syntax shadow changed proof meaning"
           fun origin term=
             (sc_restricted_guard expected value;
              if Term.is_abs term then
                let val(v,b)=Term.dest_abs term
                in SCOLam(v,origin b)end
              else if Term.is_comb term then
                let val(f,x)=Term.dest_comb term
                in SCOApp(origin f,origin x)end else SCOAtom)
           val result=SCEApplied {work=expected,frame=frame,parents=[evidence],
             proof=proof,target=Thm.concl proof,names= #names d,rows= #rows d,
             origin=origin prospective,constructor_origins=NONE,
             effect_origins=NONE,
             realized=ref NONE}
           val result=SCEProjected {work=expected,graph=graph,caller=scope,
             children=[held],value=result,permutative=NONE}
           val state=SCState {work=expected,evidence=result,ants=ants,
             finished=false,syntax=next_syntax,syntax_ants=syntax_ants}
           val _=sc_state_guard expected state
           val _=guarded(fn()=>validate_closed_fact graph scope cap fact)
       in state end)before sc_restricted_guard expected value))

  fun source_condition_statement_for expected evidence=
    sr_fail expected(fn()=>
      let val _=sce_guard expected evidence
          val d=sce_data expected evidence
          val _=Scope.validate_lifetime_for expected (#frame d)
      in {frame= #frame d,statement= #target d}end)

  (* Hyp-only typed metadata for the actual compact proof/support rows.
     Conclusion-only variables are not added; unknown origins stay explicit.
     No theorem, mint, absence or generic raw-syntax permission is issued. *)
  datatype source_hyp_fv_origins=SourceHypFVOrigins of
    {work:W.portfolio,evidence:source_condition_evidence,
     frame:Scope.receipt,statement:Term.term,variables:Term.term list,
     unknown:G.node list}
  (* The actual compact proof vocabulary is interpreted through its held
     graph names. An unknown opaque FV summary stays unknown. This exposes
     no theorem and does not issue a variable, closure or proof allowance. *)
  fun prepare_source_condition_hyp_fv_origins expected evidence=
    sr_fail expected(fn()=>W.with_step expected(fn()=>
    let val d=sce_data expected evidence
        val frame= #frame d
        val actual=Scope.description_for expected frame
        val graph= #graph actual
        fun guard()=(sce_guard expected evidence;
          Scope.validate_lifetime_for expected frame)
        fun tick n=(guard();W.spend expected n)
        fun guarded operation=
          (guard();let val value=operation()in guard();value end)
        fun member term values=List.exists
          (fn old=>(tick 1;Term.term_eq term old))values
        fun add term values=if member term values then values else
          (tick 1;term::values)
        fun union values result=List.foldl
          (fn(term,all)=>add term all)result values
        fun lookup term []=NONE
          | lookup term((node,name)::rest)=
              (tick 1;if Term.term_eq term name then SOME node else
                lookup term rest)
        val unknown=ref([]:G.node list)
        fun remember node=if List.exists
          (fn old=>(tick 1;old=node))(!unknown)then ()else
            unknown:=node:: !unknown
        fun native_variables node=
          let val term=guarded(fn()=>G.representative graph node)
              val cap= #template_limit(W.semantic_limits expected)
              (* FIRST witness only public syntax. Any abstraction is
                 deferred before dest_abs/count_body/kernel Beta work. *)
              fun binder_free current=
                let fun pending [] visits=SOME visits
                      | pending(current::rest)visits=
                        if visits>=cap then NONE else
                          (tick 1;
                           if Term.is_abs current then NONE
                           else if Term.is_comb current then
                             let val(f,x)=guarded(fn()=>
                                       Term.dest_comb current)
                             in pending(f::x::rest)(visits+1)end
                           else pending rest(visits+1))
                in pending[current]0 end
              val raw=case binder_free term of NONE=>NONE | SOME _=>
                guarded(fn()=>SmtReplayImport.bounded_raw_size cap term)
          in case raw of NONE=>NONE | SOME r=>
            let val inclusive=guarded(fn()=>
                  SmtReplayImport.bounded_binder_size cap term)
            in case inclusive of NONE=>NONE | SOME i=>
              let val _=tick(r+i)
                  val quote=ref(0:IntInf.int)
                  fun future n=
                    (quote:= !quote+IntInf.fromInt n;
                     if !quote<=remaining expected then ()else raise ERR
                       "source_condition_hyp_fv" "original metadata Work")
                  fun types ty=
                    let fun pending []=()
                          | pending([]::rest)=pending rest
                          | pending((current::args)::rest)=
                            (tick 1;future 1;
                             if Type.is_vartype current then
                               (future(String.size
                                  (Type.dest_vartype current)+1);
                                pending(args::rest))
                             else let val {Thy,Tyop,Args}=guarded(fn()=>
                                        Type.dest_thy_type current)
                                      val _=future(String.size Thy+
                                        String.size Tyop+1)
                                  in pending(Args::args::rest)end)
                    in pending[[ty]]end
                  (* Both original bounds precede this prospective type/
                     identifier/visit scan. Explicit worklists retain the
                     exact original preorder and repeated type events. *)
                  fun profile term=
                    let fun pending []=()
                          | pending(current::rest)=
                            (tick 1;future 1;types(Term.type_of current);
                             if Term.is_abs current then
                               let val(v,body)=guarded(fn()=>
                                         Term.dest_abs current)
                                   val(name,_)=guarded(fn()=>Term.dest_var v)
                                   val _=future(String.size name+1)
                                   val _=types(Term.type_of v)
                               in pending(body::rest)end
                             else if Term.is_comb current then
                               let val(f,x)=guarded(fn()=>
                                         Term.dest_comb current)
                               in pending(f::x::rest)end
                             else if Term.is_var current then
                               let val(name,_)=guarded(fn()=>
                                         Term.dest_var current)
                                   val _=future(String.size name+1)
                               in pending rest end else pending rest)
                    in pending[term]end
                  val _=profile term val _=pay expected(!quote)
                  (* ACTUAL semantic Source/Hyp syntax: compact #names is
                     deliberately not applied to original native VARs. *)
                  fun free bound current values=
                    (guard();if Term.is_var current then
                       if member current bound then values else
                         add current values
                     else if Term.is_abs current then
                       let val(v,body)=guarded(fn()=>Term.dest_abs current)
                       in free(v::bound)body values end
                     else if Term.is_comb current then
                       let val(f,x)=guarded(fn()=>Term.dest_comb current)
                       in free bound x(free bound f values)end else values)
                  val values=free []term[] val _=guard()
              in SOME values end
            end
          end
        fun variables node=
          case guarded(fn()=>G.free_variable_nodes graph node)of
            NONE=>(case native_variables node of SOME values=>values
              | NONE=>(remember node;[]))
          | SOME nodes=>
              List.map(fn variable=>(tick 1;
                guarded(fn()=>G.representative graph variable)))nodes
        fun walk bound term result=
          (tick 1;let val all=result in
           if Term.is_var term then
             if member term bound then all else
               (case lookup term (#names d)of NONE=>add term all
                | SOME node=>union(variables node)all)
           else if Term.is_comb term then
             let val(a,b)=guarded(fn()=>Term.dest_comb term)
             in walk bound b (walk bound a all)end
           else if Term.is_abs term then
             let val(v,body)=guarded(fn()=>Term.dest_abs term)
             in walk(v::bound)body all end
           else all end)
        (* This is the SAME exact witness interpretation as realization:
           closed Definition/fact/conversion rows have no Source Hyp.
           Native named proof Hyp also contains those private rows and
           cannot itself be interpreted as Original Source rigidity. *)
        val roots=ref([]:G.node list)
        fun root node=
          (tick 1;if List.exists(fn old=>(tick 1;old=node))(!roots)
             then ()else roots:=node:: !roots)
        fun inherited(parent as SourceRealization
            {graph=actual,occurrences,theorem,...})=
          (source_realization_guard expected parent;
           if Portable.pointer_eq(actual,graph)then ()else
             raise ERR "source_condition_hyp_fv"
               "foreign authentic cut Source graph";
           List.app(fn hypothesis=>
             let val matching=List.filter(fn(_,node)=>
                   (tick 1;Portable.pointer_eq(hypothesis,
                     guarded(fn()=>G.representative graph node))))
                   occurrences
                 val _=if null matching then raise ERR
                   "source_condition_hyp_fv"
                   "actual cut Hyp has no retained Source occurrence"
                   else ()
             in List.app(root o #2)matching end)(Thm.hyp theorem))
        fun closed theorem=
          if null(Thm.hyp theorem)then ()else raise ERR
            "source_condition_hyp_fv" "closed row has actual hypotheses"
        fun witness(SCEWitness(recipe as SourceRuleRecipe
            {base=SourceCompact {block=Block {leaves,...},cuts,
                                 extra_leaves,...},...},index))=
          (validate_source_rule_for expected recipe;
           case List.find(fn(slot,_,_)=>(tick 1;slot=index))cuts of
             SOME(_,_,parent)=>inherited parent
           | NONE=>case (if index<Vector.length leaves then
                 Vector.sub(leaves,index)else
                 List.nth(extra_leaves,index-Vector.length leaves))of
               Source node=>root node
             | ClosedWitness fact=>
                 (validate_closed_fact graph (#scope actual)
                   (#template_limit(W.semantic_limits expected))fact;
                  closed(closed_proof fact))
             | ConversionWitness conversion=>
                 (validate_conversion_for expected conversion;
                  closed(conversion_proof conversion))
             | Definition _=>())
        val cap= #template_limit(W.semantic_limits expected)
        fun bounded term=
          (case SmtReplayImport.bounded_raw_size cap term of
             SOME n=>tick n | NONE=>raise ERR "source_condition_hyp_fv"
               "unknown unbounded actual local Hyp";
           case SmtReplayImport.bounded_binder_size cap term of
             SOME n=>tick n | NONE=>raise ERR "source_condition_hyp_fv"
               "unknown unbounded actual binder Hyp")
        (* Pointer-first: a protected authentic row can be resolved without
           opening its raw native Source residue. Structural fallback is
           permitted only after BOTH local operands pass original template
           bounds; an unbounded unmatched Hyp never becomes empty FV. *)
        fun pointer_rows hypothesis=List.filter(fn(value,_)=>
          (tick 1;Portable.pointer_eq(hypothesis,value)))(#rows d)
        fun small term=case SmtReplayImport.bounded_raw_size cap term of
            NONE=>false | SOME n=>(tick n;
              case SmtReplayImport.bounded_binder_size cap term of
                NONE=>false | SOME n=>(tick n;true))
        fun equivalent_rows hypothesis=
          List.filter(fn(value,_)=>(tick 1;
            small value andalso guarded(fn()=>Term.aconv hypothesis value)))
            (#rows d)
        val context=guarded(fn()=>tree_term
          (Vector.fromList(List.map #1(#rows d)))
          (make_tree 0(length(#rows d))))
        fun dense hypothesis=
          Portable.pointer_eq(hypothesis,context) orelse
          (small context andalso guarded(fn()=>Term.aconv hypothesis context))
        (* The fast receiver never changes the old fallback decision. *)
        val admitted=ref(NONE:
          (Term.term*sr_tree option)list option)
        fun actual_forest hypothesis=
          let val values=case !admitted of SOME values=>values
                | NONE=>
                    let val values=sce_admitted_hyp_rows_inside
                          expected evidence
                        val _=tick 2 val _=admitted:=SOME values
                    in values end
              fun find []=NONE
                | find((actual,value)::rest)=
                    (tick 1;if Portable.pointer_eq(hypothesis,actual)
                     then value else find rest)
          in find values end
        fun forest_free tree result=
          let fun walk [] values=values
                | walk((SRTree{shape,...})::rest)values=
                    (tick 1;case shape of SRAtom term=>
                       if guarded(fn()=>Term.is_var term)then
                         (case lookup term(#names d)of NONE=>
                            walk rest(add term values)
                          | SOME node=>walk rest(union(variables node)values))
                       else walk rest values
                     | SRBound _=>walk rest values
                     | SRApp(a,b)=>walk(a::b::rest)values
                     | SRLam(_,_,body)=>walk(body::rest)values
                     | SRFresh _=>raise ERR "source_condition_hyp_fv"
                         "actual admitted forest retained virtual variable")
          in walk[tree]result end
        fun fast_hyp hypothesis known=
          case sce_admitted_row_programme_inside expected evidence of
            NONE=>NONE
          | SOME{plan,fresh,admission,rows}=>
              (case actual_forest hypothesis of NONE=>NONE
               | SOME forest=>
                   if sr_raw forest>IntInf.fromInt cap orelse
                       sr_inc forest>IntInf.fromInt cap then NONE else
                   case sr_admitted_forest_programme expected plan fresh
                       admission[hypothesis]of NONE=>NONE
                   | SOME{matches,...}=>
                       (case matches hypothesis of NONE=>NONE
                        | SOME hits=>
                            let fun count [] result=result
                                  | count(_::rest)result=
                                      (tick 1;count rest(result+1))
                                val row_count=count rows 0
                                fun nth 0(value::_)=(tick 1;value)
                                  | nth n(_::rest)=(tick 1;nth(n-1)rest)
                                  | nth _ []=raise ERR
                                      "source_condition_hyp_fv"
                                      "admitted row index mismatch"
                                val _=tick 2
                                val dense=List.exists(fn(index,_)=>
                                  (tick 1;index=row_count))hits
                                val selected=if dense then rows else
                                  List.map(fn(index,_)=>
                                    (tick 2;nth index rows))hits
                                val _=guard()
                            in if null selected then
                                 SOME(forest_free forest known)
                               else(List.app(fn(_,held)=>
                                 (tick 1;witness held))selected;SOME known)
                            end))
        fun actual_hyp hypothesis known=
          let val direct=pointer_rows hypothesis
              val rows=if null direct then
                (bounded hypothesis;
                 if dense hypothesis then #rows d else
                   equivalent_rows hypothesis)else direct
          in if null rows then walk [] hypothesis known else
               (List.app(fn(_,held)=>(tick 1;witness held))rows;known)end
        fun admitted_actual_hyp hypothesis known=
          let val direct=pointer_rows hypothesis
          in if not(null direct)then
               (List.app(fn(_,held)=>(tick 1;witness held))direct;known)
             else case fast_hyp hypothesis known of SOME value=>value
               | NONE=>actual_hyp hypothesis known end
        val local_free=List.foldl(fn(hypothesis,known)=>
          admitted_actual_hyp hypothesis known)[]
          (guarded(fn()=>Thm.hyp(#proof d)))
        val free=List.foldl(fn(node,all)=>
          union(variables node)all)local_free(List.rev(!roots))
        val _=guard()
    in SourceHypFVOrigins {work=expected,evidence=evidence,frame=frame,
      statement= #target d,variables=free,unknown=List.rev(!unknown)}end))
  fun source_condition_hyp_fv_origins_for expected
      (SourceHypFVOrigins {work,evidence,frame,statement,variables,
                               unknown})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work)then ()else
         raise ERR "hyp_fv_origins" "foreign expected Work";
       sce_guard expected evidence;
       Scope.validate_lifetime_for expected frame;
       let val d=Scope.description_for expected frame
           val _=List.app(fn node=>ignore(G.view (#graph d)node))unknown
       in {frame=frame,statement=statement,variables=variables,
         unknown=unknown}end))

  datatype source_hyp_fv_membership=HypVariablePresent | HypVariableAbsent
    | HypVariableUnresolved of G.node list
  fun source_condition_hyp_fv_membership_for expected origins variable=
    sr_fail expected(fn()=>
      let val d=source_condition_hyp_fv_origins_for expected origins
          val _=if Term.is_var variable andalso
              Term.uptodate_term variable then ()else raise ERR
            "hyp_fv_membership" "question must be an actual typed VARIABLE"
      in W.with_step expected(fn()=>
        let fun same held=
              (ignore(source_condition_hyp_fv_origins_for expected origins);
               W.spend expected 1;Term.term_eq held variable)
            val found=List.exists same(#variables d)
            val _=ignore
              (source_condition_hyp_fv_origins_for expected origins)
        in if found then HypVariablePresent else
          if null(#unknown d)then HypVariableAbsent else
            HypVariableUnresolved(#unknown d)end)
      end)

  datatype source_false_law_plan=SourceFalseLawPlan of
    {work:W.portfolio,evidence:source_condition_evidence,
     frame:Scope.receipt,graph:G.graph,scope:G.scope,
     statement:Term.term,result:Term.term,origin:sce_origin_tree,
     types:Type.hol_type list,check_type:Type.hol_type -> unit,
     phase:sc_phase ref}
  datatype source_false_law_ready=SourceFalseLawReady of
    source_false_law_plan
  fun source_false_law_guard expected(SourceFalseLawPlan
      {work,evidence,frame,graph,scope,statement,phase,...})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work)then ()else raise ERR
         "source_false_law" "foreign expected Work";
       sce_guard expected evidence;
       let val data=Scope.description_for expected frame
       in if Portable.pointer_eq(#graph data,graph)andalso #scope data=scope
           andalso Term.uptodate_term statement then ()else raise ERR
         "source_false_law" "original frame or fixed statement changed"end;
       if !phase=SCDead then raise ERR "source_false_law" "retired"else ()))
  fun source_false_law_operation expected(value as SourceFalseLawPlan
      {work,phase,...})operation=
    if Portable.pointer_eq(expected,work)then
      (operation()handle primary=>
        (phase:=SCDead;W.close expected;raise primary))
    else(W.close expected;raise ERR "source_false_law"
      "foreign expected Work")
  fun prepare_source_false_law expected{evidence,law_statement,check_type}=
    sr_fail expected(fn()=>W.with_step expected(fn()=>
      let val d=sce_data expected evidence val frame= #frame d
          val sd=Scope.description_for expected frame
          val graph= #graph sd val scope= #scope sd
          val limits=W.semantic_limits expected
          val output= #output_limit limits val template= #template_limit limits
          val budget=ref(0:IntInf.int)
          val policies=ref([]:Type.hol_type list)
          fun live()=(sce_guard expected evidence;
            Scope.validate_lifetime_for expected frame)
          fun tick n=(live();W.spend expected n)
          fun guarded operation=
            (live();let val answer=operation()in live();answer end)
          fun bounded cap term=
            (case SmtReplayImport.bounded_raw_size cap term of
               SOME n=>tick n | NONE=>raise ERR "source_false_quote"
                 "original raw allowance";
             case SmtReplayImport.bounded_binder_size cap term of
               SOME n=>tick n | NONE=>raise ERR "source_false_quote"
                 "original binder allowance")
          fun typ ty=
            (tick 1;policies:=ty:: !policies;
             if Type.is_vartype ty then
               (tick(String.size(Type.dest_vartype ty));1)
             else let val {Thy,Tyop,Args}=Type.dest_thy_type ty
                      val _=tick(String.size Thy+String.size Tyop)
                  in 1+List.foldl(fn(arg,n)=>n+typ arg)0 Args end)
          fun metrics term=
            let val _=tick 1 val annotations=typ(Term.type_of term)
            in if Term.is_abs term then
                let val(v,b)=Term.dest_abs term
                    val binder=typ(Term.type_of v)
                    val(r,i,a)=metrics b
                in(1+r,2+i,annotations+binder+a)end
              else if Term.is_comb term then
                let val(f,x)=Term.dest_comb term
                    val(r,i,a)=metrics f val(s,j,b)=metrics x
                in(1+r+s,1+i+j,annotations+a+b)end
              else(1,1,annotations)end
          fun record cap hypotheses result=
            let val _=bounded cap result
                fun cost term=
                  let val _=bounded template term val(r,i,a)=metrics term
                  in IntInf.fromInt(r+i+a)end
                val amount=List.foldl(fn(term,n)=>n+cost term)0
                  (result::hypotheses)
                val _=budget:= !budget+amount
            in if !budget<=remaining expected then ()else raise ERR
              "source_false_quote" "original cumulative Work"end
          fun constant term value=Term.is_const term andalso
            Term.same_const term value
          (* Reject foreign grammar before any count_body/Beta metric. *)
          val _=if guarded(fn()=>boolSyntax.is_imp_only law_statement)
            then ()else raise ERR "source_false_quote"
              "not the exact F or distinct truth conditional operand"
          val(antecedent,result)=guarded(fn()=>
            boolSyntax.dest_imp_only law_statement)
          val _=if guarded(fn()=>boolSyntax.is_eq result)then ()else
            raise ERR "source_false_quote"
              "not the exact F or distinct truth conditional operand"
          val(variable,right)=guarded(fn()=>boolSyntax.dest_eq result)
          fun false_condition term=constant term boolSyntax.F orelse
            (boolSyntax.is_eq term andalso
             let val(a,b)=boolSyntax.dest_eq term
             in (constant a boolSyntax.T andalso constant b boolSyntax.F)
               orelse(constant a boolSyntax.F andalso
                 constant b boolSyntax.T)end)
          val _=if guarded(fn()=>false_condition antecedent)andalso
              guarded(fn()=>Term.is_var variable)andalso
              Type.compare(Term.type_of variable,Type.bool)=EQUAL andalso
              guarded(fn()=>constant right boolSyntax.F)andalso
              guarded(fn()=>Term.aconv antecedent(#target d))then ()else
            raise ERR "source_false_quote"
              "not the exact F or distinct truth conditional operand"
          val _=bounded template law_statement
          (* Later realization substitutes the authentic parent vocabulary.
             The fixed stock variable must survive that actual sigma. *)
          val _=List.app(fn(node,named)=>
            (tick 1;if Term.term_eq variable named then
               if guarded(fn()=>Term.aconv variable
                   (G.representative graph node))then ()else raise ERR
                 "source_false_quote"
                 "captured stock variable conflicts with parent vocabulary"
             else ()))(#names d)
          val hypotheses=guarded(fn()=>Thm.hyp(#proof d))
          fun eq(a,b)=guarded(fn()=>boolSyntax.mk_eq(a,b))
          (* Every actual fixed import bridge input/header/result is quoted
             before the high-level producer imports the law. *)
          fun bridges term=
            (record template [](eq(term,term));
             if Term.is_abs term then
               let val(v,b)=guarded(fn()=>Term.dest_abs term)
               in bridges v;bridges b end
             else if Term.is_comb term then
               let val(f,x)=guarded(fn()=>Term.dest_comb term)
               in bridges f;bridges x end else ())
          val _=bridges law_statement
          val _=record template []law_statement
          (* Whole original/canonical import bridge TRANS and EQ_MP. *)
          val _=record template [](eq(law_statement,law_statement))
          val _=record template [](eq(law_statement,law_statement))
          val _=record template []law_statement
          (* Actual MP operands/results retain every compact Hyp incidence.
             Native MP introduces no law Hyp because fact must be closed. *)
          val _=record output hypotheses(#target d)
          val _=record output hypotheses result
          val _=record template hypotheses(eq(result,result))
          fun origin term=
            (tick 1;if Term.is_comb term then
               let val(f,x)=guarded(fn()=>Term.dest_comb term)
               in SCOApp(origin f,origin x)end else SCOAtom)
          val retained_origin=origin result
          val _=pay expected(!budget)
          val _=live()
      in SourceFalseLawPlan{work=expected,evidence=evidence,frame=frame,
        graph=graph,scope=scope,statement=law_statement,result=result,
        origin=retained_origin,types=List.rev(!policies),
        check_type=check_type,phase=ref SCPrepared}end))
  fun admit_source_false_law expected
      (value as SourceFalseLawPlan{types,check_type,phase,...})=
    source_false_law_operation expected value(fn()=>
      (source_false_law_guard expected value;
       if !phase=SCPrepared then ()else raise ERR "source_false_admit"
         "already admitted or consumed";
       phase:=SCAdmitting;
       W.with_step expected(fn()=>List.app(fn ty=>
         (source_false_law_guard expected value;check_type ty;
          source_false_law_guard expected value))types);
       phase:=SCAdmitted;source_false_law_guard expected value;
       SourceFalseLawReady value))
  fun execute_source_false_law expected
      {ready=SourceFalseLawReady(value as SourceFalseLawPlan
        {evidence,frame,graph,scope,statement,result,origin,phase,...}),
       law=law as ClosedFact{graph=held_graph,scope=held_scope,
         template_limit,...}}=
    source_false_law_operation expected value(fn()=>
      (source_false_law_guard expected value;
       if !phase=SCAdmitted then ()else raise ERR "source_false_execute"
         "not admitted or already consumed";
       (* Pure expected owner fields precede any held closed-law activation.
          Equal root IDs on a foreign graph are never ownership authority. *)
       if Portable.pointer_eq(graph,held_graph)andalso
           template_limit= #template_limit(W.semantic_limits expected)
         then ()else raise ERR "source_false_execute"
           "foreign closed law graph or original cap";
       phase:=SCConsumed;
       W.with_step expected(fn()=>
       let val d=sce_data expected evidence
           fun guarded operation=
             (source_false_law_guard expected value;
              let val answer=operation()
              in source_false_law_guard expected value;answer end)
           val _=guarded(fn()=>validate_closed_fact graph scope
             template_limit law)
           val theorem=guarded(fn()=>closed_original law)
           val _=if null(Thm.hyp theorem)andalso clean theorem andalso
               guarded(fn()=>Term.aconv(Thm.concl theorem)statement)then ()
             else raise ERR "source_false_execute"
               "closed law differs from prospective operand"
           val held=guarded(fn()=>G.closure_root graph scope(closed_node law))
           val proof=guarded(fn()=>SmtReplayRuleObservation.MP
             theorem(#proof d))
           val _=if clean proof andalso
               guarded(fn()=>Term.aconv(Thm.concl proof)result)then ()else
             raise ERR "source_false_execute" "native result changed"
           val child=SCEApplied{work=expected,frame=frame,parents=[evidence],
             proof=proof,target=Thm.concl proof,names= #names d,rows= #rows d,
             origin=origin,constructor_origins=NONE,
             effect_origins=NONE,
             realized=ref NONE}
           val retained=SCEProjected{work=expected,graph=graph,caller=scope,
             children=[held],value=child,permutative=NONE}
           val _=sce_guard expected retained
           val _=guarded(fn()=>validate_closed_fact graph scope
             template_limit law)
       in retained end)))
    | execute_source_false_law expected
        {ready=SourceFalseLawReady value,law=PolicyRealizedClosedFact _}=
        source_false_law_operation expected value (fn()=>
          raise ERR "source_false_execute" "policy law programme required")

  (* Only the authentic ordered EQT / SYM-EQT loop pair can share admission.
     Both original quotes are consumed once; private copies carry no policy
     authority and never escape this producer. *)
  datatype source_condition_loop_phase=SCLPrepared | SCLAdmitting
    | SCLReady | SCLExecuting | SCLDone | SCLDead
  datatype source_condition_loop_plan=SourceConditionLoopPlan of
    {work:W.portfolio,first:source_condition_rule_plan,
     second:source_condition_rule_plan,phase:source_condition_loop_phase ref}
  datatype source_condition_loop_ready=SourceConditionLoopReady of
    source_condition_loop_plan
  fun source_condition_loop_guard expected(SourceConditionLoopPlan
      {work,first,second,phase})=
    (if Portable.pointer_eq(expected,work)then ()else raise ERR
       "source_condition_loop" "foreign expected Work";
     if !phase=SCLDead orelse !phase=SCLDone then raise ERR
       "source_condition_loop" "loop batch consumed"else ();
     sce_clause_guard expected first;
     sce_clause_guard expected second)
  fun source_condition_loop_operation expected
      (value as SourceConditionLoopPlan{work,phase,...})operation=
    if Portable.pointer_eq(expected,work)then
      (operation()handle primary=>
        (phase:=SCLDead;W.close expected;raise primary))
    else(W.close expected;raise ERR
      "source_condition_loop" "foreign expected Work")
  fun prepare_source_condition_loop expected
      {first=first as SCEClausePlan
         {work=w1,evidence=e1,frame=f1,graph=g1,caller=c1,scope=s1,
          children=ch1,conditions=co1,instructions=i1,terminal=t1,used=u1,...},
       second=second as SCEClausePlan
         {work=w2,evidence=e2,frame=f2,graph=g2,caller=c2,scope=s2,
          children=ch2,conditions=co2,instructions=i2,terminal=t2,
          used=u2,...}}=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,w1)andalso
          Portable.pointer_eq(expected,w2)then ()else raise ERR
         "source_condition_loop" "foreign expected Work";
       W.with_step expected(fn()=>
       let fun live()=(sce_clause_guard expected first;
             sce_clause_guard expected second)
           fun tick n=(live();W.spend expected n)
           fun guarded operation=
             (live();let val result=operation()in live();result end)
           val _=live()val _=tick 16
           val _=if !u1 orelse !u2 then raise ERR
             "source_condition_loop" "original clause consumed"else ()
           val _=if Portable.pointer_eq(u1,u2)then raise ERR
             "source_condition_loop" "duplicate original clause"else ()
           val _=if Portable.pointer_eq(e1,e2)andalso
               Portable.pointer_eq(f1,f2)andalso
               Portable.pointer_eq(g1,g2)andalso c1=c2 andalso s1=s2 andalso
               null ch1 andalso null ch2 andalso
               null co1 andalso null co2 then ()else raise ERR
             "source_condition_loop" "different authentic loop parent"
           val _=case(t1,i1,t2,i2)of
               (SourceTruth,[],SourceTruth,[(SCEClauseSymmetry,_,_)])=>()
             | _=>raise ERR "source_condition_loop" "not ordered loop pair"
           val statement= #target(sce_data expected e1)
           val cap= #output_limit(W.semantic_limits expected)
           fun pending [] visits=()
             | pending(term::rest)visits=
                 if visits>=cap then raise ERR "source_condition_loop"
                   "original output syntax allowance"else
                 (tick 1;if Term.is_abs term then raise ERR
                    "source_condition_loop" "binder loop prerequisite"
                  else if Term.is_comb term then
                    let val(a,b)=guarded(fn()=>Term.dest_comb term)
                    in pending(a::b::rest)(visits+1)end
                  else pending rest(visits+1))
           val _=pending[statement]0
           val(left,right)=guarded(fn()=>boolSyntax.dest_eq statement)
           val _=if Type.compare(Term.type_of left,Type.bool)=EQUAL then
             ()else raise ERR "source_condition_loop" "Boolean loop required"
           fun occurs []=false
             | occurs(term::rest)=
                 (tick 1;if guarded(fn()=>if Term.is_var left then
                      Term.term_eq left term else Term.aconv left term)then
                    true
                  else if Term.is_comb term then
                    let val(a,b)=guarded(fn()=>Term.dest_comb term)
                    in occurs(a::b::rest)end else occurs rest)
           val _=if occurs[right]then ()else raise ERR
             "source_condition_loop" "actual equality is not a loop"
           val _=tick 2
           val value=SourceConditionLoopPlan{work=expected,first=first,
             second=second,phase=ref SCLPrepared}
           val _=source_condition_loop_guard expected value
       in value end)))
  fun admit_source_condition_loop expected
      (value as SourceConditionLoopPlan{first,second,phase,...})=
    source_condition_loop_operation expected value(fn()=>
      (source_condition_loop_guard expected value;
       if !phase=SCLPrepared then ()else raise ERR
         "source_condition_loop" "loop admission consumed";
       W.with_step expected(fn()=>
       let val SCEClausePlan{used=u1,...}=first
           val SCEClausePlan{used=u2,...}=second
           fun live()=source_condition_loop_guard expected value
           fun tick n=(live();W.spend expected n)
           fun guarded operation=
             (live();let val result=operation()in live();result end)
           val _=live()val _=tick 3
           val _=if !u1 orelse !u2 then raise ERR
             "source_condition_loop" "original clause consumed"else ()
           val _=(u1:=true;u2:=true;phase:=SCLAdmitting)
           (* Explicit type tasks preserve ordinary left/right order. *)
           datatype task=Materialize of sr_type | BuildArrow
           fun materialize tree=
             let fun run [] [ty]=ty
                   | run(Materialize(SRCaptured ty)::rest)values=
                       (tick 2;run rest(guarded(fn()=>ty)::values))
                   | run(Materialize(SRArrow(a,b))::rest)values=
                       (tick 4;run(Materialize a::Materialize b::
                         BuildArrow::rest)values)
                   | run(BuildArrow::rest)(right::left::values)=
                       let val _=tick 5
                           val ty=guarded(fn()=>Type.mk_thy_type
                             {Thy="min",Tyop="fun",Args=[left,right]})
                       in run rest(ty::values)end
                   | run _ _=raise ERR "source_condition_loop"
                       "private type materialization invariant"
             in run[Materialize tree][]end
           fun policy(SCEClausePlan{types,check_type,...})=
             let fun gather [] result=List.rev result
                   | gather(ty::rest)result=
                       (tick 2;gather rest(materialize ty::result))
                 val policy_types=gather types[]
                 fun apply []=()
                   | apply(ty::rest)=
                       (tick 1;guarded(fn()=>check_type ty);apply rest)
             in apply policy_types end
           val _=policy first val _=policy second
           val _=tick 2 val _=live()val _=phase:=SCLReady
       in SourceConditionLoopReady value end)))
  fun execute_source_condition_loop expected
      (SourceConditionLoopReady(value as SourceConditionLoopPlan
        {first,second,phase,...}))=
    source_condition_loop_operation expected value(fn()=>
      (source_condition_loop_guard expected value;
       if !phase=SCLReady then ()else raise ERR
         "source_condition_loop" "loop ready consumed";
       (* Claim ready before creating either private execution copy. *)
       phase:=SCLExecuting;
       let fun live()=source_condition_loop_guard expected value
           fun copy(SCEClausePlan{work,evidence,frame,graph,caller,scope,
               children,initial,instructions,terminal,result,conditions,
               types,origin,binders,permutative,...})=
             W.with_step expected(fn()=>
               (live();W.spend expected 3;
                let val private_plan=SCEClausePlan{work=work,
                      evidence=evidence,frame=frame,graph=graph,
                      caller=caller,scope=scope,children=children,
                      initial=initial,instructions=instructions,
                      terminal=terminal,result=result,conditions=conditions,
                      types=types,origin=origin,binders=binders,
                      check_type=fn _=>(live();W.spend expected 1;live()),
                      permutative=permutative,used=ref false}
                in live();private_plan end))
           val private_first=copy first val private_second=copy second
           val _=live()
           val left=execute_source_condition_rule expected private_first
           val _=live()
           val right=execute_source_condition_rule expected private_second
           val _=live()
           val result=W.with_step expected(fn()=>
             (live();W.spend expected 2;live();[left,right]))
           val _=phase:=SCLDone
       in result end))

  val source_eqt_flip_fixed_law=boolTheory.EQ_SYM_EQ
  datatype source_eqt_flip_plan=SourceEqTFlipPlan of
    {work:W.portfolio,evidence:source_condition_evidence,
     frame:Scope.receipt,graph:G.graph,scope:G.scope,law:Thm.thm,
     import:G.import_plan,first:sr_tree,second:sr_tree,
     first_origin:sce_origin_tree,second_origin:sce_origin_tree,
     types:sr_type list,check_type:Type.hol_type -> unit,phase:sc_phase ref}
  datatype source_eqt_flip_ready=SourceEqTFlipReady of source_eqt_flip_plan
  fun source_eqt_flip_guard expected(SourceEqTFlipPlan
      {work,evidence,frame,graph,scope,law,phase,...})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work)then ()else raise ERR
         "source_eqt_flip" "foreign expected Work";
       sce_guard expected evidence;
       let val d=Scope.description_for expected frame
       in if Portable.pointer_eq(#graph d,graph)andalso #scope d=scope
           then ()else raise ERR "source_eqt_flip" "actual frame changed"end;
       if Portable.pointer_eq(law,source_eqt_flip_fixed_law)andalso
           clean law andalso null(Thm.hyp law)andalso
           Term.uptodate_term(Thm.concl law)then ()else raise ERR
         "source_eqt_flip" "fixed actual law changed";
       if !phase=SCDead then raise ERR "source_eqt_flip" "retired"else ()))
  fun source_eqt_flip_operation expected
      (value as SourceEqTFlipPlan {work,phase,...})operation=
    if Portable.pointer_eq(expected,work)then
      (operation()handle primary=>
        (phase:=SCDead;W.close expected;raise primary))
    else(W.close expected;raise ERR "source_eqt_flip" "foreign expected Work")
  datatype eqf_capture=EQFVisit of Term.term | EQFJoin of sr_type
    | EQFAbstract of sr_type*Term.term
  fun prepare_source_eqt_flip expected{evidence,check_type}=
    sr_fail expected(fn()=>W.with_step expected(fn()=>
    let val d=sce_data expected evidence val frame= #frame d
        val fd=Scope.description_for expected frame
        val graph= #graph fd val scope= #scope fd
        val limits=W.semantic_limits expected
        val output= #output_limit limits val template= #template_limit limits
        val budget=ref(0:IntInf.int)val policies=ref([]:sr_type list)
        fun live()=(sce_guard expected evidence;
          Scope.validate_lifetime_for expected frame)
        fun tick n=(live();W.spend expected n)
        fun guarded operation=
          (live();let val answer=operation()in live();answer end)
        fun atom shape ty=
          (tick 1;SRTree{ty=ty,shape=shape,raw=1,inc=1,annotations=[]})
        fun app ty a b=(tick 1;SRTree{ty=ty,shape=SRApp(a,b),
          raw=1+sr_raw a+sr_raw b,inc=1+sr_inc a+sr_inc b,annotations=[]})
        fun lam ty variable body=(tick 1;SRTree
          {ty=ty,shape=SRLam(~1,variable,body),raw=1+sr_raw body,
           inc=2+sr_inc body,annotations=[]})
        fun bound cap tree=
          if sr_raw tree<=IntInf.fromInt cap andalso
              sr_inc tree<=IntInf.fromInt cap then ()else raise ERR
            "source_eqt_flip_quote" "original syntax allowance"
        (* No bounded_* count_body/Beta before an actual binder witness.
           Only the privately fixed law permits public body opening here. *)
        fun capture cap fixed term=
          let fun screen [] raw inc=()
                | screen(current::rest)raw inc=
                    (tick 1;
                     if raw>=cap orelse inc>=cap then raise ERR
                       "source_eqt_flip_quote" "original syntax allowance"
                     else if Term.is_abs current then
                       if fixed then
                         let val(_,body)=guarded(fn()=>Term.dest_abs current)
                         in screen(body::rest)(raw+1)(inc+2)end
                       else raise ERR "source_eqt_flip_quote"
                         "unwitnessed binder operand"
                     else if Term.is_comb current then
                       let val(a,b)=guarded(fn()=>Term.dest_comb current)
                       in screen(a::b::rest)(raw+1)(inc+1)end
                     else screen rest(raw+1)(inc+1))
              val _=screen[term]0 0
              fun walk [] [tree]=(bound cap tree;tree)
                | walk(EQFVisit current::pending)values=
                    let val _=tick 1
                        val ty=SRCaptured(Term.type_of current)
                    in if Term.is_abs current then
                        if fixed then
                          let val(v,b)=guarded(fn()=>Term.dest_abs current)
                          in walk(EQFVisit b::EQFAbstract(ty,v)::pending)
                            values end
                        else raise ERR "source_eqt_flip_quote"
                          "unwitnessed binder operand"
                      else if Term.is_comb current then
                        let val(a,b)=guarded(fn()=>Term.dest_comb current)
                        in walk(EQFVisit a::EQFVisit b::EQFJoin ty::pending)
                          values end
                      else let val value=atom(SRAtom current)ty
                        in walk pending(value::values)end end
                | walk(EQFJoin ty::pending)(right::left::values)=
                    let val value=app ty left right val _=bound cap value
                    in walk pending(value::values)end
                | walk(EQFAbstract(ty,v)::pending)(body::values)=
                    let val variable=atom(SRAtom v)(SRCaptured(Term.type_of v))
                        val value=lam ty variable body val _=bound cap value
                    in walk pending(value::values)end
                | walk _ _=raise ERR "source_eqt_flip_quote" "capture stack"
          in walk[EQFVisit term][]end
        fun eq a b=
          let val boolean=SRCaptured Type.bool val domain=sr_type a
              val arrow=SRArrow(domain,boolean)
              val h=atom(SRAtom boolSyntax.equality)(SRArrow(domain,arrow))
          in app boolean(app arrow h a)b end
        val initial=capture output false(#target d)
        val(left,right)=guarded(fn()=>boolSyntax.dest_eq(#target d))
        val _=if Type.compare(Term.type_of left,Type.bool)=EQUAL then ()
          else raise ERR "source_eqt_flip_quote" "Boolean equality required"
        val lhs=capture output false left val rhs=capture output false right
        val truth=atom(SRAtom boolSyntax.T)(SRCaptured Type.bool)
        val reversed=eq rhs lhs
        val first=eq initial truth val second=eq reversed truth
        val law=source_eqt_flip_fixed_law
        val _=if clean law andalso null(Thm.hyp law)then ()else raise ERR
          "source_eqt_flip_quote" "fixed law is not closed"
        val lawterm=guarded(fn()=>Thm.concl law)
        val(x,once)=guarded(fn()=>boolSyntax.dest_forall lawterm)
        val(y,specialized)=guarded(fn()=>boolSyntax.dest_forall once)
        val alpha=Term.type_of x
        val _=if Term.is_var x andalso Term.is_var y andalso
            Type.is_vartype alpha andalso
            Type.compare(alpha,Term.type_of y)=EQUAL andalso
            not(Term.term_eq x y)then ()else raise ERR
          "source_eqt_flip_quote" "fixed schema binders changed"
        val original=capture template true lawterm
        val once_tree=capture template true once
        val specialized_tree=capture template true specialized
        (* The exact closed fixed law has no term FV or Hyp. SPEC_ALL's
           prim_variant therefore retains these distinct binder objects. *)
        fun type_instance actual=
          (tick 1;if Type.compare(actual,alpha)=EQUAL then SRCaptured Type.bool
           else if Type.is_vartype actual then SRCaptured actual
           else let val {Thy,Tyop,Args}=Type.dest_thy_type actual
             in case(Thy,Tyop,Args)of("min","fun",[a,b])=>
               SRArrow(type_instance a,type_instance b)
              | _=>SRCaptured actual end)
        fun remap ty=case ty of SRCaptured actual=>type_instance actual
          | SRArrow(a,b)=>SRArrow(remap a,remap b)
        fun transform replace(SRTree {ty,shape,...})=
          let val actual=remap ty
          in case shape of SRAtom term=>
                if replace andalso Term.term_eq term x then lhs
                else if replace andalso Term.term_eq term y then rhs
                else atom(SRAtom term)actual
            | SRApp(a,b)=>app actual(transform replace a)(transform replace b)
            | SRLam(_,v,b)=>lam actual
                (transform replace v)(transform replace b)
            | _=>raise ERR "source_eqt_flip_quote" "fixed schema shape"end
        val typed=transform false specialized_tree
        val instantiated=transform true specialized_tree
        val hypotheses=guarded(fn()=>Thm.hyp(#proof d))
        (* Only genuine producer-time native Hyp pointers may authenticate
           a binder forest. Reconstructed recipe rows are not a lookup key. *)
        val admitted=sce_admitted_hyp_rows_inside expected evidence
        val _=if ListPair.allEq Portable.pointer_eq
            (hypotheses,List.map #1 admitted)then ()else raise ERR
          "source_eqt_flip_quote" "actual Hyp portfolio changed"
        val held_hyp=List.map(fn(term,forest)=>case forest of
            SOME tree=>(bound template tree;(tree,[]))
          | NONE=>(capture template false term,[]))admitted
        fun add n=(budget:= !budget+n;
          if !budget<=remaining expected then ()else raise ERR
            "source_eqt_flip_quote" "original cumulative Work")
        fun profile_type root=
          let fun native [] total=total
                | native([]::pending)total=native pending total
                | native((ty::rest)::pending)total=
                    (tick 1;
                     if Type.is_vartype ty then
                       let val name=Type.dest_vartype ty
                           val _=tick(String.size name+1)
                       in native(rest::pending)(total+1+IntInf.fromInt
                         (String.size name+1))end
                     else let val {Thy,Tyop,Args}=Type.dest_thy_type ty
                              val _=tick(String.size Thy+String.size Tyop+1)
                       in native(Args::rest::pending)(total+1+IntInf.fromInt
                         (String.size Thy+String.size Tyop+1))end)
              fun walk [] total=total
                | walk(SRArrow(a,b)::rest)total=
                    (tick 1;walk(a::b::rest)(total+1+7))
                | walk(SRCaptured ty::rest)total=
                    walk rest(native[[ty]]total)
          in walk[root]0 end
        fun profile(tree,binders)=
          let fun identifier(SRAtom term)=
                    if Term.is_var term then
                      String.size(#1(Term.dest_var term))+1
                    else if Term.is_const term then
                      let val {Thy,Name,...}=Term.dest_thy_const term
                      in String.size Thy+String.size Name+1 end else 0
                | identifier(SRFresh(name,_))=String.size name+1
                | identifier(SRBound(_,term))=
                    if Term.is_var term then
                      String.size(#1(Term.dest_var term))+1
                    else raise ERR "source_eqt_flip_quote"
                      "owned actual binder name"
                | identifier _=0
              fun walk [] total=total
                | walk((value as SRTree {ty,shape,...})::rest)total=
                    let val _=tick 1 val _=policies:=ty:: !policies
                        val names=identifier shape val _=tick names
                        val next=total+1+profile_type ty+IntInf.fromInt names
                    in case shape of SRApp(a,b)=>walk(a::b::rest)next
                      | SRLam(_,v,b)=>walk(v::b::rest)next
                      | _=>walk rest next end
          in walk[tree]0 end
        fun record cap hyp tree=
          (bound cap tree;List.app(fn(value,_)=>bound template value)hyp;
           add(sr_raw tree+sr_inc tree+profile(tree,[])+
             List.foldl(fn((value,names),total)=>
               total+sr_raw value+sr_inc value+profile(value,names))0 hyp))
        fun simple tree=record template []tree
        (* Original schema and every SPEC_ALL/INST_TYPE/INST operand/result. *)
        val _=simple original val _=simple once_tree
        val _=simple specialized_tree val _=simple typed
        val _=simple instantiated
        val _=simple(capture template false x)
        val _=simple(capture template false y)
        (* Recursive original import REFLEXIVE bridge portfolio, including
           function-typed prefixes. Canonical/private helper gaps qualified. *)
        fun bridges []=()
          | bridges((tree as SRTree {shape,...})::rest)=
              (simple(eq tree tree);
               case shape of SRApp(a,b)=>bridges(a::b::rest)
                 | SRLam(_,v,b)=>bridges(v::b::rest)
                 | _=>bridges rest)
        val _=bridges[original]
        val _=simple(eq original original)
        val _=simple(eq original original)val _=simple original
        (* EQT helper SPEC/EQ_MP and both actual incoming Hyp incidences. *)
        val _=record output held_hyp initial
        val _=record template held_hyp(eq initial first)
        val _=record output held_hyp first
        (* REWR_CONV optional ALPHA+TRANS alignment is fully retained. *)
        val symmetry=eq initial reversed
        val _=simple symmetry val _=simple(eq initial initial)
        val _=simple symmetry
        (* LAND = AP_TERM outer equality operator then AP_THM at T. *)
        val boolean=SRCaptured Type.bool val arrow=SRArrow(boolean,boolean)
        val head=atom(SRAtom boolSyntax.equality)(SRArrow(boolean,arrow))
        val partial=app arrow head initial
        val swapped_partial=app arrow head reversed
        val _=simple(eq partial swapped_partial)
        val _=simple(eq first second)
        val _=record output held_hyp second
        val _=record template held_hyp(eq second second)
        (* These rows are retained, never emitted by this new pipeline.
           Inherited realization owns its original genuine row programme;
           no reconstructed row is blind-matched or granted new credit. *)
        val original_origin=sce_lexical_origin_inside expected evidence
        val reversed_origin=case original_origin of
            SCOApp(SCOApp(h,a),b)=>SCOApp(SCOApp(h,b),a)
          | _=>raise ERR "source_eqt_flip_quote" "authentic equality origin"
        fun eqt_origin origin=SCOApp(SCOApp(SCOAtom,origin),SCOAtom)
        val _=pay expected(!budget)
        (* Genuine metadata-only import planning: no theorem/body opening.
           Public G plan_imports preserves binder opacity. *)
        val import=guarded(fn()=>G.plan_import graph scope template lawterm)
        val _=List.app(fn ty=>(tick 1;policies:=SRCaptured ty:: !policies))
          (G.import_types import)
        val _=live()
    in SourceEqTFlipPlan{work=expected,evidence=evidence,frame=frame,
      graph=graph,scope=scope,law=law,import=import,first=first,second=second,
      first_origin=eqt_origin original_origin,
      second_origin=eqt_origin reversed_origin,types=List.rev(!policies),
      check_type=check_type,phase=ref SCPrepared}end))
  fun admit_source_eqt_flip expected
      (value as SourceEqTFlipPlan{types,check_type,phase,...})=
    source_eqt_flip_operation expected value(fn()=>
      (source_eqt_flip_guard expected value;
       if !phase=SCPrepared then ()else raise ERR "source_eqt_flip_admit"
         "already admitted or consumed";
       phase:=SCAdmitting;
       W.with_step expected(fn()=>
       let fun guarded operation=
             (source_eqt_flip_guard expected value;
              let val result=operation()
              in source_eqt_flip_guard expected value;result end)
           fun materialize(SRCaptured ty)=ty
             | materialize(SRArrow(a,b))=
                 let val left=materialize a val right=materialize b
                 in guarded(fn()=>Type.mk_thy_type
                   {Thy="min",Tyop="fun",Args=[left,right]})end
       in List.app(fn forest=>
         let val ty=materialize forest
         in guarded(fn()=>check_type ty)end)types end);
       phase:=SCAdmitted;source_eqt_flip_guard expected value;
       SourceEqTFlipReady value))
  fun execute_source_eqt_flip expected
      (SourceEqTFlipReady(value as SourceEqTFlipPlan
        {evidence,frame,graph,scope,law,import,first,second,
         first_origin,second_origin,phase,...}))=
    source_eqt_flip_operation expected value(fn()=>
      (source_eqt_flip_guard expected value;
       if !phase=SCAdmitted then ()else raise ERR "source_eqt_flip_execute"
         "not admitted or already consumed";
       phase:=SCConsumed;
       W.with_step expected(fn()=>
       let fun guarded operation=
             (source_eqt_flip_guard expected value;
              let val result=operation()
              in source_eqt_flip_guard expected value;result end)
           val d=sce_data expected evidence
           val cap= #template_limit(W.semantic_limits expected)
           val imported=guarded(fn()=>G.execute_import import)
           val opened=guarded(fn()=>G.record_opened_view graph scope cap
             (#node imported))
           val fact=guarded(fn()=>record_closed_from_import graph scope
             {node= #node opened,theorem=law,template_limit=cap,
              check_type=fn _=>()})
           val _=guarded(fn()=>validate_closed_fact graph scope cap fact)
           val actual_law=guarded(fn()=>closed_original fact)
           val _=if Portable.pointer_eq(actual_law,source_eqt_flip_fixed_law)
             then ()else raise ERR "source_eqt_flip_execute"
               "wrong exact fixed-law object"
           val held=guarded(fn()=>G.closure_root graph scope(closed_node fact))
           fun emit(SRTree {shape,...})=case shape of SRAtom term=>term
             | SRApp((operator as SRTree
                 {shape=SRApp(SRTree{shape=SRAtom h,...},a),...}),b)=>
                 if Term.is_const h andalso
                     Term.same_const h boolSyntax.equality then
                   let val left=emit a val right=emit b
                   in guarded(fn()=>boolSyntax.mk_eq(left,right))end
                 else let val left=emit operator val right=emit b
                      in guarded(fn()=>Term.mk_comb(left,right))end
             | SRApp(a,b)=>let val left=emit a val right=emit b
                 in guarded(fn()=>Term.mk_comb(left,right))end
             | _=>raise ERR "source_eqt_flip_execute" "binder-free output"
           val wanted_first=emit first val wanted_second=emit second
           val base=guarded(fn()=>Drule.EQT_INTRO(#proof d))
           (* PART_MATCH/SPEC_ALL starts HERE, after total admission/base. *)
           val conversion=guarded(fn()=>Conv.LAND_CONV
             (Conv.REWR_CONV actual_law))
           val flipped=guarded(fn()=>Conv.CONV_RULE conversion base)
           fun check wanted tag theorem=
             if clean theorem andalso guarded(fn()=>Term.aconv
                 (Thm.concl theorem)wanted)andalso
                 ListPair.allEq Portable.pointer_eq
                   (Thm.hyp theorem,Thm.hyp(#proof d))andalso
                 Tag.dest_tag(Thm.tag theorem)=Tag.dest_tag tag then ()else
               raise ERR "source_eqt_flip_execute"
                 "endpoint, original Hyp or full Tag changed"
           val first_tag=Tag.merge(Thm.tag boolTheory.EQ_CLAUSES)
             (Thm.tag(#proof d))
           val second_tag=Tag.merge(Thm.tag actual_law)first_tag
           val _=check wanted_first first_tag base
           val _=check wanted_second second_tag flipped
           fun result theorem origin=
             let val child=SCEApplied{work=expected,frame=frame,
                   parents=[evidence],proof=theorem,target=Thm.concl theorem,
                   names= #names d,rows= #rows d,origin=origin,
                   constructor_origins=NONE,
             effect_origins=NONE,
             realized=ref NONE}
                 val retained=SCEProjected{work=expected,graph=graph,
                   caller=scope,children=[held],value=child,permutative=NONE}
                 val _=sce_guard expected retained
             in retained end
           val results=[result base first_origin,
             result flipped second_origin]
           val _=guarded(fn()=>validate_closed_fact graph scope cap fact)
       in results end)))

  datatype source_predicate_conditional_plan=SourcePredicateConditionalPlan of
    {work:W.portfolio,raw:scr_clause_plan,closing:scr_conj_envelope,
     phase:sc_phase ref}
  datatype source_predicate_conditional_ready=SourcePredicateConditionalReady
    of source_predicate_conditional_plan
  fun source_predicate_conditional_guard expected
      (SourcePredicateConditionalPlan{work,raw,closing,phase})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work)then ()else raise ERR
         "predicate_conditional" "foreign expected Work";
       scr_clause_guard expected raw;
       scr_conj_shape closing;
       if !phase=SCDead then raise ERR "predicate_conditional" "retired"
         else ()))
  fun source_predicate_conditional_operation expected
      (value as SourcePredicateConditionalPlan{work,phase,...})action=
    if Portable.pointer_eq(expected,work)then
      (action()handle primary=>(phase:=SCDead;W.close expected;raise primary))
    else(W.close expected;raise ERR "predicate_conditional"
      "foreign expected Work")
  fun prepare_source_predicate_conditional expected
      {evidence,statement,first,second,third,check_type}=
    sr_fail expected(fn()=>
      let val closing=SCRConjEnvelope{statement=statement,first=first,
            second=second,third=third,fact=ref NONE,import=ref NONE,
            required=ref false,ants=ref [],expected=ref []}
          val raw=prepare_source_canonical_clause_inside expected(SOME closing)
            {evidence=evidence,steps=[],pending=[],finish=false,
             check_type=check_type,future=[],kind=NONE}
          val result=SourcePredicateConditionalPlan{work=expected,raw=raw,
            closing=closing,phase=ref SCPrepared}
          val _=source_predicate_conditional_guard expected result
      in result end)
  fun admit_source_predicate_conditional expected
      (value as SourcePredicateConditionalPlan
        {raw=SCRClausePlan{types,check_type,...},phase,...})=
    source_predicate_conditional_operation expected value(fn()=>
      (source_predicate_conditional_guard expected value;
       if !phase=SCPrepared then ()else raise ERR "predicate_conditional"
         "already admitted or consumed";
       phase:=SCAdmitting;
       W.with_step expected(fn()=>
         let fun guarded action=
               (source_predicate_conditional_guard expected value;
                let val result=action()
                in source_predicate_conditional_guard expected value;
                  result end)
             fun materialize(SRCaptured ty)=ty
               | materialize(SRArrow(a,b))=
                   let val left=materialize a val right=materialize b
                   in guarded(fn()=>Type.mk_thy_type
                     {Thy="min",Tyop="fun",Args=[left,right]})end
             val actual=List.map materialize types
             val _=List.app(fn ty=>guarded(fn()=>check_type ty))actual
         in source_predicate_conditional_guard expected value end);
       phase:=SCAdmitted;
       source_predicate_conditional_guard expected value;
       SourcePredicateConditionalReady value))
  fun source_predicate_conditional_import_for expected
      (SourcePredicateConditionalReady(value as SourcePredicateConditionalPlan
        {raw=SCRClausePlan{frame,...},
         closing=SCRConjEnvelope{statement,import,...},phase,...}))=
    source_predicate_conditional_operation expected value(fn()=>
      (source_predicate_conditional_guard expected value;
       if !phase=SCAdmitted then ()else raise ERR "predicate_conditional"
         "import data requires admitted ready";
       {frame=frame,statement=statement,import= !import}))
  datatype source_predicate_conditional_completed=
    SourcePredicateConditionalCompleted of
      {work:W.portfolio,parent:source_predicate_conditional_plan,
       evidence:source_condition_evidence}
  fun execute_source_predicate_conditional_completed expected
      {ready=SourcePredicateConditionalReady
        (value as SourcePredicateConditionalPlan
          {raw,closing=SCRConjEnvelope{fact,required,...},phase,...}),law}=
    source_predicate_conditional_operation expected value(fn()=>
      (source_predicate_conditional_guard expected value;
       if !phase=SCAdmitted then ()else raise ERR "predicate_conditional"
         "ready consumed or not admitted";
       if !required=Option.isSome law then ()else raise ERR
         "predicate_conditional" "exact fixed-law requirement changed";
       fact:=law;
       source_predicate_conditional_guard expected value;
       phase:=SCConsumed;
       let val(result,_)=execute_source_canonical_clause expected raw
           val _=source_predicate_conditional_guard expected value
       in (SourcePredicateConditionalCompleted{work=expected,
           parent=value,evidence=result},result)end))
  fun execute_source_predicate_conditional expected data=
    let val(_,result)=execute_source_predicate_conditional_completed
          expected data
    in result end


