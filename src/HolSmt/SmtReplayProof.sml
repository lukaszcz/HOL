  datatype nt_meter=NTPrefix of W.portfolio*(unit->unit)
    | NTReserved of nc_aux_allowance
  datatype nt_prefix=NativeHypPrefix of
    {input:Thm.thm,hypotheses:(Term.term*nc_origin)list,
     clause:Term.term,origin:nc_origin,known:bool}
  datatype nt_transport=NativeHypTransport of
    {work:W.portfolio,guard:unit->unit,meter:nt_meter,input:Thm.thm,
     hypotheses:(Term.term*nc_origin)list,
     substitutions:(Term.term*Term.term*nc_origin)list,
     insertion:(Term.term*Term.term*nc_origin)list,known:bool}
  fun nt_tick(NTPrefix(work,guard))amount=
        (guard();W.spend work(amount+nt_prefix_payer_fee);guard())
    | nt_tick(NTReserved allowance)amount=
        nc_take_aux allowance(nc_aux_consume_fee+IntInf.fromInt amount)
  val nt_reverse_fee=length
    ["reverse call","meter argument","values argument","loop definition",
     "initial accumulator","loop call","list dispatch","item field",
     "tail field","counter call","output cons","recursive call",
     "empty result","return"]
  fun nt_reverse meter values=
    let fun visit [] result=(nt_tick meter nt_reverse_fee;result)
          | visit(value::rest)result=
              (nt_tick meter nt_reverse_fee;visit rest(value::result))
    in visit values [] end
  fun nt_graph_origin meter graph target clause=
    let val _=nt_tick meter nt_node_fee
        val exact=Portable.pointer_eq(G.representative graph target,clause)
        fun lookup held node=
          let fun scan []=NCDeferred
                | scan((old,value)::rest)=
                    (nt_tick meter nt_lookup_fee;
                     if old=node then value else scan rest)
          in nt_tick meter nt_lookup_fee;scan held end
        fun exists held node=
          let fun scan []=false
                | scan((old,_)::rest)=
                    (nt_tick meter nt_lookup_fee;
                     old=node orelse scan rest)
          in nt_tick meter nt_lookup_fee;scan held end
        fun visit [] held=
              (nt_tick meter nt_visit_fee;lookup held target)
          | visit((node,joined)::rest)held=
              (nt_tick meter nt_visit_fee;
               if exists held node then visit rest held else
               let val _=nt_tick meter nt_node_fee
                   val actual=G.representative graph node
               in case G.view graph node of
                   G.Variable _=>visit rest
                     ((node,nc_seed actual)::held)
                 | G.Constant _=>visit rest
                     ((node,nc_seed actual)::held)
                 | G.Application(left,right)=>
                     if not joined then
                       visit((left,false)::(right,false)::
                         (node,true)::rest)held
                     else let val a=lookup held left
                              val b=lookup held right
                              val origin=if nc_known a andalso nc_known b
                                then NCApplication(actual,a,b)
                                else NCDeferred
                          in visit rest((node,origin)::held)end
                 | _=>visit rest((node,NCDeferred)::held)
               end)
    in if exact then visit[(target,false)][]else NCDeferred end
  fun nt_block_origins meter
      (block as Block{graph,leaves,projections,context,nodes,...})=
    let fun named node=
          let val _=nt_tick meter nt_node_fee
              val actual= #2(table_find(nodes,G.node_id node))
          in Term.is_var actual end
        fun row index=
          (nt_tick meter nt_leaf_fee;
           case Vector.sub(leaves,index)of
             Source node=>named node
           | ClosedWitness fact=>named(closed_node fact)
           | ConversionWitness conversion=>
               named(conversion_source conversion)andalso
               named(conversion_target conversion)
           | Definition(node,rhs)=>
               named node andalso
               (case G.view graph node of
                  G.Application(left,right)=>named left andalso named right
                | G.Constant _=>Term.is_const rhs
                | _=>false))
        fun rows index held all=
          (nt_tick meter nt_leaf_fee;
           if index=Vector.length leaves then
             let val origin=if all then NCBlockContext(context,block)
                   else NCDeferred
             in (context,origin)::held end
           else let val actual=Thm.concl(Vector.sub(projections,index))
                    val known=row index
                    val origin=if known then NCBlockRow(actual,block,index)
                      else NCDeferred
                in rows(index+1)((actual,origin)::held)(all andalso known)
                end)
    in rows 0 [] true end
  val nt_alias_fee=length
    ["alias scan call","list dispatch","pair pattern","pointer comparison",
     "branch","origin known dispatch","unsupported flag read",
     "unsupported disjunction","answer update","tail projection",
     "tail call","end flag branch","result publication"]
  fun nt_all_aliases meter held term=
    let fun visit [] answer unsupported=
              if unsupported then NCDeferred else answer
          | visit((actual,origin)::rest)answer unsupported=
              (nt_tick meter nt_alias_fee;
               if Portable.pointer_eq(actual,term)then
                 visit rest origin(unsupported orelse not(nc_known origin))
               else visit rest answer unsupported)
    in nt_tick meter nt_alias_fee;visit held NCDeferred false end
  fun nt_prepare_prefix work guard source proof graph target clause=
    let val meter=NTPrefix(work,guard)
        val _=nt_tick meter nt_prefix_entry_fee
        val SourceRealization{compact=SourceCompact{block,...},...}=source
        val owned=nt_block_origins meter block
        val clause_origin=nt_graph_origin meter graph target clause
        fun hypotheses [] held all=
              (nt_tick meter nt_hyp_fee;(nt_reverse meter held,all))
          | hypotheses(actual::rest)held all=
              let val _=nt_tick meter nt_hyp_fee
                  val origin=nt_all_aliases meter owned actual
              in hypotheses rest((actual,origin)::held)
                (all andalso nc_known origin)end
        val(hyp,all)=hypotheses(Thm.hyp proof)[]true
        val _=nt_tick meter nt_prefix_record_fee
    in NativeHypPrefix{input=proof,hypotheses=hyp,clause=clause,
      origin=clause_origin,known=all}end
  (* Upper bounds count the actual later helper groups. The initial variable
     substitutions cannot increase native Hyp cardinality. Final Hyp/log
     bounds are the same genuine capture model, not caller estimates. *)
  fun nt_subtotal renamings events initial_H final_H=
    let fun cost group=nc_aux_consume_fee+IntInf.fromInt group
        val sigmas=renamings+1
    in cost nt_prepare_entry_fee+cost nt_prepare_record_fee+
      (sigmas+2)*cost nt_sigma_fee+
      IntInf.fromInt nt_direct_setup_fee+
      renamings*IntInf.fromInt nt_direct_row_fee+
      (events+2)*cost nt_alias_fee+cost nt_finish_fee+
      (final_H+1)*cost nt_hyp_fee+
      (final_H+1)*(initial_H+1)*cost nt_lookup_fee+
      ((sigmas+2)+(final_H+1))*cost nt_reverse_fee end
  (* The private plan's conditions list starts empty and only SRCondition
     conses a member. No instruction scan or retained flag is needed.
     The old conditional lookup bound includes one unused empty-row group:
     rows [] never calls present. Prepay the two fixed dispatch groups
     there, retaining exactly the old total conditional Work debit. *)
  val nt_condition_dispatch_fee=length
    ["model condition dispatch","finish condition dispatch"]
  val nt_condition_dispatch_credit=IntInf.fromInt nt_condition_dispatch_fee
  val nt_same_hyp_fee=length
    ["final Hyp set projection","initial Hyp set projection",
     "actual set pointer comparison","set identity branch","empty list"]
  fun nt_same_subtotal renamings events initial_H final_H=
    let fun cost group=nc_aux_consume_fee+IntInf.fromInt group
        val sigmas=renamings+1
    in cost nt_prepare_entry_fee+cost nt_prepare_record_fee+
      (sigmas+2)*cost nt_sigma_fee+
      IntInf.fromInt nt_direct_setup_fee+
      renamings*IntInf.fromInt nt_direct_row_fee+
      (events+2)*cost nt_alias_fee+cost nt_finish_fee+
      (final_H+1)*cost nt_hyp_fee+cost nt_same_hyp_fee+
      ((sigmas+2)+(final_H+1))*cost nt_reverse_fee end
  fun nt_prepare work guard auxiliary
      (NativeHypPrefix{input,hypotheses,clause,origin,known})
      substitutions insertion log=
    let val meter=NTReserved auxiliary
        val _=nt_tick meter(nt_prepare_entry_fee+nt_direct_setup_fee)
        fun direct [] held all=
              (nt_tick meter nt_sigma_fee;(nt_reverse meter held,all))
          | direct(({redex,residue},emitted)::rest)held all=
              let val _=nt_tick meter(nt_sigma_fee+nt_direct_row_fee)
                  val value=if Portable.pointer_eq(residue,clause)then
                      origin else emitted
                  val valid=Term.is_var redex andalso nc_known value
              in direct rest((redex,residue,value)::held)
                   (all andalso valid)end
        fun sigma [] held all=
              (nt_tick meter nt_sigma_fee;(nt_reverse meter held,all))
          | sigma({redex,residue}::rest)held all=
              let val _=nt_tick meter nt_sigma_fee
                  val value=if Portable.pointer_eq(residue,clause)then
                      origin else nt_all_aliases meter (!log)residue
                  val valid=Term.is_var redex andalso nc_known value
              in sigma rest((redex,residue,value)::held)(all andalso valid)end
        val(renaming,first)=direct substitutions [] true
        val(inserted,second)=sigma insertion [] true
        val _=nt_tick meter nt_prepare_record_fee
        val result=NativeHypTransport{work=work,guard=guard,meter=meter,
          input=input,hypotheses=hypotheses,substitutions=renaming,
          insertion=inserted,known=known andalso first andalso second}
        val _=guard()
    in result end
  fun nt_finish expected
      (NativeHypTransport{work,guard,meter,input,hypotheses,
        substitutions,insertion,known})renamed initial
      ({proof,target,conclusion,hyp,events}:nc_proof):nc_proof=
    let val _=if Portable.pointer_eq(expected,work)then ()else
          raise ERR "native_hyp_transport" "different original Work"
        val _=nt_tick meter nt_finish_fee
        val initial_hyp=Thm.hyp initial
        fun present [] _=(nt_tick meter nt_lookup_fee;false)
          | present(actual::rest)term=
              (nt_tick meter nt_lookup_fee;
               Portable.pointer_eq(actual,term)orelse present rest term)
        fun rows [] held=(nt_tick meter nt_hyp_fee;nt_reverse meter held)
          | rows((actual,old)::rest)held=
              let val _=nt_tick meter nt_hyp_fee
                  val value=if known andalso present initial_hyp actual
                    then NCVariableHyp(actual,input,renamed,initial,
                      hypotheses,substitutions,insertion)else old
              in rows rest((actual,value)::held)end
        val result={proof=proof,target=target,conclusion=conclusion,
          hyp=rows hyp [],events=events}
        val _=guard()
    in result end

  (* The actual object check is independent of the producer proof. It runs
     before origins are issued; nc_snapshot retained the actual Hyp terms.
     All post-INST no-condition rules preserve this same persistent set. *)
  fun nt_finish_same_set expected
      (NativeHypTransport{work,guard,meter,input,hypotheses,
        substitutions,insertion,known})renamed initial
      ({proof,target,conclusion,hyp,events}:nc_proof):nc_proof=
    let val _=if Portable.pointer_eq(expected,work)then ()else
          raise ERR "native_hyp_transport" "different original Work"
        val _=nt_tick meter nt_finish_fee
        val _=nt_tick meter nt_same_hyp_fee
        val _=if Portable.pointer_eq(Thm.hypset proof,Thm.hypset initial)
          then () else raise ERR "native_hyp_transport"
            "no-condition proof changed actual Hyp set"
        fun rows [] held=(nt_tick meter nt_hyp_fee;nt_reverse meter held)
          | rows((actual,old)::rest)held=
              let val _=nt_tick meter nt_hyp_fee
                  val value=if known then
                    NCVariableHyp(actual,input,renamed,initial,
                      hypotheses,substitutions,insertion)else old
              in rows rest((actual,value)::held)end
        val result={proof=proof,target=target,conclusion=conclusion,
          hyp=rows hyp [],events=events}
        val _=guard()
    in result end

  datatype source_rule_terminal = SourceEquality | SourceTruth | SourceFalse
  datatype source_rule_step = SourceSpec of G.closure_child
    | SourceConjunct of bool | SourceCondition
  fun nc_snapshot_priced(value as NCAllowance{events,hypotheses,...})
      log preserve proof=
    (nc_take value(nc_snapshot_fee+
       (hypotheses+1)*(events*nc_lookup_fee+nc_seed_fee)+
       hypotheses*nc_hyp_fee+events*nc_length_fee);
     nc_snapshot log preserve proof)
  datatype sr_type = SRCaptured of Type.hol_type
    | SRArrow of sr_type * sr_type
  datatype sr_tree = SRTree of
    {ty:sr_type,shape:sr_shape,raw:IntInf.int,inc:IntInf.int,
     annotations:sr_type list}
  and sr_shape = SRAtom of Term.term
    | SRFresh of string * Type.hol_type
    | SRBound of int * Term.term
    | SRApp of sr_tree * sr_tree
    | SRLam of int * sr_tree * sr_tree
  datatype sr_action = SRSpec of sr_tree
    | SRConjunct of bool | SRCondition
  type sr_instruction = sr_action * sr_tree * sr_tree list
  datatype source_rule_phase = SRPrepared | SRExecuted | SRRetired
  datatype source_rule_plan = SourceRulePlan of
    {work:W.portfolio,source:source_realization,frame:Scope.receipt,
     caller:G.scope,scope:G.scope,arguments:G.closure_child list,
     renaming:(G.node * Term.term * sr_tree) list,
     named:sr_tree,named_hyp:sr_tree list,rows:(int * sr_tree) list,
     hyp_forecast:sr_tree list,hyp_admission:sr_tree*IntInf.int,
     row_admission:(int*sr_tree*IntInf.int)list,
     row_context:sr_tree*IntInf.int,
     instructions:sr_instruction list,terminal:source_rule_terminal,
     result:sr_tree,conditions:sr_tree list,types:sr_type list,
     quote:IntInf.int,check_type:Type.hol_type -> unit,
     binders:(int * string * Type.hol_type) list,
     phase:source_rule_phase ref}
  (* This is intentionally distinct from ordinary SourceCompact. Its
     vocabulary and leaf rows are the output of the private fixed renaming
     and clause-substitution program, never an external semantic theorem. *)
  datatype source_rule_recipe = SourceRuleRecipe of
    {plan:source_rule_plan,base:source_compact,proof:Thm.thm,
     target:Term.term,names:(G.node * Term.term) list,
     rows:(int * Term.term) list,conditions:Term.term list,
     hyp_universe:Thm.thm*(string*Term.term)list,
     constructor_origins:nc_proof option,source_effect_origins:nc_proof option,
     realized:Thm.thm option ref}

  fun sr_data (SRTree d) = d
  fun sr_types (SRTree {annotations,...}) = annotations
  fun sr_raw value = #raw (sr_data value)
  fun sr_inc value = #inc (sr_data value)
  fun sr_type value = #ty (sr_data value)
  fun sr_same a b = Term.term_eq a b
  fun sr_fail work operation = operation ()
    handle primary => (W.close work;raise primary)
  fun sr_guard expected (SourceRulePlan
      {work,source,frame,caller,scope,arguments,phase,...}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "source_rule" "different expected Work";
      if !phase <> SRRetired then () else
        raise ERR "source_rule" "retired Source rule plan";
      source_realization_guard expected source;
      Scope.validate_lifetime_for expected frame;
      let val d = Scope.description_for expected frame
          val SourceRealization {graph,root,original_sources,...} = source
      in if Portable.pointer_eq (#graph d,graph) andalso #root d=root
          andalso #scope d=scope andalso
          Portable.pointer_eq (#sources d,original_sources) then () else
        raise ERR "source_rule" "different actual target frame";
        G.validate_scope graph caller;
        List.app (fn child => ignore
          (G.closure_child_node graph caller child)) arguments
      end)
     handle primary => (W.close expected;raise primary))

  fun prepare_source_rule expected
      {source,frame,caller,steps,terminal,check_type} =
    sr_fail expected (fn () => W.with_step expected (fn () =>
    let
      (* The expected owner is checked before any foreign frame or child. *)
      val _ = source_realization_guard expected source
      val SourceRealization {graph,root,scope=source_scope,
        original_sources,target,compact,template_limit,...} = source
      val d = Scope.description_for expected frame
      val scope = #scope d
      val _ = if Portable.pointer_eq (#graph d,graph) andalso #root d=root
          andalso Portable.pointer_eq (#sources d,original_sources)
          andalso G.scope_visible graph scope source_scope then () else
        raise ERR "prepare_source_rule" "foreign or invisible Source frame"
      val _ = G.validate_scope graph caller
      val SourceCompact {block=Block {leaves,...},proof,target_name,names,
        needed,extra_leaves,cuts,...} = compact
      val _ = if Term.is_var target_name then () else
        raise ERR "prepare_source_rule" "Source clause is not named"
      val limits = W.semantic_limits expected
      val quota = IntInf.fromInt (W.work_limit expected)
      val output = IntInf.fromInt (#output_limit limits)
      val budget = ref (0:IntInf.int)
      val policies = ref ([]:sr_type list)
      val next = ref 0
      val identifiers = ref ([]:string list)
      val binders = ref ([]:(int * string * Type.hol_type) list)
      fun tick n = W.spend expected n
      fun snapshot ty =
        (tick 1;SRCaptured ty ::
          (if Type.is_vartype ty then [] else
            List.concat (List.map snapshot (#Args (Type.dest_thy_type ty)))))
      fun weight (SRCaptured ty) = IntInf.fromInt (List.length (snapshot ty))
        | weight (SRArrow (a,b)) = 1 + weight a + weight b
      fun types ty = ty :: (case ty of SRCaptured actual =>
          (if Type.is_vartype actual then [] else
            List.concat (List.map snapshot
              (#Args (Type.dest_thy_type actual))))
        | SRArrow (a,b) => types a @ types b)
      fun atom shape ty = SRTree {ty=ty,shape=shape,raw=1,inc=1,
        annotations=types ty}
      fun app ty left right = SRTree
        {ty=ty,shape=SRApp (left,right),raw=1+sr_raw left+sr_raw right,
         inc=1+sr_inc left+sr_inc right,
         annotations=types ty @ sr_types left @ sr_types right}
      fun lam ty id variable body = SRTree
        {ty=ty,shape=SRLam (id,variable,body),raw=1+sr_raw body,
         inc=2+sr_inc body,
         annotations=types ty @ sr_types variable @ sr_types body}
      fun remember name = (tick (String.size name+1);
        if List.exists (fn held => held=name) (!identifiers) then ()
        else identifiers := name :: !identifiers)
      fun binding variable [] = NONE
        | binding variable ((held,id)::rest) =
            (tick 1;if sr_same variable held then SOME id
             else binding variable rest)
      fun bound cap term =
        (case SmtReplayImport.bounded_raw_size cap term of
           SOME n => tick n | NONE => raise ERR "prepare_source_rule"
             "bounded clause or named operand raw cap";
         case SmtReplayImport.bounded_binder_size cap term of
           SOME n => tick n | NONE => raise ERR "prepare_source_rule"
             "bounded clause or named operand binder cap")
      fun scan term =
        let fun walk lexical current =
          let val _ = tick 1
              val ty = SRCaptured (Term.type_of current)
          in if Term.is_var current then
              let val (name,_) = Term.dest_var current
                  val _ = remember name
              in case binding current lexical of
                  NONE => atom (SRAtom current) ty
                | SOME id => atom (SRBound (id,current)) ty end
            else if Term.is_comb current then
              let val (f,x) = Term.dest_comb current
              in app ty (walk lexical f) (walk lexical x) end
            else if Term.is_abs current then
              let val (v,b) = Term.dest_abs current
                  val (name,vty) = Term.dest_var v
                  val _ = remember name
                  val id = !next val _ = next := id+1
                  val variable = atom (SRBound (id,v)) (SRCaptured vty)
              in lam ty id variable (walk ((v,id)::lexical) b) end
            else atom (SRAtom current) ty
          end
        in walk [] term end
      fun capture cap term = (bound cap term;scan term)
      (* This is a realized Source PROOF operand, not an initial expression
         focus. C.project_rule and the existing semantic matcher use the
         original output convention here; initial input admission remains
         the expression consumer's obligation. No Work cap is replaced. *)
      val clause = capture (#output_limit limits)
        (G.representative graph target)
      val named = capture template_limit (Thm.concl proof)
      val named_hyp = List.map (capture template_limit) (Thm.hyp proof)
      fun named_node node = case List.find (fn (old,_) => old=node) names of
          SOME (_,variable) => variable | NONE =>
            raise ERR "prepare_source_rule" "missing authentic name"
      fun leaf index = if index < Vector.length leaves then
          Vector.sub (leaves,index)
        else List.nth (extra_leaves,index-Vector.length leaves)
      fun row index = case List.find (fn (slot,_,_) => slot=index) cuts of
          SOME (_,term,_) => term | NONE => leaf_term named_node (leaf index)
      val row_trees = List.map
        (fn index => (index,capture template_limit (row index))) needed
      val arguments = List.mapPartial (fn SourceSpec child => SOME child
        | _ => NONE) steps
      val argument_trees = List.map (fn child =>
        let val node=G.closure_child_node graph caller child
            val _ = if G.scope_visible graph scope
                (G.node_scope graph node) then () else
              raise ERR "prepare_source_rule" "argument escapes actual frame"
        in capture (#output_limit limits) (G.representative graph node) end)
        arguments
      (* Choose names only AFTER every bounded clause/argument variable has
         been seen. The opaque raw Source hypotheses are never scanned. *)
      fun fresh prefix ty =
        let fun choose n =
              let val candidate=prefix ^ Int.toString n
                  val _=tick (String.size candidate+1)
              in if List.exists (fn old => old=candidate) (!identifiers)
                then choose (n+1) else
                  (identifiers:=candidate :: !identifiers;candidate) end
            val name=choose 0
        in atom (SRFresh (name,ty)) (SRCaptured ty) end
      val renaming = List.map (fn (node,old) =>
        let val (_,ty)=Term.dest_var old
        in (node,old,fresh "__smt_source_clause_" ty) end) names
      fun rename (value as SRTree {ty,shape,...}) = case shape of
          SRAtom old => (case List.find
              (fn (_,name,_) => sr_same old name) renaming of
                SOME (_,_,replacement) => replacement | NONE => value)
        | SRApp (a,b) => app ty (rename a) (rename b)
        | SRLam (id,v,b) => lam ty id v (rename b)
        | _ => value
      val clause_name = case List.find
          (fn (_,name,_) => sr_same name target_name) renaming of
          SOME (_,_,replacement) => replacement
        | NONE => raise ERR "prepare_source_rule" "missing clause name"
      fun same_fresh (SRTree {shape=SRFresh (a,_),...})
          (SRTree {shape=SRFresh (b,_),...}) = a=b
        | same_fresh _ _ = false
      fun insert (value as SRTree {ty,shape,...}) =
        if same_fresh value clause_name then clause else case shape of
          SRApp (a,b) => app ty (insert a) (insert b)
        | SRLam (id,v,b) => lam ty id v (insert b)
        | _ => value
      val substituted_hyp = List.map (insert o rename) named_hyp
      val rows = List.map (fn (index,value) =>
        (index,insert (rename value))) row_trees
      fun head thy name (SRTree {shape=SRAtom term,...}) =
            Term.is_const term andalso
              let val c=Term.dest_thy_const term
              in #Thy c=thy andalso #Name c=name end
        | head _ _ _ = false
      fun binary thy name (SRTree {shape=SRApp
          (SRTree {shape=SRApp (h,a),...},b),...}) =
            if head thy name h then SOME (a,b) else NONE
        | binary _ _ _ = NONE
      fun forall (SRTree {shape=SRApp (h,
          SRTree {shape=SRLam (id,v,b),...}),...}) =
            if head "bool" "!" h then SOME (id,v,b) else NONE
        | forall _ = NONE
      fun substitute id replacement (value as SRTree {ty,shape,...}) =
        case shape of SRBound (old,_) =>
            if id=old then replacement else value
          | SRApp (a,b) => app ty (substitute id replacement a)
              (substitute id replacement b)
          | SRLam (old,v,b) => if id=old then value else
              lam ty old v (substitute id replacement b)
          | _ => value
      fun constructors (SRCaptured _) = 0 : IntInf.int
        | constructors (SRArrow (a,b)) = 1+constructors a+constructors b
      fun record_limit cap hypotheses value =
        let val _ = if sr_raw value<=cap andalso sr_inc value<=cap
              then () else raise ERR "prepare_source_rule"
                "prospective local proof result bound"
            val all=value :: hypotheses
            val cost=List.foldl (fn (t,n) =>
              n+sr_raw t+sr_inc t+
                IntInf.fromInt (List.length (sr_types t)) +
                List.foldl (fn (ty,k) => k+constructors ty) 0
                  (sr_types t)) 0 all
            val _ = budget := !budget+cost
            val _ = if !budget<=quota then () else
              raise ERR "prepare_source_rule" "prospective original Work"
        in policies := List.concat (List.map sr_types all) @ !policies end
      fun record hypotheses value = record_limit output hypotheses value
      fun named_record hypotheses value = record_limit quota hypotheses value
      val bool=SRCaptured Type.bool
      fun boolean term=atom (SRAtom term) bool
      fun combine constant a b =
        let val h=atom (SRAtom constant) (SRArrow (bool,SRArrow (bool,bool)))
        in app bool (app (SRArrow (bool,bool)) h a) b end
      fun implication a b=combine boolSyntax.implication a b
      fun equality a b=combine boolSyntax.equality a b
      fun align current hypotheses =
        (* Exact planned representative may alpha-rename bound variables. *)
        (record hypotheses (equality current current);
         record hypotheses current)
      val _=named_record named_hyp named
      val _=named_record (List.map rename named_hyp) (rename named)
      val _=List.app (fn (_,_,fresh)=>named_record [] fresh) renaming
      (* Retain DATA from the exact existing row records. No new
         ordinary Work, guard or native operation is introduced. *)
      val row_admission=List.map(fn(index,tree)=>
        let val before_row= !budget val _=named_record []tree
        in(index,tree,!budget-before_row)end)rows
      val hyp_before= !budget
      val _=record substituted_hyp clause
      (* Exact existing clause+ALL-Hyp record: no new native/Work call. *)
      val hyp_admission=(clause,!budget-hyp_before)
      fun play [] [] current conditions instructions =
            (current,conditions,List.rev instructions)
        | play (step::rest) args current conditions instructions =
          let val _=tick 1
              val (action,result,args,conditions)=case step of
                SourceSpec _ =>
                  let val (id,variable,body)=case forall current of
                      SOME d => d | NONE => raise ERR "prepare_source_rule"
                        "SPEC requires actual explicit forall"
                      val argument=case args of a::_ => a | [] =>
                        raise ERR "prepare_source_rule" "missing argument"
                      val _=record [] argument
                      val aty=case sr_type argument of SRCaptured t=>t
                        | _=>raise ERR "prepare_source_rule" "argument type"
                      val vty=case sr_type variable of SRCaptured t=>t
                        | _=>raise ERR "prepare_source_rule" "binder type"
                      val _=if Type.compare (aty,vty)=EQUAL then () else
                        raise ERR "prepare_source_rule" "SPEC type mismatch"
                  in (SRSpec argument,substitute id argument body,
                    List.tl args,conditions) end
              | SourceConjunct left =>
                  let val (a,b)=case binary "bool" "/\\" current of
                      SOME d=>d | NONE=>raise ERR "prepare_source_rule"
                        "projection requires actual conjunction"
                  in (SRConjunct left,if left then a else b,args,conditions)
                  end
              | SourceCondition =>
                  let val (a,b)=case binary "min" "==>" current of
                      SOME d=>d | NONE=>raise ERR "prepare_source_rule"
                        "condition requires actual implication"
                      val _=record [a] a
                  in (SRCondition,b,args,a::conditions) end
              val hypotheses=conditions @ substituted_hyp
              val _=record hypotheses result
              val _=align result hypotheses
          in play rest args result conditions
            ((action,result,conditions)::instructions) end
        | play _ _ _ _ _ = raise ERR "prepare_source_rule"
            "argument and operation route changed"
      val (body,conditions,instructions)=play steps argument_trees clause [] []
      val result=case terminal of SourceEquality =>
            (case binary "min" "=" body of SOME _=>body | NONE=>
              raise ERR "prepare_source_rule" "terminal is not equality")
        | SourceTruth =>
            let val eq=equality body (boolean boolSyntax.T)
                val _=record [] (equality eq body)
            in eq end
        | SourceFalse =>
            let val operand=case #shape (sr_data body) of
                  SRApp (h,p)=>if head "bool" "~" h then p else
                    raise ERR "prepare_source_rule" "terminal not negation"
                | _=>raise ERR "prepare_source_rule" "terminal not negation"
                val eq=equality operand (boolean boolSyntax.F)
                val _=record [] (equality body eq)
            in eq end
      val _=record (conditions @ substituted_hyp) result
      val final=List.foldl (fn (condition,current) =>
        let val value=implication condition current
        in record substituted_hyp value;value end) result conditions
      val _=if sr_raw final<=IntInf.fromInt template_limit andalso
          sr_inc final<=IntInf.fromInt template_limit then () else
        raise ERR "prepare_source_rule" "conditional compact template bound"
      val _=record substituted_hyp (equality final final)
      (* Complete named realization portfolio. These contexts contain only
         authenticated private variables and the bounded clause. They are
         not expanded Source Gamma and carry no universal Source-tree cap. *)
      val row_vector=Vector.fromList (List.map #2 rows)
      val boundary=make_tree 0 (Vector.length row_vector)
      fun forest Empty=boolean boolSyntax.T
        | forest (Leaf index)=Vector.sub (row_vector,index)
        | forest (Split (a,b))=combine boolSyntax.conjunction
            (forest a) (forest b)
      val context=forest boundary
      val before_context= !budget
      val _=named_record [context] context
      val row_context=(context,!budget-before_context)
      fun projection Empty=()
        | projection (Leaf index)=named_record [context]
            (Vector.sub (row_vector,index))
        | projection (Split (a,b))=
            (named_record [context] (forest a);
             named_record [context] (forest b);
             projection a;projection b)
      val _=projection boundary
      val _=List.app (fn (_,row)=>
        (named_record [context] row;
         named_record (context :: substituted_hyp) final)) rows
      val _=named_record [] (implication context final)
      (* The protected-name scan performed at realization is also reserved
         now. Its nodes are small named syntax, not inserted raw residues. *)
      val scan_quote=List.foldl (fn (tree,sum)=>sum+sr_raw tree) 0
        (final :: List.map #2 rows)
      val _=budget:= !budget+scan_quote
      val _=if !budget<=quota then () else
        raise ERR "prepare_source_rule" "named realization original Work"
      (* Bound variables use another disjoint private vocabulary. SPEC and
         ALPHA remain checked; a printed variable name is never a binder ID. *)
      fun collect (SRTree {shape,...}) = case shape of
          SRLam (id,SRTree {shape=SRBound (_,v),...},body) =>
            (if List.exists (fn (old,_,_)=>old=id) (!binders) then () else
              let val (_,ty)=Term.dest_var v
                  val fresh=case #shape (sr_data
                      (fresh "__smt_source_bound_" ty)) of
                      SRFresh (name,_)=>name | _=>raise ERR
                        "prepare_source_rule" "fresh binder grammar"
              in binders:=(id,fresh,ty):: !binders end;collect body)
        | SRApp (a,b)=>(collect a;collect b)
        | _=>()
      val _=List.app collect
        (final :: clause :: named :: substituted_hyp @ List.map #2 rows)
      val _=List.app (fn (SRSpec argument,_,_)=>collect argument | _=>())
        instructions
      (* Reserve all repeated typed proof/constructor grammar before any
         Type constructor, caller policy, fresh variable or proof effect. *)
      val _=pay expected (!budget)
      val plan=SourceRulePlan {work=expected,source=source,frame=frame,
        caller=caller,scope=scope,arguments=arguments,renaming=renaming,
        named=named,named_hyp=named_hyp,rows=rows,
        hyp_forecast=substituted_hyp,hyp_admission=hyp_admission,
        row_admission=row_admission,row_context=row_context,
        instructions=instructions,terminal=terminal,result=final,
        conditions=conditions,types= !policies,quote= !budget,
        check_type=check_type,binders= !binders,phase=ref SRPrepared}
      val _=sr_guard expected plan
    in plan end))

  (* The complete post-INST universe is owned by this producer. No native
     abstraction is opened before EVERY forecast Hyp has certified atoms,
     exact incidence and its original admitted aggregate Hyp quote.
     Matching preserves actual names; it never adopts a caller syntax tree. *)
  datatype sr_forest_admission=SRHypForestAdmission of
      {trees:sr_tree list,clause:sr_tree,delta:IntInf.int}
    | SRRowForestAdmission of
      {rows:(int*sr_tree*IntInf.int)list,context:sr_tree,delta:IntInf.int}
  (* Both receivers use this ONE typed lexical certificate/matcher.
     Its fixed portfolio is private producer DATA, not caller syntax. *)
  fun sr_admitted_forest_programme expected
      (plan as SourceRulePlan{quote,...})fresh admission actual_hyp=
    let
      exception UnsupportedHypForest
      exception HypForestMismatch
      fun live()=sr_guard expected plan
      fun tick n=
        (live();if IntInf.fromInt n<=remaining expected then
           W.spend expected n else raise UnsupportedHypForest)
      fun guarded operation=
        (live();let val result=operation()in live();result end)
      fun rebuilt(SRTree{ty,raw,inc,annotations,...})shape=
        (tick 1;SRTree{ty=ty,shape=shape,raw=raw,inc=inc,
          annotations=annotations})
      fun native_name term=
        if guarded(fn()=>Term.is_var term)then
          let val(name,_)=guarded(fn()=>Term.dest_var term)
          in tick(String.size name+1)end
        else if guarded(fn()=>Term.is_const term)then
          let val {Thy,Name,...}=guarded(fn()=>Term.dest_thy_const term)
          in tick(String.size Thy);tick(String.size Name+1)end
        else ()
      fun same_type expected_type actual_type=
        let fun pending []=()
              | pending((SRCaptured ty,actual)::rest)=
                  (tick 1;if guarded(fn()=>Type.compare(ty,actual))=EQUAL
                   then pending rest else raise HypForestMismatch)
              | pending((SRArrow(a,b),actual)::rest)=
                  (tick 1;if guarded(fn()=>Type.is_vartype actual)then
                     raise HypForestMismatch
                   else let val {Thy,Tyop,Args}=guarded(fn()=>
                                Type.dest_thy_type actual)
                        in case(Thy,Tyop,Args)of
                            ("min","fun",[left,right])=>
                              pending((a,left)::(b,right)::rest)
                          | _=>raise HypForestMismatch end)
        in pending[(expected_type,actual_type)]end
      fun lexical id []=raise HypForestMismatch
        | lexical id((held,variable)::rest)=
            (tick 1;if id=held then variable else lexical id rest)
      fun named name []=raise HypForestMismatch
        | named name((held,variable)::rest)=
            (tick 1;if name=held then variable else named name rest)
      fun atomic term=
        guarded(fn()=>Term.is_var term)orelse
        guarded(fn()=>Term.is_const term)
      fun annotations tree=
        let fun constructors [] (count:IntInf.int)=count
              | constructors(SRCaptured _::rest)count=
                  (tick 1;constructors rest count)
              | constructors(SRArrow(a,b)::rest)count=
                  (tick 1;constructors(a::b::rest)(count+1))
            fun count [] (result:IntInf.int)=result
              | count(ty::rest)result=
                  (tick 1;count rest(result+1+constructors[ty]0))
        in count(sr_types tree)(0:IntInf.int)end
      datatype certificate=Certify of sr_tree | CertApp of sr_tree
        | CertLam of sr_tree
      fun certify tree=
        let fun verify forest(raw,inc)=
                  if raw=sr_raw forest andalso inc=sr_inc forest then
                    (raw,inc)else raise UnsupportedHypForest
            fun run [] [result]=result
              | run(Certify forest::rest)values=
                  (tick 2;case #shape(sr_data forest)of
                     SRAtom term=>
                       if atomic term then
                         run rest(verify forest(1,1)::values)
                       else raise UnsupportedHypForest
                   | SRFresh(name,_)=>
                       if guarded(fn()=>Term.is_var(named name fresh))then
                         run rest(verify forest(1,1)::values)
                       else raise UnsupportedHypForest
                   | SRBound(_,term)=>
                       if guarded(fn()=>Term.is_var term)then
                         run rest(verify forest(1,1)::values)
                       else raise UnsupportedHypForest
                   | SRApp(a,b)=>run(Certify a::Certify b::
                       CertApp forest::rest)values
                   | SRLam(id,variable,body)=>
                       (case #shape(sr_data variable)of
                          SRBound(held,term)=>
                            if held=id andalso
                                guarded(fn()=>Term.is_var term)andalso
                                sr_raw variable=1 andalso sr_inc variable=1
                            then run(Certify body::CertLam forest::rest)
                              values else raise UnsupportedHypForest
                        | _=>raise UnsupportedHypForest))
              | run(CertApp forest::rest)((r2,i2)::(r1,i1)::values)=
                  run rest(verify forest(1+r1+r2,1+i1+i2)::values)
              | run(CertLam forest::rest)((raw,inc)::values)=
                  run rest(verify forest(1+raw,2+inc)::values)
              | run _ _=raise UnsupportedHypForest
        in run[Certify tree][]end
      fun universe [](count,cost)=(count,cost)
        | universe(tree::rest)(count,cost)=
            let val(raw,inc)=certify tree
                val typed=annotations tree val _=tick 1
            in universe rest(count+1,cost+raw+inc+typed)end
      fun actual_count [] count=count
        | actual_count(_::rest)count=
            (tick 1;actual_count rest(count+1))
      fun atom_same expected actual=
        (tick 1;
         if (guarded(fn()=>Term.is_var expected)andalso
             guarded(fn()=>Term.is_var actual))orelse
            (guarded(fn()=>Term.is_const expected)andalso
             guarded(fn()=>Term.is_const actual))then
           if guarded(fn()=>Term.term_eq expected actual)then ()else
             raise HypForestMismatch
         else raise HypForestMismatch)
      datatype task=Match of sr_tree*Term.term*(int*Term.term)list
        | BuildApp of sr_tree | BuildLam of sr_tree*Term.term
      fun matching tree actual=
        let
          fun run [] [result]=result
            | run(Match(forest,current,bindings)::rest)values=
                let val _=tick 2
                    val _=same_type(sr_type forest)
                      (guarded(fn()=>Term.type_of current))
                in case #shape(sr_data forest)of
                    SRAtom original=>
                      (atom_same original current;native_name current;
                       run rest(rebuilt forest(SRAtom current)::values))
                  | SRFresh(name,_)=>
                      (atom_same(named name fresh)current;
                       native_name current;run rest
                         (rebuilt forest(SRAtom current)::values))
                  | SRBound(id,_)=>
                      (atom_same(lexical id bindings)current;
                       native_name current;run rest
                         (rebuilt forest(SRBound(id,current))::values))
                  | SRApp(a,b)=>
                      if guarded(fn()=>Term.is_comb current)then
                        let val(left,right)=guarded(fn()=>
                                  Term.dest_comb current)
                            val _=tick 3
                        in run(Match(a,left,bindings)::
                          Match(b,right,bindings)::BuildApp forest::rest)
                          values end else raise HypForestMismatch
                  | SRLam(id,variable,body)=>
                      if guarded(fn()=>Term.is_abs current)then
                        let val(v,b)=guarded(fn()=>Term.dest_abs current)
                            val _=same_type(sr_type variable)
                              (guarded(fn()=>Term.type_of v))
                            val _=native_name v val _=tick 3
                        in run(Match(body,b,(id,v)::bindings)::
                          BuildLam(forest,v)::rest)values end
                      else raise HypForestMismatch
                end
            | run(BuildApp forest::rest)(right::left::values)=
                run rest(rebuilt forest(SRApp(left,right))::values)
            | run(BuildLam(forest,v)::rest)(body::values)=
                let val(id,variable)=case #shape(sr_data forest)of
                      SRLam(id,variable,_)=> (id,variable)
                    | _=>raise HypForestMismatch
                    val variable=rebuilt variable(SRBound(id,v))
                in run rest(rebuilt forest(SRLam(id,variable,body))::values)
                end
            | run _ _=raise HypForestMismatch
        in SOME(run[Match(tree,actual,[])][])
           handle HypForestMismatch=>NONE end
      fun choose actual []=NONE
        | choose actual(tree::rest)=
            (tick 1;case matching tree actual of SOME value=>SOME value
             | NONE=>choose actual rest)
    in
      (let val trees=case admission of
          SRHypForestAdmission{trees,...}=>trees
        | SRRowForestAdmission{rows,context,...}=>
            let val values=List.map(fn(_,tree,_)=>
                  (tick 4;tree))rows
                val _=tick 2
            in values@[context]end
      fun associate [] result=List.rev result
        | associate(hypothesis::rest)result=
            (tick 2;case choose hypothesis trees of
               SOME forest=>associate rest((hypothesis,forest)::result)
             | NONE=>associate rest result)
      fun matches actual=
        let fun walk [] _ result=SOME(List.rev result)
              | walk(tree::rest)index result=
                  (tick 1;case matching tree actual of
                     SOME forest=>walk rest(index+1)((index,forest)::result)
                   | NONE=>walk rest(index+1)result)
        in let val result=walk trees 0[] val _=live()
           in result end handle UnsupportedHypForest=>NONE end
      fun hypotheses()=
        (let val result=associate actual_hyp[] val _=live()
         in result end handle UnsupportedHypForest=>[]
           | HypForestMismatch=>[])
    in
      (* ALL candidate syntax and exact paid incidence are certified before
         actual Hyp constructor tests. Native order/dedup is never zipped. *)
      (let val(count,cost)=universe trees(0,0)
           val _=case admission of
             SRHypForestAdmission{clause,delta,...}=>
               let val(raw,inc)=certify clause
                   val typed=annotations clause
               in if cost+raw+inc+typed=delta andalso delta<=quote
                   andalso delta>=0 then ()else
                     raise UnsupportedHypForest end
           | SRRowForestAdmission{rows,context,delta}=>
               let fun check [](sum:IntInf.int)=sum
                     | check((_,tree,amount)::rest)sum=
                         let val(raw,inc)=certify tree
                             val typed=annotations tree
                         in if raw+inc+typed=amount andalso amount>=0
                             then check rest(sum+amount)else
                               raise UnsupportedHypForest end
                   val row_cost=check rows 0
                   val(raw,inc)=certify context
                   val typed=annotations context
               in if 2*(raw+inc+typed)=delta andalso delta>=0
                   andalso row_cost+delta<=quote then ()else
                     raise UnsupportedHypForest end
           val _=if actual_count actual_hyp 0<=count then ()else
             raise UnsupportedHypForest
           val _=live()
       in SOME{hypotheses=hypotheses,matches=matches}end
       handle UnsupportedHypForest=>NONE | HypForestMismatch=>NONE)
       end handle UnsupportedHypForest=>NONE | HypForestMismatch=>NONE)
    end
  fun sr_admitted_hyp_forests expected
      (plan as SourceRulePlan{hyp_forecast,hyp_admission,...})fresh actual=
    let val(clause,delta)=hyp_admission
    in case sr_admitted_forest_programme expected plan fresh
         (SRHypForestAdmission{trees=hyp_forecast,clause=clause,delta=delta})
         actual of NONE=>[] | SOME{hypotheses,...}=>hypotheses()end

  fun execute_source_rule expected (plan as SourceRulePlan
      {work,source,renaming,named,rows,instructions,terminal,result,
       conditions,types,binders,check_type,phase,...}) =
    sr_fail expected (fn () => W.with_step expected (fn () =>
    let
      val _=sr_guard expected plan
      val _=if !phase=SRPrepared then () else
        raise ERR "execute_source_rule" "Source rule plan already consumed"
      val _=phase:=SRExecuted
      fun guarded operation =
        (sr_guard expected plan;
         let val value=operation () in sr_guard expected plan;value end)
      fun materialize_type (SRCaptured ty) = guarded (fn () => ty)
        | materialize_type (SRArrow (a,b)) =
            let val left=materialize_type a val right=materialize_type b
            in guarded (fn () => Type.mk_thy_type
              {Thy="min",Tyop="fun",Args=[left,right]}) end
      val policy_types=List.map materialize_type types
      val _=List.app (fn ty => guarded (fn () => check_type ty)) policy_types
      val variables=List.map (fn (id,name,ty) =>
        (id,guarded (fn () => Term.mk_var (name,ty)))) binders
      fun bound id = case List.find (fn (old,_) => old=id) variables of
          SOME (_,variable) => variable | NONE =>
            raise ERR "execute_source_rule" "missing lexical binder"
      val fresh=ref ([]:(string * Term.term) list)
      fun variable name ty = case List.find (fn (old,_) => old=name)
          (!fresh) of SOME (_,term) => term | NONE =>
            let val term=guarded (fn () => Term.mk_var (name,ty))
            in fresh:=(name,term):: !fresh;term end
      val _=W.spend expected nc_model_fee
      fun capture_tick amount=(sr_guard expected plan;
        W.spend expected amount)
      fun capture_sum held total maximum (count:IntInf.int)=
        (capture_tick nc_walk_fee;case held of []=>(total,maximum,count)
         | (_,_,SRTree{raw,...})::rest=>capture_sum rest(total+raw)
             (IntInf.max(maximum,raw))(count+1))
      fun capture_conditions held total=
        (capture_tick nc_walk_fee;case held of []=>total
         | SRTree{raw,...}::rest=>capture_conditions rest(total+raw))
      fun capture_steps held total (count:IntInf.int)=
        (capture_tick nc_walk_fee;case held of []=>(total,count)
         | (action,SRTree{raw,...},_)::rest=>
             let val extra=case action of SRSpec(SRTree{raw,...})=>raw
                   | _=>0
             in capture_steps rest(total+raw+extra)(count+1)end)
      fun capture_binders held (count:IntInf.int)=
        (capture_tick nc_walk_fee;case held of []=>count
         | _::rest=>capture_binders rest(count+1))
      fun capture_card theorem=
        (capture_tick nc_card_fee;
         IntInf.fromInt(HOLset.numItems(Thm.hypset theorem)))
      val _=capture_tick nc_model_fee
      val SourceRealization{compact=capture_compact,...}=source
      val SourceCompact{proof=capture_proof,...}=capture_compact
      val _=nt_tick(NTPrefix(expected,fn()=>sr_guard expected plan))
        nt_caller_capture_fee
      val SourceRealization{graph=transport_graph,target=transport_target,
        ...}=source
      val transport_clause=G.representative transport_graph transport_target
      val transport_prefix=nt_prepare_prefix expected
        (fn()=>sr_guard expected plan)source capture_proof transport_graph
        transport_target transport_clause
      val(renamed_events,clause_events,renaming_count)=
        capture_sum renaming 0 0 0
      val(step_events,capture_steps_count)=capture_steps instructions 0 0
      val condition_events=capture_conditions conditions 0
      val binder_count=capture_binders binders 0
      val initial_H=capture_card capture_proof
      val borrowed_H=capture_card boolTheory.EQ_CLAUSES
      val _=if borrowed_H=0 then ()else raise ERR "constructor_capture"
        "fixed Boolean bootstrap Hyp is not closed"
      val _=capture_tick nc_model_fee
      val SRTree{raw=result_events,...}=result
      val capture_events=2*renamed_events+clause_events+step_events+
        2*condition_events+result_events
      val capture_H=initial_H+capture_steps_count
      val _=nt_tick(NTPrefix(expected,fn()=>sr_guard expected plan))
        (nt_model_fee+nt_condition_dispatch_fee)
      val transport_subtotal=case conditions of
          []=>nt_same_subtotal renaming_count capture_events
            initial_H capture_H
        | _=>nt_subtotal renaming_count capture_events initial_H capture_H-
            nt_condition_dispatch_credit
      val(capture,transport_auxiliary)=nc_prepare_combined_allowance expected
        (fn()=>sr_guard expected plan)capture_events binder_count capture_H
        transport_subtotal
      val _=nc_take capture nc_log_fee
      val constructor_log=ref[] : nc_log
      fun emit_result (SRTree {shape,...}) = case shape of
          SRAtom term=>nc_atom_result capture constructor_log term
        | SRFresh (name,ty)=>
            nc_atom_result capture constructor_log(variable name ty)
        | SRBound (id,_)=>nc_atom_result capture constructor_log(bound id)
        | SRLam (id,_,body)=>
            let val child as (b,_)=emit_result body
            in nc_binding_result false capture constructor_log
              variables id child
              (guarded (fn () => Term.mk_abs (bound id,b))) end
        | SRApp (SRTree {shape=SRApp
            (SRTree {shape=SRAtom h,...},a),...},b)=>
            if Term.is_const h andalso
                let val c=Term.dest_thy_const h
                in #Thy c="min" andalso #Name c="=" end then
              let val l as (left,_)=emit_result a
                  val r as (right,_)=emit_result b
              in nc_equality_result capture constructor_log l r
                (guarded (fn () => boolSyntax.mk_eq (left,right))) end
            else let val child as (argument,_)=emit_result a
                     val l as (left,_)=nc_application_result capture
                       constructor_log
                       (h,nc_head capture h)child
                       (guarded (fn () => Term.mk_comb (h,argument)))
                     val r as (right,_)=emit_result b
                 in nc_application_result capture constructor_log l r
                   (guarded (fn () => Term.mk_comb (left,right))) end
        | SRApp (a,b)=>
            let val l as (left,_)=emit_result a
                val r as (right,_)=emit_result b
            in nc_application_result capture constructor_log l r
                   (guarded (fn () => Term.mk_comb (left,right))) end
      fun emit tree= #1(emit_result tree)
      val SourceRealization {compact,...}=source
      val SourceCompact {proof,target_name,...}=compact
      (* Every renaming tree is the genuine fresh-variable atom selected
         by prepare_source_rule. Retain its actual emitter result instead
         of rediscovering that same origin by scanning the entire log.
         Native INST receives the same records, terms and list order. *)
      val emitted_substitutions=List.map (fn (_,old,tree) =>
        let val (residue,origin)=emit_result tree
        in ({redex=old,residue=residue},origin)end) renaming
      val substitutions=List.map #1 emitted_substitutions
      val clause_variable=case List.find
          (fn (_,old,_) => sr_same old target_name) renaming of
          SOME (_,_,tree)=>emit tree | NONE=>
            raise ERR "execute_source_rule" "missing retained clause name"
      val SourceRealization {graph,target,...}=source
      val clause=G.representative graph target
      val insertion=[{redex=clause_variable,residue=clause}]
      val transport=nt_prepare expected(fn()=>sr_guard expected plan)
        transport_auxiliary transport_prefix emitted_substitutions insertion
        constructor_log
      val renamed=guarded (fn () => SmtReplayRuleObservation.INST
        substitutions proof)
      val initial=guarded (fn () => SmtReplayRuleObservation.INST
        insertion renamed)
      fun align expected_term theorem =
        if Portable.pointer_eq (Thm.concl theorem,expected_term) then theorem
        else let val bridge=guarded (fn () =>
                    SmtReplayRuleObservation.ALPHA
                      (Thm.concl theorem) expected_term)
             in guarded (fn () =>
               SmtReplayRuleObservation.EQ_MP bridge theorem) end
      fun play [] theorem = theorem
        | play ((action,next,_)::rest) theorem =
            let val theorem=case action of SRSpec argument =>
                  let val value=emit argument
                  in guarded (fn () =>
                    SmtReplayRuleObservation.SPEC value theorem) end
                | SRConjunct left=>guarded (fn () =>
                    if left then SmtReplayRuleObservation.CONJUNCT1 theorem
                    else SmtReplayRuleObservation.CONJUNCT2 theorem)
                | SRCondition=>
                    let val condition= #1
                          (boolSyntax.dest_imp (Thm.concl theorem))
                        val premise=guarded (fn () =>
                          SmtReplayRuleObservation.ASSUME condition)
                    in guarded (fn () =>
                      SmtReplayRuleObservation.MP theorem premise) end
            in play rest (align (emit next) theorem) end
      val body=play instructions initial
      val body=case terminal of SourceEquality=>body
        | SourceTruth=>guarded (fn () => Drule.EQT_INTRO body)
        | SourceFalse=>guarded (fn () => Drule.EQF_INTRO body)
      val proof=List.foldl (fn (condition,theorem) =>
        let val value=emit condition
        in guarded (fn () => SmtReplayRuleObservation.DISCH value theorem)
        end) body conditions
      val target=emit result
      val proof=align target proof
      val names=List.map (fn (node,_,tree) => (node,emit tree)) renaming
      (* Reproduce the very SAME two simultaneous substitutions used by the
         proof; row terms are not guessed from the transformed conclusion. *)
      val SourceCompact {block=Block {leaves,...},names=old_names,needed,
        extra_leaves,cuts,...}=compact
      fun old_named node=case List.find (fn (old,_)=>old=node) old_names of
          SOME (_,term)=>term | NONE=>raise ERR "execute_source_rule"
            "missing authentic old leaf name"
      fun leaf index=if index<Vector.length leaves then
          Vector.sub (leaves,index)
        else List.nth(extra_leaves,index-Vector.length leaves)
      fun original_row index=case List.find (fn (slot,_,_)=>slot=index) cuts of
          SOME (_,term,_)=>term | NONE=>leaf_term old_named (leaf index)
      val actual_rows=List.map (fn index=>
        let val original=original_row index
            val renamed=guarded (fn()=>Term.subst substitutions original)
            val actual=guarded (fn()=>Term.subst insertion renamed)
        in (index,actual) end) needed
      val expected_tag=case terminal of SourceEquality=>Thm.tag initial
        | _=>Tag.merge (Thm.tag initial) (Thm.tag boolTheory.EQ_CLAUSES)
      val (oracles,_)=Tag.dest_tag (Thm.tag proof)
      val (expected_oracles,_)=Tag.dest_tag expected_tag
      val _=if oracles=expected_oracles andalso clean proof andalso
          null (Tag.axioms_of expected_tag) then () else
        raise ERR "execute_source_rule" "proof tag or axiom changed"
      val actual_conditions=List.rev(List.map emit conditions)
      val historical=nc_snapshot_priced capture constructor_log true proof
      val transported=case conditions of
          []=>nt_finish_same_set expected transport renamed initial historical
        | _=>nt_finish expected transport renamed initial historical
      val recipe=SourceRuleRecipe {plan=plan,base=compact,proof=proof,
        target=target,names=names,rows=actual_rows,
        conditions=actual_conditions,hyp_universe=(initial,!fresh),
        constructor_origins=SOME historical,
        source_effect_origins=SOME transported,realized=ref NONE}
      val _=nc_close_aux transport_auxiliary
      val _=nc_close_allowance capture
      val _=sr_guard expected plan
    in recipe end))

  fun validate_source_rule_for expected
      (SourceRuleRecipe {plan,proof,target,...}) =
    sr_fail expected (fn () =>
      (sr_guard expected plan;
       if clean proof andalso Portable.pointer_eq (Thm.concl proof,target)
       then () else raise ERR "source_rule" "derived named endpoint changed"))

  fun realize_source_rule expected
      (recipe as SourceRuleRecipe {plan=plan as SourceRulePlan
         {source,frame,scope,phase,...},base,proof,target,names,rows,
          realized,...}) =
    sr_fail expected (fn () =>
    let
      val _=validate_source_rule_for expected recipe
    in case !realized of SOME theorem=>theorem | NONE=>
      W.with_step expected (fn () =>
      let
        val _=validate_source_rule_for expected recipe
        val SourceRealization {graph,theorem=original,...}=source
        val SourceCompact {block=Block {leaves,...},needed,extra_leaves,
          cuts,...}=base
        fun guarded operation =
          (validate_source_rule_for expected recipe;
           let val value=operation ()
           in validate_source_rule_for expected recipe;value end)
        fun named node=case List.find (fn (old,_)=>old=node) names of
            SOME (_,term)=>term | NONE=>raise ERR "realize_source_rule"
              "missing authenticated fresh name"
        fun leaf index=if index<Vector.length leaves then
          Vector.sub (leaves,index)
          else List.nth(extra_leaves,index-Vector.length leaves)
        fun row index=case List.find (fn (slot,_)=>slot=index) rows of
            SOME (_,term)=>term | NONE=>raise ERR "realize_source_rule"
              "missing transformed actual leaf row"
        val selected=needed
        val hypotheses=Thm.hyp proof
        val _=if List.all (fn hyp=>List.exists
            (fn index=>Term.aconv hyp (row index)) selected) hypotheses
          then () else raise ERR "realize_source_rule"
            "local condition was not discharged from compact proof"
        (* No protected Source residue may be inserted below ANY binder.
           Binder independence does not authorize a large late insertion. *)
        fun no_bound protected term depth =
          (if Term.is_var term then
             if depth=0 orelse not (List.exists
                 (fn variable=>sr_same variable term) protected) then ()
             else raise ERR "realize_source_rule"
               "protected Source insertion below a binder"
           else if Term.is_comb term then
             let val (a,b)=Term.dest_comb term
             in no_bound protected a depth;no_bound protected b depth end
           else if Term.is_abs term then
             let val (_,body)=Term.dest_abs term
             in no_bound protected body (depth+1) end
           else ())
        val protected=List.map #2 names
        val _=List.app (fn term=>no_bound protected term 0)
          (target :: List.map row selected)
        (* This walks only the retained small vocabulary. Source Gamma is
           neither traversed nor passed to SPEC/INST before bulk realization.
           Whole realization/private costs remain a separate P obligation. *)
        val terms=Vector.fromList (List.map row selected)
        val tree=make_tree 0 (Vector.length terms)
        val context=guarded (fn()=>tree_term terms tree)
        val assumption=guarded (fn()=>SmtReplayRuleObservation.ASSUME context)
        val projections=guarded (fn()=>project tree assumption)
        val lifted=List.foldl (fn (premise,theorem)=>
          guarded (fn()=>SmtReplayRuleObservation.D_PROVE_HYP
            premise theorem)) proof projections
        val law=guarded (fn()=>SmtReplayRuleObservation.DISCH context lifted)
        val _=if null (Thm.hyp law) andalso clean law then () else
          raise ERR "realize_source_rule" "named law not closed"
        val sigma=List.map (fn (node,variable)=>
          (W.spend expected 1;
           {redex=variable,residue=G.representative graph node})) names
        val actual=guarded (fn()=>SmtReplayRuleObservation.INST sigma law)
        val (actual_context,actual_target)=
          boolSyntax.dest_imp (Thm.concl actual)
        val projected=Vector.fromList (project tree
          (guarded (fn()=>SmtReplayRuleObservation.ASSUME actual_context)))
        fun witness position index=case List.find
            (fn (slot,_,_)=>slot=index) cuts of
              SOME (_,_,parent)=>source_realization_theorem_for expected parent
          | NONE=>case leaf index of
              Source node=>guarded (fn()=>SmtReplayRuleObservation.ASSUME
                (G.representative graph node))
            | ClosedWitness fact=>
                (validate_closed_fact graph scope
                  (#template_limit (W.semantic_limits expected)) fact;
                 closed_proof fact)
            | ConversionWitness conversion=>
                (validate_conversion_for expected conversion;
                 conversion_proof conversion)
            | Definition _=>
                let val (a,b)=boolSyntax.dest_eq
                    (Thm.concl (Vector.sub(projected,position)))
                in guarded (fn()=>SmtReplayRuleObservation.ALPHA a b) end
        fun enumerate [] _=[]
          | enumerate (index::rest) position=
              witness position index :: enumerate rest (position+1)
        val witnesses=Vector.fromList (enumerate selected 0)
        val support=guarded (fn()=>tree_proof witnesses tree)
        val result=guarded (fn()=>SmtReplayRuleObservation.MP actual support)
        val _=if Portable.pointer_eq (Thm.concl result,actual_target)
            andalso clean result andalso List.all (fn hyp=>List.exists
              (fn old=>Portable.pointer_eq(hyp,old)) (Thm.hyp original))
              (Thm.hyp result) then () else
          raise ERR "realize_source_rule" "Original Source Hyp or tag changed"
        val _=validate_source_rule_for expected recipe
        val _=realized:=SOME result
      in result end)
    end)

  (* Bounded GEN consumes a genuine Source result. It is deliberately a
     distinct result, not an invented SourceCompact or arbitrary theorem
     recorder. Both actual body and surviving Gamma are realized and bounded
     before GEN; no protected large residue is substituted below its binder. *)
  datatype source_generalization_plan = SourceGeneralizationPlan of
    {work:W.portfolio,parent:source_realization,frame:Scope.receipt,
     graph:G.graph,scope:G.scope,target:G.node,opened:G.source,
     held:G.closure_child list,binders:G.binder_closure list,
     views:(G.node * G.source) list,
     variables:Term.term list,body:Term.term,proof:Thm.thm,
     gamma_names:(G.node * Term.term) list,epoch:int,symbols:int,
     available:bool ref}
  datatype source_generalization = SourceGeneralization of
    {plan:source_generalization_plan,theorem:Thm.thm}
  fun source_generalization_guard expected
      (SourceGeneralizationPlan {work,parent,frame,graph,scope,target,opened,
        held,binders,views,epoch,symbols,...}) =
    ((if Portable.pointer_eq (expected,work) then () else raise ERR
        "source_generalization" "different original Work";
      source_realization_guard expected parent;
      ignore (Scope.description_for expected frame);
      if Type.type_epoch ()=epoch andalso Term.term_epoch ()=symbols then ()
      else raise ERR "source_generalization" "retained epoch changed";
      G.validate_opened_view graph scope target opened;
      List.app (fn (node,view) =>
        G.validate_opened_view graph scope node view) views;
      List.app (fn child => ignore
        (G.closure_child_node graph scope child)) held;
      List.app (fn binder => ignore
        (G.binder_closure_data graph scope binder)) binders)
     handle primary => (W.close expected;raise primary))
  fun prepare_source_generalization expected
      {source,target,check_type} =
    ((source_realization_guard expected source;
      W.with_step expected (fn () =>
      let val data = source_realization_data_for expected source
          val graph = #graph data val scope = #scope data
          val limits = W.semantic_limits expected
          val template = #template_limit limits
          fun guard () =
            (source_realization_guard expected source;
             ignore (Scope.description_for expected (#frame data)))
          val _ = guard ()
          val _ = ignore (G.closure_root graph scope target)
          val original = case G.source_anchor graph target of
              SOME original => original
            | NONE => raise ERR "prepare_source_generalization"
                "missing actual target Source origin"
          fun bound cap term =
            (case SmtReplayImport.bounded_raw_size cap term of
               SOME size => W.spend expected size
             | NONE => raise ERR "prepare_source_generalization"
                 "fully realized binder operand raw cap";
             case SmtReplayImport.bounded_binder_size cap term of
               SOME size => W.spend expected size
             | NONE => raise ERR "prepare_source_generalization"
                 "fully realized binder operand inclusive cap")
          fun input term =
            (bound (#input_limit limits) term;bound template term)
          fun output term =
            (bound (#output_limit limits) term;bound template term)
          val _ = output (#original original)
          val (variables,body) = boolSyntax.strip_forall (#original original)
          val _ = if null variables then raise ERR
              "prepare_source_generalization" "target has no actual GEN"
            else ()
          val proof = source_realization_theorem_for expected source
          val _ = input (Thm.concl proof)
          val _ = List.app (fn term => (input term;output term))
            (Thm.hyp proof)
          val _ = List.app input variables
          val _ = input body
          val _ = if Term.aconv body (Thm.concl proof) then () else
            raise ERR "prepare_source_generalization"
              "different actual candidate body"
          (* Capture real construction/binder frames, not a caller's count
             or a target/body scalar pair. All scans are before policies. *)
          val opened = G.record_opened_view graph scope template target
          fun forall node = case G.view graph node of
              G.Application (head,argument) =>
                if Term.same_const (G.representative graph head)
                    boolSyntax.universal then SOME argument else NONE
            | _ => NONE
          val views = ref ([] : (G.node * G.source) list)
          val binders = ref ([] : G.binder_closure list)
          val held = ref [G.closure_root graph scope target]
          fun capture [] _ = ()
            | capture (variable::rest) node =
                let val _ = W.spend expected 1
                    val argument = case forall node of
                        SOME argument => argument
                      | NONE => raise ERR "prepare_source_generalization"
                          "different actual target binder spine"
                    val closure = G.binder_closure graph scope argument
                    val binding = G.binder_closure_data graph scope closure
                    val _ = if Type.compare (Term.type_of variable,
                        G.type_of graph (#binder binding))=EQUAL then () else
                      raise ERR "prepare_source_generalization"
                        "different actual binder domain"
                    val body = G.binder_closure_body graph scope closure
                    val _ = binders := closure :: !binders
                    val _ = held := body :: !held
                in capture rest (G.closure_child_node graph scope body) end
          val _ = capture variables (#node opened)
          fun occurrence term =
            case List.find (fn (_,node) => Portable.pointer_eq
                (term,G.representative graph node))
                (#source_occurrences data) of
              SOME (_,node) => node
            | NONE => raise ERR "prepare_source_generalization"
                "surviving Hyp has no actual Source occurrence"
          fun same left right =
            (W.spend expected 1;Term.aconv left right)
          fun fresh hypothesis =
            let val node = occurrence hypothesis
                val view = G.record_opened_view graph scope template node
                val _ = views := (node,view) :: !views
                val _ = held := G.closure_root graph scope (#node view) ::
                  !held
                val actual = case G.free_variables graph (#node view) of
                    G.Known values => values
                  | G.Unknown => raise ERR "prepare_source_generalization"
                      "missing actual Hyp free-variable receipt"
                val raw = Term.free_vars hypothesis
                val _ = if List.all (fn variable =>
                      List.exists (same variable) actual) raw andalso
                    List.all (fn variable =>
                      List.exists (same variable) raw) actual then () else
                  raise ERR "prepare_source_generalization"
                    "different actual Hyp free-variable inventory"
                val _ = if List.exists (fn variable =>
                    List.exists (same variable) actual) variables then
                  raise ERR "prepare_source_generalization"
                    "GEN variable occurs in actual surviving Hyp"
                  else ()
            in () end
          val _ = List.app fresh (Thm.hyp proof)
          (* Repeated annotations debit Work, independent of syntax caps.
             No annotation total is compared with template_limit. *)
          val types = ref ([] : Type.hol_type list)
          fun ty value =
            (W.spend expected 1;types := value :: !types;
             if Type.is_vartype value then () else
               List.app ty (#2 (Type.dest_type value)))
          fun syntax term =
            (W.spend expected 1;ty (Term.type_of term);
             if Term.is_comb term then
               let val (f,x) = Term.dest_comb term
               in syntax f;syntax x end
             else if Term.is_abs term then
               let val (v,b) = Term.dest_abs term
               in syntax v;syntax b end else ())
          val _ = List.app syntax
            (#original original :: body :: Thm.concl proof :: Thm.hyp proof)
          val epoch = Type.type_epoch () val symbols = Term.term_epoch ()
          fun envelope () =
            (guard ();G.validate_opened_view graph scope target opened;
             List.app (fn (node,view) =>
               G.validate_opened_view graph scope node view) (!views);
             List.app (fn child => ignore
               (G.closure_child_node graph scope child)) (!held);
             List.app (fn binder => ignore
               (G.binder_closure_data graph scope binder)) (!binders);
             if Type.type_epoch ()=epoch andalso Term.term_epoch ()=symbols
               then () else raise ERR "prepare_source_generalization"
                 "policy changed retained epoch")
          val _ = List.app (fn value =>
            (envelope ();check_type value;envelope ())) (List.rev (!types))
          val _ = output (G.representative graph target)
          val SourceRealization
            {compact=SourceCompact {names,...},...} = source
          val plan = SourceGeneralizationPlan
            {work=expected,parent=source,frame = #frame data,graph=graph,
             scope=scope,target=target,opened=opened,held= !held,
             binders= !binders,views= !views,variables=variables,body=body,
             proof=proof,
             gamma_names=names,epoch=epoch,symbols=symbols,available=ref true}
          val _ = source_generalization_guard expected plan
      in plan end))
     handle primary => (W.close expected;raise primary))
  fun execute_source_generalization expected
      (plan as SourceGeneralizationPlan
        {graph,target,variables,proof,available,...}) =
    ((source_generalization_guard expected plan;
      W.with_step expected (fn () =>
      let val _ = source_generalization_guard expected plan
          val _ = if !available then available := false else raise ERR
            "execute_source_generalization" "plan already executed"
          (* Primitive-event debit only; it is not a linear kernel cost
             certificate. Actual bounded operand/type scans were paid in
             prepare. Full private rule/kernel admission remains separate. *)
          val _ = W.spend expected (length variables+3)
          val generated = List.foldr (fn (variable,theorem) =>
            Thm.GEN variable theorem) proof variables
          val wanted = G.representative graph target
          val canonical = Thm.EQ_MP
            (Thm.ALPHA (Thm.concl generated) wanted) generated
          val _ = if Portable.pointer_eq (Thm.concl canonical,wanted) andalso
              ListPair.allEq Portable.pointer_eq
                (Thm.hyp canonical,Thm.hyp proof) andalso
              clean canonical andalso
              #1 (Tag.dest_tag (Thm.tag canonical))=
                #1 (Tag.dest_tag (Thm.tag proof)) then () else
            raise ERR "execute_source_generalization"
              "actual generated endpoint, Gamma or tags changed"
          val _ = source_generalization_guard expected plan
      in SourceGeneralization {plan=plan,theorem=canonical} end))
     handle primary => (W.close expected;raise primary))
  fun source_generalization_data_for expected
      (SourceGeneralization {plan = plan as SourceGeneralizationPlan
        {parent,target,variables,...},theorem}) =
    (source_generalization_guard expected plan;
     {source=parent,target=target,variables=variables,theorem=theorem})

  (* Each witness retains its ORIGINAL private compact base and index.
     The transformed value does not invent a new old-block name table. *)
  datatype sce_origin_tree=SCOAtom
    | SCOApp of sce_origin_tree*sce_origin_tree
    | SCOLam of Term.term*sce_origin_tree
  datatype sce_tree=SCEAtom of Term.term | SCEProtected of G.node
    | SCEApp of Type.hol_type*sce_tree*sce_tree
    | SCEAbs of Type.hol_type*Term.term*Term.term*sce_tree
  datatype sce_witness=SCEWitness of source_rule_recipe*int
  datatype source_condition_evidence=SCELeaf of source_rule_recipe
    | SCEApplied of {work:W.portfolio,frame:Scope.receipt,
        parents:source_condition_evidence list,proof:Thm.thm,
        target:Term.term,names:(G.node*Term.term) list,
        rows:(Term.term*sce_witness) list,origin:sce_origin_tree,
        constructor_origins:nc_proof option,
        effect_origins:nc_proof option,
        realized:Thm.thm option ref}
    | SCEProjected of {work:W.portfolio,graph:G.graph,caller:G.scope,
        children:G.closure_child list,value:source_condition_evidence,
        permutative:bool option}
  datatype source_condition_plan=SCEPlan of
    {work:W.portfolio,frame:Scope.receipt,
     parents:source_condition_evidence list,
     names:(G.node*string*Type.hol_type) list,
     programs:(sce_tree*sce_tree list) list,
     rows:(sce_tree*sce_witness) list,target:sce_tree,
     origin:sce_origin_tree,
     policies:Type.hol_type list,check_type:Type.hol_type -> unit,
     quote:IntInf.int,used:bool ref}

  fun sce_guard expected evidence=sr_fail expected (fn()=>
    case evidence of SCELeaf recipe=>validate_source_rule_for expected recipe
    | SCEProjected {work,graph,caller,children,value,...}=>
        (if Portable.pointer_eq(expected,work) then () else
           raise ERR "source_conditions" "foreign expected Work";
         G.validate_scope graph caller;
         List.app(fn child=>ignore(G.closure_child_node graph caller child))
           children;sce_guard expected value)
    | SCEApplied {work,frame,parents,proof,target,...}=>
        (if Portable.pointer_eq(expected,work) then () else
           raise ERR "source_conditions" "foreign expected Work";
         Scope.validate_lifetime_for expected frame;
         List.app (sce_guard expected) parents;
         if clean proof andalso Portable.pointer_eq(Thm.concl proof,target)
           then () else raise ERR "source_conditions"
             "transformed proof endpoint or provenance changed"))
  fun condition_evidence_for_rule expected recipe=
    (validate_source_rule_for expected recipe;SCELeaf recipe)
  type sce_snapshot={frame:Scope.receipt,proof:Thm.thm,target:Term.term,
    names:(G.node*Term.term) list,rows:(Term.term*sce_witness) list}
  fun sce_data expected evidence : sce_snapshot=
    (sce_guard expected evidence;
     case evidence of SCEProjected {value,...}=>sce_data expected value
      | SCELeaf(recipe as SourceRuleRecipe
         {plan=SourceRulePlan {frame,...},base=SourceCompact {needed,...},
          proof,target,names,rows,...})=>
         {frame=frame,proof=proof,target=target,names=names,
          rows=List.map (fn index=>
            case List.find (fn (slot,_)=>slot=index) rows of
              SOME (_,value)=>(value,SCEWitness(recipe,index))
            | NONE=>raise ERR "source_conditions"
                "missing genuine row") needed}
      | SCEApplied {frame,proof,target,names,rows,...}=>
         {frame=frame,proof=proof,target=target,names=names,rows=rows})

  (* Private read-only Hyp syntax. The caller owns the SAME Work action.
     Only current actual Hyp pointers can hit authentic producer forests;
     new UND/renamed SourceConditions Hyp remain explicitly unresolved. *)
  fun sce_admitted_hyp_rows_inside expected evidence=
    let
      fun live()=sce_guard expected evidence
      fun tick n=(live();W.spend expected n)
      val completed=ref([]:(source_rule_recipe*
        (Term.term*sr_tree)list)list)
      fun known recipe []=NONE
        | known recipe((held,rows)::rest)=
            (tick 1;if Portable.pointer_eq(recipe,held)then SOME rows
             else known recipe rest)
      fun pointer hypothesis []=false
        | pointer hypothesis(actual::rest)=
            (tick 1;Portable.pointer_eq(hypothesis,actual)orelse
             pointer hypothesis rest)
      fun find hypothesis []=NONE
        | find hypothesis((actual,forest)::rest)=
            (tick 1;if Portable.pointer_eq(hypothesis,actual)then
               SOME forest else find hypothesis rest)
      fun inherited hypothesis held=
        (sce_guard expected held;
         case held of
           SCELeaf(recipe as SourceRuleRecipe{plan,hyp_universe,...})=>
             let val(initial,fresh)=hyp_universe
                 val actual_hyp=Thm.hyp initial
                 val _=validate_source_rule_for expected recipe
             in if pointer hypothesis actual_hyp then
                  let val rows=case known recipe(!completed)of
                        SOME rows=>rows
                      | NONE=>
                          let val rows=sr_admitted_hyp_forests expected
                                plan fresh actual_hyp
                              val _=live()val _=tick 2
                              val _=completed:=(recipe,rows):: !completed
                          in rows end
                  in find hypothesis rows end
                else NONE end
         | SCEProjected{value,...}=>inherited hypothesis value
         | SCEApplied{parents,...}=>parents_for hypothesis parents)
      and parents_for hypothesis []=NONE
        | parents_for hypothesis(parent::rest)=
            (tick 1;case inherited hypothesis parent of SOME forest=>
               SOME forest | NONE=>parents_for hypothesis rest)
      val d=sce_data expected evidence
      fun collect [] result=List.rev result
        | collect(hypothesis::rest)result=
            let val _=tick 2
                val forest=inherited hypothesis evidence
                val _=live()
            in collect rest((hypothesis,forest)::result)end
      val _=live()
      val result=collect(Thm.hyp(#proof d))[]
      val _=live()
    in result end

  (* Eligibility is privately tied to the exact retained row programme.
     Re-emitted/mixed rows keep the old metadata fallback, never a guess. *)
  fun sce_admitted_row_programme_inside expected evidence=
    let val d=sce_data expected evidence
        fun live()=sce_guard expected evidence
        fun tick n=(live();W.spend expected n)
        fun recipe_of []=NONE
          | recipe_of((_,SCEWitness(recipe,_))::_)=SOME recipe
        fun same_rows _ [] []=true
          | same_rows recipe
              ((term,SCEWitness(held,index))::rest)((slot,_)::slots)=
              (tick 2;Portable.pointer_eq(recipe,held)andalso index=slot
               andalso same_rows recipe rest slots)
          | same_rows _ _ _=false
        fun actual_rows [] []=true
          | actual_rows((term,SCEWitness(_,index))::rest)
              ((slot,actual)::slots)=
              (tick 2;index=slot andalso Portable.pointer_eq(term,actual)
               andalso actual_rows rest slots)
          | actual_rows _ _=false
    in case recipe_of(#rows d)of NONE=>NONE
      | SOME(recipe as SourceRuleRecipe
          {plan=plan as SourceRulePlan{rows,row_admission,row_context,...},
           base=SourceCompact{needed,...},rows=actual,hyp_universe,...})=>
          let val _=validate_source_rule_for expected recipe
              val(initial,fresh)=hyp_universe
              val _=tick 2
              val eligible=same_rows recipe(#rows d)rows andalso
                actual_rows(#rows d)actual andalso
                List.map(fn(index,_)=>(tick 2;index))rows=needed andalso
                List.map(fn(index,_,_)=>(tick 2;index))
                  row_admission=needed
              val _=live()
          in if eligible then
               let val(context,delta)=row_context
               in SOME{plan=plan,fresh=fresh,
                 admission=SRRowForestAdmission{rows=row_admission,
                   context=context,delta=delta},rows= #rows d}end
             else NONE end
    end

  fun sr_lexical_origin charge(SRTree {shape,...})=
    (charge 1;case shape of SRApp(a,b)=>SCOApp
        (sr_lexical_origin charge a,sr_lexical_origin charge b)
      | SRLam(_,variable,body)=>
          let val original=case #shape(sr_data variable)of
                SRBound(_,term)=>term | SRAtom term=>term | _=>
                  raise ERR "lexical_origin" "missing genuine binder term"
          in SCOLam(original,sr_lexical_origin charge body)end
      | _=>SCOAtom)
  fun sce_lexical_origin_inside expected evidence=
    (sce_guard expected evidence;
     case evidence of SCELeaf(SourceRuleRecipe
         {plan=SourceRulePlan {result,...},...})=>
         sr_lexical_origin(fn n=>(sce_guard expected evidence;
           W.spend expected n))result
     | SCEProjected {value,...}=>sce_lexical_origin_inside expected value
     | SCEApplied {origin,...}=>origin)
  fun sce_tree_origin charge tree=
    (charge 1;case tree of SCEApp(_,a,b)=>SCOApp
        (sce_tree_origin charge a,sce_tree_origin charge b)
      | SCEAbs(_,_,original,body)=>SCOLam
          (original,sce_tree_origin charge body)
      | _=>SCOAtom)

  (* Lexical alpha equality in the prospective SMALL program. Protected
     Gamma identities compare graph nodes; no raw residue is opened. *)
  fun sce_equal charge left right=
    let
      fun equal_type a b=
        (charge 1;
         if Portable.pointer_eq(a,b) then true else
           let fun visit ty=
                 (charge 1;if Type.is_vartype ty then
                    charge(String.size(Type.dest_vartype ty))
                  else let val {Thy,Tyop,Args}=Type.dest_thy_type ty
                    in charge(String.size Thy+String.size Tyop);
                       List.app visit Args end)
           in visit a;visit b;Type.compare(a,b)=EQUAL end)
      fun walk lexical (SCEProtected a,SCEProtected b)=(charge 1;a=b)
          | walk lexical (SCEAtom a,SCEAtom b)=
              (charge 1;case List.find (fn (x,_)=>
                (charge 1;sr_same x a)) lexical of
                SOME (_,mapped)=>sr_same mapped b
              | NONE=>not(List.exists (fn (_,y)=>(charge 1;sr_same y b))
                  lexical)
                  andalso sr_same a b)
          | walk lexical (SCEApp(ty,a,b),SCEApp(other,c,d))=
              equal_type ty other andalso
              walk lexical(a,c) andalso walk lexical(b,d)
          | walk lexical (SCEAbs(ty,v,_,b),SCEAbs(other,w,_,c))=
              equal_type ty other andalso
              equal_type (Term.type_of v) (Term.type_of w) andalso
              walk ((v,w)::lexical)(b,c)
          | walk _ _=(charge 1;false)
    in walk [] (left,right) end
  fun sce_binary name (SCEApp(_,SCEApp(_,SCEAtom h,a),b))=
        if Term.is_const h then
          let val c=Term.dest_thy_const h
          in if #Thy c="min" andalso #Name c=name then SOME(a,b) else NONE end
        else NONE
    | sce_binary _ _=NONE
  fun sce_truth(SCEAtom term)=Term.is_const term andalso
        Term.same_const term boolSyntax.T
    | sce_truth _=false

  fun prepare_source_conditions expected {rule,premises,check_type}=
    sr_fail expected (fn()=>W.with_step expected (fn()=>
    let
      val _=if null premises then raise ERR "prepare_source_conditions"
        "no conditional premises" else ()
      val parents=rule::premises
      val data=List.map (sce_data expected) parents
      val frame= #frame(hd data)
      val scope_data=Scope.description_for expected frame
      val graph= #graph scope_data
      val _=List.app (fn d=>if Portable.pointer_eq(#frame d,frame) then ()
        else raise ERR "prepare_source_conditions" "different actual frame")
        data
      val limits=W.semantic_limits expected
      val output= #output_limit limits
      val template= #template_limit limits
      val quota=IntInf.fromInt(W.work_limit expected)
      val budget=ref(0:IntInf.int)
      val policies=ref([]:Type.hol_type list)
      val identifiers=ref([]:string list)
      val nodes=ref([]:G.node list)
      fun guarded operation=
        (List.app(sce_guard expected) parents;
         let val value=operation()
         in List.app(sce_guard expected) parents;value end)
      fun tick n=W.spend expected n
      fun append [] tail=tail
        | append(value::rest) tail=(tick 1;value::append rest tail)
      fun flatten []=[]
        | flatten(values::rest)=(tick 1;append values (flatten rest))
      fun remember term=if Term.is_var term then
        let val(name,_)=Term.dest_var term
        in tick(String.size name+1);identifiers:=name:: !identifiers end
        else ()
      fun capture cap names origin term=
        let
          val _=case SmtReplayImport.bounded_raw_size cap term of
              SOME n=>tick n | NONE=>raise ERR "prepare_source_conditions"
                "bounded transformed proof operand"
          val _=case SmtReplayImport.bounded_binder_size cap term of
              SOME n=>tick n | NONE=>raise ERR "prepare_source_conditions"
                "bounded transformed binder operand"
          fun walk lexical origin current=
            (tick 1;remember current;
             if Term.is_var current andalso not(List.exists
                 (fn bound=>(tick 1;sr_same bound current))
                 lexical) then
               (case List.find(fn(_,name)=>(tick 1;sr_same name current))
                   names of
                 SOME(node,_)=>
                   (if List.exists(fn held=>(tick 1;held=node))
                       (!nodes) then () else
                      nodes:=node:: !nodes;SCEProtected node)
               | NONE=>SCEAtom current)
             else if Term.is_comb current then
               let val(a,b)=Term.dest_comb current
                   val(left,right)=case origin of NONE=>(NONE,NONE)
                     | SOME(SCOApp(x,y))=>(SOME x,SOME y)
                     | _=>raise ERR "prepare_source_conditions"
                         "authentic application origin geometry changed"
               in SCEApp(Term.type_of current,
                   walk lexical left a,walk lexical right b) end
             else if Term.is_abs current then
               let val(v,b)=Term.dest_abs current
                   val(original,body)=case origin of NONE=>(v,NONE)
                     | SOME(SCOLam(old,next))=>(old,SOME next)
                     | _=>raise ERR "prepare_source_conditions"
                         "authentic binder origin geometry changed"
               in remember v;SCEAbs(Term.type_of current,v,original,
                   walk(v::lexical)body b) end
             else SCEAtom current)
        in guarded(fn()=>walk [] origin term) end
      val programs=ListPair.map(fn(d,parent)=>
        (capture output (#names d)
           (SOME(sce_lexical_origin_inside expected parent))(#target d),
         List.map(capture template (#names d)NONE)(Thm.hyp(#proof d))))
        (data,parents)
      val rows=List.concat(List.map(fn d=>List.map(fn(value,witness)=>
        (capture template (#names d)NONE value,witness)) (#rows d)) data)
      fun name node=
        let val ty=G.type_of graph node
            fun choose n=
              let val candidate="__smt_source_conditions_"^Int.toString n
                  val _=tick(String.size candidate+1)
              in if List.exists(fn held=>(tick 1;held=candidate))
                   (!identifiers) then
                   choose(n+1) else
                 (identifiers:=candidate:: !identifiers;candidate) end
        in (node,choose 0,ty) end
      val _=List.app(fn d=>List.app(fn(node,_)=>
        if List.exists(fn held=>(tick 1;held=node)) (!nodes) then () else
          nodes:=node:: !nodes)(#names d)) data
      val names=List.map name (!nodes)
      fun profile tree=
        let fun type_profile ty=
              let fun collect [] accumulated=List.rev accumulated
                    | collect(current::pending) accumulated=
                        (tick 3;
                         if Type.is_vartype current then
                           (tick(String.size(Type.dest_vartype current));
                            collect pending (current::accumulated))
                         else let val {Thy,Tyop,Args}=
                                Type.dest_thy_type current
                              val _=tick(String.size Thy+String.size Tyop)
                           in collect (append Args pending)
                                (current::accumulated) end)
              in collect [ty] [] end
            fun walk(SCEAtom term)=(tick 1;
                  (1:IntInf.int,1:IntInf.int,
                  type_profile(Term.type_of term)))
              | walk(SCEProtected node)=
                  (tick 1;(1,1,type_profile(G.type_of graph node)))
              | walk(SCEApp(ty,a,b))=
                  let val _=tick 1 val(x,y,ts)=walk a val(z,w,us)=walk b
                  in (1+x+z,1+y+w,append (type_profile ty) (append ts us)) end
              | walk(SCEAbs(ty,v,_,b))=
                  let val _=tick 1 val(x,y,ts)=walk b
                  in (1+x,2+y,append (type_profile ty)
                    (append (type_profile(Term.type_of v)) ts)) end
        in walk tree end
      fun reserve cap hypotheses target=
        let val(raw,inc,types)=profile target
            val _=if raw<=IntInf.fromInt cap andalso
                inc<=IntInf.fromInt cap then () else
              raise ERR "prepare_source_conditions" "prospective proof bound"
            val all=List.map (fn h=>(tick 1;profile h)) hypotheses
            val cost=List.foldl(fn((r,i,ts),n)=>
              (tick 1;n+r+i+IntInf.fromInt(length ts)))
              (raw+inc+IntInf.fromInt(length types)) all
            val _=budget:= !budget+cost
            val _=if !budget<=quota then () else
              raise ERR "prepare_source_conditions" "prospective original Work"
        in policies:=append types
          (append (flatten(List.map #3 all)) (!policies)) end
      fun union values more=List.foldl(fn(value,held)=>
        if List.exists(fn old=>sce_equal tick old value) held then held
        else append held [value]) values more
      val _=List.app(fn(target,hypotheses)=>
        reserve output hypotheses target) programs
      fun apply(current,hypotheses) []=(current,hypotheses)
        | apply(current,hypotheses)((premise,premise_hyp)::rest)=
            (case (sce_binary "==>" current,sce_binary "=" premise) of
              (SOME(condition,next),SOME(left,right))=>
                if sce_equal tick condition left andalso sce_truth right then
                  let val _=reserve output premise_hyp premise
                      val _=reserve output premise_hyp condition
                      val alpha=case premise of
                        SCEApp(ty,SCEApp(arrow,h,_),_)=>
                          SCEApp(ty,SCEApp(arrow,h,condition),condition)
                        | _=>raise ERR "prepare_source_conditions"
                            "equality constructor geometry differs"
                      val _=reserve output [] alpha
                      val _=reserve output premise_hyp condition
                      val combined=union hypotheses premise_hyp
                      val _=reserve output combined next
                  in apply(next,combined)rest end
                else raise ERR "prepare_source_conditions"
                  "condition evidence does not prove the ordered antecedent"
            | _=>raise ERR "prepare_source_conditions"
                "expected conditional rule and completed truth equality")
      val(target,hypotheses)=apply(hd programs)(tl programs)
      val _=List.app(fn(value,_)=>reserve template [] value) rows
      val _=if List.all(fn hyp=>List.exists
          (fn(value,_)=>sce_equal tick hyp value)
          rows) hypotheses then () else
        raise ERR "prepare_source_conditions" "lost authentic Source row"
      fun combine constant a b=
        let val ty=Term.type_of constant
            val(_,args)=Type.dom_rng ty
        in SCEApp(Type.bool,SCEApp(args,SCEAtom constant,a),b) end
      fun conjunction a b=combine boolSyntax.conjunction a b
      fun implication a b=combine boolSyntax.implication a b
      fun size []=0
        | size(_::rest)=(tick 1;1+size rest)
      fun split 0 pending left=(List.rev left,pending)
        | split n (value::rest) left=(tick 2;split(n-1)rest(value::left))
        | split _ [] _=raise ERR "prepare_source_conditions" "forest split"
      fun forest []=SCEAtom boolSyntax.T
        | forest [term]=term
        | forest terms=
            let val n=size terms div 2
                val(left,right)=split n terms []
            in tick 1;conjunction(forest left)(forest right) end
      val context=forest(List.map #1 rows)
      val _=reserve template [] context
      val _=reserve template [] (implication context target)
      val _=List.app(fn(value,_)=>reserve template [context] value) rows
      val _=reserve template [context] target
      (* Protected Source residues may never enter under ANY binder. *)
      fun insertion depth tree=(tick 1;case tree of SCEProtected _=>
            if depth=0 then () else raise ERR "prepare_source_conditions"
              "protected Source insertion below binder"
        | SCEApp(_,a,b)=>(insertion depth a;insertion depth b)
        | SCEAbs(_,_,_,body)=>insertion(depth+1)body | _=>())
      val _=List.app(insertion 0)(target::List.map #1 rows)
      val _=List.app(fn(node,_,_)=>
        reserve output [] (SCEProtected node)) names
      val origin=sce_tree_origin tick target
      val _=pay expected (!budget)
      val _=List.app(sce_guard expected) parents
    in SCEPlan {work=expected,frame=frame,parents=parents,names=names,
      programs=programs,rows=rows,target=target,origin=origin,
      policies= !policies,
      check_type=check_type,quote= !budget,used=ref false} end))

  fun sce_plan_guard expected (SCEPlan {work,frame,parents,...})=
    sr_fail expected (fn()=>
      (if Portable.pointer_eq(expected,work) then () else
         raise ERR "source_conditions" "foreign expected Work";
       Scope.validate_lifetime_for expected frame;
       List.app(sce_guard expected) parents))
  fun execute_source_conditions expected
      (plan as SCEPlan {frame,parents,names,programs,rows,target,
                       policies,check_type,used,origin,...})=
    sr_fail expected (fn()=>
    (sce_plan_guard expected plan;
     if !used then raise ERR "execute_source_conditions" "plan consumed"
       else ();
     W.with_step expected (fn()=>
     let
       val _=sce_plan_guard expected plan val _=used:=true
       fun guarded operation=
         (sce_plan_guard expected plan;
          let val value=operation()
          in sce_plan_guard expected plan;value end)
       val _=List.app(fn ty=>guarded(fn()=>check_type ty)) policies
       val names=List.map(fn(node,name,ty)=>
         (node,guarded(fn()=>Term.mk_var(name,ty)))) names
       fun named node=case List.find(fn(old,_)=>old=node) names of
           SOME(_,variable)=>variable | NONE=>
             raise ERR "execute_source_conditions" "missing genuine name"
       fun emit(SCEAtom term)=term
         | emit(SCEProtected node)=named node
         | emit(SCEApp(_,a,b))=
             let val left=emit a val right=emit b
             in guarded(fn()=>Term.mk_comb(left,right)) end
         | emit(SCEAbs(_,v,_,b))=
             let val body=emit b
             in guarded(fn()=>Term.mk_abs(v,body)) end
       val data=List.map(sce_data expected) parents
       fun rename (d:sce_snapshot)=
         let val sigma=List.map(fn(node,old)=>
               {redex=old,residue=named node}) (#names d)
         in guarded(fn()=>SmtReplayRuleObservation.INST sigma (#proof d)) end
       val proofs=List.map rename data
       fun apply theorem []=theorem
         | apply theorem(premise::rest)=
             let val(condition,_)=boolSyntax.dest_imp(Thm.concl theorem)
                 val reversed=guarded(fn()=>
                   SmtReplayRuleObservation.SYM premise)
                 val proved=guarded(fn()=>SmtReplayRuleObservation.EQ_MP
                   reversed boolTheory.TRUTH)
                 val bridge=guarded(fn()=>SmtReplayRuleObservation.ALPHA
                   (Thm.concl proved) condition)
                 val aligned=guarded(fn()=>
                   SmtReplayRuleObservation.EQ_MP bridge proved)
                 val next=guarded(fn()=>
                   SmtReplayRuleObservation.MP theorem aligned)
             in apply next rest end
       val proof=apply(hd proofs)(tl proofs)
       val rows=List.map(fn(value,witness)=>(emit value,witness)) rows
       (* This proof-native result has no caller-supplied graph endpoint.
          The actual conclusion of the native MP chain is retained
          directly; no second target tree or unpriced comparison is needed. *)
       val expected_tag=List.foldl
         (fn(d,tag)=>Tag.merge tag (Thm.tag(#proof d)))
         (Thm.tag boolTheory.TRUTH) data
       val _=if clean proof andalso #1(Tag.dest_tag(Thm.tag proof))=
           #1(Tag.dest_tag expected_tag) andalso
           null(Tag.axioms_of expected_tag) then () else
         raise ERR "execute_source_conditions" "unexpected proof provenance"
     in SCEApplied {work=expected,frame=frame,parents=parents,proof=proof,
       target=Thm.concl proof,names=names,rows=rows,
       origin=origin,
       constructor_origins=NONE,
             effect_origins=NONE,
             realized=ref NONE} end)))

  fun realize_source_condition_evidence expected evidence=
    sr_fail expected (fn()=>
    (sce_guard expected evidence;
     case evidence of SCEProjected {value,...}=>
       let val theorem=realize_source_condition_evidence expected value
       in sce_guard expected evidence;theorem end
     | SCELeaf recipe=>realize_source_rule expected recipe
     | SCEApplied {frame,parents,proof,target,names,rows,realized,...}=>
       case !realized of SOME theorem=>theorem | NONE=>
         W.with_step expected (fn()=>
         let
           val _=sce_guard expected evidence
           val d=Scope.description_for expected frame
           val graph= #graph d val scope= #scope d
           fun guarded operation=
             (sce_guard expected evidence;
              let val value=operation()
              in sce_guard expected evidence;value end)
           fun named node=case List.find(fn(old,_)=>old=node) names of
               SOME(_,term)=>term | NONE=>raise ERR "source_conditions"
                 "missing actual common vocabulary"
           val terms=Vector.fromList(List.map #1 rows)
           val tree=make_tree 0 (Vector.length terms)
           val context=guarded(fn()=>tree_term terms tree)
           val assumption=guarded(fn()=>
             SmtReplayRuleObservation.ASSUME context)
           val projections=guarded(fn()=>project tree assumption)
           val lifted=List.foldl(fn(premise,theorem)=>guarded(fn()=>
             SmtReplayRuleObservation.D_PROVE_HYP premise theorem))
             proof projections
           val law=guarded(fn()=>
             SmtReplayRuleObservation.DISCH context lifted)
           val _=if null(Thm.hyp law) andalso clean law then () else
             raise ERR "source_conditions" "common named law not closed"
           val sigma=List.map(fn(node,variable)=>
             {redex=variable,residue=G.representative graph node}) names
           val actual=guarded(fn()=>SmtReplayRuleObservation.INST sigma law)
           val(actual_context,actual_target)=
             boolSyntax.dest_imp(Thm.concl actual)
           val projected=Vector.fromList(project tree
             (guarded(fn()=>SmtReplayRuleObservation.ASSUME actual_context)))
           fun witness position(SCEWitness(recipe as SourceRuleRecipe
               {base=SourceCompact {block=Block {leaves,...},cuts,
                                    extra_leaves,...},...},index))=
             (validate_source_rule_for expected recipe;
              case List.find(fn(slot,_,_)=>slot=index) cuts of
                SOME(_,_,parent)=>
                  source_realization_theorem_for expected parent
              | NONE=>case (if index<Vector.length leaves then
                    Vector.sub(leaves,index) else
                    List.nth(extra_leaves,index-Vector.length leaves)) of
                  Source node=>guarded(fn()=>SmtReplayRuleObservation.ASSUME
                    (G.representative graph node))
                | ClosedWitness fact=>
                    (validate_closed_fact graph scope
                       (#template_limit(W.semantic_limits expected)) fact;
                     closed_proof fact)
                | ConversionWitness conversion=>
                    (validate_conversion_for expected conversion;
                     conversion_proof conversion)
                | Definition _=>
                    let val(a,b)=boolSyntax.dest_eq
                          (Thm.concl(Vector.sub(projected,position)))
                    in guarded(fn()=>SmtReplayRuleObservation.ALPHA a b) end)
           val witnesses=Vector.fromList(Portable.mapi
             (fn index=>fn(_,held)=>witness index held) rows)
           val support=guarded(fn()=>tree_proof witnesses tree)
           val result=guarded(fn()=>SmtReplayRuleObservation.MP actual support)
           fun originals(SCEProjected {value,...})=originals value
             | originals(SCELeaf(SourceRuleRecipe
                 {plan=SourceRulePlan {source,...},...}))=
                 let val SourceRealization {theorem,...}=source
                 in Thm.hyp theorem end
             | originals(SCEApplied {parents,...})=
                 List.concat(List.map originals parents)
           val original_hyp=List.concat(List.map originals parents)
           val _=if Portable.pointer_eq(Thm.concl result,actual_target)
               andalso clean result andalso List.all(fn hyp=>
                 List.exists(fn original=>Portable.pointer_eq(hyp,original))
                   original_hyp)(Thm.hyp result) then () else
             raise ERR "source_conditions" "Original Source Hyp or tag changed"
           val _=sce_guard expected evidence
           val _=realized:=SOME result
         in result end)))

  (* Routes apply to genuine transformed compact evidence. Source Gamma
     names and row witnesses remain unchanged. Binders have lexical IDs. *)
  datatype source_condition_rule_step=EvidenceStep of source_rule_step
    | EvidenceAssertion | EvidenceAntecedentConj
    | EvidenceAntecedentDisj of bool | EvidenceImpFalse
    | EvidenceAntecedentExists of G.closure_child
    | EvidenceConditionForall of G.closure_child | EvidenceSymmetry
  datatype sce_clause_action=SCEClauseNative of sr_action | SCEClauseTruth
    | SCEClauseAnteConj | SCEClauseAnteDisj of bool | SCEClauseNotIntro
    | SCEClauseAnteExists of sr_tree
    | SCEClauseConditionForall of sr_tree | SCEClauseSymmetry
  type sce_clause_instruction=sce_clause_action*sr_tree*sr_tree list
  datatype source_condition_rule_plan=SCEClausePlan of
    {work:W.portfolio,evidence:source_condition_evidence,
     frame:Scope.receipt,graph:G.graph,caller:G.scope,scope:G.scope,
     children:G.closure_child list,initial:sr_tree,
     instructions:sce_clause_instruction list,terminal:source_rule_terminal,
     result:sr_tree,conditions:sr_tree list,types:sr_type list,
     origin:sce_origin_tree,
     binders:(int*string*Type.hol_type) list,
     check_type:Type.hol_type -> unit,permutative:bool,used:bool ref}
  fun sce_clause_guard expected (SCEClausePlan
      {work,evidence,frame,graph,caller,scope,children,...})=
    sr_fail expected (fn()=>
      (if Portable.pointer_eq(expected,work) then () else
         raise ERR "source_condition_rule" "foreign expected Work";
       sce_guard expected evidence;
       let val d=Scope.description_for expected frame
       in if Portable.pointer_eq(#graph d,graph) andalso #scope d=scope
           then () else raise ERR "source_condition_rule" "frame changed"
       end;
       G.validate_scope graph caller;
       List.app(fn child=>ignore(G.closure_child_node graph caller child))
         children))
  fun prepare_source_condition_rule expected
      {evidence,frame,caller,steps,terminal,check_type}=
    sr_fail expected (fn()=>W.with_step expected (fn()=>
    let
      val d=sce_data expected evidence
      val source=Scope.description_for expected (#frame d)
      val actual=Scope.description_for expected frame
      val graph= #graph actual val scope= #scope actual
      val _=if Portable.pointer_eq(graph,#graph source) andalso
          Portable.pointer_eq(#sources actual,#sources source) andalso
          #root actual= #root source andalso
          G.scope_visible graph scope (#scope source) then () else
        raise ERR "prepare_source_condition_rule" "foreign Source frame"
      val _=G.validate_scope graph caller
      val children=List.mapPartial
        (fn EvidenceStep(SourceSpec child)=>SOME child
        | EvidenceAntecedentExists child=>SOME child
        | EvidenceConditionForall child=>SOME child | _=>NONE) steps
      fun guard()=
        (sce_guard expected evidence;
         Scope.validate_lifetime_for expected frame;
         List.app(fn child=>ignore(G.closure_child_node graph caller child))
           children)
      fun tick n=(guard();W.spend expected n)
      val limits=W.semantic_limits expected
      val output=IntInf.fromInt(#output_limit limits)
      val template=IntInf.fromInt(#template_limit limits)
      val quota=IntInf.fromInt(W.work_limit expected)
      val budget=ref(0:IntInf.int)
      val policies=ref([]:sr_type list)
      val next=ref 0 val identifiers=ref([]:string list)
      val binders=ref([]:(int*string*Type.hol_type) list)
      fun append [] tail=tail
        | append(v::rest) tail=(tick 1;v::append rest tail)
      fun types (captured as SRCaptured ty)=
            (tick 1;captured::(if Type.is_vartype ty then
              (tick(String.size(Type.dest_vartype ty));[])
            else let val {Thy,Tyop,Args}=Type.dest_thy_type ty
                 in tick(String.size Thy+String.size Tyop);
                   List.foldr(fn(arg,all)=>append(types(SRCaptured arg)) all)
                     [] Args end))
        | types (arrow as SRArrow(a,b))=
            (tick 1;arrow::append(types a)(types b))
      fun atom shape ty=SRTree {ty=ty,shape=shape,raw=1,inc=1,
        annotations=types ty}
      fun app ty a b=SRTree {ty=ty,shape=SRApp(a,b),
        raw=1+sr_raw a+sr_raw b,inc=1+sr_inc a+sr_inc b,
        annotations=append(types ty)(append(sr_types a)(sr_types b))}
      fun lam ty id v b=SRTree {ty=ty,shape=SRLam(id,v,b),
        raw=1+sr_raw b,inc=2+sr_inc b,
        annotations=append(types ty)(append(sr_types v)(sr_types b))}
      fun remember term=if Term.is_var term then
        let val(name,_)=Term.dest_var term
        in tick(String.size name+1);identifiers:=name:: !identifiers end
        else ()
      fun find v []=NONE
        | find v ((old,id)::rest)=
            (tick 1;if sr_same v old then SOME id else find v rest)
      fun capture lexical origin term=
        (tick 1;remember term;
         let val ty=SRCaptured(Term.type_of term)
         in if Term.is_comb term then
              let val(a,b)=Term.dest_comb term
                  val(left,right)=case origin of NONE=>(NONE,NONE)
                    | SOME(SCOApp(x,y))=>(SOME x,SOME y)
                    | _=>raise ERR "prepare_source_condition_rule"
                        "authentic application origin geometry changed"
              in app ty (capture lexical left a)(capture lexical right b)end
            else if Term.is_abs term then
              let val(v,b)=Term.dest_abs term
                  val id= !next val _=next:=id+1 val _=remember v
                  val vt=SRCaptured(Term.type_of v)
                  val(original,body)=case origin of NONE=>(v,NONE)
                    | SOME(SCOLam(old,next))=>(old,SOME next)
                    | _=>raise ERR "prepare_source_condition_rule"
                        "authentic binder origin geometry changed"
              in lam ty id (atom(SRBound(id,original))vt)
                (capture((v,id)::lexical)body b)end
            else case find term lexical of
              SOME id=>atom(SRBound(id,term))ty
            | NONE=>atom(SRAtom term)ty end)
      fun bounded cap origin term=
        (case SmtReplayImport.bounded_raw_size cap term of
           SOME n=>tick n | NONE=>raise ERR "prepare_source_condition_rule"
             "bounded local raw operand";
         case SmtReplayImport.bounded_binder_size cap term of
           SOME n=>tick n | NONE=>raise ERR "prepare_source_condition_rule"
             "bounded local binder operand";
         capture [] origin term)
      val initial=bounded(#output_limit limits)
        (SOME(sce_lexical_origin_inside expected evidence))(#target d)
      val hyp=List.map(bounded(#template_limit limits)NONE)(Thm.hyp(#proof d))
      val rows=List.map(fn(value,_)=>
        bounded(#template_limit limits)NONE value)(#rows d)
      val args=List.map(fn child=>
        let val node=G.closure_child_node graph caller child
            val _=if G.scope_visible graph scope (G.node_scope graph node)
              then () else raise ERR "prepare_source_condition_rule"
                "argument escapes actual frame"
        in bounded(#output_limit limits)NONE(G.representative graph node) end)
        children
      fun fresh id ty=
        let fun choose n=
              let val name="__smt_sce_binder_"^Int.toString id^"_"^
                    Int.toString n
                  val _=tick(String.size name+1)
              in if List.exists(fn old=>(tick 1;old=name))(!identifiers)
                   then choose(n+1) else
                 (identifiers:=name:: !identifiers;name) end
        in binders:=(id,choose 0,ty):: !binders end
      fun name_binders(SRTree {shape,...})=case shape of
          SRApp(a,b)=>(name_binders a;name_binders b)
        | SRLam(id,v,b)=>(fresh id (case sr_type v of SRCaptured t=>t
              | _=>raise ERR "prepare_source_condition_rule" "binder type");
            name_binders b)
        | _=>()
      val _=List.app name_binders(initial::args)
      fun head thy name(SRTree {shape=SRAtom term,...})=
            Term.is_const term andalso
              let val c=Term.dest_thy_const term
              in #Thy c=thy andalso #Name c=name end
        | head _ _ _=false
      fun binary thy name(SRTree {shape=SRApp
          (SRTree {shape=SRApp(h,a),...},b),...})=
            if head thy name h then SOME(a,b) else NONE
        | binary _ _ _=NONE
      fun forall(SRTree {shape=SRApp(h,SRTree {shape=SRLam(id,v,b),...}),
                            ...})=
            if head "bool" "!" h then SOME(id,v,b) else NONE
        | forall _=NONE
      fun exists(SRTree {shape=SRApp(h,SRTree {shape=SRLam(id,v,b),...}),
                            ...})=
            if head "bool" "?" h then SOME(id,v,b) else NONE
        | exists _=NONE
      fun subst id arg (value as SRTree {ty,shape,...})=
        (tick 1;case shape of SRBound(old,_)=>if old=id then arg else value
        | SRApp(a,b)=>app ty (subst id arg a)(subst id arg b)
        | SRLam(old,v,b)=>if old=id then value else
            lam ty old v (subst id arg b)
        | _=>value)
      fun tcombine constant a b=
        let val bool=SRCaptured Type.bool
            val ty=SRCaptured(Term.type_of constant)
            val arrow=SRCaptured(#2(Type.dom_rng(Term.type_of constant)))
        in app bool (app arrow (atom(SRAtom constant)ty)a)b end
      fun timp a b=tcombine boolSyntax.implication a b
      fun tneg a=
        app (SRCaptured Type.bool)
          (atom(SRAtom boolSyntax.negation)
            (SRCaptured(Term.type_of boolSyntax.negation)))a
      fun typed_equality a b=
        let val domain=sr_type a val bool=SRCaptured Type.bool
            val arrow=SRArrow(domain,bool)
            val h=atom(SRAtom boolSyntax.equality)(SRArrow(domain,arrow))
        in app bool (app arrow h a)b end
      fun abstract id variable (value as SRTree {ty,shape,...})=
        (tick 1;case shape of SRAtom term=>
            if sr_same term variable then atom(SRBound(id,term))ty
            else value
          | SRApp(a,b)=>app ty (abstract id variable a)
              (abstract id variable b)
          | SRLam(old,v,b)=>lam ty old v (abstract id variable b)
          | _=>value)
      fun quantify issue argument condition=
        let val variable=case #shape(sr_data argument)of
              SRAtom term=>if Term.is_var term then term else
                raise ERR "source_rule_quantify" "actual variable required"
            | _=>raise ERR "source_rule_quantify" "actual variable required"
            val domain=sr_type argument
            val id= !next val _=next:=id+1
            val _=if issue then fresh id (Term.type_of variable) else ()
            val bool=SRCaptured Type.bool
            val predicate=lam (SRArrow(domain,bool))id
              (atom(SRBound(id,variable))domain)
              (abstract id variable condition)
            val constant=atom(SRAtom boolSyntax.universal)
              (SRArrow(SRArrow(domain,bool),bool))
        in app bool constant predicate end
      (* Strip SPEC routes WITHOUT substituting the owned arguments.
         Permutation is a property of this template, before matching. *)
      fun original_template [] [] current=current
        | original_template(step::rest)pending current=
            let val(next,pending)=case step of EvidenceStep(SourceSpec _)=>
                  (case forall current of
                    SOME(_,_,body)=>(body,tl pending) | _=>
                    raise ERR "source_rule_template" "forall route")
                | EvidenceStep(SourceConjunct left)=>
                    ((case binary "bool" "/\\" current of SOME(a,b)=>
                      if left then a else b | _=>
                        raise ERR "source_rule_template" "conjunct route"),
                      pending)

                | EvidenceStep SourceCondition=>
                    ((case binary "min" "==>" current of SOME(_,body)=>body
                      | _=>raise ERR "source_rule_template" "condition route"),
                      pending)

                | EvidenceAssertion=>
                    ((case binary "min" "=" current of SOME(a,b)=>
                      if head "bool" "T" b then a else
                        raise ERR "source_rule_template" "truth operand"
                     | _=>raise ERR "source_rule_template" "truth equality"),
                      pending)

                | EvidenceAntecedentConj=>
                    ((case binary "min" "==>" current of SOME(ant,body)=>
                      (case binary "bool" "/\\" ant of SOME(a,b)=>
                         timp a (timp b body) | _=>
                           raise ERR "source_rule_template" "conjunct ant")
                     | _=>raise ERR "source_rule_template" "implication"),
                      pending)

                | EvidenceAntecedentDisj left=>
                    ((case binary "min" "==>" current of SOME(ant,body)=>
                      (case binary "bool" "\\/" ant of SOME(a,b)=>
                         timp (if left then a else b)body | _=>
                           raise ERR "source_rule_template" "disjunct ant")
                     | _=>raise ERR "source_rule_template" "implication"),
                      pending)

                | EvidenceImpFalse=>
                    ((case binary "min" "==>" current of SOME(a,b)=>
                       if head "bool" "F" b then tneg a else
                         raise ERR "source_rule_template" "false consequence"
                     | _=>raise ERR "source_rule_template" "implication"),
                      pending)
                | EvidenceSymmetry=>
                    ((case binary "min" "=" current of SOME(a,b)=>
                        typed_equality b a
                      | _=>raise ERR "source_rule_template" "equality"),
                      pending)
                | EvidenceConditionForall _=>
                    let val(ant,result)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "source_rule_template" "implication"
                        val argument=case pending of v::_=>v | _=>
                          raise ERR "source_rule_template" "variable"
                    in(timp(quantify false argument ant)result,tl pending)end
                | EvidenceAntecedentExists _=>
                    let val(ant,result)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "source_rule_template" "implication"
                        val(id,_,body)=case exists ant of SOME triple=>triple
                          | _=>raise ERR "source_rule_template" "exists"
                        val argument=case pending of v::_=>v | _=>
                          raise ERR "source_rule_template" "witness"
                    in(timp(subst id argument body)result,tl pending)end
            in tick 1;original_template rest pending next end
        | original_template _ _ _=
            raise ERR "source_rule_template" "argument route mismatch"
      datatype template_variable=TemplateBound of int
        | TemplateFree of Term.term
      fun key_equal(TemplateBound a,TemplateBound b)=a=b
        | key_equal(TemplateFree a,TemplateFree b)=sr_same a b
        | key_equal _=false
      fun variable(SRTree {shape=SRBound(id,_),...})=SOME(TemplateBound id)
        | variable(SRTree {shape=SRAtom term,...})=
            if Term.is_var term then SOME(TemplateFree term) else NONE
        | variable _=NONE
      fun same_ty(SRCaptured a,SRCaptured b)=Type.compare(a,b)=EQUAL
        | same_ty(SRArrow(a,b),SRArrow(c,d))=same_ty(a,c)andalso same_ty(b,d)
        | same_ty _=false
      fun vperm a b=(tick 1;
        case(variable a,variable b)of(SOME _,SOME _)=>
            same_ty(sr_type a,sr_type b)
        | _=>case(#shape(sr_data a),#shape(sr_data b))of
            (SRApp(f,x),SRApp(g,y))=>vperm f g andalso vperm x y
          | (SRLam(_,_,x),SRLam(_,_,y))=>vperm x y
          | (SRAtom x,SRAtom y)=>Term.aconv x y
          | _=>false)
      fun fv tree=
        let fun member key all=List.exists
              (fn old=>(tick 1;key_equal(key,old)))all
            fun walk bound current all=(tick 1;
              case variable current of SOME(TemplateBound id)=>
                  if List.exists(fn old=>old=id)bound then all else
                    let val key=TemplateBound id
                    in if member key all then all else key::all end
              | SOME key=>if member key all then all else key::all
              | NONE=>case #shape(sr_data current)of
                  SRApp(a,b)=>walk bound b (walk bound a all)
                | SRLam(id,_,b)=>walk(id::bound)b all | _=>all)
        in walk [] tree [] end
      fun same_fv a b=
        List.all(fn x=>List.exists(fn y=>(tick 1;key_equal(x,y)))b)a
        andalso List.all(fn y=>List.exists
          (fn x=>(tick 1;key_equal(x,y)))a)b
      val original=original_template steps args initial
      val permutative=case terminal of SourceEquality=>
            (case binary "min" "=" original of SOME(a,b)=>
                vperm a b andalso same_fv(fv a)(fv b)
              | _=>raise ERR "source_rule_template" "original equality")
        | _=>false
      fun record cap hypotheses result=
        let val _=if sr_raw result<=cap andalso sr_inc result<=cap then ()
              else raise ERR "prepare_source_condition_rule"
                "prospective local result bound"
            val all=result::hypotheses
            val cost=List.foldl(fn(tree,n)=>(tick 1;
              n+sr_raw tree+sr_inc tree+
                IntInf.fromInt(length(sr_types tree)))) 0 all
            val _=budget:= !budget+cost
            val _=if !budget<=quota then () else
              raise ERR "prepare_source_condition_rule" "original Work"
        in policies:=List.foldr(fn(tree,all)=>append(sr_types tree)all)
          (!policies)all end
      val bool=SRCaptured Type.bool
      fun boolean term=atom(SRAtom term)bool
      fun combine constant a b=
        let val arrow=SRArrow(bool,bool)
            val h=atom(SRAtom constant)(SRArrow(bool,arrow))
        in app bool (app arrow h a)b end
      fun equality a b=combine boolSyntax.equality a b
      fun implication a b=combine boolSyntax.implication a b
      fun align conditions result=
        (record output conditions (equality result result);
         record output conditions result)
      val _=align hyp initial
      fun play [] [] current conditions instructions=
            (current,conditions,List.rev instructions)
        | play(step::rest) pending current conditions instructions=
            let val _=tick 1
                val(action,result,pending,conditions)=case step of
                  EvidenceStep(SourceSpec _)=>
                    let val(id,v,b)=case forall current of SOME d=>d
                          | NONE=>raise ERR "prepare_source_condition_rule"
                              "actual explicit forall required"
                        val arg=case pending of a::_=>a | _=>
                          raise ERR "prepare_source_condition_rule" "argument"
                        val _=case(sr_type v,sr_type arg)of
                          (SRCaptured a,SRCaptured b)=>
                            if Type.compare(a,b)=EQUAL then () else
                              raise ERR "prepare_source_condition_rule"
                                "SPEC argument type"
                        | _=>raise ERR "prepare_source_condition_rule" "type"
                        val _=record output [] arg
                    in(SCEClauseNative(SRSpec arg),subst id arg b,tl pending,
                      conditions)end
                | EvidenceStep(SourceConjunct left)=>
                    let val(a,b)=case binary "bool" "/\\" current of
                          SOME d=>d | NONE=>
                            raise ERR "prepare_source_condition_rule"
                              "actual conjunction required"
                    in(SCEClauseNative(SRConjunct left),
                      if left then a else b,pending,
                      conditions)end
                | EvidenceStep SourceCondition=>
                    let val(a,b)=case binary "min" "==>" current of
                          SOME d=>d | NONE=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val _=record output [a] a
                    in(SCEClauseNative SRCondition,b,pending,a::conditions)end
                | EvidenceAssertion=>
                    let val(a,b)=case binary "min" "=" current of
                          SOME d=>d | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual truth equality required"
                        val _=if head "bool" "T" b then () else
                          raise ERR "prepare_source_condition_rule"
                            "actual truth operand required"
                        val _=record output (append conditions hyp) current
                        val _=record output [] (boolean boolSyntax.T)
                    in(SCEClauseTruth,a,pending,conditions)end
                | EvidenceAntecedentConj=>
                    let val(ant,body)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val(a,b)=case binary "bool" "/\\" ant of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual conjunction antecedent required"
                        val held=append conditions hyp
                        val _=record output [a] a
                        val _=record output [b] b
                        val _=record output [a,b] ant
                        val _=record output (a::b::held)body
                        val right=implication b body
                        val _=record output (a::held)right
                        val result=implication a right
                    in(SCEClauseAnteConj,result,pending,conditions)end
                | EvidenceAntecedentDisj left=>
                    let val(ant,body)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val(a,b)=case binary "bool" "\\/" ant of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual disjunction antecedent required"
                        val selected=if left then a else b
                        val held=append conditions hyp
                        val _=record output [selected]selected
                        val _=record output [selected]ant
                        val _=record output (selected::held)body
                        val result=implication selected body
                    in(SCEClauseAnteDisj left,result,pending,conditions)end
                | EvidenceSymmetry=>
                    let val(a,b)=case binary "min" "=" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual equality required"
                    in(SCEClauseSymmetry,typed_equality b a,pending,
                      conditions)end
                | EvidenceConditionForall _=>
                    let val(ant,result)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val argument=case pending of a::_=>a | _=>
                          raise ERR "prepare_source_condition_rule" "variable"
                        val quantified=quantify true argument ant
                        val held=append conditions hyp
                        val _=record output [] argument
                        val _=record output [quantified]quantified
                        val _=record output [quantified]ant
                        val _=record output (quantified::held)result
                    in(SCEClauseConditionForall argument,
                      implication quantified result,tl pending,conditions)end
                | EvidenceAntecedentExists _=>
                    let val(ant,result)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val(id,v,body)=case exists ant of SOME triple=>triple
                          | _=>raise ERR "prepare_source_condition_rule"
                            "actual existential antecedent required"
                        val argument=case pending of a::_=>a | _=>
                          raise ERR "prepare_source_condition_rule" "witness"
                        val _=case #shape(sr_data argument)of SRAtom term=>
                            if Term.is_var term then () else
                              raise ERR "prepare_source_condition_rule"
                                "witness must be an actual variable"
                          | _=>raise ERR "prepare_source_condition_rule"
                              "witness must be an actual variable"
                        val _=if same_ty(sr_type v,sr_type argument)then ()
                          else raise ERR "prepare_source_condition_rule"
                            "existential witness type differs"
                        val instance=subst id argument body
                        val held=append conditions hyp
                        val _=record output [] argument
                        val _=record output [instance]instance
                        val _=record output [instance]ant
                        val _=record output (instance::held)result
                    in(SCEClauseAnteExists argument,
                      implication instance result,tl pending,conditions)end
                | EvidenceImpFalse=>
                    let val(ant,last)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val _=if head "bool" "F" last then () else
                          raise ERR "prepare_source_condition_rule"
                            "actual false consequent required"
                    in(SCEClauseNotIntro,tneg ant,pending,conditions)end
                val hypotheses=append conditions hyp
                val _=record output hypotheses result
                val _=align hypotheses result
            in play rest pending result conditions
              ((action,result,conditions)::instructions)end
        | play _ _ _ _ _=raise ERR "prepare_source_condition_rule" "route"
      val(body,conditions,instructions)=play steps args initial [] []
      val hypotheses=append conditions hyp
      val result=case terminal of SourceEquality=>
            (case binary "min" "=" body of SOME _=>body | _=>
              raise ERR "prepare_source_condition_rule" "equality required")
        | SourceTruth=>let val result=equality body(boolean boolSyntax.T)
              val _=record output hypotheses(equality result body)
            in result end
        | SourceFalse=>
            let val operand=case sr_data body of
                  {shape=SRApp(h,p),...}=>if head "bool" "~" h then p else
                    raise ERR "prepare_source_condition_rule" "negation"
                | _=>raise ERR "prepare_source_condition_rule" "negation"
                val result=equality operand(boolean boolSyntax.F)
                val _=record output hypotheses(equality body result)
            in result end
      val _=record output hypotheses result
      val final=List.foldl(fn(condition,current)=>
        let val next=implication condition current
        in record output hyp next;next end)result conditions
      val _=record template hyp final
      val _=align hyp final
      (* Same balanced shape as the retained realization helper. *)
      fun balanced values=
        let fun size []=0 | size(_::rest)=(tick 1;1+size rest)
            fun split 0 pending left=(List.rev left,pending)
              | split n(v::rest)left=(tick 2;split(n-1)rest(v::left))
              | split _ _ _=raise ERR "prepare_source_condition_rule" "split"
            fun walk []=boolean boolSyntax.T | walk [v]=v
              | walk values=
                  let val(a,b)=split(size values div 2)values []
                  in combine boolSyntax.conjunction(walk a)(walk b)end
        in walk values end
      val context=balanced rows
      val _=record template [] context
      val _=record template [] (implication context final)
      val _=List.app(fn row=>record template [context]row)rows
      val _=record template [context]final
      val origin=sr_lexical_origin tick final
      val _=pay expected (!budget)
      val _=guard()
    in SCEClausePlan {work=expected,evidence=evidence,frame=frame,graph=graph,
      caller=caller,scope=scope,children=children,initial=initial,
      instructions=instructions,terminal=terminal,result=final,
      conditions=conditions,types= !policies,binders= !binders,
      origin=origin,
      check_type=check_type,permutative=permutative,used=ref false} end))

  fun execute_source_condition_rule expected
      (plan as SCEClausePlan {evidence,frame,graph,caller,children,initial,
        instructions,terminal,result,conditions,types,binders,check_type,
        used,permutative,origin,...})=
    sr_fail expected (fn()=>
      (sce_clause_guard expected plan;
       if !used then raise ERR "execute_source_condition_rule" "consumed"
         else ();
       W.with_step expected (fn()=>
       let
         val _=sce_clause_guard expected plan val _=used:=true
         fun guarded operation=
           (sce_clause_guard expected plan;
            let val value=operation()
            in sce_clause_guard expected plan;value end)
         fun materialize(SRCaptured ty)=guarded(fn()=>ty)
           | materialize(SRArrow(a,b))=
               let val left=materialize a val right=materialize b
               in guarded(fn()=>Type.mk_thy_type
                 {Thy="min",Tyop="fun",Args=[left,right]})end
         val policy_types=List.map materialize types
         val _=List.app(fn ty=>guarded(fn()=>check_type ty))policy_types
         val variables=List.map(fn(id,name,ty)=>
           (id,guarded(fn()=>Term.mk_var(name,ty))))binders
         fun bound id=case List.find(fn(old,_)=>old=id)variables of
             SOME(_,term)=>term | _=>raise ERR "execute_source_condition_rule"
               "missing lexical binder"
         fun emit(SRTree {shape,...})=case shape of SRAtom term=>term
           | SRBound(id,_)=>bound id
           | SRFresh _=>raise ERR "execute_source_condition_rule"
               "unexpected external vocabulary"
           | SRLam(id,_,body)=>
               let val term=emit body
               in guarded(fn()=>Term.mk_abs(bound id,term))end
           | SRApp(SRTree {shape=SRAtom h,...},
               (argument as SRTree {shape=SRLam(id,_,body),...}))=>
               if Term.is_const h andalso
                   Term.same_const h boolSyntax.universal then
                 let val term=emit body
                 in guarded(fn()=>boolSyntax.mk_forall(bound id,term))end
               else let val term=emit argument
                    in guarded(fn()=>Term.mk_comb(h,term))end
           | SRApp(SRTree {shape=SRApp
               (SRTree {shape=SRAtom h,...},a),...},b)=>
               if Term.is_const h andalso
                   Term.same_const h boolSyntax.equality then
                 let val left=emit a val right=emit b
                 in guarded(fn()=>boolSyntax.mk_eq(left,right))end
               else let val argument=emit a
                        val operator=guarded(fn()=>Term.mk_comb(h,argument))
                        val operand=emit b
                    in guarded(fn()=>Term.mk_comb(operator,operand))end
           | SRApp(a,b)=>let val left=emit a val right=emit b
               in guarded(fn()=>Term.mk_comb(left,right))end
         fun align term theorem=
           if Portable.pointer_eq(Thm.concl theorem,term) then theorem
           else let val bridge=guarded(fn()=>
                      SmtReplayRuleObservation.ALPHA(Thm.concl theorem)term)
             in guarded(fn()=>SmtReplayRuleObservation.EQ_MP bridge theorem)
             end
         val d=sce_data expected evidence
         val initial=align(emit initial)(#proof d)
         fun play [] theorem=theorem
           | play((action,next,_)::rest)theorem=
               let val theorem=case action of SCEClauseNative(SRSpec arg)=>
                     let val term=emit arg
                     in guarded(fn()=>
                       SmtReplayRuleObservation.SPEC term theorem)end
                   | SCEClauseNative(SRConjunct left)=>
                     guarded(fn()=>if left then
                       SmtReplayRuleObservation.CONJUNCT1 theorem else
                       SmtReplayRuleObservation.CONJUNCT2 theorem)
                   | SCEClauseNative SRCondition=>
                       let val condition= #1
                             (boolSyntax.dest_imp(Thm.concl theorem))
                           val premise=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME condition)
                       in guarded(fn()=>
                         SmtReplayRuleObservation.MP theorem premise)end
                   | SCEClauseTruth=>guarded(fn()=>Drule.EQT_ELIM theorem)
                   | SCEClauseAnteConj=>
                       let val(ant,_)=boolSyntax.dest_imp_only
                             (Thm.concl theorem)
                           val(a,b)=boolSyntax.dest_conj ant
                           val pa=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME a)
                           val pb=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME b)
                           val both=guarded(fn()=>
                             SmtReplayRuleObservation.CONJ pa pb)
                           val body=guarded(fn()=>
                             SmtReplayRuleObservation.MP theorem both)
                           val right=guarded(fn()=>
                             SmtReplayRuleObservation.DISCH b body)
                       in guarded(fn()=>
                         SmtReplayRuleObservation.DISCH a right)end
                   | SCEClauseAnteDisj left=>
                       let val(ant,_)=boolSyntax.dest_imp_only
                             (Thm.concl theorem)
                           val(a,b)=boolSyntax.dest_disj ant
                           val selected=if left then a else b
                           val assumption=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME selected)
                           val either=guarded(fn()=>if left then
                             SmtReplayRuleObservation.DISJ1 assumption b
                             else SmtReplayRuleObservation.DISJ2 a assumption)
                           val body=guarded(fn()=>
                             SmtReplayRuleObservation.MP theorem either)
                       in guarded(fn()=>
                         SmtReplayRuleObservation.DISCH selected body)end
                   | SCEClauseSymmetry=>guarded(fn()=>
                       SmtReplayRuleObservation.SYM theorem)
                   | SCEClauseConditionForall argument=>
                       let val(ant,_)=boolSyntax.dest_imp_only
                             (Thm.concl theorem)
                           val variable=emit argument
                           val quantified=guarded(fn()=>
                             boolSyntax.mk_forall(variable,ant))
                           val assumption=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME quantified)
                           val condition=guarded(fn()=>
                             SmtReplayRuleObservation.SPEC variable assumption)
                           val result=guarded(fn()=>
                             SmtReplayRuleObservation.MP theorem condition)
                       in guarded(fn()=>
                         SmtReplayRuleObservation.DISCH quantified result)end
                   | SCEClauseAnteExists argument=>
                       let val(ant,_)=boolSyntax.dest_imp_only
                             (Thm.concl theorem)
                           val(v,body)=boolSyntax.dest_exists ant
                           val witness=emit argument
                           val instance=guarded(fn()=>Term.subst
                             [{redex=v,residue=witness}]body)
                           val assumption=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME instance)
                           val existential=guarded(fn()=>
                             Thm.EXISTS(ant,witness)assumption)
                           val result=guarded(fn()=>
                             SmtReplayRuleObservation.MP theorem existential)
                       in guarded(fn()=>
                         SmtReplayRuleObservation.DISCH instance result)end
                   | SCEClauseNotIntro=>guarded(fn()=>
                       Thm.NOT_INTRO theorem)
               in play rest (align(emit next)theorem)end
         val body=play instructions initial
         val body=case terminal of SourceEquality=>body
           | SourceTruth=>guarded(fn()=>Drule.EQT_INTRO body)
           | SourceFalse=>guarded(fn()=>Drule.EQF_INTRO body)
         val proof=List.foldl(fn(condition,theorem)=>
           let val value=emit condition
           in guarded(fn()=>SmtReplayRuleObservation.DISCH value theorem)end)
           body conditions
         val proof=align(emit result)proof
         val _=if clean proof then () else
           raise ERR "execute_source_condition_rule" "proof provenance"
         val value=SCEApplied {work=expected,frame=frame,parents=[evidence],
           proof=proof,target=Thm.concl proof,names= #names d,rows= #rows d,
           origin=origin,
           constructor_origins=NONE,
             effect_origins=NONE,
             realized=ref NONE}
         val retained=SCEProjected {work=expected,graph=graph,caller=caller,
           children=children,value=value,permutative=SOME permutative}
         val _=sce_guard expected retained
       in retained end)))

  fun prepare_retained_source_cut_rule_block expected
      {frame,roots,additional_sources,closed_facts,conversions,receipts,
       targets,boolean,congruence} =
    ((List.app (source_realization_guard expected) receipts;
      let
        val data = Scope.description_for expected frame
        val graph = #graph data and scope = #scope data
        val cap = #template_limit (W.semantic_limits expected)
        val (frontier,rows,slot_origins) = W.with_step expected (fn () =>
          let
            val _ = source_realization_guards_with_work expected receipts
            fun pay n = W.spend expected n
            val _ = List.app (validate_conversion_for expected) conversions
            val _ = List.app
              (validate_conversion graph scope cap) conversions
            val _ = List.app
              (validate_closed_fact graph scope cap) closed_facts
            fun valid node =
              (pay 3;
               if G.scope_visible graph scope (G.node_scope graph node)
                 then () else raise ERR
                      "prepare_retained_source_cut_rule_block"
                   "Source operand outside actual frame";
               ignore (G.view graph node);
               if Type.compare (G.type_of graph node,Type.bool) = EQUAL
                 then node else raise ERR
                   "prepare_retained_source_cut_rule_block"
                   "Source operand is not Boolean")
            val prefix = List.map valid
              (SmtReplaySource.assumption_nodes (#sources data) @
               [SmtReplaySource.denied_goal_node (#sources data)])
            val extras = List.map valid additional_sources
            val _ = pay 1
            val extra_owner = ref ()
            val prefix_count = List.length prefix
            val base_count = prefix_count + List.length extras
            fun original_origins _ [] = []
              | original_origins index (node::rest) =
                  (pay 3;(OriginalPrefixSlot (#sources data,index),
                    node,index)::original_origins (index+1) rest)
            fun extra_origins _ [] = []
              | extra_origins index (node::rest) =
                  (pay 3;(ActualSourceSlot (extra_owner,index),node,index)::
                    extra_origins (index+1) rest)
            val initial = original_origins 0 prefix @
              extra_origins prefix_count extras
            val assigned = ref initial
            val appended = ref ([] : G.node list)
            val next = ref base_count
            fun equal (ActualSourceSlot (a,i),ActualSourceSlot (b,j)) =
                  Portable.pointer_eq (a,b) andalso i=j
              | equal (OriginalPrefixSlot (a,i),OriginalPrefixSlot (b,j)) =
                  Portable.pointer_eq (a,b) andalso i=j
              | equal _ = false
            fun reserve key node =
              let
                fun seek [] = (pay 1;NONE)
                  | seek ((old,actual,index)::rest) =
                      (pay 1;if equal (key,old) then
                         if actual=node then SOME index else
                           raise ERR "prepare_retained_source_cut_rule_block"
                             "shared occurrence changed actual Source node"
                       else seek rest)
              in case seek (!assigned) of SOME index => index
                | NONE =>
                  let val index = !next
                      val _ = pay 5
                      val _ = next := index+1
                      val _ = assigned := (key,node,index):: !assigned
                      val _ = appended := node :: !appended
                  in index end
              end
            fun retain [] = []
              | retain ((receipt as SourceRealization
                  {target,occurrences,origins,graph = held_graph,
                   original_sources,...})::rest) =
                let
                  val _ = source_realization_guard expected receipt
                  val _ = if Portable.pointer_eq (graph,held_graph) andalso
                      Portable.pointer_eq (#sources data,original_sources)
                    then () else raise ERR
                      "prepare_retained_source_cut_rule_block"
                      "different original Source portfolio"
                  val supports = ListPair.mapEq
                    (fn ((_,node),(_,key)) => reserve key (valid node))
                    (occurrences,origins)
                  val _ = valid target
                  val index = !next
                  val _ = pay 3
                  val _ = next := index+1
                  val _ = appended := target :: !appended
                in (receipt,index,supports)::retain rest end
            val rows = retain receipts
            val promoted = List.rev (!appended)
            val sources = prefix @ extras @ promoted
            val slot_origins = List.map (fn (key,_,index) =>
              (pay 2;(index,key))) (!assigned)
            (* Derive constructor authority from the SAME actual receipt.
               The application spine is concrete; argument holes are the
               exact recorded nodes, not arbitrary caller cut metadata. *)
            val spine_paths = ref ([] : G.closure_child list)
            fun node_spine target =
              let
                fun hold node =
                  (pay 3;spine_paths := G.closure_root graph scope node ::
                    !spine_paths)
                fun walk node =
                  let val _ = hold node
                  in case G.view graph node of G.Application (a,b) =>
                    let val _ = hold b
                        val (operators,arguments) = walk a
                    in (node::operators,b::arguments) end
                  | G.Constant _ => ([node],[])
                  | G.Variable _ => ([node],[])
                  | _ => ([],[node]) end
              in walk target end
            fun receipt_spine (receipt as SourceRealization {target,...}) =
              (source_realization_guard expected receipt;node_spine target)
            fun arguments node operands =
              (pay 2;ignore (G.closure_root graph scope node);
               case G.view graph node of G.Application (operator,operand) =>
                   arguments operator (operand::operands)
                 | G.Constant _ =>
                     SOME (G.representative graph node,operands)
                 | _ => NONE)
            (* This is exactly the concrete Boolean gate grammar used by
               the checked Boolean assembler, not semantic atom guessing. *)
            fun gate node = case arguments node [] of NONE => NONE
              | SOME (head,operands) =>
                let val arity = List.length operands
                    fun constant wanted = Term.same_const head wanted
                    val connective =
                      (arity=0 andalso (constant boolSyntax.T orelse
                        constant boolSyntax.F)) orelse
                      (arity=1 andalso constant boolSyntax.negation) orelse
                      (arity=2 andalso (constant boolSyntax.conjunction
                        orelse constant boolSyntax.disjunction orelse
                        constant boolSyntax.implication orelse
                        constant boolSyntax.equality)) orelse
                      (arity=3 andalso constant boolSyntax.conditional)
                    fun boolean node =
                      (pay 1;Type.compare
                        (G.type_of graph node,Type.bool)=EQUAL)
                in if connective andalso List.all boolean operands
                  then SOME operands else NONE end
            val gate_done = ref ([] : G.node list)
            fun seen node [] = (pay 1;false)
              | seen node (old::rest) =
                  (pay 1;node=old orelse seen node rest)
            fun gates node =
              let val _ = pay 2
                  val _ = ignore (G.closure_root graph scope node)
              in if seen node (!gate_done) then [] else
                (pay 2;gate_done := node :: !gate_done;
                 case gate node of NONE => [([],[node])]
                 | SOME operands => node_spine node ::
                     List.concat (List.map gates operands)) end
            val actual_targets = List.map valid targets
            val target_anchors = if boolean then [] else
              List.map (fn node => node_spine node) actual_targets
            val relation_roots = actual_targets @
              List.map (fn SourceRealization {target,...} => target) receipts
            fun equation node = case arguments node [] of
                SOME (head,[left,right]) =>
                  if Term.same_const head boolSyntax.equality then
                    SOME (left,right) else NONE
              | _ => NONE
            val known_pairs = List.mapPartial equation
              (List.map (fn SourceRealization {target,...} => target) receipts)
            val pairs_done = ref ([] : (G.node * G.node) list)
            fun same_pair (left,right) (a,b) =
              (left=a andalso right=b) orelse (left=b andalso right=a)
            fun proved pair = List.exists (fn old =>
              (pay 1;same_pair pair old)) known_pairs
            fun pair (left,right) =
              let val _ = pay 4
                  val _ = ignore (G.closure_root graph scope left)
                  val _ = ignore (G.closure_root graph scope right)
              in if left=right orelse proved (left,right) orelse
                  List.exists (fn old =>
                    (pay 1;same_pair (left,right) old)) (!pairs_done) then []
                else
                  (pay 2;pairs_done := (left,right) :: !pairs_done;
                   case (G.view graph left,G.view graph right) of
                     (G.Application (f,x),G.Application (g,y)) =>
                       ([left,right],[f,x,g,y]) :: (pair (f,g) @ pair (x,y))
                   | _ => []) end
            val congruence_spines = if congruence then List.concat
              (List.map (fn node => case equation node of
                 SOME operands => pair operands | NONE => []) actual_targets)
              else []
            val spines = List.map receipt_spine receipts @
              (if boolean then List.concat (List.map gates relation_roots)
               else []) @
              List.map node_spine (List.filter (fn node =>
                Option.isSome (equation node)) relation_roots) @
              target_anchors @ congruence_spines
            val constructor_roots = List.concat (List.map #1 spines)
            val cut_targets = List.concat (List.map #2 spines)
            (* The original prefix and inherited supports are authentic
               Source occurrences, not independent constructor demands.
               Their authority comes from this SAME Scope Source portfolio
               and the exact parent receipts validated above. Caller extras
               remain ordinary, as do facts, conversions and explicit roots.
               Constructor spines still dominate a retained Source atom. *)
            val facts = List.map (fn fact => (pay 1;closed_node fact))
              closed_facts
            val conversion_roots = List.concat (List.map (fn conversion =>
              (pay 3;[conversion_source conversion,
                conversion_target conversion])) conversions)
            val support_roots = List.concat (List.map
              (fn SourceRealization {occurrences,...} =>
                List.map (fn (_,node) => (pay 1;node)) occurrences) receipts)
            fun member node [] = false
              | member node (old::rest) =
                  (pay 1;node = old orelse member node rest)
            (* Descendant ordinary demand is also dominant. This walk is
               paid on SAME Work and starts ONLY from actual independent
               roots, never from the original occurrence inventory. *)
            val ordinary = ref ([] : G.node list)
            val ordinary_paths = ref ([] : G.closure_child list)
            fun demand [] = ()
              | demand (node::rest) =
                (pay 1;
                 ordinary_paths := G.closure_root graph scope node ::
                   !ordinary_paths;
                 if member node (!ordinary) then demand rest else
                   (pay 2;ordinary := node :: !ordinary;
                    case G.view graph node of G.Application (a,b) =>
                        (demand [a,b];demand rest)
                      | _ => demand rest))
            val _ = demand (extras @ facts @ conversion_roots @ roots)
            val demanded = !ordinary @ constructor_roots
            val retained_atoms = prefix @ support_roots @ cut_targets
            val seen = ref ([] : G.node list)
            val atoms = ref ([] : G.node list)
            fun visit [] = ()
              | visit (node::rest) =
                (pay 1;if member node (!seen) then visit rest else
                 let
                   val _ = pay 2
                   val _ = seen := node :: !seen
                   val _ = if G.scope_visible graph scope
                       (G.node_scope graph node) then () else
                     raise ERR "prepare_retained_source_cut_rule_block"
                       "node escaped frame"
                   val cut = member node retained_atoms andalso
                     not (member node demanded)
                   val children = if cut then
                       (pay 2;atoms := node :: !atoms;[]) else
                     case G.view graph node of
                       G.Application (a,b) => [a,b] | _ => []
                 in visit children;visit rest end)
            val _ = visit (sources @ cut_targets @ demanded)
            fun reverse [] answer = answer
              | reverse (node::rest) answer =
                  (pay 2;reverse rest (node::answer))
            val reachable = reverse (!seen) []
            val held = !ordinary_paths @ !spine_paths @ List.map (fn node =>
              (pay 2;G.closure_root graph scope node)) reachable
            val frontier = RealizationFrontier
              {work = expected,graph = graph,scope = scope,frame = frame,
               template_limit = cap,epoch = Type.type_epoch (),
               symbols = Term.term_epoch (),roots = roots,sources = sources,
               closed_facts = closed_facts,conversions = conversions,
               reachable = reachable,atoms = reverse (!atoms) [],
               held = held,retained_sources = NONE}
            val _ = source_realization_guards_with_work expected receipts
            val _ = frontier_guard expected frontier
          in (frontier,rows,slot_origins) end)
        val tables = W.with_step expected (fn () =>
          (source_realization_guards_with_work expected receipts;
           prepare_owned_realization_tables expected frontier))
        val block = W.with_step expected (fn () =>
          (source_realization_guards_with_work expected receipts;
           freeze_owned_needed_realization_tables_plan expected tables))
        val result = SourceCutBlock {work = expected,block = block,
          frame = frame,receipts = receipts,slot_origins = slot_origins,
          rows = rows}
        val _ = source_cut_block_guard expected result
      in result end)
     handle primary => (W.close expected;raise primary))


  (* Actual support slots derive from this exact opaque cut row. No caller
     index, needed array or theorem is accepted as occurrence authority. *)
  fun source_cut_support_edges_for expected
      (value as SourceCutBlock {block,rows,...}) receipt =
    ((source_realization_guard expected receipt;
      source_cut_block_guard expected value;
      W.with_step expected (fn () =>
      let val _ = source_cut_block_guard_with_work expected value
          val supports = case List.find (fn (held,_,_) =>
              (W.spend expected 1;
               Portable.pointer_eq (held,receipt))) rows of
              SOME (_,_,supports) => supports
            | NONE => raise ERR "source_cut_support_edges_for"
                "receipt was not reserved in this exact block"
          val actual = Vector.fromList (sources block)
          val edges = List.map (fn slot =>
            (W.spend expected 2;
             (Vector.sub (actual,slot),source block slot))) supports
          val _ = source_cut_block_guard_with_work expected value
      in edges end))
     handle primary => (W.close expected;raise primary))

  (* Genuine compact proofs are converted to a bounded actual body with
     only authentic Source assumptions. This is effective evidence, never
     an invented ordinary SourceCompact or caller theorem/node grant. *)
  datatype sg_tree = SGAtom of Term.term
    | SGForecastConstant of Type.hol_type
    | SGName of G.node * string * Type.hol_type
    | SGApp of Type.hol_type * sg_tree * sg_tree
    | SGAbs of Type.hol_type * Term.term * sg_tree
  datatype sg_witness = SGSourceWitness of G.node
    | SGDefinitionWitness
    | SGFactWitness of closed_fact
    | SGConversionWitness of closed_conversion
    | SGParentWitness of sg_program
  and sg_program = SGProgram of
    {source:source_realization,original:Thm.thm,target:G.node,
     original_rows:Term.term list,rows:sg_tree list,
     witnesses:sg_witness list,
     sigma:(Term.term * sg_tree) list,result:sg_tree,
     hypotheses:sg_tree list}
  datatype source_selective_generalization_plan = SGPlan of
    {work:W.portfolio,source:source_realization,frame:Scope.receipt,
     graph:G.graph,scope:G.scope,target:G.node,opened:G.source,
     variables:Term.term list,body:Term.term,program:sg_program,
     names:(G.node * sg_tree) list,policies:Type.hol_type list,
     quote:IntInf.int,check_type:Type.hol_type -> unit,used:bool ref}
  datatype source_selective_generalization = SGEffective of
    {plan:source_selective_generalization_plan,proof:Thm.thm,
     target:G.node,names:(G.node * Term.term) list,
     rows:(G.node * Term.term) list,discharged:G.node list,
     realized:Thm.thm option ref}

  fun sg_type (SGAtom term)=Term.type_of term
    | sg_type (SGForecastConstant ty)=ty
    | sg_type (SGName (_,_,ty))=ty
    | sg_type (SGApp (ty,_,_))=ty
    | sg_type (SGAbs (ty,_,_))=ty
  fun sg_size inclusive value = case value of
      SGAtom _=>1:IntInf.int | SGName _=>1 | SGForecastConstant _=>1
    | SGApp (_,a,b)=>1+sg_size inclusive a+sg_size inclusive b
    | SGAbs (_,_,body)=>(if inclusive then 2 else 1)+sg_size inclusive body
  fun sg_binary constant a b =
    let val equality=Term.same_const constant boolSyntax.equality
        (* All forecast equalities here compare Boolean proof endpoints.
           Quote their actual specialized Boolean operator annotation. *)
        val ty=Term.type_of(if equality then boolSyntax.conjunction
          else constant)
        val head=if equality then SGForecastConstant ty else SGAtom constant
        val middle= #2(Type.dom_rng ty)
    in SGApp(Type.bool,SGApp(middle,head,a),b) end
  fun sg_forest [] = SGAtom boolSyntax.T
    | sg_forest values =
      let val entries=Vector.fromList values
          fun build Empty=SGAtom boolSyntax.T
            | build(Leaf index)=Vector.sub(entries,index)
            | build(Split(a,b))=sg_binary boolSyntax.conjunction
                (build a)(build b)
      in build(make_tree 0(Vector.length entries)) end
  fun sg_guard expected (SGPlan
      {work,source,frame,graph,scope,target,opened,...}) =
    sr_fail expected (fn()=>
      (if Portable.pointer_eq(expected,work) then () else
         raise ERR "source_selective_generalization" "foreign expected Work";
       source_realization_guard expected source;
       ignore(Scope.description_for expected frame);
       G.validate_opened_view graph scope target opened))

  fun prepare_source_selective_generalization expected
      {source,target,check_type} = sr_fail expected (fn()=>
    W.with_step expected (fn()=>
    let
      val _=source_realization_guard expected source
      val SourceRealization {graph,scope,frame,theorem,template_limit,
        original_sources,...}=source
      val limits=W.semantic_limits expected
      val cap=template_limit
      val budget=ref(0:IntInf.int)
      val policies=ref([]:Type.hol_type list)
      val identifiers=ref([]:string list)
      fun tick n=W.spend expected n
      fun remember text=(tick(String.size text+1);
        if List.exists(fn old=>old=text)(!identifiers) then () else
          identifiers:=text:: !identifiers)
      fun bounded limit term=
        (case SmtReplayImport.bounded_raw_size limit term of
           SOME n=>tick n | NONE=>raise ERR
             "prepare_source_selective_generalization"
             "bounded operand raw cap";
         case SmtReplayImport.bounded_binder_size limit term of
           SOME n=>tick n | NONE=>raise ERR
             "prepare_source_selective_generalization"
             "bounded operand binder cap")
      fun syntax term=
        (tick 1;
         if Term.is_var term then
           (remember(#1(Term.dest_var term));SGAtom term)
         else if Term.is_comb term then
           let val(a,b)=Term.dest_comb term
           in SGApp(Term.type_of term,syntax a,syntax b) end
         else if Term.is_abs term then
           let val(v,b)=Term.dest_abs term
               val _=remember(#1(Term.dest_var v))
           in SGAbs(Term.type_of term,v,syntax b) end
         else SGAtom term)
      fun capture limit term=(bounded limit term;syntax term)
      val wanted=G.representative graph target
      val wanted_tree=capture (#output_limit limits) wanted
      val _=bounded cap wanted
      val(variables,body)=boolSyntax.strip_forall wanted
      val _=if null variables then raise ERR
        "prepare_source_selective_generalization" "target has no actual GEN"
        else ()
      val _=bounded (#input_limit limits) body
      val _=bounded cap body
      val _=bounded (#input_limit limits)(Thm.concl theorem)
      val _=if Term.aconv body (Thm.concl theorem) then () else raise ERR
        "prepare_source_selective_generalization"
        "different actual candidate body"
      (* The actual surviving Hyp portfolio supplies eigenvariable authority.
         Its graph free-variable receipts are inspected without raw Gamma. *)
      val SourceRealization {occurrences,...}=source
      fun actual_hyp hypothesis=
        let val node=case List.find(fn(_,node)=>
              (tick 1;Portable.pointer_eq(hypothesis,
                 G.representative graph node))) occurrences of
                SOME(_,node)=>node | NONE=>raise ERR
                  "prepare_source_selective_generalization"
                  "surviving Hyp has no actual Source occurrence"
            val fv=case G.free_variables graph node of G.Known fv=>fv
              | G.Unknown=>raise ERR "prepare_source_selective_generalization"
                  "missing actual Source free-variable receipt"
            val _=List.app(fn v=>tick 1) fv
        in if List.exists(fn v=>List.exists(fn actual=>
              (tick 1;sr_same v actual)) fv) variables then raise ERR
            "prepare_source_selective_generalization"
            "GEN variable occurs in actual surviving Hyp" else () end
      val _=List.app actual_hyp (Thm.hyp theorem)
      val completed=ref([]:(source_realization * unit) list)
      val raw=ref([]:source_realization list)
      val expose=ref([]:G.node list)
      val sources=ref([]:G.node list)
      fun add cell node=(tick 1;if List.exists(fn old=>old=node)(!cell)
        then () else cell:=node:: !cell)
      fun original_row names leaves extras cuts index=
        case List.find(fn(slot,_,_)=>slot=index) cuts of
          SOME(_,term,_)=>term | NONE=>
            let fun named node=case List.find(fn(old,_)=>old=node) names of
                    SOME(_,term)=>term | NONE=>raise ERR
                      "prepare_source_selective_generalization"
                      "missing genuine compact vocabulary"
                val leaf=if index<Vector.length leaves then
                  Vector.sub(leaves,index) else
                  List.nth(extras,index-Vector.length leaves)
            in leaf_term named leaf end
      fun selected_names names originals conclusion=
        let val free=List.concat(List.map Term.free_vars
              (conclusion::originals))
        in List.filter(fn(_,variable)=>List.exists(fn v=>
          (tick 1;sr_same v variable)) free) names end
      fun collect receipt=
        let val _=source_realization_guard expected receipt
            val hit=List.exists(fn(old,_)=>
              (tick 1;Portable.pointer_eq(old,receipt)))(!completed)
        in if hit then () else
          let val SourceRealization {graph=owner,scope=held_scope,
                original_sources=held_sources,target=actual,compact,...}=
                receipt
              val _=if Portable.pointer_eq(graph,owner) andalso
                  Portable.pointer_eq(original_sources,held_sources) andalso
                  G.scope_visible graph scope held_scope then () else raise ERR
                "prepare_source_selective_generalization" "foreign cut backing"
              val _=bounded cap(G.representative graph actual)
              val SourceCompact {block=Block {leaves,...},names,needed,
                extra_leaves,cuts,proof,...}=compact
              val _=List.app(fn term=>ignore(capture cap term))
                (Thm.concl proof::Thm.hyp proof)
              fun row index=
                let val _=ignore(capture cap
                      (original_row names leaves extra_leaves cuts index))
                in case List.find(fn(slot,_,_)=>slot=index) cuts of
                    SOME(_,_,parent)=>collect parent
                  | NONE=>case (if index<Vector.length leaves then
                      Vector.sub(leaves,index) else
                      List.nth(extra_leaves,index-Vector.length leaves)) of
                      Source node=>add sources node
                    | Definition(node,_)=>add expose node
                    | ClosedWitness fact=>add expose(closed_node fact)
                    | ConversionWitness conv=>
                        (add expose(conversion_source conv);
                         add expose(conversion_target conv)) end
              val _=add expose actual
              val _=List.app row needed
              val _=raw:=receipt:: !raw
              val _=completed:=(receipt,()):: !completed
          in () end
        end
      val _=collect source
      (* Only bounded conclusion/witness subgraphs may be expanded. A large
         Source forest stays a distinct authentic atom, even if conjunctive. *)
      val required=G.block_reachable graph (!expose)
      fun protected node=List.exists(fn old=>old=node)(!sources) andalso
        not(List.exists(fn old=>old=node) required)
      val replacements=ref([]:(G.node * sg_tree) list)
      fun actual node=case List.find(fn(old,_)=>old=node)(!replacements) of
          SOME(_,tree)=>tree | NONE=>
            let val tree=capture cap(G.representative graph node)
                val _=bounded (#output_limit limits)
                  (G.representative graph node)
            in replacements:=(node,tree):: !replacements;tree end
      val _=List.app(fn receipt=>
        let val SourceRealization {compact=SourceCompact {names,proof,
              block=Block {leaves,...},needed,extra_leaves,cuts,...},...}=
              receipt
            val originals=List.map
              (original_row names leaves extra_leaves cuts) needed
            val bindings=selected_names names originals(Thm.concl proof)
        in List.app(fn(node,_)=>if protected node then ()
          else ignore(actual node)) bindings end)(!raw)
      fun fresh node=
        let fun choose index=
              let val text="__smt_gen_gamma_"^Int.toString index
                  val _=tick(String.size text+1)
              in if List.exists(fn old=>old=text)(!identifiers) then
                choose(index+1) else (remember text;text) end
        in SGName(node,choose 0,G.type_of graph node) end
      val gamma=List.map(fn node=>(node,if protected node then fresh node
        else actual node))(!sources)
      fun replacement node=case List.find(fn(old,_)=>old=node) gamma of
          SOME(_,tree)=>tree | NONE=>actual node
      fun substitute bindings tree=case tree of SGAtom term=>
          (case List.find(fn(old,_)=>
             (tick 1;sr_same old term)) bindings of
             SOME(_,value)=>value | NONE=>tree)
        | SGApp(ty,a,b)=>SGApp(ty,substitute bindings a,substitute bindings b)
        | SGAbs(ty,v,b)=>SGAbs(ty,v,substitute
            (List.filter(fn(old,_)=>not(sr_same old v)) bindings)b)
        | _=>tree
      fun type_scan ty=
        (tick 1;policies:=ty:: !policies;
         if Type.is_vartype ty then 1:IntInf.int else
           1+List.foldl(fn(t,n)=>n+type_scan t)0
             (#Args(Type.dest_thy_type ty)))
      fun quote trees=
        let fun annotations tree=
              type_scan(sg_type tree)+(case tree of
                SGApp(_,a,b)=>annotations a+annotations b
              | SGAbs(_,v,b)=>type_scan(Term.type_of v)+annotations b
              | _=>0)
            fun cost tree=
              let val raw=sg_size false tree val inc=sg_size true tree
                  val _=if raw<=IntInf.fromInt cap andalso
                    inc<=IntInf.fromInt cap then () else raise ERR
                    "prepare_source_selective_generalization"
                    "prospective actual compact operand cap"
              in raw+inc+annotations tree end
            val amount=List.foldl(fn(tree,n)=>n+cost tree)1 trees
            val _=budget:= !budget+amount
        in if !budget<=remaining expected then () else raise ERR
          "prepare_source_selective_generalization" "prospective original Work"
        end
      (* Pure typed alpha grammar determines every future Hyp set.
         Source identities are protected graph data, never proof authority. *)
      fun model tree=case tree of SGAtom term=>SCEAtom term
        | SGName(node,_,_)=>SCEProtected node
        | SGApp(ty,a,b)=>SCEApp(ty,model a,model b)
        | SGAbs(ty,v,b)=>SCEAbs(ty,v,v,model b)
        | SGForecastConstant _=>raise ERR
            "prepare_source_selective_generalization"
            "prospective equality marker used as a Hyp"
      fun same a b=sce_equal tick (model a)(model b)
      fun insert (tree,values)=if List.exists(same tree) values then values
        else values @ [tree]
      fun union a b=List.foldl insert a b
      fun without tree values=List.filter(fn old=>not(same tree old)) values
      fun footprint(conclusion,hypotheses)=conclusion::hypotheses
      fun event result operands=
        (quote(footprint result @ List.concat(List.map footprint operands));
         result)
      fun alignment wanted (proof as (actual,hypotheses))=
        let val equality=event
              (sg_binary boolSyntax.equality actual wanted,[])[]
            val _=quote[actual,wanted]
        in event(wanted,hypotheses)[equality,proof] end
      fun project_models tree (proof as (conclusion,hypotheses))=
        case tree of Empty=>[] | Leaf _=>[proof]
        | Split(a,b)=>
            let val(left,right)=case conclusion of
                  SGApp(_,SGApp(_,_,left),right)=>(left,right)
                | _=>raise ERR "prepare_source_selective_generalization"
                    "different prospective context projection"
                val first=event(left,hypotheses)[proof]
                val second=event(right,hypotheses)[proof]
            in project_models a first @ project_models b second end
      fun proof_tree []=(SGAtom boolSyntax.T,[])
        | proof_tree proofs=
          let val entries=Vector.fromList proofs
              fun build Empty=(SGAtom boolSyntax.T,[])
                | build(Leaf index)=Vector.sub(entries,index)
                | build(Split(a,b))=
                    let val left as (l,lh)=build a
                        val right as (r,rh)=build b
                    in event(sg_binary boolSyntax.conjunction l r,
                      union lh rh)[left,right] end
          in build(make_tree 0(Vector.length entries)) end
      fun prepare receipt=
        let val SourceRealization {target=target_node,compact,...}=receipt
            val SourceCompact {block=Block {leaves,...},proof,names,needed,
              extra_leaves,cuts,...}=compact
            val originals=List.map
              (original_row names leaves extra_leaves cuts) needed
            val bindings=selected_names names originals(Thm.concl proof)
            val sigma=List.map(fn(node,term)=>(term,replacement node)) bindings
            val original_trees=List.map(capture cap) originals
            val rows=List.map(substitute sigma) original_trees
            val result=actual target_node
            val context=sg_forest original_trees val transformed=sg_forest rows
            val initial=(capture cap(Thm.concl proof),
              List.map(capture cap)(Thm.hyp proof))
            val _=quote(footprint initial)
            val assumption=event(context,[context])[]
            val boundary=make_tree 0(length original_trees)
            val projections=project_models boundary assumption
            (* D_PROVE_HYP is the actual DISCH then MP sequence. Each
               intermediate result includes its complete exact named Hyp. *)
            fun replace (premise as (row,ph),(current as (c,ch)))=
              let val discharged=event
                    (sg_binary boolSyntax.implication row c,
                     without row ch)[current]
              in event(c,union (#2 discharged) ph)[discharged,premise] end
            val lifted=List.foldl replace initial projections
            val closed_law=event
              (sg_binary boolSyntax.implication context (#1 lifted),
               without context (#2 lifted))[lifted]
            val _=if null(#2 closed_law) then () else raise ERR
              "prepare_source_selective_generalization"
              "prospective genuine compact law not closed"
            val transformed_law=event
              (sg_binary boolSyntax.implication transformed result,[])
              [closed_law]
            val _=quote(List.concat(List.map(fn(redex,residue)=>
              [SGAtom redex,residue]) sigma))
            fun witness index=case List.find(fn(slot,_,_)=>slot=index) cuts of
                SOME(_,_,parent)=>SGParentWitness(prepare parent)
              | NONE=>case (if index<Vector.length leaves then
                  Vector.sub(leaves,index) else
                  List.nth(extra_leaves,index-Vector.length leaves)) of
                  Source node=>SGSourceWitness node
                | Definition _=>SGDefinitionWitness
                | ClosedWitness fact=>SGFactWitness fact
                | ConversionWitness conv=>SGConversionWitness conv
            val witnesses=List.map witness needed
            fun backing(row,SGSourceWitness _)=event(row,[row])[]
              | backing(row,SGDefinitionWitness)=
                  let val(a,b)=case row of
                        SGApp(_,SGApp(_,_,a),b)=>(a,b)
                      | _=>raise ERR "prepare_source_selective_generalization"
                          "prospective definition is not equality"
                      val _=quote[a,b]
                  in event(row,[])[] end
              | backing(row,SGFactWitness fact)=
                  alignment row(capture cap(Thm.concl(closed_proof fact)),[])
              | backing(row,SGConversionWitness conv)=alignment row
                  (capture cap(Thm.concl(conversion_proof conv)),[])
              | backing(row,SGParentWitness(SGProgram
                  {result,hypotheses,...}))=alignment row(result,hypotheses)
            val models=List.map backing(ListPair.zip(rows,witnesses))
            val support=proof_tree models
            val applied=event(result,#2 support)[transformed_law,support]
            val canonical=alignment result applied
        in SGProgram{source=receipt,original=proof,target=target_node,
          original_rows=originals,rows=rows,witnesses=witnesses,
          sigma=sigma,result=result,hypotheses= #2 canonical} end
      val program as SGProgram{result,hypotheses,...}=prepare source
      fun forall_layers (SGApp(_,SGAtom operator,SGAbs(ty,v,body)))=
            if Term.is_const operator andalso
                Term.same_const operator boolSyntax.universal then
              (SGAtom operator,ty,v)::forall_layers body else []
        | forall_layers _=[]
      val layers=forall_layers wanted_tree
      val _=if length layers=length variables then () else raise ERR
        "prepare_source_selective_generalization"
        "different prospective actual GEN spine"
      fun gen((variable,(operator,ty,_)),current as (body,hypotheses))=
        (quote[SGAtom variable];event
          (SGApp(Type.bool,operator,SGAbs(ty,variable,body)),hypotheses)
          [current])
      val generated=List.foldr gen(result,hypotheses)
        (ListPair.zip(variables,layers))
      val canonical=alignment wanted_tree generated
      val selected=List.filter(fn(_,row)=>List.exists(same row)
        (#2 canonical)) gamma
      fun close((_,row),current as (conclusion,hypotheses))=
        event(sg_binary boolSyntax.implication row conclusion,
          without row hypotheses)[current]
      val closed=List.foldr close canonical selected
      val _=if null(#2 closed) then () else raise ERR
        "prepare_source_selective_generalization"
        "prospective effective Source law not closed"
      (* Final INST traverses this closed small template. Large residues
         remain opaque; post-insertion private/kernel pricing is OPEN. *)
      val _=quote(footprint closed)
      val _=List.app(fn(node,tree)=>case tree of SGName _=>
        (quote[tree];ignore(type_scan(G.type_of graph node))) | _=>()) gamma
      val opened=G.record_opened_view graph scope cap target
      val plan=SGPlan{work=expected,source=source,frame=frame,graph=graph,
        scope=scope,target=target,opened=opened,variables=variables,body=body,
        program=program,names=gamma,policies=List.rev(!policies),
        quote= !budget,check_type=check_type,used=ref false}
      val _=sg_guard expected plan
    in plan end))

  fun execute_source_selective_generalization expected
      (plan as SGPlan{source,graph,target,program,names,policies,quote,
        check_type,variables,used,...}) = sr_fail expected (fn()=>
    W.with_step expected (fn()=>
    let
      val _=sg_guard expected plan
      val _=if !used then raise ERR "execute_source_selective_generalization"
        "plan already used" else used:=true
      val _=pay expected quote
      fun guarded operation=
        (sg_guard expected plan;let val value=operation()
         in sg_guard expected plan;value end)
      val _=List.app(fn ty=>guarded(fn()=>check_type ty)) policies
      val fresh=ref([]:(G.node * Term.term) list)
      fun emit tree=case tree of SGAtom term=>term
        | SGForecastConstant _=>raise ERR
            "execute_source_selective_generalization"
            "prospective-only constant escaped into the actual program"
        | SGName(node,text,ty)=>(case List.find(fn(old,_)=>old=node)(!fresh) of
            SOME(_,term)=>term | NONE=>
              let val term=guarded(fn()=>Term.mk_var(text,ty))
              in fresh:=(node,term):: !fresh;term end)
        | SGApp(_,a,b)=>
            let val left=emit a val right=emit b
            in guarded(fn()=>Term.mk_comb(left,right)) end
        | SGAbs(_,v,b)=>let val body=emit b
            in guarded(fn()=>Term.mk_abs(v,body)) end
      val actual_names=List.map(fn(node,tree)=>(node,emit tree)) names
      val completed=ref([]:(source_realization * Thm.thm) list)
      fun align wanted theorem=if Portable.pointer_eq
          (wanted,Thm.concl theorem) then theorem else
        guarded(fn()=>SmtReplayRuleObservation.EQ_MP
          (SmtReplayRuleObservation.ALPHA (Thm.concl theorem) wanted) theorem)
      fun play(SGProgram{source=receipt,original,target=actual,original_rows,
          rows,witnesses,sigma,result,...})=
        let val _=source_realization_guard expected receipt
        in case List.find(fn(old,_)=>Portable.pointer_eq(old,receipt))
            (!completed) of SOME(_,proof)=>proof | NONE=>
          let val terms=Vector.fromList original_rows
              val tree=make_tree 0(Vector.length terms)
              val context=guarded(fn()=>tree_term terms tree)
              val assumption=guarded(fn()=>
                SmtReplayRuleObservation.ASSUME context)
              val projected=guarded(fn()=>project tree assumption)
              val lifted=List.foldl(fn(premise,proof)=>guarded(fn()=>
                SmtReplayRuleObservation.D_PROVE_HYP premise proof))
                original projected
              val law=guarded(fn()=>
                SmtReplayRuleObservation.DISCH context lifted)
              val _=if null(Thm.hyp law) andalso clean law then () else
                raise ERR "execute_source_selective_generalization"
                  "genuine compact law not closed"
              val substitution=List.map(fn(old,tree)=>
                {redex=old,residue=emit tree}) sigma
              val actual_law=guarded(fn()=>
                SmtReplayRuleObservation.INST substitution law)
              val actual_rows=List.map emit rows
              fun witness (row,SGSourceWitness _)=guarded(fn()=>
                    SmtReplayRuleObservation.ASSUME row)
                | witness(row,SGDefinitionWitness)=
                    let val(a,b)=boolSyntax.dest_eq row
                    in guarded(fn()=>SmtReplayRuleObservation.ALPHA a b) end
                | witness(row,SGFactWitness fact)=align row(closed_proof fact)
                | witness(row,SGConversionWitness conv)=
                    align row(conversion_proof conv)
                | witness(row,SGParentWitness parent)=align row(play parent)
              val backing=List.map witness(ListPair.zip(actual_rows,witnesses))
              val support=guarded(fn()=>
                tree_proof(Vector.fromList backing)tree)
              val proof=guarded(fn()=>SmtReplayRuleObservation.MP
                actual_law support)
              val proof=align (G.representative graph actual) proof
              val _=completed:=(receipt,proof):: !completed
          in proof end
        end
      val body=play program
      val _=if List.all(fn hyp=>List.exists(fn(_,row)=>Term.aconv hyp row)
        actual_names)(Thm.hyp body) then () else raise ERR
          "execute_source_selective_generalization"
          "non-Source definition or cut Hyp survived before GEN"
      val proof=List.foldr(fn(variable,proof)=>guarded(fn()=>
        Thm.GEN variable proof)) body variables
      val proof=align(G.representative graph target)proof
      val rows=List.filter(fn(_,row)=>List.exists(Term.aconv row)
        (Thm.hyp proof)) actual_names
      val _=sg_guard expected plan
    in SGEffective{plan=plan,proof=proof,target=target,names= !fresh,
      rows=rows,discharged=[],realized=ref NONE} end))

  (* Effective Scope closure operates on the authentic named result. The
     ordinary Source leaf decoder is never asked to decode a GEN witness. *)
  fun discharge_source_selective_generalization expected
      (SGEffective{plan=plan as SGPlan{source,graph,scope,check_type,...},
        proof,target,names,rows,discharged,...}) hypothesis =
    sr_fail expected (fn()=>W.with_step expected (fn()=>
    let
      val _=sg_guard expected plan
      val _=ignore(G.closure_root graph scope hypothesis)
      val SourceRealization {occurrences,...}=source
      val _=if List.exists(fn(_,node)=>node=hypothesis) occurrences then ()
        else raise ERR "discharge_source_selective_generalization"
          "hypothesis has no authentic Source occurrence"
      val operand=case List.find(fn(node,_)=>node=hypothesis) rows of
          SOME(_,row)=>row | NONE=>raise ERR
            "discharge_source_selective_generalization"
            "hypothesis is not in the effective named Gamma"
      val cap= #template_limit(W.semantic_limits expected)
      fun count inclusive term=case
          (if inclusive then SmtReplayImport.bounded_binder_size cap term
           else SmtReplayImport.bounded_raw_size cap term) of
            SOME n=>n | NONE=>raise ERR
              "discharge_source_selective_generalization"
              "actual named operand exceeds original cap"
      fun future inclusive=
        let val a=count inclusive operand
            val b=count inclusive(Thm.concl proof)
        in if cap<3 orelse b>cap-3-a then raise ERR
            "discharge_source_selective_generalization"
            "prospective effective Scope law exceeds original cap"
          else a+b+3 end
      val raw=future false val inc=future true
      val policies=ref([]:Type.hol_type list)
      fun ty actual=(W.spend expected 1;policies:=actual:: !policies;
        if Type.is_vartype actual then () else
          List.app ty (#Args(Type.dest_thy_type actual)))
      fun syntax term=
        (W.spend expected 1;ty(Term.type_of term);
         if Term.is_comb term then
           let val(a,b)=Term.dest_comb term in syntax a;syntax b end
         else if Term.is_abs term then
           let val(v,b)=Term.dest_abs term in syntax v;syntax b end else ())
      val _=W.spend expected raw val _=W.spend expected inc
      val _=List.app(fn term=>
        (W.spend expected(count false term);
         W.spend expected(count true term);syntax term))
        (operand::Thm.concl proof::Thm.hyp proof)
      val _=ty(Term.type_of boolSyntax.implication)
      val _=ty(#2(Type.dom_rng(Term.type_of boolSyntax.implication)))
      val _=ty Type.bool
      fun guarded operation=(sg_guard expected plan;
        let val result=operation() in sg_guard expected plan;result end)
      val _=List.app(fn actual=>guarded(fn()=>check_type actual))
        (List.rev(!policies))
      val _=W.spend expected 7
      val proof=guarded(fn()=>SmtReplayRuleObservation.DISCH operand proof)
      val head=guarded(fn()=>G.constant graph scope boolSyntax.implication)
      val inner=guarded(fn()=>G.application graph scope(head,hypothesis))
      val target=guarded(fn()=>G.application graph scope(inner,target))
      val rows=List.filter(fn(node,_)=>node<>hypothesis) rows
      val _=if not(List.exists(Term.aconv operand)(Thm.hyp proof)) then ()
        else raise ERR "discharge_source_selective_generalization"
          "actual effective Scope Hyp survived DISCH"
    in SGEffective{plan=plan,proof=proof,target=target,names=names,
      rows=rows,discharged=hypothesis::discharged,realized=ref NONE} end))

  fun source_selective_generalization_data_for expected
      (SGEffective{plan=plan as SGPlan{source,frame,...},target,...}) =
    (sg_guard expected plan;{source=source,frame=frame,target=target})

  fun source_selective_generalization_theorem_for expected
      (SGEffective{plan=plan as SGPlan{source,graph,...},proof,target,
        names,rows,discharged,realized}) = sr_fail expected (fn()=>
    let val _=sg_guard expected plan
    in case !realized of SOME theorem=>theorem | NONE=>
      W.with_step expected (fn()=>
      let
        fun guarded operation=(sg_guard expected plan;
          let val value=operation() in sg_guard expected plan;value end)
        (* Protected residues are absent from every binder body. The only
           late insertion is in the closed Source implication antecedents. *)
        fun no_bound term depth=
          if Term.is_var term then
            if depth=0 orelse not(List.exists(fn(_,v)=>sr_same v term) names)
            then () else raise ERR "source_selective_generalization"
              "protected Source insertion below a binder"
          else if Term.is_comb term then
            let val(a,b)=Term.dest_comb term
            in no_bound a depth;no_bound b depth end
          else if Term.is_abs term then
            let val(_,body)=Term.dest_abs term
            in no_bound body(depth+1) end else ()
        val _=no_bound (Thm.concl proof) 0
        val law=List.foldr(fn((_,row),theorem)=>guarded(fn()=>
          SmtReplayRuleObservation.DISCH row theorem)) proof rows
        val _=if null(Thm.hyp law) andalso clean law then () else raise ERR
          "source_selective_generalization" "effective named law not closed"
        val sigma=List.map(fn(node,variable)=>
          {redex=variable,residue=G.representative graph node}) names
        val actual=guarded(fn()=>SmtReplayRuleObservation.INST sigma law)
        val result=List.foldl(fn((node,_),theorem)=>guarded(fn()=>
          SmtReplayRuleObservation.MP theorem
            (SmtReplayRuleObservation.ASSUME(G.representative graph node))))
          actual rows
        (* The actual target is either the admitted bounded GEN target or
           owner-built implication shells around retained Source children.
           Those large children are the exact simultaneously inserted nodes. *)
        val wanted=G.representative graph target
        val result=if Portable.pointer_eq(Thm.concl result,wanted) then result
          else guarded(fn()=>SmtReplayRuleObservation.EQ_MP
            (SmtReplayRuleObservation.ALPHA(Thm.concl result)wanted) result)
        val SourceRealization {theorem=original,...}=source
        val expected_hyp=List.filter(fn hyp=>not(List.exists(fn node=>
          Portable.pointer_eq(hyp,G.representative graph node))discharged))
          (Thm.hyp original)
        val _=if Portable.pointer_eq(Thm.concl result,
            G.representative graph target) andalso clean result andalso
            ListPair.allEq Portable.pointer_eq(Thm.hyp result,expected_hyp)
            andalso #1(Tag.dest_tag(Thm.tag result))=
              #1(Tag.dest_tag(Thm.tag original)) then () else raise ERR
          "source_selective_generalization"
          "actual endpoint, Hyp or tags changed"
        val _=sg_guard expected plan
        val _=realized:=SOME result
      in result end)
    end)

  (* Compilation retains the opaque proof origin and a lexical route.
     Concrete SPEC arguments are required. Missing binders are not guessed. *)
  datatype sce_schema_route=SCEForall of int*Term.term
    | SCESelect of bool | SCEUndisch | SCEAssertion
  datatype source_condition_schema=SCESchema of
    {work:W.portfolio,evidence:source_condition_evidence,
     route:sce_schema_route list,binders:(int*Term.term) list,
     left:Term.term,right:Term.term option,conditions:Term.term list,
     terminal:source_rule_terminal}
  fun sce_schema_guard expected(SCESchema {work,evidence,...})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work) then () else
         raise ERR "source_condition_schema" "foreign expected Work";
       sce_guard expected evidence))
  fun compile_source_condition_schemas expected evidence=
    sr_fail expected(fn()=>W.with_step expected(fn()=>
    let val d=sce_data expected evidence
        val cap= #output_limit(W.semantic_limits expected)
        val target= #target d val next=ref 0
        fun tick n=(sce_guard expected evidence;W.spend expected n)
        val _=case SmtReplayImport.bounded_raw_size cap target of
          SOME n=>tick n | _=>raise ERR "source_condition_schema"
            "bounded selected clause raw syntax"
        val _=case SmtReplayImport.bounded_binder_size cap target of
          SOME n=>tick n | _=>raise ERR "source_condition_schema"
            "bounded selected clause binder syntax"
        fun guarded operation=
          (sce_guard expected evidence;
           let val value=operation()
           in sce_guard expected evidence;value end)
        fun routes path binders conditions term=
          (tick 1;
           if boolSyntax.is_forall term then
             let val(v,body)=guarded(fn()=>boolSyntax.dest_forall term)
                 val id= !next val _=next:=id+1
             in routes (SCEForall(id,v)::path)((id,v)::binders)
               conditions body end
           else if boolSyntax.is_conj term then
             let val(a,b)=guarded(fn()=>boolSyntax.dest_conj term)
             in routes(SCESelect true::path)binders conditions a @
               routes(SCESelect false::path)binders conditions b end
           else if boolSyntax.is_imp_only term then
             let val(a,b)=guarded(fn()=>boolSyntax.dest_imp_only term)
             in routes(SCEUndisch::path)binders(a::conditions)b end
           else let val(terminal,left,right)=
                 if boolSyntax.is_eq term then
                   let val(a,b)=guarded(fn()=>boolSyntax.dest_eq term)
                   in(SourceEquality,a,SOME b)end
                 else if boolSyntax.is_neg term then
                   (SourceFalse,guarded(fn()=>boolSyntax.dest_neg term),NONE)
                 else(SourceTruth,term,NONE)
           in [SCESchema {work=expected,evidence=evidence,
             route=List.rev path,binders=List.rev binders,left=left,
             right=right,conditions=List.rev conditions,terminal=terminal}]
           end)
        val(path,body)=if boolSyntax.is_eq target then
            let val(a,b)=guarded(fn()=>boolSyntax.dest_eq target)
            in if Term.is_const b andalso Term.same_const b boolSyntax.T
                 then ([SCEAssertion],a)
               else([],target)end
          else([],target)
        val result=routes path [] [] body
        val _=sce_guard expected evidence
    in result end))
  fun source_condition_schema_for expected
      (schema as SCESchema {binders,left,right,conditions,terminal,...})=
    (sce_schema_guard expected schema;
     {binders=binders,left=left,right=right,conditions=conditions,
      terminal=terminal})
  fun prepare_source_condition_schema expected
      (schema as SCESchema {evidence,route,binders,terminal,...})
      {frame,caller,arguments,check_type}=
    sr_fail expected(fn()=>
    let val _=sce_schema_guard expected schema
        val _=if length binders=length arguments then () else
          raise ERR "prepare_source_condition_schema"
            "every actual explicit binder requires an owned argument"
        fun steps [] []=[]
          | steps(SCEAssertion::rest)args=
              EvidenceAssertion::steps rest args
          | steps(SCESelect left::rest)args=
              EvidenceStep(SourceConjunct left)::steps rest args
          | steps(SCEUndisch::rest)args=
              EvidenceStep SourceCondition::steps rest args
          | steps(SCEForall _::rest)(arg::args)=
              EvidenceStep(SourceSpec arg)::steps rest args
          | steps _ _=raise ERR "prepare_source_condition_schema"
              "lexical route and actual arguments differ"
    in prepare_source_condition_rule expected
      {evidence=evidence,frame=frame,caller=caller,
       steps=steps route arguments,terminal=terminal,check_type=check_type}
    end)

  datatype source_rewrite_refusal=ConditionCycle | ConditionStackLimit
    | EquationCycle | PermutativeOrder
  datatype source_rewrite_gate=RewriteAllowed
    | RewriteRefused of source_rewrite_refusal
  datatype source_condition_occurrence=SCEOccurrence of
    {work:W.portfolio,evidence:source_condition_evidence,term:Term.term}
  fun sce_occurrence_guard expected(SCEOccurrence {work,evidence,...})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work) then () else
         raise ERR "source_condition_occurrence" "foreign expected Work";
       sce_guard expected evidence))
  fun source_condition_occurrences expected evidence=
    sr_fail expected(fn()=>W.with_step expected(fn()=>
      let val d=sce_data expected evidence
          fun walk term=
            (sce_guard expected evidence;W.spend expected 1;
             if boolSyntax.is_imp_only term then
               let val(a,b)=boolSyntax.dest_imp_only term
               in SCEOccurrence {work=expected,evidence=evidence,term=a}::
                 walk b end else [])
          val result=walk(#target d)
      in sce_guard expected evidence;result end))
  (* Exact Cond_rewr condition and unbounded permutation checks. Pending
     stack entries are authentic occurrences, not supplied raw theorems. *)
  fun source_condition_rewrite_gate expected {rule,stack}=
    sr_fail expected(fn()=>W.with_step expected(fn()=>
    let
      fun guard()=(sce_guard expected rule;
        List.app(sce_occurrence_guard expected)stack)
      val _=guard()
      fun tick n=(guard();W.spend expected n)
      (* Only the trusted clause producer can issue this origin. A raw
         instantiated shape cannot grant template permutation authority. *)
      val permutative=case rule of
          SCEProjected {permutative=SOME actual,...}=>actual
        | _=>raise ERR "source_condition_rewrite_gate"
            "missing genuine original template permutation origin"
      val d=sce_data expected rule
      val cap= #output_limit(W.semantic_limits expected)
      fun bounded term=
        (case SmtReplayImport.bounded_raw_size cap term of
           SOME n=>tick n | _=>raise ERR "source_condition_rewrite_gate"
             "selected rewrite raw syntax bound";
         case SmtReplayImport.bounded_binder_size cap term of
           SOME n=>tick n | _=>raise ERR "source_condition_rewrite_gate"
             "selected rewrite binder syntax bound")
      val _=bounded(#target d)
      fun split term conditions=
        (tick 1;if boolSyntax.is_imp_only term then
           let val(a,b)=boolSyntax.dest_imp_only term
           in split b (a::conditions)end
         else(List.rev conditions,term))
      val(conditions,equation)=split(#target d)[]
      val(left,right)=if boolSyntax.is_eq equation then
          boolSyntax.dest_eq equation else
        raise ERR "source_condition_rewrite_gate" "actual equation required"
      val pending=List.map(fn SCEOccurrence {term,...}=>term)stack
      fun same a b=(tick 1;Term.aconv a b)
      fun scan_type ty=(tick 1;if Type.is_vartype ty then
            tick(String.size(Type.dest_vartype ty))
          else let val {Thy,Tyop,Args}=Type.dest_thy_type ty
               in tick(String.size Thy+String.size Tyop);
                 List.app scan_type Args end)
      fun size term=(tick 1;if Term.is_abs term then
            1+size(#2(Term.dest_abs term))
          else if Term.is_comb term then
            let val(a,b)=Term.dest_comb term in size a+size b end else 1)
      fun find term []=NONE
        | find term((v,id)::rest)=
            (tick 1;if Term.term_eq term v then SOME id else find term rest)
      fun head env term=
        if Term.is_var term then
          (case find term env of SOME id=>(("","",~id),Type.alpha)
           | NONE=>let val(name,ty)=Term.dest_var term
                   in((name,"",0),ty)end)
        else if Term.is_const term then
          let val {Name,Thy,Ty}=Term.dest_thy_const term
          in((Name,Thy,1),Ty)end
        else if Term.is_abs term then
          (("","",2),Term.type_of(#1(Term.dest_abs term)))
        else(("","",3),Type.alpha)
      fun compare_type a b=
        (scan_type a;scan_type b;Type.compare(a,b))
      fun compare_head env_a env_b a b=
        let val((name_a,thy_a,kind_a),ty_a)=head env_a a
            val((name_b,thy_b,kind_b),ty_b)=head env_b b
            val _=tick(String.size name_a+String.size name_b+
              String.size thy_a+String.size thy_b+1)
        in case String.compare(name_a,name_b)of EQUAL=>
             (case String.compare(thy_a,thy_b)of EQUAL=>
               (case Int.compare(kind_a,kind_b)of EQUAL=>
                  compare_type ty_a ty_b | order=>order)
              | order=>order)
           | order=>order end
      fun strip term args=(tick 1;if Term.is_comb term then
          let val(f,x)=Term.dest_comb term in strip f(x::args)end
        else(term,args))
      fun order depth env_a env_b a b=
        case Int.compare(size a,size b)of EQUAL=>
          if Term.is_abs a then
            if Term.is_abs b then
              let val(v,x)=Term.dest_abs a val(w,y)=Term.dest_abs b
              in case compare_type(Term.type_of v)(Term.type_of w)of
                EQUAL=>order(depth+1)((v,depth)::env_a)
                  ((w,depth)::env_b)x y | result=>result end
            else GREATER
          else if Term.is_abs b then LESS
          else let val(f,xs)=strip a [] val(g,ys)=strip b []
                   fun list [] []=EQUAL
                     | list(x::xs)(y::ys)=
                         (case order depth env_a env_b x y of
                            EQUAL=>list xs ys | result=>result)
                     | list [] _=LESS | list _ []=GREATER
               in case compare_head env_a env_b f g of EQUAL=>
                    (case Int.compare(length xs,length ys)of
                       EQUAL=>list xs ys | result=>result)
                  | result=>result end
        | result=>result
      val result=if List.exists(fn condition=>List.exists
            (same condition)pending)conditions then
          RewriteRefused ConditionCycle
        else if length pending+length conditions>4 then
          RewriteRefused ConditionStackLimit
        else if same left right then RewriteRefused EquationCycle
        else if permutative andalso order 0 [] [] left right<>GREATER then
          RewriteRefused PermutativeOrder
        else RewriteAllowed
      val _=guard()
    in result end))

  (* A checked GEN result has an explicit witness case. It is never decoded
     as an ordinary Definition or promoted by a caller theorem/node pair. *)
  datatype source_effective_evidence = SEOriginal of source_realization
    | SEGeneralized of source_selective_generalization
    | SEChecked of
      {work:W.portfolio,source_frame:retained_source_frame,
       graph:G.graph,root:G.scope,scope:G.scope,frame:Scope.receipt,
       original_sources:SmtReplaySource.sources,target:G.node,
       occurrences:(int * G.node) list,origins:(int * source_origin) list,
       theorem:Thm.thm,block:block,edge:edge,named_target:Term.term,
       named_proof:Thm.thm,names:(G.node * Term.term) list,needed:int list,
       cuts:(int * source_effective_evidence) list,
       held:G.closure_child list,facts:closed_fact list,
       conversions:closed_conversion list,template_limit:int,
       parents:source_effective_evidence list,epoch:int,symbols:int}
    | SEScoped of
      {work:W.portfolio,parent:source_effective_evidence,hypothesis:G.node,
       target:G.node,native_hypothesis:Term.term,proof:Thm.thm,
       names:(G.node * Term.term) list,
       rows:(int * Term.term * source_effective_scope_row) list,
       parents:source_effective_evidence list,realized:Thm.thm option ref}
    | SEFurtherGEN of
      {work:W.portfolio,parent:source_effective_evidence,opened:G.source,
       target:G.node,proof:Thm.thm,names:(G.node * Term.term) list,
       rows:(G.node * Term.term) list,realized:Thm.thm option ref}
    | SENormalized of
      {work:W.portfolio,parent:source_effective_evidence,opened:G.source,
       target:G.node,origin:G.source option,proof:Thm.thm,
       names:(G.node * Term.term) list,
       rows:(G.node * Term.term) list,realized:Thm.thm option ref}
  and source_effective_scope_row = ESSource of G.node
    | ESDefinition of G.node * Term.term | ESFact of closed_fact
    | ESConversion of closed_conversion | ESCut of source_effective_evidence
  datatype source_effective_cut_block = SECutBlock of
    {work:W.portfolio,block:block,frame:Scope.receipt,
     receipts:source_effective_evidence list,
     slot_origins:(int * source_origin) list,
     rows:(source_effective_evidence * int * int list) list}
  fun effective_owner(SEOriginal(SourceRealization{work,...}))=work
    | effective_owner(SEGeneralized(SGEffective{plan=SGPlan{work,...},...}))=
        work
    | effective_owner(SEChecked{work,...})=work
    | effective_owner(SEScoped{work,...})=work
    | effective_owner(SEFurtherGEN{work,...})=work
    | effective_owner(SENormalized{work,...})=work
  fun effective_source_guard expected evidence=
    effective_source_guard_observing
      (fn _=>fn theorem=>(Thm.concl theorem,Thm.hyp theorem,clean theorem))
      expected evidence
  and effective_source_guard_observing observe expected evidence=
    sr_fail expected(fn()=>
    (if Portable.pointer_eq(expected,effective_owner evidence) then () else
       raise ERR "effective_source_guard" "foreign expected Work";
     case evidence of SEOriginal receipt=>
       source_realization_guard expected receipt
     | SEGeneralized(SGEffective{plan,proof,rows,...})=>
         (sg_guard expected plan;
          if clean proof andalso List.all(fn hyp=>
              List.exists(fn(_,row)=>Term.aconv hyp row)rows)(Thm.hyp proof)
            then () else raise ERR "effective_source_guard"
              "effective GEN proof or named Hyp changed")
     | SEChecked{source_frame,graph,root,scope,frame,original_sources,target,
         occurrences,origins,theorem,block=Block{owner,owned_frame,
           graph=held_graph,scope=held_scope,...},
         edge=Edge{owner=edge_owner,...},
         named_target,named_proof,held,facts,conversions,template_limit,
         parents,epoch,symbols,...}=>
       let val _=retained_source_guard expected source_frame
           val data=Scope.description_for expected frame
           val _=if Portable.pointer_eq(owner,edge_owner) andalso
               Portable.pointer_eq(graph,held_graph) andalso scope=held_scope
               andalso Portable.pointer_eq(graph,#graph data) andalso
               root= #root data andalso scope= #scope data andalso
               Portable.pointer_eq(original_sources,#sources data) andalso
               #template_limit(W.semantic_limits expected)=template_limit
               andalso Type.type_epoch()=epoch andalso
               Term.term_epoch()=symbols then () else raise ERR
             "effective_source_guard" "genuine effective frame changed"
           val _=case owned_frame of SOME(work,held_frame)=>
                 if Portable.pointer_eq(expected,work) andalso
                     Portable.pointer_eq(frame,held_frame) then () else
                   raise ERR "effective_source_guard" "compact owner changed"
             | NONE=>raise ERR "effective_source_guard" "unowned compact proof"
           val _=if clean named_proof andalso
               Term.aconv(Thm.concl named_proof)named_target andalso
               List.map #1 occurrences=List.map #1 origins then () else
             raise ERR "effective_source_guard"
               "compact endpoint/origins changed"
           val _=List.app(fn child=>ignore
             (G.closure_child_node graph scope child))held
           val _=List.app(validate_closed_fact graph scope template_limit)facts
           val _=List.app(validate_conversion_for expected)conversions
           val _=List.app(effective_source_guard expected)parents
           val(conclusion,hypotheses,clean_result)=observe evidence theorem
       in if clean_result andalso Portable.pointer_eq(conclusion,
           G.representative graph target) andalso List.all(fn hyp=>
             List.exists(fn(_,node)=>Portable.pointer_eq(hyp,
               G.representative graph node))occurrences)hypotheses
         then () else raise ERR "effective_source_guard"
           "actual effective endpoint, Hyp or tags changed" end
     | SEScoped{parent,hypothesis,target,native_hypothesis,proof,rows,parents,
         realized,...}=>
       let val _=effective_source_guard expected parent
           val _=List.app(effective_source_guard expected)parents
           fun backing(SEOriginal(SourceRealization{graph,scope,...}))=
                 (graph,scope)
             | backing(SEGeneralized(SGEffective{plan=SGPlan
                 {source=SourceRealization{graph,scope,...},...},...}))=
                 (graph,scope)
             | backing(SEChecked{graph,scope,...})=(graph,scope)
             | backing(SEScoped{parent,...})=backing parent
             | backing(SEFurtherGEN{parent,...})=backing parent
             | backing(SENormalized{parent,...})=backing parent
           val(graph,scope)=backing parent
           val _=ignore(G.closure_root graph scope target)
           val _=ignore(G.closure_root graph scope hypothesis)
           fun row(_,_,kind)=case kind of
               ESCut held=>effective_source_guard expected held
             | ESFact fact=>validate_closed_fact graph scope
                 (#template_limit(W.semantic_limits expected))fact
             | ESConversion conversion=>
                 validate_conversion_for expected conversion
             | _=>()
           val _=List.app row rows
           fun native(SEOriginal(SourceRealization{compact=SourceCompact
                 {proof,...},...}))=Thm.concl proof
             | native(SEGeneralized(SGEffective{proof,...}))=Thm.concl proof
             | native(SEChecked{named_target,...})=named_target
             | native(SEScoped{proof,...})=Thm.concl proof
             | native(SEFurtherGEN{proof,...})=Thm.concl proof
             | native(SENormalized{proof,...})=Thm.concl proof
           val(left,right)=if boolSyntax.is_imp_only(Thm.concl proof) then
               boolSyntax.dest_imp_only(Thm.concl proof) else raise ERR
                 "effective_source_guard" "missing native Scope implication"
           val _=if Term.aconv left native_hypothesis andalso
               Term.aconv right(native parent) then () else raise ERR
             "effective_source_guard" "native Scope endpoint changed"
           val _=case !realized of NONE=>() | SOME theorem=>
             if clean theorem andalso Portable.pointer_eq(Thm.concl theorem,
                 G.representative graph target) andalso
                 not(List.exists(fn hyp=>Portable.pointer_eq(hyp,
                   G.representative graph hypothesis))(Thm.hyp theorem))
               then () else raise ERR "effective_source_guard"
                 "cached actual Scope endpoint or Hyp changed"
       in if clean proof andalso List.all(fn hyp=>
           List.exists(fn(_,native,_)=>Term.aconv hyp native)rows)
             (Thm.hyp proof) then () else raise ERR
         "effective_source_guard" "scoped native Hyp or tags changed"end
     | SEFurtherGEN{parent,target,opened,proof,rows,realized,...}=>
       let val _=effective_source_guard expected parent
           fun backing(SEOriginal(SourceRealization{graph,scope,...}))=
                 (graph,scope)
             | backing(SEGeneralized(SGEffective{plan=SGPlan
                 {source=SourceRealization{graph,scope,...},...},...}))=
                 (graph,scope)
             | backing(SEChecked{graph,scope,...})=(graph,scope)
             | backing(SEScoped{parent,...})=backing parent
             | backing(SEFurtherGEN{parent,...})=backing parent
             | backing(SENormalized{parent,...})=backing parent
           val(graph,scope)=backing parent
           val _=G.validate_opened_view graph scope target opened
           val _=case !realized of NONE=>() | SOME theorem=>
             if clean theorem andalso Portable.pointer_eq(Thm.concl theorem,
                 G.representative graph target)then () else raise ERR
               "effective_source_guard" "cached effective GEN changed"
       in if clean proof andalso Portable.pointer_eq(Thm.concl proof,
           G.representative graph target) andalso List.all(fn hyp=>
             List.exists(fn(_,row)=>Term.aconv hyp row)rows)(Thm.hyp proof)
         then () else raise ERR "effective_source_guard"
           "effective generic GEN endpoint, Hyp or tags changed"end
     | SENormalized{parent,target,opened,origin,proof,rows,realized,...}=>
       let val _=effective_source_guard expected parent
           fun backing(SEOriginal(SourceRealization{graph,scope,...}))=
                 (graph,scope)
             | backing(SEGeneralized(SGEffective{plan=SGPlan
                 {source=SourceRealization{graph,scope,...},...},...}))=
                 (graph,scope)
             | backing(SEChecked{graph,scope,...})=(graph,scope)
             | backing(SEScoped{parent,...})=backing parent
             | backing(SEFurtherGEN{parent,...})=backing parent
             | backing(SENormalized{parent,...})=backing parent
           val(graph,scope)=backing parent
           val _=G.validate_opened_view graph scope target opened
           val _=case origin of NONE=>() | SOME held=>
             (case G.source_anchor graph target of
               SOME actual=>if #node held= #node actual andalso
                   Portable.pointer_eq(#original held,#original actual)
                   andalso Portable.pointer_eq(#bridge held,#bridge actual)
                 then ()else raise ERR "effective_source_guard"
                   "normalized Original origin changed"
             | NONE=>raise ERR "effective_source_guard"
                 "normalized Original origin disappeared")
           val _=case !realized of NONE=>() | SOME theorem=>
             if clean theorem andalso Portable.pointer_eq(Thm.concl theorem,
                 G.representative graph target)then () else raise ERR
               "effective_source_guard" "cached normalized clause changed"
       in if clean proof andalso Portable.pointer_eq(Thm.concl proof,
           G.representative graph target) andalso List.all(fn hyp=>
             List.exists(fn(_,row)=>Term.aconv hyp row)rows)(Thm.hyp proof)
         then () else raise ERR "effective_source_guard"
           "effective normalized clause endpoint, Hyp or tags changed"end
))
  fun effective_data expected evidence=
    (effective_source_guard expected evidence;
     case evidence of SEOriginal(SourceRealization
         {graph,root,scope,frame,original_sources,target,occurrences,origins,
          template_limit,...})=>
         {graph=graph,root=root,scope=scope,frame=frame,
          original_sources=original_sources,target=target,
          occurrences=occurrences,origins=origins,
          template_limit=template_limit}
       | SEGeneralized(SGEffective{plan=SGPlan{source,...},target,
           discharged,...})=>
         let val SourceRealization
               {graph,root,scope,frame,original_sources,occurrences,origins,
                template_limit,...}=source
             val keep=ListPair.zip(occurrences,origins)
             val keep=List.filter(fn((_,node),_)=>
               not(List.exists(fn held=>held=node)discharged))keep
         in {graph=graph,root=root,scope=scope,frame=frame,
           original_sources=original_sources,target=target,
           occurrences=List.map #1 keep,origins=List.map #2 keep,
           template_limit=template_limit} end
       | SEChecked{graph,root,scope,frame,original_sources,target,
           occurrences,origins,template_limit,...}=>
         {graph=graph,root=root,scope=scope,frame=frame,
          original_sources=original_sources,target=target,
          occurrences=occurrences,origins=origins,
          template_limit=template_limit}
       | SEScoped{parent,hypothesis,target,...}=>
         let val data=effective_data expected parent
             val keep=List.filter(fn((_,node),_)=>node<>hypothesis)
               (ListPair.zip(#occurrences data,#origins data))
         in {graph= #graph data,root= #root data,scope= #scope data,
           frame= #frame data,original_sources= #original_sources data,
           target=target,occurrences=List.map #1 keep,
           origins=List.map #2 keep,template_limit= #template_limit data}end
       | SEFurtherGEN{parent,target,...}=>
         let val data=effective_data expected parent
         in {graph= #graph data,root= #root data,scope= #scope data,
           frame= #frame data,original_sources= #original_sources data,
           target=target,occurrences= #occurrences data,origins= #origins data,
           template_limit= #template_limit data}end
       | SENormalized{parent,target,...}=>
         let val data=effective_data expected parent
         in {graph= #graph data,root= #root data,scope= #scope data,
           frame= #frame data,original_sources= #original_sources data,
           target=target,occurrences= #occurrences data,origins= #origins data,
           template_limit= #template_limit data}end
)
  fun effective_source_for_receipt expected receipt=
    (source_realization_guard expected receipt;SEOriginal receipt)
  fun effective_source_for_generalization expected generalized=
    let val result=SEGeneralized generalized
    in effective_source_guard expected result;result end
  fun effective_source_data_for expected evidence=
    let val data=effective_data expected evidence
    in {graph= #graph data,root= #root data,scope= #scope data,
      frame= #frame data,original_sources= #original_sources data,
      target= #target data,source_occurrences= #occurrences data,
      template_limit= #template_limit data} end
  (* Exact lazy Hyp data is inherited from the authentic original proof.
     A Source occurrence portfolio alone is never taken as the actual Hyp. *)
  fun effective_actual_hyp expected evidence=
    (effective_source_guard expected evidence;
     case evidence of SEOriginal(SourceRealization{theorem,...})=>
         Thm.hyp theorem
       | SEChecked{theorem,...}=>Thm.hyp theorem
       | SEGeneralized(SGEffective{plan=SGPlan{source=SourceRealization
           {graph,theorem,...},...},discharged,...})=>
           List.filter(fn hyp=>not(List.exists(fn node=>
             Portable.pointer_eq(hyp,G.representative graph node))
               discharged))(Thm.hyp theorem)
       | SEFurtherGEN{parent,...}=>effective_actual_hyp expected parent
       | SENormalized{parent,...}=>effective_actual_hyp expected parent
       | SEScoped{parent,hypothesis,...}=>
           let fun graph_of(SEOriginal(SourceRealization{graph,...}))=graph
                 | graph_of(SEChecked{graph,...})=graph
                 | graph_of(SEGeneralized(SGEffective{plan=SGPlan
                     {source=SourceRealization{graph,...},...},...}))=graph
                 | graph_of(SEScoped{parent,...})=graph_of parent
                 | graph_of(SEFurtherGEN{parent,...})=graph_of parent
                 | graph_of(SENormalized{parent,...})=graph_of parent
               val value=G.representative(graph_of parent)hypothesis
           in List.filter(fn hyp=>not(Portable.pointer_eq(hyp,value)))
             (effective_actual_hyp expected parent)end)
  fun effective_actual_tag expected evidence=
    (effective_source_guard expected evidence;
     case evidence of SEOriginal(SourceRealization{theorem,...})=>
         Thm.tag theorem
       | SEChecked{theorem,...}=>Thm.tag theorem
       | SEGeneralized(SGEffective{plan=SGPlan{source=SourceRealization
           {theorem,...},...},...})=>Thm.tag theorem
       | SEFurtherGEN{parent,...}=>effective_actual_tag expected parent
       | SENormalized{parent,...}=>effective_actual_tag expected parent
       | SEScoped{parent,...}=>effective_actual_tag expected parent)
  fun effective_source_theorem_for expected evidence=
    (effective_source_guard expected evidence;
     case evidence of SEOriginal receipt=>
       source_realization_theorem_for expected receipt
     | SEGeneralized generalized=>
       source_selective_generalization_theorem_for expected generalized
     | SEChecked{theorem,...}=>theorem
     | value as SEScoped{parent,hypothesis,target,proof,names,rows,
         realized,...}=>
       (case !realized of SOME theorem=>theorem | NONE=>
        let val data=effective_data expected parent
            val graph= #graph data
            fun cut(index,_,ESCut held)=
                  SOME(index,effective_source_theorem_for expected held)
              | cut _=NONE
            (* All authentic lazy cut proofs own their actions first. *)
            val completed=List.mapPartial cut rows
        in W.with_step expected(fn()=>
          let
            fun guarded action=
              (effective_source_guard expected value;
               let val result=action()
               in effective_source_guard expected value;result end)
            val _=W.spend expected (1+length rows+length names)
            val law=List.foldr(fn((_,native,_),theorem)=>guarded(fn()=>
              SmtReplayRuleObservation.DISCH native theorem))proof rows
            val _=if null(Thm.hyp law) then () else raise ERR
              "effective_source_theorem_for" "scoped native law not closed"
            val sigma=List.map(fn(node,variable)=>
              {redex=variable,residue=G.representative graph node})names
            val actual=guarded(fn()=>SmtReplayRuleObservation.INST sigma law)
            fun witness(index,_,kind)=case kind of
                ESSource node=>SmtReplayRuleObservation.ASSUME
                  (G.representative graph node)
              | ESDefinition(node,rhs)=>SmtReplayRuleObservation.ALPHA
                  (G.representative graph node)(Term.subst sigma rhs)
              | ESFact fact=>closed_proof fact
              | ESConversion conversion=>conversion_proof conversion
              | ESCut _=>case List.find(fn(slot,_)=>slot=index)completed of
                  SOME(_,theorem)=>theorem | NONE=>raise ERR
                    "effective_source_theorem_for" "missing scoped cut proof"
            val result=List.foldl(fn(row,theorem)=>guarded(fn()=>
              SmtReplayRuleObservation.MP theorem(witness row)))actual rows
            val wanted=G.representative graph target
            val result=if Portable.pointer_eq(Thm.concl result,wanted) then
                result else guarded(fn()=>SmtReplayRuleObservation.EQ_MP
                  (SmtReplayRuleObservation.ALPHA(Thm.concl result)wanted)
                  result)
            val wanted_hyp=effective_actual_hyp expected value
            val wanted_tag=effective_actual_tag expected parent
            val _=if Portable.pointer_eq(Thm.concl result,wanted) andalso
                clean result andalso ListPair.allEq Portable.pointer_eq
                  (Thm.hyp result,wanted_hyp) andalso
                #1(Tag.dest_tag(Thm.tag result))= #1(Tag.dest_tag wanted_tag)
              then () else raise ERR "effective_source_theorem_for"
                "scoped actual endpoint, Hyp or tags changed"
            val _=realized:=SOME result
          in result end)
        end)
     | value as SEFurtherGEN{parent,target,proof,names,rows,
         realized,...}=>
       (case !realized of SOME theorem=>theorem | NONE=>
        let val data=effective_data expected parent val graph= #graph data
        in W.with_step expected(fn()=>
          let fun guarded action=
                (effective_source_guard expected value;
                 let val result=action()
                 in effective_source_guard expected value;result end)
              val _=W.spend expected (1+length names+length rows)
              val law=List.foldr(fn((_,row),theorem)=>guarded(fn()=>
                SmtReplayRuleObservation.DISCH row theorem))proof rows
              val _=if null(Thm.hyp law) then () else raise ERR
                "effective_source_theorem_for" "generic GEN law not closed"
              val sigma=List.map(fn(node,variable)=>
                {redex=variable,residue=G.representative graph node})names
              val actual=guarded(fn()=>SmtReplayRuleObservation.INST sigma law)
              val actual=List.foldl(fn((node,_),theorem)=>guarded(fn()=>
                SmtReplayRuleObservation.MP theorem
                  (SmtReplayRuleObservation.ASSUME
                    (G.representative graph node))))actual rows
              val wanted=G.representative graph target
              val actual=if Portable.pointer_eq(Thm.concl actual,wanted)then
                  actual else guarded(fn()=>SmtReplayRuleObservation.EQ_MP
                    (SmtReplayRuleObservation.ALPHA(Thm.concl actual)wanted)
                    actual)
              val expected_hyp=effective_actual_hyp expected parent
              val expected_tag=effective_actual_tag expected parent
              val _=if clean actual andalso
                  Portable.pointer_eq(Thm.concl actual,wanted) andalso
                  ListPair.allEq Portable.pointer_eq
                    (Thm.hyp actual,expected_hyp) andalso
                  #1(Tag.dest_tag(Thm.tag actual))=
                    #1(Tag.dest_tag expected_tag) then () else raise ERR
                "effective_source_theorem_for"
                "generic GEN actual endpoint, Hyp or tags changed"
              val _=realized:=SOME actual
          in actual end)
        end)
     | value as SENormalized{parent,target,proof,names,rows,
         realized,...}=>
       (case !realized of SOME theorem=>theorem | NONE=>
        let val data=effective_data expected parent val graph= #graph data
        in W.with_step expected(fn()=>
          let fun guarded action=
                (effective_source_guard expected value;
                 let val result=action()
                 in effective_source_guard expected value;result end)
              val _=W.spend expected (1+length names+length rows)
              val law=List.foldr(fn((_,row),theorem)=>guarded(fn()=>
                SmtReplayRuleObservation.DISCH row theorem))proof rows
              val _=if null(Thm.hyp law) then () else raise ERR
                "effective_source_theorem_for"
                "normalized clause law not closed"
              val sigma=List.map(fn(node,variable)=>
                {redex=variable,residue=G.representative graph node})names
              val actual=guarded(fn()=>SmtReplayRuleObservation.INST sigma law)
              val actual=List.foldl(fn((node,_),theorem)=>guarded(fn()=>
                SmtReplayRuleObservation.MP theorem
                  (SmtReplayRuleObservation.ASSUME
                    (G.representative graph node))))actual rows
              val wanted=G.representative graph target
              val actual=if Portable.pointer_eq(Thm.concl actual,wanted)then
                  actual else guarded(fn()=>SmtReplayRuleObservation.EQ_MP
                    (SmtReplayRuleObservation.ALPHA(Thm.concl actual)wanted)
                    actual)
              val expected_hyp=effective_actual_hyp expected parent
              val expected_tag=effective_actual_tag expected parent
              val _=if clean actual andalso
                  Portable.pointer_eq(Thm.concl actual,wanted) andalso
                  ListPair.allEq Portable.pointer_eq
                    (Thm.hyp actual,expected_hyp) andalso
                  #1(Tag.dest_tag(Thm.tag actual))=
                    #1(Tag.dest_tag expected_tag) then () else raise ERR
                "effective_source_theorem_for"
                "normalized clause actual endpoint, Hyp or tags changed"
              val _=realized:=SOME actual
          in actual end)
        end)
)
  fun effective_origin_equal(ActualSourceSlot(a,i),ActualSourceSlot(b,j))=
        Portable.pointer_eq(a,b) andalso i=j
    | effective_origin_equal
        (OriginalPrefixSlot(a,i),OriginalPrefixSlot(b,j))=
        Portable.pointer_eq(a,b) andalso i=j
    | effective_origin_equal _=false
  fun effective_cut_guard expected
      (SECutBlock{work,block,frame,receipts,slot_origins,rows})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work) then () else
         raise ERR "effective_cut_guard" "foreign expected Work";
       List.app(effective_source_guard expected)receipts;
       ignore(Scope.description_for expected frame);
       validate_block_for expected block;
       let val actual=Vector.fromList(sources block)
           fun origin slot=case List.find(fn(index,_)=>index=slot)
               slot_origins of SOME(_,key)=>key | NONE=>raise ERR
                 "effective_cut_guard" "missing genuine Source origin"
           fun row(receipt,index,supports)=
             let val data=effective_data expected receipt
             in if Vector.sub(actual,index)= #target data andalso
                 ListPair.allEq(fn((_,node),slot)=>
                   node=Vector.sub(actual,slot)) (#occurrences data,supports)
                 andalso ListPair.allEq(fn((_,key),slot)=>
                   effective_origin_equal(key,origin slot))
                   (#origins data,supports) then () else raise ERR
               "effective_cut_guard" "authentic cut target/support changed" end
       in List.app row rows end))
  fun effective_source_cut_block_for expected
      (value as SECutBlock{block,...})=
    (effective_cut_guard expected value;block)

  fun prepare_effective_source_cut_rule_block expected
      {frame,roots,additional_sources,closed_facts,conversions,receipts,
       targets,boolean,congruence} =
    ((List.app (effective_source_guard expected) receipts;
      let
        val data = Scope.description_for expected frame
        val graph = #graph data and scope = #scope data
        val cap = #template_limit (W.semantic_limits expected)
        val (frontier,rows,slot_origins) = W.with_step expected (fn () =>
          let
            val _ = List.app (effective_source_guard expected) receipts
            fun pay n = W.spend expected n
            val _ = List.app (validate_conversion_for expected) conversions
            val _ = List.app
              (validate_conversion graph scope cap) conversions
            val _ = List.app
              (validate_closed_fact graph scope cap) closed_facts
            fun valid node =
              (pay 3;
               if G.scope_visible graph scope (G.node_scope graph node)
                 then () else raise ERR
                      "prepare_effective_source_cut_rule_block"
                   "Source operand outside actual frame";
               ignore (G.view graph node);
               if Type.compare (G.type_of graph node,Type.bool) = EQUAL
                 then node else raise ERR
                   "prepare_effective_source_cut_rule_block"
                   "Source operand is not Boolean")
            val prefix = List.map valid
              (SmtReplaySource.assumption_nodes (#sources data) @
               [SmtReplaySource.denied_goal_node (#sources data)])
            val extras = List.map valid additional_sources
            val _ = pay 1
            val extra_owner = ref ()
            val prefix_count = List.length prefix
            val base_count = prefix_count + List.length extras
            fun original_origins _ [] = []
              | original_origins index (node::rest) =
                  (pay 3;(OriginalPrefixSlot (#sources data,index),
                    node,index)::original_origins (index+1) rest)
            fun extra_origins _ [] = []
              | extra_origins index (node::rest) =
                  (pay 3;(ActualSourceSlot (extra_owner,index),node,index)::
                    extra_origins (index+1) rest)
            val initial = original_origins 0 prefix @
              extra_origins prefix_count extras
            val assigned = ref initial
            val appended = ref ([] : G.node list)
            val next = ref base_count
            fun equal (ActualSourceSlot (a,i),ActualSourceSlot (b,j)) =
                  Portable.pointer_eq (a,b) andalso i=j
              | equal (OriginalPrefixSlot (a,i),OriginalPrefixSlot (b,j)) =
                  Portable.pointer_eq (a,b) andalso i=j
              | equal _ = false
            fun reserve key node =
              let
                fun seek [] = (pay 1;NONE)
                  | seek ((old,actual,index)::rest) =
                      (pay 1;if equal (key,old) then
                         if actual=node then SOME index else
                           raise ERR "prepare_effective_source_cut_rule_block"
                             "shared occurrence changed actual Source node"
                       else seek rest)
              in case seek (!assigned) of SOME index => index
                | NONE =>
                  let val index = !next
                      val _ = pay 5
                      val _ = next := index+1
                      val _ = assigned := (key,node,index):: !assigned
                      val _ = appended := node :: !appended
                  in index end
              end
            fun retain [] = []
              | retain (receipt::rest) =
                let
                  val _ = effective_source_guard expected receipt
                  val actual = effective_data expected receipt
                  val target = #target actual
                  val occurrences = #occurrences actual
                  val origins = #origins actual
                  val held_graph = #graph actual
                  val original_sources = #original_sources actual
                  val _ = if Portable.pointer_eq (graph,held_graph) andalso
                      Portable.pointer_eq (#sources data,original_sources)
                    then () else raise ERR
                      "prepare_effective_source_cut_rule_block"
                      "different original Source portfolio"
                  val supports = ListPair.mapEq
                    (fn ((_,node),(_,key)) => reserve key (valid node))
                    (occurrences,origins)
                  val _ = valid target
                  val index = !next
                  val _ = pay 3
                  val _ = next := index+1
                  val _ = appended := target :: !appended
                in (receipt,index,supports)::retain rest end
            val rows = retain receipts
            val promoted = List.rev (!appended)
            val sources = prefix @ extras @ promoted
            val slot_origins = List.map (fn (key,_,index) =>
              (pay 2;(index,key))) (!assigned)
            (* Derive constructor authority from the SAME actual receipt.
               The application spine is concrete; argument holes are the
               exact recorded nodes, not arbitrary caller cut metadata. *)
            val spine_paths = ref ([] : G.closure_child list)
            fun node_spine target =
              let
                fun hold node =
                  (pay 3;spine_paths := G.closure_root graph scope node ::
                    !spine_paths)
                fun walk node =
                  let val _ = hold node
                  in case G.view graph node of G.Application (a,b) =>
                    let val _ = hold b
                        val (operators,arguments) = walk a
                    in (node::operators,b::arguments) end
                  | G.Constant _ => ([node],[])
                  | G.Variable _ => ([node],[])
                  | _ => ([],[node]) end
              in walk target end
            fun receipt_spine receipt =
              (effective_source_guard expected receipt;
               node_spine (#target (effective_data expected receipt)))
            fun arguments node operands =
              (pay 2;ignore (G.closure_root graph scope node);
               case G.view graph node of G.Application (operator,operand) =>
                   arguments operator (operand::operands)
                 | G.Constant _ =>
                     SOME (G.representative graph node,operands)
                 | _ => NONE)
            (* This is exactly the concrete Boolean gate grammar used by
               the checked Boolean assembler, not semantic atom guessing. *)
            fun gate node = case arguments node [] of NONE => NONE
              | SOME (head,operands) =>
                let val arity = List.length operands
                    fun constant wanted = Term.same_const head wanted
                    val connective =
                      (arity=0 andalso (constant boolSyntax.T orelse
                        constant boolSyntax.F)) orelse
                      (arity=1 andalso constant boolSyntax.negation) orelse
                      (arity=2 andalso (constant boolSyntax.conjunction
                        orelse constant boolSyntax.disjunction orelse
                        constant boolSyntax.implication orelse
                        constant boolSyntax.equality)) orelse
                      (arity=3 andalso constant boolSyntax.conditional)
                    fun boolean node =
                      (pay 1;Type.compare
                        (G.type_of graph node,Type.bool)=EQUAL)
                in if connective andalso List.all boolean operands
                  then SOME operands else NONE end
            val gate_done = ref ([] : G.node list)
            fun seen node [] = (pay 1;false)
              | seen node (old::rest) =
                  (pay 1;node=old orelse seen node rest)
            fun gates node =
              let val _ = pay 2
                  val _ = ignore (G.closure_root graph scope node)
              in if seen node (!gate_done) then [] else
                (pay 2;gate_done := node :: !gate_done;
                 case gate node of NONE => [([],[node])]
                 | SOME operands => node_spine node ::
                     List.concat (List.map gates operands)) end
            val actual_targets = List.map valid targets
            val target_anchors = if boolean then [] else
              List.map (fn node => node_spine node) actual_targets
            val relation_roots = actual_targets @
              List.map (fn receipt =>
                #target (effective_data expected receipt)) receipts
            fun equation node = case arguments node [] of
                SOME (head,[left,right]) =>
                  if Term.same_const head boolSyntax.equality then
                    SOME (left,right) else NONE
              | _ => NONE
            val known_pairs = List.mapPartial equation
              (List.map (fn receipt =>
                #target (effective_data expected receipt)) receipts)
            val pairs_done = ref ([] : (G.node * G.node) list)
            fun same_pair (left,right) (a,b) =
              (left=a andalso right=b) orelse (left=b andalso right=a)
            fun proved pair = List.exists (fn old =>
              (pay 1;same_pair pair old)) known_pairs
            fun pair (left,right) =
              let val _ = pay 4
                  val _ = ignore (G.closure_root graph scope left)
                  val _ = ignore (G.closure_root graph scope right)
              in if left=right orelse proved (left,right) orelse
                  List.exists (fn old =>
                    (pay 1;same_pair (left,right) old)) (!pairs_done) then []
                else
                  (pay 2;pairs_done := (left,right) :: !pairs_done;
                   case (G.view graph left,G.view graph right) of
                     (G.Application (f,x),G.Application (g,y)) =>
                       ([left,right],[f,x,g,y]) :: (pair (f,g) @ pair (x,y))
                   | _ => []) end
            val congruence_spines = if congruence then List.concat
              (List.map (fn node => case equation node of
                 SOME operands => pair operands | NONE => []) actual_targets)
              else []
            val spines = List.map receipt_spine receipts @
              (if boolean then List.concat (List.map gates relation_roots)
               else []) @
              List.map node_spine (List.filter (fn node =>
                Option.isSome (equation node)) relation_roots) @
              target_anchors @ congruence_spines
            val constructor_roots = List.concat (List.map #1 spines)
            val cut_targets = List.concat (List.map #2 spines)
            (* The original prefix and inherited supports are authentic
               Source occurrences, not independent constructor demands.
               Their authority comes from this SAME Scope Source portfolio
               and the exact parent receipts validated above. Caller extras
               remain ordinary, as do facts, conversions and explicit roots.
               Constructor spines still dominate a retained Source atom. *)
            val facts = List.map (fn fact => (pay 1;closed_node fact))
              closed_facts
            val conversion_roots = List.concat (List.map (fn conversion =>
              (pay 3;[conversion_source conversion,
                conversion_target conversion])) conversions)
            val support_roots = List.concat (List.map
              (fn receipt =>
                List.map (fn (_,node) => (pay 1;node))
                  (#occurrences (effective_data expected receipt))) receipts)
            fun member node [] = false
              | member node (old::rest) =
                  (pay 1;node = old orelse member node rest)
            (* Descendant ordinary demand is also dominant. This walk is
               paid on SAME Work and starts ONLY from actual independent
               roots, never from the original occurrence inventory. *)
            val ordinary = ref ([] : G.node list)
            val ordinary_paths = ref ([] : G.closure_child list)
            fun demand [] = ()
              | demand (node::rest) =
                (pay 1;
                 ordinary_paths := G.closure_root graph scope node ::
                   !ordinary_paths;
                 if member node (!ordinary) then demand rest else
                   (pay 2;ordinary := node :: !ordinary;
                    case G.view graph node of G.Application (a,b) =>
                        (demand [a,b];demand rest)
                      | _ => demand rest))
            val _ = demand (extras @ facts @ conversion_roots @ roots)
            val demanded = !ordinary @ constructor_roots
            val retained_atoms = prefix @ support_roots @ cut_targets
            (* These fixed inventories contain only this graph's validated
               Sources or genuine children of checked constructor spines.
               Keep their lists for traversal order; index membership once.
               Each query still passes the existing Scope/owner check below
               before its node ID is used. Duplicate IDs have unit payloads. *)
            val retained_index = fixed_table expected retained_atoms
              G.node_id (fn _ => ())
            val demanded_index = fixed_table expected demanded
              G.node_id (fn _ => ())
            fun indexed_member table node =
              Option.isSome (table_peek (table,G.node_id node))
            val seen = ref ([] : G.node list)
            val atoms = ref ([] : G.node list)
            fun visit [] = ()
              | visit (node::rest) =
                (pay 1;if member node (!seen) then visit rest else
                 let
                   val _ = pay 2
                   val _ = seen := node :: !seen
                   val _ = if G.scope_visible graph scope
                       (G.node_scope graph node) then () else
                     raise ERR "prepare_effective_source_cut_rule_block"
                       "node escaped frame"
                   val cut = indexed_member retained_index node andalso
                     not (indexed_member demanded_index node)
                   val children = if cut then
                       (pay 2;atoms := node :: !atoms;[]) else
                     case G.view graph node of
                       G.Application (a,b) => [a,b] | _ => []
                 in visit children;visit rest end)
            val _ = visit (sources @ cut_targets @ demanded)
            fun reverse [] answer = answer
              | reverse (node::rest) answer =
                  (pay 2;reverse rest (node::answer))
            val reachable = reverse (!seen) []
            val held = !ordinary_paths @ !spine_paths @ List.map (fn node =>
              (pay 2;G.closure_root graph scope node)) reachable
            val frontier = RealizationFrontier
              {work = expected,graph = graph,scope = scope,frame = frame,
               template_limit = cap,epoch = Type.type_epoch (),
               symbols = Term.term_epoch (),roots = roots,sources = sources,
               closed_facts = closed_facts,conversions = conversions,
               reachable = reachable,atoms = reverse (!atoms) [],
               held = held,retained_sources = NONE}
            val _ = List.app (effective_source_guard expected) receipts
            val _ = frontier_guard expected frontier
          in (frontier,rows,slot_origins) end)
        val tables = W.with_step expected (fn () =>
          (List.app (effective_source_guard expected) receipts;
           prepare_owned_realization_tables expected frontier))
        val block = W.with_step expected (fn () =>
          (List.app (effective_source_guard expected) receipts;
           freeze_owned_needed_realization_tables_plan expected tables))
        val result = SECutBlock {work = expected,block = block,
          frame = frame,receipts = receipts,slot_origins = slot_origins,
          rows = rows}
        val _ = effective_cut_guard expected result
      in result end)
     handle primary => (W.close expected;raise primary))

  fun effective_source_cut_edge_for expected
      (value as SECutBlock {block,rows,...}) receipt =
    ((effective_cut_guard expected value;
      W.with_step expected (fn () =>
      let
        val _ = effective_cut_guard expected value
        val row = case List.find (fn (held,_,_) =>
            Portable.pointer_eq (held,receipt)) rows of SOME row => row
          | NONE => raise ERR "effective_source_cut_edge_for"
              "receipt was not reserved in this exact block"
        val (actual,index,_) = row
        val target = #target (effective_data expected actual)
        val supports = List.concat (List.map
          (fn (receipt,_,slots) =>
            if target = #target (effective_data expected receipt)
              then slots else []) rows)
        val edge = source block index
        val Block {template_limit,...} = block
        (* Keep each genuine support dependency even if the kernel theorem
           merges pointer-identical Hyp. Quote named future rules first. *)
        fun retain (slot,result) =
          let
            val support = source block slot
            val left = Thm.concl (theorem block result)
            val right = Thm.concl (theorem block support)
            val _ = owned_sparse_projection_quote expected template_limit
              (Vector.fromList [left,right])
            fun size count term = case count template_limit term of
                SOME value => value
              | NONE => raise ERR "effective_source_cut_edge_for"
                  "named support exceeds original cap"
            val raw = 3 + size SmtReplayImport.bounded_raw_size left +
              size SmtReplayImport.bounded_raw_size right
            val inclusive = 3 +
              size SmtReplayImport.bounded_binder_size left +
              size SmtReplayImport.bounded_binder_size right
            val _ = if raw <= template_limit andalso
                inclusive <= template_limit then () else
              raise ERR "effective_source_cut_edge_for"
                "future support conjunction exceeds original cap"
            val _ = W.spend expected raw
            val _ = W.spend expected inclusive
            val future = boolSyntax.mk_conj (left,right)
            val _ = owned_sparse_projection_quote expected template_limit
              (Vector.fromList [future])
            val joined = compose block
              (fn [a,b] => SmtReplayRuleObservation.CONJ a b
                | _ => raise ERR "effective_source_cut_edge_for"
                    "internal arity")
              [result,support]
          in compose block
            (fn [proof] => SmtReplayRuleObservation.CONJUNCT1 proof
              | _ => raise ERR "effective_source_cut_edge_for"
                    "internal arity")
            [joined] end
        val result = List.foldl retain edge supports
        val _ = effective_cut_guard expected value
      in result end))
     handle primary => (W.close expected;raise primary))

  fun realize_effective_source_cut_receipt expected
      (value as SECutBlock {block,receipts,rows,slot_origins,...})
      target edge =
    let
      val _ = effective_cut_guard expected value
      val Block {graph,scope,leaves,nodes,template_limit,owned_frame,
                       leaf_index,owned_names,...} = block
    in ((validate_block_for expected block;
      (* Fence the supplied edge and target before activating any parent.
         Each authentic lazy parent owns its action outside this cut action. *)
      ignore (theorem block edge);
      ignore (G.closure_root graph scope target);
      let
        val actual_parents = List.map (fn receipt =>
          (effective_source_guard expected receipt;
           let val proof = effective_source_theorem_for expected receipt
               val _ = effective_source_guard expected receipt
           in (receipt,proof) end)) receipts
        fun held_parent receipt =
          (effective_source_guard expected receipt;
           let val proof = case List.find (fn (held,_) =>
                 Portable.pointer_eq (held,receipt)) actual_parents of
                   SOME (_,proof) => proof | NONE => raise ERR
                     "realize_effective_source_cut_receipt"
                     "missing authentic completed parent"
               val _ = effective_source_guard expected receipt
           in proof end)
      in W.with_step expected (fn () =>
      let
        val _ = effective_cut_guard expected value
        val frame = case owned_frame of SOME (_,frame) => frame
          | NONE => raise ERR "realize_effective_source_cut_receipt"
              "unowned block"
        val data = Scope.description_for expected frame
        val _ = if Option.isSome leaf_index then () else
          raise ERR "realize_effective_source_cut_receipt"
            "actual sparse dependency metadata required"
        val names = case owned_names of SOME names => names
          | NONE => raise ERR "realize_effective_source_cut_receipt"
              "missing authentic named vocabulary"
        val proof = theorem block edge
        val target_name = name block target
        val terms = Thm.concl proof :: Thm.hyp proof
        val _ = List.app
          (fixed_guard_operand expected names template_limit) terms
        val _ = owned_sparse_projection_quote expected template_limit
          (Vector.fromList terms)
        val indices = needed_leaves block edge
        val _ = List.app (fn _ => W.spend expected 1) indices
        val selected_terms = Vector.fromList (List.map (fn index =>
          (W.spend expected 1;leaf_term (name block)
            (Vector.sub (leaves,index)))) indices)
        val active_tree = make_tree 0 (Vector.length selected_terms)
        val active_context = tree_term selected_terms active_tree
        fun raw term = case SmtReplayImport.bounded_raw_size
            template_limit term of SOME count => count
          | NONE => raise ERR "realize_effective_source_cut_receipt"
              "actual named operand exceeds original raw cap"
        fun inclusive term = case SmtReplayImport.bounded_binder_size
            template_limit term of SOME count => count
          | NONE => raise ERR "realize_effective_source_cut_receipt"
              "actual named operand exceeds original binder cap"
        val raw_law = 3 + raw active_context + raw target_name
        val inc_law = 3 + inclusive active_context + inclusive target_name
        val _ = if raw_law <= template_limit andalso
            inc_law <= template_limit then () else
          raise ERR "realize_effective_source_cut_receipt"
            "prospective actual DISCH law exceeds original cap"
        val _ = W.spend expected raw_law
        val _ = W.spend expected inc_law
        val _ = owned_sparse_projection_quote expected template_limit
          (Vector.fromList [active_context,target_name])
        val source_frame as RetainedSourceFrame
            {original_slots,...} = retained_source_frame_for expected block []
        val needed = needed_source_occurrences block edge
        fun member slot = List.exists (fn actual =>
          (W.spend expected 1;slot = actual)) needed
        fun support (_,index,slots) = if not (member index) then () else
          if List.all member slots then () else
            raise ERR "realize_effective_source_cut_receipt"
              "authentic Source support was not carried by the edge"
        val _ = List.app support rows
        fun discharged slot = List.exists (fn (_,index,_) =>
          (W.spend expected 1;slot = index)) rows
        val needed = List.filter (fn slot => not (discharged slot)) needed
        val occurrences = List.map (fn index =>
          (W.spend expected 1;(index,List.nth (original_slots,index)))) needed
        val held = table_foldl (fn (_, (node,_),rest) =>
          (W.spend expected 2;G.closure_root graph scope node :: rest))
          [] nodes
        val facts = Vector.foldr
          (fn (ClosedWitness fact,rest) => fact::rest | (_,rest) => rest)
          [] leaves
        val conversions = Vector.foldr
          (fn (ConversionWitness plan,rest) => plan::rest | (_,rest) => rest)
          [] leaves
        val _ = List.app (validate_conversion_for expected) conversions
        val _ = retained_source_guard expected source_frame
        fun supply (index,_) = case List.find (fn (_,slot,_) =>
            slot = index) rows of NONE => NONE
          | SOME (receipt,_,_) =>
              SOME (held_parent receipt)
        val _ = effective_cut_guard expected value
        val compact_cuts = List.map (fn (receipt,index,_) =>
          (index,receipt)) rows
        val prepared = prepare_source_cut_internal block NONE target edge
          (SOME supply) NONE
        val _ = List.app (effective_source_guard expected) receipts
        val epoch=Type.type_epoch () val symbols=Term.term_epoch ()
        fun make result = SEChecked
          {work = expected,source_frame = source_frame,graph = graph,
           root = #root data,scope = scope,frame = frame,
           original_sources = #sources data,target = target,
           occurrences = occurrences,
           origins = List.map (fn (index,_) =>
             case List.find (fn (slot,_) => slot=index) slot_origins of
               SOME (_,key) => (index,key)
             | NONE => raise ERR "realize_effective_source_cut_receipt"
                 "missing genuine support occurrence origin") occurrences,
           theorem = result,
           block = block,edge = edge,named_target = target_name,
           named_proof = proof,needed = indices,
           names = List.map #2 (table_list nodes),cuts = compact_cuts,
           held = held,
           facts = facts,conversions = conversions,
           template_limit = template_limit,parents = receipts,
           epoch = epoch,symbols = symbols}
        val candidate=make boolTheory.TRUTH
        val endpoint= #endpoint prepared
        val hypotheses= #hypotheses prepared
        fun observe held theorem=if Portable.pointer_eq(held,candidate)then
            (endpoint,hypotheses,true)
          else (Thm.concl theorem,Thm.hyp theorem,clean theorem)
        val _=effective_source_guard_observing observe expected candidate
        val count=length hypotheses
        val _=W.spend expected (2+count*(count+3))
        val _=W.require_callback_free_return expected
        val result= #run prepared ()
        val _=if Portable.pointer_eq(Thm.concl result,endpoint)andalso
            clean result andalso List.all(fn term=>List.exists
              (fn held=>Portable.pointer_eq(term,held))hypotheses)
                (Thm.hyp result)then ()else
          raise ERR "effective_source_guard"
            "actual effective endpoint, Hyp or tags changed"
      in make result end) end)
     handle primary => (W.close expected;raise primary)) end

  (* Virtual implication/negation nodes record native canonical routes.
     Discovery never fabricates intermediate Term constructors or proofs. *)
  datatype sce_canonical_syntax=SCELiteral of Term.term
    | SCECanonicalImp of sce_canonical_syntax*sce_canonical_syntax
    | SCECanonicalNeg of sce_canonical_syntax
  datatype source_antecedent_schema=SCEAntecedentSchema of
    {work:W.portfolio,evidence:source_condition_evidence,
     steps:source_condition_rule_step list,terminal:source_rule_terminal}
  fun sce_antecedent_schema_guard expected
      (SCEAntecedentSchema {work,evidence,...})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work) then () else
         raise ERR "antecedent_schema" "foreign expected Work";
       sce_guard expected evidence))
  fun compile_source_antecedent_schemas expected evidence=
    sr_fail expected(fn()=>W.with_step expected(fn()=>
    let val d=sce_data expected evidence
        fun guard()=sce_guard expected evidence
        fun tick n=(guard();W.spend expected n)
        fun guarded operation=
          (guard();let val result=operation()in guard();result end)
        fun implication(SCECanonicalImp pair)=SOME pair
          | implication(SCELiteral term)=
              if boolSyntax.is_imp_only term then
                let val(a,b)=guarded(fn()=>boolSyntax.dest_imp_only term)
                in SOME(SCELiteral a,SCELiteral b)end else NONE
          | implication _=NONE
        fun conjunction(SCELiteral term)=
              if boolSyntax.is_conj term then
                SOME(guarded(fn()=>boolSyntax.dest_conj term))else NONE
          | conjunction _=NONE
        fun disjunction(SCELiteral term)=
              if boolSyntax.is_disj term then
                SOME(guarded(fn()=>boolSyntax.dest_disj term))else NONE
          | disjunction _=NONE
        fun exists_term(SCELiteral term)=boolSyntax.is_exists term
          | exists_term _=false
        fun false_term(SCELiteral term)=Term.is_const term andalso
              Term.same_const term boolSyntax.F
          | false_term _=false
        fun finish steps terminal=
          SCEAntecedentSchema {work=expected,evidence=evidence,
            steps=List.rev steps,terminal=terminal}
        fun route steps syntax=
          (tick 1;
           case conjunction syntax of SOME(a,b)=>
             route(EvidenceStep(SourceConjunct true)::steps)(SCELiteral a) @
             route(EvidenceStep(SourceConjunct false)::steps)(SCELiteral b)
           | NONE=>case implication syntax of SOME(ant,body)=>
               (case conjunction ant of SOME(a,b)=>
                  route(EvidenceAntecedentConj::steps)
                    (SCECanonicalImp(SCELiteral a,
                      SCECanonicalImp(SCELiteral b,body)))
                | NONE=>case disjunction ant of SOME(a,b)=>
                    route(EvidenceAntecedentDisj true::steps)
                      (SCECanonicalImp(SCELiteral a,body)) @
                    route(EvidenceAntecedentDisj false::steps)
                      (SCECanonicalImp(SCELiteral b,body))
                  | NONE=>if exists_term ant then
                      raise ERR "antecedent_schema"
                        "existential route needs authentic fresh witness"
                    else if false_term body then
                      route(EvidenceImpFalse::steps)(SCECanonicalNeg ant)
                    else route(EvidenceStep SourceCondition::steps)body)
             | NONE=>case syntax of SCECanonicalNeg _=>
                 [finish steps SourceFalse]
               | SCELiteral term=>
                   if boolSyntax.is_forall term then
                     raise ERR "antecedent_schema"
                       "explicit forall needs authenticated argument route"
                   else if Term.is_const term andalso
                       Term.same_const term boolSyntax.T then []
                   else if Term.is_const term andalso
                       Term.same_const term boolSyntax.F then
                     raise ERR "antecedent_schema"
                       "false conclusion needs fixed falsity proof route"
                   else if boolSyntax.is_eq term then
                     [finish steps SourceEquality]
                   else if boolSyntax.is_neg term then
                     [finish steps SourceFalse]
                   else [finish steps SourceTruth]
               | _=>raise ERR "antecedent_schema" "virtual terminal")
        val cap= #output_limit(W.semantic_limits expected)
        val _=case SmtReplayImport.bounded_raw_size cap (#target d)of
          SOME n=>tick n | NONE=>raise ERR "antecedent_schema"
            "selected original clause raw syntax bound"
        val _=case SmtReplayImport.bounded_binder_size cap (#target d)of
          SOME n=>tick n | NONE=>raise ERR "antecedent_schema"
            "selected original clause binder syntax bound"
        val(steps,target)=if boolSyntax.is_eq(#target d)then
              let val(a,b)=guarded(fn()=>boolSyntax.dest_eq(#target d))
              in if Term.is_const b andalso Term.same_const b boolSyntax.T
                   then([EvidenceAssertion],a)else([],#target d)end
            else([],#target d)
        val schemas=route steps(SCELiteral target)
        val _=guard()
    in schemas end))
  fun prepare_source_antecedent_schema expected
      (schema as SCEAntecedentSchema {evidence,steps,terminal,...})
      {frame,caller,check_type}=
    sr_fail expected(fn()=>
      (sce_antecedent_schema_guard expected schema;
       prepare_source_condition_rule expected
         {evidence=evidence,steps=steps,terminal=terminal,
          frame=frame,caller=caller,check_type=check_type}))

  (* The small proof and each witness come from ONE exact effective parent.
     Caller ordinals, raw theorem/node pairs and leaf-role hints are absent. *)
  datatype effective_row_kind = ERSource of G.node
    | ERDefinition of G.node * Term.term
    | ERFact of closed_fact | ERConversion of closed_conversion
    | ERCut of source_effective_evidence
  datatype source_effective_row_witness = ERWitness of
    {work:W.portfolio,parent:source_effective_evidence,
     native:Term.term,names:(G.node * Term.term) list,
     kind:effective_row_kind}
  datatype source_effective_compact_view = ECView of
    {work:W.portfolio,parent:source_effective_evidence,frame:Scope.receipt,
     graph:G.graph,scope:G.scope,original_sources:SmtReplaySource.sources,
     proof:Thm.thm,target:G.node,native_target:Term.term,
     names:(G.node * Term.term) list,needed:int list,
     cuts:(int * source_effective_evidence) list,
     rows:(int * Term.term * source_effective_row_witness) list}
  datatype source_effective_completed_witnesses = ECCompleted of
    {view:source_effective_compact_view,
     rows:(source_effective_row_witness * Thm.thm) list}
  fun effective_compact_guard expected
      (ECView{work,parent,frame,graph,scope,proof,native_target,...})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work) then () else
         raise ERR "effective_compact_guard" "foreign expected Work";
       effective_source_guard expected parent;
       ignore(Scope.description_for expected frame);
       G.validate_scope graph scope;
       if clean proof andalso
           Portable.pointer_eq(Thm.concl proof,native_target)
         then () else raise ERR "effective_compact_guard"
           "authentic compact endpoint or tag changed"))
  fun effective_row_guard expected
      (ERWitness{work,parent,...})=sr_fail expected(fn()=>
    (if Portable.pointer_eq(expected,work) then () else
       raise ERR "effective_row_guard" "foreign expected Work";
     effective_source_guard expected parent))
  fun effective_source_compact_for expected parent=
    sr_fail expected(fn()=>
    let
      val data=effective_data expected parent
      val graph= #graph data val scope= #scope data
      val frame= #frame data val target= #target data
      fun token native names kind=ERWitness{work=expected,parent=parent,
        native=native,names=names,kind=kind}
      fun build proof native_target names needed cuts rows=
        let val result=ECView{work=expected,parent=parent,frame=frame,
              graph=graph,scope=scope,original_sources= #original_sources data,
              proof=proof,target=target,native_target=native_target,
              names=names,needed=needed,cuts=cuts,rows=rows}
        in effective_compact_guard expected result;result end
      fun named names node=case List.find(fn(old,_)=>old=node) names of
          SOME(_,value)=>value | NONE=>raise ERR "effective_source_compact_for"
            "missing genuine compact node name"
      fun ordinary proof native_target names needed cuts leaves extras=
        let fun row index=case List.find(fn(slot,_,_)=>slot=index) cuts of
              SOME(_,value,held)=>(index,value,
                token value names (ERCut held))
            | NONE=>
              let val leaf=if index<Vector.length leaves then
                    Vector.sub(leaves,index) else
                    List.nth(extras,index-Vector.length leaves)
                  val value=leaf_term(named names)leaf
                  val kind=case leaf of Source node=>ERSource node
                    | Definition(node,term)=>ERDefinition(node,term)
                    | ClosedWitness fact=>ERFact fact
                    | ConversionWitness conversion=>ERConversion conversion
              in (index,value,token value names kind) end
            val rows=List.map row needed
        in build proof native_target names needed
          (List.map(fn(index,_,held)=>(index,held))cuts)rows end
    in case parent of
      SEOriginal(SourceRealization{compact=SourceCompact
          {block=Block{leaves,...},proof,target_name,names,needed,
           extra_leaves,cuts,...},...})=>
        ordinary proof target_name names needed
          (List.map(fn(index,value,held)=>
            (index,value,SEOriginal held))cuts)leaves extra_leaves
    | SEGeneralized(SGEffective{proof,names,rows,...})=>
        let val slots=List.tabulate(length rows,fn index=>index)
            val actual=Portable.mapi(fn index=>fn(node,value)=>
              (index,value,token value names(ERSource node)))rows
        in build proof (Thm.concl proof) names slots [] actual end
    | SEChecked{block=Block{leaves,...},named_proof,named_target,names,
        needed,cuts,...}=>
        ordinary named_proof named_target names needed
          (List.map(fn(index,held)=>
            (index,leaf_term(named names)(Vector.sub(leaves,index)),held))cuts)
          leaves []
    | SEScoped{proof,names,rows,...}=>
        let fun row(index,value,kind)=
              let val witness=case kind of ESSource node=>ERSource node
                    | ESDefinition pair=>ERDefinition pair
                    | ESFact fact=>ERFact fact
                    | ESConversion conversion=>ERConversion conversion
                    | ESCut held=>ERCut held
              in(index,value,token value names witness)end
            val cuts=List.mapPartial(fn(index,_,kind)=>case kind of
                ESCut held=>SOME(index,held) | _=>NONE)rows
        in build proof(Thm.concl proof)names(List.map #1 rows)cuts
          (List.map row rows)end
    | SEFurtherGEN{proof,names,rows,...}=>
        let val slots=List.tabulate(length rows,fn index=>index)
            val actual=Portable.mapi(fn index=>fn(node,value)=>
              (index,value,token value names(ERSource node)))rows
        in build proof(Thm.concl proof)names slots [] actual end
    | SENormalized{proof,names,rows,...}=>
        let val slots=List.tabulate(length rows,fn index=>index)
            val actual=Portable.mapi(fn index=>fn(node,value)=>
              (index,value,token value names(ERSource node)))rows
        in build proof(Thm.concl proof)names slots [] actual end
    end)
  fun effective_source_compact_data_for expected
      (view as ECView{frame,graph,scope,original_sources,proof,target,
        native_target,names,needed,cuts,rows,...})=
    (effective_compact_guard expected view;
     {frame=frame,graph=graph,scope=scope,original_sources=original_sources,
      proof=proof,target=target,native_target=native_target,names=names,
      needed=needed,cuts=cuts,rows=rows})
  (* Forecast actual row effects without substituting or minting a theorem.
     Source selectors AND their proof operands remain opaque exact ports.
     Small native syntax preserves repeated programme incidences only. *)
  datatype source_effective_completion_plan = ECPlan of
    {work:W.portfolio,view:source_effective_compact_view,quote:IntInf.int,
     policies:Type.hol_type list,check_type:Type.hol_type -> unit,
     used:bool ref}
  datatype ec_metrics = ECMetrics of
    {raw:IntInf.int,inc:IntInf.int,ann:IntInf.int,bytes:IntInf.int}
  fun effective_completion_guard expected
      (ECPlan{work,view,...})=sr_fail expected(fn()=>
    (if Portable.pointer_eq(expected,work) then () else raise ERR
       "effective_completion_guard" "foreign expected Work";
     effective_compact_guard expected view))
  fun prepare_effective_source_compact_completion expected
      {view=view as ECView{graph,scope,rows,proof,...},check_type}=
    sr_fail expected(fn()=>
    let
      val _=effective_compact_guard expected view
      val budget=ref(0:IntInf.int)
      val policies=ref([]:Type.hol_type list)
      fun tick n=(budget:= !budget+IntInf.fromInt n;
        if !budget<=remaining expected then () else raise ERR
          "prepare_effective_source_compact_completion"
          "prospective original Work exhausted")
      fun types ty=
        let val _=tick 1 val _=policies:=ty:: !policies
        in if Type.is_vartype ty then
            (1:IntInf.int,IntInf.fromInt(String.size(Type.dest_vartype ty)))
          else let val {Thy,Tyop,Args}=Type.dest_thy_type ty
              val _=tick(String.size Thy+String.size Tyop)
              val (count,bytes)=List.foldl(fn(arg,(count,bytes))=>
                let val(c,b)=types arg in(count+c,bytes+b)end)
                (1:IntInf.int,IntInf.fromInt
                  (String.size Thy+String.size Tyop))Args
          in(count,bytes)end
        end
      fun atom ty inclusive children=
        let val(a,b)=types ty
            val base=ECMetrics{raw=1,inc=inclusive,ann=a,bytes=b}
            fun plus(ECMetrics{raw=r,inc=i,ann=a,bytes=b},
                ECMetrics{raw=s,inc=j,ann=c,bytes=d})=
              ECMetrics{raw=r+s,inc=i+j,ann=a+c,bytes=b+d}
        in List.foldl plus base children end
      fun metrics term=
        if Term.is_abs term then
          let val _=tick 1 val(v,b)=Term.dest_abs term
              val (vc,vb)=types(Term.type_of v)
              val ECMetrics{raw=r,inc=i,ann=a,bytes=d}=metrics b
              val (c,e)=types(Term.type_of term)
          in ECMetrics{raw=1+r,inc=2+i,ann=c+vc+a,
            bytes=e+vb+d}end
        else if Term.is_comb term then
          let val _=tick 1 val(a,b)=Term.dest_comb term
          in atom(Term.type_of term)1 [metrics a,metrics b]end
        else(tick 1;atom(Term.type_of term)1 [])
      fun port node=(tick 1;atom(G.type_of graph node)1 [])
      fun quote(ECMetrics{raw,inc,ann,bytes})=
        let val amount=raw+inc+ann+bytes+1
        in budget:= !budget+amount;
          if !budget<=remaining expected then () else raise ERR
            "prepare_effective_source_compact_completion"
            "prospective original Work exhausted"
        end
      fun term value=quote(metrics value)
      fun node value=quote(port value)
      fun theorem held=(term(Thm.concl held);List.app term(Thm.hyp held))
      fun actual_hyp evidence=
        let val data=effective_data expected evidence
            val roots= #occurrences data
            val hypotheses=effective_actual_hyp expected evidence
            fun origin hyp=case List.find(fn(_,held)=>
                  (tick 1;Portable.pointer_eq(hyp,
                    G.representative graph held)))roots of
                SOME(_,held)=>held | NONE=>raise ERR
                  "prepare_effective_source_compact_completion"
                  "actual cut Hyp lost genuine Source origin"
        in List.map origin hypotheses end
      fun named names held=case List.find(fn(old,_)=>
          (tick 1;old=held))names of SOME(_,value)=>value
        | NONE=>raise ERR "prepare_effective_source_compact_completion"
            "missing actual constructor child name"
      fun immediate names held rhs=case G.view graph held of
          G.Application(a,b)=>
            if Term.is_comb rhs then
              let val(left,right)=Term.dest_comb rhs
                  val _=tick 2
              in if sr_same left(named names a) andalso
                  sr_same right(named names b) then
                    atom(G.type_of graph held)1 [port a,port b]
                else raise ERR "prepare_effective_source_compact_completion"
                  "different actual immediate constructor children"end
            else raise ERR "prepare_effective_source_compact_completion"
              "actual application definition has no native application"
        | G.Constant _=>
            if Term.is_const rhs andalso Term.same_const rhs
                (G.representative graph held) then port held else raise ERR
              "prepare_effective_source_compact_completion"
              "different actual constant definition"
        | _=>raise ERR "prepare_effective_source_compact_completion"
            "no actual immediate ALPHA recipe for this definition"
      fun row(_,native,witness as ERWitness{names,kind,...})=
        let val _=effective_row_guard expected witness val _=term native
        in case kind of
          ERSource node=>
            (* ASSUME's conclusion AND its actual one-element Hyp set. *)
            (quote(port node);quote(port node))
        | ERDefinition(node,rhs)=>
            let val ty=G.type_of graph node
                val _=quote(port node)
                val _=List.app(fn(held,variable)=>
                  (term variable;quote(port held)))names
                val left=port node
                val right=immediate names node rhs
                (* The native Definition row already owns this exact
                   specialized equality operator/application type. No new
                   arrow Type is constructed by preflight. *)
                val (native_application,_)=Term.dest_comb native
                val (native_operator,_)=Term.dest_comb native_application
                val equality_ty=Term.type_of native_operator
                val application_ty=Term.type_of native_application
                val conclusion=atom Type.bool 1
                  [atom application_ty 1
                    [atom equality_ty 1 [],left],right]
                (* Closed ALPHA has authentic immediate equal children.
                   The forecast counts protected ports, never expanded raw
                   residues. Term.subst traverses only the native rhs. *)
                val _=term rhs val _=quote right val _=quote conclusion
            in ()end
        | ERFact fact=>theorem(closed_proof fact)
        | ERConversion conversion=>
            (validate_conversion_for expected conversion;
             theorem(conversion_proof conversion))
        | ERCut held=>
            let val data=effective_data expected held
                val _=node(#target data)
                val _=List.app node(actual_hyp held)
            in ()end
        end
      val _=theorem proof
      val _=List.app row rows
      val _=effective_compact_guard expected view
    in ECPlan{work=expected,view=view,quote= !budget,
      policies=List.rev(!policies),check_type=check_type,used=ref false}end)
  fun effective_source_completion_work_for expected
      (plan as ECPlan{quote,...})=
    (effective_completion_guard expected plan;quote)
  fun execute_effective_source_compact_completion expected
      (plan as ECPlan{view=view as ECView{graph,scope,rows,...},quote,
        policies,check_type,used,...})=sr_fail expected(fn()=>
    let
      val _=effective_completion_guard expected plan
      val _=if !used then raise ERR
        "execute_effective_source_compact_completion"
        "completion plan already executed" else ()
      (* Pay ALL future row portfolios before any policy or lazy parent
         action. Policies cannot renew Work or mint a row witness. *)
      val _=W.with_step expected(fn()=>
        (effective_completion_guard expected plan;pay expected quote;
         used:=true;List.app(fn ty=>
           (effective_completion_guard expected plan;check_type ty;
            effective_completion_guard expected plan))policies))
      (* Lazy authentic effective cuts realize before this action, matching
         the genuine consumer's parent-action order. No reentry waiver. *)
      fun completed (_,_,witness as ERWitness{kind,...})=
        (effective_row_guard expected witness;
         case kind of ERCut held=>
           let val proof=effective_source_theorem_for expected held
               val _=effective_row_guard expected witness
           in SOME(witness,proof) end
         | _=>NONE)
      val completed_cuts=List.mapPartial completed rows
      val result=W.with_step expected(fn()=>
        let
          val _=effective_compact_guard expected view
          fun held witness=case List.find(fn(old,_)=>
              Portable.pointer_eq(old,witness))completed_cuts of
                SOME(_,proof)=>proof | NONE=>raise ERR
                  "complete_effective_source_compact_witnesses"
                  "missing genuine completed cut witness"
          fun realize (_,_,witness as ERWitness{names,kind,...})=
            let val _=effective_row_guard expected witness
                val _=W.spend expected 1
                val proof=case kind of
                    ERSource node=>SmtReplayRuleObservation.ASSUME
                      (G.representative graph node)
                  | ERDefinition(node,term)=>
                      let val sigma=List.map(fn(node,variable)=>
                            {redex=variable,
                             residue=G.representative graph node})names
                          val actual=Term.subst sigma term
                      in SmtReplayRuleObservation.ALPHA
                        (G.representative graph node)actual end
                  | ERFact fact=>closed_proof fact
                  | ERConversion conversion=>
                      (validate_conversion_for expected conversion;
                       conversion_proof conversion)
                  | ERCut _=>held witness
                val _=effective_row_guard expected witness
                val _=if clean proof then () else raise ERR
                  "complete_effective_source_compact_witnesses"
                  "actual row witness has unpermitted tags"
            in (witness,proof) end
          val actual=List.map realize rows
          val _=effective_compact_guard expected view
        in ECCompleted{view=view,rows=actual} end)
    in result end)
  fun complete_effective_source_compact_witnesses expected view=
    execute_effective_source_compact_completion expected
      (prepare_effective_source_compact_completion expected
        {view=view,check_type=fn _=>()})
  fun effective_source_completed_witness_for expected
      (ECCompleted{view,rows}) witness=
    sr_fail expected(fn()=>
      (effective_compact_guard expected view;
       effective_row_guard expected witness;
       let val proof=case List.find(fn(held,_)=>
             Portable.pointer_eq(held,witness))rows of
               SOME(_,proof)=>proof | NONE=>raise ERR
                 "effective_source_completed_witness_for"
                 "witness was not completed in this exact view"
           val _=effective_row_guard expected witness
       in proof end))
  (* The actual compact proof vocabulary is interpreted through its held
     graph names. An unknown opaque FV summary stays unknown. This exposes
     no theorem and does not issue a variable, closure or proof allowance. *)
  fun source_condition_freshness_for expected evidence=
    sr_fail expected(fn()=>W.with_step expected(fn()=>
    let val d=sce_data expected evidence
        val frame= #frame d
        val actual=Scope.description_for expected frame
        val graph= #graph actual
        fun guard()=(sce_guard expected evidence;
          Scope.validate_lifetime_for expected frame)
        fun tick n=(guard();W.spend expected n)
        fun guarded operation=
          (guard();let val value=operation()in guard();value end)
        fun member term values=List.exists
          (fn old=>(tick 1;Term.term_eq term old))values
        fun add term values=if member term values then values else
          (tick 1;term::values)
        fun union values result=List.foldl
          (fn(term,all)=>add term all)result values
        fun lookup term []=NONE
          | lookup term((node,name)::rest)=
              (tick 1;if Term.term_eq term name then SOME node else
                lookup term rest)
        fun variables node=
          case guarded(fn()=>G.free_variable_nodes graph node)of
            NONE=>NONE
          | SOME nodes=>
              SOME(List.map(fn variable=>(tick 1;
                guarded(fn()=>G.representative graph variable)))nodes)
        fun walk bound term result=
          (tick 1;case result of NONE=>NONE | SOME all=>
           if Term.is_var term then
             if member term bound then SOME all else
               (case lookup term (#names d)of NONE=>SOME(add term all)
                | SOME node=>case variables node of NONE=>NONE
                  | SOME values=>SOME(union values all))
           else if Term.is_comb term then
             let val(a,b)=guarded(fn()=>Term.dest_comb term)
             in walk bound b (walk bound a (SOME all))end
           else if Term.is_abs term then
             let val(v,body)=guarded(fn()=>Term.dest_abs term)
             in walk(v::bound)body(SOME all)end
           else SOME all)
        val cap=W.work_limit expected
        val terms= #target d::Thm.hyp(#proof d)
        val _=List.app(fn term=>
          (case SmtReplayImport.bounded_raw_size cap term of
             SOME n=>tick n | NONE=>raise ERR "source_condition_freshness"
               "bounded compact statement required";
           case SmtReplayImport.bounded_binder_size cap term of
             SOME n=>tick n | NONE=>raise ERR "source_condition_freshness"
               "bounded compact binder statement required"))terms
        val free=List.foldl(fn(term,all)=>walk [] term all)(SOME [])terms
        val _=guard()
    in {frame=frame,statement= #target d,variables=free}end))

  datatype source_effective_scope_program = EScopeProgram of
    {source:source_effective_evidence,view:source_effective_compact_view,
     hypothesis:G.node,name:string,variable:Term.term option,
     parents:(int * source_effective_scope_program) list,
     result:source_effective_evidence option ref}
  datatype source_effective_scope_plan = EScopePlan of
    {work:W.portfolio,program:source_effective_scope_program,quote:IntInf.int,
     policies:Type.hol_type list,check_type:Type.hol_type -> unit,
     used:bool ref}
  fun effective_scope_program_guard expected
      (EScopeProgram{source,view,parents,...})=
    (effective_source_guard expected source;
     effective_compact_guard expected view;
     List.app(fn(_,program)=>effective_scope_program_guard expected program)
       parents)
  fun effective_scope_plan_guard expected
      (EScopePlan{work,program,...})=sr_fail expected(fn()=>
    (if Portable.pointer_eq(work,expected) then () else raise ERR
       "effective_scope_plan_guard" "foreign expected Work";
     effective_scope_program_guard expected program))
  fun prepare_effective_source_scope expected
      {source,hypothesis,check_type}=sr_fail expected(fn()=>
    let val data=effective_data expected source
        val graph= #graph data val scope= #scope data
        val _=ignore(G.closure_root graph scope hypothesis)
        val _=if Type.compare(G.type_of graph hypothesis,Type.bool)=EQUAL
          then () else raise ERR "prepare_effective_source_scope"
            "actual Scope hypothesis is not Boolean"
        val cap= #template_limit(W.semantic_limits expected)
        val budget=ref(0:IntInf.int)
        val policies=ref([]:Type.hol_type list)
        val cache=ref([]:
          (source_effective_evidence * source_effective_scope_program) list)
        fun tick n=(budget:= !budget+IntInf.fromInt n;
          if !budget<=remaining expected then () else raise ERR
            "prepare_effective_source_scope" "prospective original Work")
        fun capture term=
          let val _=case SmtReplayImport.bounded_raw_size cap term of
                  SOME n=>tick n | NONE=>raise ERR
                    "prepare_effective_source_scope" "native raw cap"
              val _=case SmtReplayImport.bounded_binder_size cap term of
                  SOME n=>tick n | NONE=>raise ERR
                    "prepare_effective_source_scope" "native binder cap"
              fun tree term=(tick 1;
                if Term.is_comb term then
                  let val(a,b)=Term.dest_comb term
                  in SGApp(Term.type_of term,tree a,tree b)end
                else if Term.is_abs term then
                  let val(v,b)=Term.dest_abs term
                  in SGAbs(Term.type_of term,v,tree b)end
                else SGAtom term)
          in tree term end
        fun types ty=(tick 1;policies:=ty:: !policies;
          if Type.is_vartype ty then 1:IntInf.int else
            1+List.foldl(fn(arg,n)=>n+types arg)0
              (#Args(Type.dest_thy_type ty)))
        fun annotations tree=types(sg_type tree)+(case tree of
            SGApp(_,a,b)=>annotations a+annotations b
          | SGAbs(_,v,b)=>types(Term.type_of v)+annotations b | _=>0)
        fun quote trees=
          let val amount=List.foldl(fn(tree,n)=>
                n+sg_size false tree+sg_size true tree+annotations tree)1 trees
              val _=budget:= !budget+amount
          in if !budget<=remaining expected then () else raise ERR
            "prepare_effective_source_scope" "prospective original Work"end
        fun model tree=case tree of SGAtom term=>SCEAtom term
          | SGName(node,_,_)=>SCEProtected node
          | SGApp(ty,a,b)=>SCEApp(ty,model a,model b)
          | SGAbs(ty,v,b)=>SCEAbs(ty,v,v,model b)
          | SGForecastConstant _=>raise ERR "prepare_effective_source_scope"
              "unexpected prospective constant marker"
        fun same a b=sce_equal tick(model a)(model b)
        fun insert(tree,values)=if List.exists(same tree)values then values
          else values@[tree]
        fun union a b=List.foldl insert a b
        fun without tree values=List.filter(fn old=>not(same tree old))values
        fun footprint(conclusion,hypotheses)=conclusion::hypotheses
        fun event result operands=
          (quote(footprint result@List.concat(List.map footprint operands));
           result)
        fun collect held=case List.find(fn(old,_)=>
            (tick 1;Portable.pointer_eq(old,held)))(!cache) of
            SOME(_,program)=>program | NONE=>
          let val actual=effective_data expected held
              val _=if Portable.pointer_eq(graph,#graph actual) andalso
                  Portable.pointer_eq(#original_sources data,
                    #original_sources actual) andalso
                  G.scope_visible graph scope(#scope actual) then () else
                raise ERR "prepare_effective_source_scope"
                  "foreign authentic Scope parent backing"
              val view=effective_source_compact_for expected held
              val d=effective_source_compact_data_for expected view
              val free=List.concat(List.map Term.free_vars
                (Thm.concl(#proof d)::Thm.hyp(#proof d)@
                  List.map(fn(_,native,_)=>native)(#rows d)@
                  List.map #2(#names d)))
              val identifiers=List.map(#1 o Term.dest_var)free
              fun choose index=
                let val name="__smt_effective_scope_"^Int.toString index
                    val _=tick(String.size name+1)
                in if List.exists(fn old=>old=name)identifiers then
                  choose(index+1)else name end
              val row_variable=List.find(fn(_,_,ERWitness{kind,...})=>
                case kind of ERSource node=>node=hypothesis | _=>false)
                (#rows d)
              val held_variable=case row_variable of
                  SOME(_,native,_)=>SOME native
                | NONE=>Option.map #2(List.find(fn(node,_)=>
                    node=hypothesis)(#names d))
              val (variable,name)=case held_variable of
                  SOME term=>(SOME term,if Term.is_var term then
                    #1(Term.dest_var term)else "")
                | NONE=>(NONE,choose 0)
              val q=case variable of SOME term=>SGAtom term
                | NONE=>SGName(hypothesis,name,Type.bool)
              val parents=List.mapPartial(fn(index,_,ERWitness{kind,...})=>
                case kind of ERCut parent=>SOME(index,collect parent)
                  | _=>NONE)(#rows d)
              val original=(capture(Thm.concl(#proof d)),
                List.map capture(Thm.hyp(#proof d)))
              fun cut(index,native,ERWitness{kind,...}) proof=case kind of
                  ERCut _=>
                    let val premise=capture native
                        val scoped=sg_binary boolSyntax.implication q premise
                        val assumed=event(scoped,[scoped])[]
                        val hypothesis=event(q,[q])[]
                        val completed=event(premise,union[scoped][q])
                          [assumed,hypothesis]
                        val discharged=event
                          (sg_binary boolSyntax.implication premise(#1 proof),
                           without premise(#2 proof))[proof]
                    in event(#1 proof,union(#2 completed)(#2 discharged))
                      [completed,discharged]end
                | _=>proof
              val body=List.foldl(fn(row,proof)=>cut row proof)original
                (#rows d)
              val _=event(sg_binary boolSyntax.implication q(#1 body),
                without q(#2 body))[body]
              val _=quote[q,SGAtom boolSyntax.implication]
              val _=List.app(fn(_,native,_)=>quote[capture native])(#rows d)
              val result=EScopeProgram{source=held,view=view,
                hypothesis=hypothesis,name=name,variable=variable,
                parents=parents,result=ref NONE}
              val _=cache:=(held,result):: !cache
          in result end
        val program=collect source
        val _=effective_scope_program_guard expected program
    in EScopePlan{work=expected,program=program,quote= !budget,
      policies=List.rev(!policies),check_type=check_type,used=ref false}end)
  fun execute_effective_source_scope expected
      (plan as EScopePlan{program,quote,policies,check_type,used,...})=
    sr_fail expected(fn()=>
    let val _=effective_scope_plan_guard expected plan
        val _=if !used then raise ERR "execute_effective_source_scope"
          "Scope plan already executed"else ()
        val _=W.with_step expected(fn()=>
          (effective_scope_plan_guard expected plan;pay expected quote;
           used:=true;List.app(fn ty=>
             (effective_scope_plan_guard expected plan;check_type ty;
              effective_scope_plan_guard expected plan))policies))
        fun execute(program as EScopeProgram{source,view,hypothesis,name,
            variable,parents,result})=case !result of SOME held=>held | NONE=>
          let val _=effective_scope_program_guard expected program
              val completed=List.map(fn(index,parent)=>
                (index,execute parent))parents
          in W.with_step expected(fn()=>
            let val d=effective_source_compact_data_for expected view
                val graph= #graph d val scope= #scope d
                val _=W.spend expected (1+length(#rows d)+length(#names d))
                val q=case variable of SOME term=>term
                  | NONE=>Term.mk_var(name,Type.bool)
                val names=case variable of SOME _=> #names d
                  | NONE=>(hypothesis,q):: #names d
                fun guarded action=
                  (effective_scope_program_guard expected program;
                   let val value=action()
                   in effective_scope_program_guard expected program;
                     value end)
                fun convert(index,native,ERWitness{kind,...})=
                  case kind of ERCut _=>
                    let val held=case List.find(fn(slot,_)=>slot=index)
                          completed of SOME(_,held)=>held | NONE=>raise ERR
                            "execute_effective_source_scope"
                            "missing actual scoped parent"
                    in(index,boolSyntax.mk_imp(q,native),ESCut held)end
                  | ERSource node=>(index,native,ESSource node)
                  | ERDefinition pair=>(index,native,ESDefinition pair)
                  | ERFact fact=>(index,native,ESFact fact)
                  | ERConversion conversion=>(index,native,
                      ESConversion conversion)
                val rows=List.map convert(#rows d)
                fun complete_cut((index,native,kind),proof)=case kind of
                    ESCut _=>
                      let val premise= #2(boolSyntax.dest_imp native)
                          val actual=guarded(fn()=>
                            SmtReplayRuleObservation.MP
                              (SmtReplayRuleObservation.ASSUME native)
                              (SmtReplayRuleObservation.ASSUME q))
                      in guarded(fn()=>SmtReplayRuleObservation.MP
                        (SmtReplayRuleObservation.DISCH premise proof)
                        actual)end
                  | _=>proof
                val body=List.foldl complete_cut(#proof d)rows
                val proof=guarded(fn()=>SmtReplayRuleObservation.DISCH q body)
                val rows=List.filter(fn(_,native,_)=>List.exists
                  (fn hyp=>Term.aconv hyp native)(Thm.hyp proof))rows
                val parent_data=effective_data expected source
                val head=G.constant graph scope boolSyntax.implication
                val operator=G.application graph scope(head,hypothesis)
                val target=G.application graph scope
                  (operator,#target parent_data)
                val value=SEScoped{work=expected,parent=source,
                  hypothesis=hypothesis,target=target,native_hypothesis=q,
                  proof=proof,names=names,
                  rows=rows,parents=List.map #2 completed,realized=ref NONE}
                val _=effective_source_guard expected value
                val _=result:=SOME value
            in value end)
          end
        val value=execute program
    in effective_source_guard expected value;value end)

  (* The normalizer retains exact native views; no SourceRealization is
     reconstructed from a GEN/Scope/cut proof to enter the legacy compiler. *)
  datatype eg_witness = EGSourceWitness of G.node | EGDefinitionWitness
    | EGFactWitness of closed_fact | EGConversionWitness of closed_conversion
    | EGParentWitness of eg_program
  and eg_program = EGProgram of
    {source:source_effective_evidence,view:source_effective_compact_view,
     original:Thm.thm,target:G.node,original_rows:Term.term list,
     rows:sg_tree list,witnesses:eg_witness list,
     sigma:(Term.term * sg_tree) list,result:sg_tree,
     hypotheses:sg_tree list,
     scoped_mp:(eg_program * G.node * source_effective_row_witness *
       source_effective_row_witness) option}
  datatype effective_native_operation=ENGeneralize | ENNormalize
  datatype source_effective_generalization_plan = EGPlan of
    {work:W.portfolio,source:source_effective_evidence,frame:Scope.receipt,
     graph:G.graph,scope:G.scope,target:G.node,opened:G.source,
     operation:effective_native_operation,original_origin:G.source option,
     variables:Term.term list,body:Term.term,program:eg_program,
     names:(G.node * sg_tree) list,policies:Type.hol_type list,
     quote:IntInf.int,check_type:Type.hol_type -> unit,used:bool ref}
  fun eg_guard expected (EGPlan
      {work,source,frame,graph,scope,target,opened,...}) =
    sr_fail expected (fn()=>
      (if Portable.pointer_eq(expected,work) then () else
         raise ERR "effective_source_generalization" "foreign expected Work";
       effective_source_guard expected source;
       ignore(Scope.description_for expected frame);
       G.validate_opened_view graph scope target opened))

  fun prepare_effective_native_program expected
      {source,target,check_type,operation} = sr_fail expected (fn()=>
    W.with_step expected (fn()=>
    let
      val _=effective_source_guard expected source
      val d=effective_data expected source
      val graph= #graph d val scope= #scope d val frame= #frame d
      val template_limit= #template_limit d
      val original_sources= #original_sources d
      val actual_conclusion=G.representative graph(#target d)
      val actual_hypotheses=effective_actual_hyp expected source
      val limits=W.semantic_limits expected
      val cap=template_limit
      val budget=ref(0:IntInf.int)
      val policies=ref([]:Type.hol_type list)
      val identifiers=ref([]:string list)
      fun tick n=W.spend expected n
      fun remember text=(tick(String.size text+1);
        if List.exists(fn old=>old=text)(!identifiers) then () else
          identifiers:=text:: !identifiers)
      fun bounded limit term=
        (case SmtReplayImport.bounded_raw_size limit term of
           SOME n=>tick n | NONE=>raise ERR
             "prepare_effective_source_generalization"
             "bounded operand raw cap";
         case SmtReplayImport.bounded_binder_size limit term of
           SOME n=>tick n | NONE=>raise ERR
             "prepare_effective_source_generalization"
             "bounded operand binder cap")
      fun syntax term=
        (tick 1;
         if Term.is_var term then
           (remember(#1(Term.dest_var term));SGAtom term)
         else if Term.is_comb term then
           let val(a,b)=Term.dest_comb term
           in SGApp(Term.type_of term,syntax a,syntax b) end
         else if Term.is_abs term then
           let val(v,b)=Term.dest_abs term
               val _=remember(#1(Term.dest_var v))
           in SGAbs(Term.type_of term,v,syntax b) end
         else SGAtom term)
      fun capture limit term=(bounded limit term;syntax term)
      val wanted=G.representative graph target
      val wanted_tree=capture (#output_limit limits) wanted
      val _=bounded cap wanted
      val _=bounded (#input_limit limits)actual_conclusion
      (* Peel ONLY the new prefix. Existing forall syntax in the authentic
         parent conclusion belongs to the body and is not generalized again. *)
      fun new_prefix variables remaining=
        if not(null variables) andalso Term.aconv remaining actual_conclusion
          then(List.rev variables,remaining)
        else if boolSyntax.is_forall remaining then
          let val(variable,body)=boolSyntax.dest_forall remaining
          in new_prefix(variable::variables)body end
        else raise ERR "prepare_effective_source_generalization"
          "different actual candidate body"
      val(variables,body)=case operation of
          ENGeneralize=>new_prefix [] wanted
        | ENNormalize=>([],actual_conclusion)
      val original_origin=case operation of ENGeneralize=>NONE
        | ENNormalize=>G.source_anchor graph target
      val _=case original_origin of NONE=>()
        | SOME origin=>
            (bounded (#output_limit limits)(#original origin);
             bounded cap(#original origin);tick 1;
             if #node origin=target andalso
                 Term.aconv(#original origin)wanted then ()else raise ERR
               "prepare_effective_source_normalization"
               "authentic bounded Original clause differs")
      val _=bounded (#input_limit limits) body
      val _=bounded cap body
      val _=if Term.aconv body actual_conclusion then () else raise ERR
        "prepare_effective_source_generalization"
        "different actual candidate body"
      (* The actual surviving Hyp portfolio supplies eigenvariable authority.
         Its graph free-variable receipts are inspected without raw Gamma. *)
      val occurrences= #occurrences d
      val actual_source_nodes=ref([]:G.node list)
      fun actual_hyp hypothesis=
        let val node=case List.find(fn(_,node)=>
              (tick 1;Portable.pointer_eq(hypothesis,
                 G.representative graph node))) occurrences of
                SOME(_,node)=>node | NONE=>raise ERR
                  "prepare_effective_source_generalization"
                  "surviving Hyp has no actual Source occurrence"
            val fv=case operation of ENNormalize=>[] | ENGeneralize=>
              (case G.free_variables graph node of G.Known fv=>fv
              | G.Unknown=>raise ERR "prepare_effective_source_generalization"
                  "missing actual Source free-variable receipt")
            val _=actual_source_nodes:=node:: !actual_source_nodes
            val _=List.app(fn v=>tick 1) fv
        in if List.exists(fn v=>List.exists(fn actual=>
              (tick 1;sr_same v actual)) fv) variables then raise ERR
            "prepare_effective_source_generalization"
            "GEN variable occurs in actual surviving Hyp" else () end
      val _=List.app actual_hyp actual_hypotheses
      val completed=ref([]:(source_effective_evidence * unit) list)
      val raw=ref([]:source_effective_evidence list)
      val scoped_programs=ref([]:(source_effective_evidence *
        source_effective_evidence * G.node * source_effective_row_witness *
        source_effective_row_witness) list)
      fun selected_program receipt=List.find(fn(held,_,_,_,_)=>
        (tick 1;Portable.pointer_eq(held,receipt)))(!scoped_programs)
      val expose=ref([]:G.node list)
      val sources=ref([]:G.node list)
      val scope_ports=ref([]:G.node list)
      val definition_nodes=ref([]:G.node list)
      val scoped_targets=ref([]:(G.node * G.node * G.node) list)
      fun scoped node=List.find(fn(target,_,_)=>target=node)(!scoped_targets)
      fun add cell node=(tick 1;if List.exists(fn old=>old=node)(!cell)
        then () else cell:=node:: !cell)
      fun selected_names names originals conclusion=
        let val free=List.concat(List.map Term.free_vars
              (conclusion::originals))
        in List.filter(fn(_,variable)=>List.exists(fn v=>
          (tick 1;sr_same v variable)) free) names end
      fun collect receipt=
        let val _=effective_source_guard expected receipt
            val hit=List.exists(fn(old,_)=>
              (tick 1;Portable.pointer_eq(old,receipt)))(!completed)
        in if hit then () else
          let val data=effective_data expected receipt
              val owner= #graph data val held_sources= #original_sources data
              val held_scope= #scope data val actual= #target data
              val _=if Portable.pointer_eq(graph,owner) andalso
                  Portable.pointer_eq(original_sources,held_sources) andalso
                  G.scope_visible graph scope held_scope then () else raise ERR
                "prepare_effective_source_generalization" "foreign cut backing"
              val is_scoped=case receipt of
                  SEScoped{hypothesis,parent,...}=>
                    (add scope_ports hypothesis;
                     scoped_targets:=(actual,hypothesis,
                       #target(effective_data expected parent))::
                       !scoped_targets;true)
                | _=>false
              val _=if is_scoped then () else
                bounded cap(G.representative graph actual)
              val view=effective_source_compact_for expected receipt
              val native=effective_source_compact_data_for expected view
              val _=List.app(fn term=>ignore(capture cap term))
                (Thm.concl(#proof native)::Thm.hyp(#proof native))
              fun row(_,term,witness as ERWitness{kind,...})=
                (effective_row_guard expected witness;
                 ignore(capture cap term);
                 case kind of ERCut parent=>collect parent
                   | ERSource node=>add sources node
                   | ERDefinition(node,_)=>add definition_nodes node
                   | ERFact fact=>add expose(closed_node fact)
                   | ERConversion conv=>
                       (add expose(conversion_source conv);
                        add expose(conversion_target conv)))
              val _=if is_scoped then ()else add expose actual
              (* A genuine checked Scope application can be proved by MP
                 from its exact cut and Source witnesses. Its SAT-selected
                 constructor Definitions are not operands of this programme.
                 No theorem/node pairing supplies either witness. *)
              fun scoped_mp ()=case receipt of SEChecked _=>
                let fun cut(_,_,cut_row as ERWitness{kind,...})=
                      case kind of ERCut(held as SEScoped
                          {parent,hypothesis,...})=>
                        if #target(effective_data expected parent)=actual
                          then(case List.find(fn(_,_,ERWitness{kind,...})=>
                            case kind of ERSource node=>node=hypothesis
                              | _=>false)(#rows native)of
                              SOME(_,_,source_row)=>
                                SOME(held,hypothesis,cut_row,source_row)
                            | NONE=>NONE)
                          else NONE
                      | _=>NONE
                in case List.mapPartial cut(#rows native)of
                  candidate::_=>SOME candidate | []=>NONE end
                | _=>NONE
              val _=case scoped_mp()of
                NONE=>List.app row(#rows native)
              | SOME(held,hypothesis,cut_row,source_row)=>
                  (effective_row_guard expected cut_row;
                   effective_row_guard expected source_row;
                   collect held;add sources hypothesis;
                   scoped_programs:=(receipt,held,hypothesis,cut_row,
                     source_row):: !scoped_programs)
              val _=raw:=receipt:: !raw
              val _=completed:=(receipt,()):: !completed
          in () end
        end
      val _=collect source
      (* These two constructor nodes are emitted ONLY by the authentic
         SEScoped producer. Ordinary definitions retain their full cap. *)
      fun scope_spine node=List.find(fn(target,hypothesis,body)=>
        let val _=tick 1
        in case G.view graph target of G.Application(operator,actual_body)=>
          (case G.view graph operator of G.Application(head,actual_hyp)=>
            if actual_body=body andalso actual_hyp=hypothesis andalso
                Term.is_const(G.representative graph head) andalso
                Term.same_const(G.representative graph head)
                  boolSyntax.implication then node=operator orelse node=target
              else raise ERR "prepare_effective_source_generalization"
                "authentic Scope constructor changed"
           | _=>raise ERR "prepare_effective_source_generalization"
               "missing authentic Scope operator")
        | _=>raise ERR "prepare_effective_source_generalization"
            "missing authentic Scope application"end)(!scoped_targets)
      val _=List.app(fn node=>if Option.isSome(scope_spine node)then ()else
        add expose node)(!definition_nodes)
      (* Only bounded conclusion/witness subgraphs may be expanded. A large
         Source forest stays a distinct authentic atom, even if conjunctive. *)
      val required=G.block_reachable graph (#target d:: !expose)
      val ports=List.foldl(fn(node,all)=>
        if List.exists(fn old=>old=node)all then all else all@[node])
        (!sources)(!scope_ports)
      fun protected node=List.exists(fn old=>old=node)ports andalso
        not(List.exists(fn old=>old=node) required)
      val replacements=ref([]:(G.node * sg_tree) list)
      val port_replacements=ref([]:(G.node * sg_tree) list)
      fun resolved node=case List.find(fn(old,_)=>old=node)
          (!port_replacements)of SOME(_,tree)=>tree | NONE=>actual node
      and actual node=case List.find(fn(old,_)=>old=node)(!replacements) of
          SOME(_,tree)=>tree | NONE=>
            let val tree=case scoped node of
                    SOME(_,hypothesis,body)=>sg_binary boolSyntax.implication
                      (resolved hypothesis)(resolved body)
                  | NONE=>case scope_spine node of SOME _=>
                      (case G.view graph node of G.Application(a,b)=>
                         SGApp(G.type_of graph node,resolved a,resolved b)
                       | _=>raise ERR "prepare_effective_source_generalization"
                           "missing actual Scope spine application")
                    | NONE=>capture cap(G.representative graph node)
                val _=if Option.isSome(scoped node) orelse
                    Option.isSome(scope_spine node)then ()else
                  bounded (#output_limit limits)(G.representative graph node)
            in replacements:=(node,tree):: !replacements;tree end
      val _=List.app(fn receipt=>
        let val view=effective_source_compact_for expected receipt
            val d=effective_source_compact_data_for expected view
            val originals=List.map(fn(_,term,_)=>term)(#rows d)
            val bindings=selected_names(#names d)originals
              (Thm.concl(#proof d))
        in case selected_program receipt of SOME _=>()
          | NONE=>List.app(fn(node,_)=>if protected node orelse
              Option.isSome(scope_spine node)then ()else ignore(actual node))
                bindings end)(!raw)
      fun fresh node=
        let fun choose index=
              let val text="__smt_gen_gamma_"^Int.toString index
                  val _=tick(String.size text+1)
              in if List.exists(fn old=>old=text)(!identifiers) then
                choose(index+1) else (remember text;text) end
        in SGName(node,choose 0,G.type_of graph node) end
      val gamma=List.map(fn node=>(node,if protected node then fresh node
        else actual node))ports
      val _=port_replacements:=gamma
      fun replacement node=case List.find(fn(old,_)=>old=node) gamma of
          SOME(_,tree)=>tree | NONE=>actual node
      fun substitute bindings tree=case tree of SGAtom term=>
          (case List.find(fn(old,_)=>
             (tick 1;sr_same old term)) bindings of
             SOME(_,value)=>value | NONE=>tree)
        | SGApp(ty,a,b)=>SGApp(ty,substitute bindings a,substitute bindings b)
        | SGAbs(ty,v,b)=>SGAbs(ty,v,substitute
            (List.filter(fn(old,_)=>not(sr_same old v)) bindings)b)
        | _=>tree
      fun type_scan ty=
        (tick 1;policies:=ty:: !policies;
         if Type.is_vartype ty then 1:IntInf.int else
           1+List.foldl(fn(t,n)=>n+type_scan t)0
             (#Args(Type.dest_thy_type ty)))
      fun quote trees=
        let fun annotations tree=
              type_scan(sg_type tree)+(case tree of
                SGApp(_,a,b)=>annotations a+annotations b
              | SGAbs(_,v,b)=>type_scan(Term.type_of v)+annotations b
              | _=>0)
            fun cost tree=
              let val raw=sg_size false tree val inc=sg_size true tree
                  val _=if raw<=IntInf.fromInt cap andalso
                    inc<=IntInf.fromInt cap then () else raise ERR
                    "prepare_effective_source_generalization"
                    "prospective actual compact operand cap"
              in raw+inc+annotations tree end
            val amount=List.foldl(fn(tree,n)=>n+cost tree)1 trees
            val _=budget:= !budget+amount
        in if !budget<=remaining expected then () else raise ERR
          "prepare_effective_source_generalization" "prospective original Work"
        end
      (* Pure typed alpha grammar determines every future Hyp set.
         Source identities are protected graph data, never proof authority. *)
      fun model tree=case tree of SGAtom term=>SCEAtom term
        | SGName(node,_,_)=>SCEProtected node
        | SGApp(ty,a,b)=>SCEApp(ty,model a,model b)
        | SGAbs(ty,v,b)=>SCEAbs(ty,v,v,model b)
        | SGForecastConstant _=>raise ERR
            "prepare_effective_source_generalization"
            "prospective equality marker used as a Hyp"
      fun same a b=sce_equal tick (model a)(model b)
      fun insert (tree,values)=if List.exists(same tree) values then values
        else values @ [tree]
      fun union a b=List.foldl insert a b
      fun without tree values=List.filter(fn old=>not(same tree old)) values
      fun footprint(conclusion,hypotheses)=conclusion::hypotheses
      fun event result operands=
        (quote(footprint result @ List.concat(List.map footprint operands));
         result)
      fun alignment wanted (proof as (actual,hypotheses))=
        let val equality=event
              (sg_binary boolSyntax.equality actual wanted,[])[]
            val _=quote[actual,wanted]
        in event(wanted,hypotheses)[equality,proof] end
      fun project_models tree (proof as (conclusion,hypotheses))=
        case tree of Empty=>[] | Leaf _=>[proof]
        | Split(a,b)=>
            let val(left,right)=case conclusion of
                  SGApp(_,SGApp(_,_,left),right)=>(left,right)
                | _=>raise ERR "prepare_effective_source_generalization"
                    "different prospective context projection"
                val first=event(left,hypotheses)[proof]
                val second=event(right,hypotheses)[proof]
            in project_models a first @ project_models b second end
      fun proof_tree []=(SGAtom boolSyntax.T,[])
        | proof_tree proofs=
          let val entries=Vector.fromList proofs
              fun build Empty=(SGAtom boolSyntax.T,[])
                | build(Leaf index)=Vector.sub(entries,index)
                | build(Split(a,b))=
                    let val left as (l,lh)=build a
                        val right as (r,rh)=build b
                    in event(sg_binary boolSyntax.conjunction l r,
                      union lh rh)[left,right] end
          in build(make_tree 0(Vector.length entries)) end
      fun prepare receipt=case selected_program receipt of
          SOME(_,parent,hypothesis,cut_row,source_row)=>
            let val parent_program as EGProgram
                  {result=law,hypotheses=law_hyp,...}=prepare parent
                val premise=replacement hypothesis
                val wanted=actual(#target(effective_data expected receipt))
                val _=if same law
                    (sg_binary boolSyntax.implication premise wanted)then ()
                  else raise ERR "prepare_effective_source_generalization"
                    "genuine Scope MP programme endpoint changed"
                val assumption=event(premise,[premise])[]
                val applied=event(wanted,union law_hyp [premise])
                  [(law,law_hyp),assumption]
                val result=alignment wanted applied
                val view=effective_source_compact_for expected receipt
                val data=effective_source_compact_data_for expected view
                val proof= #proof data
                val original_hypotheses=Thm.hyp proof
                val original_model=(capture cap(Thm.concl proof),
                  List.map(capture cap)original_hypotheses)
                val _=quote(footprint original_model)
                (* Closing this exact native proof retains its genuine
                   kernel provenance. It supplies no Source assumption. *)
                fun discharge(row,current as (conclusion,hypotheses))=
                  event(sg_binary boolSyntax.implication row conclusion,
                    without row hypotheses)[current]
                val provenance=List.foldr discharge original_model
                  (#2 original_model)
                val _=if null(#2 provenance)then ()else raise ERR
                  "prepare_effective_source_generalization"
                  "prospective checked provenance law not closed"
                val pair=event(sg_binary boolSyntax.conjunction
                  (#1 result)(#1 provenance),#2 result)[result,provenance]
                val result=event(wanted,#2 pair)[pair]
            in EGProgram{source=receipt,view=view,original=proof,
              target= #target data,original_rows=original_hypotheses,
              rows=[],witnesses=[],
              sigma=[],result=wanted,hypotheses= #2 result,

              scoped_mp=SOME(parent_program,hypothesis,cut_row,source_row)}end
        | NONE=>
        let val data=effective_data expected receipt
            val target_node= #target data
            val view=effective_source_compact_for expected receipt
            val d=effective_source_compact_data_for expected view
            val proof= #proof d val names= #names d
            val originals=List.map(fn(_,native,_)=>native)(#rows d)
            val bindings=selected_names names originals(Thm.concl proof)
            val sigma=List.map(fn(node,term)=>(term,replacement node)) bindings
            val original_trees=List.map(capture cap) originals
            val rows=List.map(substitute sigma) original_trees
            val result=actual target_node
            val context=sg_forest original_trees val transformed=sg_forest rows
            val initial=(capture cap(Thm.concl proof),
              List.map(capture cap)(Thm.hyp proof))
            val _=quote(footprint initial)
            val assumption=event(context,[context])[]
            val boundary=make_tree 0(length original_trees)
            val projections=project_models boundary assumption
            (* D_PROVE_HYP is the actual DISCH then MP sequence. Each
               intermediate result includes its complete exact named Hyp. *)
            fun replace (premise as (row,ph),(current as (c,ch)))=
              let val discharged=event
                    (sg_binary boolSyntax.implication row c,
                     without row ch)[current]
              in event(c,union (#2 discharged) ph)[discharged,premise] end
            val lifted=List.foldl replace initial projections
            val closed_law=event
              (sg_binary boolSyntax.implication context (#1 lifted),
               without context (#2 lifted))[lifted]
            val _=if null(#2 closed_law) then () else raise ERR
              "prepare_effective_source_generalization"
              "prospective genuine compact law not closed"
            val transformed_law=event
              (sg_binary boolSyntax.implication transformed result,[])
              [closed_law]
            val _=quote(List.concat(List.map(fn(redex,residue)=>
              [SGAtom redex,residue]) sigma))
            fun witness(_,_,held as ERWitness{kind,...})=
              (effective_row_guard expected held;
               case kind of ERCut parent=>EGParentWitness(prepare parent)
                 | ERSource node=>EGSourceWitness node
                 | ERDefinition _=>EGDefinitionWitness
                 | ERFact fact=>EGFactWitness fact
                 | ERConversion conv=>EGConversionWitness conv)
            val witnesses=List.map witness(#rows d)
            fun backing(row,EGSourceWitness _)=event(row,[row])[]
              | backing(row,EGDefinitionWitness)=
                  let val(a,b)=case row of
                        SGApp(_,SGApp(_,_,a),b)=>(a,b)
                      | _=>raise ERR "prepare_effective_source_generalization"
                          "prospective definition is not equality"
                      val _=quote[a,b]
                  in event(row,[])[] end
              | backing(row,EGFactWitness fact)=
                  alignment row(capture cap(Thm.concl(closed_proof fact)),[])
              | backing(row,EGConversionWitness conv)=alignment row
                  (capture cap(Thm.concl(conversion_proof conv)),[])
              | backing(row,EGParentWitness(EGProgram
                  {result,hypotheses,...}))=alignment row(result,hypotheses)
            val models=List.map backing(ListPair.zip(rows,witnesses))
            val support=proof_tree models
            val applied=event(result,#2 support)[transformed_law,support]
            val canonical=alignment result applied
        in EGProgram{source=receipt,view=view,original=proof,
          target=target_node,
          original_rows=originals,rows=rows,witnesses=witnesses,
          sigma=sigma,result=result,hypotheses= #2 canonical,
          scoped_mp=NONE} end
      val program as EGProgram{result,hypotheses,...}=prepare source
      val expected_hypotheses=List.map replacement(!actual_source_nodes)
      val _=if length hypotheses=length expected_hypotheses andalso
          List.all(fn hyp=>List.exists(same hyp)expected_hypotheses)hypotheses
        then ()else raise ERR "prepare_effective_source_generalization"
          "prospective Source Hyp differs from actual inherited Hyp"
      fun forall_layers (SGApp(_,SGAtom operator,SGAbs(ty,v,body)))=
            if Term.is_const operator andalso
                Term.same_const operator boolSyntax.universal then
              (SGAtom operator,ty,v)::forall_layers body else []
        | forall_layers _=[]
      val all_layers=forall_layers wanted_tree
      val _=if length all_layers>=length variables then () else raise ERR
        "prepare_effective_source_generalization"
        "different prospective actual GEN spine"
      val layers=List.take(all_layers,length variables)
      fun gen((variable,(operator,ty,_)),current as (body,hypotheses))=
        (quote[SGAtom variable];event
          (SGApp(Type.bool,operator,SGAbs(ty,variable,body)),hypotheses)
          [current])
      val generated=List.foldr gen(result,hypotheses)
        (ListPair.zip(variables,layers))
      val canonical=alignment wanted_tree generated
      val selected=List.filter(fn(_,row)=>List.exists(same row)
        (#2 canonical)) gamma
      fun close((_,row),current as (conclusion,hypotheses))=
        event(sg_binary boolSyntax.implication row conclusion,
          without row hypotheses)[current]
      val closed=List.foldr close canonical selected
      val _=if null(#2 closed) then () else raise ERR
        "prepare_effective_source_generalization"
        "prospective effective Source law not closed"
      (* Final INST traverses this closed small template. Large residues
         remain opaque; post-insertion private/kernel pricing is OPEN. *)
      val _=quote(footprint closed)
      val _=List.app(fn(node,tree)=>case tree of SGName _=>
        (quote[tree];ignore(type_scan(G.type_of graph node))) | _=>()) gamma
      val opened=G.record_opened_view graph scope cap target
      val plan=EGPlan{work=expected,source=source,frame=frame,graph=graph,
        scope=scope,target=target,opened=opened,operation=operation,
        original_origin=original_origin,variables=variables,body=body,
        program=program,names=gamma,policies=List.rev(!policies),
        quote= !budget,check_type=check_type,used=ref false}
      val _=eg_guard expected plan
    in plan end))

  fun execute_effective_source_generalization expected
      (plan as EGPlan{source,graph,target,program,names,policies,quote,
        check_type,variables,operation,original_origin,used,...}) =
    sr_fail expected (fn()=>
    W.with_step expected (fn()=>
    let
      val _=eg_guard expected plan
      val _=if !used then raise ERR "execute_effective_source_generalization"
        "plan already used" else used:=true
      val _=pay expected quote
      fun guarded operation=
        (eg_guard expected plan;let val value=operation()
         in eg_guard expected plan;value end)
      val _=List.app(fn ty=>guarded(fn()=>check_type ty)) policies
      val fresh=ref([]:(G.node * Term.term) list)
      fun emit tree=case tree of SGAtom term=>term
        | SGForecastConstant _=>raise ERR
            "execute_effective_source_generalization"
            "prospective-only constant escaped into the actual program"
        | SGName(node,text,ty)=>(case List.find(fn(old,_)=>old=node)(!fresh) of
            SOME(_,term)=>term | NONE=>
              let val term=guarded(fn()=>Term.mk_var(text,ty))
              in fresh:=(node,term):: !fresh;term end)
        | SGApp(_,a,b)=>
            let val left=emit a val right=emit b
            in guarded(fn()=>Term.mk_comb(left,right)) end
        | SGAbs(_,v,b)=>let val body=emit b
            in guarded(fn()=>Term.mk_abs(v,body)) end
      val actual_names=List.map(fn(node,tree)=>(node,emit tree)) names
      val completed=ref([]:(source_effective_evidence * Thm.thm) list)
      fun align wanted theorem=if Portable.pointer_eq
          (wanted,Thm.concl theorem) then theorem else
        guarded(fn()=>SmtReplayRuleObservation.EQ_MP
          (SmtReplayRuleObservation.ALPHA (Thm.concl theorem) wanted) theorem)
      fun play(EGProgram{source=receipt,view,original,target=actual,
          original_rows,
          rows,witnesses,sigma,result,scoped_mp,...})=
        let val _=effective_source_guard expected receipt
            val _=effective_compact_guard expected view
        in case List.find(fn(old,_)=>Portable.pointer_eq(old,receipt))
            (!completed) of SOME(_,proof)=>proof | NONE=>
          let val proof=case scoped_mp of
                SOME(parent,hypothesis,cut_row,source_row)=>
                  (effective_row_guard expected cut_row;
                   effective_row_guard expected source_row;
                   let val premise=emit(case List.find(fn(node,_)=>
                         node=hypothesis)names of SOME(_,tree)=>tree
                       | NONE=>raise ERR
                           "execute_effective_source_generalization"
                           "Scope MP lost authentic Source port")
                       val law=play parent
                       val assumption=guarded(fn()=>
                         SmtReplayRuleObservation.ASSUME premise)
                       val proof=guarded(fn()=>SmtReplayRuleObservation.MP
                         law assumption)
                       val provenance=List.foldr(fn(row,current)=>
                         guarded(fn()=>SmtReplayRuleObservation.DISCH
                           row current))original original_rows
                       val _=if null(Thm.hyp provenance) andalso
                           clean provenance then ()else raise ERR
                         "execute_effective_source_generalization"
                         "genuine checked provenance law not closed"
                       val paired=guarded(fn()=>
                         SmtReplayRuleObservation.CONJ proof provenance)
                   in guarded(fn()=>
                     SmtReplayRuleObservation.CONJUNCT1 paired)end)
              | NONE=>
          let val terms=Vector.fromList original_rows
              val tree=make_tree 0(Vector.length terms)
              val context=guarded(fn()=>tree_term terms tree)
              val assumption=guarded(fn()=>
                SmtReplayRuleObservation.ASSUME context)
              val projected=guarded(fn()=>project tree assumption)
              val lifted=List.foldl(fn(premise,proof)=>guarded(fn()=>
                SmtReplayRuleObservation.D_PROVE_HYP premise proof))
                original projected
              val law=guarded(fn()=>
                SmtReplayRuleObservation.DISCH context lifted)
              val _=if null(Thm.hyp law) andalso clean law then () else
                raise ERR "execute_effective_source_generalization"
                  "genuine compact law not closed"
              val substitution=List.map(fn(old,tree)=>
                {redex=old,residue=emit tree}) sigma
              val actual_law=guarded(fn()=>
                SmtReplayRuleObservation.INST substitution law)
              val actual_rows=List.map emit rows
              fun witness (row,EGSourceWitness _)=guarded(fn()=>
                    SmtReplayRuleObservation.ASSUME row)
                | witness(row,EGDefinitionWitness)=
                    let val(a,b)=boolSyntax.dest_eq row
                    in guarded(fn()=>SmtReplayRuleObservation.ALPHA a b) end
                | witness(row,EGFactWitness fact)=align row(closed_proof fact)
                | witness(row,EGConversionWitness conv)=
                    align row(conversion_proof conv)
                | witness(row,EGParentWitness parent)=align row(play parent)
              val backing=List.map witness(ListPair.zip(actual_rows,witnesses))
              val support=guarded(fn()=>
                tree_proof(Vector.fromList backing)tree)
              val proof=guarded(fn()=>SmtReplayRuleObservation.MP
                actual_law support)
              val proof=align (emit result) proof
          in proof end
              val proof=align(emit result)proof
              val _=completed:=(receipt,proof):: !completed
          in proof end
        end
      val body=play program
      val actual_hypotheses=effective_actual_hyp expected source
      val _=if List.all(fn hyp=>List.exists(fn(node,row)=>
        List.exists(fn actual=>Portable.pointer_eq(actual,
          G.representative graph node))actual_hypotheses andalso
        Term.aconv hyp row)actual_names)(Thm.hyp body)then ()else raise ERR
          "execute_effective_source_generalization"
          "non-Source definition or cut Hyp survived before GEN"
      val proof=List.foldr(fn(variable,proof)=>guarded(fn()=>
        Thm.GEN variable proof)) body variables
      val proof=align(G.representative graph target)proof
      val rows=List.filter(fn(node,row)=>List.exists(fn actual=>
        Portable.pointer_eq(actual,G.representative graph node))
          actual_hypotheses andalso List.exists(Term.aconv row)
            (Thm.hyp proof))actual_names
      val _=eg_guard expected plan
      val EGPlan{opened,...}=plan
      val value=case operation of ENGeneralize=>
          SEFurtherGEN{work=expected,parent=source,opened=opened,
            proof=proof,target=target,names= !fresh,rows=rows,
            realized=ref NONE}
        | ENNormalize=>SENormalized{work=expected,parent=source,opened=opened,
            origin=original_origin,proof=proof,target=target,names= !fresh,
            rows=rows,realized=ref NONE}
      val _=effective_source_guard expected value
    in value end))


  datatype source_effective_normalization_plan=ENPlan of
    source_effective_generalization_plan
  datatype source_effective_normalization=ENormalization of
    source_effective_evidence
  fun prepare_effective_source_generalization expected
      {source,target,check_type}=
    prepare_effective_native_program expected
      {source=source,target=target,check_type=check_type,
       operation=ENGeneralize}
  fun prepare_effective_source_normalization expected {source,check_type}=
    sr_fail expected(fn()=>
      let val data=effective_data expected source
      in ENPlan(prepare_effective_native_program expected
        {source=source,target= #target data,check_type=check_type,
         operation=ENNormalize})end)
  fun execute_effective_source_normalization expected(ENPlan plan)=
    ENormalization(execute_effective_source_generalization expected plan)
  fun effective_source_normalization_evidence_for expected
      (ENormalization evidence)=
    (effective_source_guard expected evidence;evidence)
  fun effective_source_normalization_view_for expected receipt=
    effective_source_compact_for expected
      (effective_source_normalization_evidence_for expected receipt)
  fun effective_source_normalization_origin_for expected
      (ENormalization(evidence as SENormalized{parent,target,origin,...}))=
    sr_fail expected(fn()=>
      (effective_source_guard expected evidence;
       let val data=effective_data expected parent
       in {frame= #frame data,target=target,
         statement=G.representative(#graph data)target,
         original=Option.map #original origin}end))
    | effective_source_normalization_origin_for expected _=
        sr_fail expected(fn()=>raise ERR "effective_source_normalization"
          "non-normalized private receipt")
  (* Original lexical variables travel with constructor paths. Distinct
     proof programs may reuse an emitted alpha name; that name is not a
     key for an Original binder or a Source occurrence. *)
  datatype source_condition_binder_origins=SourceConditionBinderOrigins of
    {work:W.portfolio,evidence:source_condition_evidence,
     frame:Scope.receipt,statement:Term.term,
     binders:(int list*Term.term*Term.term) list}
  fun prepare_source_condition_binder_origins expected evidence=
    sr_fail expected(fn()=>W.with_step expected(fn()=>
    let val d=sce_data expected evidence
        val frame= #frame d
        fun guard()=(sce_guard expected evidence;
          Scope.validate_lifetime_for expected frame)
        fun tick n=(guard();W.spend expected n)
        fun guarded operation=
          (guard();let val value=operation()in guard();value end)
        val origin=sce_lexical_origin_inside expected evidence
        fun walk path SCOAtom term rows=
              (tick 1;if Term.is_comb term orelse Term.is_abs term then
                 raise ERR "source_binder_origins"
                   "retained atomic origin geometry changed"
               else rows)
          | walk path (SCOApp(left,right))term rows=
              (tick 1;if Term.is_comb term then
                 let val(a,b)=guarded(fn()=>Term.dest_comb term)
                 in walk(1::path)right b(walk(0::path)left a rows)end
               else raise ERR "source_binder_origins"
                 "retained application origin geometry changed")
          | walk path (SCOLam(original,body))term rows=
              (tick 1;if Term.is_abs term then
                 let val(emitted,next)=guarded(fn()=>Term.dest_abs term)
                     val _=if Term.is_var original then ()else
                       raise ERR "source_binder_origins"
                         "retained binder variable changed"
                     val route=List.rev path
                     val _=tick(length route+1)
                 in walk(2::path)body next
                     ((route,original,emitted)::rows)end
               else raise ERR "source_binder_origins"
                 "retained abstraction origin geometry changed")
        val rows=walk [] origin (#target d)[]
        val _=guard()
    in SourceConditionBinderOrigins {work=expected,evidence=evidence,
      frame=frame,statement= #target d,binders=List.rev rows}end))
  fun source_condition_binder_origins_for expected
      (SourceConditionBinderOrigins {work,evidence,frame,statement,
                                     binders})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work)then ()else
         raise ERR "source_binder_origins" "foreign expected Work";
       sce_guard expected evidence;
       Scope.validate_lifetime_for expected frame;
       {frame=frame,statement=statement,binders=binders}))
  (* A complete small proof scan retains EVERY unknown graph origin.
     This is a typed metadata portfolio, never an FV absence certificate. *)
  datatype source_freshness_origins=SourceFreshnessOrigins of
    {work:W.portfolio,evidence:source_condition_evidence,
     frame:Scope.receipt,statement:Term.term,variables:Term.term list,
     unknown:G.node list}
  (* The actual compact proof vocabulary is interpreted through its held
     graph names. An unknown opaque FV summary stays unknown. This exposes
     no theorem and does not issue a variable, closure or proof allowance. *)
  fun prepare_source_condition_freshness_origins expected evidence=
    sr_fail expected(fn()=>W.with_step expected(fn()=>
    let val d=sce_data expected evidence
        val frame= #frame d
        val actual=Scope.description_for expected frame
        val graph= #graph actual
        fun guard()=(sce_guard expected evidence;
          Scope.validate_lifetime_for expected frame)
        fun tick n=(guard();W.spend expected n)
        fun guarded operation=
          (guard();let val value=operation()in guard();value end)
        fun member term values=List.exists
          (fn old=>(tick 1;Term.term_eq term old))values
        fun add term values=if member term values then values else
          (tick 1;term::values)
        fun union values result=List.foldl
          (fn(term,all)=>add term all)result values
        fun lookup term []=NONE
          | lookup term((node,name)::rest)=
              (tick 1;if Term.term_eq term name then SOME node else
                lookup term rest)
        val unknown=ref([]:G.node list)
        fun remember node=if List.exists
          (fn old=>(tick 1;old=node))(!unknown)then ()else
            unknown:=node:: !unknown
        fun variables node=
          case guarded(fn()=>G.free_variable_nodes graph node)of
            NONE=>(remember node;[])
          | SOME nodes=>
              List.map(fn variable=>(tick 1;
                guarded(fn()=>G.representative graph variable)))nodes
        fun walk bound term result=
          (tick 1;let val all=result in
           if Term.is_var term then
             if member term bound then all else
               (case lookup term (#names d)of NONE=>add term all
                | SOME node=>union(variables node)all)
           else if Term.is_comb term then
             let val(a,b)=guarded(fn()=>Term.dest_comb term)
             in walk bound b (walk bound a all)end
           else if Term.is_abs term then
             let val(v,body)=guarded(fn()=>Term.dest_abs term)
             in walk(v::bound)body all end
           else all end)
        (* This is the SAME exact witness interpretation as realization:
           closed Definition/fact/conversion rows have no Source Hyp.
           Native named proof Hyp also contains those private rows and
           cannot itself be interpreted as Original Source rigidity. *)
        val roots=ref([]:G.node list)
        fun root node=
          (tick 1;if List.exists(fn old=>(tick 1;old=node))(!roots)
             then ()else roots:=node:: !roots)
        fun inherited(parent as SourceRealization
            {graph=actual,occurrences,theorem,...})=
          (source_realization_guard expected parent;
           if Portable.pointer_eq(actual,graph)then ()else
             raise ERR "source_condition_freshness"
               "foreign authentic cut Source graph";
           List.app(fn hypothesis=>
             let val matching=List.filter(fn(_,node)=>
                   (tick 1;Portable.pointer_eq(hypothesis,
                     guarded(fn()=>G.representative graph node))))
                   occurrences
                 val _=if null matching then raise ERR
                   "source_condition_freshness"
                   "actual cut Hyp has no retained Source occurrence"
                   else ()
             in List.app(root o #2)matching end)(Thm.hyp theorem))
        fun closed theorem=
          if null(Thm.hyp theorem)then ()else raise ERR
            "source_condition_freshness" "closed row has actual hypotheses"
        fun witness(SCEWitness(recipe as SourceRuleRecipe
            {base=SourceCompact {block=Block {leaves,...},cuts,
                                 extra_leaves,...},...},index))=
          (validate_source_rule_for expected recipe;
           case List.find(fn(slot,_,_)=>(tick 1;slot=index))cuts of
             SOME(_,_,parent)=>inherited parent
           | NONE=>case (if index<Vector.length leaves then
                 Vector.sub(leaves,index)else
                 List.nth(extra_leaves,index-Vector.length leaves))of
               Source node=>root node
             | ClosedWitness fact=>
                 (validate_closed_fact graph (#scope actual)
                   (#template_limit(W.semantic_limits expected))fact;
                  closed(closed_proof fact))
             | ConversionWitness conversion=>
                 (validate_conversion_for expected conversion;
                  closed(conversion_proof conversion))
             | Definition _=>())
        val _=List.app(fn(_,held)=>(tick 1;witness held)) (#rows d)
        val cap=W.work_limit expected
        (* Actual local antecedents remain in the retained statement.
           Authentic extra Source/local Hyp remains a Source witness row. *)
        val terms=[#target d]
        val _=List.app(fn term=>
          (case SmtReplayImport.bounded_raw_size cap term of
             SOME n=>tick n | NONE=>raise ERR "source_condition_freshness"
               "bounded compact statement required";
           case SmtReplayImport.bounded_binder_size cap term of
             SOME n=>tick n | NONE=>raise ERR "source_condition_freshness"
               "bounded compact binder statement required"))terms
        val statement_free=List.foldl
          (fn(term,all)=>walk [] term all)[]terms
        val free=List.foldl(fn(node,all)=>
          union(variables node)all)statement_free(List.rev(!roots))
        val _=guard()
    in SourceFreshnessOrigins {work=expected,evidence=evidence,frame=frame,
      statement= #target d,variables=free,unknown=List.rev(!unknown)}end))
  fun source_condition_freshness_origins_for expected
      (SourceFreshnessOrigins {work,evidence,frame,statement,variables,
                               unknown})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work)then ()else
         raise ERR "freshness_origins" "foreign expected Work";
       sce_guard expected evidence;
       let val d=Scope.description_for expected frame
           val _=List.app(fn node=>ignore(G.view (#graph d)node))unknown
       in {frame=frame,statement=statement,variables=variables,
         unknown=unknown}end))

  (* Actual witness Hyp DATA, not a new Source/proof/absence entitlement. *)
  datatype source_effective_row_hypotheses = ERHypotheses of
    {work:W.portfolio,row:source_effective_row_witness,
     backing:source_effective_evidence,graph:G.graph,scope:G.scope,
     frame:Scope.receipt,hypotheses:G.node list,
     occurrences:(int * G.node * source_origin) list}
  datatype source_effective_hyp_origin = ERHypOrigin of
    {portfolio:source_effective_row_hypotheses,ordinal:int,node:G.node,
     origin:source_origin}
  fun effective_row_hyp_guard expected
      (ERHypotheses{work,row,backing,frame,graph,scope,...})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work)then ()else raise ERR
         "effective_row_hypotheses" "foreign expected Work";
       effective_row_guard expected row;
       effective_source_guard expected backing;
       ignore(Scope.description_for expected frame);
       G.validate_scope graph scope))
  fun prepare_effective_source_row_hypotheses expected
      (row as ERWitness{parent,kind,...})=sr_fail expected(fn()=>
    (effective_row_guard expected row;
     W.with_step expected(fn()=>
     let val backing=case kind of ERCut held=>held | _=>parent
         val d=effective_data expected backing
         val graph= #graph d val scope= #scope d val frame= #frame d
         fun tick n=(effective_row_guard expected row;
           effective_source_guard expected backing;W.spend expected n)
         val _=tick 1
         (* Closed Definition/Fact/Conversion witnesses have NO Source Hyp.
            Their native private names/child FV are not rigidity evidence. *)
         val hypotheses=case kind of ERSource node=>[node]
           | ERCut held=>
               let fun origin hyp=case List.find(fn(_,node)=>
                     (tick 1;Portable.pointer_eq(hyp,
                       G.representative graph node)))(#occurrences d)of
                       SOME(_,node)=>node | NONE=>raise ERR
                         "effective_row_hypotheses"
                         "actual cut Hyp lost authentic Source origin"
               in List.map origin(effective_actual_hyp expected held)end
           | ERFact fact=>
               (if null(Thm.hyp(closed_proof fact))then []else raise ERR
                 "effective_row_hypotheses" "fact witness is not closed")
           | ERConversion conversion=>
               (validate_conversion_for expected conversion;
                if null(Thm.hyp(conversion_proof conversion))then []else
                  raise ERR "effective_row_hypotheses"
                    "conversion witness is not closed")
           | ERDefinition _=>[]
         val pairs=ListPair.zip(#occurrences d,#origins d)
         fun used((ordinal,node),(held,origin))=
           (tick 1;
            if ordinal=held then
              if List.exists(fn hyp=>(tick 1;hyp=node))hypotheses then
                SOME(ordinal,node,origin)else NONE
            else raise ERR "effective_row_hypotheses"
              "authentic occurrence/origin ordinal changed")
         val occurrences=List.mapPartial used pairs
         val _=if List.all(fn hyp=>List.exists(fn(_,node,_)=>
             (tick 1;node=hyp))occurrences)hypotheses then ()else raise ERR
           "effective_row_hypotheses" "Source row lacks authentic origin"
         val result=ERHypotheses{work=expected,row=row,backing=backing,
           graph=graph,scope=scope,frame=frame,hypotheses=hypotheses,
           occurrences=occurrences}
         val _=effective_row_hyp_guard expected result
     in result end)))
  fun effective_source_row_hypotheses_for expected
      (portfolio as ERHypotheses{graph,scope,frame,hypotheses,
        occurrences,...})=
    (effective_row_hyp_guard expected portfolio;
     {graph=graph,scope=scope,frame=frame,hypotheses=hypotheses,
      origins=List.map(fn(ordinal,node,origin)=>ERHypOrigin
        {portfolio=portfolio,ordinal=ordinal,node=node,origin=origin})
        occurrences})
  fun effective_source_hyp_origin_for expected
      (ERHypOrigin{portfolio,ordinal,node,origin})=
    (effective_row_hyp_guard expected portfolio;
     {ordinal=ordinal,node=node,original=case origin of
        OriginalPrefixSlot _=>true | ActualSourceSlot _=>false})


  datatype sce_future_argument=SCEFutureArgument of
    {name:string,ty:Type.hol_type,child:G.closure_child option ref}
  fun sce_future_guard graph scope NONE=()
    | sce_future_guard graph scope
        (SOME(SCEFutureArgument {name,ty,child}))=
      case !child of NONE=>() | SOME held=>
        let val node=G.closure_child_node graph scope held
            val term=G.representative graph node
            val(actual,domain)=if Term.is_var term then Term.dest_var term
              else raise ERR "source_argument_guard"
                "bound argument is not a genuine variable"
        in if G.node_scope graph node=scope andalso actual=name andalso
            Type.compare(domain,ty)=EQUAL then ()else
          raise ERR "source_argument_guard"
            "bound argument name, type or actual frame changed"end

  datatype sce_argument_clause_plan=SCEArgumentClausePlan of
    {work:W.portfolio,evidence:source_condition_evidence,
     frame:Scope.receipt,graph:G.graph,caller:G.scope,scope:G.scope,
     children:G.closure_child list,initial:sr_tree,
     instructions:sce_clause_instruction list,terminal:source_rule_terminal,
     result:sr_tree,conditions:sr_tree list,types:sr_type list,
     origin:sce_origin_tree,
     binders:(int*string*Type.hol_type) list,
     check_type:Type.hol_type -> unit,permutative:bool,used:bool ref,
     future:sce_future_argument option}
  fun sce_argument_clause_guard expected (SCEArgumentClausePlan
      {work,evidence,frame,graph,caller,scope,children,future,...})=
    sr_fail expected (fn()=>
      (if Portable.pointer_eq(expected,work) then () else
         raise ERR "source_condition_rule" "foreign expected Work";
       sce_guard expected evidence;
       let val d=Scope.description_for expected frame
       in if Portable.pointer_eq(#graph d,graph) andalso #scope d=scope
           then () else raise ERR "source_condition_rule" "frame changed"
       end;
       G.validate_scope graph caller;
       List.app(fn child=>ignore(G.closure_child_node graph caller child))
         children;
       sce_future_guard graph scope future))

  fun prepare_source_condition_argument_clause expected
      {evidence,frame,caller,steps,terminal,check_type,future}=
    sr_fail expected (fn()=>W.with_step expected (fn()=>
    let
      val d=sce_data expected evidence
      val source=Scope.description_for expected (#frame d)
      val actual=Scope.description_for expected frame
      val graph= #graph actual val scope= #scope actual
      val _=if Portable.pointer_eq(graph,#graph source) andalso
          Portable.pointer_eq(#sources actual,#sources source) andalso
          #root actual= #root source andalso
          G.scope_visible graph scope (#scope source) then () else
        raise ERR "prepare_source_condition_rule" "foreign Source frame"
      val _=if caller=scope then ()else raise ERR
        "prepare_source_argument" "caller must be the actual frame"
      val _=G.validate_scope graph caller
      val children=List.mapPartial
        (fn EvidenceStep(SourceSpec child)=>SOME child
        | EvidenceAntecedentExists child=>SOME child
        | EvidenceConditionForall child=>SOME child | _=>NONE) steps
      fun guard()=
        (sce_guard expected evidence;
         Scope.validate_lifetime_for expected frame;
         List.app(fn child=>ignore(G.closure_child_node graph caller child))
           children)
      fun tick n=(guard();W.spend expected n)
      val limits=W.semantic_limits expected
      val output=IntInf.fromInt(#output_limit limits)
      val template=IntInf.fromInt(#template_limit limits)
      val quota=IntInf.fromInt(W.work_limit expected)
      val budget=ref(0:IntInf.int)
      val policies=ref([]:sr_type list)
      val next=ref 0 val identifiers=ref([]:string list)
      val binders=ref([]:(int*string*Type.hol_type) list)
      fun append [] tail=tail
        | append(v::rest) tail=(tick 1;v::append rest tail)
      fun types (captured as SRCaptured ty)=
            (tick 1;captured::(if Type.is_vartype ty then
              (tick(String.size(Type.dest_vartype ty));[])
            else let val {Thy,Tyop,Args}=Type.dest_thy_type ty
                 in tick(String.size Thy+String.size Tyop);
                   List.foldr(fn(arg,all)=>append(types(SRCaptured arg)) all)
                     [] Args end))
        | types (arrow as SRArrow(a,b))=
            (tick 1;arrow::append(types a)(types b))
      fun atom shape ty=SRTree {ty=ty,shape=shape,raw=1,inc=1,
        annotations=types ty}
      fun app ty a b=SRTree {ty=ty,shape=SRApp(a,b),
        raw=1+sr_raw a+sr_raw b,inc=1+sr_inc a+sr_inc b,
        annotations=append(types ty)(append(sr_types a)(sr_types b))}
      fun lam ty id v b=SRTree {ty=ty,shape=SRLam(id,v,b),
        raw=1+sr_raw b,inc=2+sr_inc b,
        annotations=append(types ty)(append(sr_types v)(sr_types b))}
      fun remember term=if Term.is_var term then
        let val(name,_)=Term.dest_var term
        in tick(String.size name+1);identifiers:=name:: !identifiers end
        else ()
      fun find v []=NONE
        | find v ((old,id)::rest)=
            (tick 1;if sr_same v old then SOME id else find v rest)
      fun capture lexical origin term=
        (tick 1;remember term;
         let val ty=SRCaptured(Term.type_of term)
         in if Term.is_comb term then
              let val(a,b)=Term.dest_comb term
                  val(left,right)=case origin of NONE=>(NONE,NONE)
                    | SOME(SCOApp(x,y))=>(SOME x,SOME y)
                    | _=>raise ERR "prepare_source_condition_rule"
                        "authentic application origin geometry changed"
              in app ty (capture lexical left a)(capture lexical right b)end
            else if Term.is_abs term then
              let val(v,b)=Term.dest_abs term
                  val id= !next val _=next:=id+1 val _=remember v
                  val vt=SRCaptured(Term.type_of v)
                  val(original,body)=case origin of NONE=>(v,NONE)
                    | SOME(SCOLam(old,next))=>(old,SOME next)
                    | _=>raise ERR "prepare_source_condition_rule"
                        "authentic binder origin geometry changed"
              in lam ty id (atom(SRBound(id,original))vt)
                (capture((v,id)::lexical)body b)end
            else case find term lexical of
              SOME id=>atom(SRBound(id,term))ty
            | NONE=>atom(SRAtom term)ty end)
      fun bounded cap origin term=
        (case SmtReplayImport.bounded_raw_size cap term of
           SOME n=>tick n | NONE=>raise ERR "prepare_source_condition_rule"
             "bounded local raw operand";
         case SmtReplayImport.bounded_binder_size cap term of
           SOME n=>tick n | NONE=>raise ERR "prepare_source_condition_rule"
             "bounded local binder operand";
         capture [] origin term)
      val initial=bounded(#output_limit limits)
        (SOME(sce_lexical_origin_inside expected evidence))(#target d)
      val hyp=List.map(bounded(#template_limit limits)NONE)(Thm.hyp(#proof d))
      val rows=List.map(fn(value,_)=>
        bounded(#template_limit limits)NONE value)(#rows d)
      val args=List.map(fn child=>
        let val node=G.closure_child_node graph caller child
            val _=if G.scope_visible graph scope (G.node_scope graph node)
              then () else raise ERR "prepare_source_condition_rule"
                "argument escapes actual frame"
        in bounded(#output_limit limits)NONE(G.representative graph node) end)
        children
      val future_tree=case future of NONE=>NONE
        | SOME(SCEFutureArgument {name,ty,...})=>
            (tick(String.size name+1);
             identifiers:=name:: !identifiers;
             SOME(atom(SRFresh(name,ty))(SRCaptured ty)))
      fun fresh id ty=
        let fun choose n=
              let val name="__smt_sce_binder_"^Int.toString id^"_"^
                    Int.toString n
                  val _=tick(String.size name+1)
              in if List.exists(fn old=>(tick 1;old=name))(!identifiers)
                   then choose(n+1) else
                 (identifiers:=name:: !identifiers;name) end
        in binders:=(id,choose 0,ty):: !binders end
      fun name_binders(SRTree {shape,...})=case shape of
          SRApp(a,b)=>(name_binders a;name_binders b)
        | SRLam(id,v,b)=>(fresh id (case sr_type v of SRCaptured t=>t
              | _=>raise ERR "prepare_source_condition_rule" "binder type");
            name_binders b)
        | _=>()
      val _=List.app name_binders(initial::args)
      fun head thy name(SRTree {shape=SRAtom term,...})=
            Term.is_const term andalso
              let val c=Term.dest_thy_const term
              in #Thy c=thy andalso #Name c=name end
        | head _ _ _=false
      fun binary thy name(SRTree {shape=SRApp
          (SRTree {shape=SRApp(h,a),...},b),...})=
            if head thy name h then SOME(a,b) else NONE
        | binary _ _ _=NONE
      fun forall(SRTree {shape=SRApp(h,SRTree {shape=SRLam(id,v,b),...}),
                            ...})=
            if head "bool" "!" h then SOME(id,v,b) else NONE
        | forall _=NONE
      fun exists(SRTree {shape=SRApp(h,SRTree {shape=SRLam(id,v,b),...}),
                            ...})=
            if head "bool" "?" h then SOME(id,v,b) else NONE
        | exists _=NONE
      fun subst id arg (value as SRTree {ty,shape,...})=
        (tick 1;case shape of SRBound(old,_)=>if old=id then arg else value
        | SRApp(a,b)=>app ty (subst id arg a)(subst id arg b)
        | SRLam(old,v,b)=>if old=id then value else
            lam ty old v (subst id arg b)
        | _=>value)
      fun tcombine constant a b=
        let val bool=SRCaptured Type.bool
            val ty=SRCaptured(Term.type_of constant)
            val arrow=SRCaptured(#2(Type.dom_rng(Term.type_of constant)))
        in app bool (app arrow (atom(SRAtom constant)ty)a)b end
      fun timp a b=tcombine boolSyntax.implication a b
      fun tneg a=
        app (SRCaptured Type.bool)
          (atom(SRAtom boolSyntax.negation)
            (SRCaptured(Term.type_of boolSyntax.negation)))a
      fun typed_equality a b=
        let val domain=sr_type a val bool=SRCaptured Type.bool
            val arrow=SRArrow(domain,bool)
            val h=atom(SRAtom boolSyntax.equality)(SRArrow(domain,arrow))
        in app bool (app arrow h a)b end
      fun abstract id variable (value as SRTree {ty,shape,...})=
        (tick 1;case shape of SRAtom term=>
            if sr_same term variable then atom(SRBound(id,term))ty
            else value
          | SRApp(a,b)=>app ty (abstract id variable a)
              (abstract id variable b)
          | SRLam(old,v,b)=>lam ty old v (abstract id variable b)
          | _=>value)
      fun quantify issue argument condition=
        let val variable=case #shape(sr_data argument)of
              SRAtom term=>if Term.is_var term then term else
                raise ERR "source_rule_quantify" "actual variable required"
            | _=>raise ERR "source_rule_quantify" "actual variable required"
            val domain=sr_type argument
            val id= !next val _=next:=id+1
            val _=if issue then fresh id (Term.type_of variable) else ()
            val bool=SRCaptured Type.bool
            val predicate=lam (SRArrow(domain,bool))id
              (atom(SRBound(id,variable))domain)
              (abstract id variable condition)
            val constant=atom(SRAtom boolSyntax.universal)
              (SRArrow(SRArrow(domain,bool),bool))
        in app bool constant predicate end
      (* Strip SPEC routes WITHOUT substituting the owned arguments.
         Permutation is a property of this template, before matching. *)
      fun original_template [] [] current=current
        | original_template(step::rest)pending current=
            let val(next,pending)=case step of EvidenceStep(SourceSpec _)=>
                  (case forall current of
                    SOME(_,_,body)=>(body,tl pending) | _=>
                    raise ERR "source_rule_template" "forall route")
                | EvidenceStep(SourceConjunct left)=>
                    ((case binary "bool" "/\\" current of SOME(a,b)=>
                      if left then a else b | _=>
                        raise ERR "source_rule_template" "conjunct route"),
                      pending)

                | EvidenceStep SourceCondition=>
                    ((case binary "min" "==>" current of SOME(_,body)=>body
                      | _=>raise ERR "source_rule_template" "condition route"),
                      pending)

                | EvidenceAssertion=>
                    ((case binary "min" "=" current of SOME(a,b)=>
                      if head "bool" "T" b then a else
                        raise ERR "source_rule_template" "truth operand"
                     | _=>raise ERR "source_rule_template" "truth equality"),
                      pending)

                | EvidenceAntecedentConj=>
                    ((case binary "min" "==>" current of SOME(ant,body)=>
                      (case binary "bool" "/\\" ant of SOME(a,b)=>
                         timp a (timp b body) | _=>
                           raise ERR "source_rule_template" "conjunct ant")
                     | _=>raise ERR "source_rule_template" "implication"),
                      pending)

                | EvidenceAntecedentDisj left=>
                    ((case binary "min" "==>" current of SOME(ant,body)=>
                      (case binary "bool" "\\/" ant of SOME(a,b)=>
                         timp (if left then a else b)body | _=>
                           raise ERR "source_rule_template" "disjunct ant")
                     | _=>raise ERR "source_rule_template" "implication"),
                      pending)

                | EvidenceImpFalse=>
                    ((case binary "min" "==>" current of SOME(a,b)=>
                       if head "bool" "F" b then tneg a else
                         raise ERR "source_rule_template" "false consequence"
                     | _=>raise ERR "source_rule_template" "implication"),
                      pending)
                | EvidenceSymmetry=>
                    ((case binary "min" "=" current of SOME(a,b)=>
                        typed_equality b a
                      | _=>raise ERR "source_rule_template" "equality"),
                      pending)
                | EvidenceConditionForall _=>
                    let val(ant,result)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "source_rule_template" "implication"
                        val argument=case pending of v::_=>v | _=>
                          raise ERR "source_rule_template" "variable"
                    in(timp(quantify false argument ant)result,tl pending)end
                | EvidenceAntecedentExists _=>
                    let val(ant,result)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "source_rule_template" "implication"
                        val(id,_,body)=case exists ant of SOME triple=>triple
                          | _=>raise ERR "source_rule_template" "exists"
                        val argument=case pending of v::_=>v | _=>
                          raise ERR "source_rule_template" "witness"
                    in(timp(subst id argument body)result,tl pending)end
            in tick 1;original_template rest pending next end
        | original_template _ _ _=
            raise ERR "source_rule_template" "argument route mismatch"
      datatype template_variable=TemplateBound of int
        | TemplateFree of Term.term
      fun key_equal(TemplateBound a,TemplateBound b)=a=b
        | key_equal(TemplateFree a,TemplateFree b)=sr_same a b
        | key_equal _=false
      fun variable(SRTree {shape=SRBound(id,_),...})=SOME(TemplateBound id)
        | variable(SRTree {shape=SRAtom term,...})=
            if Term.is_var term then SOME(TemplateFree term) else NONE
        | variable _=NONE
      fun same_ty(SRCaptured a,SRCaptured b)=Type.compare(a,b)=EQUAL
        | same_ty(SRArrow(a,b),SRArrow(c,d))=same_ty(a,c)andalso same_ty(b,d)
        | same_ty _=false
      fun vperm a b=(tick 1;
        case(variable a,variable b)of(SOME _,SOME _)=>
            same_ty(sr_type a,sr_type b)
        | _=>case(#shape(sr_data a),#shape(sr_data b))of
            (SRApp(f,x),SRApp(g,y))=>vperm f g andalso vperm x y
          | (SRLam(_,_,x),SRLam(_,_,y))=>vperm x y
          | (SRAtom x,SRAtom y)=>Term.aconv x y
          | _=>false)
      fun fv tree=
        let fun member key all=List.exists
              (fn old=>(tick 1;key_equal(key,old)))all
            fun walk bound current all=(tick 1;
              case variable current of SOME(TemplateBound id)=>
                  if List.exists(fn old=>old=id)bound then all else
                    let val key=TemplateBound id
                    in if member key all then all else key::all end
              | SOME key=>if member key all then all else key::all
              | NONE=>case #shape(sr_data current)of
                  SRApp(a,b)=>walk bound b (walk bound a all)
                | SRLam(id,_,b)=>walk(id::bound)b all | _=>all)
        in walk [] tree [] end
      fun same_fv a b=
        List.all(fn x=>List.exists(fn y=>(tick 1;key_equal(x,y)))b)a
        andalso List.all(fn y=>List.exists
          (fn x=>(tick 1;key_equal(x,y)))a)b
      val original=original_template steps args initial
      val permutative=case terminal of SourceEquality=>
            (case binary "min" "=" original of SOME(a,b)=>
                vperm a b andalso same_fv(fv a)(fv b)
              | _=>raise ERR "source_rule_template" "original equality")
        | _=>false
      fun record cap hypotheses result=
        let val _=if sr_raw result<=cap andalso sr_inc result<=cap then ()
              else raise ERR "prepare_source_condition_rule"
                "prospective local result bound"
            val all=result::hypotheses
            val cost=List.foldl(fn(tree,n)=>(tick 1;
              n+sr_raw tree+sr_inc tree+
                IntInf.fromInt(length(sr_types tree)))) 0 all
            val _=budget:= !budget+cost
            val _=if !budget<=quota then () else
              raise ERR "prepare_source_condition_rule" "original Work"
        in policies:=List.foldr(fn(tree,all)=>append(sr_types tree)all)
          (!policies)all end
      val bool=SRCaptured Type.bool
      fun boolean term=atom(SRAtom term)bool
      fun combine constant a b=
        let val arrow=SRArrow(bool,bool)
            val h=atom(SRAtom constant)(SRArrow(bool,arrow))
        in app bool (app arrow h a)b end
      fun equality a b=combine boolSyntax.equality a b
      fun implication a b=combine boolSyntax.implication a b
      fun align conditions result=
        (record output conditions (equality result result);
         record output conditions result)
      val _=align hyp initial
      fun play [] [] current conditions instructions=
            (current,conditions,List.rev instructions)
        | play(step::rest) pending current conditions instructions=
            let val _=tick 1
                val(action,result,pending,conditions)=case step of
                  EvidenceStep(SourceSpec _)=>
                    let val(id,v,b)=case forall current of SOME d=>d
                          | NONE=>raise ERR "prepare_source_condition_rule"
                              "actual explicit forall required"
                        val arg=case pending of a::_=>a | _=>
                          raise ERR "prepare_source_condition_rule" "argument"
                        val _=case(sr_type v,sr_type arg)of
                          (SRCaptured a,SRCaptured b)=>
                            if Type.compare(a,b)=EQUAL then () else
                              raise ERR "prepare_source_condition_rule"
                                "SPEC argument type"
                        | _=>raise ERR "prepare_source_condition_rule" "type"
                        val _=record output [] arg
                    in(SCEClauseNative(SRSpec arg),subst id arg b,tl pending,
                      conditions)end
                | EvidenceStep(SourceConjunct left)=>
                    let val(a,b)=case binary "bool" "/\\" current of
                          SOME d=>d | NONE=>
                            raise ERR "prepare_source_condition_rule"
                              "actual conjunction required"
                    in(SCEClauseNative(SRConjunct left),
                      if left then a else b,pending,
                      conditions)end
                | EvidenceStep SourceCondition=>
                    let val(a,b)=case binary "min" "==>" current of
                          SOME d=>d | NONE=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val _=record output [a] a
                    in(SCEClauseNative SRCondition,b,pending,a::conditions)end
                | EvidenceAssertion=>
                    let val(a,b)=case binary "min" "=" current of
                          SOME d=>d | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual truth equality required"
                        val _=if head "bool" "T" b then () else
                          raise ERR "prepare_source_condition_rule"
                            "actual truth operand required"
                        val _=record output (append conditions hyp) current
                        val _=record output [] (boolean boolSyntax.T)
                    in(SCEClauseTruth,a,pending,conditions)end
                | EvidenceAntecedentConj=>
                    let val(ant,body)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val(a,b)=case binary "bool" "/\\" ant of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual conjunction antecedent required"
                        val held=append conditions hyp
                        val _=record output [a] a
                        val _=record output [b] b
                        val _=record output [a,b] ant
                        val _=record output (a::b::held)body
                        val right=implication b body
                        val _=record output (a::held)right
                        val result=implication a right
                    in(SCEClauseAnteConj,result,pending,conditions)end
                | EvidenceAntecedentDisj left=>
                    let val(ant,body)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val(a,b)=case binary "bool" "\\/" ant of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual disjunction antecedent required"
                        val selected=if left then a else b
                        val held=append conditions hyp
                        val _=record output [selected]selected
                        val _=record output [selected]ant
                        val _=record output (selected::held)body
                        val result=implication selected body
                    in(SCEClauseAnteDisj left,result,pending,conditions)end
                | EvidenceSymmetry=>
                    let val(a,b)=case binary "min" "=" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual equality required"
                    in(SCEClauseSymmetry,typed_equality b a,pending,
                      conditions)end
                | EvidenceConditionForall _=>
                    let val(ant,result)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val argument=case pending of a::_=>a | _=>
                          raise ERR "prepare_source_condition_rule" "variable"
                        val quantified=quantify true argument ant
                        val held=append conditions hyp
                        val _=record output [] argument
                        val _=record output [quantified]quantified
                        val _=record output [quantified]ant
                        val _=record output (quantified::held)result
                    in(SCEClauseConditionForall argument,
                      implication quantified result,tl pending,conditions)end
                | EvidenceAntecedentExists _=>
                    let val(ant,result)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val(id,v,body)=case exists ant of SOME triple=>triple
                          | _=>raise ERR "prepare_source_condition_rule"
                            "actual existential antecedent required"
                        val argument=case pending of a::_=>a | _=>
                          raise ERR "prepare_source_condition_rule" "witness"
                        val _=case #shape(sr_data argument)of SRAtom term=>
                            if Term.is_var term then () else
                              raise ERR "prepare_source_condition_rule"
                                "witness must be an actual variable"
                          | _=>raise ERR "prepare_source_condition_rule"
                              "witness must be an actual variable"
                        val _=if same_ty(sr_type v,sr_type argument)then ()
                          else raise ERR "prepare_source_condition_rule"
                            "existential witness type differs"
                        val instance=subst id argument body
                        val held=append conditions hyp
                        val _=record output [] argument
                        val _=record output [instance]instance
                        val _=record output [instance]ant
                        val _=record output (instance::held)result
                    in(SCEClauseAnteExists argument,
                      implication instance result,tl pending,conditions)end
                | EvidenceImpFalse=>
                    let val(ant,last)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val _=if head "bool" "F" last then () else
                          raise ERR "prepare_source_condition_rule"
                            "actual false consequent required"
                    in(SCEClauseNotIntro,tneg ant,pending,conditions)end
                val hypotheses=append conditions hyp
                val _=record output hypotheses result
                val _=align hypotheses result
            in play rest pending result conditions
              ((action,result,conditions)::instructions)end
        | play _ _ _ _ _=raise ERR "prepare_source_condition_rule" "route"
      val(body,conditions,instructions)=play steps args initial [] []
      val(body,conditions,instructions)=case future_tree of NONE=>
            (body,conditions,instructions)
        | SOME argument=>
            let val(ant,result)=case binary "min" "==>" body of
                  SOME pair=>pair | _=>raise ERR "prepare_source_argument"
                    "actual implication required"
                val(id,v,part)=case exists ant of SOME triple=>triple
                  | _=>raise ERR "prepare_source_argument"
                    "actual existential antecedent required"
                val _=if same_ty(sr_type v,sr_type argument)then ()else
                  raise ERR "prepare_source_argument"
                    "prospective argument type differs"
                val instance=subst id argument part
                val held=append conditions hyp
                val _=record output [] argument
                val _=record output [] instance
                val _=record output [instance]instance
                val _=record output [instance]ant
                val _=record output (instance::held)result
                val next=implication instance result
                val _=record output held next
                val _=align held next
                val extended=instance::conditions
                val _=record output [instance]instance
                val _=record output (append extended hyp)result
                val _=align (append extended hyp)result
            in (result,extended,instructions@[
              (SCEClauseAnteExists argument,next,conditions),
              (SCEClauseNative SRCondition,result,extended)])end
      val hypotheses=append conditions hyp
      val result=case terminal of SourceEquality=>
            (case binary "min" "=" body of SOME _=>body | _=>
              raise ERR "prepare_source_condition_rule" "equality required")
        | SourceTruth=>let val result=equality body(boolean boolSyntax.T)
              val _=record output hypotheses(equality result body)
            in result end
        | SourceFalse=>
            let val operand=case sr_data body of
                  {shape=SRApp(h,p),...}=>if head "bool" "~" h then p else
                    raise ERR "prepare_source_condition_rule" "negation"
                | _=>raise ERR "prepare_source_condition_rule" "negation"
                val result=equality operand(boolean boolSyntax.F)
                val _=record output hypotheses(equality body result)
            in result end
      val _=record output hypotheses result
      fun discharge [] current=current
        | discharge(condition::rest)current=
            let val next=implication condition current
                val _=record output (append rest hyp)next
            in discharge rest next end
      val final=discharge conditions result
      val _=record template hyp final
      val _=align hyp final
      (* Same balanced shape as the retained realization helper. *)
      fun balanced values=
        let fun size []=0 | size(_::rest)=(tick 1;1+size rest)
            fun split 0 pending left=(List.rev left,pending)
              | split n(v::rest)left=(tick 2;split(n-1)rest(v::left))
              | split _ _ _=raise ERR "prepare_source_condition_rule" "split"
            fun walk []=boolean boolSyntax.T | walk [v]=v
              | walk values=
                  let val(a,b)=split(size values div 2)values []
                  in combine boolSyntax.conjunction(walk a)(walk b)end
        in walk values end
      val context=balanced rows
      val _=record template [] context
      val _=record template [] (implication context final)
      val _=List.app(fn row=>record template [context]row)rows
      val _=record template [context]final
      val origin=sr_lexical_origin tick final
      val _=pay expected (!budget)
      val _=guard()
    in SCEArgumentClausePlan {work=expected,evidence=evidence,
      frame=frame,graph=graph,
      caller=caller,scope=scope,children=children,initial=initial,
      instructions=instructions,terminal=terminal,result=final,
      conditions=conditions,types= !policies,binders= !binders,
      origin=origin,
      check_type=check_type,permutative=permutative,used=ref false,
      future=future} end))
  fun execute_source_condition_argument_clause expected
      (plan as SCEArgumentClausePlan
        {evidence,frame,graph,caller,children,initial,
        instructions,terminal,result,conditions,types,binders,check_type,
        used,permutative,origin,future,...})=
    sr_fail expected (fn()=>
      (sce_argument_clause_guard expected plan;
       if !used then raise ERR "execute_source_condition_rule" "consumed"
         else ();
       W.with_step expected (fn()=>
       let
         val _=sce_argument_clause_guard expected plan val _=used:=true
         fun guarded operation=
           (sce_argument_clause_guard expected plan;
            let val value=operation()
            in sce_argument_clause_guard expected plan;value end)
         fun materialize(SRCaptured ty)=guarded(fn()=>ty)
           | materialize(SRArrow(a,b))=
               let val left=materialize a val right=materialize b
               in guarded(fn()=>Type.mk_thy_type
                 {Thy="min",Tyop="fun",Args=[left,right]})end
         (* The opaque ready phase completed every retained policy. *)
         val variables=List.map(fn(id,name,ty)=>
           (id,guarded(fn()=>Term.mk_var(name,ty))))binders
         fun bound id=case List.find(fn(old,_)=>old=id)variables of
             SOME(_,term)=>term | _=>raise ERR "execute_source_condition_rule"
               "missing lexical binder"
         fun emit(SRTree {shape,...})=case shape of SRAtom term=>term
           | SRBound(id,_)=>bound id
           | SRFresh(name,ty)=>guarded(fn()=>
               case future of SOME(SCEFutureArgument
                   {name=held,ty=actual,child,...})=>
                 if name=held andalso Type.compare(ty,actual)=EQUAL then
                   (case !child of SOME argument=>
                      G.representative graph
                        (G.closure_child_node graph
                          (#scope(Scope.description_for expected frame))
                          argument)
                    | NONE=>raise ERR "execute_source_argument"
                        "argument has not been bound")
                 else raise ERR "execute_source_argument"
                   "prospective argument identity changed"
               | NONE=>raise ERR "execute_source_condition_rule"
                   "unexpected external vocabulary")
           | SRLam(id,_,body)=>
               let val term=emit body
               in guarded(fn()=>Term.mk_abs(bound id,term))end
           | SRApp(SRTree {shape=SRAtom h,...},
               (argument as SRTree {shape=SRLam(id,_,body),...}))=>
               if Term.is_const h andalso
                   Term.same_const h boolSyntax.universal then
                 let val term=emit body
                 in guarded(fn()=>boolSyntax.mk_forall(bound id,term))end
               else let val term=emit argument
                    in guarded(fn()=>Term.mk_comb(h,term))end
           | SRApp(SRTree {shape=SRApp
               (SRTree {shape=SRAtom h,...},a),...},b)=>
               if Term.is_const h andalso
                   Term.same_const h boolSyntax.equality then
                 let val left=emit a val right=emit b
                 in guarded(fn()=>boolSyntax.mk_eq(left,right))end
               else let val argument=emit a
                        val operator=guarded(fn()=>Term.mk_comb(h,argument))
                        val operand=emit b
                    in guarded(fn()=>Term.mk_comb(operator,operand))end
           | SRApp(a,b)=>let val left=emit a val right=emit b
               in guarded(fn()=>Term.mk_comb(left,right))end
         fun align term theorem=
           if Portable.pointer_eq(Thm.concl theorem,term) then theorem
           else let val bridge=guarded(fn()=>
                      SmtReplayRuleObservation.ALPHA(Thm.concl theorem)term)
             in guarded(fn()=>SmtReplayRuleObservation.EQ_MP bridge theorem)
             end
         val d=sce_data expected evidence
         val initial=align(emit initial)(#proof d)
         fun play [] theorem=theorem
           | play((action,next,_)::rest)theorem=
               let val theorem=case action of SCEClauseNative(SRSpec arg)=>
                     let val term=emit arg
                     in guarded(fn()=>
                       SmtReplayRuleObservation.SPEC term theorem)end
                   | SCEClauseNative(SRConjunct left)=>
                     guarded(fn()=>if left then
                       SmtReplayRuleObservation.CONJUNCT1 theorem else
                       SmtReplayRuleObservation.CONJUNCT2 theorem)
                   | SCEClauseNative SRCondition=>
                       let val condition= #1
                             (boolSyntax.dest_imp(Thm.concl theorem))
                           val premise=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME condition)
                       in guarded(fn()=>
                         SmtReplayRuleObservation.MP theorem premise)end
                   | SCEClauseTruth=>guarded(fn()=>Drule.EQT_ELIM theorem)
                   | SCEClauseAnteConj=>
                       let val(ant,_)=boolSyntax.dest_imp_only
                             (Thm.concl theorem)
                           val(a,b)=boolSyntax.dest_conj ant
                           val pa=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME a)
                           val pb=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME b)
                           val both=guarded(fn()=>
                             SmtReplayRuleObservation.CONJ pa pb)
                           val body=guarded(fn()=>
                             SmtReplayRuleObservation.MP theorem both)
                           val right=guarded(fn()=>
                             SmtReplayRuleObservation.DISCH b body)
                       in guarded(fn()=>
                         SmtReplayRuleObservation.DISCH a right)end
                   | SCEClauseAnteDisj left=>
                       let val(ant,_)=boolSyntax.dest_imp_only
                             (Thm.concl theorem)
                           val(a,b)=boolSyntax.dest_disj ant
                           val selected=if left then a else b
                           val assumption=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME selected)
                           val either=guarded(fn()=>if left then
                             SmtReplayRuleObservation.DISJ1 assumption b
                             else SmtReplayRuleObservation.DISJ2 a assumption)
                           val body=guarded(fn()=>
                             SmtReplayRuleObservation.MP theorem either)
                       in guarded(fn()=>
                         SmtReplayRuleObservation.DISCH selected body)end
                   | SCEClauseSymmetry=>guarded(fn()=>
                       SmtReplayRuleObservation.SYM theorem)
                   | SCEClauseConditionForall argument=>
                       let val(ant,_)=boolSyntax.dest_imp_only
                             (Thm.concl theorem)
                           val variable=emit argument
                           val quantified=guarded(fn()=>
                             boolSyntax.mk_forall(variable,ant))
                           val assumption=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME quantified)
                           val condition=guarded(fn()=>
                             SmtReplayRuleObservation.SPEC variable assumption)
                           val result=guarded(fn()=>
                             SmtReplayRuleObservation.MP theorem condition)
                       in guarded(fn()=>
                         SmtReplayRuleObservation.DISCH quantified result)end
                   | SCEClauseAnteExists argument=>
                       let val(ant,_)=boolSyntax.dest_imp_only
                             (Thm.concl theorem)
                           val(v,body)=boolSyntax.dest_exists ant
                           val witness=emit argument
                           val instance=guarded(fn()=>Term.subst
                             [{redex=v,residue=witness}]body)
                           val assumption=guarded(fn()=>
                             SmtReplayRuleObservation.ASSUME instance)
                           val existential=guarded(fn()=>
                             Thm.EXISTS(ant,witness)assumption)
                           val result=guarded(fn()=>
                             SmtReplayRuleObservation.MP theorem existential)
                       in guarded(fn()=>
                         SmtReplayRuleObservation.DISCH instance result)end
                   | SCEClauseNotIntro=>guarded(fn()=>
                       Thm.NOT_INTRO theorem)
               in play rest (align(emit next)theorem)end
         val body=play instructions initial
         val body=case terminal of SourceEquality=>body
           | SourceTruth=>guarded(fn()=>Drule.EQT_INTRO body)
           | SourceFalse=>guarded(fn()=>Drule.EQF_INTRO body)
         val proof=List.foldl(fn(condition,theorem)=>
           let val value=emit condition
           in guarded(fn()=>SmtReplayRuleObservation.DISCH value theorem)end)
           body conditions
         val proof=align(emit result)proof
         val _=if clean proof then () else
           raise ERR "execute_source_condition_rule" "proof provenance"
         val value=SCEApplied {work=expected,frame=frame,parents=[evidence],
           proof=proof,target=Thm.concl proof,names= #names d,rows= #rows d,
           origin=origin,
           constructor_origins=NONE,
             effect_origins=NONE,
             realized=ref NONE}
         val retained=SCEProjected {work=expected,graph=graph,caller=caller,
           children=(case future of
             SOME(SCEFutureArgument {child,...})=>(case !child of
               SOME argument=>argument::children | NONE=>raise ERR
                 "execute_source_argument" "missing retained argument")
           | NONE=>raise ERR "execute_source_argument"
               "missing prospective argument"),
           value=value,permutative=SOME permutative}
         val _=sce_guard expected retained
       in retained end)))

  datatype source_argument_phase=ArgumentPrepared | ArgumentAdmitting
    | ArgumentAdmitted
    | ArgumentConsumed | ArgumentDead
  datatype source_condition_argument_plan=SourceConditionArgumentPlan of
    {work:W.portfolio,plan:sce_argument_clause_plan,
     phase:source_argument_phase ref}
  datatype source_condition_argument_ready=SourceConditionArgumentReady of
    source_condition_argument_plan
  fun source_argument_guard expected
      (SourceConditionArgumentPlan {work,plan,phase})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work)then ()else
         raise ERR "source_argument_guard" "foreign expected Work";
       if !phase=ArgumentDead then raise ERR "source_argument_guard"
         "argument plan is retired"else ();
       sce_argument_clause_guard expected plan))
  fun source_argument_operation expected
      (value as SourceConditionArgumentPlan {work,phase,...})operation=
    (if Portable.pointer_eq(expected,work)then
       (operation()handle primary=>
         (phase:=ArgumentDead;W.close expected;raise primary))
     else (W.close expected;raise ERR "source_argument"
       "foreign expected Work"))
  fun prepare_source_condition_exists_argument expected
      {evidence,frame,caller,name,ty,check_type}=
    sr_fail expected(fn()=>
    let
      val steps=W.with_step expected(fn()=>
        let val d=sce_data expected evidence
            fun tick n=(sce_guard expected evidence;
              Scope.validate_lifetime_for expected frame;W.spend expected n)
            fun guarded operation=
              (tick 1;let val value=operation()in tick 1;value end)
            fun prefix term=
              (tick 1;if boolSyntax.is_imp_only term then
                 let val(ant,body)=guarded(fn()=>
                       boolSyntax.dest_imp_only term)
                 in if boolSyntax.is_exists ant then []else
                   EvidenceStep SourceCondition::prefix body end
               else raise ERR "prepare_source_argument"
                 "actual implication spine has no existential antecedent")
            val(lhs,rhs)=guarded(fn()=>boolSyntax.dest_eq(#target d))
            val _=if Term.is_const rhs andalso
                Term.same_const rhs boolSyntax.T then ()else
              raise ERR "prepare_source_argument"
                "actual assertion equality required"
        in EvidenceAssertion::prefix lhs end)
      val future=SCEFutureArgument {name=name,ty=ty,child=ref NONE}
      val plan=prepare_source_condition_argument_clause expected
        {evidence=evidence,frame=frame,caller=caller,steps=steps,
         terminal=SourceTruth,check_type=check_type,future=SOME future}
      val result=SourceConditionArgumentPlan
        {work=expected,plan=plan,phase=ref ArgumentPrepared}
      val _=source_argument_guard expected result
    in result end)
  fun admit_source_condition_exists_argument expected
      (value as SourceConditionArgumentPlan
        {plan=plan as SCEArgumentClausePlan {types,check_type,...},phase,...})=
    source_argument_operation expected value(fn()=>
      (source_argument_guard expected value;
       if !phase=ArgumentPrepared then ()else raise ERR
         "admit_source_argument" "plan already admitted or consumed";
       phase:=ArgumentAdmitting;
       W.with_step expected(fn()=>
       let
         fun guarded operation=
           (source_argument_guard expected value;
            let val result=operation()
            in source_argument_guard expected value;result end)
         fun materialize(SRCaptured ty)=guarded(fn()=>ty)
           | materialize(SRArrow(a,b))=
               let val left=materialize a val right=materialize b
               in guarded(fn()=>Type.mk_thy_type
                 {Thy="min",Tyop="fun",Args=[left,right]})end
         val actual=List.map materialize types
         val _=List.app(fn ty=>guarded(fn()=>check_type ty))actual
         val _=source_argument_guard expected value
         val _=phase:=ArgumentAdmitted
       in SourceConditionArgumentReady value end)))
  fun source_condition_argument_ready_for expected
      (SourceConditionArgumentReady(value as SourceConditionArgumentPlan
        {plan=SCEArgumentClausePlan {frame,future,...},phase,...}))=
    source_argument_operation expected value(fn()=>
      (source_argument_guard expected value;
       if !phase=ArgumentAdmitted then ()else raise ERR
         "source_argument_ready" "ready is not available";
       case future of SOME(SCEFutureArgument {name,ty,...})=>
         {frame=frame,name=name,ty=ty}
       | NONE=>raise ERR "source_argument_ready" "missing quoted argument"))
  fun execute_source_condition_exists_argument expected
      {ready=SourceConditionArgumentReady
         (value as SourceConditionArgumentPlan
           {plan=plan as SCEArgumentClausePlan
              {frame,graph,future,...},phase,...}),
       argument}=
    source_argument_operation expected value(fn()=>
      (source_argument_guard expected value;
       if !phase=ArgumentAdmitted then ()else raise ERR
         "execute_source_argument" "ready already consumed";
       W.with_step expected(fn()=>
         let val _=source_argument_guard expected value
             val scope= #scope(Scope.description_for expected frame)
             val future=case future of SOME held=>held | NONE=>
               raise ERR "execute_source_argument" "missing quoted argument"
             val SCEFutureArgument {child,...}=future
             val _=if Option.isSome(!child)then raise ERR
               "execute_source_argument" "argument already bound"else ()
             val _=child:=SOME argument
             val _=sce_future_guard graph scope(SOME future)
             val _=source_argument_guard expected value
         in ()end);
       let val result=execute_source_condition_argument_clause expected
             plan
           val _=source_argument_guard expected value
           val _=phase:=ArgumentConsumed
       in result end))

  (* Private SAME-cache reader. Call only inside the owner's Busy action.
     These groups count written Source events, not a whole kernel tariff. *)
  val ncc_origin_export_group=length
    ["entry","singleton pattern","thunk call","unit argument",
     "private producer cell read",
     "statement capture","proof capture","bare capture","closed capture",
     "passive Tag call","Tag result","record statement","record tag",
     "record bare","record closed","record publication","return"]
  val ncc_old_export_group=length
    ["entry","singleton pattern","thunk call","unit argument",
     "private producer cell read",
     "proof capture","first capture","second capture","third capture",
     "record proof","record first","record second","record third",
     "record publication","return"]
  val ncc_export_group=ncc_origin_export_group+ncc_old_export_group+length
    ["unit selector entry","singleton constructor","selector return",
     "reader template bind","reader law bind","reader origin bind",
     "reader tuple publication","reader return"]
  val ncc_prepare_group=length
    ["entry","Sources getter","graph getter","root getter",
     "limits getter","guard closure","guard call","Type epoch",
     "Term epoch","grammar root","pending stack","ports ref",
     "pairs ref","names ref","Types ref","result record",
     "metadata record","result publication","return"]
  val ncc_grammar_group=length
    ["loop entry","stack case","head pair","tail bind","shape case",
     "VAR flag","outer COMB flag","outer COMB destructor",
     "inner COMB flag","inner COMB destructor","head CONST flag",
     "constructor identity","identity branch","ports triple",
     "port cons 1","port cons 2","port cons 3","pending pair 1",
     "pending pair 2","pending cell 1","pending cell 2","pair record",
     "pair cell","tail call"]
  val ncc_type_group=length
    ["Type loop","stack case","head bind","bound comparison",
     "bound branch","Type variable flag","Type destructor",
     "name fields","byte sizes","byte model","name comparison",
     "argument schedule","stack cell","counter addition","tail call"]
  val ncc_port_group=length
    ["port loop","list case","Type getter","Type profile call",
     "VAR flag","VAR destructor","CONST flag","CONST destructor",
     "name fields","byte sizes","byte model","counter addition",
     "Type profile result","profile return binding","port-name branch",
     "tail call"]
  val ncc_schedule_group=length
    ["entry","first parameter cell","second parameter cell",
     "third parameter cell","port tail","schedule binding","return"]
  val ncc_freshness_group=length
    ["entry","list case","head bind","full term freshness call",
     "validity branch","tail argument","tail call"]
  val ncc_pair_group=length
    ["pair loop","list case","actual VAR destructor","held VAR destructor",
     "two byte sizes","byte model","name equality","Type getters",
     "Type comparison","comparison branches","tail call"]
  val ncc_guard_group=ncc_export_group+length
    ["entry","owner comparison","owner branch","Work context",
     "Type epoch","Term epoch","two stamp comparisons","stamp branch",
     "cached selector","cached getters","proof comparison",
     "statement comparison","first comparison","second comparison",
     "third comparison","Tag comparison","bare comparison",
     "closed comparison","identity branches","context fence","return"]
  val ncc_fact_group=length
    ["entry","cache guard","frame lifetime","frame description",
     "fact pattern","graph comparison","graph branch","template getter",
     "template comparison","template branch","original identity argument",
     "original pointer comparison","original identity branch",
     "fact validation",
     "original getter","proof comparison","statement getter",
     "statement comparison","Tag getter","Tag comparison",
     "identity branches","ports result","return"]
  type ncc_law_ports={proof:Thm.thm,first:Term.term,second:Term.term,
    third:Term.term}
  type ncc_origin_ports={statement:Term.term,tag:Tag.tag,
    bare:bool,closed:bool}
  datatype nc_conj_cache=NCConjCache of
    {work:W.portfolio,graph:G.graph,root:G.scope,
     sources:SmtReplaySource.sources,limits:W.limits,epoch:int,symbols:int,
     template:SmtReplayConj.conj_discharge_template,law:ncc_law_ports,
     origin:ncc_origin_ports,type_nodes:int,name_bytes:int}
  fun ncc_fail text=raise ERR "conj_cache_read" text
  fun ncc_context expected graph root sources limits=
    W.validate expected graph root sources limits
  (* Re-read the fixed producer. No caller tuple can enter this reader. *)
  fun ncc_export ()=
    let val template=SmtReplayConj.conj_discharge_template()
        val law=SmtReplayConj.conj_discharge_template_data template
        val origin=SmtReplayConj.conj_discharge_constructor_data template
    in(template,law,origin)end
  fun guard_conj_cache_inside_using expected
      (NCConjCache{work,graph,root,sources,limits,epoch,symbols,
        law,origin,...})debit=
    (if Portable.pointer_eq(expected,work)then ()else
       ncc_fail "foreign expected Work";
     ncc_context expected graph root sources limits;
     debit ncc_guard_group;
     if Type.type_epoch()=epoch andalso Term.term_epoch()=symbols then ()
       else ncc_fail "cached read epoch changed";
     let val(_,actual,current)=ncc_export()
     in if Portable.pointer_eq(#proof actual,#proof law)andalso
         Portable.pointer_eq(#first actual,#first law)andalso
         Portable.pointer_eq(#second actual,#second law)andalso
         Portable.pointer_eq(#third actual,#third law)andalso
         Portable.pointer_eq(#statement current,#statement origin)andalso
         Portable.pointer_eq(#tag current,#tag origin)andalso
         #bare current= #bare origin andalso #closed current= #closed origin
       then ()else ncc_fail "fixed producer changed"end;
     ncc_context expected graph root sources limits)
  fun guard_conj_cache_inside expected value=
    guard_conj_cache_inside_using expected value(W.spend expected)
  fun prepare_conj_cache_inside expected=
    let val _=W.spend expected(ncc_prepare_group+ncc_export_group)
        val sources=W.original_sources expected
        val graph=SmtReplaySource.owning_graph sources
        val root=SmtReplaySource.owning_scope sources
        val limits=W.semantic_limits expected
        fun guard()=ncc_context expected graph root sources limits
        val _=guard()
        val epoch=Type.type_epoch()val symbols=Term.term_epoch()
        val(template,law:ncc_law_ports,origin:ncc_origin_ports)=ncc_export()
        val _=if #bare origin andalso #closed origin then ()else
          ncc_fail "fixed producer lacks closed bare origin"
        val _=W.spend expected ncc_grammar_group
        val _=if Portable.pointer_eq(#statement origin,
              Thm.concl(#proof law))andalso null(Thm.hyp(#proof law))
            andalso Portable.pointer_eq(#tag origin,Thm.tag(#proof law))
          then ()else ncc_fail "cache proof or closed origin differs"
        datatype pattern=First | Second | Third
          | Imp of pattern*pattern | Conj of pattern*pattern
        val schema=Imp(Imp(First,Imp(Second,Third)),
          Imp(Conj(First,Second),Third))
        val ports=ref[]:Term.term list ref
        val pairs=ref[]:(Term.term*Term.term)list ref
        fun leaf actual wanted=
          if Term.is_var actual andalso Term.is_var wanted then
            (ports:=actual:: !ports;pairs:=(actual,wanted):: !pairs)
          else ncc_fail "fixed schema variable changed"
        fun application term=
          if Term.is_comb term then Term.dest_comb term else
            ncc_fail "fixed schema application changed"
        fun binary constant left right term rest=
          let val(operator,b)=application term
              val(head,a)=application operator
              val _=if Term.is_const head andalso
                  Term.same_const head constant then ()else
                ncc_fail "fixed schema connective changed"
              val _=ports:=term::operator::head:: !ports
          in(a,left)::(b,right)::rest end
        fun grammar []=()
          | grammar((actual,pattern)::rest)=
            let val _=W.spend expected ncc_grammar_group
                val next=case pattern of
                  First=>(leaf actual(#first law);rest)
                | Second=>(leaf actual(#second law);rest)
                | Third=>(leaf actual(#third law);rest)
                | Imp(a,b)=>binary boolSyntax.implication a b actual rest
                | Conj(a,b)=>binary boolSyntax.conjunction a b actual rest
            in grammar next end
        val _=grammar[(#statement origin,schema)]
        val name_bytes=ref 0 val type_nodes=ref 0
        fun bytes a b=
          let val amount=String.size a+String.size b
              val _=W.spend expected amount
          in name_bytes:= !name_bytes+amount end
        fun profile_type initial=
          let fun add [] rest=rest
                | add(t::ts)rest=(W.spend expected ncc_type_group;
                    add ts(t::rest))
              fun loop [] count=count
                | loop(ty::rest)count=
                  let val _=W.spend expected ncc_type_group
                      val _=if count<32 then ()else
                        ncc_fail "fixed Type grammar exceeds bound"
                  in if Type.is_vartype ty then
                       ncc_fail "fixed Boolean Type variable"
                     else let val{Thy,Tyop,Args}=Type.dest_thy_type ty
                          val _=bytes Thy Tyop
                          val _=if Thy="min"andalso
                              (Tyop="bool"orelse Tyop="fun")then ()else
                            ncc_fail "fixed Boolean Type changed"
                       in loop(add Args rest)(count+1)end end
              val count=loop[initial]0
              val _=W.spend expected ncc_type_group
              val _=if Type.uptodate_type initial then ()else
                ncc_fail "fixed Type declaration retired"
          in type_nodes:= !type_nodes+count end
        fun profile []=()
          | profile(term::rest)=
            let val _=W.spend expected ncc_port_group
                val _=profile_type(Term.type_of term)
                val _=if Term.is_var term then
                    let val(name,_)=Term.dest_var term in bytes "" name end
                  else if Term.is_const term then
                    let val{Name,Thy,...}=Term.dest_thy_const term
                    in bytes Thy Name end else ()
            in profile rest end
        val _=W.spend expected ncc_schedule_group
        val current_ports= #first law:: #second law:: #third law:: !ports
        val _=profile current_ports
        fun agree []=()
          | agree((actual,wanted)::rest)=
            let val _=W.spend expected ncc_pair_group
                val(a,ta)=Term.dest_var actual
                val(b,tb)=Term.dest_var wanted
                val _=bytes a b
                val _=if a=b andalso Type.compare(ta,tb)=EQUAL andalso
                    Type.compare(tb,Type.bool)=EQUAL then ()else
                  ncc_fail "fixed original parameter differs"
            in agree rest end
        val _=agree(!pairs)
        (* ALL port Types, names and typed parameter relations precede
           the first recursive term declaration check. *)
        fun freshness []=()
          | freshness(term::rest)=
            (W.spend expected ncc_freshness_group;
             if Term.uptodate_term term then ()else
               ncc_fail "fixed term declaration retired";
             freshness rest)
        val _=freshness current_ports
        val _=guard()
        val value=NCConjCache{work=expected,graph=graph,root=root,
          sources=sources,limits=limits,epoch=epoch,symbols=symbols,
          template=template,law=law,origin=origin,type_nodes= !type_nodes,
          name_bytes= !name_bytes}
        val _=guard_conj_cache_inside expected value
    in value end
  (* Current-cache guard runs first. The genuine fact graph identity is
     then checked BEFORE activating that fact or its closed scope. *)
  fun conj_cache_fact_for_inside_using expected value frame fact debit=
    let val _=guard_conj_cache_inside_using expected value debit
        val _=debit ncc_fact_group
        val NCConjCache{graph,limits,law,origin,...}=value
        val _=case fact of PolicyRealizedClosedFact _=>
              ncc_fail "policy fact requires policy law programme" | _=>()
        val ClosedFact{graph=owner,original,template_limit,...}=fact
        val _=Scope.validate_lifetime_for expected frame
        val actual=Scope.description_for expected frame
        val _=if Portable.pointer_eq(graph,#graph actual)andalso
            Portable.pointer_eq(graph,owner)then ()else
          ncc_fail "different genuine fact graph"
        val _=if template_limit= #template_limit limits then ()else
          ncc_fail "different original template cap"
        val _=if Portable.pointer_eq(original,#proof law)then ()else
          ncc_fail "different actual cached proof"
        val _=validate_closed_fact graph(#scope actual)
          (#template_limit limits)fact
        val proof=closed_original fact
        val _=if Portable.pointer_eq(proof,#proof law)andalso
            Portable.pointer_eq(original,#proof law)andalso
            Portable.pointer_eq(Thm.concl proof,#statement origin)andalso
            Portable.pointer_eq(Thm.tag proof,#tag origin)then ()else
          ncc_fail "different actual cached proof"
        val _=guard_conj_cache_inside_using expected value debit
    in law end
  fun conj_cache_fact_for_inside expected value frame fact=
    conj_cache_fact_for_inside_using expected value frame fact
      (W.spend expected)

  datatype scr_conj_envelope=SCRConjEnvelope of
    {statement:Term.term,first:Term.term,second:Term.term,third:Term.term,
     fact:closed_fact option ref,import:G.import_plan option ref,
     required:bool ref,ants:Term.term list ref,expected:Term.term list ref}
  fun scr_conj_shape(SCRConjEnvelope{statement,first,second,third,...})=
    let fun variable term=Term.is_var term andalso
          Type.compare(Term.type_of term,Type.bool)=EQUAL
        fun exact term wanted=variable term andalso Term.term_eq term wanted
        val _=if List.all variable[first,second,third]andalso
            not(Term.term_eq first second)andalso
            not(Term.term_eq first third)andalso
            not(Term.term_eq second third)then ()else raise ERR
          "predicate_conditional" "fixed distinct Bool parameters required"
        (* Each destructor opens an application only; no Abs or metric. *)
        val(input,output)=boolSyntax.dest_imp_only statement
        val(p,qr)=boolSyntax.dest_imp_only input
        val(q,r)=boolSyntax.dest_imp_only qr
        val(pq,r')=boolSyntax.dest_imp_only output
        val(p',q')=boolSyntax.dest_conj pq
    in if exact p first andalso exact p' first andalso exact q second
        andalso exact q' second andalso exact r third andalso exact r' third
      then if Term.uptodate_term statement then ()else raise ERR
        "predicate_conditional" "stale fixed schema"
      else raise ERR "predicate_conditional"
        "different captured conjunction schema"end
  fun scr_conj_guard expected frame(SCRConjEnvelope
      {statement,fact,required,...})=
    let val _=Scope.validate_lifetime_for expected frame
        val d=Scope.description_for expected frame
    in case !fact of NONE=>() | SOME law=>
      (validate_closed_fact(#graph d)(#scope d)
         (#template_limit(W.semantic_limits expected))law;
       if !required andalso null(Thm.hyp(closed_original law))andalso
           clean(closed_original law)andalso Portable.pointer_eq
             (Thm.concl(closed_original law),statement)then ()else raise ERR
         "predicate_conditional" "different actual closed fixed law")end

  datatype scr_future_kind=SCRExists | SCRSpecs
  datatype scr_action=SCRNative of sce_clause_action | SCRDischarge of sr_tree
    | SCRPredicateTruth | SCRConjClose of sr_tree*Term.term*bool
  type scr_instruction=scr_action*sr_tree*sr_tree list
  datatype scr_clause_plan=SCRClausePlan of
    {work:W.portfolio,evidence:source_condition_evidence,
     frame:Scope.receipt,graph:G.graph,caller:G.scope,scope:G.scope,
     children:G.closure_child list,initial:sr_tree,
     instructions:scr_instruction list,terminal:source_rule_terminal,
     result:sr_tree,conditions:sr_tree list,types:sr_type list,
     origin:sce_origin_tree,
     binders:(int*string*Type.hol_type) list,
     check_type:Type.hol_type -> unit,permutative:bool,used:bool ref,
     future:sce_future_argument list,
     closing:scr_conj_envelope option,
     condition_origins:sce_origin_tree list}
  fun scr_clause_guard expected (SCRClausePlan
      {work,evidence,frame,graph,caller,scope,children,future,closing,...})=
    sr_fail expected (fn()=>
      (if Portable.pointer_eq(expected,work) then () else
         raise ERR "source_condition_rule" "foreign expected Work";
       sce_guard expected evidence;
       let val d=Scope.description_for expected frame
       in if Portable.pointer_eq(#graph d,graph) andalso #scope d=scope
           then () else raise ERR "source_condition_rule" "frame changed"
       end;
       G.validate_scope graph caller;
       List.app(fn child=>ignore(G.closure_child_node graph caller child))
         children;
       List.app(fn held=>sce_future_guard graph scope(SOME held))future;
       case closing of NONE=>() | SOME data=>
         scr_conj_guard expected frame data))

  fun prepare_source_canonical_clause_inside expected closing
      {evidence,steps,pending,finish,check_type,future,kind}=
    sr_fail expected (fn()=>W.with_step expected (fn()=>
    let
      val d=sce_data expected evidence
      val frame= #frame d val terminal=SourceTruth
      val source=Scope.description_for expected (#frame d)
      val actual=Scope.description_for expected frame
      val graph= #graph actual val scope= #scope actual
      val caller=scope
      val _=if Portable.pointer_eq(graph,#graph source) andalso
          Portable.pointer_eq(#sources actual,#sources source) andalso
          #root actual= #root source andalso
          G.scope_visible graph scope (#scope source) then () else
        raise ERR "prepare_source_condition_rule" "foreign Source frame"
      val _=if caller=scope then ()else raise ERR
        "prepare_source_argument" "caller must be the actual frame"
      val _=G.validate_scope graph caller
      val children=List.mapPartial
        (fn EvidenceStep(SourceSpec child)=>SOME child
        | EvidenceAntecedentExists child=>SOME child
        | EvidenceConditionForall child=>SOME child | _=>NONE) steps
      fun guard()=
        (sce_guard expected evidence;
         Scope.validate_lifetime_for expected frame;
         List.app(fn child=>ignore(G.closure_child_node graph caller child))
           children)
      fun tick n=(guard();W.spend expected n)
      val limits=W.semantic_limits expected
      val output=IntInf.fromInt(#output_limit limits)
      val template=IntInf.fromInt(#template_limit limits)
      val quota=IntInf.fromInt(W.work_limit expected)
      val budget=ref(0:IntInf.int)
      val policies=ref([]:sr_type list)
      val next=ref 0 val identifiers=ref([]:string list)
      val binders=ref([]:(int*string*Type.hol_type) list)
      fun append [] tail=tail
        | append(v::rest) tail=(tick 1;v::append rest tail)
      fun types (captured as SRCaptured ty)=
            (tick 1;captured::(if Type.is_vartype ty then
              (tick(String.size(Type.dest_vartype ty));[])
            else let val {Thy,Tyop,Args}=Type.dest_thy_type ty
                 in tick(String.size Thy+String.size Tyop);
                   List.foldr(fn(arg,all)=>append(types(SRCaptured arg)) all)
                     [] Args end))
        | types (arrow as SRArrow(a,b))=
            (tick 1;arrow::append(types a)(types b))
      fun atom shape ty=SRTree {ty=ty,shape=shape,raw=1,inc=1,
        annotations=types ty}
      fun app ty a b=SRTree {ty=ty,shape=SRApp(a,b),
        raw=1+sr_raw a+sr_raw b,inc=1+sr_inc a+sr_inc b,
        annotations=append(types ty)(append(sr_types a)(sr_types b))}
      fun lam ty id v b=SRTree {ty=ty,shape=SRLam(id,v,b),
        raw=1+sr_raw b,inc=2+sr_inc b,
        annotations=append(types ty)(append(sr_types v)(sr_types b))}
      fun remember term=if Term.is_var term then
        let val(name,_)=Term.dest_var term
        in tick(String.size name+1);identifiers:=name:: !identifiers end
        else ()
      fun find v []=NONE
        | find v ((old,id)::rest)=
            (tick 1;if sr_same v old then SOME id else find v rest)
      fun capture lexical origin term=
        (tick 1;remember term;
         let val ty=SRCaptured(Term.type_of term)
         in if Term.is_comb term then
              let val(a,b)=Term.dest_comb term
                  val(left,right)=case origin of NONE=>(NONE,NONE)
                    | SOME(SCOApp(x,y))=>(SOME x,SOME y)
                    | _=>raise ERR "prepare_source_condition_rule"
                        "authentic application origin geometry changed"
              in app ty (capture lexical left a)(capture lexical right b)end
            else if Term.is_abs term then
              let val(v,b)=Term.dest_abs term
                  val id= !next val _=next:=id+1 val _=remember v
                  val vt=SRCaptured(Term.type_of v)
                  val(original,body)=case origin of NONE=>(v,NONE)
                    | SOME(SCOLam(old,next))=>(old,SOME next)
                    | _=>raise ERR "prepare_source_condition_rule"
                        "authentic binder origin geometry changed"
              in lam ty id (atom(SRBound(id,original))vt)
                (capture((v,id)::lexical)body b)end
            else case find term lexical of
              SOME id=>atom(SRBound(id,term))ty
            | NONE=>atom(SRAtom term)ty end)
      fun bounded cap origin term=
        (case SmtReplayImport.bounded_raw_size cap term of
           SOME n=>tick n | NONE=>raise ERR "prepare_source_condition_rule"
             "bounded local raw operand";
         case SmtReplayImport.bounded_binder_size cap term of
           SOME n=>tick n | NONE=>raise ERR "prepare_source_condition_rule"
             "bounded local binder operand";
         capture [] origin term)
      fun no_abs cap term=
        let fun walk [] count=()
              | walk(current::rest)count=
                  (tick 1;if count>=cap then raise ERR
                     "predicate_conditional" "original binder-free allowance"
                   else if Term.is_abs current then raise ERR
                     "predicate_conditional" "unwitnessed binder operand"
                   else if Term.is_comb current then
                     let val(a,b)=Term.dest_comb current
                     in walk(a::b::rest)(count+1)end
                   else walk rest(count+1))
        in walk[term]0 end
      fun mode_initial()=case closing of NONE=>() | SOME data=>
        (scr_conj_shape data;no_abs(#output_limit limits)(#target d))
      val _=mode_initial()
      val initial=bounded(#output_limit limits)
        (SOME(sce_lexical_origin_inside expected evidence))(#target d)
      val hyp=case closing of NONE=>
            List.map(bounded(#template_limit limits)NONE)(Thm.hyp(#proof d))
        | SOME _=>
            let val actual=Thm.hyp(#proof d)
                val known=sce_admitted_hyp_rows_inside expected evidence
                val _=if ListPair.allEq Portable.pointer_eq
                    (actual,List.map #1 known)then ()else raise ERR
                  "predicate_conditional" "actual Hyp portfolio changed"
                fun forest(term,SOME value)=
                      if sr_raw value<=template andalso sr_inc value<=template
                      then value else raise ERR "predicate_conditional"
                        "original actual Hyp allowance"
                  | forest(term,NONE)=
                      (no_abs(#template_limit limits)term;
                       bounded(#template_limit limits)NONE term)
            in List.map forest known end
      val rows=case closing of NONE=>List.map(fn(value,_)=>
            bounded(#template_limit limits)NONE value)(#rows d)
        | SOME _=>[]
      val args=List.map(fn child=>
        let val node=G.closure_child_node graph caller child
            val _=if G.scope_visible graph scope (G.node_scope graph node)
              then () else raise ERR "prepare_source_condition_rule"
                "argument escapes actual frame"
        in bounded(#output_limit limits)NONE(G.representative graph node) end)
        children
      val future_names=ref([]:string list)
      val future_trees=List.map
        (fn SCEFutureArgument {name,ty,...}=>
          (tick(String.size name+1);
           if List.exists(fn old=>(tick 1;old=name))(!future_names)then
             raise ERR "canonical_future" "duplicate quoted name"else ();
           future_names:=name:: !future_names;
           identifiers:=name:: !identifiers;
           atom(SRFresh(name,ty))(SRCaptured ty)))future
      val saved=List.map(fn(term,origin)=>
        bounded(#output_limit limits)(SOME origin)term)pending
      fun fresh id ty=
        let fun choose n=
              let val name="__smt_sce_binder_"^Int.toString id^"_"^
                    Int.toString n
                  val _=tick(String.size name+1)
              in if List.exists(fn old=>(tick 1;old=name))(!identifiers)
                   then choose(n+1) else
                 (identifiers:=name:: !identifiers;name) end
        in binders:=(id,choose 0,ty):: !binders end
      fun name_binders(SRTree {shape,...})=case shape of
          SRApp(a,b)=>(name_binders a;name_binders b)
        | SRLam(id,v,b)=>(fresh id (case sr_type v of SRCaptured t=>t
              | _=>raise ERR "prepare_source_condition_rule" "binder type");
            name_binders b)
        | _=>()
      val _=List.app name_binders(initial::args@saved)
      fun head thy name(SRTree {shape=SRAtom term,...})=
            Term.is_const term andalso
              let val c=Term.dest_thy_const term
              in #Thy c=thy andalso #Name c=name end
        | head _ _ _=false
      fun binary thy name(SRTree {shape=SRApp
          (SRTree {shape=SRApp(h,a),...},b),...})=
            if head thy name h then SOME(a,b) else NONE
        | binary _ _ _=NONE
      fun type_same(SRCaptured a,SRCaptured b)=Type.compare(a,b)=EQUAL
        | type_same(SRArrow(a,b),SRArrow(c,d))=
            type_same(a,c)andalso type_same(b,d)
        | type_same(SRCaptured actual,arrow as SRArrow _)=
            type_same(arrow,SRCaptured actual)
        | type_same(SRArrow(a,b),SRCaptured actual)=
            if Type.is_vartype actual then false else
              let val {Thy,Tyop,Args}=Type.dest_thy_type actual
              in case(Thy,Tyop,Args)of("min","fun",[left,right])=>
                type_same(a,SRCaptured left)andalso
                type_same(b,SRCaptured right) | _=>false end
      fun tree_same a b=
        (tick 1;if not(type_same(sr_type a,sr_type b))then false else
         case(#shape(sr_data a),#shape(sr_data b))of
           (SRAtom x,SRAtom y)=>Term.term_eq x y
         | (SRFresh(x,a),SRFresh(y,b))=>x=y andalso Type.compare(a,b)=EQUAL
         | (SRBound(_,x),SRBound(_,y))=>Term.term_eq x y
         | (SRApp(f,x),SRApp(g,y))=>tree_same f g andalso tree_same x y
         | _=>false)
      fun native_hyp conditions=case closing of NONE=>append conditions hyp
        | SOME _=>List.foldl(fn(value,held)=>
            if List.exists(fn old=>tree_same value old)held then held
            else append held[value])hyp(List.rev conditions)
      fun remove_hyp ant held=
        List.filter(fn value=>not(tree_same ant value))held
      fun require_predicate_terminal tree=
        let fun operator(SRTree{shape=SRApp(left,_),...})=operator left
              | operator(SRTree{shape=SRAtom term,...})=term
              | operator _=raise ERR "predicate_conditional"
                  "predicate operator required"
            val h=operator tree
            fun forbidden constant=Term.is_const h andalso
              Term.same_const h constant
            val special=Term.is_const h andalso
              let val {Thy,Name,...}=Term.dest_thy_const h
              in Thy="marker"andalso Name="Abbrev"end
        in case #shape(sr_data tree)of SRApp _=>
          if forbidden boolSyntax.equality orelse forbidden boolSyntax.negation
              orelse forbidden boolSyntax.implication orelse
              forbidden boolSyntax.conjunction orelse
              forbidden boolSyntax.disjunction orelse
              forbidden boolSyntax.universal orelse
              forbidden boolSyntax.existential orelse special then raise ERR
            "predicate_conditional" "specialized terminal branch"
          else ()
        | _=>raise ERR "predicate_conditional" "predicate terminal required"end
      fun ants current found=case binary "min" "==>" current of
          NONE=>(require_predicate_terminal current;List.rev found)
        | SOME(ant,body)=>ants body(ant::found)
      fun raw_anchor(SRTree{shape,...})=
        (tick 1;case shape of SRAtom term=>
           if Term.is_var term andalso List.exists(fn(_,name)=>
               (tick 1;Term.term_eq term name))(#names d)then raise ERR
             "predicate_conditional" "named syntax requires normalization"
           else ()
         | SRApp(a,b)=>(raw_anchor a;raw_anchor b)
         | _=>raise ERR "predicate_conditional"
             "raw binder-free syntax required")
      val _=case closing of NONE=>() | SOME _=>raw_anchor initial
      val ordered_ants=case closing of NONE=>[] | SOME _=>ants initial []
      val steps=case closing of NONE=>steps | SOME _=>
        List.map(fn _=>EvidenceStep SourceCondition)ordered_ants
      fun guarded_source source=
        (source_realization_guard expected source;guard())
      val original_roots=ref([]:G.node list)
      fun roots source=case source of
          SCELeaf(SourceRuleRecipe
            {plan=SourceRulePlan{source=parent,...},...})=>
            let val SourceRealization
                  {graph=owner,occurrences,theorem,...}=parent
                val _=guarded_source parent
                val _=if Portable.pointer_eq(owner,graph)then ()else raise ERR
                  "predicate_conditional" "foreign Source ancestor"
                fun original hypothesis=
                  let val matching=List.filter(fn(_,node)=>
                        (tick 1;Portable.pointer_eq(hypothesis,
                          G.representative graph node)))occurrences
                  in if null matching then raise ERR "predicate_conditional"
                       "actual ancestor Hyp lacks genuine Source root"
                     else List.app(fn(_,node)=>
                       original_roots:=node:: !original_roots)matching end
            in List.app original(Thm.hyp theorem);guarded_source parent end
        | SCEProjected{value,...}=>roots value
        | SCEApplied{parents,...}=>List.app roots parents
      fun graph_same forest node=
        (tick 1;case(#shape(sr_data forest),G.view graph node)of
          (SRAtom term,G.Variable _)=>Term.is_var term andalso
            Term.term_eq term(G.representative graph node)
        | (SRAtom term,G.Constant _)=>Term.is_const term andalso
            Term.term_eq term(G.representative graph node)
        | (SRApp(a,b),G.Application(x,y))=>
            graph_same a x andalso graph_same b y
        | (_,G.OpaqueRetained)=>raise ERR "predicate_conditional"
            "Original Source ant alias is unresolved"
        | (_,G.AdmittedBinder _)=>raise ERR "predicate_conditional"
            "Original Source ant alpha alias is unresolved"
        | _=>false)
      val _=case closing of NONE=>() | SOME _=>
        (roots evidence;List.app(fn ant=>
          if List.exists(fn node=>graph_same ant node)(!original_roots)
          then raise ERR "predicate_conditional"
            "Original Source ant alias needs semantic receiver"
          else ())ordered_ants)
      fun forall(SRTree {shape=SRApp(h,SRTree {shape=SRLam(id,v,b),...}),
                            ...})=
            if head "bool" "!" h then SOME(id,v,b) else NONE
        | forall _=NONE
      fun exists(SRTree {shape=SRApp(h,SRTree {shape=SRLam(id,v,b),...}),
                            ...})=
            if head "bool" "?" h then SOME(id,v,b) else NONE
        | exists _=NONE
      fun subst id arg (value as SRTree {ty,shape,...})=
        (tick 1;case shape of SRBound(old,_)=>if old=id then arg else value
        | SRApp(a,b)=>app ty (subst id arg a)(subst id arg b)
        | SRLam(old,v,b)=>if old=id then value else
            lam ty old v (subst id arg b)
        | _=>value)
      fun tcombine constant a b=
        let val bool=SRCaptured Type.bool
            val ty=SRCaptured(Term.type_of constant)
            val arrow=SRCaptured(#2(Type.dom_rng(Term.type_of constant)))
        in app bool (app arrow (atom(SRAtom constant)ty)a)b end
      fun timp a b=tcombine boolSyntax.implication a b
      fun tneg a=
        app (SRCaptured Type.bool)
          (atom(SRAtom boolSyntax.negation)
            (SRCaptured(Term.type_of boolSyntax.negation)))a
      fun typed_equality a b=
        let val domain=sr_type a val bool=SRCaptured Type.bool
            val arrow=SRArrow(domain,bool)
            val h=atom(SRAtom boolSyntax.equality)(SRArrow(domain,arrow))
        in app bool (app arrow h a)b end
      fun abstract id variable (value as SRTree {ty,shape,...})=
        (tick 1;case shape of SRAtom term=>
            if sr_same term variable then atom(SRBound(id,term))ty
            else value
          | SRApp(a,b)=>app ty (abstract id variable a)
              (abstract id variable b)
          | SRLam(old,v,b)=>lam ty old v (abstract id variable b)
          | _=>value)
      fun quantify issue argument condition=
        let val variable=case #shape(sr_data argument)of
              SRAtom term=>if Term.is_var term then term else
                raise ERR "source_rule_quantify" "actual variable required"
            | _=>raise ERR "source_rule_quantify" "actual variable required"
            val domain=sr_type argument
            val id= !next val _=next:=id+1
            val _=if issue then fresh id (Term.type_of variable) else ()
            val bool=SRCaptured Type.bool
            val predicate=lam (SRArrow(domain,bool))id
              (atom(SRBound(id,variable))domain)
              (abstract id variable condition)
            val constant=atom(SRAtom boolSyntax.universal)
              (SRArrow(SRArrow(domain,bool),bool))
        in app bool constant predicate end
      (* Strip SPEC routes WITHOUT substituting the owned arguments.
         Permutation is a property of this template, before matching. *)
      fun original_template [] [] current=current
        | original_template(step::rest)pending current=
            let val(next,pending)=case step of EvidenceStep(SourceSpec _)=>
                  (case forall current of
                    SOME(_,_,body)=>(body,tl pending) | _=>
                    raise ERR "source_rule_template" "forall route")
                | EvidenceStep(SourceConjunct left)=>
                    ((case binary "bool" "/\\" current of SOME(a,b)=>
                      if left then a else b | _=>
                        raise ERR "source_rule_template" "conjunct route"),
                      pending)

                | EvidenceStep SourceCondition=>
                    ((case binary "min" "==>" current of SOME(_,body)=>body
                      | _=>raise ERR "source_rule_template" "condition route"),
                      pending)

                | EvidenceAssertion=>
                    ((case binary "min" "=" current of SOME(a,b)=>
                      if head "bool" "T" b then a else
                        raise ERR "source_rule_template" "truth operand"
                     | _=>raise ERR "source_rule_template" "truth equality"),
                      pending)

                | EvidenceAntecedentConj=>
                    ((case binary "min" "==>" current of SOME(ant,body)=>
                      (case binary "bool" "/\\" ant of SOME(a,b)=>
                         timp a (timp b body) | _=>
                           raise ERR "source_rule_template" "conjunct ant")
                     | _=>raise ERR "source_rule_template" "implication"),
                      pending)

                | EvidenceAntecedentDisj left=>
                    ((case binary "min" "==>" current of SOME(ant,body)=>
                      (case binary "bool" "\\/" ant of SOME(a,b)=>
                         timp (if left then a else b)body | _=>
                           raise ERR "source_rule_template" "disjunct ant")
                     | _=>raise ERR "source_rule_template" "implication"),
                      pending)

                | EvidenceImpFalse=>
                    ((case binary "min" "==>" current of SOME(a,b)=>
                       if head "bool" "F" b then tneg a else
                         raise ERR "source_rule_template" "false consequence"
                     | _=>raise ERR "source_rule_template" "implication"),
                      pending)
                | EvidenceSymmetry=>
                    ((case binary "min" "=" current of SOME(a,b)=>
                        typed_equality b a
                      | _=>raise ERR "source_rule_template" "equality"),
                      pending)
                | EvidenceConditionForall _=>
                    let val(ant,result)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "source_rule_template" "implication"
                        val argument=case pending of v::_=>v | _=>
                          raise ERR "source_rule_template" "variable"
                    in(timp(quantify false argument ant)result,tl pending)end
                | EvidenceAntecedentExists _=>
                    let val(ant,result)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "source_rule_template" "implication"
                        val(id,_,body)=case exists ant of SOME triple=>triple
                          | _=>raise ERR "source_rule_template" "exists"
                        val argument=case pending of v::_=>v | _=>
                          raise ERR "source_rule_template" "witness"
                    in(timp(subst id argument body)result,tl pending)end
            in tick 1;original_template rest pending next end
        | original_template _ _ _=
            raise ERR "source_rule_template" "argument route mismatch"
      datatype template_variable=TemplateBound of int
        | TemplateFree of Term.term
      fun key_equal(TemplateBound a,TemplateBound b)=a=b
        | key_equal(TemplateFree a,TemplateFree b)=sr_same a b
        | key_equal _=false
      fun variable(SRTree {shape=SRBound(id,_),...})=SOME(TemplateBound id)
        | variable(SRTree {shape=SRAtom term,...})=
            if Term.is_var term then SOME(TemplateFree term) else NONE
        | variable _=NONE
      fun same_ty(SRCaptured a,SRCaptured b)=Type.compare(a,b)=EQUAL
        | same_ty(SRArrow(a,b),SRArrow(c,d))=same_ty(a,c)andalso same_ty(b,d)
        | same_ty _=false
      fun vperm a b=(tick 1;
        case(variable a,variable b)of(SOME _,SOME _)=>
            same_ty(sr_type a,sr_type b)
        | _=>case(#shape(sr_data a),#shape(sr_data b))of
            (SRApp(f,x),SRApp(g,y))=>vperm f g andalso vperm x y
          | (SRLam(_,_,x),SRLam(_,_,y))=>vperm x y
          | (SRAtom x,SRAtom y)=>Term.aconv x y
          | _=>false)
      fun fv tree=
        let fun member key all=List.exists
              (fn old=>(tick 1;key_equal(key,old)))all
            fun walk bound current all=(tick 1;
              case variable current of SOME(TemplateBound id)=>
                  if List.exists(fn old=>old=id)bound then all else
                    let val key=TemplateBound id
                    in if member key all then all else key::all end
              | SOME key=>if member key all then all else key::all
              | NONE=>case #shape(sr_data current)of
                  SRApp(a,b)=>walk bound b (walk bound a all)
                | SRLam(id,_,b)=>walk(id::bound)b all | _=>all)
        in walk [] tree [] end
      fun same_fv a b=
        List.all(fn x=>List.exists(fn y=>(tick 1;key_equal(x,y)))b)a
        andalso List.all(fn y=>List.exists
          (fn x=>(tick 1;key_equal(x,y)))a)b
      val original=original_template steps args initial
      val permutative=case terminal of SourceEquality=>
            (case binary "min" "=" original of SOME(a,b)=>
                vperm a b andalso same_fv(fv a)(fv b)
              | _=>raise ERR "source_rule_template" "original equality")
        | _=>false
      fun record cap hypotheses result=
        let val _=if sr_raw result<=cap andalso sr_inc result<=cap then ()
              else raise ERR "prepare_source_condition_rule"
                "prospective local result bound"
            val all=result::hypotheses
            fun constructors(SRCaptured _)=0:IntInf.int
              | constructors(SRArrow(a,b))=
                  (tick 1;1+constructors a+constructors b)
            val cost=List.foldl(fn(tree,n)=>(tick 1;
              n+sr_raw tree+sr_inc tree+
                IntInf.fromInt(length(sr_types tree))+
                (case closing of NONE=>0 | SOME _=>
                  List.foldl(fn(ty,total)=>total+constructors ty)
                    0(sr_types tree)))) 0 all
            val _=budget:= !budget+cost
            val _=if !budget<=quota then () else
              raise ERR "prepare_source_condition_rule" "original Work"
        in policies:=List.foldr(fn(tree,all)=>append(sr_types tree)all)
          (!policies)all end
      val bool=SRCaptured Type.bool
      fun boolean term=atom(SRAtom term)bool
      fun combine constant a b=
        let val arrow=SRArrow(bool,bool)
            val h=atom(SRAtom constant)(SRArrow(bool,arrow))
        in app bool (app arrow h a)b end
      fun equality a b=combine boolSyntax.equality a b
      fun implication a b=combine boolSyntax.implication a b
      fun align conditions result=case closing of NONE=>
        (record template conditions (equality result result);
         record output conditions result)
        | SOME _=>record output conditions result
      val _=align hyp initial
      fun play [] [] current conditions instructions=
            (current,conditions,List.rev instructions)
        | play(step::rest) pending current conditions instructions=
            let val _=tick 1
                val(action,result,pending,conditions)=case step of
                  EvidenceStep(SourceSpec _)=>
                    let val(id,v,b)=case forall current of SOME d=>d
                          | NONE=>raise ERR "prepare_source_condition_rule"
                              "actual explicit forall required"
                        val arg=case pending of a::_=>a | _=>
                          raise ERR "prepare_source_condition_rule" "argument"
                        val _=case(sr_type v,sr_type arg)of
                          (SRCaptured a,SRCaptured b)=>
                            if Type.compare(a,b)=EQUAL then () else
                              raise ERR "prepare_source_condition_rule"
                                "SPEC argument type"
                        | _=>raise ERR "prepare_source_condition_rule" "type"
                        val _=record output [] arg
                    in(SCEClauseNative(SRSpec arg),subst id arg b,tl pending,
                      conditions)end
                | EvidenceStep(SourceConjunct left)=>
                    let val(a,b)=case binary "bool" "/\\" current of
                          SOME d=>d | NONE=>
                            raise ERR "prepare_source_condition_rule"
                              "actual conjunction required"
                    in(SCEClauseNative(SRConjunct left),
                      if left then a else b,pending,
                      conditions)end
                | EvidenceStep SourceCondition=>
                    let val(a,b)=case binary "min" "==>" current of
                          SOME d=>d | NONE=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val _=record output [a] a
                    in(SCEClauseNative SRCondition,b,pending,a::conditions)end
                | EvidenceAssertion=>
                    let val(a,b)=case binary "min" "=" current of
                          SOME d=>d | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual truth equality required"
                        val _=if head "bool" "T" b then () else
                          raise ERR "prepare_source_condition_rule"
                            "actual truth operand required"
                        val _=record output (native_hyp conditions) current
                        val _=record output [] (boolean boolSyntax.T)
                    in(SCEClauseTruth,a,pending,conditions)end
                | EvidenceAntecedentConj=>
                    let val(ant,body)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val(a,b)=case binary "bool" "/\\" ant of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual conjunction antecedent required"
                        val held=native_hyp conditions
                        val _=record output [a] a
                        val _=record output [b] b
                        val _=record output [a,b] ant
                        val _=record output (a::b::held)body
                        val right=implication b body
                        val _=record output (a::held)right
                        val result=implication a right
                    in(SCEClauseAnteConj,result,pending,conditions)end
                | EvidenceAntecedentDisj left=>
                    let val(ant,body)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val(a,b)=case binary "bool" "\\/" ant of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual disjunction antecedent required"
                        val selected=if left then a else b
                        val held=native_hyp conditions
                        val _=record output [selected]selected
                        val _=record output [selected]ant
                        val _=record output (selected::held)body
                        val result=implication selected body
                    in(SCEClauseAnteDisj left,result,pending,conditions)end
                | EvidenceSymmetry=>
                    let val(a,b)=case binary "min" "=" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual equality required"
                    in(SCEClauseSymmetry,typed_equality b a,pending,
                      conditions)end
                | EvidenceConditionForall _=>
                    let val(ant,result)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val argument=case pending of a::_=>a | _=>
                          raise ERR "prepare_source_condition_rule" "variable"
                        val quantified=quantify true argument ant
                        val held=native_hyp conditions
                        val _=record output [] argument
                        val _=record output [quantified]quantified
                        val _=record output [quantified]ant
                        val _=record output (quantified::held)result
                    in(SCEClauseConditionForall argument,
                      implication quantified result,tl pending,conditions)end
                | EvidenceAntecedentExists _=>
                    let val(ant,result)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val(id,v,body)=case exists ant of SOME triple=>triple
                          | _=>raise ERR "prepare_source_condition_rule"
                            "actual existential antecedent required"
                        val argument=case pending of a::_=>a | _=>
                          raise ERR "prepare_source_condition_rule" "witness"
                        val _=case #shape(sr_data argument)of SRAtom term=>
                            if Term.is_var term then () else
                              raise ERR "prepare_source_condition_rule"
                                "witness must be an actual variable"
                          | _=>raise ERR "prepare_source_condition_rule"
                              "witness must be an actual variable"
                        val _=if same_ty(sr_type v,sr_type argument)then ()
                          else raise ERR "prepare_source_condition_rule"
                            "existential witness type differs"
                        val instance=subst id argument body
                        val held=native_hyp conditions
                        val _=record output [] argument
                        val _=record output [instance]instance
                        val _=record output [instance]ant
                        val _=record output (instance::held)result
                    in(SCEClauseAnteExists argument,
                      implication instance result,tl pending,conditions)end
                | EvidenceImpFalse=>
                    let val(ant,last)=case binary "min" "==>" current of
                          SOME pair=>pair | _=>
                            raise ERR "prepare_source_condition_rule"
                              "actual implication required"
                        val _=if head "bool" "F" last then () else
                          raise ERR "prepare_source_condition_rule"
                            "actual false consequent required"
                    in(SCEClauseNotIntro,tneg ant,pending,conditions)end
                val hypotheses=native_hyp conditions
                val _=record output hypotheses result
                val _=align hypotheses result
            in play rest pending result conditions
              ((action,result,conditions)::instructions)end
        | play _ _ _ _ _=raise ERR "prepare_source_condition_rule" "route"
      val(body,conditions,instructions)=play steps args initial [] []
      fun future_specs [] current instructions=(current,instructions)
        | future_specs(argument::rest)current instructions=
          let val(id,variable,body)=case forall current of SOME triple=>triple
                | NONE=>raise ERR "canonical_future"
                    "actual universal block is shorter than quotation"
              val _=if same_ty(sr_type variable,sr_type argument)then ()else
                raise ERR "canonical_future" "universal argument type"
              val result=subst id argument body
              val _=record output [] argument
              val _=record output (native_hyp conditions)result
              (* Public temporary SPECL retains its single synthetic
                 initial-clause hypothesis throughout the quoted block. *)
              val _=record output [initial]result
              val _=align(native_hyp conditions)result
          in future_specs rest result(instructions@[
            (SCEClauseNative(SRSpec argument),result,conditions)])end
      val(body,instructions)=case(kind,future_trees)of(NONE,[])=>
            (body,instructions)
        | (SOME SCRSpecs,arguments)=>
            let val _=record output [initial]initial
                val(result,instructions)=future_specs arguments body
                  instructions
            in case forall result of NONE=>(result,instructions)
              | SOME _=>raise ERR "canonical_future"
                  "whole actual SPEC_ALL block must be quoted"end
        | (SOME SCRExists,[argument])=>
            let val(ant,result)=case binary "min" "==>" body of
                  SOME pair=>pair | _=>raise ERR "canonical_future"
                    "actual implication required"
                val(id,v,part)=case exists ant of SOME triple=>triple
                  | _=>raise ERR "canonical_future"
                    "actual existential antecedent required"
                val _=if same_ty(sr_type v,sr_type argument)then ()else
                  raise ERR "canonical_future" "existential argument type"
                val instance=subst id argument part
                val held=native_hyp conditions
                val _=record output [] argument
                val _=record output [] instance
                val _=record output [instance]instance
                val _=record output [instance]ant
                val _=record output (instance::held)result
                val next=implication instance result
                val _=record output held next
                val _=align held next
            in(next,instructions@[
              (SCEClauseAnteExists argument,next,conditions)])end
        | _=>raise ERR "canonical_future" "actual quoted argument route"
      val instructions=List.map(fn(action,result,conditions)=>
        (SCRNative action,result,conditions))instructions
      val hypotheses=native_hyp conditions
      val result=body
      val _=record output hypotheses result
      fun discharge [] current instructions=(current,instructions)
        | discharge(condition::rest)current instructions=
            let val next=implication condition current
                val _=record output hypotheses next
            in discharge rest next(instructions@[
              (SCRDischarge condition,next,[])])end
      fun predicate_close data result instructions=
        let val SCRConjEnvelope{statement,first,second,third,required,
              ants,expected,...}=data
            val _=required:=length ordered_ants>=2
            val law=capture []NONE statement
            fun replace p q r(value as SRTree{ty,shape,...})=case shape of
                SRAtom term=>if Term.term_eq term first then p
                  else if Term.term_eq term second then q
                  else if Term.term_eq term third then r else value
              | SRApp(a,b)=>app ty(replace p q r a)(replace p q r b)
              | _=>raise ERR "predicate_conditional" "fixed schema geometry"
            fun bridge []=()
              | bridge((tree as SRTree{shape,...})::rest)=
                  (record template[](typed_equality tree tree);
                   case shape of SRApp(a,b)=>bridge(a::b::rest)
                     | _=>bridge rest)
            val _=if !required then
              (record template[]law;
               List.app(fn term=>record template[](capture []NONE term))
                 [first,second,third];
               bridge[law];record template[](equality law law);
               record template[](equality law law);record template[]law)
              else ()
            fun original current found=
              (tick 1;if boolSyntax.is_imp_only current then
                 let val(a,b)=boolSyntax.dest_imp_only current
                 in original b(a::found)end else List.rev found)
            val real_ants=original(#target d)[]
            val _=ants:=real_ants
            val _=expected:=List.filter(fn hypothesis=>
              not(List.exists(fn ant=>(tick 1;Term.aconv ant hypothesis))
                real_ants))(Thm.hyp(#proof d))
            val held=native_hyp conditions
            val eqt=equality result(boolean boolSyntax.T)
            val _=record template held(equality result eqt)
            val _=record output held eqt
            val truth=(SCRPredicateTruth,eqt,conditions)
            fun close [] [] current hypotheses instructions=
                  (current,instructions)
              | close(condition::rest)(actual::actuals)current
                  hypotheses instructions=
                  let val discharged=implication condition current
                      val after=remove_hyp condition hypotheses
                      val _=record output hypotheses current
                      val _=record output after discharged
                      val _=record template after
                        (equality discharged discharged)
                      val(next,combine)=case binary "min" "==>" current of
                          NONE=>(discharged,false)
                        | SOME(q,r)=>
                            let val p=condition
                                val schema=replace p q r law
                                val next=implication
                                  (combine boolSyntax.conjunction p q)r
                                val _=record template[]p
                                val _=record template[]q
                                val _=record template[]r
                                val _=record template[]schema
                                val _=record output after next
                            in(next,true)end
                  in close rest actuals next after(instructions@[
                    (SCRConjClose(condition,actual,combine),next,[])])end
              | close _ _ _ _ _=raise ERR "predicate_conditional"
                  "actual ordered ant portfolio changed"
        in close(List.rev ordered_ants)(List.rev real_ants)
          eqt held(instructions@[truth])end
      val(final,instructions)=case closing of SOME data=>
            predicate_close data result instructions
        | NONE=>if finish then discharge saved result instructions
            else(result,instructions)
      val final_hyp=case closing of NONE=>hyp | SOME _=>
        List.foldl(fn(ant,held)=>remove_hyp ant held)hyp ordered_ants
      val _=record template final_hyp final
      val _=align final_hyp final
      (* Same balanced shape as the retained realization helper. *)
      fun balanced values=
        let fun size []=0 | size(_::rest)=(tick 1;1+size rest)
            fun split 0 pending left=(List.rev left,pending)
              | split n(v::rest)left=(tick 2;split(n-1)rest(v::left))
              | split _ _ _=raise ERR "prepare_source_condition_rule" "split"
            fun walk []=boolean boolSyntax.T | walk [v]=v
              | walk values=
                  let val(a,b)=split(size values div 2)values []
                  in combine boolSyntax.conjunction(walk a)(walk b)end
        in walk values end
      val _=case closing of SOME _=>() | NONE=>
        let val context=balanced rows
        in record template [] context;
          record template [] (implication context final);
          List.app(fn row=>record template [context]row)rows;
          record template [context]final end
      (* Bounded syntax-shadow DATA construction has its own result
         footprint; it carries no theorem or Hyp permission. *)
      val _=record output []final
      val _=List.app(fn argument=>record output []argument)future_trees
      val _=List.app(fn condition=>record output []condition)conditions
      val origin=sr_lexical_origin tick final
      val condition_origins=List.map(sr_lexical_origin tick)conditions
      val _=pay expected (!budget)
      val _=case closing of NONE=>() | SOME(SCRConjEnvelope
          {statement,import,required,...})=>
        if !required then
          let val _=guard()
              val actual=G.plan_import graph scope(#template_limit limits)
                statement
              val _=guard()
              val _=List.app(fn ty=>(tick 1;
                policies:=SRCaptured ty:: !policies))(G.import_types actual)
          in import:=SOME actual end else ()
      val _=guard()
    in SCRClausePlan {work=expected,evidence=evidence,
      frame=frame,graph=graph,
      caller=caller,scope=scope,children=children,initial=initial,
      instructions=instructions,terminal=terminal,result=final,
      conditions=conditions,types= !policies,binders= !binders,
      origin=origin,
      check_type=check_type,permutative=permutative,used=ref false,
      future=future,closing=closing,
      condition_origins=condition_origins} end))
  fun prepare_source_canonical_clause expected data=
    prepare_source_canonical_clause_inside expected NONE data

  (* These fixed groups price this Source reader's explicit instructions.
     Borrowed kernel/signature tables and machine costs remain qualified. *)
  (* Public dest_forall opens only this fixed nine-node Boolean body.
     Per-node reserves cover opening/comparing it and its scalar Types on
     either kernel; no realized caller operand is opened or compared. *)
  val eqc_library_export_fee=9*16+32*4+length
    ["accessor entry","cached conclusion","dest_forall","port record",
     "tag getter","argument VAR check","Hyp getter","empty Hyp check",
     "accessor return"]
  val eqc_export_fee=eqc_library_export_fee+length
    ["entry","Sources getter","graph getter","scope getter",
     "limits getter","guard closure","guard call","exporter call",
     "port annotation","closed read","closed check","bare read",
     "bare check","andalso branch","check branch","hold fields",
     "reader return"]
  val eqc_schema_fee=length
    ["schema entry","argument VAR check","body COMB check",
     "outer first COMB destructor","outer second COMB check",
     "outer second COMB destructor","outer equality CONST check",
     "outer left VAR check","inner COMB check","inner first destructor",
     "inner second COMB check","inner second destructor",
     "inner equality CONST check","inner left VAR check",
     "inner truth CONST check","statement COMB check",
     "statement COMB destructor","forall CONST check","ABS flag check",
     "first VAR identity call","second VAR identity call",
     "first VAR identity branch","second VAR identity branch",
     "body node portfolio","body cell","outer left cell","eq1 cell",
     "left cell","inner cell","inner left cell","eq2 cell",
     "right cell","truth cell","argument cell","statement cell",
     "forall cell","empty list","type counter ref","name counter ref",
     "schema return"]
  val eqc_port_fee=length
    ["port call","list case","head projection","Type getter",
     "Type scheduler call","name dispatch","VAR destructor",
     "CONST destructor","name fields","size getters","byte model",
     "validation call","result counters","tail call","return"]
  val eqc_type_fee=length
    ["Type loop","pending case","head projection","bound comparison",
     "bound branch","Type VAR check","type destructor","name fields",
     "size getters","byte model","type name comparison",
     "argument scheduler","list cell","counter addition","loop return"]
  val eqc_finish_fee=length
    ["finish entry","body freshness call","statement freshness call",
     "argument freshness call","freshness branches","Tag hold",
     "guard call","Type stamp","Term stamp","result record",
     "data record","publication","return"]
  val eqc_get_fee=eqc_library_export_fee+length
    ["getter entry","owner comparison","owner branch","Work guard",
     "Type stamp","Term stamp","stamp comparisons","stamp branch",
     "fixed exporter call","statement pointer comparison","Tag pointer",
     "nine-node body comparison","Boolean variable comparison",
     "origin fact comparisons","identity branch","data projection",
