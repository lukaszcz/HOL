  val ne_row_fee=nc_consume_fee+IntInf.fromInt(length
    ["entry","allowance read","bound comparison","subtraction",
     "allowance write","guard call","row argument","origin field",
     "row pair","candidate read","list cell","candidate write",
     "guard call","return"])
  val ne_lookup_fee=nc_consume_fee+IntInf.fromInt(length
    ["entry","pending case","row projection","pointer comparison",
     "branch","tail projection","loop call","return"])
  val ne_final_fee=nc_consume_fee+IntInf.fromInt(length
    ["entry","snapshot fields","proof comparison","target comparison",
     "Hyp case","lookup call","selected origin","row pair",
     "list cell","Hyp tail","record fields","publication","return"])
  val ne_conj_payer_fee=nc_aux_consume_fee+IntInf.fromInt(length
    ["private debit entry","allowance call","zero payer","return"])
  val ne_conj_fee=nc_aux_consume_fee+IntInf.fromInt(length
    ["entry","allowance call","pending clear","cache case",
     "current proof read","predecessor comparison","body pointer compare",
     "candidate lookup","known ant flag","known body flag",
     "closed fact fields","cache fields","law pointer comparison",
