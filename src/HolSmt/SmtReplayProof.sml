  type eqc_ports=
    {statement:Term.term,body:Term.term,quantifier_variable:Term.term,
     tag:Tag.tag,bare:bool,closed:bool}
  type source_eqt_cache_data=
    {valid:bool,body_nodes:int,type_nodes:int,name_bytes:int,
     closed:bool,bare:bool}
  datatype source_eqt_cache_read=SourceEqtCacheRead of
    {work:W.portfolio,graph:G.graph,scope:G.scope,
     sources:SmtReplaySource.sources,limits:W.limits,
     epoch:int,symbols:int,ports:eqc_ports,data:source_eqt_cache_data}
  fun eqc_context work graph scope sources limits=
    W.validate work graph scope sources limits
  fun eqc_fail text=raise ERR "eqt_cache_read" text
  fun eqc_inside_guard_using expected
      (SourceEqtCacheRead{work,graph,scope,sources,limits,epoch,symbols,
        ports,...})debit=
    (if Portable.pointer_eq(expected,work)then ()else
       eqc_fail "foreign expected Work";
     eqc_context expected graph scope sources limits;
     if Type.type_epoch()=epoch andalso Term.term_epoch()=symbols then ()
       else eqc_fail "cached read epoch changed";
     debit();
     let val actual=Drule.eqt_intro_cache_data()
     in if Portable.pointer_eq(#statement actual,#statement ports)andalso
         Term.term_eq(#body actual)(#body ports)andalso
         Term.term_eq(#quantifier_variable actual)
           (#quantifier_variable ports)andalso
         Portable.pointer_eq(#tag actual,#tag ports)andalso
         #bare actual= #bare ports andalso #closed actual= #closed ports
       then ()else eqc_fail "fixed producer changed"end;
     eqc_context expected graph scope sources limits)
  fun eqc_inside_guard expected value=
    eqc_inside_guard_using expected value
      (fn()=>W.spend expected eqc_get_fee)
  fun source_eqt_cache_read_for expected
      (value as SourceEqtCacheRead{work,data,...})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work)then ()else
         eqc_fail "foreign expected Work";
       W.with_step expected(fn()=>
         (eqc_inside_guard expected value;data))))
  fun eqc_prepare_inside expected=let
      val _=W.spend expected eqc_export_fee
      val sources=W.original_sources expected
      val graph=SmtReplaySource.owning_graph sources
      val scope=SmtReplaySource.owning_scope sources
      val limits=W.semantic_limits expected
      fun guard()=eqc_context expected graph scope sources limits
      val _=guard()
      val ports:eqc_ports=Drule.eqt_intro_cache_data()
      val _=if #bare ports andalso #closed ports then ()else
        eqc_fail "fixed producer has no closed bare origin"
      val _=W.spend expected eqc_schema_fee
      fun comb term=if Term.is_comb term then Term.dest_comb term else
        eqc_fail "fixed schema is not an application"
      fun constant term=if Term.is_const term then ()else
        eqc_fail "fixed schema constant changed"
      fun variable term=if Term.is_var term then ()else
        eqc_fail "fixed schema variable changed"
      val argument= #quantifier_variable ports
      val _=variable argument
      val(outer_left,inner)=comb(#body ports)
      val(eq1,left)=comb outer_left
      val(inner_left,truth)=comb inner
      val(eq2,right)=comb inner_left
      val _=constant eq1 val _=constant eq2 val _=constant truth
      val _=variable left val _=variable right
      val(all,abstraction)=comb(#statement ports)
      val _=constant all
      val _=if Term.is_abs abstraction then ()else
        eqc_fail "fixed GEN constructor endpoint changed"
      (* Only the fixed law's Abs was opened by the accessor. The decoded
         body is bounded; it is not retained construction provenance. *)
      val terms=[#body ports,outer_left,eq1,left,inner,inner_left,eq2,
        right,truth,argument,#statement ports,all]
      val type_nodes=ref 0 val name_bytes=ref 0
      fun bytes thy name=
        let val amount=String.size thy+String.size name
            val _=W.spend expected amount
        in name_bytes:= !name_bytes+amount end
      fun profile_type initial=
        let fun add [] rest=rest
              | add(t::ts)rest=(W.spend expected eqc_type_fee;
                  add ts(t::rest))
            fun loop [] count=count
              | loop(ty::rest)count=
                let val _=W.spend expected eqc_type_fee
                    val _=if count<32 then ()else
                      eqc_fail "fixed Type grammar exceeds its bound"
                in if Type.is_vartype ty then
                     eqc_fail "fixed Boolean schema has a Type variable"
                   else let val{Thy,Tyop,Args}=Type.dest_thy_type ty
                        val _=bytes Thy Tyop
                        val _=if Thy="min" andalso
                            (Tyop="bool"orelse Tyop="fun")then ()else
                          eqc_fail "fixed Boolean Type changed"
                     in loop(add Args rest)(count+1)end end
            val count=loop[initial]0
            val _=W.spend expected eqc_type_fee
            val _=if Type.uptodate_type initial then ()else
              eqc_fail "fixed Type declaration retired"
        in type_nodes:= !type_nodes+count end
      fun port []=()
        | port(term::rest)=
          let val _=W.spend expected eqc_port_fee
              val _=profile_type(Term.type_of term)
              val _=if Term.is_var term then
                  let val(name,_)=Term.dest_var term in bytes "" name end
                else if Term.is_const term then
                  let val{Name,Thy,...}=Term.dest_thy_const term
                  in bytes Thy Name end else ()
          in port rest end
      val _=port terms
      val _=W.spend expected eqc_schema_fee
      fun named term thy name=
        let val{Name,Thy,...}=Term.dest_thy_const term
        in Thy=thy andalso Name=name end
      val _=if named eq1 "min" "="andalso named eq2 "min" "="andalso
          named truth "bool" "T"andalso named all "bool" "!"andalso
          Term.term_eq left argument andalso Term.term_eq right argument
        then ()else eqc_fail "fixed Boolean schema changed"
      val _=if Type.compare(Term.type_of argument,Type.bool)=EQUAL then ()
        else eqc_fail "fixed scalar domain is not Boolean"
      val _=W.spend expected eqc_finish_fee
      val _=if Term.uptodate_term(#body ports)andalso
          Term.uptodate_term(#statement ports)andalso
          Term.uptodate_term argument then ()else
        eqc_fail "fixed declaration retired"
      val _=guard()
      val data={valid=true,body_nodes=9,type_nodes= !type_nodes,
        name_bytes= !name_bytes,closed= #closed ports,bare= #bare ports}
      val value=SourceEqtCacheRead{work=expected,graph=graph,scope=scope,
        sources=sources,limits=limits,epoch=Type.type_epoch(),
        symbols=Term.term_epoch(),ports=ports,data=data}
      val _=eqc_inside_guard expected value
    in value end
  fun prepare_source_eqt_cache_read expected=
    sr_fail expected(fn()=>W.with_step expected(fn()=>
      eqc_prepare_inside expected))

  (* The historical emitter sidecar is unchanged. This private portfolio
     records actual existing native effects, not a predicted sr_tree. *)
  val ne_model_fee=length
    ["entry","step projection","Hyp projection","mode projection",
     "mode branch","dispatch product","creation fee","step product",
     "candidate bound","lookup product","final Hyp product",
     "subtotal addition","pay call","return"]
  val ne_create_fee=length
    ["entry","context constructor","work field","guard field",
     "allowance ref","phase ref","current ref","proof ref",
     "candidates ref","cache field","remaining field","open-phase field",
     "initial record","publication","conj field","pending ref",
     "pending field","return"]
  val ne_dispatch_fee=length
    ["mode case","optional context projection","branch","return"]
  val ne_step_fee=nc_consume_fee+IntInf.fromInt(length
    ["entry","allowance read","nonnegative comparison","bound compare",
     "branch","subtraction","allowance write","guard call",
     "proof projection","actual pointer comparison","action dispatch",
     "old origin read","known dispatch","origin constructor",
     "actual conclusion getter","origin field","parent field",
