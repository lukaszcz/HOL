structure SmtReplayProof :> SmtReplayProof =
struct
  open SmtReplayGraph SmtReplayResolve
  structure G = SmtReplayGraph
  structure R = ReplayRedblackPrivateWork
  structure W = SmtReplayInvocationWork
  structure Scope = SmtReplayOwnedScopeReceipt
  val _ = ReplayRedblackPrivateWork.lookup_int
  val _ = SmtReplayInvocationWork.spend
  val _ = SmtReplayOwnedScopeReceipt.description_for
  val ERR = Feedback.mk_HOL_ERR "SmtReplayProof"
  type proof_statistics =
    {edges : IntInf.int,fixed_rule_calls : IntInf.int,
     generic_rule_calls : IntInf.int,final_inst_calls : IntInf.int,
     name_hits : IntInf.int,name_misses : IntInf.int}
  datatype proof_observation = ProofObservation of
    {graph : G.graph,edges : IntInf.int ref,fixed : IntInf.int ref,
     generic : IntInf.int ref,inst : IntInf.int ref,
     hits : IntInf.int ref,misses : IntInf.int ref}
  val proof_observation = ref (NONE : proof_observation option)
  fun observe_proof graph select = case !proof_observation of NONE => ()
    | SOME (ProofObservation fields) =>
        if Portable.pointer_eq (graph,#graph fields) then
          let val cell = select fields in cell := !cell+1 end
        else ()
  fun with_proof_statistics work action =
    let
      val sources = W.original_sources work
      val graph = SmtReplaySource.owning_graph sources
      val root = SmtReplaySource.owning_scope sources
      val limits = W.semantic_limits work
      fun valid () = W.validate work graph root sources limits
      val _ = valid ()
      val _ = case !proof_observation of NONE => ()
        | SOME _ => raise ERR "with_proof_statistics" "observation reentry"
      val fields = {graph = graph,edges = ref (0 : IntInf.int),
        fixed = ref (0 : IntInf.int),generic = ref (0 : IntInf.int),
        inst = ref (0 : IntInf.int),hits = ref (0 : IntInf.int),
        misses = ref (0 : IntInf.int)}
      val _ = proof_observation := SOME (ProofObservation fields)
      val outcome = Exn.capture (fn () =>
        let val result = action () val _ = valid () in result end) ()
      val _ = proof_observation := NONE
    in case outcome of Exn.Exn primary => raise primary
      | Exn.Res result =>
        let
      val counts : proof_statistics =
        {edges = !(#edges fields),fixed_rule_calls = !(#fixed fields),
         generic_rule_calls = !(#generic fields),
         final_inst_calls = !(#inst fields),
         name_hits = !(#hits fields),name_misses = !(#misses fields)}
        in (result,counts) end
    end

  datatype boundary = datatype SmtReplayNamedContext.boundary
  datatype closed_fact = ClosedFact of
    {graph : G.graph,scope : G.scope,node : G.node,original : Thm.thm,
     canonical : Thm.thm,template_limit : int}
    | PolicyClosedFact of
    {graph:G.graph,scope:G.scope,node:G.node,original:Thm.thm,
     canonical:Thm.thm,template_limit:SmtReplayResourcePolicy.limit,
     metric_captures:G.profiled_metric list}
    | PolicyRealizedClosedFact of
    {work:W.portfolio,graph:G.graph,scope:G.scope,node:G.node,
     theorem:Thm.thm,template_limit:SmtReplayResourcePolicy.limit,
     guard:unit->unit}
  datatype realization = Realization of
    {work : W.portfolio,owner : unit ref,graph : G.graph,root : G.scope,
     scope : G.scope,sources : SmtReplaySource.sources,frame : Scope.receipt,
     equality : G.node,source : G.node,target : G.node,template_limit : int,
     epoch : int,symbols : int,held : G.closure_child list,
     facts : closed_fact list,conversions : closed_conversion list,
     theorem : Thm.thm}
  and closed_conversion = ClosedConversion of
    {graph : G.graph,scope : G.scope,source : G.node,target : G.node,
     source_view : G.source,target_view : G.source,theorem : Thm.thm,
     template_limit : int}
    | RealizedConversion of realization
    | PolicyClosedConversion of
    {graph:G.graph,scope:G.scope,source:G.node,target:G.node,
     source_view:G.source,target_view:G.source,theorem:Thm.thm,
     template_limit:SmtReplayResourcePolicy.limit,
     metric_captures:G.profiled_metric list}
    | PolicyRealizedConversion of
    {work:W.portfolio,graph:G.graph,scope:G.scope,source:G.node,
     target:G.node,theorem:Thm.thm,
     template_limit:SmtReplayResourcePolicy.limit,guard:unit->unit}
  datatype leaf = Source of G.node | Definition of G.node * Term.term
    | ClosedWitness of closed_fact | ConversionWitness of closed_conversion
  datatype dependency = Dependency of int * dependency_body
  and dependency_body = Leaves of int list | Union of dependency list
  (* Only the additive owned path selects FixedTable. Ordinary blocks
     retain their original dictionaries, ordering and callback behavior. *)
  datatype 'a table = LegacyTable of (int,'a) Redblackmap.dict
    | FixedTable of {work:W.portfolio,map:'a R.int_map,
                     rows:(int * 'a) list}
    | PolicyFixedTable of {work:W.portfolio,map:'a R.int_map,
        rows:(int * 'a) list,
        profiles:SmtReplayNamedContext.profile_store,
        contract:SmtReplayNativeContract.contract,guard:unit->unit}
  fun remaining work = IntInf.fromInt
    (W.work_limit work - #charged (W.audit work))
  fun pay work amount =
    if amount >= 0 andalso amount <= remaining work then
      W.spend work (IntInf.toInt amount)
    else (W.close work;raise ERR "private_table" "original Work exhausted")
  fun table_peek (LegacyTable map,key) = Redblackmap.peek (map,key)
    | table_peek (FixedTable {work,map,...},key) =
        (let val plan = W.legacy_plan_lookup_int work (map,key)
        in R.int_lookup_value (map,plan) end
        handle primary => (W.close work;raise primary))
    | table_peek (PolicyFixedTable {work,map,guard,...},key) =
        ((guard ();
          let val plan=W.plan_lookup_int work (map,key)
              val value=R.int_lookup_value (map,plan)
              val _=guard ()
          in value end)
         handle primary=>(W.close work;raise primary))
  fun table_find (LegacyTable map,key) = Redblackmap.find (map,key)
    | table_find (table as FixedTable {work,...},key) =
        (case table_peek (table,key) of SOME value => value
         | NONE => (W.close work;raise ERR "private_table"
             "missing retained table key"))
    | table_find (table as PolicyFixedTable {work,...},key) =
        (case table_peek (table,key) of SOME value=>value
         | NONE=>(W.close work;raise ERR "private_table"
             "missing retained policy table key"))
  fun table_list (LegacyTable map) = Redblackmap.listItems map
    | table_list (FixedTable {rows,...}) = rows
    | table_list (PolicyFixedTable {rows,guard,...}) =
        (guard ();rows)
  fun table_foldl operation initial (LegacyTable map) =
        Redblackmap.foldl operation initial map
    | table_foldl operation initial (FixedTable {work,rows,...}) =
        (List.foldl (fn ((key,value),state) =>
          (W.spend work 1;operation (key,value,state))) initial rows
         handle primary => (W.close work;raise primary))
    | table_foldl operation initial
        (PolicyFixedTable {work,rows,guard,...}) =
        ((guard ();List.foldl (fn ((key,value),state)=>
          (W.spend_policy work 1;operation (key,value,state))) initial rows)
         handle primary=>(W.close work;raise primary))
  fun table_app operation (LegacyTable map) = Redblackmap.app operation map
    | table_app operation (FixedTable {work,rows,...}) =
        (List.app (fn row => (W.spend work 1;operation row)) rows
         handle primary => (W.close work;raise primary))
    | table_app operation (PolicyFixedTable {work,rows,guard,...}) =
        ((guard ();List.app (fn row=>
          (W.spend_policy work 1;operation row)) rows)
         handle primary=>(W.close work;raise primary))
  fun table_owned (LegacyTable _) = false
    | table_owned (FixedTable _) = true
    | table_owned (PolicyFixedTable _) = true
  datatype 'a fixed_table_plan = FixedTablePlan of
    {work:W.portfolio,base:'a R.int_map,
     listing:'a R.int_batch_listing,used:bool ref}
  fun prepare_fixed_table work inputs key =
    let val _ = W.spend work 2
        val base = R.empty_int ()
        fun keys [] = []
          | keys (input::rest) =
              (* Actual key-copy events plus THIS future payload row/cons.
                 This private plan owns the later exact one-shot replay. *)
              (W.spend work 6;key input :: keys rest)
        val batch = W.legacy_plan_insert_int_batch work (base,keys inputs)
        val listing = W.legacy_plan_list_int_batch work batch
        (* Plan3, future one-shot/control events5, FixedTable2.
           W/Scope guard helper internals remain a separate open quote. *)
        val _ = W.spend work 10
    in FixedTablePlan {work = work,base = base,
      listing = listing,used = ref false} end
  fun finish_fixed_table expected
      (FixedTablePlan {work,base,listing,used}) inputs payload =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "finish_fixed_table" "different original Work";
      W.spend work 0;
      if !used then raise ERR "finish_fixed_table" "table plan already used"
        else used := true;
      let fun values [] = []
            | values (input::rest) =
                payload input :: values rest
          val map = R.finish_int_batch_with_listing
            (base,listing,values inputs)
          val rows = R.finish_batch_list_int (map,listing)
      in FixedTable {work = work,map = map,rows = rows} end)
     handle primary => (W.close expected;raise primary))
  fun fixed_table work inputs key payload =
    finish_fixed_table work (prepare_fixed_table work inputs key)
      inputs payload

  (* Private fixed tables originate ONLY in the SAME authentic naming plan.
     No arbitrary generic set/comparator or caller name/type map is adopted. *)
  datatype fixed_names = FixedNames of
    {work:W.portfolio,graph:G.graph,scope:G.scope,frame:Scope.receipt,
     strings:R.string_set option,types:(string * Type.hol_type) R.int_map,
     held:G.closure_child list,epoch:int,symbols:int,
     validated_revision:IntInf.int option ref}
  fun fixed_names_guard expected (FixedNames
      {work,graph,scope,frame,held,epoch,symbols,validated_revision,...}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "fixed_names_guard" "different original Work";
      let val actual = Scope.description_for expected frame
      in if Portable.pointer_eq (#graph actual,graph) andalso
          #scope actual = scope andalso Type.type_epoch () = epoch andalso
          Term.term_epoch () = symbols then () else
        raise ERR "fixed_names_guard" "different original frame/epochs" end;
      (* Frame validation above is NEVER cached: Backend lexical frame
         retirement is distinct from graph publication. This cache covers
         only completed callback-free G paths in this exact held object. *)
      let val revision = G.validation_revision graph scope
      in if !validated_revision = SOME revision then () else
        (List.app (fn child =>
           ignore (G.closure_child_node graph scope child)) held;
         if G.validation_revision graph scope = revision then
           validated_revision := SOME revision else
           validated_revision := NONE) end)
     handle primary =>
       (validated_revision := NONE;W.close expected;raise primary))
  fun naming_index expected name =
    let val prefix = "__smt_replay_" val width = String.size prefix
        val _ = W.spend expected (width + String.size name + 1)
        val _ = if String.isPrefix prefix name then () else
          raise ERR "naming_index" "not a genuine graph placeholder name"
        val length = String.size name-width
        (* Tail extraction/copy and decimal parse are separate primitives.
           This path is reached only for authentic retained G names; all G
           writers use the canonical nonnegative machine-Int spelling. *)
        val _ = W.spend expected (length+1)
        val tail = String.extract (name,width,NONE)
        val _ = W.spend expected (length+1)
    in case Int.fromString tail of SOME index =>
        if index >= 0 then index else
          raise ERR "naming_index" "negative graph placeholder index"
      | NONE => raise ERR "naming_index" "unbounded placeholder index" end
  fun prepare_fixed_names work graph scope frame naming held =
    ((G.validate_placeholder_plan graph scope naming;
      let val rows = G.placeholder_plan_bindings naming
          val _ = W.spend work 2
          val initial_types = R.empty_int ()
          fun prepare [] types = types
            | prepare ((node,name,ty)::rest) types =
              let val _ = W.spend work 1
                  val index = naming_index work name
                  val slot = W.legacy_plan_insert_int work (types,index)
                  val _ = W.spend work 1
                  val next_types = R.finish_int (types,slot,(name,ty))
              in prepare rest next_types end
          val types = prepare rows initial_types
          val _ = W.spend work 3
          val names = FixedNames {work = work,graph = graph,scope = scope,
            frame = frame,strings = NONE,types = types,held = held,
            epoch = Type.type_epoch (),symbols = Term.term_epoch (),
            validated_revision = ref NONE}
          val _ = fixed_names_guard work names
      in names end)
     handle primary => (W.close work;raise primary))
  (* The finite naming plan already supplies canonical numeric suffixes.
     One typed index suffices: a parsed integer is only a search key, and
     the retained FULL spelling must also agree. Arbitrary public variables
     (including malformed/overflowing suffixes) remain nonmembers. The old
     policy path retains its independent string-set programme below. *)
  fun fixed_suffix_name spend lookup name =
    let val prefix = "__smt_replay_" val width = String.size prefix
        val _ = spend (IntInf.fromInt width +
          IntInf.fromInt (String.size name) + 1)
    in if not (String.isPrefix prefix name) then NONE else
      let val length = String.size name-width
          val _ = spend (IntInf.fromInt length+1)
          val tail = String.extract (name,width,NONE)
          val _ = spend (IntInf.fromInt length+1)
          val parsed = Int.fromString tail handle Overflow => NONE
      in case parsed of NONE => NONE | SOME index =>
        if index < 0 then NONE else case lookup index of NONE => NONE
        | SOME (exact,wanted) =>
          let val _ = spend (IntInf.fromInt (String.size exact) +
                IntInf.fromInt (String.size name) + 1)
          in if exact = name then SOME wanted else NONE end
      end
    end
  (* Comparison operands are actual immutable Type objects, never a caller
     tree count. Name bytes and each public type incidence are admitted
     before the fixed Type.compare; hidden kernel forcing is not priced. *)
  fun variable_type_work_using spend ty =
    let
      fun walk [] total = total
        | walk (pending::more) total =
          (spend 1;case pending of [] => walk more total
           | current::rest =>
             let val _ = spend 1
                 val variable = Type.is_vartype current
             in if variable then
                  let val _ = spend 2
                      val text = Type.dest_vartype current
                      val bytes = String.size text
                      val _ = spend bytes
                      val _ = spend 1
                  in walk (rest::more)
                       (total+IntInf.fromInt (1+bytes)) end
                else
                  let val _ = spend 4
                      val {Thy,Tyop,Args} = Type.dest_thy_type current
                      val bytes = String.size Thy + String.size Tyop
                      val _ = spend bytes
                      val _ = spend 2
                  in walk (Args::rest::more)
                       (total+IntInf.fromInt (1+bytes)) end
             end)
      val _ = spend 2
    in walk [[ty]] (0 : IntInf.int) end
  fun variable_type_work work = variable_type_work_using (W.spend work)
  (* Private query within one already guarded callback-free inspection.
     Outer guard validates all incoming paths before and after this span. *)
  fun fixed_names_member_using spend metadata_pay expected (FixedNames
      {work,strings,types,...}) term =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "fixed_names_member" "different original Work";
      W.spend expected 0;
      let val _ = spend 1
          val (name,ty) = Term.dest_var term
      in case strings of NONE =>
          let fun lookup index =
                let val query = W.legacy_plan_lookup_int expected (types,index)
                in R.int_lookup_value (types,query) end
          in case fixed_suffix_name metadata_pay lookup name of
              NONE => false
            | SOME wanted =>
              (* The actual name/index/spelling lookup already succeeded.
                 Immutable Type identity needs no forest or comparator. *)
              (spend 2;
               if Portable.pointer_eq (ty,wanted) then true else
                 let val a = variable_type_work_using spend ty
                     val b = variable_type_work_using spend wanted
                     val _ = pay expected (1+a+b)
                 in Type.compare (ty,wanted) = EQUAL end)
          end
        | SOME strings =>
          let
          val query = W.legacy_plan_lookup_string expected (strings,name)
      in if not (R.string_lookup_value (strings,query)) then false else
        let val index = naming_index expected name
            val slot = W.legacy_plan_lookup_int expected (types,index)
            val (exact,wanted) = case R.int_lookup_value (types,slot) of
                SOME pair => pair | NONE =>
                  raise ERR "fixed_names_member" "missing authentic typed name"
            val _ = spend (String.size exact + String.size name + 1)
            val _ = if exact = name then () else
              raise ERR "fixed_names_member" "different authentic spelling"
            (* Same authentic immutable-Type reflexivity, after the full
               string/name/index/spelling lookup. Distinct objects retain
               both original forests and the exact Type.compare. *)
            val _ = spend 2
        in if Portable.pointer_eq (ty,wanted) then true else
          let val a = variable_type_work_using spend ty
              val b = variable_type_work_using spend wanted
              val _ = pay expected (1+a+b)
              val equal = Type.compare (ty,wanted) = EQUAL
          in equal end
        end
          end
      end)
     handle primary => (W.close expected;raise primary))

  fun fixed_names_member work =
    fixed_names_member_using (W.spend work) (pay work) work

  fun bound_variable_member_using spend work term binders =
    let val (name,ty) = Term.dest_var term
        fun member [] = false
          | member (binder::rest) =
            let val _ = spend 1
                val (old,wanted) = Term.dest_var binder
                val _ = spend (String.size name + String.size old + 1)
            in if name <> old then member rest else
              let val a = variable_type_work_using spend ty
                  val b = variable_type_work_using spend wanted
                  val _ = pay work (1+a+b)
              in Type.compare (ty,wanted) = EQUAL orelse member rest end
            end
    in member binders end

  datatype owned_tables_plan = OwnedTablesPlan of
    {work:W.portfolio,graph:G.graph,scope:G.scope,frame:Scope.receipt,
     template:int,roots:G.node list,closed_facts:closed_fact list,
     conversions:closed_conversion list,reachable:G.node list,
     held:G.closure_child list,node_plan:(G.node * Term.term) fixed_table_plan,
     naming:G.placeholder_plan,name_guard:fixed_names,
     definition_plan:int fixed_table_plan,
     definition_rows:(int * int) list,used:bool ref}

  (* Private DATA, never a completed lifetime/Scope/policy observation.
     Slots below are addressed by a genuine dependency ordinal, then fenced
     by the actual theorem pointer. A shared dependency with a different
     output replaces ONE slot: it cannot create a theorem-list search. *)
  type primitive_term_data =
    {term:Term.term,value:SmtReplayNamedContext.profile,
     bytes:IntInf.int option ref}
  type primitive_hyp_data =
    {reversed:Term.term list,unique:Term.term list,without:Term.term list,
     entries:primitive_term_data list,
     unique_entries:primitive_term_data list,
     without_entries:primitive_term_data list,
     count:IntInf.int,others:IntInf.int,common:bool,
     common_weight:IntInf.int,
     full:SmtReplayNamedContext.profile,
     noncommon:SmtReplayNamedContext.profile,
     maximum:SmtReplayNamedContext.profile,
     admitted:IntInf.int option ref}
  type primitive_edge_data =
    {conclusion:primitive_term_data option ref,
     equation:(primitive_term_data * primitive_term_data) option ref,
     implication:primitive_term_data option ref,
     hypotheses:primitive_hyp_data option ref}
  datatype primitive_metadata = PrimitiveMetadata of
    {revision:IntInf.int,epoch:int,symbols:int,
     profiles:(Term.term * SmtReplayNamedContext.profile) list Array.array,
     bytes:(Term.term * IntInf.int) list Array.array,
     operands:(Term.term * int) list Array.array,
     edges:(Thm.thm * primitive_edge_data) option Array.array ref}
  type compact_assembly =
    {proof:Thm.thm,indices:int list option,tree:boundary,
     context:Term.term,projections:Thm.thm vector,law:Thm.thm,
     geometry:(int * int * int) option}
  datatype block = Block of
    {owner : unit ref, graph : G.graph, scope : G.scope,
     nodes : (G.node * Term.term) table,
     names : Term.term HOLset.set,
     owned_names : fixed_names option,
     leaves : leaf vector, tree : boundary, context : Term.term,
     projections : Thm.thm vector,
     leaf_index : (Term.term,int list) Redblackmap.dict option,
     definitions : int table,
     source_count : int, template_limit : int, realized : bool ref,
     next_dependency : int ref,
     primitive_metadata : primitive_metadata option ref,
     assembly : compact_assembly option ref,
     owned_frame : (W.portfolio * Scope.receipt) option}
  datatype edge = Edge of
    {owner : unit ref, theorem : Thm.thm, dependencies : dependency,
     primitive : (int * int * primitive_edge_data) option}

  datatype retained_source_frame = RetainedSourceFrame of
    {block : block,work : W.portfolio,frame : Scope.receipt,
     graph : G.graph,scope : G.scope,template_limit : int,
     original_slots : G.node list,selected_indices : int list,
     sources : G.node list,held : G.closure_child list,
     epoch : int,symbols : int}

  (* Distinct from Source-free equality realization: only a genuine sparse
     owned block edge mints this receipt. Slot indices are actual BLOCK
     occurrences, never original S ordinal authority or a caller array. *)
  datatype source_origin = ActualSourceSlot of unit ref * int
    | OriginalPrefixSlot of SmtReplaySource.sources * int
  datatype source_realization = SourceRealization of
    {work : W.portfolio,source_frame : retained_source_frame,
     graph : G.graph,root : G.scope,scope : G.scope,frame : Scope.receipt,
     original_sources : SmtReplaySource.sources,target : G.node,
     occurrences : (int * G.node) list,
     origins : (int * source_origin) list,theorem : Thm.thm,
     compact : source_compact,
     held : G.closure_child list,facts : closed_fact list,
     conversions : closed_conversion list,template_limit : int,
     parents : source_realization list,epoch : int,symbols : int}
  and source_compact = SourceCompact of
    {block : block,edge : edge,target_name : Term.term,proof : Thm.thm,
     needed : int list,closed : compact_assembly option,
     names : (G.node * Term.term) list,extra_leaves : leaf list,
     cuts : (int * Term.term * source_realization) list}

  datatype realization_frontier = RealizationFrontier of
    {work : W.portfolio,graph : G.graph,scope : G.scope,
     frame : Scope.receipt,template_limit : int,epoch : int,symbols : int,
     roots : G.node list,sources : G.node list,closed_facts : closed_fact list,
     conversions : closed_conversion list,reachable : G.node list,
     atoms : G.node list,held : G.closure_child list,
     retained_sources : retained_source_frame option}
  datatype realization_tables_plan = RealizationTablesPlan of
    {work : W.portfolio,frontier : realization_frontier,
     plan : owned_tables_plan}

  fun clean theorem =
    let val (oracles, _) = Tag.dest_tag (Thm.tag theorem) in
      List.all (fn oracle => oracle = "DISK_THM") oracles andalso
      List.null (Tag.axioms_of (Thm.tag theorem))
    end

  (* Type metadata is immutable. Cache physical nodes, but add each actual
     child occurrence to the exact unfolded incidence count. No supplied
     Type policy runs here, and no cache survives this one constructor. *)
  fun pc_type_counter () = SmtReplayGoalClose.type_counter
    (fn()=>ERR "policy_type_count" "unfinished child") ()
  structure RP=SmtReplayResourcePolicy
  fun pg_metric_guard graph scope captures =
    List.app (fn capture=>ignore
      (G.profiled_metric_data graph scope capture)) captures
  fun pcf_for expected
      (saved as PolicyRealizedClosedFact {work,...}) =
    ((if Portable.pointer_eq(expected,work) then () else
        raise ERR "policy_closed_fact" "different original Work";
      let val PolicyRealizedClosedFact {guard,...}=saved
      in guard () end)
     handle primary=>(W.close expected;raise primary))
    | pcf_for _ _=()
  fun pcf_validate graph scope maximum
      (saved as PolicyRealizedClosedFact {graph=owner,...}) =
    if Portable.pointer_eq(graph,owner) then
      let val PolicyRealizedClosedFact {scope=frame,template_limit,
                guard,...}=saved
          val _=if maximum=template_limit then () else
            raise ERR "freeze" "different original policy"
          val _=G.validate_scope graph scope
          val _=if G.scope_visible graph scope frame then () else
            raise ERR "freeze" "closed fact escapes actual frame"
      in guard () end
    else raise ERR "freeze" "different graph owner"
    | pcf_validate _ _ _ _=
        raise ERR "freeze" "not a policy realization fact"

  fun pc_closed_node (PolicyClosedFact
      {graph,scope,node,metric_captures,...}) =
        (G.validate_scope graph scope;ignore (G.view graph node);
         pg_metric_guard graph scope metric_captures;node)
    | pc_closed_node _=raise ERR "closed_node" "not a policy closed fact"
  fun pc_validate_closed graph scope maximum
      (fact as PolicyClosedFact {graph=owner,...}) =
    let
      val _=if Portable.pointer_eq (graph,owner) then () else
        raise ERR "freeze" "closed auxiliary owner or cap differs"
      val PolicyClosedFact {scope=frame,node,canonical,template_limit,...}=fact
      val _=if maximum=template_limit then () else
        raise ERR "freeze" "closed auxiliary owner or cap differs"
      val _=ignore (pc_closed_node fact)
      val _=if G.scope_visible graph scope frame then () else
        raise ERR "freeze" "closed auxiliary owner or cap differs"
    in if Portable.pointer_eq (Thm.concl canonical,
           G.representative graph node) andalso
         List.null (Thm.hyp canonical) andalso clean canonical then () else
      raise ERR "freeze" "closed auxiliary proof differs" end
    | pc_validate_closed _ _ _ _ =
        raise ERR "freeze" "not a policy closed fact"
  fun pc_validate_conversion graph scope maximum
      (saved as PolicyClosedConversion {graph=owner,...}) =
    let
      val _=if Portable.pointer_eq (graph,owner) then () else
        raise ERR "conversion" "owner or original cap differs"
      val PolicyClosedConversion {scope=frame,source,target,source_view,
        target_view,theorem,template_limit,metric_captures,...}=saved
      val _=if maximum=template_limit then () else
        raise ERR "conversion" "owner or original cap differs"
      val _=G.validate_scope graph scope
      val _=if G.scope_visible graph scope frame then () else
        raise ERR "conversion" "owner or original cap differs"
      val _=pg_metric_guard graph frame metric_captures
      val _=G.validate_opened_view graph frame source source_view
      val _=G.validate_opened_view graph frame target target_view
      val (left,right)=boolSyntax.dest_eq (Thm.concl theorem)
    in if null (Thm.hyp theorem) andalso clean theorem andalso
        Portable.pointer_eq (left,G.representative graph source) andalso
        Portable.pointer_eq (right,G.representative graph target) then () else
      raise ERR "conversion" "retained closed endpoints differ" end
    | pc_validate_conversion _ _ _ _ =
        raise ERR "conversion" "not a policy closed conversion"
  (* Guarded typed conversions retain a genuine late realization or a
     canonical closed fact; neither factory accepts a raw proof pair. *)
  fun pcr_for expected (saved as PolicyRealizedConversion {work,...}) =
    ((if Portable.pointer_eq(expected,work) then () else
        raise ERR "validate_conversion_for" "different original Work";
      let val PolicyRealizedConversion {guard,...}=saved
      in guard () end)
     handle primary=>(W.close expected;raise primary))
    | pcr_for expected _=(W.close expected;
        raise ERR "validate_conversion_for" "not a policy realization")
  fun pcr_validate graph scope maximum
      (saved as PolicyRealizedConversion {graph=owner,...}) =
    if Portable.pointer_eq(graph,owner) then
      let val PolicyRealizedConversion {scope=frame,template_limit,
                guard,...}=saved
          val _=if maximum=template_limit then () else
            raise ERR "conversion" "different original policy"
          val _=G.validate_scope graph scope
          val _=if G.scope_visible graph scope frame then () else
            raise ERR "conversion" "realized endpoint escapes actual frame"
      in guard () end
    else raise ERR "conversion" "different graph owner"
    | pcr_validate _ _ _ _=
        raise ERR "conversion" "not a policy realization"

  fun pc_conversion_for expected (saved as PolicyClosedConversion _) =
    ((let
        val sources=W.original_sources expected
        val graph=SmtReplaySource.owning_graph sources
        val root=SmtReplaySource.owning_scope sources
        val limits=W.semantic_policy expected
        val _=W.validate_policy expected graph root sources limits
        val PolicyClosedConversion {graph=owner,...}=saved
        val _=if Portable.pointer_eq (graph,owner) then () else
          raise ERR "validate_conversion_for" "different original graph"
        val PolicyClosedConversion {scope,...}=saved
        val _=if G.scope_visible graph scope root then () else
          raise ERR "validate_conversion_for" "outside original Source root"
      in pc_validate_conversion graph scope (#template_limit limits) saved end)
     handle primary=>(W.close expected;raise primary))
    | pc_conversion_for expected _=
        (W.close expected;raise ERR "validate_conversion_for"
          "not a policy closed conversion")

  fun closed_node (ClosedFact {graph,scope,node,...}) =
    (G.validate_scope graph scope;ignore (G.view graph node);node)

    | closed_node (fact as PolicyClosedFact _)=pc_closed_node fact
    | closed_node (PolicyRealizedClosedFact {node,guard,...})=
        (guard ();node)
  fun closed_original (fact as ClosedFact {original,...}) =
    (ignore (closed_node fact);original)
    | closed_original (fact as PolicyClosedFact {original,...})=
        (ignore (closed_node fact);original)
    | closed_original (PolicyRealizedClosedFact {theorem,guard,...})=
        (guard ();theorem)
  fun closed_proof (ClosedFact {canonical,...}) = canonical

    | closed_proof (PolicyClosedFact {canonical,...})=canonical
    | closed_proof (PolicyRealizedClosedFact {theorem,guard,...})=
        (guard ();theorem)

  (* The graph-owned binder recipe is a prerequisite. Unknown metrics
     decline BEFORE inspecting the original theorem's term structure.
     This function never opens an original abstraction or trusts an
     arbitrary semantic equality supplied alongside the theorem. *)
  fun record_closed_program exact from_import graph scope
      {node,theorem,template_limit,check_type} =
    let
      val _ = G.validate_scope graph scope
      val _ = ignore (G.view graph node)
      val _ = if template_limit > 0 then () else
        raise ERR "record_closed" "nonpositive original template limit"
      val _ = if G.scope_visible graph scope (G.node_scope graph node)
        then () else raise ERR "record_closed" "foreign auxiliary scope"
      val _ = List.app (fn metric =>
        case G.unfolded_nodes graph metric template_limit node of
          SOME count => if count <= template_limit then () else
            raise ERR "record_closed" "auxiliary metric exceeds limit"
        | NONE => raise ERR "record_closed" "unrecorded auxiliary binder")
        [G.RawNodes,G.BinderInclusiveNodes]
      val _ = if List.null (Thm.hyp theorem) andalso clean theorem then ()
        else raise ERR "record_closed" "auxiliary is not clean and closed"
      (* Bound actual type incidences before the caller's type policy.
         G.reachable includes already recorded opened binder bodies. *)
      val reachable = G.reachable graph [node]
      val types = List.map (G.type_of graph) reachable
      val remaining = ref template_limit
      fun type_shape [] = ()
        | type_shape (ty :: rest) =
            if !remaining = 0 then
              raise ERR "record_closed" "type portfolio exceeds limit"
            else (remaining := !remaining - 1;
              if Type.is_vartype ty then type_shape rest
              else type_shape (#2 (Type.dest_type ty) @ rest))
      val _ = type_shape types
      datatype recipe = Identity of Term.term
        | Anchor of Thm.thm
        | WholeAnchor of Thm.thm * Thm.thm
        | Atom of Term.term * Term.term
        | Application of Term.term * Term.term * recipe * recipe
      fun plan current original =
        let val representative = G.representative graph current in
          if Portable.pointer_eq (original,representative) then
            Identity original
          else case G.source_anchor graph current of
            SOME {original = held,bridge,...} =>
              if Portable.pointer_eq (original,held) then
                let val (left,right) = boolSyntax.dest_eq (Thm.concl bridge)
                    val _ = if List.null (Thm.hyp bridge) andalso
                        clean bridge andalso
                        Portable.pointer_eq (left,held) andalso
                        Portable.pointer_eq (right,representative) then ()
                      else raise ERR "record_closed" "source anchor differs"
                in Anchor bridge end
              else composite current original representative
          | NONE => composite current original representative
        end
      and composite current original representative =
        case G.view graph current of
          G.Application (operator,operand) =>
            if Term.is_comb original then
              let val (f,x) = Term.dest_comb original
              in Application (original,representative,
                plan operator f,plan operand x) end
            else raise ERR "record_closed" "original auxiliary shape differs"
        | G.Constant _ =>
            if Term.is_const original then
              let val ty = Term.type_of original
                  val _ = type_shape [ty]
              in if Term.same_const original representative andalso
                  Type.compare (ty,G.type_of graph current) = EQUAL then
                    Atom (original,representative)
                else raise ERR "record_closed" "constant declaration differs"
              end
            else raise ERR "record_closed" "original constant shape differs"
        | G.Variable (G.RigidSource,_) =>
            if Term.is_var original then
              let val (text,ty) = Term.dest_var original
                  val _ = type_shape [ty]
              in if text = #1 (Term.dest_var representative) andalso
                  Type.compare (ty,G.type_of graph current) = EQUAL then
                    Atom (original,representative)
                else raise ERR "record_closed" "rigid source variable differs"
              end
            else raise ERR "record_closed" "original variable shape differs"
        | _ => raise ERR "record_closed" "original auxiliary anchor differs"
      val original = Thm.concl theorem
      val _ = if exact andalso not (Portable.pointer_eq
          (original,G.representative graph node)) then
        raise ERR "record_closed_exact" "different exact native conclusion"
        else ()
      val epoch = Type.type_epoch ()
      fun retained_import () =
        let val (imported,opened) =
              G.imported_opened_source graph scope original node
            val first = #bridge imported val second = #bridge opened
            val (a,b) = boolSyntax.dest_eq (Thm.concl first)
            val (c,d) = boolSyntax.dest_eq (Thm.concl second)
        in if Portable.pointer_eq (a,original) andalso
            Portable.pointer_eq
              (b,G.representative graph (#node imported)) andalso
            Portable.pointer_eq (#original opened,b) andalso
            Portable.pointer_eq (b,c) andalso
            Portable.pointer_eq (d,G.representative graph node) andalso
            null (Thm.hyp first) andalso null (Thm.hyp second) andalso
            clean first andalso clean second then (first,second)
          else raise ERR "record_closed" "registered whole bridge differs"
        end
      val held = if from_import then SOME (retained_import ()) else NONE
      fun active () =
        (G.validate_scope graph scope;
         if from_import then
           (if Type.type_epoch () = epoch then () else
              raise ERR "record_closed" "Type retirement epoch changed";
            List.app (fn current => G.validate_scope graph
              (G.node_scope graph current)) reachable;
            let val (first,second) = retained_import ()
            in case held of SOME (a,b) =>
                 if Portable.pointer_eq (a,first) andalso
                     Portable.pointer_eq (b,second) then () else
                   raise ERR "record_closed" "retained import bridge changed"
               | NONE => raise ERR "record_closed" "missing retained bridge"
            end)
         else ())
      val recipe = case held of SOME pair => WholeAnchor pair
        | NONE => plan node original
      (* All syntax/metric/type portfolios precede proof bridge operations. *)
      val _ = List.app (fn ty => (active ();check_type ty;active ())) types
      val _ = if Type.compare (G.type_of graph node,Type.bool) = EQUAL
        then () else raise ERR "record_closed" "auxiliary is not Boolean"
      fun execute (Identity term) = SmtReplayRuleObservation.REFL term
        | execute (Anchor proof) = proof
        | execute (WholeAnchor (first,second)) =
            SmtReplayRuleObservation.TRANS first second
        | execute (Atom (original,representative)) =
            SmtReplayRuleObservation.ALPHA original representative
        | execute (Application (original,representative,f,x)) =
            let val joined = SmtReplayRuleObservation.MK_COMB
                  (execute f,execute x)
                val (left,right) = boolSyntax.dest_eq (Thm.concl joined)
            in SmtReplayRuleObservation.TRANS
                 (SmtReplayRuleObservation.ALPHA original left)
                 (SmtReplayRuleObservation.TRANS joined
                   (SmtReplayRuleObservation.ALPHA right representative)) end
      val _ = active ()
      val canonical = if exact then theorem else
        SmtReplayRuleObservation.EQ_MP (execute recipe) theorem
      val _ = if Portable.pointer_eq (Thm.concl canonical,
            G.representative graph node) andalso
          List.null (Thm.hyp canonical) andalso clean canonical then ()
        else raise ERR "record_closed" "canonical auxiliary changed"
      val _ = active ()
    in ClosedFact {graph = graph,scope = scope,node = node,
      original = theorem,canonical = canonical,
      template_limit = template_limit} end

  fun record_closed_internal from_import graph scope args =
    record_closed_program false from_import graph scope args
  (* Already canonical clean closed proof: no alignment operation exists.
     All established metric/type/Scope admission above is still performed. *)
  fun record_closed_exact graph scope args =
    record_closed_program true false graph scope args
  fun record_closed graph scope args =
    record_closed_internal false graph scope args
  fun record_closed_from_import graph scope args =
    record_closed_internal true graph scope args

  fun realization_owner (Realization {work,...}) = work
  fun realization_guard receipt =
    let val expected = realization_owner receipt
        val completed = ref ([] : realization list)
        fun visit (current as Realization
            {work,graph,root,scope,sources,frame,template_limit,epoch,symbols,
             equality,source,target,held,facts,conversions,theorem,...}) =
          (if Portable.pointer_eq (expected,work) then () else
             raise ERR "realization_guard" "different retained original Work";
           if List.exists (fn old => Portable.pointer_eq (current,old))
               (!completed) then () else
           let
             val data = Scope.description_for work frame
             val _ = if Portable.pointer_eq (#graph data,graph) andalso
                 #root data = root andalso #scope data = scope andalso
                 Portable.pointer_eq (#sources data,sources) andalso
                 #template_limit (W.semantic_limits work) = template_limit
               then () else raise ERR "realization_guard"
                 "original owner changed"
             val _ = if Type.type_epoch () = epoch andalso
                 Term.term_epoch () = symbols then () else
               raise ERR "realization_guard" "type or term retirement changed"
             val _ = List.app (fn child =>
               ignore (G.closure_child_node graph scope child)) held
             val _ = List.app (fn ClosedFact {graph = owner,scope = frame,
                 node,canonical,template_limit = limit,...} =>
               if Portable.pointer_eq (owner,graph) andalso
                   G.scope_visible graph scope frame andalso
                   limit = template_limit andalso
                   null (Thm.hyp canonical) andalso clean canonical andalso
                   Portable.pointer_eq (Thm.concl canonical,
                     G.representative graph node) then () else
                 raise ERR "realization_guard" "retained fact changed"
               | PolicyRealizedClosedFact _=>raise ERR "realization_guard"
                   "policy fact in finite realization") facts
             fun child (RealizedConversion inherited) = visit inherited
               | child (ClosedConversion {graph = owner,scope = frame,
                   source,target,source_view,target_view,theorem,
                   template_limit = limit}) =
                 let val _ = if Portable.pointer_eq (owner,graph) andalso
                         limit = template_limit andalso
                         G.scope_visible graph scope frame then () else
                       raise ERR "realization_guard" "retained leaf changed"
                     val _ = G.validate_opened_view graph frame source
                       source_view
                     val _ = G.validate_opened_view graph frame target
                       target_view
                     val (left,right) = boolSyntax.dest_eq (Thm.concl theorem)
                 in if null (Thm.hyp theorem) andalso clean theorem andalso
                     Portable.pointer_eq (left,G.representative graph source)
                     andalso Portable.pointer_eq
                       (right,G.representative graph target) then () else
                   raise ERR "realization_guard" "retained equality changed" end
               | child (PolicyRealizedConversion _)=
                   raise ERR "realization_guard" "policy leaf in finite path"
             val _ = List.app child conversions
             val (left,right) = boolSyntax.dest_eq (Thm.concl theorem)
             val _ = if null (Thm.hyp theorem) andalso clean theorem andalso
                 Portable.pointer_eq (Thm.concl theorem,
                   G.representative graph equality) andalso
                 Portable.pointer_eq (left,G.representative graph source)
                 andalso Portable.pointer_eq
                   (right,G.representative graph target) then () else
               raise ERR "realization_guard" "canonical endpoints changed"
           in completed := current :: !completed end)
    in visit receipt end
  fun conversion_source (ClosedConversion {graph,scope,source,...}) =
        (G.validate_scope graph scope;ignore (G.view graph source);source)
    | conversion_source (RealizedConversion (receipt as Realization
        {source,...})) = (realization_guard receipt;source)
    | conversion_source (PolicyClosedConversion
        {graph,scope,source,metric_captures,...})=
        (G.validate_scope graph scope;ignore (G.view graph source);
         pg_metric_guard graph scope metric_captures;source)
    | conversion_source (PolicyRealizedConversion
        {source,guard,...})=(guard ();source)
  fun conversion_target (ClosedConversion {graph,scope,target,...}) =
        (G.validate_scope graph scope;ignore (G.view graph target);target)
    | conversion_target (RealizedConversion (receipt as Realization
        {target,...})) = (realization_guard receipt;target)
    | conversion_target (PolicyClosedConversion
        {graph,scope,target,metric_captures,...})=
        (G.validate_scope graph scope;ignore (G.view graph target);
         pg_metric_guard graph scope metric_captures;target)
    | conversion_target (PolicyRealizedConversion
        {target,guard,...})=(guard ();target)
  fun conversion_proof (ClosedConversion {theorem,...}) = theorem
    | conversion_proof (RealizedConversion (receipt as Realization
        {theorem,...})) = (realization_guard receipt;theorem)
    | conversion_proof (PolicyClosedConversion {theorem,...})=theorem
    | conversion_proof (PolicyRealizedConversion {theorem,guard,...})=
        (guard ();theorem)
  fun validate_realization_for expected receipt =
    ((if Portable.pointer_eq (expected,realization_owner receipt) then () else
        raise ERR "validate_realization_for" "different original Work";
      realization_guard receipt)
     handle primary => (W.close expected;raise primary))
  fun validate_conversion_for expected (RealizedConversion receipt) =
        validate_realization_for expected receipt
    | validate_conversion_for _ (ClosedConversion _) = ()
    | validate_conversion_for expected (saved as PolicyClosedConversion _)=
        pc_conversion_for expected saved
    | validate_conversion_for expected
        (saved as PolicyRealizedConversion _)=pcr_for expected saved
  fun conversion_realization_for expected (RealizedConversion receipt) =
        (validate_realization_for expected receipt;SOME receipt)
    | conversion_realization_for _ (ClosedConversion _) = NONE
    | conversion_realization_for expected (saved as PolicyClosedConversion _)=
        (pc_conversion_for expected saved;NONE)
    | conversion_realization_for expected
        (saved as PolicyRealizedConversion _)=(pcr_for expected saved;NONE)
  fun conversion_from_realization expected receipt =
    (validate_realization_for expected receipt;RealizedConversion receipt)
  fun realization_data_for expected (receipt as Realization
      {graph,root,scope,sources,equality,source,target,template_limit,...}) =
    (validate_realization_for expected receipt;
     {graph = graph,root = root,scope = scope,sources = sources,
      equality = equality,source = source,target = target,
      template_limit = template_limit})
  fun realization_theorem_for expected (receipt as Realization
      {theorem,...}) = (validate_realization_for expected receipt;theorem)

  (* BOTH views must be genuine graph-recorded syntax recipes. In
     particular a semantic equality cannot replace an opaque source's
     missing syntax admission. The old node retains its original ID. *)
  fun record_conversion_internal typed graph scope
      {source,source_view,target,target_view,theorem,template_limit,
       check_type} =
    let
      val _ = G.validate_opened_view graph scope source source_view
      val _ = G.validate_opened_view graph scope target target_view
      val _ = if template_limit > 0 then () else
        raise ERR "record_conversion" "nonpositive template limit"
      fun bound metric =
        let val remaining = ref (template_limit-3)
            fun node current =
              case G.unfolded_nodes graph metric template_limit current of
                SOME count => if count <= !remaining then
                    remaining := !remaining-count
                  else raise ERR "record_conversion" "conversion exceeds cap"
              | NONE => raise ERR "record_conversion" "unknown syntax metric"
        in List.app node [#node source_view,#node target_view] end
      val _ = List.app bound [G.RawNodes,G.BinderInclusiveNodes]
      val _ = if null (Thm.hyp theorem) andalso clean theorem then () else
        raise ERR "record_conversion" "conversion is not clean and closed"
      val (left,right) = boolSyntax.dest_eq (Thm.concl theorem)
      val _ = if Portable.pointer_eq (left,G.representative graph source)
          andalso Portable.pointer_eq (right,G.representative graph target)
        then () else raise ERR "record_conversion" "exact endpoints differ"
      val remaining = ref template_limit
      fun types [] = ()
        | types (ty::rest) =
            if !remaining = 0 then raise ERR "record_conversion" "type cap"
            else (remaining := !remaining-1;
              if Type.is_vartype ty then types rest
              else types (#2 (Type.dest_type ty) @ rest))
      val reachable = G.reachable graph [#node source_view,#node target_view]
      val portfolio = List.map (fn node =>
        (G.validate_scope graph scope;G.type_of graph node)) reachable
      val _ = types portfolio
      val _ = List.app (fn ty =>
        (G.validate_scope graph scope;check_type ty;
         G.validate_scope graph scope)) portfolio
      val _ = if typed then
          (if G.type_id graph source = G.type_id graph target then () else
             raise ERR "record_typed_conversion" "cached endpoint types differ")
        else if Type.compare (G.type_of graph source,Type.bool) = EQUAL
          andalso Type.compare (G.type_of graph target,Type.bool) = EQUAL
        then () else raise ERR "record_conversion" "Boolean endpoints required"
      val _ = G.validate_scope graph scope
    in ClosedConversion {graph = graph,scope = scope,source = source,
      target = target,source_view = source_view,target_view = target_view,
      theorem = theorem,template_limit = template_limit} end
  fun record_conversion graph scope request =
    record_conversion_internal false graph scope request
  fun record_typed_conversion graph scope request =
    record_conversion_internal true graph scope request

  fun validate_conversion graph scope limit
      (conversion as ClosedConversion {graph = owner,scope = frame,source,
          target,source_view,target_view,theorem,template_limit}) =
    let val _ = G.validate_scope graph scope
        val _ = if G.root_scope graph = G.root_scope owner andalso
            G.scope_visible graph scope frame andalso limit = template_limit
          then () else raise ERR "conversion" "owner or original cap differs"
        val _ = G.validate_opened_view graph frame source source_view
        val _ = G.validate_opened_view graph frame target target_view
        val (left,right) = boolSyntax.dest_eq (Thm.concl theorem)
    in if null (Thm.hyp theorem) andalso clean theorem andalso
        Portable.pointer_eq (left,G.representative graph source) andalso
        Portable.pointer_eq (right,G.representative graph target) then ()
      else raise ERR "conversion" "retained closed endpoints differ" end

    | validate_conversion graph scope limit (RealizedConversion
        (receipt as Realization {graph = owner,scope = frame,
                                template_limit,...})) =
      (if Portable.pointer_eq (graph,owner) andalso limit = template_limit
          then () else raise ERR "conversion" "realized owner or cap differs";
       realization_guard receipt;
       if G.scope_visible graph scope frame then () else
         raise ERR "conversion" "realized endpoint escapes actual frame")

    | validate_conversion _ _ _ (PolicyClosedConversion _) =
        raise ERR "conversion" "use validate_conversion_with_policy"
    | validate_conversion _ _ _ (PolicyRealizedConversion _)=
        raise ERR "conversion" "use validate_conversion_with_policy"

  fun validate_closed_fact graph scope limit
      (fact as ClosedFact {graph = owner,scope = frame,node,canonical,
                           template_limit,...}) =
    (ignore (closed_node fact);
     if G.root_scope graph = G.root_scope owner andalso
         G.scope_visible graph scope frame andalso limit = template_limit
     then () else raise ERR "freeze" "closed auxiliary owner or cap differs";
     if Portable.pointer_eq (Thm.concl canonical,
           G.representative graph node) andalso
         List.null (Thm.hyp canonical) andalso clean canonical then ()
     else raise ERR "freeze" "closed auxiliary proof differs")

    | validate_closed_fact _ _ _ (PolicyClosedFact _) =
        raise ERR "freeze" "use validate_closed_fact_with_policy"
    | validate_closed_fact _ _ _ (PolicyRealizedClosedFact _)=
        raise ERR "freeze" "use validate_closed_fact_with_policy"

  fun specialize_closed (plan as ClosedFact
      {graph,scope,node,canonical,template_limit,...})
      {operands,check_type} =
    let
      val _ = validate_closed_fact graph scope template_limit plan
      fun metric current = List.app (fn kind =>
        case G.unfolded_nodes graph kind template_limit current of
          SOME count => if count <= template_limit then () else
            raise ERR "specialize_closed" "operand exceeds original limit"
        | NONE => raise ERR "specialize_closed" "unknown operand metric")
        [G.RawNodes,G.BinderInclusiveNodes]
      fun inspect [] current _ = current
        | inspect (operand :: rest) current count =
            if count >= template_limit then
              raise ERR "specialize_closed" "instantiation incidence limit"
            else let
              val _ = ignore (G.view graph operand)
              val _ = if G.scope_visible graph scope
                  (G.node_scope graph operand) then () else
                raise ERR "specialize_closed" "foreign operand scope"
              val _ = metric operand
              val (operator,abstraction) = case G.view graph current of
                  G.Application pair => pair
                | _ => raise ERR "specialize_closed" "forall prefix exhausted"
              val _ = case G.view graph operator of G.Constant _ =>
                    if Term.same_const (G.representative graph operator)
                        boolSyntax.universal then () else
                      raise ERR "specialize_closed" "not recorded forall"
                | _ => raise ERR "specialize_closed" "not recorded forall"
              val {binder,body,...} = case G.view graph abstraction of
                  G.AdmittedBinder row => row
                | _ => raise ERR "specialize_closed" "unrecorded forall body"
              val _ = if G.type_id graph binder = G.type_id graph operand
                then () else raise ERR "specialize_closed" "binder type differs"
            in inspect rest body (count+1) end
      val body = inspect operands node 0
      val _ = List.app (fn current => case G.view graph current of
          G.OpaqueRetained => raise ERR "specialize_closed"
            "unrecorded body binder"
        | G.AdmittedBinder _ => raise ERR "specialize_closed"
            "remaining binder needs another recipe"
        | _ => ()) (G.reachable graph [body])
      val types = List.map (G.type_of graph) operands
      val remaining = ref template_limit
      fun type_shape [] = ()
        | type_shape (ty :: rest) =
            if !remaining = 0 then
              raise ERR "specialize_closed" "operand type incidence limit"
            else (remaining := !remaining - 1;
              if Type.is_vartype ty then type_shape rest
              else type_shape (#2 (Type.dest_type ty) @ rest))
      val _ = type_shape types
      val _ = List.app (fn ty =>
        (G.validate_scope graph scope;check_type ty;
         G.validate_scope graph scope)) types
      val _ = G.validate_scope graph scope
      val holes = List.map (G.placeholder graph) operands
      (* Every SPEC substitutes a one-node named variable, never the
         expanded retained Source term. All opened bodies were admitted
         before this first public binder proof operation. *)
      val theorem = List.foldl (fn (hole,proof) =>
        SmtReplayRuleObservation.SPEC hole proof)
        canonical holes
      val _ = if List.null (Thm.hyp theorem) andalso clean theorem then ()
        else raise ERR "specialize_closed" "instance changed Hyp or tags"
      val _ = G.validate_scope graph scope
    in {theorem = theorem,holes = holes} end

    | specialize_closed (PolicyClosedFact _) _ =
        raise ERR "specialize_closed" "policy specialization not implemented"
    | specialize_closed (PolicyRealizedClosedFact _) _=
        raise ERR "specialize_closed" "policy specialization not implemented"

  (* Only completed consumption/revocation retires a finite Block. Retained
     Source receipts still need its immutable leaves/names and proof edges,
     not these optional runtime caches. assemble_internal checks theorem
     (hence active) before reading assembly; deferred native programmes
     capture their law/tree before retirement and never consult it again.
     Constructors prepay the cache writes and table dispatch before
     projection rules (policy also pays the store release call/write).
     Keep retirement callback-free and debit-free, even on retired Work. *)
  fun retire_block (Block {nodes,primitive_metadata,assembly,realized,...}) =
    (primitive_metadata := NONE;assembly := NONE;
     (case nodes of PolicyFixedTable {profiles,...} =>
        SmtReplayNamedContext.clear_profile_store profiles | _ => ());
     realized := true)

  fun active_finite (Block {graph, scope, realized, owned_frame, ...}) =
    ((case owned_frame of NONE => () | SOME (work,frame) =>
       let val data = Scope.description_for work frame
       in if Portable.pointer_eq (#graph data,graph) andalso
           #scope data = scope then () else
         (W.close work;raise ERR "active" "owned body frame changed") end);
     G.validate_scope graph scope;
     if !realized then raise ERR "active" "block already realized" else ())
    handle primary =>
      (case owned_frame of NONE => raise primary
       | SOME (work,_) => (W.close work;raise primary))

  fun active (block as Block {nodes,...}) =
    (case nodes of PolicyFixedTable {guard,...}=>guard () | _=>();
     active_finite block)

  fun policy_legacy_block_only operation (Block {nodes,...}) =
    case nodes of PolicyFixedTable {work,...}=>
      (W.close work;raise ERR operation
        "use the genuine policy rule/realization consumer")
    | _=>()

  fun validate_block_for expected (block as Block {owned_frame,...}) =
    ((case owned_frame of SOME (work,_) =>
        if Portable.pointer_eq (expected,work) then () else
          raise ERR "validate_block_for" "different original Work"
      | NONE => raise ERR "validate_block_for" "unowned proof block";
      active block)
     handle primary => (W.close expected;raise primary))

  fun name (block as Block {graph, nodes, ...}) node =
    let
      val _ = active block
      (* Validate ownership even when another graph has the same integer ID. *)
      val _ = G.type_of graph node
    in
      case table_peek (nodes, G.node_id node) of
        SOME (_, variable) => (observe_proof graph #hits;variable)
      | NONE => (observe_proof graph #misses;
          raise ERR "name" "node outside frozen block")
    end

  fun context (block as Block {context, ...}) =
    (active block; context)
  fun template_limit (block as Block {template_limit,...}) =
    (active block;template_limit)
  fun scope (block as Block {scope,...}) = (active block;scope)

  fun sources (block as Block {leaves,source_count,...}) =
    (active block;List.tabulate (source_count,fn index =>
      case Vector.sub (leaves,index) of Source node => node
        | _ => raise ERR "sources" "invalid recorded source leaf"))

  fun theorem (block as Block {owner, ...})
      (Edge {owner = edge_owner, theorem, ...}) =
    (active block;
     if owner = edge_owner then theorem
     else raise ERR "theorem" "proof edge belongs to another block")

  fun new_dependency (Block {next_dependency, ...}) body =
    let val id = !next_dependency in
      next_dependency := id + 1; Dependency (id, body)
    end

  (* Retain dependency sharing just like term/proof sharing. Flattening a
     prefix union at every congruence edge gives quadratic retained lists on
     deep chains. Collect the distinct leaves only when a caller requests
     them; each dependency DAG node is then visited once. *)
  fun dependencies block (edge as Edge {dependencies, ...}) =
    let
      val _ = theorem block edge
      fun collect [] _ leaves = Redblackset.listItems leaves
        | collect (Dependency (id, body) :: pending) visited leaves =
            if Redblackset.member (visited, id) then
              collect pending visited leaves
            else
              let val visited = Redblackset.add (visited, id) in
                case body of
                  Leaves indices => collect pending visited
                    (Redblackset.addList (leaves, indices))
                | Union children => collect (children @ pending) visited leaves
              end
    in collect [dependencies] (Redblackset.empty Int.compare)
      (Redblackset.empty Int.compare) end

  fun leaf_term names (Source node) = names node
    | leaf_term names (ClosedWitness fact) = names (closed_node fact)
    | leaf_term names (ConversionWitness conversion) = boolSyntax.mk_eq
        (names (conversion_source conversion),
         names (conversion_target conversion))
    | leaf_term names (Definition (node, rhs)) =
        boolSyntax.mk_eq (names node, rhs)

  val make_tree = SmtReplayNamedContext.make_tree
  val tree_term = SmtReplayNamedContext.tree_term
  val project = SmtReplayNamedContext.project
  val tree_proof = SmtReplayNamedContext.tree_proof

  (* Source occurrences derive only from this genuine old owned block.
     Its proof-edge retirement leaves the retained backing Scope live. *)
  fun retained_source_guard_using charge expected (RetainedSourceFrame
      {block = Block {graph = old_graph,scope = old_scope,leaves,
          source_count,owned_frame,...},work,frame,graph,scope,template_limit,
       original_slots,selected_indices,sources,held,epoch,symbols}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "retained_source_guard" "different original Work";
      case owned_frame of SOME (actual,old_frame) =>
        if Portable.pointer_eq (expected,actual) andalso
            Portable.pointer_eq (frame,old_frame) andalso
            Portable.pointer_eq (graph,old_graph) andalso scope = old_scope
          then () else raise ERR "retained_source_guard"
            "different actual owned Source frame"
      | NONE => raise ERR "retained_source_guard" "unowned Source frame";
      let val data = Scope.description_for expected frame
          val _ = if Portable.pointer_eq (#graph data,graph) andalso
              #scope data = scope andalso
              #template_limit (W.semantic_limits expected) = template_limit
              andalso Type.type_epoch () = epoch andalso
              Term.term_epoch () = symbols then () else
            raise ERR "retained_source_guard" "Source lifetime changed"
          fun slots index = if index = source_count then [] else
            (charge 2;case Vector.sub (leaves,index) of Source node =>
                node::slots(index+1)
              | _ => raise ERR "retained_source_guard"
                  "actual Source row changed")
          fun same [] [] = true
            | same (a::rest) (b::tail) =
                (charge 1;a=b andalso same rest tail)
            | same _ _ = false
          val current = slots 0
          val _ = if same current original_slots then () else
            raise ERR "retained_source_guard" "original Source slots changed"
          fun selected index = List.exists
            (fn held => (charge 1;held=index)) selected_indices
          fun kept _ [] = []
            | kept index (node::rest) =
                (charge 2;if selected index then kept (index+1) rest
                 else node::kept (index+1) rest)
          val _ = if same (kept 0 current) sources then () else
            raise ERR "retained_source_guard" "retained Source order changed"
      in List.app (fn child =>
        (charge 1;ignore (G.closure_child_node graph scope child))) held end)
     handle primary => (W.close expected;raise primary))
  fun retained_source_guard expected frame =
    retained_source_guard_using (fn _=>()) expected frame
  fun retained_source_frame_for expected
      (old as Block {graph,scope,leaves,source_count,template_limit,
                    owned_frame,...}) indices =
    let
      val _ = validate_block_for expected old
      val _ = W.spend expected 0
      val frame = case owned_frame of SOME (_,held) => held
        | NONE => raise ERR "discharge_sources_with_work" "unowned block"
      fun slots index = if index = source_count then [] else
        (W.spend expected 2;case Vector.sub (leaves,index) of Source node =>
           node::slots(index+1)
         | _ => raise ERR "discharge_sources_with_work" "invalid Source row")
      val original = slots 0
      fun select index =
        (W.spend expected 1;
         if index >= 0 andalso index < source_count then
           case Vector.sub (leaves,index) of Source node => node
             | _ => raise ERR "discharge_sources_with_work" "invalid Source row"
         else raise ERR "discharge_sources_with_work"
           "unknown local source occurrence")
      val _ = List.app (fn index => ignore (select index)) indices
      fun copy index [] = []
        | copy index (node::rest) =
            let val _ = W.spend expected 1
                val remove = List.exists (fn selected =>
                  (W.spend expected 1;selected = index)) indices
            in if remove then copy (index+1) rest
               else node :: copy (index+1) rest end
      val retained = copy 0 original
      val held = List.map (fn node =>
        (W.spend expected 2;G.closure_root graph scope node)) original
      val receipt = RetainedSourceFrame {block = old,work = expected,
        frame = frame,graph = graph,scope = scope,
        template_limit = template_limit,
        original_slots = original,selected_indices = indices,sources = retained,
        held = held,epoch = Type.type_epoch (),symbols = Term.term_epoch ()}
      val _ = retained_source_guard expected receipt
    in receipt end

  fun frontier_guard expected (RealizationFrontier
      {work,graph,scope,frame,template_limit,epoch,symbols,
       closed_facts,conversions,held,retained_sources,...}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "frontier_guard" "different original Work";
      let val _ = Option.app (retained_source_guard expected) retained_sources
          val data = Scope.description_for work frame
          val _ = if Portable.pointer_eq (#graph data,graph) andalso
              #scope data = scope andalso
              #template_limit (W.semantic_limits work) = template_limit andalso
              Type.type_epoch () = epoch andalso Term.term_epoch () = symbols
            then () else raise ERR "frontier_guard" "original frame changed"
          val _ = List.app (validate_conversion_for expected) conversions
          val _ = List.app (validate_conversion graph scope template_limit)
            conversions
          val _ = List.app (validate_closed_fact graph scope template_limit)
            closed_facts
      in List.app (fn child =>
        ignore (G.closure_child_node graph scope child)) held end)
     handle primary => (W.close expected;raise primary))
  fun realization_frontier_data_for expected (frontier as RealizationFrontier
      {graph,scope,roots,sources,reachable,atoms,template_limit,...}) =
    (frontier_guard expected frontier;
     {graph = graph,scope = scope,roots = roots,sources = sources,
      reachable = reachable,atoms = atoms,template_limit = template_limit})
  (* Diagnostic audit only; no graph/Scope callbacks or admission changes. *)
  fun tables_phase work label describe =
    if not ((OS.Process.getEnv "HOL4_HOLSMT_REPLAY_DIAGNOSTICS" = SOME "1")
        handle _ => false) then () else
      ((let val audit = W.audit work
        in TextIO.output (TextIO.stdErr,
          "TABLES_WORK phase=" ^ label ^ " charged=" ^
          Int.toString (#charged audit) ^ " retired=" ^
          Bool.toString (#retired audit) ^ describe () ^ "\n");
          TextIO.flushOut TextIO.stdErr end) handle _ => ())
  fun prepare_frontier original extra_sources work
      {frame,roots,closed_facts,conversions} =
    ((W.spend work 0;
      let
        val data = Scope.description_for work frame
        val graph = #graph data and scope = #scope data
        val cap = #template_limit (W.semantic_limits work)
        fun pay n = W.spend work n
        val diagnostics =
          (OS.Process.getEnv "HOL4_HOLSMT_REPLAY_DIAGNOSTICS" = SOME "1")
          handle _ => false
        fun phase label describe = if not diagnostics then () else
          ((let val audit = W.audit work
            in TextIO.output (TextIO.stdErr,
              "FRONTIER_WORK phase=" ^ label ^ " charged=" ^
              Int.toString (#charged audit) ^ " retired=" ^
              Bool.toString (#retired audit) ^ describe () ^ "\n");
              TextIO.flushOut TextIO.stdErr end) handle _ => ())
        val _ = phase "validate.before" (fn () => "")
        val _ = List.app (validate_conversion_for work) conversions
        val _ = List.app (validate_conversion graph scope cap) conversions
        val _ = List.app (validate_closed_fact graph scope cap) closed_facts
        val _ = phase "validate.after" (fn () => "")
        (* Additional final-replay slots are ordinary block Sources. They
           never become occurrences in the original S portfolio. Each is
           copied and checked in this same genuine root frame before any
           receipt endpoint can act as a cut. *)
        fun extras [] = []
          | extras (node::rest) =
              (pay 3;
               if G.scope_visible graph scope (G.node_scope graph node)
                 then () else raise ERR "prepare_frontier"
                   "additional Source outside original root frame";
               ignore (G.view graph node);node :: extras rest)
        val extra_sources = if original then extras extra_sources
          else if null extra_sources then [] else
            raise ERR "prepare_frontier" "additional Source needs original S"
        fun original_prefix [] =
              (pay 1;SmtReplaySource.denied_goal_node (#sources data) ::
                extra_sources)
          | original_prefix (node::rest) =
              (pay 2;node :: original_prefix rest)
        val sources = if original then
            if scope = #root data then
              original_prefix
                (SmtReplaySource.assumption_nodes (#sources data))
            else raise ERR "prepare_frontier" "original Sources outside root"
          else []
        fun add [] values = values
          | add (node::rest) values = (pay 2;add rest (node::values))
        fun leaves [] cuts legacy = (cuts,legacy)
          | leaves (conversion::rest) cuts legacy =
            (pay 1;case conversion of RealizedConversion (receipt as Realization
                {source,target,...}) =>
                  (validate_realization_for work receipt;
                   leaves rest (source::target::cuts) legacy)
              | ClosedConversion _ => leaves rest cuts
                  (conversion_source conversion::conversion_target conversion::
                   legacy)
              | PolicyRealizedConversion _=>
                  raise ERR "prepare_frontier" "use policy frontier")
        val (cuts,legacy) = leaves conversions [] []
        val facts = List.map (fn fact => (pay 1;closed_node fact)) closed_facts
        (* Explicit ordinary roots dominate cuts. A receipt can NEVER hide
           a constructor demanded elsewhere at the same semantic node. *)
        val demanded = add sources (add facts (add legacy roots))
        val _ = phase "inventory.after" (fn () =>
          " roots=" ^ Int.toString (length roots) ^
          " cuts=" ^ Int.toString (length cuts) ^
          " demanded=" ^ Int.toString (length demanded))
        fun member node [] = false
          | member node (old::rest) =
              (pay 1;node = old orelse member node rest)
        (* Keep the original small-frontier path and exact DFS lists. After
           64 distinct nodes, index seen membership instead of repeatedly
           scanning the growing prefix. Private plans pay the SAME Work.
           Buckets retain full node equality: another graph's equal integer
           ID cannot hide a foreign input. This index grants no admission. *)
        fun bucket index node =
          let val _ = pay 2
              val query = W.legacy_plan_lookup_int work (index,G.node_id node)
                handle R.Limit => W.abort_work_limit work
          in case R.int_lookup_value (index,query) of
              NONE => [] | SOME nodes => nodes end
        fun insert index node previous =
          let val _ = pay 2
              val plan = W.legacy_plan_insert_int work (index,G.node_id node)
                handle R.Limit => W.abort_work_limit work
              val _ = pay 2
          in R.finish_int (index,plan,node::previous) end
        fun index nodes = List.foldl (fn (node,index) =>
          let val _ = pay 1 val previous = bucket index node
          in if member node previous then index
             else insert index node previous end) (R.empty_int ()) nodes
        val seen_index = ref (NONE : G.node list R.int_map option)
        val small_count = ref 0
        val seen = ref ([] : G.node list) val atoms = ref ([] : G.node list)
        fun visit [] = ()
          | visit (node::rest) =
            (pay 1;let val previous = case !seen_index of
                   NONE => !seen | SOME saved => bucket saved node
             in if member node previous then visit rest else
             let val _ = pay 2 val _ = seen := node :: !seen
                 val _ = case !seen_index of
                     SOME saved =>
                       seen_index := SOME (insert saved node previous)
                   | NONE => if !small_count < 64 then
                       small_count := !small_count+1
                     else (seen_index := SOME (index (!seen));
                       phase "seen.promoted" (fn () => ""))
                 val _ = if G.scope_visible graph scope
                     (G.node_scope graph node) then () else
                   raise ERR "prepare_frontier" "node escaped frame"
                 val cut = member node cuts andalso not (member node demanded)
                 val children = if cut then
                     (pay 2;atoms := node :: !atoms;[]) else
                   case G.view graph node of G.Application (a,b) => [a,b]
                     | _ => []
             in visit children;visit rest end end)
        val _ = visit (add cuts demanded)
        val _ = phase "visit.after" (fn () =>
          " reachable=" ^ Int.toString (length (!seen)) ^
          " atoms=" ^ Int.toString (length (!atoms)))
        fun reverse [] answer = answer
          | reverse (node::rest) answer =
              (pay 2;reverse rest (node::answer))
        val reachable = reverse (!seen) [] val atoms = reverse (!atoms) []
        val held = List.map (fn node =>
          (pay 2;G.closure_root graph scope node)) reachable
        val _ = phase "held.after" (fn () => "")
        val frontier = RealizationFrontier {work = work,graph = graph,
          scope = scope,frame = frame,template_limit = cap,
          epoch = Type.type_epoch (),symbols = Term.term_epoch (),
          roots = roots,sources = sources,closed_facts = closed_facts,
          conversions = conversions,reachable = reachable,atoms = atoms,
          held = held,retained_sources = NONE}
        val _ = frontier_guard work frontier
        val _ = phase "guard.after" (fn () => "")
      in frontier end)
     handle primary => (W.close work;raise primary))
  fun prepare_realization_frontier work args =
    prepare_frontier false [] work args
  fun prepare_original_realization_frontier work
      {roots,closed_facts,conversions} =
    ((let val frame = Scope.root work
      in W.with_step work (fn () =>
        prepare_frontier true [] work {frame = frame,roots = roots,
          closed_facts = closed_facts,conversions = conversions}) end)
     handle primary => (W.close work;raise primary))


  fun prepare_original_realization_frontier_with_extras work
      {roots,additional_sources,closed_facts,conversions} =
    ((let val frame = Scope.root work
      in W.with_step work (fn () =>
        prepare_frontier true additional_sources work
          {frame = frame,roots = roots,closed_facts = closed_facts,
           conversions = conversions}) end)
     handle primary => (W.close work;raise primary))

  fun prepare_scoped_frontier extra_sources work
      {frame,roots,closed_facts,conversions} =
    ((W.spend work 0;
      let
        val data = Scope.description_for work frame
        val graph = #graph data and scope = #scope data
        val cap = #template_limit (W.semantic_limits work)
        fun pay n = W.spend work n
        val _ = List.app (validate_conversion_for work) conversions
        val _ = List.app (validate_conversion graph scope cap) conversions
        val _ = List.app (validate_closed_fact graph scope cap) closed_facts
        (* Additional final-replay slots are ordinary block Sources. They
           never become occurrences in the original S portfolio. Each is
           copied and checked in this same genuine root frame before any
           receipt endpoint can act as a cut. *)
        fun extras [] = []
          | extras (node::rest) =
              (pay 3;
               if G.scope_visible graph scope (G.node_scope graph node)
                 then () else raise ERR "prepare_frontier"
                   "additional Source outside original root frame";
               ignore (G.view graph node);
               if Type.compare (G.type_of graph node,Type.bool) = EQUAL
                 then () else raise ERR "prepare_scoped_frontier"
                   "additional Source is not Boolean";
               node :: extras rest)
        val extra_sources = extras extra_sources
        fun original_prefix [] =
              (pay 1;SmtReplaySource.denied_goal_node (#sources data) ::
                extra_sources)
          | original_prefix (node::rest) =
              (pay 2;node :: original_prefix rest)
        val sources =
            if G.scope_visible graph scope (#root data) then
              original_prefix
                (SmtReplaySource.assumption_nodes (#sources data))
            else raise ERR "prepare_scoped_frontier"
              "original Sources outside descendant frame"
        fun add [] values = values
          | add (node::rest) values = (pay 2;add rest (node::values))
        fun leaves [] cuts legacy = (cuts,legacy)
          | leaves (conversion::rest) cuts legacy =
            (pay 1;case conversion of RealizedConversion (receipt as Realization
                {source,target,...}) =>
                  (validate_realization_for work receipt;
                   leaves rest (source::target::cuts) legacy)
              | ClosedConversion _ => leaves rest cuts
                  (conversion_source conversion::conversion_target conversion::
                   legacy)
              | PolicyRealizedConversion _=>
                  raise ERR "prepare_frontier" "use policy frontier")
        val (cuts,legacy) = leaves conversions [] []
        val facts = List.map (fn fact => (pay 1;closed_node fact)) closed_facts
        (* Explicit ordinary roots dominate cuts. A receipt can NEVER hide
           a constructor demanded elsewhere at the same semantic node. *)
        val demanded = add sources (add facts (add legacy roots))
        fun member node [] = false
          | member node (old::rest) =
              (pay 1;node = old orelse member node rest)
        val seen = ref ([] : G.node list) val atoms = ref ([] : G.node list)
        fun visit [] = ()
          | visit (node::rest) =
            (pay 1;if member node (!seen) then visit rest else
             let val _ = pay 2 val _ = seen := node :: !seen
                 val _ = if G.scope_visible graph scope
                     (G.node_scope graph node) then () else
                   raise ERR "prepare_frontier" "node escaped frame"
                 val cut = member node cuts andalso not (member node demanded)
                 val children = if cut then
                     (pay 2;atoms := node :: !atoms;[]) else
                   case G.view graph node of G.Application (a,b) => [a,b]
                     | _ => []
             in visit children;visit rest end)
        val _ = visit (add cuts demanded)
        fun reverse [] answer = answer
          | reverse (node::rest) answer =
              (pay 2;reverse rest (node::answer))
        val reachable = reverse (!seen) [] val atoms = reverse (!atoms) []
        val held = List.map (fn node =>
          (pay 2;G.closure_root graph scope node)) reachable
        val frontier = RealizationFrontier {work = work,graph = graph,
          scope = scope,frame = frame,template_limit = cap,
          epoch = Type.type_epoch (),symbols = Term.term_epoch (),
          roots = roots,sources = sources,closed_facts = closed_facts,
          conversions = conversions,reachable = reachable,atoms = atoms,
          held = held,retained_sources = NONE}
        val _ = frontier_guard work frontier
      in frontier end)
     handle primary => (W.close work;raise primary))
  (* The supplied frame is an opaque same-invocation body/binding receipt.
     This entry owns its action; no caller Source array or scope is accepted. *)
  fun prepare_scoped_original_realization_frontier work
      {frame,roots,additional_sources,closed_facts,conversions} =
    ((ignore (Scope.description_for work frame);
      W.with_step work (fn () =>
        prepare_scoped_frontier additional_sources work
          {frame = frame,roots = roots,closed_facts = closed_facts,
           conversions = conversions}))
     handle primary => (W.close work;raise primary))

  fun prepare_retained_source_frontier work
      (source_frame as RetainedSourceFrame {frame,sources = retained,...})
      {roots,closed_facts,conversions} =
    ((retained_source_guard work source_frame;W.spend work 0;
      let
        val data = Scope.description_for work frame
        val graph = #graph data and scope = #scope data
        val cap = #template_limit (W.semantic_limits work)
        fun pay n = W.spend work n
        val _ = List.app (validate_conversion_for work) conversions
        val _ = List.app (validate_conversion graph scope cap) conversions
        val _ = List.app (validate_closed_fact graph scope cap) closed_facts
        val sources = retained
        fun add [] values = values
          | add (node::rest) values = (pay 2;add rest (node::values))
        fun leaves [] cuts legacy = (cuts,legacy)
          | leaves (conversion::rest) cuts legacy =
            (pay 1;case conversion of RealizedConversion (receipt as Realization
                {source,target,...}) =>
                  (validate_realization_for work receipt;
                   leaves rest (source::target::cuts) legacy)
              | ClosedConversion _ => leaves rest cuts
                  (conversion_source conversion::conversion_target conversion::
                   legacy)
              | PolicyRealizedConversion _=>
                  raise ERR "prepare_frontier" "use policy frontier")
        val (cuts,legacy) = leaves conversions [] []
        val facts = List.map (fn fact => (pay 1;closed_node fact)) closed_facts
        (* Explicit ordinary roots dominate cuts. A receipt can NEVER hide
           a constructor demanded elsewhere at the same semantic node. *)
        val demanded = add sources (add facts (add legacy roots))
        fun member node [] = false
          | member node (old::rest) =
              (pay 1;node = old orelse member node rest)
        val seen = ref ([] : G.node list) val atoms = ref ([] : G.node list)
        fun visit [] = ()
          | visit (node::rest) =
            (pay 1;if member node (!seen) then visit rest else
             let val _ = pay 2 val _ = seen := node :: !seen
                 val _ = if G.scope_visible graph scope
                     (G.node_scope graph node) then () else
                   raise ERR "prepare_frontier" "node escaped frame"
                 val cut = member node cuts andalso not (member node demanded)
                 val children = if cut then
                     (pay 2;atoms := node :: !atoms;[]) else
                   case G.view graph node of G.Application (a,b) => [a,b]
                     | _ => []
             in visit children;visit rest end)
        val _ = visit (add cuts demanded)
        fun reverse [] answer = answer
          | reverse (node::rest) answer =
              (pay 2;reverse rest (node::answer))
        val reachable = reverse (!seen) [] val atoms = reverse (!atoms) []
        val held = List.map (fn node =>
          (pay 2;G.closure_root graph scope node)) reachable
        val frontier = RealizationFrontier {work = work,graph = graph,
          scope = scope,frame = frame,template_limit = cap,
          epoch = Type.type_epoch (),symbols = Term.term_epoch (),
          roots = roots,sources = sources,closed_facts = closed_facts,
          conversions = conversions,reachable = reachable,atoms = atoms,
          held = held,retained_sources = SOME source_frame}
        val _ = frontier_guard work frontier
      in frontier end)
     handle primary => (W.close work;raise primary))

  (* Private callback-free microsteps may share a charged carrier. Each
     native-rule quotation remains fresh; this only removes repeated Work
     scope-path metadata checks while no callback can change that path.
     Charge setup, hit/refill arithmetic and all unused credit. Unpriced
     Work needs no guard batching: pay only the actual request there.
     Near the original limit a priced refill must also be exact, never a
     speculative batch truncated to absorb the remaining allowance. *)
  fun compact_callback_free_payer_with_quantum quantum work =
    let val credit=ref 0
        val ceiling=W.work_limit work
        val overhead=case W.priced_root_scope_path work of NONE=>0
          | SOME path=>33+
              IntInf.toInt (G.scope_path_validation_work path)
        val _=W.spend work 16
    in if overhead=0 then fn payload=>W.spend work (payload+8)
       else fn payload=>
      let val amount=payload+8
      in if amount<= !credit then credit:= !credit-amount else
        let val need=amount+48- !credit
            val available=ceiling- #charged (W.audit work)
            val batch=if available<=quantum+overhead+48 then need
              else Int.max (need,quantum)
            val _=W.spend work batch
        in credit:= !credit+batch-amount-48 end
      end
    end

  fun compact_callback_free_payer work =
    compact_callback_free_payer_with_quantum 256 work

  (* New sparse owned projections see only the actual named leaf terms.
     Quote BOTH existing dimensions and repeated actual type occurrences
     before the first ASSUME or term-key index comparison. No total type
     incidence is bounded by the syntax cap; SAME Work is cumulative. *)
  fun owned_sparse_projection_quote work limit terms =
    let
      val pay=compact_callback_free_payer work
      fun types [] = ()
        | types (ty::rest) =
            (pay 1;
             types ((if Type.is_vartype ty then [] else
               #2 (Type.dest_type ty)) @ rest))
      fun syntax [] = ()
        | syntax (term::rest) =
            (pay 1;types [Term.type_of term];
             if Term.is_comb term then
               let val (operator,operand) = Term.dest_comb term
               in syntax (operator::operand::rest) end
             else if Term.is_abs term then
               let val (binder,body) = Term.dest_abs term
               in syntax (binder::body::rest) end
             else syntax rest)
      fun quote term =
        let val _ = pay 1
            val raw = case SmtReplayImport.bounded_raw_size limit term of
                SOME count => count
              | NONE => raise ERR "owned_sparse_projection"
                  "compact leaf exceeds original raw cap"
            val _ = pay 1
            val inclusive =
              case SmtReplayImport.bounded_binder_size limit term of
                SOME count => count
              | NONE => raise ERR "owned_sparse_projection"
                  "compact leaf exceeds original binder cap"
            (* The ASSUME conclusion and sole Hyp are the SAME term. *)
            val _ = pay raw val _ = pay inclusive
            val _ = pay raw val _ = pay inclusive
        in syntax [term];syntax [term] end
    in Vector.app quote terms end

  fun freeze_tables_with_frontier frontier metered owned_frame prepared sparse
      closed_facts
      conversions graph
      {scope, roots, sources, template_limit} =
    let
      val _ = G.validate_scope graph scope
      val _ = if template_limit >= 1 then () else
        raise ERR "freeze" "invalid compact template bound"
      fun admit_closed [] _ = ()
        | admit_closed (fact :: rest) count =
            if count >= template_limit then
              raise ERR "freeze" "closed auxiliary incidence exceeds limit"
            else (validate_closed_fact graph scope template_limit fact;
                  admit_closed rest (count+1))
      val _ = admit_closed closed_facts 0
      fun admit_conversions [] _ = ()
        | admit_conversions (conversion::rest) count =
            if count >= template_limit then
              raise ERR "freeze" "conversion incidence exceeds cap"
            else (validate_conversion graph scope template_limit conversion;
              admit_conversions rest (count+1))
      val _ = admit_conversions conversions (List.length closed_facts)
      val conversion_roots = List.concat (List.map (fn conversion =>
        [conversion_source conversion,conversion_target conversion])
        conversions)
      val (reachable,atoms) = case frontier of NONE =>
            (G.block_reachable graph
              (sources @ List.map closed_node closed_facts @
              conversion_roots @ roots),[])
        | SOME (held as RealizationFrontier {work,roots = old_roots,
            sources = old_sources,closed_facts = old_facts,
            conversions = old_conversions,reachable,atoms,...}) =>
          (frontier_guard work held;
           if roots = old_roots andalso sources = old_sources andalso
               ListPair.allEq Portable.pointer_eq
                 (closed_facts,old_facts) andalso
               ListPair.allEq Portable.pointer_eq (conversions,old_conversions)
             then (reachable,atoms) else
               raise ERR "freeze" "different authentic frontier leaves")
      val _ = List.app (fn node =>
        case G.view graph node of
          G.Constant _ => ()
        | G.Variable (G.RigidSource, _) => ()
        | _ => if G.scope_visible graph scope (G.node_scope graph node) then ()
          else raise ERR "freeze" "node escapes its binder frame") reachable
      val nodes = case metered of NONE => LegacyTable
          (List.foldl (fn (node, map) =>
            Redblackmap.insert (map, G.node_id node,
              (node, G.placeholder graph node)))
            (Redblackmap.mkDict Int.compare) reachable)
        | SOME work => (case prepared of
            SOME (OwnedTablesPlan
                {reachable = planned,node_plan,naming,...}) =>
              if reachable = planned then
                let val minted = G.mint_placeholder_terms graph scope naming
                in finish_fixed_table work node_plan minted (fn pair => pair)
                end
              else raise ERR "freeze_owned_tables" "reachable plan changed"
          | NONE => fixed_table work reachable G.node_id
              (fn node => (node,G.placeholder graph node)))
      fun names node =
        #2 (table_find (nodes, G.node_id node))
      fun definitions node =
        if List.exists (fn atom => atom = node) atoms then [] else
        let val syntax = case G.view graph node of
                G.Application pair => SmtReplayNamedContext.Application pair
              | G.Constant _ => SmtReplayNamedContext.Constant
                  (G.representative graph node)
              | _ => SmtReplayNamedContext.Atom
        in case SmtReplayNamedContext.constructor_rhs names syntax of
             NONE => [] | SOME rhs => [Definition (node,rhs)] end
      val _ = List.app (fn node =>
        if Type.compare (G.type_of graph node, Type.bool) = EQUAL then ()
        else raise ERR "freeze" "source fact is not Boolean") sources
      val leaves = Vector.fromList
        (List.map Source sources @ List.map ClosedWitness closed_facts @
         List.map ConversionWitness conversions @
         List.concat (List.map definitions reachable))
      val leaf_terms = Vector.map (leaf_term names) leaves
      val tree = make_tree 0 (Vector.length leaves)
      val context = tree_term leaf_terms tree
      val _ = case SmtReplayImport.bounded_raw_size template_limit context of
          SOME _ => ()
        | NONE => raise ERR "freeze" "compact context exceeds template bound"
      val owned_names = case prepared of
          SOME (OwnedTablesPlan {name_guard,...}) => SOME name_guard
        | NONE => NONE
      val name_set = case owned_names of NONE => table_foldl
          (fn (_, (_, variable), set) => HOLset.add (set, variable))
          (HOLset.empty Term.compare) nodes
        | SOME _ => HOLset.empty Term.compare
      val _ = case (sparse,metered) of (true,SOME work) =>
          owned_sparse_projection_quote work template_limit leaf_terms
        | _ => ()
      val leaf_index = if not sparse then NONE else SOME (Vector.foldli
        (fn (index,term,table) => Redblackmap.insert (table,term,
          index :: Option.getOpt (Redblackmap.peek (table,term),[])))
        (Redblackmap.mkDict Term.compare) leaf_terms)
      (* Prepay retire_block's two cache writes and table dispatch. *)
      val _ = case metered of NONE => () | SOME work => W.spend work 3
      val projections =
        if sparse then Vector.map SmtReplayRuleObservation.ASSUME leaf_terms
        else Vector.fromList
          (project tree (SmtReplayRuleObservation.ASSUME context))
      val definition_index = case metered of NONE => LegacyTable
          (Vector.foldli
            (fn (index, Definition (node, _), map) =>
                  Redblackmap.insert (map, G.node_id node, index)
              | (_, _, map) => map)
            (Redblackmap.mkDict Int.compare) leaves)
        | SOME work => (case prepared of
            SOME (OwnedTablesPlan
                {definition_plan,definition_rows,...}) =>
              finish_fixed_table work definition_plan definition_rows #2
          | NONE =>
            let val rows = Vector.foldri
                  (fn (index,leaf,rest) =>
                    (W.spend work 1;case leaf of Definition (node,_) =>
                       (W.spend work 3;(G.node_id node,index)::rest)
                     | _ => rest)) [] leaves
            in fixed_table work rows #1 #2 end)
    in
      Block {owner = ref (), graph = graph, scope = scope, nodes = nodes,
        names = name_set,owned_names = owned_names,leaves = leaves,
        tree = tree, context = context, projections = projections,
        leaf_index = leaf_index,
        definitions = definition_index, source_count = List.length sources,
        template_limit = template_limit, realized = ref false,
        next_dependency = ref 0,primitive_metadata = ref NONE,
        assembly = ref NONE,
        owned_frame = owned_frame}
    end

  fun freeze_tables metered owned_frame prepared sparse closed_facts
      conversions graph args =
    freeze_tables_with_frontier NONE metered owned_frame prepared sparse
      closed_facts conversions graph args

  fun freeze_internal sparse closed_facts conversions graph args =
    freeze_tables NONE NONE NONE sparse closed_facts conversions graph args

  (* Prepare only authentic private table state: no placeholder payload,
     Term constructor, proof operation or supplied policy executes here. *)
  fun prepare_owned_tables work {frame,roots,closed_facts,conversions} =
    ((W.spend work 0;
      let val data = Scope.description_for work frame
          val graph = #graph data and scope = #scope data
          val template = #template_limit (W.semantic_limits work)
          fun admit [] count _ = count
            | admit (value::rest) count validate =
                (W.spend work 1;
                 if count >= template then raise ERR "prepare_owned_tables"
                   "closed leaf incidence exceeds original template"
                 else (validate value;admit rest (count+1) validate))
          val closed_count = admit closed_facts 0
            (validate_closed_fact graph scope template)
          val total_count = admit conversions closed_count
            (fn conversion => (validate_conversion_for work conversion;
              validate_conversion graph scope template conversion))
          fun closed_roots [] = []
            | closed_roots (fact::rest) =
                (W.spend work 2;closed_node fact :: closed_roots rest)
          fun conversion_roots [] = []
            | conversion_roots (conversion::rest) =
                (W.spend work 3;conversion_source conversion ::
                  conversion_target conversion :: conversion_roots rest)
          fun append [] tail = tail
            | append (node::rest) tail =
                (W.spend work 2;node :: append rest tail)
          val reachable = G.block_reachable graph
            (append (closed_roots closed_facts)
              (append (conversion_roots conversions) roots))
          fun hold node =
            (W.spend work 2;G.closure_root graph scope node)
          val held = List.map hold reachable
          val naming = W.legacy_plan_placeholders work graph scope
            {nodes = reachable}
          val name_guard =
            prepare_fixed_names work graph scope frame naming held
          val node_plan = prepare_fixed_table work reachable G.node_id
          fun rows [] _ = []
            | rows (node::rest) index =
                (W.spend work 1;
                 case G.view graph node of
                   G.Application _ =>
                     (W.spend work 3;(G.node_id node,index) ::
                       rows rest (index+1))
                 | G.Constant _ =>
                     (W.spend work 3;(G.node_id node,index) ::
                       rows rest (index+1))
                 | _ => rows rest index)
          val definition_rows = rows reachable total_count
          val definition_plan = prepare_fixed_table work definition_rows #1
          val _ = ignore (Scope.description_for work frame)
          val _ = W.spend work 3
      in OwnedTablesPlan {work = work,graph = graph,scope = scope,
        frame = frame,template = template,roots = roots,
        closed_facts = closed_facts,conversions = conversions,
        reachable = reachable,held = held,node_plan = node_plan,naming = naming,
        name_guard = name_guard,
        definition_plan = definition_plan,definition_rows = definition_rows,
        used = ref false} end)
     handle primary => (W.close work;raise primary))
  (* Immutable authentic snapshot-program cost. Compare the expected owner
     BEFORE touching the held plan; this accessor issues no allowance. *)
  fun prepare_owned_realization_tables work
      (frontier as RealizationFrontier {frame,roots,sources,closed_facts,
         conversions,reachable,atoms,...}) =
    ((frontier_guard work frontier;W.spend work 0;
      let val _ = tables_phase work "prepare.frontier.after" (fn () => "")
          val data = Scope.description_for work frame
          val graph = #graph data and scope = #scope data
          val template = #template_limit (W.semantic_limits work)
          fun admit [] count _ = count
            | admit (value::rest) count validate =
                (W.spend work 1;
                 if count >= template then raise ERR "prepare_owned_tables"
                   "closed leaf incidence exceeds original template"
                 else (validate value;admit rest (count+1) validate))
          val closed_count = admit closed_facts 0
            (validate_closed_fact graph scope template)
          val total_count = admit conversions closed_count
            (fn conversion => (validate_conversion_for work conversion;
              validate_conversion graph scope template conversion))
          fun source_count [] n = n
            | source_count (_::rest) n =
                (W.spend work 1;source_count rest (n+1))
          val total_count = source_count sources total_count
          val _ = tables_phase work "prepare.leaves.after" (fn () => "")
          fun hold node =
            (W.spend work 2;G.closure_root graph scope node)
          val held = List.map hold reachable
          val _ = tables_phase work "prepare.held.after" (fn () => "")
          val naming = W.legacy_plan_placeholders work graph scope
            {nodes = reachable}
          val _ = tables_phase work "prepare.naming.after" (fn () => "")
          val name_guard =
            prepare_fixed_names work graph scope frame naming held
          val _ = tables_phase work "prepare.names.after" (fn () => "")
          val node_plan = prepare_fixed_table work reachable G.node_id
          val _ = tables_phase work "prepare.nodes.after" (fn () => "")
          fun rows [] _ = []
            | rows (node::rest) index =
                (W.spend work 1;
                 if List.exists (fn atom => atom = node) atoms then
                   rows rest index else case G.view graph node of
                   G.Application _ =>
                     (W.spend work 3;(G.node_id node,index) ::
                       rows rest (index+1))
                 | G.Constant _ =>
                     (W.spend work 3;(G.node_id node,index) ::
                       rows rest (index+1))
                 | _ => rows rest index)
          val definition_rows = rows reachable total_count
          val _ = tables_phase work "prepare.rows.after" (fn () => "")
          val definition_plan = prepare_fixed_table work definition_rows #1
          val _ = tables_phase work "prepare.definitions.after" (fn () => "")
          val _ = ignore (Scope.description_for work frame)
          val _ = W.spend work 3
          val plan = OwnedTablesPlan {work = work,graph = graph,scope = scope,
        frame = frame,template = template,roots = roots,
        closed_facts = closed_facts,conversions = conversions,
        reachable = reachable,held = held,node_plan = node_plan,naming = naming,
        name_guard = name_guard,
        definition_plan = definition_plan,definition_rows = definition_rows,
        used = ref false}
      (* Sole RealizationTablesPlan constructor: frontier and plan hold the
         exact same immutable fact/conversion lists and frame, with the same
         original template cap. With no supplied callbacks between guards,
         frontier validation therefore covers the plan's leaf checks. *)
      in RealizationTablesPlan
        {work = work,frontier = frontier,plan = plan} end)
     handle primary => (W.close work;raise primary))
  (* Immutable authentic snapshot-program cost. Compare the expected owner
     BEFORE touching the held plan; this accessor issues no allowance. *)
  fun owned_tables_guard_work expected
      (OwnedTablesPlan {work,naming,...}) =
    if Portable.pointer_eq (expected,work) then
      G.placeholder_plan_guard_cost naming
    else (W.close expected;raise ERR "owned_tables_guard_work"
      "different original Work")
  fun validate_owned_tables_using check_leaves expected
      (OwnedTablesPlan {work,graph,scope,frame,template,held,
                        naming,closed_facts,conversions,...}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "validate_owned_tables" "different original Work";
      let val data = Scope.description_for work frame
          val _ = if Portable.pointer_eq (#graph data,graph) andalso
              #scope data = scope andalso
              #template_limit (W.semantic_limits work) = template then ()
            else raise ERR "validate_owned_tables" "original owner changed"
          val _ = G.validate_placeholder_plan graph scope naming
          val _ = List.app (fn child =>
            ignore (G.closure_child_node graph scope child)) held
          val _ = if check_leaves then
            List.app (validate_closed_fact graph scope template) closed_facts
            else ()
          val _ = if check_leaves then List.app (fn conversion =>
            (validate_conversion_for work conversion;
             validate_conversion graph scope template conversion)) conversions
            else ()
      in ignore (Scope.description_for work frame) end)
     handle primary => (W.close expected;raise primary))
  fun validate_owned_tables expected plan =
    validate_owned_tables_using true expected plan
  fun freeze_owned_tables_plan work
      (plan as OwnedTablesPlan {graph,scope,frame,template,
        roots,closed_facts,conversions,used,...}) =
    ((pay work (2 * owned_tables_guard_work work plan);
      validate_owned_tables work plan;W.spend work 0;
      if !used then raise ERR "freeze_owned_tables_plan" "plan already used"
        else used := true;
      let val block = freeze_tables (SOME work) (SOME (work,frame))
            (SOME plan) false closed_facts conversions graph
            {scope = scope,roots = roots,sources = [],
             template_limit = template}
          val _ = validate_owned_tables work plan
      in block end)
     handle primary => (W.close work;raise primary))
  fun freeze_owned_tables work request =
    freeze_owned_tables_plan work (prepare_owned_tables work request)

  fun validate_realization_tables expected
      (RealizationTablesPlan {work,frontier,plan}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "validate_realization_tables" "different original Work";
      frontier_guard expected frontier;
      validate_owned_tables_using false expected plan)
     handle primary => (W.close expected;raise primary))
  fun realization_tables_guard_work expected
      (RealizationTablesPlan {work,plan,...}) =
    if Portable.pointer_eq (expected,work) then
      owned_tables_guard_work expected plan
    else (W.close expected;raise ERR "realization_tables_guard_work"
      "different original Work")
  fun freeze_owned_realization_tables_plan expected
      (tables as RealizationTablesPlan {work,frontier,
        plan as OwnedTablesPlan {graph,scope,frame,template,
          roots,closed_facts,conversions,used,...}}) =
    ((let val guard_work = 2 * realization_tables_guard_work expected tables
          val _ = tables_phase expected "freeze.guard.before"
            (fn () => " guard_work=" ^ IntInf.toString guard_work)
      in pay expected guard_work end;
      tables_phase expected "freeze.guard.after" (fn () => "");
      validate_realization_tables expected tables;W.spend expected 0;
      tables_phase expected "freeze.validate.after" (fn () => "");
      if !used then raise ERR "freeze_owned_realization_tables_plan"
          "plan already used" else used := true;
      let val data = realization_frontier_data_for expected frontier
          val block = freeze_tables_with_frontier (SOME frontier)
            (SOME expected) (SOME (expected,frame)) (SOME plan)
            false closed_facts conversions graph
            {scope = scope,roots = roots,sources = #sources data,
             template_limit = template}
          val _ = tables_phase expected "freeze.block.after" (fn () => "")
          val _ = validate_realization_tables expected tables
          val _ = tables_phase expected "freeze.complete" (fn () => "")
      in block end)
     handle primary => (W.close expected;raise primary))

  fun freeze_owned_needed_realization_tables_plan expected
      (tables as RealizationTablesPlan {work,frontier,
        plan as OwnedTablesPlan {graph,scope,frame,template,
          roots,closed_facts,conversions,used,...}}) =
    ((pay expected (2 * realization_tables_guard_work expected tables);
      validate_realization_tables expected tables;W.spend expected 0;
      if !used then raise ERR "freeze_owned_needed_realization_tables_plan"
          "plan already used" else used := true;
      let val data = realization_frontier_data_for expected frontier
          val block = freeze_tables_with_frontier (SOME frontier)
            (SOME expected) (SOME (expected,frame)) (SOME plan)
            true closed_facts conversions graph
            {scope = scope,roots = roots,sources = #sources data,
             template_limit = template}
          val _ = validate_realization_tables expected tables
      in block end)
     handle primary => (W.close expected;raise primary))

  (* Genuine original prefix and actual scoped extras, same opaque table
     plan and cumulative Work. The frontier owns its outside action first. *)
  fun prepare_needed_sources_with_work expected request =
    ((let
        val frontier = prepare_scoped_original_realization_frontier
          expected request
        val tables = W.with_step expected (fn () =>
          prepare_owned_realization_tables expected frontier)
      in W.with_step expected (fn () =>
        freeze_owned_needed_realization_tables_plan expected tables) end)
     handle primary => (W.close expected;raise primary))

  fun freeze graph args = freeze_internal false [] [] graph args
  fun prepare_needed_sources graph args = freeze_internal true [] [] graph args
  fun freeze_with_closed graph
      {scope,roots,sources,closed_facts,template_limit} =
    freeze_internal false closed_facts [] graph
      {scope = scope,roots = roots,sources = sources,
       template_limit = template_limit}

  fun prepare_needed_sources_with_closed graph
      {scope,roots,sources,closed_facts,template_limit} =
    freeze_internal true closed_facts [] graph
      {scope = scope,roots = roots,sources = sources,
       template_limit = template_limit}

  fun freeze_with_conversions graph
      {scope,roots,sources,closed_facts,conversions,template_limit} =
    freeze_internal false closed_facts conversions graph
      {scope = scope,roots = roots,sources = sources,
       template_limit = template_limit}
  fun prepare_needed_sources_with_conversions graph
      {scope,roots,sources,closed_facts,conversions,template_limit} =
    freeze_internal true closed_facts conversions graph
      {scope = scope,roots = roots,sources = sources,
       template_limit = template_limit}

  fun needed_leaves (block as Block {leaf_index,...}) edge =
    let
      val proof = theorem block edge
      val table = case leaf_index of SOME table => table
        | NONE => raise ERR "needed_sources" "not a sparse preparation block"
      fun lookup hypothesis = case Redblackmap.peek (table,hypothesis) of
          SOME indices => indices
        | NONE => raise ERR "needed_sources" "unrecorded compact hypothesis"
    in Redblackset.listItems (Redblackset.addList
      (Redblackset.empty Int.compare,
       List.concat (List.map lookup (Thm.hyp proof)))) end

  fun needed_source_occurrences (block as Block {source_count,...}) edge =
    List.filter (fn index => index < source_count) (needed_leaves block edge)

  fun needed_sources_using (block as Block {graph,...}) edge witness =
    let
      val nodes = Vector.fromList (sources block)
      fun classify (index,(needed,laws)) =
        let val node = Vector.sub (nodes,index)
        in case witness (index,node) of NONE => (node :: needed,laws)
          | SOME proof =>
              if Portable.pointer_eq (Thm.concl proof,
                    G.representative graph node) andalso clean proof then
                if List.null (Thm.hyp proof) then
                  (needed,(node,proof) :: laws)
                else raise ERR "needed_sources"
                  "needed Source witness requires exact Hyp expansion"
              else raise ERR "needed_sources" "original witness differs"
        end
      val (needed,laws) = List.foldl classify ([],[])
        (needed_source_occurrences block edge)
    in {needed = List.rev needed,laws = List.rev laws} end

  fun projection (block as Block {owner, graph, projections, ...}) index =
    (active block;
     observe_proof graph #edges;
     Edge {owner = owner, theorem = Vector.sub (projections, index),
       dependencies = new_dependency block (Leaves [index]),primitive=NONE})

  fun source (block as Block {source_count, ...}) index =
    if index >= 0 andalso index < source_count then projection block index
    else raise ERR "source" "unknown source occurrence"

  fun closed (block as Block {leaves,...}) fact =
    let val _=case fact of PolicyRealizedClosedFact _=>
              (case block of Block {nodes=PolicyFixedTable {work,...},...}=>
                 pcf_for work fact
               | _=>raise ERR "closed" "policy fact requires policy block")
            | _=>()
        val _ = ignore (name block (closed_node fact))
        fun seek index = if index >= Vector.length leaves then
            raise ERR "closed" "auxiliary was not reserved before freeze"
          else case Vector.sub (leaves,index) of ClosedWitness held =>
            if Portable.pointer_eq (held,fact) then projection block index
            else seek (index+1)
          | _ => seek (index+1)
    in seek 0 end

  fun definition (block as Block {definitions, ...}) node =
    (ignore (name block node);
     case table_peek (definitions, G.node_id node) of
       SOME index => projection block index
     | NONE => raise ERR "definition" "node has no constructor definition")

  (* Guard the proof template BEFORE free-variable collection or matching.
     No large residue is passed to these ordinary kernel/library helpers. *)
  fun conversion (block as Block {leaves,...}) plan =
    let val _ = active block
        fun seek index =
          if index = Vector.length leaves then
            raise ERR "conversion" "conversion was not reserved before freeze"
          else case Vector.sub (leaves,index) of ConversionWitness held =>
              if Portable.pointer_eq (held,plan) then projection block index
              else seek (index+1)
            | _ => seek (index+1)
    in seek 0 end

  fun guard_legacy (block as Block {names,context,template_limit,...}) terms =
    let
      fun inspect term =
        if Portable.pointer_eq (term, context) then ()
        else let
          val _ = case SmtReplayImport.bounded_raw_size template_limit term of
              SOME _ => ()
            | NONE => raise ERR "guard" "expanded compact proof template"
          fun visit under_binder term =
            if Term.is_var term then
              if under_binder andalso HOLset.member (names, term) then
                raise ERR "guard" "graph insertion below a binder"
              else ()
            else if Term.is_comb term then
              let val (operator, operand) = Term.dest_comb term in
                visit under_binder operator; visit under_binder operand
              end
            else if Term.is_abs term then
              visit true (#2 (Term.dest_abs term))
            else ()
          val _ = visit false term
          val _ = if HOLset.isSubset
              (Term.FVL [term] (HOLset.empty Term.compare), names)
            then () else raise ERR "guard" "unowned compact variable"
        in () end
    in active block; List.app inspect terms end

  (* Actual public syntax paths are visited prospectively on the fixed-rule
     route. The separate first pass preserves the original size-first
     refusal order. dest_abs is alpha-preserving; no count_body proof rule
     is manufactured for this raw occurrence count. Hidden closure forcing
     remains outside this nominal public-path envelope. *)
  fun fixed_guard_operand_using spend metadata_pay work names limit term =
    let
      fun raw [] count = count
        | raw (current::rest) count =
          (spend 1;
           if count >= limit then
             raise ERR "guard" "expanded compact proof template"
           else if Term.is_comb current then
             let val _ = spend 4
                 val (operator,operand) = Term.dest_comb current
             in raw (operator::operand::rest) (count+1) end
           else if Term.is_abs current then
             let val _ = spend 3
                 val (_,body) = Term.dest_abs current
             in raw (body::rest) (count+1) end
           else raw rest (count+1))
      fun visit binders under current =
        (spend 1;
         if Term.is_var current then
           let val owned = fixed_names_member_using spend metadata_pay
                 work names current
           in if under andalso owned then
                raise ERR "guard" "graph insertion below a binder"
              else if owned orelse
                  bound_variable_member_using spend work current binders
                then () else raise ERR "guard" "unowned compact variable" end
         else if Term.is_comb current then
           let val _ = spend 2
               val (operator,operand) = Term.dest_comb current
           in visit binders under operator;visit binders under operand end
         else if Term.is_abs current then
           let val _ = spend 3
               val (binder,body) = Term.dest_abs current
           in visit (binder::binders) true body end
         else ())
      val _ = spend 1
      val _ = raw [term] 0
    in visit [] false term end
  fun fixed_guard_operand work =
    fixed_guard_operand_using (W.spend work) (pay work) work

  (* The source receipt's admission visitor is callback-free too. Keep all
     genuine name lookups, each original zero-spend lifetime check and the
     separate native Type.compare quotes, but do not run the whole Work
     scope path again for every raw/Type/suffix metadata microstep. *)
  fun fixed_guard_retained_operands work names limit terms =
    let val spend=compact_callback_free_payer_with_quantum 1024 work
        val ceiling=IntInf.fromInt (W.work_limit work)
        fun metadata_pay amount =
          if amount>=0 andalso amount<=ceiling then spend (IntInf.toInt amount)
          else (W.close work;raise ERR "private_table"
            "original Work exhausted")
    in List.app
      (fixed_guard_operand_using spend metadata_pay work names limit) terms end
  (* Ordinary checked/compose keep their semantic entry behavior, including
     supported calls outside an owned action. These plain queries confer no
     Work credit. Only the private fixed prepare path uses the paid visitor
     above; generic callback/private work is still an explicit gap. *)
  fun guard (block as Block {owned_names,context,template_limit,...}) terms =
    case owned_names of NONE => guard_legacy block terms
      | SOME (names as FixedNames {work,strings,types,...}) =>
        ((fixed_names_guard work names;active block;
          let
            fun member term =
              let val (name,ty) = Term.dest_var term
              in case strings of NONE =>
                  (case fixed_suffix_name (fn _ => ())
                      (fn index => R.peek_int (types,index)) name of
                    NONE => false
                  | SOME wanted => Type.compare (ty,wanted) = EQUAL)
                | SOME strings => R.member_string (strings,name) andalso
                let val prefix = "__smt_replay_"
                    val tail = String.extract
                      (name,String.size prefix,NONE)
                    val index = case Int.fromString tail of SOME value => value
                      | NONE => raise ERR "guard" "invalid held name spelling"
                in case R.peek_int (types,index) of
                  SOME (exact,wanted) => exact = name andalso
                    Type.compare (ty,wanted) = EQUAL
                | NONE => raise ERR "guard" "missing held name type" end end
            fun bound term binders =
              let val (name,ty) = Term.dest_var term
              in List.exists (fn binder =>
                let val (old,wanted) = Term.dest_var binder
                in name = old andalso Type.compare (ty,wanted) = EQUAL end)
                binders end
            fun visit binders under term =
              if Term.is_var term then
                let val owned = member term
                in if under andalso owned then
                     raise ERR "guard" "graph insertion below a binder"
                   else if owned orelse bound term binders then () else
                     raise ERR "guard" "unowned compact variable" end
              else if Term.is_comb term then
                let val (operator,operand) = Term.dest_comb term
                in visit binders under operator;visit binders under operand end
              else if Term.is_abs term then
                let val (binder,body) = Term.dest_abs term
                in visit (binder::binders) true body end
              else ()
            fun inspect term =
              if Portable.pointer_eq (term,context) then () else
              (case SmtReplayImport.bounded_raw_size template_limit term of
                 SOME _ => visit [] false term
               | NONE => raise ERR "guard" "expanded compact proof template")
          in List.app inspect terms;fixed_names_guard work names end)
         handle primary => (W.close work;raise primary))

  fun checked
      (block as Block {owner, graph, projections, leaf_index, ...}) proof =
    let
      val _ = policy_legacy_block_only "checked" block
      val _ = guard block (Thm.concl proof :: Thm.hyp proof)
      val _ = if clean proof then () else
        raise ERR "checked" "unexpected proof tags"
      fun lookup hypothesis = case leaf_index of SOME table =>
            (case Redblackmap.peek (table,hypothesis) of
               SOME (index::_) => index
             | _ => raise ERR "checked" "hypothesis outside sparse context")
        | NONE => let
          fun seek index =
            if index = Vector.length projections then
              raise ERR "checked" "hypothesis outside frozen context"
            else if Term.aconv hypothesis
                (Thm.concl (Vector.sub (projections, index))) then index
            else seek (index + 1)
        in seek 0 end
      val dependencies = List.map lookup (Thm.hyp proof)
      val lifted = List.foldl (fn (index, result) =>
        SmtReplayRuleObservation.D_PROVE_HYP
          (Vector.sub (projections, index)) result)
        proof dependencies
    in observe_proof graph #edges;Edge {owner = owner, theorem = lifted,
      dependencies = new_dependency block (Leaves dependencies),
      primitive=NONE} end

  (* Prospectively inspect bounded compact operands. In contrast to the
     older sparse admission helper, every syntax/Type edge is paid before
     visiting it; a failed quote cannot construct a term or theorem. *)
  type assembly_metrics =
    {raw:int,inc:int,ann:int,text:int,plain:bool,cmp:int}
  fun assembly_term_quote pay limit =
    let
      (* Walk each actual annotation, including structurally equal fresh
         Types from Term.type_of. A pointer-list memo makes those cheap
         shallow walks quadratic in the number of distinct allocations. *)
      fun type_size ty =
        (pay 2;if Type.is_vartype ty then
           let val bytes=String.size (Type.dest_vartype ty)
               val _=pay bytes
           in (1+bytes,0) end
         else
           let val {Thy,Tyop,Args}=Type.dest_thy_type ty
               val bytes=String.size Thy+String.size Tyop
               val _=pay (3+bytes)
           in List.foldl (fn (child,(nodes,text))=>
             let val (n,t)=type_size child val _=pay 4
             in (nodes+n,text+t) end) (1,bytes) Args end)
      fun quote term : assembly_metrics =
      let
      val raw = ref 0 val inclusive = ref 0
      val annotations = ref 0 val text = ref 0
      val _=pay 4
      val plain = ref true val compare = ref 0
      fun visit current =
        let val _=pay 5
            val _=raw := !raw+1 val _=inclusive := !inclusive+1
            val _=if !raw<=limit andalso !inclusive<=limit then () else
              raise ERR "owned_sparse_projection"
                "compact leaf exceeds original binder cap"
            val _=pay 8
            val (own,type_text)=type_size (Term.type_of current)
            val _=text := !text+type_text
            val _=compare := !compare+4
            val _=annotations := !annotations+own
        in if Term.is_comb current then
             let val (a,b)=Term.dest_comb current
             in visit a;visit b end
           else if Term.is_abs current then
             let val (binder,body)=Term.dest_abs current
                 val _=pay 4 val _=inclusive := !inclusive+1
                 val _=plain := false
                 val (own,bytes)=type_size (Term.type_of binder)
                 val _=annotations := !annotations+own
                 val _=text := !text+bytes
             in visit body end
           else
             let val bytes=if Term.is_var current then
                   String.size (#1 (Term.dest_var current))
                 else if Term.is_const current then
                   let val {Thy,Name,...}=Term.dest_thy_const current
                   in String.size Thy+String.size Name end else 0
                 val _=pay (bytes+10)
                 val _=compare := !compare+14+bytes+7*own+2*type_text
             in text := !text+bytes end
        end
      val _=visit term
      val _=pay 9
      val _=if !inclusive<=limit then () else
        raise ERR "owned_sparse_projection"
          "compact leaf exceeds original binder cap"
      (* Immutable geometry, NOT future native credit. Admission below
         counts every port again; kernel work has a separate fresh quote. *)
    in {raw= !raw,inc= !inclusive,ann= !annotations,text= !text,
        plain= !plain,cmp= !compare} end
      (* An App borrows both children. Combine their actual geometry but
         inspect this actual App's annotation separately: in particular an
         intermediate rator has a different Type from the full application.
         This is DATA composition, not an admission or native allowance. *)
      fun application term (a:assembly_metrics) (b:assembly_metrics)
          : assembly_metrics =
        let val _=pay 45
            val (own,bytes)=type_size (Term.type_of term)
            val raw=1+ #raw a+ #raw b
            val inc=1+ #inc a+ #inc b
            val _=if raw<=limit andalso inc<=limit then () else
              raise ERR "owned_sparse_projection"
                "compact leaf exceeds original binder cap"
        in {raw=raw,inc=inc,ann=own+ #ann a+ #ann b,
            text=bytes+ #text a+ #text b,
            plain= #plain a andalso #plain b,cmp=4+ #cmp a+ #cmp b} end
    in {term=quote,application=application} end

  (* Capture actual Hyp before lifting. Only successful leaves enter D;
     semantic rewrites are never assumed as syntax definitions. Cache the
     closed compact law and projections, not discovery callbacks. *)
  fun assemble_internal (block as Block {assembly,leaf_index,tree,
      context,projections,nodes,template_limit,...}) edge =
    let
      val proof = theorem block edge
      val _ = case (leaf_index,nodes) of
          (SOME _,FixedTable {work,...}) => W.spend work 3
        | _ => ()
      fun phase label describe = case (leaf_index,nodes) of
          (SOME _,FixedTable {work,...}) =>
            tables_phase work ("assembly." ^ label) describe
        | _ => ()
      fun build () =
        let
          val _ = phase "before" (fn () => "")
          (* Callback-free microsteps share prepaid credit from the SAME
             Work. This avoids revalidating the entire priced scope path
             for each Type edge. No credit survives this assembly; at most
             4095 unused payload units remain charged, never refunded or
             reset. The carrier's own setup/hit/refill events are paid too:
             16 at setup, 8 per invocation, 48 more per refill.
             The hoisted payer's hit has eight SourceWork events:
             payload+8 (1), credit read/compare/branch (3), credit
             read/subtract/write (3), function dispatch (1). High-level
             let bindings are not events. Refill reserves another 48 for
             audit, Int/IntInf arithmetic, batching and the final update;
             priced scope-path guards still run in the actual W.spend. *)
          val payer = case (leaf_index,nodes) of
              (SOME _,FixedTable {work,...}) =>
                compact_callback_free_payer_with_quantum 4096 work
            | _ => fn _ => ()
          val indices = case leaf_index of NONE => NONE
            | SOME _ => SOME (needed_leaves block edge)
          val chosen = Option.getOpt (indices,[])
          val _ = phase "selected" (fn () =>
            " leaves=" ^ Int.toString (length chosen))
          val terms = Vector.fromList (List.map (fn index =>
            (payer 3;Thm.concl (Vector.sub (projections,index)))) chosen)
          (* Subselection cannot exceed the already admitted full context.
             Pay the balanced skeleton before constructing it; every leaf
             is an existing Boolean term with the same owned-name guard. *)
          fun boundary start count =
            (payer 3;if count=0 then Empty else if count=1 then Leaf start
             else let val half=count div 2 in Split
               (boundary start half,boundary (start+half) (count-half)) end)
          fun syntax Empty = (payer 1;boolSyntax.T)
            | syntax (Leaf index) = (payer 1;Vector.sub (terms,index))
            | syntax (Split (a,b)) =
                let val left=syntax a val right=syntax b
                    val _=payer 12
                in boolSyntax.mk_conj (left,right) end
          val boundary = case indices of NONE => tree
            | SOME _ => boundary 0 (Vector.length terms)
          val d = case indices of NONE => context
            | SOME _ => syntax boundary
          (* Geometry is immutable DATA, not a native-work allowance.
             In particular DISCH/MP do not walk borrowed conclusions or
             every borrowed Hyp term. They operate on persistent sets.
             Admit ALL prospective ports below, but prepay the actual
             constructor/set/comparison programme separately. *)
          val sparse = case (leaf_index,nodes) of
              (SOME _,FixedTable _) => true | _ => false
          val ceiling = case nodes of FixedTable {work,...} =>
                W.work_limit work
            | _ => template_limit
          val _ = payer 128
          val costs = Array.array
            (127,[] : (Term.term * assembly_metrics) list)
          val _ = payer 2
          val hot_geometry = ref
            (NONE : ((Term.term * assembly_metrics) *
                     (Term.term * assembly_metrics)) option)
          val metric_reader=assembly_term_quote payer template_limit
          val quote_metric= #term metric_reader
          fun bucket_metric term =
            let val index = SmtReplayImport.pointer_bucket_observed
                  (fn n => payer (IntInf.toInt n)) 4 127 term
                fun find [] = (payer 1;NONE)
                  | find ((held,amount)::rest) =
                      (payer 2;if Portable.pointer_eq (held,term) then
                         SOME amount else find rest)
            in case find (Array.sub (costs,index)) of
                SOME amount => amount
              | NONE =>
                let val amount = quote_metric term
                    val _ = payer 4
                    val _ = Array.update (costs,index,
                      (term,amount)::Array.sub (costs,index))
                in amount end
            end
          (* Build-local, pointer-authenticated geometry only. The six
             events cover cell read/case and two pointer tests/branches.
             Misses retain the collision-safe, fully observed bucket.
             Neither a hit nor this cell grants any native-work credit. *)
          fun metric term =
            (payer 6;case !hot_geometry of
               SOME ((left,a),(right,b)) =>
                 if Portable.pointer_eq (left,term) then a
                 else if Portable.pointer_eq (right,term) then b
                 else bucket_metric term
             | NONE => bucket_metric term)
          fun weight ({raw,inc,ann,text,...}:assembly_metrics) =
            raw+inc+ann+text
          (* Build-local name identities, not native comparison credit.
             Hash EVERY byte once per captured prefix, including the fold
             carrier, then authenticate the bucket by pointer or an exact
             paid String.compare. Equal spellings hash to the same bucket
             and reuse its ID; fresh IDs therefore prove unequal spellings.
             Unequal string pointers prove nothing. 128 array cells/header
             plus counter/ref and table bindings. *)
          val _=payer 132
          val prefix_names=Array.array (127,[] : (string * int) list)
          val next_prefix_name=ref 0
          fun prefix_name name =
            let val bytes=String.size name
                val _=payer (8+8*bytes)
                val hash=CharVector.foldl (fn (c,h)=>
                  Word.+ (Word.* (h,0w33),Word.fromInt (Char.ord c)))
                  0w17 name
                val _=payer 5
                val index=Word.toInt (Word.mod (hash,0w127))
                val rows=Array.sub (prefix_names,index)
                fun find [] = (payer 1;NONE)
                  | find ((held,id)::rest) =
                      (payer 4;
                       if Portable.pointer_eq (held,name) then SOME id
                       else (payer (4+bytes+String.size held);
                         if String.compare (held,name)=EQUAL then SOME id
                         else find rest))
            in case find rows of SOME id=>id
              | NONE=>
                  let val _=payer 12
                      val id= !next_prefix_name
                      val _=next_prefix_name:=id+1
                      val _=Array.update
                        (prefix_names,index,(name,id)::rows)
                  in id end
            end
          type native_prefix =
            {nameID:int,headTerm:Term.term,headCmp:int,nameBytes:int}
          fun capture_prefix term : native_prefix option =
            (payer 3;if Term.is_comb term then
               let val _=payer 4
                   val (left,_)=Term.dest_comb term
               in if Term.is_comb left then
                    let val _=payer 6
                        val (head,arg)=Term.dest_comb left
                    in if Term.is_const head andalso Term.is_var arg then
                         let val _=payer 4
                             val (name,_)=Term.dest_var arg
                             val id=prefix_name name
                             (* Direct quotes, NOT bucket_metric: a
                                constant's instantiated Type can have a
                                fresh pointer on every type_of call. *)
                             val headCmp= #cmp (quote_metric head)
                             (* Distinct names stop var_compare BEFORE
                                Type.compare in both kernels. No Type
                                profile of arg is needed for this fork. *)
                             val nameBytes=String.size name
                             val _=payer 7
                         in SOME {nameID=id,headTerm=head,
                           headCmp=headCmp,nameBytes=nameBytes}
                         end
                       else NONE end
                  else NONE end
             else NONE)
          datatype native_root = NativeVariable of {id:int,bytes:int}
            | NativeConstant
            | NativeApplication of native_prefix option
            | NativeAbstraction
          fun capture_root value =
            (payer 8;if Term.is_var value then
               let val (name,_)=Term.dest_var value
                   val id=prefix_name name val _=payer 5
               in NativeVariable {id=id,bytes=String.size name} end
             else if Term.is_comb value then
               NativeApplication (capture_prefix value)
             else if Term.is_const value then NativeConstant
             else NativeAbstraction)
          datatype port = Port of
            {term:Term.term,metrics:assembly_metrics,aliases:Term.term list,
             against_d:(order * int) option ref,
             prefix:native_root option ref}
          fun measured_port term metrics =
            (* Root descriptor is captured once from this actual term.
               It is immutable geometry, never native comparison credit. *)
            (payer 10;Port {term=term,metrics=metrics,aliases=[term],
              against_d=ref NONE,prefix=ref NONE})
          fun port term = measured_port term (metric term)
          fun prefix (Port {term,prefix,...}) =
            (payer 4;case !prefix of SOME saved=>saved
             | NONE=>let val saved=capture_root term val _=payer 3
                     in prefix:=SOME saved;saved end)
          fun term (Port {term,...}) = term
          fun metrics (Port {metrics,...}) = metrics
          fun map action [] = (payer 1;[])
            | map action (value::rest) =
                (payer 2;action value::map action rest)
          fun append [] tail = (payer 1;tail)
            | append (value::rest) tail =
                (payer 2;value::append rest tail)
          fun count [] = (payer 1;0)
            | count (_::rest) = (payer 1;1+count rest)
          (* Re-admit EVERY actual input/result/Hyp incidence, including
             repeated ports. A cached scalar avoids a syntax rescan, not
             any bound. No aggregate raw cap is imposed on a Hyp forest.
             The Type-incidence sum is fresh for each native rule. *)
          fun quote ports extra = if not sparse then () else
            let
              fun add (p:assembly_metrics) annotations =
                (payer 8;
                 if #raw p<=template_limit andalso
                    #inc p<=template_limit andalso #ann p<=ceiling
                 then annotations+ #ann p else
                   raise ERR "assemble" "prospective compact port bound")
              fun scan [] total = (payer 1;total)
                | scan (value::rest) total =
                    scan rest (add (metrics value) total)
              val annotations=List.foldl (fn (p,n)=>add p n)
                (scan ports 0) extra
              val _=payer 2
            in if annotations<=ceiling then () else
              raise ERR "assemble" "prospective compact Type portfolio"
            end
          (* A Hyp forest has no aggregate raw/inc cap. Its maxima and
             annotation SUM are immutable geometry, not admitted-success
             credit. Seed maxima from actual initial Hyp union {D}; every
             later forest is a subset of that set. Keep its ACTUAL sum by
             subtracting removed representatives / adding union deltas in
             the existing set-forecast traversals. All terms still undergo
             native comparison and every result Hyp is certified below. *)
          type hyp_summary = {raw:int,inc:int,ann:int}
          fun subtract (s:hyp_summary) removed : hyp_summary =
            (payer 8;{raw= #raw s,inc= #inc s,ann= #ann s-removed})
          fun augment (s:hyp_summary) added : hyp_summary =
            (payer 8;{raw= #raw s,inc= #inc s,ann= #ann s+added})
          (* Fresh scalar admission for EACH rule. The two forests are
             counted separately even when identical; extra ports likewise
             retain full multiplicity. ann <= total makes the old per-port
             ann cap redundant, never a Type-incidence waiver. Maxima may
             include a deleted term, but were bounded at seeding and the
             caps are immutable, so this gives exactly the old admission
             predicate, not an extra restriction on any later forest. *)
          fun quote_summaries (a:hyp_summary) (b:hyp_summary) extra =
            let val _=payer 24
                val _=if #raw a<=template_limit andalso
                    #inc a<=template_limit andalso
                    #raw b<=template_limit andalso
                    #inc b<=template_limit then () else
                  raise ERR "assemble" "prospective compact port bound"
                fun add (p:assembly_metrics,n) =
                  (payer 8;
                   if #raw p<=template_limit andalso
                      #inc p<=template_limit andalso #ann p<=ceiling
                   then n+ #ann p else
                     raise ERR "assemble" "prospective compact port bound")
                val annotations=List.foldl add (#ann a+ #ann b) extra
                val _=payer 2
            in if annotations<=ceiling then () else
              raise ERR "assemble" "prospective compact Type portfolio"
            end
          (* Both Term.compare implementations are rator-first (not the
             standard kernel's aconv order). Split the old two-copy quote:
             inspect metadata now, return a scalar for ONE future native
             comparison. This scalar is geometry, never reusable credit.
             Binder fallback retains the experimental environment-map
             envelope. Charge the scalar bookkeeping before each update. *)
          fun comparison a b =
            let
              val _=payer 12
              val native=ref 0
              fun charge n = (payer (n+4);native := !native+n)
              fun order a b =
                (charge 8;
                 if Portable.pointer_eq (a,b) then EQUAL
                 else if Term.is_comb a andalso Term.is_comb b then
                   let val (f,x)=Term.dest_comb a
                       val (g,y)=Term.dest_comb b
                   in case order f g of EQUAL=>order x y | other=>other end
                 else if Term.is_var a andalso Term.is_var b then
                   let val (x,_)=Term.dest_var a val (y,_)=Term.dest_var b
                       val _=charge (4+String.size x+String.size y)
                   in case String.compare (x,y) of EQUAL=>atomic a b
                        | other=>other end
                 else if Term.is_abs a andalso Term.is_abs b then
                   let val amount=weight (metric a)+weight (metric b)
                       val _=charge (16+2*amount*amount)
                   in Term.compare (a,b) end
                 else if Term.is_const a andalso Term.is_const b then
                   let val x= #Name (Term.dest_thy_constid a)
                       val y= #Name (Term.dest_thy_constid b)
                       val {Thy=at,Name=an}=KernelSig.name_of_id x
                       val {Thy=bt,Name=bn}=KernelSig.name_of_id y
                       val _=charge (12+String.size at+String.size an+
                         String.size bt+String.size bn)
                   in case KernelSig.id_compare (x,y) of
                        EQUAL=>atomic a b | other=>other end
                 else Term.compare (a,b))
              and atomic a b =
                let
                  fun type_work ty =
                    (charge 3;if Type.is_vartype ty then
                       let val bytes=String.size (Type.dest_vartype ty)
                       in charge bytes;1+bytes end
                     else
                       let val {Thy,Tyop,Args}=Type.dest_thy_type ty
                           val bytes=String.size Thy+String.size Tyop
                           val _=charge (3+bytes)
                       in List.foldl (fn (child,n)=>n+type_work child)
                         (1+bytes) Args end)
                  val left=Term.type_of a val right=Term.type_of b
                  val amount=type_work left+type_work right
                  val _=charge (16+amount)
                in Type.compare (left,right) end
              val result=order a b
              val _=payer 3
            in (result,!native) end
          (* A red-black tree with n nodes has height <= 2*ceil(log2(n+1)).
             delete and singleton union compare distinct nodes on ONE
             search path. With sum S, maximum M and minimum m, prepay
             min(S,H*M,S-max(0,n-H)*m): any omitted nodes each cost >=m.
             This also handles a few expensive outliers without paying
             H copies of the largest cost. ALL metadata work stays paid;
             no dependence on native shape, pointer identity, or aconv. *)
          fun height n =
            let fun bits 0 total = (payer 2;2*total)
                  | bits n total = (payer 4;bits (n div 2) (total+1))
            in bits n 0 end
          fun candidates compare values =
            let
              fun scan [] n total largest smallest =
                    (payer 10;([],n,total,largest,smallest))
                | scan (value::rest) n total largest smallest =
                    let val _=payer 28
                        val (ordering,cost)=compare value
                        val (tail,k,sum,big,small)=scan rest (n+1)
                          (total+cost) (Int.max (largest,cost))
                          (if n=0 then cost else Int.min (smallest,cost))
                    in ((value,ordering)::tail,k,sum,big,small) end
              val (pairs,n,total,largest,smallest)=scan values 0 0 0 0
              val h=height n
              val _=payer (16+Int.min (h*largest,
                total-Int.max (0,n-h)*smallest))
            in (pairs,n,h) end
          (* With at least one binder-free operand, comparison cannot
             enter a pair of Abs bodies. Every visited pair costs eight;
             split this as four per syntax node of each operand. An atom
             adds at most 28 plus BOTH names and Type forests. For one
             Type forest, type_work + its returned size is bounded by
             7*ann + 2*type_text: ann includes every Type node and
             variable byte, type_text counts Type-operator bytes. cmp
             sums four per syntax node, fourteen plus name bytes per
             atom, and that atom's FULL Type-forest bound. Unlike port
             admission, comparison does not inspect App annotations.
             Bound construction was paid in assembly_term_quote; the
             scalar bounds ONE native comparison, never reusable credit. *)
          (* Once singleton {D} has been joined, retain an aggregate of
             the ACTUAL forest's comparisons against D. Deletion updates
             its count and sum; immutable initial extrema remain safe
             bounds for every subset. This never retains native credit:
             union pays a fresh search-path bound on every use. *)
          val _=payer 10
          val d_forest=ref
            (NONE : {n:int,total:int,largest:int,smallest:int} option)
          fun removed_from_d (Port {against_d,...}) =
            (payer 8;case !d_forest of NONE=>()
             | SOME {n,total,largest,smallest}=>
                 (case !against_d of SOME (ordering,cost)=>
                    (payer 9;
                     d_forest:=if ordering=EQUAL then NONE else
                       SOME {n=n-1,total=total-cost,
                         largest=largest,smallest=smallest})
                  | NONE=>d_forest:=NONE))
          (* A subset envelope is DATA over the initial actual Hyp. It
             bounds root-discriminated comparisons without rebuilding a
             row-by-forest cost vector. Distinct first names are required;
             aliases that change actual representatives invalidate it. *)
          type delete_envelope =
            {variableBytes:int,applicationBytes:int,headCmp:int,
             commonHead:Term.term option,otherApplicationCmp:int}
          val _=payer 3
          val delete_envelope=ref (NONE:delete_envelope option)
          fun without row values =
            let
              fun precise () =
                let val (pairs,n,h)=candidates
                      (fn value=>comparison (term row) (term value)) values
                    fun retain [] = (payer 2;([],0))
                      | retain ((value,ordering)::rest) =
                          let val _=payer 4
                              val (tail,removed)=retain rest
                          in if ordering=EQUAL then
                               (payer 4;removed_from_d value;
                                (tail,removed+ #ann (metrics value)))
                             else (value::tail,removed) end
                    val (retained,removed)=retain pairs
                in (retained,n,h,removed) end
              (* Actual Hyp is a set. If its representative is the SAME
                 pointer as row, that is the unique equal member: no
                 ordering forecast is needed to remove it. Still prepay
                 the entire future native search path. D can be much
                 larger than any row, so compare that outlier precisely,
                 rather than putting its whole geometry into the bound.
                 Misses and binders retain the original comparison path.
                 Certification below still checks EVERY actual result. *)
              fun pointer_path () =
                let val _=payer 12
                    val bound= #cmp (metrics row)
                    (* Hoist the row descriptor and its arithmetic. Each
                       other port uses ONE paid cached getter, not a name
                       comparison per row x Hyp. Same-name/shape misses
                       retain the full old cmp bound. *)
                    val _=payer 6
                    val root=prefix row
                    fun pair_bound value =
                      let val other=prefix value val _=payer 16
                          fun fallback ()=bound+ #cmp (metrics value)
                      in case (root,other) of
                          (NativeVariable {id,bytes},
                           NativeVariable {id=other,bytes=otherBytes})=>
                            if id=other then fallback ()
                            else 20+bytes+otherBytes
                        | (NativeApplication (SOME
                             {nameID,headTerm,headCmp,nameBytes}),
                           NativeApplication (SOME
                             {nameID=other,headTerm=otherHead,
                              headCmp=otherCmp,nameBytes=otherBytes}))=>
                            if nameID=other then fallback ()
                            else 36+nameBytes+otherBytes+
                              (if Portable.pointer_eq
                                  (headTerm,otherHead) then 8
                               else headCmp+otherCmp)
                        | (NativeApplication _,NativeApplication _)=>
                            fallback ()
                        | (NativeConstant,NativeConstant)=>fallback ()
                        | (NativeAbstraction,NativeAbstraction)=>fallback ()
                        | _=>8
                      end
                    (* Both kernels compare the two App rators first.
                       Different constant IDs or Types stop at the head;
                       equal heads reach the first variables, whose
                       DISTINCT interned names stop before the RHS (and
                       before their Types). Distinct first names also
                       exclude pointer-equal terms or inner rators. Thus
                       16 covers the two App pairs; the head costs eight
                       ONLY on an authenticated pointer hit (both kernels
                       are at binder depth zero), otherwise both full head
                       quotes. The variable pair costs 12 + both name
                       lengths + eight for the experimental empty-env
                       lookups, with NO Type work on unequal names.
                       This is ONLY a future bound: found below is still
                       required, then each native path is freshly paid. *)
                    fun scan [] found n total largest smallest =
                          (payer 11;([],found,n,total,largest,smallest,0))
                      | scan (value::rest) found n total largest smallest =
                          let val _=payer 44
                              val same=Portable.pointer_eq
                                (term row,term value)
                              val cost=if same then 8
                                else if Portable.pointer_eq (term value,d)
                                then #2 (comparison (term row) d)
                                else pair_bound value
                              val (tail,seen,k,sum,big,small,removed)=scan rest
                                (found orelse same) (n+1) (total+cost)
                                (Int.max (largest,cost))
                                (if n=0 then cost else
                                   Int.min (smallest,cost))
                              val removed=if same then
                                (payer 4;removed_from_d value;
                                 removed+ #ann (metrics value))
                                else removed
                          in (if same then tail else value::tail,
                              seen,k,sum,big,small,removed) end
                    val (retained,found,n,total,largest,smallest,removed)=
                      scan values false 0 0 0 0
                    val _=payer 3
                in if not found then precise () else
                     let val h=height n
                         val _=payer (16+Int.min (h*largest,
                           total-Int.max (0,n-h)*smallest))
                     in (retained,n,h,removed) end
                end
              fun enveloped (e:delete_envelope) root =
                let val _=payer 24
                    val regular=case root of
                        NativeVariable {bytes,...}=>
                          20+bytes+ #variableBytes e
                      | NativeApplication (SOME
                          {headTerm,headCmp,nameBytes,...})=>
                          Int.max (bound_for_missing e,
                            36+nameBytes+ #applicationBytes e+
                            (case #commonHead e of SOME held=>
                               if Portable.pointer_eq (held,headTerm)
                               then 8 else headCmp+ #headCmp e
                             | NONE=>headCmp+ #headCmp e))
                      | _=>0
                    fun scan [] found n outlier removed =
                          (payer 8;([],found,n,outlier,removed))
                      | scan (value::rest) found n outlier removed =
                          let val _=payer 18
                              val same=Portable.pointer_eq
                                (term row,term value)
                              val is_d=Portable.pointer_eq (term value,d)
                              val outlier=if is_d then
                                SOME (#2 (comparison (term row) d))
                                else outlier
                              val (tail,seen,k,cost,removed)=scan rest
                                (found orelse same) (n+1) outlier removed
                          in if same then
                               (payer 4;removed_from_d value;
                                (tail,seen,k,cost,
                                  removed+ #ann (metrics value)))
                             else (value::tail,seen,k,cost,removed) end
                    val (retained,found,n,outlier,removed)=
                      scan values false 0 NONE 0
                in if not found then precise () else
                     let val h=height n
                         val slots=Int.min (n,h)
                         (* At most ONE D is present in an actual set.
                            Pay the worst path even when that outlier is
                            not visited. No native tree shape is assumed. *)
                         val cost=case outlier of NONE=>slots*regular
                           | SOME amount=>slots*regular+
                               Int.max (0,amount-regular)
                         val _=payer (24+cost)
                     in (retained,n,h,removed) end
                end
              and bound_for_missing (e:delete_envelope) =
                (payer 3;if #otherApplicationCmp e=0 then 8
                 else #cmp (metrics row)+ #otherApplicationCmp e)
              val _=payer 7
            in if #plain (metrics row) then
                 if Portable.pointer_eq (term row,d) then pointer_path () else
                 (case (!delete_envelope,prefix row) of
                    (SOME e,root as NativeVariable _)=>enveloped e root
                  | (SOME e,root as NativeApplication (SOME _))=>
                      enveloped e root
                  | _=>pointer_path ())
               else precise () end
          fun maximum (a:assembly_metrics) (b:assembly_metrics)
              : assembly_metrics =
            (payer 19;{raw=Int.max (#raw a,#raw b),
              inc=Int.max (#inc a,#inc b),ann=Int.max (#ann a,#ann b),
              text=Int.max (#text a,#text b),
              plain= #plain a andalso #plain b,
              cmp=Int.max (#cmp a,#cmp b)})
          fun merge (a as Port {term=t,metrics=p,aliases=xs,...})
              (Port {term=u,metrics=q,aliases=ys,...}) =
            (payer 6;if Portable.pointer_eq (t,u) then a else
               (* Term.compare EQUAL preserves raw/inc and ann (alpha
                  renaming changes no Type incidence). Thus maximum's ann
                  is exact for EVERY alias, not an upper-bound substitute
                  for the full-multiplicity sums. Text/cmp may differ.
                  Pay the added prefix field/ref; as with against_d,
                  merged aliases must not retain a descriptor cache. *)
               (payer 3;
                Port {term=t,metrics=maximum p q,aliases=append xs ys,
                  against_d=ref NONE,prefix=ref NONE}))
          (* The projection Hyp is ALWAYS the singleton {D}. Cache only
             its immutable comparison geometry, never a native allowance.
             Each use prepays a fresh path bound. Certification invalidates
             the cache if the actual representative pointer changes.
             Costs are symmetric, also covering union's reversed insertion
             direction when BOTH operand sets happen to be singletons. *)
          fun union left row =
            let
              (* If D is already in the certified forest, singleton union
                 cannot change that set. The alias established by the first
                 merge remains available to certify native representatives,
                 including the singleton/singleton operand-order case. *)
              fun retained {n,total,largest,smallest} =
                let val h=height n
                    val _=payer (28+Int.min (h*largest,
                      total-Int.max (0,n-h)*smallest))
                in (left,n,h,0) end
              fun initial () =
            let fun against (Port {term=held,against_d,...}) =
                  (payer 4;case !against_d of SOME saved=>saved
                   | NONE=>let val saved=comparison (term row) held
                               val _=payer 3
                           in against_d:=SOME saved;saved end)
                (* Keep candidates' fresh path payment. *)
                val (comparisons,n,h)=candidates against left
                fun remaining values=map (fn (value,_)=>value) values
                fun insert [] =
                      (payer 5;([row],#ann (metrics row)))
                  | insert ((value,comparison)::rest) =
                      (payer 4;case comparison of
                         LESS=>(payer 3;
                           (row::value::remaining rest,#ann (metrics row)))
                       | EQUAL=>
                           let val joined=merge value row val _=payer 6
                           in (joined::remaining rest,
                             #ann (metrics joined)- #ann (metrics value)) end
                       | GREATER=>let val (tail,added)=insert rest
                                  in (value::tail,added) end)
                val _=payer 2
                val (joined,added)=insert comparisons
                (* Locate the D representative once. Its future comparison
                   is eight only for the SAME pointer; merged aliases may
                   select another pointer, so use a full paid comparison. *)
                fun finish [] count sum big small =
                      (payer 12;d_forest:=SOME {n=count,total=sum,
                        largest=big,smallest=small})
                  | finish ((value as Port {against_d,...})::rest)
                      count sum big small =
                      let val _=payer 18
                          val saved=case !against_d of SOME saved=>saved
                            | NONE=>let val saved=comparison (term row)
                                          (term value) val _=payer 3
                                    in against_d:=SOME saved;saved end
                          val cost= #2 saved
                      in finish rest (count+1) (sum+cost)
                           (Int.max (big,cost))
                           (if count=0 then cost else Int.min (small,cost))
                      end
                val _=finish joined 0 0 0 0
            in (joined,n,h,added) end
            in payer 3;case !d_forest of SOME summary=>retained summary
              | NONE=>initial () end
          (* Native sets are sorted. After each lift, authenticate EVERY
             actual Hyp pointer against its forecast position/aliases.
             Pay list extraction, pointer tests and new port cells BEFORE
             the native operation, not on a later successful rule. *)
          fun verification_quote ports =
            let fun aliases (Port {aliases,...},n)=
                  n+count aliases
                (* Four extra events per result port cover the prefix
                   field/branch and, on change, a fresh empty ref. *)
            in payer (16+19*count ports+
              4*List.foldl aliases 0 ports) end
          fun certify [] [] = []
            | certify (Port {term=held,metrics,aliases,against_d,prefix}::rest)
                (actual::tail) =
                if List.exists (fn held=>
                    Portable.pointer_eq (actual,held)) aliases then
                  let val same=Portable.pointer_eq (actual,held)
                      (* A different native representative can change an
                         eight-event pointer comparison into a structural
                         comparison. Drop the aggregate, never that work. *)
                      val _=if same then () else
                        (d_forest:=NONE;delete_envelope:=NONE)
                  in Port {term=actual,metrics=metrics,aliases=aliases,
                    against_d=if same then against_d else ref NONE,
                    prefix=if same then prefix else ref NONE}::
                    certify rest tail end
                else raise ERR "assemble" "actual native Hyp pointer changed"
            | certify _ _ = raise ERR "assemble" "actual native Hyp changed"
          (* The newly built conjunction spine owns these exact children.
             Measure each leaf once and each of the two actual App nodes
             once, bottom-up. Keeping the child ports avoids remeasuring
             every descendant when projection later reaches that child.
             Actual theorem conclusions are still authenticated below;
             destructor clones retain the independently paid fallback. *)
          datatype projection_geometry = NoGeometry
            | Geometry of port * projection_geometry * projection_geometry
          fun projection_geometry boundary actual =
            (payer 6;case boundary of
               Split (a,b) =>
                 let val _=payer 10
                     val (partial,right)=Term.dest_comb actual
                     val (head,left)=Term.dest_comb partial
                     val ga=projection_geometry a left
                     val gb=projection_geometry b right
                     fun root (Geometry (p,_,_))=metrics p
                       | root NoGeometry=raise ERR "assemble"
                           "missing projection geometry"
                     val hm=metric head
                     val pm= #application metric_reader partial hm (root ga)
                     val amount= #application metric_reader actual pm
                       (root gb)
                 in Geometry (measured_port actual amount,ga,gb) end
             | _ => Geometry (port actual,NoGeometry,NoGeometry))
          val projection_geometry=if sparse then
              projection_geometry boundary d else NoGeometry
          val dport=case projection_geometry of
              Geometry (p,_,_)=>SOME p | NoGeometry=>NONE
          val conclusion=if sparse then SOME (port (Thm.concl proof)) else NONE
          (* Seed once from the actual ports' already measured immutable
             terms, before project_paid. All future prospective port caps
             and admissions remain fresh, including on hot hits. *)
          val _ = payer 12
          val _ = case (dport,conclusion) of
              (SOME dp,SOME cp) => hot_geometry :=
                SOME ((term dp,metrics dp),(term cp,metrics cp))
            | _ => ()
          fun required (SOME value)=value
            | required NONE=raise ERR "assemble" "missing sparse geometry"
          val implication_constant=if sparse then
              SOME (metric boolSyntax.implication) else NONE
          (* prim_mk_imp borrows both children. Its two Apps add two raw,
             two inclusive and four Boolean annotation incidences. Admit
             the FULL prospective result without constructing that term. *)
          fun implication row conclusion : assembly_metrics =
            let val a=metrics row val b=metrics conclusion
                val c=required implication_constant val _=payer 35
            in {raw= #raw a+ #raw b+ #raw c+2,
                inc= #inc a+ #inc b+ #inc c+2,
                ann= #ann a+ #ann b+ #ann c+4,
                text= #text a+ #text b+ #text c,
                plain= #plain a andalso #plain b andalso #plain c,
                cmp= #cmp a+ #cmp b+ #cmp c+8} end
          fun discharge_quote row conclusion hyp summary =
            let val (retained,n,h,removed)=without row hyp
                val retained_summary=subtract summary removed
                val next=implication row conclusion
                val _=payer 6
                val _=quote_summaries summary retained_summary
                  [metrics row,metrics conclusion,next]
                (* is_bool/type_of(row), persistent-set delete/rebalance,
                   two App constructors, Count and theorem record. No
                   native FVL/varset traversal occurs in DISCH or MP. *)
                (* del visits <=H nodes; append then follows at most two
                   height-H spines, with constant-time balancing per node.
                   These visits are also distinct in the original tree. *)
                val _=payer (128+weight (metrics row)+
                  32*Int.min (n,3*h+1))
            in (retained,retained_summary,next) end
          (* Reuse only pointer-authenticated geometry. A valid closure
             alias may have another pointer: measure that actual port,
             rather than rejecting it or borrowing the forecast's size. *)
          fun actual_port held saved = if not sparse then NONE else
            let val _=payer 6 val actual=Thm.concl held
            in case saved of SOME old=>
                 if Portable.pointer_eq (actual,term old) then saved
                 else SOME (port actual)
               | NONE=>SOME (port actual)
            end
          fun child_port actual geometry =
            (payer 6;case geometry of Geometry (p,_,_)=>
               if Portable.pointer_eq (actual,term p) then SOME p
               else if sparse then SOME (port actual) else NONE
             | NoGeometry=>if sparse then SOME (port actual) else NONE)
          fun project_paid Empty _ _ _ = []
            | project_paid (Leaf _) held saved _ =
                let val actual=actual_port held saved val _=payer 3
                in [(held,actual)] end
            | project_paid (Split (a,b)) held saved geometry =
                let val parent=actual_port held saved
                    val _=payer 7
                    val (ga,gb)=case geometry of Geometry (_,ga,gb)=>(ga,gb)
                      | NoGeometry=>(NoGeometry,NoGeometry)
                    val (left,right)=boolSyntax.dest_conj (Thm.concl held)
                    val lp=child_port left ga
                    val rp=child_port right gb
                    (* ALL four incidences are admitted for EACH rule;
                       carrying ports removes only repeated geometry work. *)
                    val _=if sparse then quote
                      [required lp,required dport,required parent,
                       required dport] [] else ()
                    val _ = payer 128
                    val l = SmtReplayRuleObservation.CONJUNCT1 held
                    val _=if sparse then quote
                      [required rp,required dport,required parent,
                       required dport] [] else ()
                    val _ = payer 128
                    val r = SmtReplayRuleObservation.CONJUNCT2 held
                in project_paid a l lp ga @ project_paid b r rp gb end
          (* Private geometry parallels the public theorem vector. It is
             authenticated again on lift, never exported as permission. *)
          val (projected,projection_ports) = case indices of NONE =>
                (projections,Vector.fromList [])
            | SOME _ =>
                let val _=if sparse then quote
                      [required dport,required dport] [] else ()
                    val _=if sparse then
                      payer (128+weight (metrics (required dport)))
                      else payer 1
                    val rows=project_paid boundary
                      (SmtReplayRuleObservation.ASSUME d) dport
                      projection_geometry
                    val _=payer (4+12*count rows)
                    val rows=Vector.fromList rows
                in (Vector.map #1 rows,Vector.map #2 rows) end
          val _ = phase "projected" (fn () => "")
          val (hypotheses,hyp_summary) = if not sparse then
              ([],{raw=0,inc=0,ann=0}) else
            let val _=payer 8
                val dp=metrics (required dport)
                fun seed [] summary = (payer 2;([],summary))
                  | seed (held::rest) (s:hyp_summary) =
                      let val _=payer 32
                          val value=port held val p=metrics value
                          val _=if #raw p<=template_limit andalso
                              #inc p<=template_limit then () else
                            raise ERR "assemble"
                              "prospective compact port bound"
                          val next={raw=Int.max (#raw s,#raw p),
                            inc=Int.max (#inc s,#inc p),ann= #ann s+ #ann p}
                          val (tail,summary)=seed rest next
                      in (value::tail,summary) end
            in seed (Thm.hyp proof) {raw= #raw dp,inc= #inc dp,ann=0} end
          (* Capture root geometry once. A bit per interned name detects
             duplicate variable/application prefixes; those forests keep
             the complete pairwise fallback. Maxima stay safe for subsets.
             D is handled separately and precisely in every deletion. *)
          val _=if not sparse then () else
            let val roots=map (fn value=>(value,prefix value)) hypotheses
                val size= !next_prefix_name
                val _=payer (24+size)
                val seen=Array.array (size,0)
                fun unique id bit =
                  let val _=payer 12 val old=Array.sub (seen,id)
                  in if old=bit orelse old=3 then false else
                       (Array.update (seen,id,old+bit);true) end
                fun seed [] vb ab hc common missing valid =
                      (payer 8;if valid then delete_envelope:=SOME
                        {variableBytes=vb,applicationBytes=ab,headCmp=hc,
                         commonHead=common,otherApplicationCmp=missing}
                       else ())
                  | seed ((value,root)::rest) vb ab hc common missing valid =
                      let val _=payer 26
                      in case root of NativeVariable {id,bytes}=>
                           seed rest (Int.max (vb,bytes)) ab hc common missing
                             (unique id 1 andalso valid)
                       | NativeApplication (SOME
                           {nameID,headTerm,headCmp,nameBytes})=>
                           let val common=if hc=0 then SOME headTerm else
                                 case common of SOME held=>
                                   if Portable.pointer_eq (held,headTerm)
                                   then common else NONE
                                 | NONE=>NONE
                           in seed rest vb (Int.max (ab,nameBytes))
                             (Int.max (hc,headCmp)) common missing
                             (unique nameID 2 andalso valid) end
                       | NativeApplication NONE=>seed rest vb ab hc common
                           (if Portable.pointer_eq (term value,d) then missing
                            else Int.max (missing,#cmp (metrics value))) valid
                       | _=>seed rest vb ab hc common missing valid
                      end
            in seed roots 0 0 0 NONE 0 true end
          fun lift ((premise,saved),(result,hyp,summary)) = if not sparse then
              (SmtReplayRuleObservation.D_PROVE_HYP premise result,[],summary)
            else let
              val row=required (actual_port premise saved)
              val current=required conclusion val dp=required dport
              val _=payer 5
              val _=case Thm.hyp premise of [held]=>
                  if Portable.pointer_eq (held,d) then () else
                    raise ERR "assemble" "projection Hyp pointer changed"
                | _=>raise ERR "assemble" "projection Hyp changed"
              (* PROVE_HYP = MP (DISCH row result) premise, unchanged.
                 Both COMPLETE portfolios and both kernel programmes are
                 prepaid before entering that two-rule native wrapper. *)
              val _=phase "lift.disch.before" (fn()=>
                " hypotheses=" ^ Int.toString (length hyp))
              val (retained,retained_summary,next)=
                discharge_quote row current hyp summary
              val _=phase "lift.mp.before" (fn()=>"")
              val (joined,n,h,added)=union retained dp
              val joined_summary=augment retained_summary added
              (* Four list cells, three metric getters and the additional
                 carried-summary field in the returned lift state. *)
              val _=payer 8
              val _=quote_summaries retained_summary joined_summary
                [metrics row,metrics dp,metrics current,next]
              (* dest_imp, SAME-pointer antecedent aconv, singleton set
                 union/rebalance, Tag.merge with projection's empty tag,
                 Count and theorem record. Comparisons were paid above. *)
              val _=payer (128+32*Int.min (n,h+1))
              val _=verification_quote joined
              val _=phase "lift.quoted" (fn()=>"")
              val lifted=SmtReplayRuleObservation.D_PROVE_HYP premise result
              val actual=certify joined (Thm.hyp lifted)
              (* Carry the sum ONLY after every actual representative has
                 been authenticated. No summary grants permission to skip
                 native work, subsequent cap checks, or certification. *)
              val _=if Portable.pointer_eq
                  (Thm.concl lifted,term current) then () else
                raise ERR "assemble" "actual native conclusion changed"
            in (lifted,actual,joined_summary) end
          val (lifted,lifted_hyp,lifted_summary) = case indices of NONE =>
                (proof,[],hyp_summary)
            | SOME _ => Vector.foldli (fn (index,premise,state)=>
                (payer 4;lift ((premise,
                  Vector.sub (projection_ports,index)),state)))
                (proof,hypotheses,hyp_summary) projected
          val _ = phase "close.disch.before" (fn () => "")
          val closed_geometry = if sparse then
              let val (_,_,m)=discharge_quote (required dport)
                    (required conclusion) lifted_hyp lifted_summary
                  val _=payer 4
              in SOME (#raw m,#inc m,#ann m) end else NONE
          val _ = phase "close.disch.quoted" (fn () => "")
          val law = SmtReplayRuleObservation.DISCH d lifted
          val _ = guard block [Thm.concl law]
          val _ = if null (Thm.hyp law) andalso clean law then () else
            raise ERR "assemble" "compact proof is not closed"
          val result = {proof=proof,indices=indices,tree=boundary,context=d,
            projections=projected,law=law,
            geometry=closed_geometry}:compact_assembly
          val _ = assembly := SOME result
          val _ = phase "after" (fn () => "")
        in result end
    in case !assembly of SOME held =>
         if Portable.pointer_eq (proof,#proof held) then held else build ()
       | NONE => build () end

  fun assemble block edge =
    (policy_legacy_block_only "assemble" block;
     #law (assemble_internal block edge))

  (* Insertion guards exclude graph names below binders. Inspect only
     compact syntax, never expanded representatives. *)
  fun retained_proof_nodes (Block {nodes,...}) proof =
    let
      fun spend n = case nodes of FixedTable {work,...} => W.spend work n
        | _ => ()
      fun compare (a,b) =
        (spend (1+String.size a+String.size b);String.compare (a,b))
      fun visit term set =
        (spend 1;
         if Term.is_var term then
           Redblackset.add (set,#1 (Term.dest_var term))
         else if Term.is_comb term then
           let val (a,b) = Term.dest_comb term
           in visit b (visit a set) end
         else set)
      val used = List.foldl (fn (term,set) => visit term set)
        (Redblackset.empty compare) (Thm.concl proof :: Thm.hyp proof)
    in table_foldl (fn (_, (node,variable),rest) =>
      (spend 1;if Redblackset.member (used,#1 (Term.dest_var variable))
        then node::rest else rest)) [] nodes end

  fun refreeze_needed_sources (old as Block
      {graph,scope,nodes,leaves,template_limit,leaf_index,...})
      {roots,target,edge} =
    let
      val proof = theorem old edge
      val _ = if table_owned nodes then
        raise ERR "refreeze_needed_sources" "owned table route is final only"
        else ()
      val _ = if Option.isSome leaf_index then () else
        raise ERR "refreeze_needed_sources" "not a sparse preparation block"
      val _ = if Term.aconv (Thm.concl proof) (name old target) then () else
        raise ERR "refreeze_needed_sources" "wrong compact target"
      val original_nodes = retained_proof_nodes old proof
      val used = Redblackset.addList (Redblackset.empty Int.compare,
        needed_leaves old edge)
      val original_sources = sources old
      val _ = retire_block old
      val closed_facts = Vector.foldri
        (fn (i,ClosedWitness fact,rest) =>
              if Redblackset.member (used,i) then fact::rest else rest
          | (_,_,rest) => rest) [] leaves
      val conversions = Vector.foldri
        (fn (i,ConversionWitness plan,rest) =>
              if Redblackset.member (used,i) then plan::rest else rest
          | (_,_,rest) => rest) [] leaves
      val next = freeze_internal true closed_facts conversions graph
        {scope = scope,roots = roots @ original_nodes,
         sources = original_sources,template_limit = template_limit}
      val _ = List.app (fn node =>
        if Portable.pointer_eq (G.placeholder graph node,name next node)
          then () else raise ERR "refreeze_needed_sources"
            "compact name identity changed") original_nodes
      val transferred = checked next proof
      val _ = assemble next transferred
    in {block = next,edge = transferred} end

  (* The checked sparse edge, not a caller's needed array, is the only
     dependency authority. Expected Work precedes block/edge activation. *)
  fun needed_source_occurrences_with_work expected block edge =
    ((validate_block_for expected block;
      W.with_step expected (fn () =>
        let val _ = validate_block_for expected block
            val proof = theorem block edge
            val Block {owned_names,template_limit,...} = block
            val names = case owned_names of SOME names => names
              | NONE => raise ERR "needed_sources_with_work"
                  "missing authentic owned names"
            val terms = Thm.concl proof :: Thm.hyp proof
            val _ = List.app
              (fixed_guard_operand expected names template_limit) terms
            val _ = owned_sparse_projection_quote expected template_limit
              (Vector.fromList terms)
            val indices = needed_source_occurrences block edge
            val _ = List.app (fn _ => W.spend expected 1) indices
            val _ = validate_block_for expected block
        in indices end))
     handle primary => (W.close expected;raise primary))

  (* Keep original Source occurrences, but only actual successful witness
     and constructor demands. New resolution roots remain explicit. Transfer
     the immutable sparse theorem after checking its retained names/Hyp;
     separately cache its balanced, closed common-context assembly. *)
  fun refreeze_needed_sources_with_work expected
      (old as Block {graph,scope,nodes,leaves,template_limit,
        leaf_index,owned_names,...}) {roots,target,edge} =
    ((validate_block_for expected old;
      W.with_step expected (fn () =>
      let
        val _ = validate_block_for expected old
        val _ = if Option.isSome leaf_index then () else
          raise ERR "refreeze_needed_sources_with_work"
            "not an owned sparse preparation block"
        val proof = theorem old edge
        val names = case owned_names of SOME names => names
          | NONE => raise ERR "refreeze_needed_sources_with_work"
              "missing authentic owned names"
        val terms = Thm.concl proof :: Thm.hyp proof
        val _ = List.app
          (fixed_guard_operand expected names template_limit) terms
        val _ = owned_sparse_projection_quote expected template_limit
          (Vector.fromList terms)
        val target_name = name old target
        val _ = W.spend expected 1
        val _ = if Term.aconv (Thm.concl proof) target_name then () else
          raise ERR "refreeze_needed_sources_with_work"
            "wrong compact target"
        (* Certify the entire actual Hyp against the old sparse index.
           Constructor/closed/conversion leaves participate, not only S. *)
        val used = Redblackset.addList
          (Redblackset.empty (fn (a,b) =>
            (W.spend expected 1;Int.compare (a,b))),needed_leaves old edge)
        val retained = retained_proof_nodes old proof
        val source_frame = retained_source_frame_for expected old []
        fun live i = (W.spend expected 1;Redblackset.member (used,i))
        val definitions = Vector.foldri
          (fn (i,Definition (node,_),rest) =>
                if live i then node::rest else rest
            | (_,_,rest) => (W.spend expected 1;rest)) [] leaves
        val facts = Vector.foldri
          (fn (i,ClosedWitness held,rest) =>
                if live i then held::rest else rest
            | (_,_,rest) => (W.spend expected 1;rest)) [] leaves
        val conversions = Vector.foldri
          (fn (i,ConversionWitness held,rest) =>
                if live i then held::rest else rest
            | (_,_,rest) => (W.spend expected 1;rest)) [] leaves
        (* Standalone variable/binder/opaque names carry no application
           demand. Application cuts remain justified only by the SAME
           held genuine realization leaves, not by an inferred atom flag. *)
        val anchors = List.filter (fn node =>
          (W.spend expected 1;case G.view graph node of
             G.Application _ => false | _ => true)) retained
        val frontier = prepare_retained_source_frontier expected source_frame
          {roots = target::definitions @ roots @ anchors,closed_facts = facts,
           conversions = conversions}
        val tables = prepare_owned_realization_tables expected frontier
        val next as Block {owner,leaf_index = next_index,...} =
          freeze_owned_needed_realization_tables_plan expected tables
        val _ = List.app (fn node =>
          if Portable.pointer_eq (G.placeholder graph node,name next node)
            then () else raise ERR "refreeze_needed_sources_with_work"
              "compact name identity changed") retained
        val index = case next_index of SOME held => held
          | NONE => raise ERR "refreeze_needed_sources_with_work"
              "missing final sparse index"
        (* This SAME proof is already kernel checked. No INST, ALPHA,
           PROVE_HYP or externally paired theorem is accepted here. *)
        fun lookup hypothesis =
          (W.spend expected 1;
           case Redblackmap.peek (index,hypothesis) of
             SOME (index::_) => index
           | _ => raise ERR "refreeze_needed_sources_with_work"
               "original compact Hyp is absent from final leaves")
        val actual = List.map lookup (Thm.hyp proof)
        val dependency = new_dependency next (Leaves actual)
        val transferred = Edge {owner = owner,theorem = proof,
          dependencies = dependency,primitive=NONE}
        val _ = needed_leaves next transferred
        val _ = assemble next transferred
        val _ = retained_source_guard expected source_frame
        val _ = validate_block_for expected next
        val _ = W.spend expected 1
        val _ = retire_block old
      in {block = next,edge = transferred} end))
     handle primary => (W.close expected;raise primary))

  fun compose (block as Block {owner, graph, context, leaf_index, ...})
      operation premises =
    let
      val _ = policy_legacy_block_only "compose" block
      val proofs = List.map (theorem block) premises
      val _ = observe_proof graph #generic
      val result = operation proofs
      val _ = guard block (Thm.concl result :: Thm.hyp result)
      val _ = if clean result andalso
        List.all (fn hypothesis => case leaf_index of NONE =>
            Term.aconv hypothesis context
          | SOME table => Redblackmap.inDomain (table,hypothesis))
          (Thm.hyp result) then ()
        else raise ERR "compose" "invalid common-context proof"
      val dependencies = new_dependency block (Union (List.map
        (fn Edge {dependencies, ...} => dependencies) premises))
    in observe_proof graph #edges;Edge {owner = owner, theorem = result,
      dependencies = dependencies,primitive=NONE} end

  (* No external theorem operation/callback or raw operand is supplied.
     Every premise belongs to THIS block before the fixed recipe executes.
     Exact arity declines before the first new kernel rule. *)
  datatype compact_primitive = ReflexiveName of G.node
    | Symmetry | Transitivity | Congruence | EqualityMP
    | ApplyNamedArgument of G.node | ImplicationMP
  fun named_primitive (ReflexiveName node) =
        SmtReplayNamedContext.ReflexiveName node
    | named_primitive Symmetry = SmtReplayNamedContext.Symmetry
    | named_primitive Transitivity = SmtReplayNamedContext.Transitivity
    | named_primitive Congruence = SmtReplayNamedContext.Congruence
    | named_primitive EqualityMP = SmtReplayNamedContext.EqualityMP
    | named_primitive (ApplyNamedArgument node) =
        SmtReplayNamedContext.ApplyNamedArgument node
    | named_primitive ImplicationMP = SmtReplayNamedContext.ImplicationMP
  fun derive_primitive block recipe premises =
    compose block (fn proofs =>
      let val _ = case (recipe,proofs) of
              (ImplicationMP,[law,_]) =>
                ignore (boolSyntax.dest_imp_only (Thm.concl law))
            | _ => ()
      in SmtReplayNamedContext.primitive_using
        (fn () => ERR "derive_primitive" "incorrect fixed recipe arity")
        (name block) (named_primitive recipe) proofs end)
      premises

  (* Prospective fixed kernel grammar. Generic compose remains unchanged;
     this inventory does NOT price HOLset/FVL or private kernel forcing. *)
  type primitive_profile = SmtReplayNamedContext.profile
  datatype primitive_shape = datatype SmtReplayNamedContext.shape
  datatype primitive_plan = PrimitivePlan of
    {work:W.portfolio,block:block,recipe:compact_primitive,
     premises:edge list,proofs:Thm.thm list,result:primitive_profile,
     result_equation:(primitive_profile * primitive_profile) option,
     shape:primitive_shape,hypotheses:primitive_term_data list list,
     certify_hypotheses:Term.term list -> primitive_hyp_data,
     dependencies:dependency list,
     epoch:int,symbols:int,used:bool ref}
  fun primitive_work expected (Block {owned_frame,...}) =
    case owned_frame of SOME (work,_) =>
      if Portable.pointer_eq (expected,work) then () else
        (W.close expected;raise ERR "primitive_work" "different original Work")
    | NONE => (W.close expected;
        raise ERR "primitive_work" "unowned fixed-rule block")
  (* Fixed native rules union, rather than concatenate, premise Hyp.
     Keep one occurrence of the SAME authentic common-context pointer in
     the prospective result portfolio. Every other candidate is retained.
     This reader is fresh for ONE preparation, not a completed quotation
     cache: the first occurrence pays its full raw/inclusive/Type weight.
     Filtering and allocation are paid as well as the downstream quote. *)
  fun common_hypotheses_using (pay:IntInf.int -> unit) common observe =
    let val _ = pay 5
        val seen = ref false
        fun copy [] = (pay 1;[])
          | copy (term::rest) =
              (pay 4;if Portable.pointer_eq (term,common) then
                 (pay 2;if !seen then copy rest else
                    (pay 3;seen := true;term::copy rest))
               else (pay 1;term::copy rest))
    in fn proof => (pay 1;copy (observe proof)) end

  fun validate_primitive_owner expected block =
    ((primitive_work expected block;W.spend expected 0;active block)
     handle primary => (W.close expected;raise primary))
  fun primitive_owner_for expected (block as Block {graph,scope,...}) =
    (validate_primitive_owner expected block;{graph = graph,scope = scope})
  fun clear_primitive_metadata expected
      (Block {owned_frame,primitive_metadata,...}) =
    (* Failure cleanup must not activate a foreign held frame or replace
       the original exception with a debit on an already retired Work. *)
    case owned_frame of SOME (work,_) =>
        if Portable.pointer_eq (expected,work) then primitive_metadata:=NONE
        else ()
      | NONE => ()
  fun prepare_primitive expected block recipe premises =
    ((primitive_work expected block;
      (* SAME immutable Work header first, including on exhausted Work.
         Prepay 64 fixed metadata events BEFORE the passive audit reads:
         two audit calls/matches/used+phase reads/branches/records and
         charged projections (<=20), delta and mode dispatch (<=4), plus
         <=40 for header control, arguments and payer setup. This spend
         performs the ordinary Scope guard before its budget decision;
         no held block is activated or consulted to bill these reads. *)
      W.spend expected 64;
      let
        val charged_before = #charged (W.audit expected)
        val _ = W.spend expected 0
        val overhead = #charged (W.audit expected) - charged_before
        val _ = active block
        val _ = tables_phase expected "primitive.entry" (fn () => "")
        val cap = IntInf.fromInt (template_limit block)
        val ceiling = IntInf.fromInt (W.work_limit expected)
        (* This preparation has no caller callback or new G Scope. The
           ScopeMap and ancestor path therefore stay fixed: a successful
           zero spend samples the exact guard programme on THIS counter.
           In particular PaidIndices can bill its coupled R meter even
           when priced_root_scope_path is NONE. No guard is run against a
           fresh quota, and the delta is neither refunded nor credit.
           Batch only when the original Work actually pays a guard fee;
           native quotes and full final guards remain separate below. *)
        val spend = if overhead=0 then W.spend expected else
              let val _=W.spend expected 16
                  val credit = ref 0
              in fn n =>
                let
                  (* The immutable mode dispatch is outside the hot loop.
                     Eight carrier events: call, payload addition, balance
                     read/comparison/branch, balance read/subtraction/write.
                     A miss additionally reserves 48 balance/audit/refill
                     events. After each call, credit is total refill
                     payload debits minus sum(n+8) minus 48 per refill.
                     It stays nonnegative; <1024 unused units are dropped
                     at return, never refunded or used by native quotes.
                     Below the low-water mark refill only the exact need;
                     never absorb the remainder as speculative credit.
                     Guard fees are additional original-Work debits. *)
                  val amount=n+8
                in if amount <= !credit then credit:= !credit-amount else
                  let val need=amount+48- !credit
                      val available=IntInf.toInt ceiling -
                        #charged (W.audit expected)
                      val batch=if available<=1024+overhead+48 then need
                        else Int.max (need,1024)
                      val _=W.spend expected batch
                  in credit:= !credit+batch-amount-48 end
                end
              end
        (* Added fixed carrier setup: <=64 closures/records/selectors,
           <=128 scalar dispatch/projection events, and <=128 branch/call
           events, independently of every miss/walk/hit invoice below. *)
        val _ = spend 320
        (* The suffix parser's byte operations are metadata too. Its
           carrier admits the SAME actual bytes before their traversal,
           without four extra remaining/Scope walks per variable. The
           native Type-comparison quotes retain their original pay calls. *)
        fun metadata_pay amount =
          if amount>=0 andalso amount<=ceiling then
            spend (IntInf.toInt amount)
          else (W.close expected;
            raise ERR "private_table" "original Work exhausted")
        fun plus a b = IntInf.min (ceiling+1,a+b)
        fun times a b = IntInf.min (ceiling+1,a*b)
        val Block {graph,scope,primitive_metadata,...} = block
        (* Prepay the failure cleanup write: Work may already be retired
           when an exception requires dropping this private metadata. *)
        val _ = spend 1
        (* Only successful syntax metadata belongs in this private cache.
           Its geometry contains no Source proof or callback result;
           ordinal slots retain only an authentic theorem as a pointer key.
           The original owner/frame guard precedes every use. Naming
           admission stays at its original later position below. *)
        fun metadata () =
          let
            (* Header/final guards bracket this callback-free preparation.
               These immutable syntax tables need no additional complete
               Scope walk at each internal lookup. Epoch/revision fences
               and each observation's original Work charge remain. *)
            (* One prepaid fixed header rather than four carrier calls:
               revision/epochs, both epoch tests and revision dispatch. *)
            val _ = spend 7
            val revision = G.validation_revision graph scope
            val epoch = Type.type_epoch ()
            val symbols = Term.term_epoch ()
            fun fresh () =
              let
                  (* Three 127-cell tables, a 128-cell ordinal table,
                     ref headers, record and publication are prepaid. *)
                  val _ = spend (12+4*128)
                  val saved = PrimitiveMetadata
                    {revision=revision,epoch=epoch,symbols=symbols,
                     profiles=Array.array(127,[]),
                     bytes=Array.array(127,[]),operands=Array.array(127,[]),
                     edges=ref(Array.array(128,NONE))}
                  val _ = primitive_metadata := SOME saved
              in saved end
            (* Profiles contain only raw/inclusive/Type incidence; bytes
               contain only variable spelling lengths. Their saturation
               ceiling belongs to this block's SAME immutable Work limit.
               Graph growth changes none of these values. Operands and
               per-Hyp admitted flags memoize only name-class permission
               for their exact revision, never a lifetime/policy guard. *)
            fun refresh profiles bytes edges =
              let
                  (* One array plus its 127 initialized cells, the new
                     record and its publication; no new Work or credit. *)
                  val _ = spend (8+128)
                  val saved = PrimitiveMetadata
                    {revision=revision,epoch=epoch,symbols=symbols,
                     profiles=profiles,bytes=bytes,
                     operands=Array.array(127,[]),
                     edges=edges}
                  val _ = primitive_metadata := SOME saved
              in saved end
            fun same_epochs types terms =
              types=epoch andalso terms=symbols
          in case !primitive_metadata of
              SOME (saved as PrimitiveMetadata
                {revision=old,epoch=types,symbols=terms,
                 profiles,bytes,edges,...}) =>
                  if same_epochs types terms then
                    (if old=revision then saved else
                       refresh profiles bytes edges)
                  else fresh ()
            | NONE => fresh ()
          end
        fun lookup_rows _ [] = (spend 1;NONE)
          | lookup_rows term ((held,value)::rest) =
              (spend 2;if Portable.pointer_eq (term,held) then SOME value
               else lookup_rows term rest)
        (* A route is only a collision-tolerant hint. Sample at most two
           App layers and the final two variable-name bytes, not a complete
           repeated name fold. Arbitrary names and collisions are safe:
           lookup_rows ALWAYS authenticates the exact physical term.
           Full spelling and Type admission below is independent of this
           hint. No binder body is opened by routing. *)
        fun route_code depth term =
          (spend 2;if Term.is_var term then
             let val _=spend 24
                 val name= #1(Term.dest_var term)
                 val size=String.size name
                 fun byte offset=if size<offset then 0w0 else
                   Word.fromInt(Char.ord(String.sub(name,size-offset)))
             in Word.+(Word.fromInt size,
                  Word.+(Word.*(byte 1,0w37),byte 2)) end
           else (spend 2;if Term.is_const term then
             (spend 6;Word.fromInt(KernelSig.epoch_of
               (#Name(Term.dest_thy_constid term))))
           else (spend 2;if depth=0 orelse not(Term.is_comb term) then
             (spend 1;0w19) else
             let val _=spend 8
                 val (left,right)=Term.dest_comb term
                 val a=route_code (depth-1) left
                 val b=route_code (depth-1) right
             in Word.+(Word.*(a,0w37),Word.*(b,0w17)) end)))
        fun route_bucket term =
          let val _=spend 4
              (* Named binary ports are distinguished by their first
                 operand. Sampling the other branch again serves no
                 admission purpose: every collision still probes the full
                 physical key, and all spellings/Types are admitted below. *)
              val sample=if Term.is_comb term then
                let val _=spend 6
                    val (left,right)=Term.dest_comb term
                in if Term.is_comb left then
                     (spend 3;#2 (Term.dest_comb left)) else right end
                else term
              val code=route_code 0 sample val _=spend 4
          in Word.toInt(Word.mod(code,0w127)) end
        (* All three geometry/permission tables use the SAME immutable
           routing programme. Keep a bounded, prepare-local pointer view of
           that DATA, not a completed lookup or admission. Repeated profile,
           operand and byte queries still probe their actual current rows;
           only the redundant name-fold/syntax sampling is absent on hits.
           No scope, callback result, native incidence or permission is held.
           A full view falls back to the original paid programme. *)
        val _ = spend 8
        val routes = ref ([] : (Term.term * int) list)
        val route_count = ref 0
        fun route term =
          let fun find [] = (spend 1;NONE)
                | find ((held,index)::rest) =
                    (spend 3;if Portable.pointer_eq(term,held) then
                       SOME index else find rest)
          in spend 2;case find (!routes) of SOME index=>index
            | NONE=>
                let val index=route_bucket term
                    val _=spend 2
                    val _=if !route_count<16 then
                        (spend 6;routes:=(term,index):: !routes;
                         route_count:= !route_count+1) else ()
                in index end
          end
        fun lookup table term =
          let val index=route term
              val _=spend 1
              val rows=Array.sub(table,index)
          in (index,lookup_rows term rows)end
        fun insert table index term value =
          (spend 4;Array.update(table,index,
             (term,value)::Array.sub(table,index)))
        fun publish saved update =
          let val current = metadata () val _ = spend 1
          in if Portable.pointer_eq (saved,current) then update () else () end
        (* Native output geometry already travels on its exact Edge,
           including its actual equality operands. Do not also publish
           every output through the general syntax table: that redundant
           routing/insertion programme served the same future input twice.
           Non-edge syntax still uses the full fresh table path below. *)
        (* Borrow Type argument spines; name bytes precede comparisons.
           This callback-free preparation may see the same immutable Type
           DAG at every compact node. Memoize inspection, NOT incidence:
           each parent still adds the full weight of each argument slot.
           The memo never escapes this prepare or supplies native credit. *)
        (* As with term metadata above, a bounded public-metadata hash
           only routes pointer probes. Never hash the expanded Type DAG
           or treat a hash collision as equality. Sample both function
           arguments so ordinary arrow annotations do not all share the
           outer fun Tyop's bucket. No liveness/admission check is added. *)
        val _ = spend (2+128)
        val type_weights = Array.array
          (127,[] : (Type.hol_type * IntInf.int) list)
        fun type_hash depth ty =
          (spend 2;if Type.is_vartype ty then
             let val _ = spend 3
                 val name = Type.dest_vartype ty
                 val _ = spend (6*String.size name)
             in CharVector.foldl
               (fn (c,h) => Word.+ (Word.* (h,0w33),
                 Word.fromInt (Char.ord c))) 0w17 name end
           else
             let val _ = spend 4
                 val {Tyop,Args,...} = Type.dest_thy_typeid ty
                 val code = Word.fromInt (KernelSig.epoch_of Tyop)
             in if depth=0 then (spend 1;code) else
               let
                 (* Inspect at most two slots at each bounded level;
                    the complete argument spine is still weighed below. *)
                 fun sample [] = (spend 1;0w19)
                   | sample (child::_) =
                       (spend 2;type_hash (depth-1) child)
                 val _ = spend 1
                 val (left,right) = case Args of
                     [] => (spend 1;(0w17,0w19))
                   | child::rest =>
                       (spend 2;(type_hash (depth-1) child,sample rest))
                 val _ = spend 4
               in Word.+ (Word.* (code,0w37),
                    Word.+ (Word.* (left,0w17),right)) end
             end)
        (* A bounded exact-pointer front view avoids re-running the
           recursive routing hash for frequent arrow annotations. Every
           parent still adds the entire annotation incidence below. *)
        val _=spend 8
        val recent_types=ref ([] : (Type.hol_type * IntInf.int) list)
        val recent_type_count=ref 0
        (* Fresh shallow annotations cannot benefit from building another
           routing hash/table entry. Inspect their complete actual forest
           directly. Deep Types retain the shared-DAG table below. This
           bounded attempt neither limits Types nor supplies native credit;
           every argument slot still contributes its full repeated weight. *)
        fun shallow_type depth ty =
          (spend 8;if Type.is_vartype ty then
             let val _=spend 4
                 val bytes=String.size (Type.dest_vartype ty)
                 val _=spend bytes
             in SOME (plus 1 (IntInf.fromInt bytes)) end
           else
             let val _=spend 4
                 val {Args,...}=Type.dest_thy_typeid ty
             in case Args of []=>SOME 1
               | _=>if depth=0 then NONE
                    else shallow_arguments (depth-1) Args 1 end)
        and shallow_arguments depth [] total = (spend 2;SOME total)
          | shallow_arguments depth (ty::rest) total =
              (spend 6;case shallow_type depth ty of NONE=>NONE
               | SOME n=>shallow_arguments depth rest (plus total n))
        fun type_weight ty =
          (* Atomic immutable geometry is cheaper to read than to hash or
             memoize. Every annotation incidence still adds its FULL size;
             this is not a Type check or native admission exemption. *)
          (spend 2;if Type.is_vartype ty then
             let val _ = spend 4
                 val bytes = String.size (Type.dest_vartype ty)
                 val _ = spend bytes
             in plus 1 (IntInf.fromInt bytes) end
           else
             let val _ = spend 4
                 val {Args,...} = Type.dest_thy_typeid ty
             in case Args of [] => 1
               | _ =>
                 let
                   val _=spend 2
                   val recent=lookup_rows ty (!recent_types)
                 in case recent of SOME amount=>amount | NONE=>
                   let
                     val amount=case shallow_arguments 1 Args 1 of
                         SOME amount=>amount
                       | NONE=>
                         let val hash=type_hash 2 ty val _=spend 3
                             val index=Word.toInt (Word.mod (hash,0w127))
                             val _=spend 1
                             val found=lookup_rows ty
                               (Array.sub (type_weights,index))
                         in case found of SOME amount=>(spend 1;amount)
                           | NONE=>
                             let val _=spend 1
                                 fun arguments [] total=(spend 1;total)
                                   | arguments (child::rest) total=
                                       (spend 2;arguments rest
                                         (plus total (type_weight child)))
                                 val amount=arguments Args 1
                                 val _=insert type_weights index ty amount
                             in amount end
                         end
                     val _=spend 2
                     val _=if !recent_type_count<8 then
                         (spend 6;recent_types:=(ty,amount):: !recent_types;
                          recent_type_count:= !recent_type_count+1) else ()
                   in amount end
                 end
             end)
        fun profile_uncached term : primitive_profile =
          let val _ = spend 1
              val own = type_weight (Term.type_of term)
          in if Term.is_comb term then
              let val _ = spend 1 val (a,b) = Term.dest_comb term
                  val left = profile_uncached a
                  val right = profile_uncached b
              in {raw = plus 1 (plus (#raw left) (#raw right)),
                  inc = plus 1 (plus (#inc left) (#inc right)),
                  ann = plus own (plus (#ann left) (#ann right)),ty = own} end
             else if Term.is_abs term then
              let val _ = spend 1 val (binder,body) = Term.dest_abs term
                  val domain = type_weight (Term.type_of binder)
                  val result = profile_uncached body
              in {raw = plus 1 (#raw result),inc = plus 2 (#inc result),
                  ann = plus own (plus domain (#ann result)),ty = own} end
             else
              let val _ = if Term.is_var term then
                    spend (String.size (#1 (Term.dest_var term))) else ()
              in {raw = 1,inc = 1,ann = own,ty = own} end
          end
        fun profile_table term =
          let val saved as PrimitiveMetadata {profiles,...} = metadata ()
              val _ = spend 1
              val(index,found)=lookup profiles term
          in case found of SOME value => (spend 1;value)
            | NONE =>
                let val value = profile_uncached term
                    val _ = publish saved (fn () =>
                      insert profiles index term value)
                in value end
          end
        (* At most two native inputs and four equality operands. This
           fixed-size hot geometry view bypasses the 127-bucket table; it
           is not an unbounded list of theorems or hypotheses. *)
        val _ = spend 4
        val hot = ref ([]:primitive_term_data list)
        fun hot_find _ [] = (spend 1;NONE)
          | hot_find term ((data:primitive_term_data)::rest) =
              (spend 4;if Portable.pointer_eq(term,#term data) then
                 SOME data else hot_find term rest)
        fun remember data = (spend 3;hot := data :: !hot)
        fun profile term =
          (spend 2;case hot_find term (!hot) of
             SOME data => (spend 2;#value data)
           | NONE => profile_table term)
        fun term_data term : primitive_term_data =
          let val value=profile_table term
              val _=spend 6
          in {term=term,value=value,bytes=ref NONE} end
        fun equality (a:primitive_profile) (b:primitive_profile) =
          {raw = plus 3 (plus (#raw a) (#raw b)),
           inc = plus 3 (plus (#inc a) (#inc b)),
           ann = plus (plus 6 (times 3 (#ty a)))
             (plus (#ann a) (#ann b)),ty = 1} : primitive_profile
        fun application f x =
          let val _ = spend 1
              val output = #2 (Type.dom_rng (Term.type_of f))
              val own = type_weight output
              val a = profile f val b = profile x
          in {raw = plus 1 (plus (#raw a) (#raw b)),
              inc = plus 1 (plus (#inc a) (#inc b)),
              ann = plus own (plus (#ann a) (#ann b)),ty = own} end
        fun proof_list [] = []
          | proof_list (edge::rest) =
              (spend 2;theorem block edge :: proof_list rest)
        (* Reject malformed arity before constructing the bounded hot
           view. All seven accepted recipes keep their original rules. *)
        val _ = spend 8
        val arity = case recipe of ReflexiveName _ => 0
          | Symmetry => 1 | ApplyNamedArgument _ => 1 | _ => 2
        val _ = case (arity,premises) of (0,[]) => ()
          | (1,[_]) => () | (2,[_,_]) => ()
          | _ => raise ERR "prepare_primitive" "incorrect fixed recipe arity"
        val _ = tables_phase expected "primitive.profile.before"
          (fn () => "")
        val proofs = proof_list premises
        val edge_store as PrimitiveMetadata {edges,epoch,symbols,...} =
          metadata ()
        fun edge_data
            (edge as Edge {primitive=SOME(types,terms,data),...}) proof =
              (spend 12;if types=epoch andalso terms=symbols then data
               else edge_ordinal edge proof)
          | edge_data edge proof = (spend 2;edge_ordinal edge proof)
        and edge_ordinal
            (Edge {dependencies=Dependency(id,_),...}) proof =
          let
            (* Genuine block theorem ownership was checked by proof_list.
               No public theorem/ordinal pair reaches this function. The
               enclosing callback-free header/final guards stay fresh. *)
            val _=spend 24
            val old= !edges
            val size=Array.length old
            val rows=if id<size then old else
              let val size'=Int.max(id+1,2*size)
                  (* Array header/cells, all copied rows and loop events,
                     ref publication, scalar arithmetic and closures. *)
                  val _=spend 32
                  val _=spend size'
                  val _=spend size'
                  val _=spend size'
                  val _=spend (8*size)
                  val next=Array.array(size',NONE)
                  fun copy i=if i=size then () else
                    (Array.update(next,i,Array.sub(old,i));copy(i+1))
                  val _=copy 0
                  val _=edges:=next
              in next end
          in case Array.sub(rows,id) of
              SOME(held,data) =>
                if Portable.pointer_eq(held,proof) then data else
                  fresh_edge rows id proof
            | NONE => fresh_edge rows id proof
          end
        and fresh_edge rows id proof : primitive_edge_data =
          let val _=spend 32
              val data={conclusion=ref NONE,equation=ref NONE,
                implication=ref NONE,hypotheses=ref NONE}
              val _=Array.update(rows,id,SOME(proof,data))
          in data end
        fun input_data [] [] = (spend 1;[])
          | input_data (edge::tail) (proof::rest) =
              let val data:primitive_edge_data=edge_data edge proof
                  val _=spend 8
                  val root=case !(#conclusion data) of SOME value=>value
                    | NONE=>
                        let val value=term_data(Thm.concl proof)
                            val _=spend 3
                            val _= #conclusion data := SOME value
                        in value end
                  val _=remember root
                  val _=spend 4
              in (proof,data)::input_data tail rest end
          | input_data _ _ = raise ERR "prepare_primitive" "input arity"
        val inputs = input_data premises proofs
        fun input proof =
          let fun find [] = raise ERR "prepare_primitive" "foreign input"
                | find ((held,data)::rest) =
                    (spend 4;if Portable.pointer_eq(proof,held) then data
                     else find rest)
          in spend 2;find inputs end
        (* The fixed recipes below observe at most two genuine premise
           theorems. Keep their first actual equality operands within THIS
           prepare: standard lazy destructors may otherwise reopen them as
           fresh native objects when the later check shape is built. *)
        (* Two epoch reads, empty-list/ref setup and the new guard closure. *)
        val _ = spend 5
        val equation_epoch = Type.type_epoch ()
        val equation_symbols = Term.term_epoch ()
        fun equation_guard () =
          (primitive_work expected block;spend 2;
           (* The enclosing preparation retains its full entry/exit Scope
              guards; no callback can change it during this observation.
              Two epoch reads/comparisons and the actual branch. *)
           spend 5;
           if equation_epoch = Type.type_epoch () andalso
               equation_symbols = Term.term_epoch () then () else
             raise ERR "prepare_primitive" "native operand epochs changed")
        fun equation proof =
          let val _=equation_guard ()
              val data:primitive_edge_data=input proof
              val _=spend 8
              val (a,b)=case !(#equation data) of SOME parts=>parts
                | NONE=>
                    let val _=spend 4
                        val (a,b)=boolSyntax.dest_eq(Thm.concl proof)
                        val parts=(term_data a,term_data b)
                        val _=equation_guard ()
                        val _=spend 4
                        val _= #equation data := SOME parts
                    in parts end
              (* One installation per use, not per shape/profile query. *)
              val _=spend 2
              val _=if Option.isSome(hot_find (#term a) (!hot)) then ()
                else remember a
              val _=if Option.isSome(hot_find (#term b) (!hot)) then ()
                else remember b
              val _=spend 3
          in (#term a,#term b) end
        fun implication proof =
          let val _=equation_guard ()
              val data:primitive_edge_data=input proof
              val _=spend 8
              val right=case !(#implication data) of SOME value=>value
                | NONE=>
                    let val _=spend 3
                        val (_,term)=boolSyntax.dest_imp_only(Thm.concl proof)
                        val value=term_data term
                        val _=equation_guard ()
                        val _=spend 3
                        val _= #implication data := SOME value
                    in value end
              val _=spend 2
              val _=if Option.isSome(hot_find (#term right) (!hot)) then ()
                else remember right
          in #term right end
        fun equation_result a b = (spend 4;(equality a b,SOME(a,b)))
        val (result,result_equation) = case (recipe,proofs) of
            (ReflexiveName node,[]) =>
              let val operand = profile (name block node)
              in equation_result operand operand end
          | (Symmetry,[proof]) =>
              let val (a,b) = equation proof
              in equation_result (profile b) (profile a) end
          | (Transitivity,[left,right]) =>
              let val (a,_) = equation left val (_,c) = equation right
              in equation_result (profile a) (profile c) end
          | (Congruence,[left,right]) =>
              let val (a,b) = equation left val (x,y) = equation right
              in equation_result (application a x) (application b y) end
          | (EqualityMP,[equality,proof]) =>
              let val (_,right) = equation equality
              in (profile right,NONE) end
          | (ApplyNamedArgument node,[proof]) =>
              let val (a,b) = equation proof val x = name block node
              in equation_result (application a x) (application b x) end
          | (ImplicationMP,[law,_]) =>
              (profile (implication law),NONE)
          | _ => raise ERR "prepare_primitive" "incorrect fixed recipe arity"
        (* Same existing RAW guard boundary. Inclusive/annotation incidence
           is Work, not a new syntax limit or caller cap override. *)
        val _ = tables_phase expected "primitive.profile.after"
          (fn () => "")
        val _ = if #raw result <= cap then () else
          raise ERR "prepare_primitive" "expanded compact proof template"
        fun weight (value:primitive_profile) =
          plus (#raw value) (plus (#inc value) (#ann value))
        val _ = spend 4
        val common_quoted = ref false
        val common_term = context block
        val zero:primitive_profile={raw=0,inc=0,ann=0,ty=0}
        fun sum (a:primitive_profile) (b:primitive_profile)
            : primitive_profile =
          {raw=plus (#raw a) (#raw b),inc=plus (#inc a) (#inc b),
           ann=plus (#ann a) (#ann b),ty=plus (#ty a) (#ty b)}
        fun maximum (a:primitive_profile) (b:primitive_profile)
            : primitive_profile =
          {raw=IntInf.max(#raw a,#raw b),inc=IntInf.max(#inc a,#inc b),
           ann=IntInf.max(#ann a,#ann b),ty=IntInf.max(#ty a,#ty b)}
        (* Pure DATA constructor. Its actual input is certified native
           Hyp, never a candidate union. Source misses prepay each entry;
           the native suffix prepays count*128 plus setup below. No hidden
           payer, fresh quota or policy callback runs in this constructor. *)
        fun make_hyp_summary entries admitted =
          let
            fun walk [] reversed unique without all one none count others
                common cw full noncommon high : primitive_hyp_data =
                  {reversed=reversed,unique=unique,without=without,
                   entries=all,unique_entries=one,without_entries=none,
                   count=count,others=others,common=common,
                   common_weight=cw,full=full,noncommon=noncommon,
                   maximum=high,admitted=ref admitted}
              | walk ((entry:primitive_term_data)::rest) reversed unique
                  without all one none count others common cw full
                  noncommon high =
                  let val term= #term entry val value= #value entry
                      val full'=sum full value
                      val high'=maximum high value
                  in if Portable.pointer_eq(term,common_term) then
                      walk rest (term::reversed)
                        (if common then unique else term::unique) without
                        (entry::all) (if common then one else entry::one)
                        none (count+1) others true (weight value)
                        full' noncommon high'
                    else walk rest (term::reversed) (term::unique)
                      (term::without) (entry::all) (entry::one) (entry::none)
                      (count+1) (others+1) common cw
                      full' (sum noncommon value) high'
                  end
          in walk entries [] [] [] [] [] [] 0 0 false 0 zero zero zero end
        fun summarize proof (data:primitive_edge_data) =
          (spend 8;case !(#hypotheses data) of SOME value=>value
           | NONE=>
             let
               (* Only original/non-native producers reach this miss.
                  Their authentic theorem is owner checked above. *)
               val _=spend 64
               fun entries [] = (spend 2;[])
                 | entries (term::rest) =
                     (spend 160;term_data term :: entries rest)
               val value=make_hyp_summary (entries (Thm.hyp proof)) NONE
               val _=spend 4
               val _= #hypotheses data := SOME value
             in value end)
        fun summaries [] = (spend 1;[])
          | summaries ((proof,data)::rest) =
              (spend 5;summarize proof data :: summaries rest)
        fun hypotheses [] total = (spend 1;total)
          | hypotheses ((data:primitive_hyp_data)::rest) total =
              let val _=spend 24
                  val extra=if #common data andalso not(!common_quoted)
                    then (common_quoted:=true;#common_weight data) else 0
              in hypotheses rest
                (plus total (plus (weight(#noncommon data)) extra)) end
        (* This boundary owns its actual future result/Hyp portfolio. An
           earlier Core reservation is not an external allowance or credit.
           The result Hyp is a union: the pointer-identical authentic
           common context occurs at most once. Quote its FULL geometry
           once, not once per premise. Other candidates remain conservative
           (even alpha-equivalent/cloned contexts); no syntax comparison or
           cross-rule credit is used. Raw/inclusive/type work is debited
           BEFORE the first kernel rule. The original candidate list and
           the complete result/Hyp checks below are unchanged. *)
        val _ = tables_phase expected "primitive.hyp.forecast.before"
          (fn () => "")
        val hypothesis_data = summaries inputs
        (* Every use, including a geometry hit, pays the FULL native
           raw/inclusive/annotation incidence. This is never Work credit. *)
        val quote = hypotheses hypothesis_data (plus 1 (weight result))
        val _ = tables_phase expected "primitive.hyp.debit.before"
          (fn () => " amount=" ^ IntInf.toString quote ^
            " result.raw=" ^ IntInf.toString (#raw result) ^
            " result.inc=" ^ IntInf.toString (#inc result) ^
            " result.ann=" ^ IntInf.toString (#ann result) ^
            " common=" ^ Bool.toString (!common_quoted))
        val remaining = IntInf.fromInt
          (W.work_limit expected - #charged (W.audit expected))
        val _ = if quote <= remaining then W.spend expected (IntInf.toInt quote)
          else raise ERR "prepare_primitive"
            "fixed result/Hyp portfolio exceeds original remaining Work"
        val _ = tables_phase expected "primitive.hyp.debit.after"
          (fn () => "")
        (* These private instructions are derived only from THIS recipe
           and its retained genuine premise proofs. No caller syntax or
           external completed-guard credit is accepted. All constructors
           of the instruction program are charged before allocation. *)
        fun held term = (spend 1;HeldSyntax term)
        fun eq a b = (spend 1;EqualitySyntax (a,b))
        fun app a b = (spend 1;ApplicationSyntax (a,b))
        val shape = case (recipe,proofs) of
            (ReflexiveName node,[]) =>
              let val operand = held (name block node) in eq operand operand end
          | (Symmetry,[proof]) =>
              let val (a,b) = equation proof in eq (held b) (held a) end
          | (Transitivity,[left,right]) =>
              let val (a,_) = equation left val (_,c) = equation right
              in eq (held a) (held c) end
          | (Congruence,[left,right]) =>
              let val (a,b) = equation left val (x,y) = equation right
              in eq (app (held a) (held x)) (app (held b) (held y)) end
          | (EqualityMP,[equality,_]) => held (#2 (equation equality))
          | (ApplyNamedArgument node,[proof]) =>
              let val (a,b) = equation proof val x = name block node
              in eq (app (held a) (held x)) (app (held b) (held x)) end
          | (ImplicationMP,[law,_]) =>
              held (implication law)
          | _ => raise ERR "prepare_primitive" "incorrect fixed recipe arity"
        val (names,common,limit) = case block of
          Block {owned_names = SOME names,context,template_limit,...} =>
            (names,context,template_limit)
        | _ => raise ERR "prepare_primitive" "missing owned naming plan"
        val _ = fixed_names_guard expected names
        fun admit_operand term =
          let val saved as PrimitiveMetadata {operands,...} = metadata ()
              val _ = spend 1
              val(index,found)=lookup operands term
              val _ = spend 1
          in if found=SOME limit then () else
              (fixed_guard_operand_using spend metadata_pay
                 expected names limit term;
               publish saved (fn () =>
                 insert operands index term limit))
          end
        fun admit top instruction =
          (spend 1;case instruction of HeldSyntax term =>
             if top andalso Portable.pointer_eq (term,common) then () else
               admit_operand term
           | EqualitySyntax (a,b) => (admit false a;admit false b)
           | ApplicationSyntax (a,b) => (admit false a;admit false b))
        val _ = admit true shape
        (* Keep the original candidate order/aliases, but borrow cached
           immutable list SEGMENTS instead of rebuilding a flattened list.
           A two-input recipe removes only repeated authentic common
           pointers, exactly as common_hypotheses_using did before. *)
        val _=spend 12
        fun collect [] _ segments count = (spend 2;(segments,count))
          | collect ((data:primitive_hyp_data)::rest) seen segments count =
              let val _=spend 24
                  val keep= #common data andalso not seen
                  val terms=if arity=2 then
                      (if seen then #without_entries data
                       else #unique_entries data)
                    else #entries data
                  val n=if arity=2 then #others data+
                      (if keep then 1 else 0) else #count data
              in collect rest (seen orelse #common data)
                (terms::segments) (count+n) end
        val (candidates,candidate_count)=collect hypothesis_data false [] 0
        val PrimitiveMetadata {revision=admission_revision,...}=edge_store
        fun admit_hypotheses (data:primitive_hyp_data) =
          let
            (* Fresh original owner/name guard BEFORE permission flags.
               Only actual name-class admission is memoized per revision;
               no lifetime, policy, observer or Scope result is cached. *)
            val _=fixed_names_guard expected names
            val _=spend 12
          in if !(#admitted data)=SOME admission_revision then () else
              let fun visit [] = spend 1
                    | visit (term::rest) =
                        (spend 4;
                         if Portable.pointer_eq(term,common) then () else
                           admit_operand term;
                         visit rest)
                  val _=visit (#reversed data)
                  val _=spend 4
                  val _= #admitted data := SOME admission_revision
              in () end
          end
        val _=List.app admit_hypotheses hypothesis_data
        val _ = tables_phase expected "primitive.admission.after"
          (fn () => " candidates=" ^ IntInf.toString candidate_count)
        (* The trusted fixed rules only retain/union premise hypotheses.
           The result check tests the actual union against retained input
           pointers. At most N hypotheses and N candidates per search; the
           N-square envelope is computed from the real candidate list. *)
        (* Repeated standard-kernel equality destruction can produce
           distinct lazy operand objects. A pointer cut is only a fast
           path. Price the genuine held syntax/type/name forest first for
           a possible alpha comparison; never refuse an admitted binder or
           cloned/lazy operand merely for lacking physical identity.
           Kernel-private Clos/Subst forcing remains explicitly unpriced. *)
        fun term_bytes_uncached term =
          let val _ = spend 1
          in if Term.is_var term then
              let val bytes = String.size (#1 (Term.dest_var term))
                  val _ = spend bytes
              in IntInf.fromInt bytes end
             else if Term.is_comb term then
              let val _ = spend 1 val (a,b) = Term.dest_comb term
              in plus (term_bytes_uncached a) (term_bytes_uncached b) end
             else if Term.is_abs term then
              let val _ = spend 1 val (binder,body) = Term.dest_abs term
              in plus (term_bytes_uncached binder)
                (term_bytes_uncached body) end
             else 0 end
        fun term_bytes_table term =
          let val saved as PrimitiveMetadata {bytes,...} = metadata ()
              val _ = spend 1
              val(index,found)=lookup bytes term
          in case found of SOME value => (spend 1;value)
            | NONE =>
                let val value = term_bytes_uncached term
                    val _ = publish saved (fn () =>
                      insert bytes index term value)
                in value end
          end
        fun term_bytes term =
          (spend 4;case hot_find term (!hot) of
             NONE=>term_bytes_table term
           | SOME (data:primitive_term_data)=>
               (spend 5;case !(#bytes data) of SOME value=>value
                | NONE=>let val value=term_bytes_table term
                            val _=spend 4
                            val _= #bytes data := SOME value
                        in value end))
        fun check_work (HeldSyntax term) =
              if Thm.kernelid = "stdknl" then
                plus 1 (times 2
                  (plus (weight (profile term)) (term_bytes term)))
              else 1
          | check_work (EqualitySyntax (a,b)) =
              plus 8 (plus (check_work a) (check_work b))
          | check_work (ApplicationSyntax (a,b)) =
              plus 4 (plus (check_work a) (check_work b))
        fun tags [] total = total
          | tags (proof::rest) total =
            let val _ = spend 1
                val (oracles,_) = Tag.dest_tag (Thm.tag proof)
                fun names [] amount = amount
                  | names (name::tail) amount =
                    (spend 1;names tail
                      (amount + IntInf.fromInt (10+String.size name)))
            in tags rest (names oracles total) end
        (* Three future one-shot events: ref read, branch, write. Six
           dependency events: Union, counter read/add/write, Dependency,
           and Edge. Scope/closure guard internals remain separately open. *)
        (* Additional fixed future metadata: actual conclusion read,
           tuple/SOME/ref write (4), and one failure cleanup write (1).
           There is no post-native Work spend or unquoted hash traversal. *)
        val _ = tables_phase expected "primitive.future.forecast.before"
          (fn () => "")
        (* Keep the original matcher/Hyp/tag envelope. Extra fixed224
           pays actual-AST/result-cache binding and summary setup. Each
           candidate reserves128 for <=2 segment probes, witness/list
           creation and the actual-Hyp summary (<=actual output count).
           This is fresh payment on EVERY use, including geometry hits. *)
        val segment_carrier = 224 + 128*candidate_count
        val future = check_work shape + candidate_count *
          (candidate_count+2) + tags proofs 2 + 9 + 5 + segment_carrier
        val _ = tables_phase expected "primitive.future.debit.before"
          (fn () => " amount=" ^ IntInf.toString future)
        val _ = pay expected future
        val _ = tables_phase expected "primitive.future.debit.after"
          (fn () => "")
        fun dependency_inputs [] = []
          | dependency_inputs (Edge {dependencies,...}::tail) =
              (spend 3;dependencies::dependency_inputs tail)
        val dependencies = dependency_inputs premises
        (* The original N-square membership search now returns the exact
           retained geometry witness. It neither compares Types nor opens
           Terms. Build output DATA only from the actual certified Hyp. *)
        fun retained_entry term [] = NONE
          | retained_entry term ((entry:primitive_term_data)::rest) =
              if Portable.pointer_eq(term,#term entry) then SOME entry
              else retained_entry term rest
        fun retained_segments term [] = NONE
          | retained_segments term (segment::rest) =
              (case retained_entry term segment of SOME entry=>SOME entry
               | NONE=>retained_segments term rest)
        fun certify_hypotheses actual =
          let fun entries [] = []
                | entries (term::rest) =
                    (case retained_segments term candidates of
                       SOME entry=>entry::entries rest
                     | NONE=>raise ERR "compose"
                         "invalid common-context proof")
          in make_hyp_summary (entries actual) (SOME admission_revision) end
        val _ = fixed_names_guard expected names
        val _ = active block
        val _ = spend 2
        val _ = tables_phase expected "primitive.guards.after"
          (fn () => "")
      in PrimitivePlan {work = expected,block = block,recipe = recipe,
        premises = premises,proofs = proofs,result = result,
        result_equation=result_equation,shape = shape,
        hypotheses = candidates,certify_hypotheses=certify_hypotheses,
        dependencies = dependencies,
        epoch=epoch,symbols=symbols,used = ref false} end)
     handle primary =>
       (clear_primitive_metadata expected block;W.close expected;
        raise primary))
  fun execute_primitive expected (PrimitivePlan
      {work,block,recipe,proofs,result,result_equation,shape,dependencies,
       certify_hypotheses,epoch,symbols,used,...}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "execute_primitive" "different original Work";
      primitive_work expected block;W.spend expected 0;active block;
      if !used then raise ERR "execute_primitive" "plan already executed"
        else used := true;
      let
        val names = case block of
          Block {owned_names = SOME value,...} => value
        | _ => raise ERR "execute_primitive" "missing owned naming plan"
        val _ = fixed_names_guard expected names
        val Block {graph,...} = block
        val _ = observe_proof graph #fixed
        val proof = case (recipe,proofs) of
            (ReflexiveName node,[]) =>
              SmtReplayRuleObservation.REFL (name block node)
          | (Symmetry,[proof]) => SmtReplayRuleObservation.SYM proof
          | (Transitivity,[left,right]) =>
              SmtReplayRuleObservation.TRANS left right
          | (Congruence,[left,right]) =>
              SmtReplayRuleObservation.MK_COMB (left,right)
          | (EqualityMP,[equality,proof]) =>
              SmtReplayRuleObservation.EQ_MP equality proof
          | (ApplyNamedArgument node,[proof]) =>
              SmtReplayRuleObservation.AP_THM proof (name block node)
          | (ImplicationMP,[law,premise]) =>
              SmtReplayRuleObservation.MP law premise
          | _ => raise ERR "execute_primitive" "incorrect fixed recipe arity"
        (* Already paid known shells and genuine operand alpha forests.
           Experimental constructors/destructors retain exact operand
           objects. Standard lazy destructors need not preserve physical
           objects across reads and use the reserved alpha fallback. No
           experimental binder-environment comparator is silently priced
           by a linear forest count. Hidden standard closure/equality work
           remains explicit; no kernel-machine envelope is asserted. *)
        fun matches (HeldSyntax held) actual =
              Portable.pointer_eq (held,actual) orelse
              (Thm.kernelid = "stdknl" andalso Term.aconv held actual)
          | matches (ApplicationSyntax (a,b)) actual =
              Term.is_comb actual andalso
              let val (left,right) = Term.dest_comb actual
              in matches a left andalso matches b right end
          | matches (EqualitySyntax (a,b)) actual =
              Term.is_comb actual andalso
              let val (head,right) = Term.dest_comb actual
              in Term.is_comb head andalso
                let val (operator,left) = Term.dest_comb head
                in Term.is_const operator andalso
                  Term.same_const operator boolSyntax.equality andalso
                  matches a left andalso matches b right end end
        val _ = if matches shape (Thm.concl proof) andalso clean proof
          then () else raise ERR "compose" "invalid common-context proof"
        val actual_hypotheses = certify_hypotheses (Thm.hyp proof)
        (* Bind geometry to THIS actual kernel AST, only after actual
           shape/tag/Hyp certification. Do not retain speculative operand
           pointers, alpha-observer results or predicted spelling bytes. *)
        val actual_equation = case result_equation of NONE=>NONE
          | SOME(a,b)=>
              let val (left,right)=boolSyntax.dest_eq(Thm.concl proof)
              in SOME({term=left,value=a,bytes=ref NONE},
                      {term=right,value=b,bytes=ref NONE}) end
        val result_data : primitive_edge_data =
          {conclusion=ref(SOME{term=Thm.concl proof,value=result,
             bytes=ref NONE}),equation=ref actual_equation,
           implication=ref NONE,hypotheses=ref(SOME actual_hypotheses)}
        val _ = fixed_names_guard expected names
        val _ = active block
        val Block {owner,...} = block
        val dependency = new_dependency block (Union dependencies)
        val edge = Edge
          {owner = owner,theorem = proof,dependencies = dependency,
           primitive=SOME(epoch,symbols,result_data)}
      in observe_proof graph #edges;edge end)
     handle primary =>
       (clear_primitive_metadata expected block;W.close expected;
        raise primary))

  (* Closed C schemas contain no binders. Their actual holes are variables,
     and INST replaces them only by the authentic typed names of this block.
     Keep the output as private syntax instructions, not a caller quotation.
     Old checked/primitive APIs and their supported binder cases are intact. *)
  datatype named_inst_shape = datatype SmtReplayNamedContext.named_inst_shape
  datatype closed_named_inst_plan = ClosedNamedInstPlan of
    {work:W.portfolio,block:block,theorem:Thm.thm,
     substitution:(Term.term,Term.term) Lib.subst,shape:named_inst_shape,
     oracles:string list,epoch:int,symbols:int,used:bool ref}

  fun prepare_closed_named_inst expected
      (block as Block {owned_names,template_limit,...})
      {substitution,theorem} =
    ((primitive_work expected block;W.spend expected 0;active block;
      let
        val names = case owned_names of SOME held => held | NONE =>
          raise ERR "prepare_closed_named_inst" "missing owned name plan"
        val _ = fixed_names_guard expected names
        fun spend n = W.spend expected n
        fun type_work ty =
          let
            (* Borrow actual Type argument spines. Queue/cons allocations,
               public tests/destructors and variable-name bytes are paid.
               Kernel-private lazy type_of/INST helpers remain separate. *)
            fun walk [] count = count
              | walk (pending::more) count =
                (spend 1;case pending of [] => walk more count
                 | ty::rest =>
                   let val _ = spend 1
                       val variable = Type.is_vartype ty
                   in if variable then
                        let val _ = spend 2
                            val text = Type.dest_vartype ty
                            val bytes = String.size text
                            val _ = spend bytes
                            val _ = spend 1
                        in walk (rest::more)
                             (count+IntInf.fromInt (1+bytes)) end
                      else
                        let val _ = spend 4
                            val {Thy,Tyop,Args} = Type.dest_thy_type ty
                            val bytes = String.size Thy + String.size Tyop
                            val _ = spend bytes
                            val _ = spend 2
                        in walk (Args::rest::more)
                             (count+IntInf.fromInt (1+bytes)) end
                   end)
            val _ = spend 2
          in walk [[ty]] (0:IntInf.int) end
        fun same_type left right =
          let val a = type_work left val b = type_work right
              val _ = pay expected (1+a+b)
          in Type.compare (left,right) = EQUAL end
        fun var_data term =
          (spend 2;
           if Term.is_var term then Term.dest_var term else
             raise ERR "prepare_closed_named_inst"
               "schema substitution must be variable to named variable")
        fun same_variable (name,ty) (other,wanted) =
          (spend (String.size name + String.size other + 1);
           name = other andalso same_type ty wanted)
        fun validate_substitution [] = ()
          | validate_substitution ({redex,residue}::rest) =
            let val _ = spend 1
                val source = var_data redex
                val target = var_data residue
                val _ = if same_type (#2 source) (#2 target) then () else
                  raise ERR "prepare_closed_named_inst"
                    "different schema substitution types"
                val _ = if fixed_names_member expected names residue then ()
                  else raise ERR "guard" "unowned compact variable"
                fun coherent [] = ()
                  | coherent ({redex,residue}::tail) =
                    (spend 1;
                     if same_variable source (var_data redex) andalso
                         not (same_variable target (var_data residue)) then
                       raise ERR "prepare_closed_named_inst"
                         "conflicting repeated schema hole"
                     else coherent tail)
                val _ = coherent rest
            in validate_substitution rest end
        val _ = validate_substitution substitution
        val _ = spend 2
        val input = Thm.concl theorem
        val hypotheses = Thm.hyp theorem
        val _ = if null hypotheses then () else
          raise ERR "prepare_closed_named_inst" "schema is not closed"
        val _ = spend 2
        val tag = Thm.tag theorem
        val (oracles,_) = Tag.dest_tag tag
        val _ = spend 1
        val _ = if null (Tag.axioms_of tag) then () else
          raise ERR "prepare_closed_named_inst" "unexpected schema axioms"
        fun oracle_work [] amount = amount
          | oracle_work (oracle::rest) amount =
            let val _ = spend 1
                val _ = spend (String.size oracle + 9)
                val _ = if oracle = "DISK_THM" then () else
                  raise ERR "prepare_closed_named_inst" "unexpected schema tag"
            in oracle_work rest
                 (amount + 2*IntInf.fromInt (String.size oracle) + 3) end
        val tag_work = oracle_work oracles (5:IntInf.int)
        (* Same size-first order as the compact guard. No output or Type
           work is inferred from a caller coefficient or constructed Term. *)
        fun raw [] count = count
          | raw (current::rest) count =
            (spend 1;
             if count >= template_limit then
               raise ERR "guard" "expanded compact proof template"
             else
               let val _ = spend 1
               in if Term.is_comb current then
                    let val _ = spend 4
                        val (left,right) = Term.dest_comb current
                    in raw (left::right::rest) (count+1) end
                  else
                    (spend 1;
                     if Term.is_abs current then
                       raise ERR "prepare_closed_named_inst"
                         "binder schema requires a bounded local proof block"
                     else raw rest (count+1))
               end)
        val _ = spend 1
        val raw_nodes = raw [input] 0
        fun replacement source [] = NONE
          | replacement source ({redex,residue}::rest) =
            (spend 1;
             if same_variable source (var_data redex) then SOME residue
             else replacement source rest)
        (* Profile every actual input annotation and the corresponding
           future output annotation. Variable replacements preserve Type
           exactly; constants/apps are untouched. Pay future local matches
           before INST, including equal-name cloned variable comparisons. *)
        fun derive current =
          let val _ = spend 2
              val ty = Term.type_of current
              val annotation = type_work ty
              val _ = pay expected (1+annotation)
              val _ = spend 1
          in if Term.is_var current then
              let val source = var_data current
                  val output = case replacement source substitution of
                      SOME residue => residue | NONE => current
                  val _ = if fixed_names_member expected names output then ()
                    else raise ERR "guard" "unowned compact variable"
                  val (name,wanted) = var_data output
                  val _ = pay expected
                    (7+2*IntInf.fromInt (String.size name)+2*annotation)
                  val _ = spend 1
              in NamedInstVariable (name,wanted) end
             else if Term.is_comb current then
              let val _ = spend 2
                  val (left,right) = Term.dest_comb current
                  val a = derive left val b = derive right
                  val _ = pay expected (6+2*annotation)
                  val _ = spend 1
              in NamedInstApplication (a,b) end
             else
              let val _ = spend 1
                  val _ = if Term.is_const current then () else
                    raise ERR "prepare_closed_named_inst"
                      "unknown closed schema syntax"
                  val _ = spend 3
                  val {Thy,Name,...} = Term.dest_thy_const current
                  val bytes = IntInf.fromInt (String.size Thy) +
                    IntInf.fromInt (String.size Name)
                  val _ = pay expected (6+2*annotation+2*bytes)
                  val _ = spend 1
              in NamedInstConstant (current,ty) end
          end
        val shape = derive input
        (* Output Raw/Inclusive equal the measured binder-free input, not
           an expanded graph coefficient. Repeated annotation debit above
           is cumulative and independent of the syntax cap. *)
        val _ = pay expected (2*IntInf.fromInt raw_nodes)
        (* Future INST call, read/branch/write, exact empty-Hyp/tag/result
           checks, six empty Leaves/counter/Dependency/Edge events. *)
        val _ = pay expected (1+tag_work+3+3+6)
        val _ = fixed_names_guard expected names
        val _ = active block
        val _ = spend 2
      in ClosedNamedInstPlan {work=expected,block=block,theorem=theorem,
        substitution=substitution,shape=shape,oracles=oracles,
        epoch=Type.type_epoch (),symbols=Term.term_epoch (),
        used=ref false} end)
     handle primary => (W.close expected;raise primary))

  fun execute_closed_named_inst expected (ClosedNamedInstPlan
      {work,block,theorem,substitution,shape,oracles,epoch,symbols,used}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "execute_closed_named_inst" "different original Work";
      primitive_work expected block;W.spend expected 0;active block;
      if !used then raise ERR "execute_closed_named_inst"
        "schema INST plan already executed" else used := true;
      let
        val Block {owner,graph,owned_names,...} = block
        val names = case owned_names of SOME held => held | NONE =>
          raise ERR "execute_closed_named_inst" "missing owned name plan"
        val _ = fixed_names_guard expected names
        val _ = if Type.type_epoch () = epoch andalso
            Term.term_epoch () = symbols then () else
          raise ERR "execute_closed_named_inst" "schema epochs changed"
        (* Exact same original variable-only INST. No P.checked, import,
           Hyp lookup, FVL/HOLset query or external proof callback follows. *)
        val proof = SmtReplayRuleObservation.INST substitution theorem
        fun matches (NamedInstVariable (name,ty)) actual =
              Term.is_var actual andalso
              let val (other,wanted) = Term.dest_var actual
              in name = other andalso Type.compare (ty,wanted) = EQUAL end
          | matches (NamedInstConstant (held,ty)) actual =
              Term.is_const actual andalso Term.same_const held actual andalso
              Type.compare (ty,Term.type_of actual) = EQUAL
          | matches (NamedInstApplication (a,b)) actual =
              Term.is_comb actual andalso
              let val (left,right) = Term.dest_comb actual
              in matches a left andalso matches b right end
        val result_tag = Thm.tag proof
        val _ = if null (Thm.hyp proof) andalso
            null (Tag.axioms_of result_tag) andalso
            #1 (Tag.dest_tag result_tag) = oracles andalso
            matches shape (Thm.concl proof) then () else
          raise ERR "execute_closed_named_inst" "closed schema result changed"
        val _ = fixed_names_guard expected names
        val _ = active block
        val dependency = new_dependency block (Leaves [])
      in observe_proof graph #edges;
         Edge {owner=owner,theorem=proof,dependencies=dependency,
           primitive=NONE} end)
     handle primary => (W.close expected;raise primary))

  fun constructor (block as Block {graph, ...}) node =
    (policy_legacy_block_only "constructor" block;
     case G.view graph node of
      G.Constant _ => definition block node
    | G.Application (operator, operand) =>
        compose block
          (fn [equation, operator] => SmtReplayRuleObservation.TRANS equation
              (SmtReplayRuleObservation.AP_THM operator (name block operand))
            | _ => raise ERR "constructor" "incorrect spine premises")
          [definition block node, constructor block operator]
    | _ => checked block (SmtReplayRuleObservation.REFL (name block node)))

  (* A private prospective programme over genuine SAME-block inputs.
     Neither a path nor a forecast token can construct an edge. *)
  structure BP = SmtReplayNamedContext
  datatype projection_instruction = ProjectionInput of edge * Thm.thm
    | ProjectionTruth
    | ProjectionFixed of Term.term BP.primitive * int list
    | ProjectionBoolean of Term.term BP.boolean_rule * int list
  datatype projection_step = ProjectionStep of
    {instruction:projection_instruction,shape:BP.shape,
     candidates:Term.term list,dependency:dependency}
  datatype boolean_projection_plan = BooleanProjectionPlan of
    {work:W.portfolio,block:block,steps:projection_step vector,
     result:int,epoch:int,symbols:int,used:bool ref}
  fun prepare_boolean_projection expected block {target,premises} =
    ((primitive_work expected block;W.spend expected 0;active block;
      policy_legacy_block_only "prepare_boolean_projection" block;
      let
        val Block {graph,scope,owned_names,context=common,
          template_limit=limit,...}=block
        val names=case owned_names of SOME held=>held | NONE=>
          raise ERR "prepare_boolean_projection" "missing owned names"
        (* New local closures/records and actual inspector setup, not a
           native allowance or a substitute for its observed scans. *)
        val _=W.spend expected 64
        val epoch=Type.type_epoch () val symbols=Term.term_epoch ()
        val limits=W.semantic_limits expected
        val ceiling=IntInf.fromInt(W.work_limit expected)
        val cap=IntInf.fromInt limit
        fun fail message=raise ERR "prepare_boolean_projection" message
        fun guard ()=
          (primitive_work expected block;W.spend expected 0;active block;
           fixed_names_guard expected names;W.spend expected 5;
           if epoch=Type.type_epoch () andalso
               symbols=Term.term_epoch () then ()else
             fail "native declaration lifetime changed")
        fun spend n=W.spend expected n
        fun debit n=pay expected n
        fun weight(p:BP.profile)= #raw p+ #inc p+ #ann p
        fun type_work ty=BP.type_weight_using debit
          (ERR "prepare_boolean_projection") ceiling ty
        fun same_type a b=
          let val x=type_work a val y=type_work b
              val _=debit(1+x+y)
          in Type.compare(a,b)=EQUAL end
        fun owned term=fixed_names_member expected names term
        val admission:BP.admission=
          {pay=debit,member=owned,guard=guard,template_limit=limit,
           type_work_limit=W.work_limit expected,
           error=ERR "prepare_boolean_projection"}
        val fixed:BP.fixed_admission=
          {pay=debit,guard=guard,template_limit=limit,
           type_work_limit=W.work_limit expected,
           error=ERR "prepare_boolean_projection"}
        val inspect=BP.inspector admission
        fun profile term=(guard ();#profile inspect term)
        fun bound input(p:BP.profile)=
          let val maximum=IntInf.fromInt
                (if input then #input_limit limits else #output_limit limits)
          in if #raw p<=cap andalso #inc p<=cap andalso
              #raw p<=maximum andalso #inc p<=maximum andalso
              #ann p<=ceiling then ()else
            fail "actual compact input/result exceeds native cap" end
        fun admit term=
          let val p=profile term val _=bound true p
              val _=fixed_guard_operand expected names limit term
          in p end
        fun spelling term=
          (spend 1;if Term.is_var term then
              let val _=spend 1 val(name,_)=Term.dest_var term
                  val _=spend(String.size name)
              in IntInf.fromInt(String.size name)end
            else if Term.is_comb term then
              let val _=spend 3 val(f,x)=Term.dest_comb term
              in spelling f+spelling x end
            else if Term.is_const term then
              let val _=spend 1 val row=Term.dest_thy_const term
                  val bytes=String.size(#Thy row)+String.size(#Name row)
                  val _=spend bytes
              in IntInf.fromInt bytes end
            else fail "unexpected compact binder")
        fun compare_terms(a,b)=
          let val x=admit a val y=admit b
              val bytes=spelling a+spelling b
              val _=debit(1+weight x+weight y+bytes)
          in Term.compare(a,b)end
        fun same_term(a,b)=compare_terms(a,b)=EQUAL
        fun copy action []=(spend 1;[])
          | copy action(x::rest)=(spend 3;action x::copy action rest)
        fun add term []=(spend 2;[term])
          | add term(old::rest)=
              (spend 1;case compare_terms(term,old)of
                  LESS=>(spend 2;term::old::rest)
                | EQUAL=>(spend 1;old::rest)
                | GREATER=>(spend 1;old::add term rest))
        fun union [] result=(spend 1;result)
          | union(term::rest)result=
              (spend 1;union rest(add term result))
        fun node_name node=
          (spend 2;ignore(G.node_scope graph node);name block node)
        fun boolean node=
          (spend 1;if same_type(G.type_of graph node)Type.bool then ()else
            fail "non-Boolean projection endpoint")
        val wanted=node_name target val _=boolean target
        (* An unsupported shape is a live metadata decline. Every supplied
           edge still has its real owner/endpoint checked first. *)
        fun tag_work proof=
          let val _=spend 3 val(oracles,_)=Tag.dest_tag(Thm.tag proof)
              fun visit [] total=(spend 1;total)
                | visit(name::rest)total=
                    (spend 1;visit rest
                      (total+IntInf.fromInt(10+String.size name)))
          in visit oracles 2 end
        fun incoming(node,edge)=
          let val term=node_name node val _=boolean node
              val proof=theorem block edge
              val _=ignore(admit(Thm.concl proof))
              val _=spend 1
              val _=List.app(fn hyp=>(spend 1;ignore(admit hyp)))
                (Thm.hyp proof)
              val _=debit(tag_work proof)
              val _=if same_term(Thm.concl proof,term) andalso clean proof
                then ()else fail "actual premise endpoint or tag differs"
          in(node,edge)end
        val _=tables_phase expected "projection.inputs.before"(fn()=>"")
        val inputs=copy incoming premises
        val _=tables_phase expected "projection.inputs.after"(fn()=>"")
        fun conjunct node=
          (spend 2;ignore(G.node_scope graph node);
           case G.view graph node of G.Application(f,right)=>
             (spend 1;case G.view graph f of G.Application(head,left)=>
               (spend 1;case G.view graph head of G.Constant _=>
                 (spend 1;if Term.same_const(G.representative graph head)
                     boolSyntax.conjunction then
                   (spend 4;SOME(head,f,left,right))else NONE)
                 | _=>NONE)
               | _=>NONE)
           | _=>NONE)
        fun search root=
          let val _=spend 3 val seen=ref([]:G.node list)
              fun member node []=(spend 1;false)
                | member node(old::rest)=
                    (spend 1;node=old orelse member node rest)
              fun visit node=
                (spend 2;ignore(G.node_scope graph node);
                 if node=target then(spend 1;SOME [])
                 else if member node(!seen)then NONE else
                   let val _=spend 3 val _=seen:=node:: !seen
                   in case conjunct node of NONE=>NONE
                     | SOME(head,partial,left,right)=>
                         (case visit left of SOME path=>
                            (spend 3;SOME
                              ((node,head,partial,left,right,true)::path))
                          | NONE=>case visit right of NONE=>NONE
                            | SOME path=>(spend 3;SOME
                              ((node,head,partial,left,right,false)::path)))
                   end)
          in visit root end
        fun select []=(spend 1;NONE)
          | select((node,edge)::rest)=
              (spend 1;case search node of NONE=>select rest
                | SOME path=>(spend 2;SOME(edge,path)))
        val truth=(spend 1;case G.view graph target of G.Constant _=>
            (spend 1;Term.same_const(G.representative graph target)
              boolSyntax.T)|_=>false)
        val _=tables_phase expected "projection.select.before"(fn()=>"")
        val selected=if truth then NONE else select inputs
        val _=tables_phase expected "projection.select.after"(fn()=>"")
      in if not truth andalso not(Option.isSome selected)then
          (guard ();NONE)
        else let
          datatype token=Token of {index:int,term:Term.term,
            hypotheses:Term.term list,aliases:Term.term list,
            tags:IntInf.int,dependency:dependency}
          val _=spend 24
          val commands=ref([]:projection_step list) val next=ref 0
          val future_control=ref(27:IntInf.int)
          fun conclusion(Token{term,...})=term
          fun hypotheses(Token{hypotheses,...})=hypotheses
          fun index(Token{index,...})=index
          fun dependency(Token{dependency,...})=dependency
          fun aliases(Token{aliases,...})=aliases
          fun tags(Token{tags,...})=tags
          fun identity term=term
          fun shape_scan shape=
            spend(case shape of BP.HeldSyntax _=>2
              | BP.ApplicationSyntax _=>7|BP.EqualitySyntax _=>8)
          fun bool_scan shape=spend(case shape of BP.PBHeld _=>2
            | BP.PBFalse=>2|BP.PBNegation _=>4|_=>6)
          fun shape_work(BP.HeldSyntax term)=
                let val p=profile term val bytes=spelling term
                in 1+2*(weight p+bytes)end
            | shape_work(BP.ApplicationSyntax(a,b))=
                (spend 1;4+shape_work a+shape_work b)
            | shape_work(BP.EqualitySyntax(a,b))=
                (spend 1;8+shape_work a+shape_work b)
          fun materialize shape=
            let val(p,_)=BP.describe_shape shape_scan profile
                  type_work same_type shape
                val _=bound false p
                (* This added bounded syntax construction is separate from
                   the SAME already quoted future kernel result. *)
                val _=debit(1+weight p)
                val result=BP.realize_shape shape_scan shape
                val _=ignore(admit result)
            in result end
          fun publish instruction shape candidates hyp tags dependencies term=
            let val _=guard () val _=spend 27
                fun count [] n=(spend 1;n)
                  | count(_::rest)n=(spend 1;count rest(n+1))
                val extra=case instruction of ProjectionInput _=>2
                  | ProjectionTruth=>0
                  | ProjectionFixed(_,ids)=>2+4*count ids 0
                  | ProjectionBoolean(_,ids)=>2+4*count ids 0
                val _=spend 3
                val _=future_control:= !future_control+19+extra
                val id= !next
                val dep=new_dependency block(Union dependencies)
                val step=ProjectionStep{instruction=instruction,
                  shape=shape,candidates=candidates,dependency=dep}
                val _=commands:=step:: !commands val _=next:=id+1
            in Token{index=id,term=term,hypotheses=hyp,
              aliases=candidates,tags=tags,dependency=dep}end
          fun seed edge=
            let val proof=theorem block edge
                val term=Thm.concl proof val hyp=Thm.hyp proof
                val Edge{dependencies,...}=edge
                val _=ignore(admit term)
                val _=spend 1
                val candidates=copy(fn h=>(ignore(admit h);h))hyp
                val _=debit(1+weight(profile term))
                val tags=tag_work proof
                val _=spend 1
                fun count [] n=(spend 1;n)
                  | count(_::rest)n=(spend 1;count rest(n+1))
                val count=count candidates(0:IntInf.int)
                val _=debit(tags+shape_work(BP.HeldSyntax term)+
                  count*(count+2))
                val _=if clean proof then ()else
                  fail "unclean actual constructor/input proof"
                val _=spend 2
            in publish(ProjectionInput(edge,proof))(BP.HeldSyntax term)
              candidates candidates tags [dependencies] term end
          fun finish instruction shape preview_hypotheses proofs=
            let val _=spend 6
                val term=materialize shape
                val hyp=union preview_hypotheses []
                fun append [] tail=(spend 1;tail)
                  | append(x::rest)tail=(spend 2;x::append rest tail)
                fun collect [] result=(spend 1;result)
                  | collect(proof::rest)result=
                      (spend 1;collect rest(append(aliases proof)result))
                (* Syntax-equal input Hyp can have distinct native objects.
                   Forecast the actual kernel SET once, but retain every
                   real pointer alias for the post-kernel ownership check. *)
                fun retained term []=(spend 1;false)
                  | retained term(old::rest)=
                      (spend 1;Portable.pointer_eq(term,old)orelse
                        retained term rest)
                fun unique [] result=(spend 1;result)
                  | unique(term::rest)result=
                      (spend 1;if retained term result then
                        unique rest result else
                        (spend 1;unique rest(term::result)))
                val candidates=unique(collect proofs [])[]
                fun count [] n=(spend 1;n)
                  | count(_::rest)n=(spend 1;count rest(n+1))
                fun tag_total [] n=(spend 1;n)
                  | tag_total(proof::rest)n=
                      (spend 1;tag_total rest(n+tags proof))
                val tag_quote=tag_total proofs 2
                val n=count candidates(0:IntInf.int)
                val _=debit(shape_work shape+n*(n+2)+tag_quote+20)
                val deps=copy dependency proofs
            in publish instruction shape candidates hyp tag_quote deps term
            end
          fun fixed_step recipe proofs=
            let val _=guard ()
                val ids=copy index proofs
                (* Shared preview quotes the native RESULT Hyp union.
                   A common pointer contributes its full geometry once;
                   finish still collects all real input aliases separately.
                   This reader is fresh per rule, never native credit. *)
                val _=spend 19
                val result_hypotheses=case proofs of [_,_]=>
                    common_hypotheses_using debit common hypotheses
                  | _=>hypotheses
                val prepared=BP.prepare_fixed_observed conclusion
                  result_hypotheses fixed profile identity recipe proofs
                fun join(a,b)=if same_term(a,b)then ()else
                  fail "actual fixed operands differ"
                val _=case(recipe,proofs)of
                    (BP.Transitivity,[a,b])=>
                      join(#2(boolSyntax.dest_eq(conclusion a)),
                        #1(boolSyntax.dest_eq(conclusion b)))
                  | (BP.EqualityMP,[a,b])=>
                      join(#1(boolSyntax.dest_eq(conclusion a)),conclusion b)
                  | _=>()
            in finish(ProjectionFixed(recipe,ids))
              (#shape prepared)(#hypotheses prepared)proofs end
          fun project left proof=
            let val _=guard () val _=spend 17
                val opcode=if left then BP.PolicyConjunctLeft
                  else BP.PolicyConjunctRight
                val prepared=BP.prepare_boolean_observed conclusion
                  hypotheses fixed profile identity opcode [proof]
                val shape=BP.boolean_syntax bool_scan(#shape prepared)
            in finish(ProjectionBoolean(opcode,[index proof]))
              shape(#hypotheses prepared)[proof]end
          fun definition_seed node=
            (spend 16;seed(definition block node))
          fun descend proof []=proof
            | descend proof((node,head,partial,left,right,side)::rest)=
              let
                val _=spend 6
                val h=definition_seed head
                val p=definition_seed partial
                val n=definition_seed node
                val first=fixed_step(BP.ApplyNamedArgument(node_name left))
                  [h]
                val middle=fixed_step BP.Transitivity[p,first]
                val applied=fixed_step
                  (BP.ApplyNamedArgument(node_name right))[middle]
                val bridge=fixed_step BP.Transitivity[n,applied]
                val conjunction=fixed_step BP.EqualityMP[bridge,proof]
                val child=project side conjunction
              in descend child rest end
          val _=tables_phase expected "projection.programme.before"
            (fn()=>"")
          val answer=if truth then
              let val _=spend 2
                  val term=Thm.concl boolTheory.TRUTH
                  val _=ignore(admit term)
                  val _=debit(1+weight(profile term)+tag_work boolTheory.TRUTH+
                    shape_work(BP.HeldSyntax term))
                  val given=publish ProjectionTruth(BP.HeldSyntax term)
                    [] [] (tag_work boolTheory.TRUTH) [] term
                  val def=definition_seed target
                  val symmetry=fixed_step BP.Symmetry[def]
              in fixed_step BP.EqualityMP[symmetry,given]end
            else case selected of SOME(edge,path)=>descend(seed edge)path
              | NONE=>fail "missing selected actual premise"
          val _=tables_phase expected "projection.programme.after"
            (fn()=>" steps=" ^ Int.toString(!next))
          val _=if same_term(conclusion answer,wanted)then ()else
            fail "prepared projection endpoint differs"
          fun reverse [] result=(spend 1;result)
            | reverse(x::rest)result=
                (spend 2;reverse rest(x::result))
          val ordered=reverse(!commands)[]
          val _=spend(2+ !next)
          val steps=Vector.fromList ordered
          (* All future vector cells, instruction dispatch/proof lookup,
             checks, tag walks, one-shot state and final edge publication
             are prepaid before the first constructor/native proof rule. *)
          val _=spend 1
          val _=debit(!future_control)
          val _=guard () val _=spend 10
        in SOME(BooleanProjectionPlan{work=expected,block=block,
          steps=steps,result=index answer,epoch=epoch,symbols=symbols,
          used=ref false})end
      end)
     handle primary=>(W.close expected;raise primary))
  fun execute_boolean_projection expected(BooleanProjectionPlan
      {work,block,steps,result,epoch,symbols,used})=
    ((if Portable.pointer_eq(expected,work)then ()else
        raise ERR "execute_boolean_projection" "different original Work";
      primitive_work expected block;W.spend expected 0;active block;
      let
        val Block{graph,owner,owned_names,...}=block
        val names=case owned_names of SOME held=>held|NONE=>
          raise ERR "execute_boolean_projection" "missing owned names"
        fun guard ()=
          (primitive_work expected block;W.spend expected 0;active block;
           fixed_names_guard expected names;
           if epoch=Type.type_epoch () andalso
               symbols=Term.term_epoch ()then ()else
             raise ERR "execute_boolean_projection"
               "native declaration lifetime changed")
        val _=guard ()
        val _=if !used then raise ERR "execute_boolean_projection"
          "plan already executed"else used:=true
        val values=Array.array(Vector.length steps,NONE:Thm.thm option)
        fun get index=case Array.sub(values,index)of SOME proof=>proof
          | NONE=>raise ERR "execute_boolean_projection"
              "forward or missing native proof"
        fun identity term=term
        fun invalid ()=ERR "execute_boolean_projection"
          "private instruction arity changed"
        fun retained term []=false
          | retained term(candidate::rest)=
              Portable.pointer_eq(term,candidate)orelse retained term rest
        (* Forecast and native AP_THM can allocate distinct equal Apps on
           either kernel. These are admitted binder-free compact operands,
           with syntax/spelling/Type comparisons prepaid by shape_work.
           Equality here checks the result shape, never Hyp ownership or
           proof authority. Hyp still needs an actual retained input alias. *)
        fun matches(BP.HeldSyntax held)actual=
              Portable.pointer_eq(held,actual)orelse
              Term.compare(held,actual)=EQUAL
          | matches(BP.ApplicationSyntax(a,b))actual=
              Term.is_comb actual andalso
              let val(f,x)=Term.dest_comb actual
              in matches a f andalso matches b x end
          | matches(BP.EqualitySyntax(a,b))actual=
              boolSyntax.is_eq actual andalso
              let val(x,y)=boolSyntax.dest_eq actual
              in matches a x andalso matches b y end
        fun execute(index,ProjectionStep{instruction,shape,candidates,...})=
          let val _=guard ()
              val proof=case instruction of
                  ProjectionInput(edge,held)=>
                    let val actual=theorem block edge
                    in if Portable.pointer_eq(actual,held)then actual else
                      raise ERR "execute_boolean_projection"
                        "actual input proof changed"end
                | ProjectionTruth=>boolTheory.TRUTH
                | ProjectionFixed(recipe,indices)=>
                    (observe_proof graph #fixed;
                     BP.primitive_using invalid identity recipe
                       (List.map get indices))
                | ProjectionBoolean(opcode,indices)=>
                    (observe_proof graph #fixed;
                     BP.boolean_using invalid identity opcode
                       (List.map get indices))
              val _=if matches shape(Thm.concl proof) andalso
                  clean proof andalso
                  List.all(fn term=>retained term candidates)(Thm.hyp proof)
                then ()else raise ERR "execute_boolean_projection"
                  "native projection result/Hyp/tags differ"
              val _=guard () val _=Array.update(values,index,SOME proof)
          in ()end
        val _=Vector.appi execute steps
        val ProjectionStep{dependency,...}=Vector.sub(steps,result)
        val proof=get result val _=guard ()
      in observe_proof graph #edges;
         Edge{owner=owner,theorem=proof,dependencies=dependency,
           primitive=NONE}end)
     handle primary=>(W.close expected;raise primary))

  fun discharge_sources (old as Block
      {graph,scope,nodes,leaves,tree,context,source_count,
       template_limit,leaf_index,...}) {indices,body,edge} =
    let
      val _ = if Option.isSome leaf_index then
          raise ERR "discharge_sources" "sparse local discharge is unsupported"
        else ()
      val body_name = name old body
      val proof = theorem old edge
      val _ = if table_owned nodes then
        raise ERR "discharge_sources" "owned table route is Source-free"
        else ()
      val _ = if Term.aconv (Thm.concl proof) body_name then () else
        raise ERR "discharge_sources" "incorrect compact body endpoint"
      fun selected index =
        if index < 0 orelse index >= source_count then
          raise ERR "discharge_sources" "unknown local source occurrence"
        else case Vector.sub (leaves,index) of Source node => node
          | _ => raise ERR "discharge_sources" "invalid source leaf"
      val selected = List.map selected indices
      val removed = Redblackset.addList (Redblackset.empty Int.compare,
        List.map G.node_id selected)
      fun local_source node = Redblackset.member (removed,G.node_id node)
      val retained = List.filter (not o local_source) (sources old)
      val law = SmtReplayRuleObservation.DISCH context proof
      val _ = guard old [Thm.concl law]
      val _ = if List.null (Thm.hyp law) andalso clean law then () else
        raise ERR "discharge_sources" "old compact proof is not closed"

      datatype chain = End of G.node | Implication of G.node * G.node * chain
      fun endpoint (End node) = node
        | endpoint (Implication (node,_,_)) = node
      val implication = G.constant graph scope boolSyntax.implication
      fun discover [] = End body
        | discover (node::rest) =
            let
              val tail = discover rest
              val root = G.application graph scope
                (G.application graph scope (implication,node),endpoint tail)
            in Implication (root,node,tail) end
      val chain = discover selected
      val target = endpoint chain
      val roots = target :: List.map (fn (_, (node,_)) => node)
        (table_list nodes)
      val closed_facts = Vector.foldr
        (fn (ClosedWitness fact,rest) => fact :: rest | (_,rest) => rest)
        [] leaves
      val conversions = Vector.foldr
        (fn (ConversionWitness plan,rest) => plan :: rest | (_,rest) => rest)
        [] leaves
      val next = freeze_with_conversions graph
        {scope = scope,roots = roots,sources = retained,
         closed_facts = closed_facts,conversions = conversions,
         template_limit = template_limit}
      val source_edges = List.tabulate (List.length retained,source next)
      val source_index = List.foldl
        (fn ((node,index),table) => Redblackmap.insert
          (table,G.node_id node,index)) (Redblackmap.mkDict Int.compare)
        (ListPair.zip (retained,List.tabulate (List.length retained,Lib.I)))
      val definition_edges = Vector.foldr
        (fn (Definition (node,_),edges) => definition next node :: edges
          | (_,edges) => edges) [] leaves
      fun witness (Source node) =
            if local_source node then
              SmtReplayRuleObservation.ASSUME (name next node)
            else theorem next (List.nth (source_edges,
              Redblackmap.find (source_index,G.node_id node)))
        | witness (Definition (node,_)) = theorem next (definition next node)
        | witness (ClosedWitness fact) = theorem next (closed next fact)
        | witness (ConversionWitness plan) =
            theorem next (conversion next plan)
      val fact = SmtReplayRuleObservation.MP law
        (tree_proof (Vector.map witness leaves) tree)
      val discharged = List.foldr
        (fn (node,fact) => SmtReplayRuleObservation.DISCH (name next node)
          fact) fact selected
      fun bridge (End node) =
            checked next (SmtReplayRuleObservation.REFL (name next node))
        | bridge (Implication (node,antecedent,tail)) =
            compose next
              (fn [constructor,child] =>
                  SmtReplayRuleObservation.TRANS constructor
                  (SmtReplayRuleObservation.AP_TERM (Term.mk_comb
                    (boolSyntax.implication,name next antecedent)) child)
                | _ => raise ERR "discharge_sources"
                    "incorrect implication premises")
              [constructor next node,bridge tail]
      val equation = bridge chain
      val result = compose next
        (fn equation::_ => SmtReplayRuleObservation.EQ_MP
          (SmtReplayRuleObservation.SYM equation) discharged
          | _ => raise ERR "discharge_sources" "missing implication bridge")
        (equation :: source_edges @ definition_edges)
      val _ = retire_block old
    in {block = next,target = target,edge = result} end

  (* Fixed owned local-Source discharge. Only this block's exact recorded
     occurrence vector and its authentic backing frame supply Source slots.
     No fresh Source portfolio, caller theorem or expanded residue is used. *)
  fun discharge_sources_with_work expected
      (old as Block {graph,scope,nodes,leaves,tree,context,source_count,
        template_limit,leaf_index,owned_names,...})
      {indices,body,edge} =
    ((primitive_work expected old;
      W.with_step expected (fn () =>
      let
        val _ = validate_block_for expected old
        val _ = if Option.isSome leaf_index then
            raise ERR "discharge_sources_with_work"
              "sparse local discharge is unsupported" else ()
        val source_frame as RetainedSourceFrame {sources = retained,...} =
          retained_source_frame_for expected old indices
        val body_name = name old body
        val proof = theorem old edge
        val _ = W.spend expected 1
        val _ = if Term.aconv (Thm.concl proof) body_name then () else
          raise ERR "discharge_sources_with_work" "incorrect body endpoint"
        fun selected index =
          (W.spend expected 1;case Vector.sub (leaves,index) of
             Source node => node
           | _ => raise ERR "discharge_sources_with_work" "invalid Source")
        val selected = List.map selected indices
        fun local_slot index = List.exists (fn chosen =>
          (W.spend expected 1;chosen = index)) indices
        datatype chain = End of G.node
          | Implication of G.node * G.node * chain
        fun endpoint (End node) = node
          | endpoint (Implication (node,_,_)) = node
        val _ = W.spend expected 1
        val implication = G.constant graph scope boolSyntax.implication
        fun discover [] = End body
          | discover (node::rest) =
              let val _ = W.spend expected 3
                  val tail = discover rest
                  val root = G.application graph scope
                    (G.application graph scope (implication,node),endpoint tail)
              in Implication (root,node,tail) end
        val chain = discover selected val target = endpoint chain
        (* Demands derive from actual constructor leaves, not the complete
           name inventory. A realized endpoint atom is not expanded merely
           because the old compact proof uses its retained variable name. *)
        val definitions = Vector.foldr
          (fn (Definition (node,_),rest) =>
                (W.spend expected 2;node::rest)
            | (_,rest) => (W.spend expected 1;rest)) [] leaves
        val closed_facts = Vector.foldr
          (fn (ClosedWitness fact,rest) =>
                (W.spend expected 2;fact::rest)
            | (_,rest) => (W.spend expected 1;rest)) [] leaves
        val conversions = Vector.foldr
          (fn (ConversionWitness conversion,rest) =>
                (W.spend expected 2;conversion::rest)
            | (_,rest) => (W.spend expected 1;rest)) [] leaves
        val frontier = prepare_retained_source_frontier expected source_frame
          {roots = target::definitions,closed_facts = closed_facts,
           conversions = conversions}
        val tables = prepare_owned_realization_tables expected frontier
        val next = freeze_owned_realization_tables_plan expected tables
        val _ = table_app (fn (_, (node,original)) =>
          if Portable.pointer_eq (original,name next node) then () else
            raise ERR "discharge_sources_with_work" "compact name changed")
          nodes
        (* Quote each fixed public rule's actual compact operand/result/Hyp
           before that rule. Independent type incidence is measured at each
           syntax occurrence; no old table quote or semantic profile grants
           credit for these additional operations. Lazy/kernel/private work
           remains a separate obligation. *)
        fun quote block terms =
          let val names = case block of Block {owned_names = SOME names,...} =>
                    names
                | _ => raise ERR "discharge_sources_with_work"
                    "missing authentic owned names"
              fun type_weight ty =
                let val _ = W.spend expected 1
                in if Type.is_vartype ty then
                    (W.spend expected
                      (String.size (Type.dest_vartype ty));1 : IntInf.int)
                   else List.foldl (fn (arg,total) =>
                     (W.spend expected 1;total + type_weight arg)) 1
                     (#2 (Type.dest_type ty)) end
              fun syntax term =
                let val _ = W.spend expected 1
                    val ty = type_weight (Term.type_of term)
                in if Term.is_comb term then
                    let val _ = W.spend expected 2
                        val (left,right) = Term.dest_comb term
                    in 2 + ty + syntax left + syntax right end
                   else if Term.is_abs term then
                    let val _ = W.spend expected 2
                        val (binder,body) = Term.dest_abs term
                    in 3 + ty + type_weight (Term.type_of binder) +
                      syntax body end
                   else 2 + ty end
              fun visit [] = ()
                | visit (term::rest) =
                    (W.spend expected 1;
                     fixed_guard_operand expected names template_limit term;
                     pay expected (syntax term);visit rest)
          in validate_block_for expected block;visit terms;
             validate_block_for expected block end
        fun premises proofs =
          List.foldr (fn (proof,rest) =>
            (W.spend expected 2;Thm.concl proof :: Thm.hyp proof @ rest))
            [] proofs
        fun admit block result hypotheses proofs =
          quote block (result :: hypotheses @ premises proofs)
        fun discharge block antecedent fact =
          let val _ = W.spend expected 3
              val result = boolSyntax.mk_imp (antecedent,Thm.concl fact)
              val _ = admit block result (Thm.hyp fact) [fact]
          in SmtReplayRuleObservation.DISCH antecedent fact end
        fun mp block law fact =
          let val _ = W.spend expected 2
              val result = #2 (boolSyntax.dest_imp (Thm.concl law))
              val _ = admit block result (Thm.hyp law @ Thm.hyp fact) [law,fact]
          in SmtReplayRuleObservation.MP law fact end
        fun assume block term =
          (admit block term [term] [];SmtReplayRuleObservation.ASSUME term)
        fun conjunction block left right =
          let val _ = W.spend expected 3
              val result = boolSyntax.mk_conj (Thm.concl left,Thm.concl right)
              val _ = admit block result
                (Thm.hyp left @ Thm.hyp right) [left,right]
          in SmtReplayRuleObservation.CONJ left right end
        fun reflexive block term =
          let val _ = W.spend expected 3
              val result = boolSyntax.mk_eq (term,term)
              val _ = admit block result [] []
          in SmtReplayRuleObservation.REFL term end
        fun trans block left right =
          let val _ = W.spend expected 3
              val result = boolSyntax.mk_eq
                (#1 (boolSyntax.dest_eq (Thm.concl left)),
                 #2 (boolSyntax.dest_eq (Thm.concl right)))
              val _ = admit block result
                (Thm.hyp left @ Thm.hyp right) [left,right]
          in SmtReplayRuleObservation.TRANS left right end
        fun apply_argument block proof operand =
          let val _ = W.spend expected 5
              val (left,right) = boolSyntax.dest_eq (Thm.concl proof)
              val result = boolSyntax.mk_eq
                (Term.mk_comb (left,operand),Term.mk_comb (right,operand))
              val _ = admit block result (Thm.hyp proof) [proof]
          in SmtReplayRuleObservation.AP_THM proof operand end
        fun apply_operator block operator proof =
          let val _ = W.spend expected 5
              val (left,right) = boolSyntax.dest_eq (Thm.concl proof)
              val result = boolSyntax.mk_eq
                (Term.mk_comb (operator,left),Term.mk_comb (operator,right))
              val _ = admit block result (Thm.hyp proof) [proof]
          in SmtReplayRuleObservation.AP_TERM operator proof end
        fun symmetry block proof =
          let val _ = W.spend expected 3
              val (left,right) = boolSyntax.dest_eq (Thm.concl proof)
              val result = boolSyntax.mk_eq (right,left)
              val _ = admit block result (Thm.hyp proof) [proof]
          in SmtReplayRuleObservation.SYM proof end
        fun equality_mp block equality fact =
          let val _ = W.spend expected 2
              val result = #2 (boolSyntax.dest_eq (Thm.concl equality))
              val _ = admit block result
                (Thm.hyp equality @ Thm.hyp fact) [equality,fact]
          in SmtReplayRuleObservation.EQ_MP equality fact end
        val law = discharge old context proof
        val _ = if List.null (Thm.hyp law) andalso clean law then () else
          raise ERR "discharge_sources_with_work" "old proof is not closed"
        val source_edges = List.tabulate (List.length retained,source next)
        fun retained_index index =
          let fun count current total = if current = index then total else
                count (current+1)
                  (if local_slot current then total else total+1)
          in count 0 0 end
        fun witness (index,Source node) =
              if local_slot index then assume next (name next node)
              else theorem next (List.nth (source_edges,retained_index index))
          | witness (_,Definition (node,_)) =
              theorem next (definition next node)
          | witness (_,ClosedWitness fact) = theorem next (closed next fact)
          | witness (_,ConversionWitness plan) =
              theorem next (conversion next plan)
        val witnesses = Vector.mapi witness leaves
        fun rebuild Empty = boolTheory.TRUTH
          | rebuild (Leaf index) = Vector.sub (witnesses,index)
          | rebuild (Split (left,right)) =
              conjunction next (rebuild left) (rebuild right)
        val fact = mp next law (rebuild tree)
        val discharged = List.foldr (fn (node,fact) =>
          discharge next (name next node) fact) fact selected
        fun constructor node = case G.view graph node of
            G.Constant _ => theorem next (definition next node)
          | G.Application (operator,operand) =>
              trans next (theorem next (definition next node))
                (apply_argument next (constructor operator) (name next operand))
          | _ => reflexive next (name next node)
        fun bridge (End node) = reflexive next (name next node)
          | bridge (Implication (node,antecedent,tail)) =
              let val _ = W.spend expected 2
                  val operator = Term.mk_comb
                    (boolSyntax.implication,name next antecedent)
              in trans next (constructor node)
                (apply_operator next operator (bridge tail)) end
        val result = equality_mp next (symmetry next (bridge chain)) discharged
        val Block {context = next_context,leaves = next_leaves,owner,...} = next
        val _ = guard next (Thm.concl result :: Thm.hyp result)
        val _ = if clean result andalso List.all
            (fn hypothesis => Term.aconv hypothesis next_context)
            (Thm.hyp result) then () else
          raise ERR "discharge_sources_with_work" "invalid common-context proof"
        (* Conservative actual leaf union retains every original witness
           dependency; no Hyp claim is derived from this semantic union. *)
        val dependency = new_dependency next (Leaves
          (List.tabulate (Vector.length next_leaves,Lib.I)))
        val _ = retained_source_guard expected source_frame
        val _ = validate_block_for expected next
        val _ = retire_block old
      in observe_proof graph #edges;{block = next,target = target,
        edge = Edge {owner = owner,theorem = result,dependencies = dependency,
          primitive=NONE}}
      end)) handle primary => (W.close expected;raise primary))

  (* Cross-block witnesses already use retained endpoints and canonical
     source hypotheses. They are not instantiated or re-abstracted here. *)
  fun realize_internal (block as Block
      {graph,scope,nodes,leaves,leaf_index,...})
      resolution target
      edge supplied closed_images =
    let
      val _ = policy_legacy_block_only "realize" block
      val operation = case resolution of NONE => "realize"
        | SOME _ => "realize_resolved"
      val _ = case resolution of NONE => ()
        | SOME result => SmtReplayResolve.validate graph scope result
      fun resolved_node node = case resolution of NONE => node
        | SOME result => SmtReplayResolve.node result node
      fun assignment node = case resolution of NONE => false
        | SOME result => SmtReplayResolve.is_assignment_source result node
      fun resolved node = G.representative graph (resolved_node node)
      val selected = case leaf_index of NONE => NONE
        | SOME _ => SOME (needed_leaves block edge)
      val selected_set = Option.map (fn indices => Redblackset.addList
        (Redblackset.empty Int.compare,indices)) selected
      fun used index = case selected_set of NONE => true
        | SOME indices => Redblackset.member (indices,index)
      val target_name = name block target
      val _ = if resolved_node target = target then () else
        raise ERR operation "assignment changes original target"
      (* Image admission is separate from cross-block ordinary witnesses.
         No image table or extra graph traversal is made on old paths. *)
      val images = Option.map (fn proofs =>
        List.foldl (fn ((index,proof),table) =>
          let
            val _ = if index >= 0 andalso index < Vector.length leaves
              then () else raise ERR operation "invalid closed Source index"
            val node = case Vector.sub (leaves,index) of Source node => node
              | _ => raise ERR operation "closed image is not a Source"
            val current = resolved_node node
            val _ = if used index andalso not (assignment node) andalso
                current <> node andalso
                List.null (Thm.hyp proof) andalso clean proof andalso
                Portable.pointer_eq (Thm.concl proof,
                  G.representative graph current) then () else
              raise ERR operation "closed Source image is not exact and clean"
            val _ = if Redblackmap.inDomain (table,index) then
                raise ERR operation "duplicate closed Source image" else ()
          in Redblackmap.insert (table,index,proof) end)
          (Redblackmap.mkDict Int.compare) proofs) closed_images
      fun image index = case images of NONE => NONE
        | SOME table => Redblackmap.peek (table,index)
      fun validate_source (index,Source node) =
            if not (used index) orelse assignment node orelse
                resolved_node node = node orelse
                Option.isSome (image index) then () else
              raise ERR operation "assignment changes source fact"
        | validate_source (_,ClosedWitness fact) =
            if resolved_node (closed_node fact) = closed_node fact then ()
            else raise ERR operation "assignment changes closed auxiliary"
        | validate_source (_,ConversionWitness plan) =
            if resolved_node (conversion_source plan) = conversion_source plan
                andalso resolved_node (conversion_target plan) =
                  conversion_target plan then () else
              raise ERR operation "assignment changes closed conversion"
        | validate_source _ = ()
      val _ = case (images,selected) of (NONE,NONE) => Vector.app
            (fn leaf => validate_source (~1,leaf)) leaves
        | _ => Vector.appi validate_source leaves

      (* This optional lookup compares only canonical pointer identities.
         The ordinary realization allocates no witness table or vector. *)
      val allowed = ref NONE
      val bucket_count = 4093
      val hint = SmtReplayImport.pointer_bucket 4 bucket_count
      fun source_table () = case !allowed of SOME table => table
        | NONE =>
          let
            val table = Array.array (bucket_count,[])
            fun insert (Source node) =
                  if assignment node orelse
                      ((Option.isSome images orelse Option.isSome selected)
                       andalso resolved_node node <> node) then ()
                  else
                  let val term = G.representative graph node
                      val bucket = hint term
                  in Array.update (table,bucket,
                    term :: Array.sub (table,bucket)) end
              | insert _ = ()
            val _ = Vector.app insert leaves
            val _ = allowed := SOME table
          in table end
      fun permitted hypothesis = List.exists
        (fn source => Portable.pointer_eq (source,hypothesis))
        (Array.sub (source_table (),hint hypothesis))
      fun check_witness node proof =
        if Portable.pointer_eq
            (Thm.concl proof,G.representative graph node) andalso
            clean proof andalso List.all permitted (Thm.hyp proof) andalso
            (not (Option.isSome selected) orelse List.null (Thm.hyp proof))
        then proof else raise ERR operation
          "cross-block witness has invalid endpoint, hypotheses or tags"
      val witnesses = Option.map (fn supply => Vector.mapi
        (fn (index,Source node) =>
              if not (used index) orelse assignment node orelse
                  Option.isSome (image index) then NONE
              else Option.map (check_witness node) (supply (index,node))
          | (_,_) => NONE) leaves) supplied

      val proof = theorem block edge
      val _ = if Term.aconv (Thm.concl proof) target_name then ()
        else raise ERR operation "incorrect compact endpoint"
      val indices = Option.getOpt (selected,[])
      val active_leaves = case selected of NONE => leaves
        | SOME _ => Vector.fromList
            (List.map (fn index => Vector.sub (leaves,index)) indices)
      val substitution = table_foldl
        (fn (_, (node,variable), list) =>
          {redex = variable,residue = resolved node} :: list) [] nodes
      val _ = SmtReplayTermBridge.prepare_schema_substitution
        1 proof substitution
      val compact = assemble_internal block edge
      val active_tree = #tree compact
      val law = #law compact
      val _ = observe_proof graph #inst
      val instantiated = SmtReplayRuleObservation.INST substitution law
      val (antecedent,_) = boolSyntax.dest_imp (Thm.concl instantiated)
      val actual_leaves = Vector.fromList
        (project active_tree (SmtReplayRuleObservation.ASSUME antecedent))
      fun discharge (position,(index,Source node)) =
            if assignment node then
              let
                val equality = Thm.concl (Vector.sub (actual_leaves,position))
                val (left,right) = boolSyntax.dest_eq equality
                val _ = if Portable.pointer_eq (left,right) then () else
                  raise ERR operation
                    "resolved solver assignment is not reflexive"
              in SmtReplayRuleObservation.REFL left end
            else
              (case image index of SOME proof => proof
               | NONE => case Option.map
                   (fn proofs => Vector.sub (proofs,index)) witnesses of
                   SOME (SOME proof) => proof
                 | _ => SmtReplayRuleObservation.ASSUME
                     (G.representative graph node))
        | discharge (_,(_,ClosedWitness fact)) = closed_proof fact
        | discharge (position,(_,ConversionWitness plan)) =
            let val (left,right) = boolSyntax.dest_eq
                  (Thm.concl (Vector.sub (actual_leaves,position)))
                val _ = if Portable.pointer_eq (left,G.representative graph
                      (conversion_source plan)) andalso
                    Portable.pointer_eq (right,G.representative graph
                      (conversion_target plan)) then () else
                  raise ERR operation "realized conversion endpoints differ"
            in conversion_proof plan end
        | discharge (position,(_,Definition _)) =
            let val (left,right) = boolSyntax.dest_eq
              (Thm.concl (Vector.sub (actual_leaves,position))) in
              (* Applications retain the corresponding immediate children;
                 constant aliases have identical endpoints. This is not a
                 comparison of independently expanded graph residues. *)
              SmtReplayTermBridge.nodewise_equality left right
            end
      fun exact_witness (position,proof) =
        let val expected = Thm.concl (Vector.sub (actual_leaves,position))
        in if Portable.pointer_eq (Thm.concl proof,expected) then proof
           else SmtReplayRuleObservation.EQ_MP
             (SmtReplayTermBridge.nodewise_equality
               (Thm.concl proof) expected) proof
        end
      val actual_witnesses = Vector.mapi exact_witness
        (case selected of NONE => Vector.mapi
          (fn (index,leaf) => discharge (index,(index,leaf))) leaves
        | SOME _ => Vector.mapi discharge (Vector.fromList
            (ListPair.zip (indices,Vector.foldr
              (fn (leaf,rest) => leaf :: rest) [] active_leaves))))
      val result = SmtReplayRuleObservation.MP instantiated
        (tree_proof actual_witnesses active_tree)
      val _ = if Portable.pointer_eq
          (Thm.concl result,G.representative graph target) andalso clean result
        then () else raise ERR operation "endpoint or tags changed"
      val _ = retire_block block
    in result end

  fun realize block target edge =
    realize_internal block NONE target edge NONE NONE
  (* One synchronous validation transaction. Incoming owner, exact Scope,
     epochs, actual Source slots and every retained backing path precede a
     completed hit. Only successful recursive descendants are skipped.
     Metadata getters select unpriced memo events; owned consumer actions
     select their actual event debit. Neither selection caches across calls. *)
  fun source_realization_guards_observing expected metered observe receipts =
    let
      fun fence (SourceRealization {work,...}) =
        if Portable.pointer_eq (expected,work) then () else
          (W.close expected;raise ERR "source_realization_guard"
            "different original Work")
      val _ = List.app fence receipts
      (* Only private receipt-data observers occur here, never user
         callbacks. Every original owner/frame/epoch/path/endpoint/origin
         check below still runs in order. Share their metadata carrier,
         NOT a completed guard or any lifetime permission. *)
      val charge=if metered then
          compact_callback_free_payer_with_quantum 1024 expected
        else fn _=>()
      val _ = charge 1
      val done = ref ([] : source_realization list)
      fun completed receipt [] = (charge 1;false)
        | completed receipt (old::rest) =
            (charge 1;Portable.pointer_eq (receipt,old) orelse
              completed receipt rest)
      fun visit (receipt as SourceRealization
      {work,source_frame,graph,root,scope,frame,original_sources,target,
       occurrences,origins,theorem,compact,held,facts,conversions,
       template_limit,
       parents,epoch,symbols}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "source_realization_guard" "different original Work";
      retained_source_guard_using charge expected source_frame;
      let
        val data = Scope.description_for expected frame
        val _ = if Portable.pointer_eq (#graph data,graph) andalso
            #root data = root andalso #scope data = scope andalso
            Portable.pointer_eq (#sources data,original_sources) andalso
            #template_limit (W.semantic_limits expected) = template_limit
            andalso Type.type_epoch () = epoch andalso
            Term.term_epoch () = symbols then () else
          raise ERR "source_realization_guard" "held Source frame changed"
        val SourceCompact {block = compact_block as Block
            {owner = block_owner,owned_frame,graph = compact_graph,
             scope = compact_scope,...},edge = Edge {owner = edge_owner,
             ...},target_name,proof = compact_proof,...} = compact
        val _ = if Portable.pointer_eq (block_owner,edge_owner) andalso
            Portable.pointer_eq (compact_graph,graph) andalso
            compact_scope = scope andalso clean compact_proof andalso
              Term.aconv (Thm.concl compact_proof) target_name then () else
          raise ERR "source_realization_guard"
            "held compact proof owner or endpoint changed"
        val _ = case owned_frame of SOME (held,held_frame) =>
            if Portable.pointer_eq (held,expected) andalso
                Portable.pointer_eq (held_frame,frame) then () else
              raise ERR "source_realization_guard"
                "held compact invocation or frame changed"
          | NONE => raise ERR "source_realization_guard"
              "unowned compact evidence"
        fun same_origins [] [] = true
          | same_origins ((a,_)::rest) ((b,_)::tail) =
              (charge 1;a=b andalso same_origins rest tail)
          | same_origins _ _ = false
        val _ = if same_origins origins occurrences then () else
          raise ERR "source_realization_guard"
            "actual occurrence origins changed"
        fun original_origin ((_,node),(_,OriginalPrefixSlot (held,index))) =
              let val _ = if Portable.pointer_eq (held,original_sources)
                    then () else raise ERR "source_realization_guard"
                      "different retained original Source origin"
                  fun at [] remaining =
                        (charge 1;remaining=0 andalso
                         SmtReplaySource.denied_goal_node held=node)
                    | at (head::rest) remaining =
                        (charge 1;if remaining=0 then head=node
                         else at rest (remaining-1))
              in if index >= 0 andalso
                  at (SmtReplaySource.assumption_nodes held) index then () else
                raise ERR "source_realization_guard"
                  "actual original-prefix occurrence changed" end
          | original_origin _ = ()
        val _ = ListPair.appEq
          (fn pair => (charge 1;original_origin pair)) (occurrences,origins)
        val _ = List.app (fn child =>
          (charge 1;ignore (G.closure_child_node graph scope child))) held
        val _ = List.app (fn fact =>
          (charge 1;validate_closed_fact graph scope template_limit fact))
          facts
        val _ = List.app (fn conversion =>
          (charge 1;validate_conversion_for expected conversion)) conversions
        val _ = List.app (fn conversion =>
          (charge 1;validate_conversion graph scope template_limit conversion))
          conversions
        val (conclusion,hypotheses,clean_result)=observe receipt theorem
        val _ = if Portable.pointer_eq
            (conclusion,G.representative graph target) andalso
            clean_result andalso List.all (fn hypothesis =>
              (charge 1;List.exists (fn (_,node) =>
                (charge 1;Portable.pointer_eq
                  (hypothesis,G.representative graph node))) occurrences))
              hypotheses then () else
          raise ERR "source_realization_guard" "checked Source result changed"
      in
        if completed receipt (!done) then () else
          (visits parents;charge 2;done := receipt :: !done)
      end)
     handle primary => (W.close expected;raise primary))

      and visits [] = charge 1
        | visits (receipt::rest) =
            (charge 1;visit receipt;visits rest)
    in visits receipts end
  fun source_realization_observations _ theorem =
    (Thm.concl theorem,Thm.hyp theorem,clean theorem)
  fun source_realization_guards_internal expected metered receipts =
    source_realization_guards_observing expected metered
      source_realization_observations receipts
  fun source_realization_guard expected receipt =
    source_realization_guards_internal expected false [receipt]
  fun source_realization_guards_with_work expected receipts =
    source_realization_guards_internal expected true receipts

  (* Validate the receipt DATA and its entire backing before realization.
     The anticipated endpoint/Hyp are derived privately from the closed
     compact law and captured genuine witnesses, not supplied by a caller.
     They confer no proof: finish checks the actual native theorem against
     them. No candidate receipt or validation permission escapes this call.
     Public receipt queries still run the complete original validator. *)
  fun preflight_source_realization expected make (endpoint,hypotheses) =
    let
      val candidate=make boolTheory.TRUTH
      fun observe held theorem=if Portable.pointer_eq(held,candidate) then
          (endpoint,hypotheses,true)
        else source_realization_observations held theorem
      val _=source_realization_guards_observing expected true observe
        [candidate]
      val count=length hypotheses
      (* Additional pointer-only comparison with the anticipated native
         Hyp. The backing validator above pays its own original programme. *)
      val _=W.spend expected (2+count*(count+3))
      val _=W.require_callback_free_return expected
      fun finish theorem=
        if Portable.pointer_eq(Thm.concl theorem,endpoint) andalso
            clean theorem andalso List.all (fn term=>List.exists
              (fn held=>Portable.pointer_eq(term,held)) hypotheses)
                (Thm.hyp theorem) then make theorem
        else raise ERR "source_realization_guard"
          "checked Source result changed"
    in finish end

  (* Own one action. Quote actual named selected-context operands and the
     future DISCH law BEFORE realization. No expanded represented Source
     is classified as a fresh original occurrence or silently bounded away.
     Generic realization/kernel/private traversal closure remains separate. *)
  fun realize_source_owned_receipt expected
      (block as Block {owner,graph,scope,leaves,nodes,template_limit,
                       owned_frame,leaf_index,owned_names,...}) target edge =
    ((validate_block_for expected block;
      W.with_step expected (fn () =>
      let
        val _ = validate_block_for expected block
        val frame = case owned_frame of SOME (_,frame) => frame
          | NONE => raise ERR "realize_source_owned_receipt" "unowned block"
        val data = Scope.description_for expected frame
        val _ = if Option.isSome leaf_index then () else
          raise ERR "realize_source_owned_receipt"
            "actual sparse dependency metadata required"
        val names = case owned_names of SOME names => names
          | NONE => raise ERR "realize_source_owned_receipt"
              "missing authentic named vocabulary"
        val proof = theorem block edge
        val target_name = name block target
        val terms = Thm.concl proof :: Thm.hyp proof
        val _ = fixed_guard_retained_operands expected names
          template_limit terms
        val _ = owned_sparse_projection_quote expected template_limit
          (Vector.fromList terms)
        val indices = needed_leaves block edge
        val _ = List.app (fn _ => W.spend expected 1) indices
        val selected_terms = Vector.fromList (List.map (fn index =>
          (W.spend expected 1;leaf_term (name block)
            (Vector.sub (leaves,index)))) indices)
        val active_tree = make_tree 0 (Vector.length selected_terms)
        val active_context = tree_term selected_terms active_tree
        fun raw term = case SmtReplayImport.bounded_raw_size
            template_limit term of SOME count => count
          | NONE => raise ERR "realize_source_owned_receipt"
              "actual named operand exceeds original raw cap"
        fun inclusive term = case SmtReplayImport.bounded_binder_size
            template_limit term of SOME count => count
          | NONE => raise ERR "realize_source_owned_receipt"
              "actual named operand exceeds original binder cap"
        val raw_law = 3 + raw active_context + raw target_name
        val inc_law = 3 + inclusive active_context + inclusive target_name
        val _ = if raw_law <= template_limit andalso
            inc_law <= template_limit then () else
          raise ERR "realize_source_owned_receipt"
            "prospective actual DISCH law exceeds original cap"
        val _ = W.spend expected raw_law
        val _ = W.spend expected inc_law
        val _ = owned_sparse_projection_quote expected template_limit
          (Vector.fromList [active_context,target_name])
        val source_frame as RetainedSourceFrame
            {original_slots,...} = retained_source_frame_for expected block []
        val needed = needed_source_occurrences block edge
        val occurrences = List.map (fn index =>
          (W.spend expected 1;(index,List.nth (original_slots,index)))) needed
        val held = table_foldl (fn (_, (node,_),rest) =>
          (W.spend expected 2;G.closure_root graph scope node :: rest)) [] nodes
        val facts = Vector.foldr
          (fn (ClosedWitness fact,rest) => fact::rest | (_,rest) => rest)
          [] leaves
        val conversions = Vector.foldr
          (fn (ConversionWitness plan,rest) => plan::rest | (_,rest) => rest)
          [] leaves
        val _ = List.app (validate_conversion_for expected) conversions
        val _ = retained_source_guard expected source_frame
        val closed=assemble_internal block edge
        val result = realize block target edge
        val receipt = SourceRealization
          {work = expected,source_frame = source_frame,graph = graph,
           root = #root data,scope = scope,frame = frame,
           original_sources = #sources data,target = target,
           occurrences = occurrences,
           origins = List.map (fn (index,_) =>
             (index,ActualSourceSlot (owner,index))) occurrences,
           theorem = result,
           compact = SourceCompact {block = block,edge = edge,
             target_name = target_name,proof = proof,needed = indices,
             names = List.map #2 (table_list nodes),extra_leaves = [],
             cuts = [],closed = SOME closed},
           held = held,
           facts = facts,conversions = conversions,
           template_limit = template_limit,parents = [],
           epoch = Type.type_epoch (),symbols = Term.term_epoch ()}
        val _ = source_realization_guard expected receipt
      in receipt end))
     handle primary => (W.close expected;raise primary))

  fun source_realization_data_for expected
      (receipt as SourceRealization
        {graph,root,scope,frame,original_sources,target,occurrences,
         template_limit,...}) =
    (source_realization_guard expected receipt;
     {graph = graph,root = root,scope = scope,frame = frame,
      original_sources = original_sources,target = target,
      source_occurrences = occurrences,template_limit = template_limit})
  fun source_realization_theorem_for expected
      (receipt as SourceRealization {theorem,...}) =
    (source_realization_guard expected receipt;theorem)

  fun realize_owned_receipt expected (block as Block
      {owner,graph,scope,source_count,nodes,leaves,template_limit,
       owned_frame,...}) target edge =
    ((case owned_frame of SOME (work,_) =>
        if Portable.pointer_eq (expected,work) then () else
          raise ERR "realize_owned_receipt" "different original Work"
      | NONE => raise ERR "realize_owned_receipt" "unowned proof block";
      W.spend expected 0;
      if source_count = 0 then () else
        raise ERR "realize_owned_receipt" "ordinary Source in receipt block";
      let
        val frame = case owned_frame of SOME (_,frame) => frame
          | NONE => raise ERR "realize_owned_receipt" "missing original frame"
        val data = Scope.description_for expected frame
        val _ = if template_limit =
            #template_limit (W.semantic_limits expected) then () else
          raise ERR "realize_owned_receipt" "different original template"
        (* The exact equality is the actual target of THIS block edge.
           Source/target are parsed internally; no caller theorem pair. *)
        val _ = ignore (theorem block edge)
        val (partial,target_node) = case G.view graph target of
            G.Application pair => pair
          | _ => raise ERR "realize_owned_receipt" "target not equality"
        val (head,source) = case G.view graph partial of
            G.Application pair => pair
          | _ => raise ERR "realize_owned_receipt" "target not typed equality"
        val _ = case G.view graph head of G.Constant _ =>
              if Term.same_const (G.representative graph head)
                  boolSyntax.equality andalso
                  G.type_id graph source = G.type_id graph target_node then ()
              else raise ERR "realize_owned_receipt" "wrong equality operator"
          | _ => raise ERR "realize_owned_receipt" "unrecorded equality head"
        val facts = Vector.foldr (fn (ClosedWitness fact,rest) => fact::rest
          | (_,rest) => rest) [] leaves
        val conversions = Vector.foldr
          (fn (ConversionWitness conversion,rest) => conversion::rest
            | (_,rest) => rest) [] leaves
        val _ = List.app (validate_conversion_for expected) conversions
        val held = table_foldl (fn (_, (node,_),rest) =>
          (W.spend expected 2;G.closure_root graph scope node :: rest)) [] nodes
        val epoch = Type.type_epoch () val symbols = Term.term_epoch ()
        val proof = realize block target edge
        val receipt = Realization {work = expected,owner = owner,
          graph = graph,root = #root data,scope = scope,
          sources = #sources data,frame = frame,equality = target,
          source = source,target = target_node,template_limit = template_limit,
          epoch = epoch,symbols = symbols,held = held,facts = facts,
          conversions = conversions,theorem = proof}
        val _ = validate_realization_for expected receipt
      in receipt end)
     handle primary => (W.close expected;raise primary))
  fun realize_with_sources block target edge witnesses =
    realize_internal block NONE target edge (SOME witnesses) NONE
  fun realize_resolved block resolution target edge =
    realize_internal block (SOME resolution) target edge NONE NONE
  fun realize_resolved_with_sources block resolution target edge witnesses =
    realize_internal block (SOME resolution) target edge (SOME witnesses) NONE
  fun realize_resolved_with_closed_sources block resolution target edge
      images witnesses =
    realize_internal block (SOME resolution) target edge
      (SOME witnesses) (SOME images)
  (* Private specialization: ONLY source_cut_block retains the proof supply.
     Open Hyp must be exact promoted Source slots. Old realization is literal
     and retains its existing sparse closed-witness restriction. *)
  fun prepare_source_cut_internal (block as Block
      {graph,scope,nodes,leaves,leaf_index,owned_frame,...})
      resolution target
      edge supplied closed_images =
    let
      val operation = case resolution of NONE => "realize"
        | SOME _ => "realize_resolved"
      val _ = case resolution of NONE => ()
        | SOME result => SmtReplayResolve.validate graph scope result
      fun resolved_node node = case resolution of NONE => node
        | SOME result => SmtReplayResolve.node result node
      fun assignment node = case resolution of NONE => false
        | SOME result => SmtReplayResolve.is_assignment_source result node
      fun resolved node = G.representative graph (resolved_node node)
      val selected = case leaf_index of NONE => NONE
        | SOME _ => SOME (needed_leaves block edge)
      val selected_set = Option.map (fn indices => Redblackset.addList
        (Redblackset.empty Int.compare,indices)) selected
      fun used index = case selected_set of NONE => true
        | SOME indices => Redblackset.member (indices,index)
      val target_name = name block target
      val _ = if resolved_node target = target then () else
        raise ERR operation "assignment changes original target"
      (* Image admission is separate from cross-block ordinary witnesses.
         No image table or extra graph traversal is made on old paths. *)
      val images = Option.map (fn proofs =>
        List.foldl (fn ((index,proof),table) =>
          let
            val _ = if index >= 0 andalso index < Vector.length leaves
              then () else raise ERR operation "invalid closed Source index"
            val node = case Vector.sub (leaves,index) of Source node => node
              | _ => raise ERR operation "closed image is not a Source"
            val current = resolved_node node
            val _ = if used index andalso not (assignment node) andalso
                current <> node andalso
                List.null (Thm.hyp proof) andalso clean proof andalso
                Portable.pointer_eq (Thm.concl proof,
                  G.representative graph current) then () else
              raise ERR operation "closed Source image is not exact and clean"
            val _ = if Redblackmap.inDomain (table,index) then
                raise ERR operation "duplicate closed Source image" else ()
          in Redblackmap.insert (table,index,proof) end)
          (Redblackmap.mkDict Int.compare) proofs) closed_images
      fun image index = case images of NONE => NONE
        | SOME table => Redblackmap.peek (table,index)
      fun validate_source (index,Source node) =
            if not (used index) orelse assignment node orelse
                resolved_node node = node orelse
                Option.isSome (image index) then () else
              raise ERR operation "assignment changes source fact"
        | validate_source (_,ClosedWitness fact) =
            if resolved_node (closed_node fact) = closed_node fact then ()
            else raise ERR operation "assignment changes closed auxiliary"
        | validate_source (_,ConversionWitness plan) =
            if resolved_node (conversion_source plan) = conversion_source plan
                andalso resolved_node (conversion_target plan) =
                  conversion_target plan then () else
              raise ERR operation "assignment changes closed conversion"
        | validate_source _ = ()
      val _ = case (images,selected) of (NONE,NONE) => Vector.app
            (fn leaf => validate_source (~1,leaf)) leaves
        | _ => Vector.appi validate_source leaves

      (* This optional lookup compares only canonical pointer identities.
         The ordinary realization allocates no witness table or vector. *)
      val allowed = ref NONE
      val bucket_count = 4093
      val hint = SmtReplayImport.pointer_bucket 4 bucket_count
      fun source_table () = case !allowed of SOME table => table
        | NONE =>
          let
            val table = Array.array (bucket_count,[])
            fun insert (Source node) =
                  if assignment node orelse
                      ((Option.isSome images orelse Option.isSome selected)
                       andalso resolved_node node <> node) then ()
                  else
                  let val term = G.representative graph node
                      val bucket = hint term
                  in Array.update (table,bucket,
                    term :: Array.sub (table,bucket)) end
              | insert _ = ()
            val _ = Vector.app insert leaves
            val _ = allowed := SOME table
          in table end
      fun permitted hypothesis = List.exists
        (fn source => Portable.pointer_eq (source,hypothesis))
        (Array.sub (source_table (),hint hypothesis))
      fun check_witness node proof =
        if Portable.pointer_eq
            (Thm.concl proof,G.representative graph node) andalso
            clean proof andalso List.all permitted (Thm.hyp proof)
        then proof else raise ERR operation
          "cross-block witness has invalid endpoint, hypotheses or tags"
      val witnesses = Option.map (fn supply => Vector.mapi
        (fn (index,Source node) =>
              if not (used index) orelse assignment node orelse
                  Option.isSome (image index) then NONE
              else Option.map (check_witness node) (supply (index,node))
          | (_,_) => NONE) leaves) supplied

      val proof = theorem block edge
      val _ = if Term.aconv (Thm.concl proof) target_name then ()
        else raise ERR operation "incorrect compact endpoint"
      val indices = Option.getOpt (selected,[])
      val active_leaves = case selected of NONE => leaves
        | SOME _ => Vector.fromList
            (List.map (fn index => Vector.sub (leaves,index)) indices)
      val compact = assemble_internal block edge
      val active_tree = #tree compact
      val law = #law compact
      val substitution = table_foldl
        (fn (_, (node,variable), list) =>
          {redex = variable,residue = resolved node} :: list) [] nodes
      fun pay amount=case owned_frame of NONE=>()
        | SOME(work,_)=>W.spend work amount
      fun captured proof=(fn _=>proof,Thm.hyp proof)
      fun capture (index,leaf)=
        (pay 4;case leaf of Source node=>
          if assignment node then
            (fn actual=>
              let val(left,right)=boolSyntax.dest_eq(Thm.concl actual)
                  val _=if Portable.pointer_eq(left,right)then ()else
                    raise ERR operation
                      "resolved solver assignment is not reflexive"
              in SmtReplayRuleObservation.REFL left end,[])
          else (case image index of SOME proof=>captured proof
            | NONE=>case Option.map
                (fn proofs=>Vector.sub(proofs,index)) witnesses of
                SOME(SOME proof)=>captured proof
              | _=>let val term=G.representative graph node
                in (fn _=>SmtReplayRuleObservation.ASSUME term,[term])end)
        | ClosedWitness fact=>captured(closed_proof fact)
        | ConversionWitness plan=>
            let val left=G.representative graph(conversion_source plan)
                val right=G.representative graph(conversion_target plan)
                val proof=conversion_proof plan
                fun run actual=
                  let val(a,b)=boolSyntax.dest_eq(Thm.concl actual)
                  in if Portable.pointer_eq(a,left)andalso
                      Portable.pointer_eq(b,right)then proof else
                    raise ERR operation "realized conversion endpoints differ"
                  end
            in (run,Thm.hyp proof)end
        | Definition _=>(fn actual=>
            let val(left,right)=boolSyntax.dest_eq(Thm.concl actual)
            in SmtReplayRuleObservation.ALPHA left right end,[]))
      val programme=case selected of NONE=>Vector.mapi capture leaves
        | SOME _=>Vector.map capture(Vector.fromList
            (ListPair.zip(indices,Vector.foldr op:: [] active_leaves)))
      (* Pointer union of retained witness Hyp, never a mixed-source kernel
         set or expanded comparison. This is a permitted-Hyp upper bound:
         the kernel may deduplicate distinct alpha-equal bounded Sources.
         It predicts DATA only; the native theorem is still checked below. *)
      fun member term []=(pay 1;false)
        | member term(held::rest)=
            (pay 1;Portable.pointer_eq(term,held)orelse member term rest)
      fun insert(term,rest)=
        (pay 2;if member term rest then rest else term::rest)
      val hypotheses=Vector.foldl
        (fn((_,terms),rest)=>List.foldl insert rest terms)[] programme
      val endpoint=G.representative graph target
      val epoch=Type.type_epoch() val symbols=Term.term_epoch()
      fun run()=
        let
          val _=if epoch=Type.type_epoch()andalso
              symbols=Term.term_epoch()then ()else
            raise ERR operation "declaration lifetime changed"
          val _=observe_proof graph #inst
          val instantiated=SmtReplayRuleObservation.INST substitution law
          val(antecedent,_)=boolSyntax.dest_imp(Thm.concl instantiated)
          val actual_leaves=Vector.fromList(project active_tree
            (SmtReplayRuleObservation.ASSUME antecedent))
          val actual_witnesses=Vector.mapi
            (fn(position,(discharge,_))=>
              discharge(Vector.sub(actual_leaves,position))) programme
          val result=SmtReplayRuleObservation.MP instantiated
            (tree_proof actual_witnesses active_tree)
          val _=if Portable.pointer_eq(Thm.concl result,endpoint)andalso
              clean result then ()else
            raise ERR operation "endpoint or tags changed"
          val _=retire_block block
        in result end
    in {run=run,endpoint=endpoint,hypotheses=hypotheses,
        assembly=compact} end


  (* Each target is an additional ordinary block Source with an authentic
     open-Hyp witness. Its source dependencies are copied ONLY from the
     held receipt, and never promoted from an external needed array. *)
  datatype source_cut_block = SourceCutBlock of
    {work : W.portfolio,block : block,frame : Scope.receipt,
     receipts : source_realization list,
     slot_origins : (int * source_origin) list,
     rows : (source_realization * int * int list) list}
  fun source_cut_block_guard_internal expected metered
      (SourceCutBlock {work,block,frame,receipts,slot_origins,rows}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "source_cut_block_guard" "different original Work";
      source_realization_guards_internal expected metered receipts;
      ignore (Scope.description_for expected frame);
      validate_block_for expected block;
      let val actual = Vector.fromList (sources block)
          fun equal (ActualSourceSlot (a,i),ActualSourceSlot (b,j)) =
                Portable.pointer_eq (a,b) andalso i=j
            | equal (OriginalPrefixSlot (a,i),OriginalPrefixSlot (b,j)) =
                Portable.pointer_eq (a,b) andalso i=j
            | equal _ = false
          fun origin slot = case List.find (fn (index,_) => index=slot)
              slot_origins of SOME (_,key) => key
            | NONE => raise ERR "source_cut_block_guard"
                "missing genuine slot origin"
          fun row (receipt as SourceRealization
              {target,occurrences,origins,...},index,supports) =
            if Vector.sub (actual,index) = target andalso
                ListPair.allEq (fn ((_,node),slot) =>
                  node = Vector.sub (actual,slot)) (occurrences,supports)
                andalso ListPair.allEq (fn ((_,key),slot) =>
                  equal (key,origin slot)) (origins,supports)
              then () else raise ERR "source_cut_block_guard"
                "actual target or promoted Source occurrences changed"
      in List.app row rows end)
     handle primary => (W.close expected;raise primary))
  fun source_cut_block_guard expected value =
    source_cut_block_guard_internal expected false value
  fun source_cut_block_guard_with_work expected value =
    source_cut_block_guard_internal expected true value
  fun source_cut_block_for expected (value as SourceCutBlock {block,...}) =
    (source_cut_block_guard expected value;block)

  fun prepare_source_cut_block expected
      {frame,roots,additional_sources,closed_facts,conversions,receipts} =
    ((List.app (source_realization_guard expected) receipts;
      let
        val data = Scope.description_for expected frame
        val graph = #graph data and scope = #scope data
        val cap = #template_limit (W.semantic_limits expected)
        val (frontier,rows,slot_origins) = W.with_step expected (fn () =>
          let
            val _ = source_realization_guards_with_work expected receipts
            fun pay n = W.spend expected n
            val _ = List.app (validate_conversion_for expected) conversions
            val _ = List.app
              (validate_conversion graph scope cap) conversions
            val _ = List.app
              (validate_closed_fact graph scope cap) closed_facts
            fun valid node =
              (pay 3;
               if G.scope_visible graph scope (G.node_scope graph node)
                 then () else raise ERR "prepare_source_cut_block"
                   "Source operand outside actual frame";
               ignore (G.view graph node);
               if Type.compare (G.type_of graph node,Type.bool) = EQUAL
                 then node else raise ERR "prepare_source_cut_block"
                   "Source operand is not Boolean")
            val prefix = List.map valid
              (SmtReplaySource.assumption_nodes (#sources data) @
               [SmtReplaySource.denied_goal_node (#sources data)])
            val extras = List.map valid additional_sources
            val _ = pay 1
            val extra_owner = ref ()
            val prefix_count = List.length prefix
            val base_count = prefix_count + List.length extras
            fun original_origins _ [] = []
              | original_origins index (node::rest) =
                  (pay 3;(OriginalPrefixSlot (#sources data,index),
                    node,index)::original_origins (index+1) rest)
            fun extra_origins _ [] = []
              | extra_origins index (node::rest) =
                  (pay 3;(ActualSourceSlot (extra_owner,index),node,index)::
                    extra_origins (index+1) rest)
            val initial = original_origins 0 prefix @
              extra_origins prefix_count extras
            val assigned = ref initial
            val appended = ref ([] : G.node list)
            val next = ref base_count
            fun equal (ActualSourceSlot (a,i),ActualSourceSlot (b,j)) =
                  Portable.pointer_eq (a,b) andalso i=j
              | equal (OriginalPrefixSlot (a,i),OriginalPrefixSlot (b,j)) =
                  Portable.pointer_eq (a,b) andalso i=j
              | equal _ = false
            fun reserve key node =
              let
                fun seek [] = (pay 1;NONE)
                  | seek ((old,actual,index)::rest) =
                      (pay 1;if equal (key,old) then
                         if actual=node then SOME index else
                           raise ERR "prepare_source_cut_block"
                             "shared occurrence changed actual Source node"
                       else seek rest)
              in case seek (!assigned) of SOME index => index
                | NONE =>
                  let val index = !next
                      val _ = pay 5
                      val _ = next := index+1
                      val _ = assigned := (key,node,index):: !assigned
                      val _ = appended := node :: !appended
                  in index end
              end
            fun retain [] = []
              | retain ((receipt as SourceRealization
                  {target,occurrences,origins,graph = held_graph,
                   original_sources,...})::rest) =
                let
                  val _ = source_realization_guard expected receipt
                  val _ = if Portable.pointer_eq (graph,held_graph) andalso
                      Portable.pointer_eq (#sources data,original_sources)
                    then () else raise ERR "prepare_source_cut_block"
                      "different original Source portfolio"
                  val supports = ListPair.mapEq
                    (fn ((_,node),(_,key)) => reserve key (valid node))
                    (occurrences,origins)
                  val _ = valid target
                  val index = !next
                  val _ = pay 3
                  val _ = next := index+1
                  val _ = appended := target :: !appended
                in (receipt,index,supports)::retain rest end
            val rows = retain receipts
            val promoted = List.rev (!appended)
            val sources = prefix @ extras @ promoted
            val slot_origins = List.map (fn (key,_,index) =>
              (pay 2;(index,key))) (!assigned)
            val cut_targets = List.map (fn SourceRealization {target,...} =>
              (pay 1;target)) receipts
            (* Original and independent ordinary demands dominate the cuts.
               Only receipt target slots may omit their constructor forest. *)
            val facts = List.map (fn fact => (pay 1;closed_node fact))
              closed_facts
            val conversion_roots = List.concat (List.map (fn conversion =>
              (pay 3;[conversion_source conversion,
                conversion_target conversion])) conversions)
            val support_roots = List.concat (List.map
              (fn SourceRealization {occurrences,...} =>
                List.map (fn (_,node) => (pay 1;node)) occurrences) receipts)
            val demanded = prefix @ extras @ support_roots @ facts @
              conversion_roots @ roots
            fun member node [] = false
              | member node (old::rest) =
                  (pay 1;node = old orelse member node rest)
            val seen = ref ([] : G.node list)
            val atoms = ref ([] : G.node list)
            fun visit [] = ()
              | visit (node::rest) =
                (pay 1;if member node (!seen) then visit rest else
                 let
                   val _ = pay 2
                   val _ = seen := node :: !seen
                   val _ = if G.scope_visible graph scope
                       (G.node_scope graph node) then () else
                     raise ERR "prepare_source_cut_block" "node escaped frame"
                   val cut = member node cut_targets andalso
                     not (member node demanded)
                   val children = if cut then
                       (pay 2;atoms := node :: !atoms;[]) else
                     case G.view graph node of
                       G.Application (a,b) => [a,b] | _ => []
                 in visit children;visit rest end)
            val _ = visit (cut_targets @ demanded)
            fun reverse [] answer = answer
              | reverse (node::rest) answer =
                  (pay 2;reverse rest (node::answer))
            val reachable = reverse (!seen) []
            val held = List.map (fn node =>
              (pay 2;G.closure_root graph scope node)) reachable
            val frontier = RealizationFrontier
              {work = expected,graph = graph,scope = scope,frame = frame,
               template_limit = cap,epoch = Type.type_epoch (),
               symbols = Term.term_epoch (),roots = roots,sources = sources,
               closed_facts = closed_facts,conversions = conversions,
               reachable = reachable,atoms = reverse (!atoms) [],
               held = held,retained_sources = NONE}
            val _ = source_realization_guards_with_work expected receipts
            val _ = frontier_guard expected frontier
          in (frontier,rows,slot_origins) end)
        val tables = W.with_step expected (fn () =>
          (source_realization_guards_with_work expected receipts;
           prepare_owned_realization_tables expected frontier))
        val block = W.with_step expected (fn () =>
          (source_realization_guards_with_work expected receipts;
           freeze_owned_needed_realization_tables_plan expected tables))
        val result = SourceCutBlock {work = expected,block = block,
          frame = frame,receipts = receipts,slot_origins = slot_origins,
          rows = rows}
        val _ = source_cut_block_guard expected result
      in result end)
     handle primary => (W.close expected;raise primary))

  fun prepare_source_cut_constructor_block expected
      {frame,roots,additional_sources,closed_facts,conversions,receipts} =
    ((List.app (source_realization_guard expected) receipts;
      let
        val data = Scope.description_for expected frame
        val graph = #graph data and scope = #scope data
        val cap = #template_limit (W.semantic_limits expected)
        val (frontier,rows,slot_origins) = W.with_step expected (fn () =>
          let
            val _ = source_realization_guards_with_work expected receipts
            fun pay n = W.spend expected n
            val _ = List.app (validate_conversion_for expected) conversions
            val _ = List.app
              (validate_conversion graph scope cap) conversions
            val _ = List.app
              (validate_closed_fact graph scope cap) closed_facts
            fun valid node =
              (pay 3;
               if G.scope_visible graph scope (G.node_scope graph node)
                 then () else raise ERR
                      "prepare_source_cut_constructor_block"
                   "Source operand outside actual frame";
               ignore (G.view graph node);
               if Type.compare (G.type_of graph node,Type.bool) = EQUAL
                 then node else raise ERR
                   "prepare_source_cut_constructor_block"
                   "Source operand is not Boolean")
            val prefix = List.map valid
              (SmtReplaySource.assumption_nodes (#sources data) @
               [SmtReplaySource.denied_goal_node (#sources data)])
            val extras = List.map valid additional_sources
            val _ = pay 1
            val extra_owner = ref ()
            val prefix_count = List.length prefix
            val base_count = prefix_count + List.length extras
            fun original_origins _ [] = []
              | original_origins index (node::rest) =
                  (pay 3;(OriginalPrefixSlot (#sources data,index),
                    node,index)::original_origins (index+1) rest)
            fun extra_origins _ [] = []
              | extra_origins index (node::rest) =
                  (pay 3;(ActualSourceSlot (extra_owner,index),node,index)::
                    extra_origins (index+1) rest)
            val initial = original_origins 0 prefix @
              extra_origins prefix_count extras
            val assigned = ref initial
            val appended = ref ([] : G.node list)
            val next = ref base_count
            fun equal (ActualSourceSlot (a,i),ActualSourceSlot (b,j)) =
                  Portable.pointer_eq (a,b) andalso i=j
              | equal (OriginalPrefixSlot (a,i),OriginalPrefixSlot (b,j)) =
                  Portable.pointer_eq (a,b) andalso i=j
              | equal _ = false
            fun reserve key node =
              let
                fun seek [] = (pay 1;NONE)
                  | seek ((old,actual,index)::rest) =
                      (pay 1;if equal (key,old) then
                         if actual=node then SOME index else
                           raise ERR "prepare_source_cut_constructor_block"
                             "shared occurrence changed actual Source node"
                       else seek rest)
              in case seek (!assigned) of SOME index => index
                | NONE =>
                  let val index = !next
                      val _ = pay 5
                      val _ = next := index+1
                      val _ = assigned := (key,node,index):: !assigned
                      val _ = appended := node :: !appended
                  in index end
              end
            fun retain [] = []
              | retain ((receipt as SourceRealization
                  {target,occurrences,origins,graph = held_graph,
                   original_sources,...})::rest) =
                let
                  val _ = source_realization_guard expected receipt
                  val _ = if Portable.pointer_eq (graph,held_graph) andalso
                      Portable.pointer_eq (#sources data,original_sources)
                    then () else raise ERR
                      "prepare_source_cut_constructor_block"
                      "different original Source portfolio"
                  val supports = ListPair.mapEq
                    (fn ((_,node),(_,key)) => reserve key (valid node))
                    (occurrences,origins)
                  val _ = valid target
                  val index = !next
                  val _ = pay 3
                  val _ = next := index+1
                  val _ = appended := target :: !appended
                in (receipt,index,supports)::retain rest end
            val rows = retain receipts
            val promoted = List.rev (!appended)
            val sources = prefix @ extras @ promoted
            val slot_origins = List.map (fn (key,_,index) =>
              (pay 2;(index,key))) (!assigned)
            (* Derive constructor authority from the SAME actual receipt.
               The application spine is concrete; argument holes are the
               exact recorded nodes, not arbitrary caller cut metadata. *)
            val spine_paths = ref ([] : G.closure_child list)
            fun receipt_spine (receipt as SourceRealization {target,...}) =
              let
                val _ = source_realization_guard expected receipt
                fun hold node =
                  (pay 3;spine_paths := G.closure_root graph scope node ::
                    !spine_paths)
                fun walk node =
                  let
                    val _ = hold node
                  in case G.view graph node of G.Application (a,b) =>
                    let val _ = hold b
                        val (operators,arguments) = walk a
                    in (node::operators,b::arguments) end
                  | G.Constant _ => ([node],[])
                  | G.Variable _ => ([node],[])
                  (* An opaque whole target confers no constructor spine. *)
                  | _ => ([],[node]) end
              in walk target end
            val spines = List.map receipt_spine receipts
            val constructor_roots = List.concat (List.map #1 spines)
            val cut_targets = List.concat (List.map #2 spines)
            (* Original and independent ordinary demands dominate the cuts.
               Only receipt target slots may omit their constructor forest. *)
            val facts = List.map (fn fact => (pay 1;closed_node fact))
              closed_facts
            val conversion_roots = List.concat (List.map (fn conversion =>
              (pay 3;[conversion_source conversion,
                conversion_target conversion])) conversions)
            val support_roots = List.concat (List.map
              (fn SourceRealization {occurrences,...} =>
                List.map (fn (_,node) => (pay 1;node)) occurrences) receipts)
            val demanded = prefix @ extras @ support_roots @ facts @
              conversion_roots @ roots @ constructor_roots
            fun member node [] = false
              | member node (old::rest) =
                  (pay 1;node = old orelse member node rest)
            val seen = ref ([] : G.node list)
            val atoms = ref ([] : G.node list)
            fun visit [] = ()
              | visit (node::rest) =
                (pay 1;if member node (!seen) then visit rest else
                 let
                   val _ = pay 2
                   val _ = seen := node :: !seen
                   val _ = if G.scope_visible graph scope
                       (G.node_scope graph node) then () else
                     raise ERR "prepare_source_cut_constructor_block"
                       "node escaped frame"
                   val cut = member node cut_targets andalso
                     not (member node demanded)
                   val children = if cut then
                       (pay 2;atoms := node :: !atoms;[]) else
                     case G.view graph node of
                       G.Application (a,b) => [a,b] | _ => []
                 in visit children;visit rest end)
            val _ = visit (cut_targets @ demanded)
            fun reverse [] answer = answer
              | reverse (node::rest) answer =
                  (pay 2;reverse rest (node::answer))
            val reachable = reverse (!seen) []
            val held = !spine_paths @ List.map (fn node =>
              (pay 2;G.closure_root graph scope node)) reachable
            val frontier = RealizationFrontier
              {work = expected,graph = graph,scope = scope,frame = frame,
               template_limit = cap,epoch = Type.type_epoch (),
               symbols = Term.term_epoch (),roots = roots,sources = sources,
               closed_facts = closed_facts,conversions = conversions,
               reachable = reachable,atoms = reverse (!atoms) [],
               held = held,retained_sources = NONE}
            val _ = source_realization_guards_with_work expected receipts
            val _ = frontier_guard expected frontier
          in (frontier,rows,slot_origins) end)
        val tables = W.with_step expected (fn () =>
          (source_realization_guards_with_work expected receipts;
           prepare_owned_realization_tables expected frontier))
        val block = W.with_step expected (fn () =>
          (source_realization_guards_with_work expected receipts;
           freeze_owned_needed_realization_tables_plan expected tables))
        val result = SourceCutBlock {work = expected,block = block,
          frame = frame,receipts = receipts,slot_origins = slot_origins,
          rows = rows}
        val _ = source_cut_block_guard expected result
      in result end)
     handle primary => (W.close expected;raise primary))


  (* A closed theorem supplies its own implication grammar. This metadata
     cannot create an assertion, replace a Source, or classify caller atoms.
     Only its outer shell is needed for one genuinely checked named MP. *)
  datatype closed_law_spine = ClosedLawSpine of
    {work:W.portfolio,frame:Scope.receipt,graph:G.graph,scope:G.scope,
     sources:SmtReplaySource.sources,fact:closed_fact,law:G.node,
     premises:G.node list,target:G.node,constructors:G.node list,
     holes:G.node list,layers:(G.node list * G.node list) list,
     held:G.closure_child list,epoch:int,symbols:int}

  fun closed_law_spine_guard expected
      (ClosedLawSpine {work,frame,graph,scope,sources,fact,held,
                       epoch,symbols,...}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "closed_law_spine" "different original Work";
      let val actual = Scope.description_for expected frame
          val _ = if Portable.pointer_eq (#graph actual,graph) andalso
              #scope actual=scope andalso
              Portable.pointer_eq (#sources actual,sources) andalso
              epoch=Type.type_epoch () andalso symbols=Term.term_epoch ()
            then () else raise ERR "closed_law_spine"
              "closed law frame or epoch changed"
          val cap = #template_limit (W.semantic_limits expected)
          val _ = validate_closed_fact graph scope cap fact
      in List.app (fn child =>
        ignore (G.closure_child_node graph scope child)) held end)
     handle primary => (W.close expected;raise primary))

  fun prepare_closed_law_spine expected {frame,fact,premises,target} =
    ((W.with_step expected (fn () =>
      let
        val actual = Scope.description_for expected frame
        val graph = #graph actual and scope = #scope actual
        val _ = case fact of ClosedFact {graph=owner,scope=origin,...} =>
            if Portable.pointer_eq (graph,owner) andalso scope=origin
              then () else raise ERR "closed_law_spine"
                "different exact closed law frame"
          | _ => raise ERR "closed_law_spine" "finite closed fact required"
        val cap = #template_limit (W.semantic_limits expected)
        val _ = validate_closed_fact graph scope cap fact
        val law = closed_node fact
        val held = ref ([]:G.closure_child list)
        fun node current =
          (W.spend expected 3;
           held := G.closure_root graph scope current :: !held;
           if Type.compare (G.type_of graph current,Type.bool)=EQUAL then ()
           else raise ERR "closed_law_spine" "non-Boolean law endpoint")
        fun chain current [] =
              (node current;
               if current=target then [] else
                 raise ERR "closed_law_spine" "law target differs")
          | chain current (premise::rest) =
              (node current;node premise;
               case G.view graph current of G.Application (partial,tail) =>
                 (case G.view graph partial of G.Application (head,input) =>
                    (W.spend expected 4;
                     if input=premise andalso
                         (case G.view graph head of G.Constant _ =>
                            Term.same_const (G.representative graph head)
                              boolSyntax.implication
                          | _ => false) then () else
                       raise ERR "closed_law_spine"
                         "ordered law premise or implication head differs";
                     held := G.closure_root graph scope partial ::
                       G.closure_root graph scope head :: !held;
                     let val next = chain tail rest
                         val _ = W.spend expected 2
                     in ([current,partial,head],[premise,tail]) :: next end)
                  | _ => raise ERR "closed_law_spine"
                      "missing typed implication operator")
               | _ => raise ERR "closed_law_spine"
                   "missing actual implication shell")
        val layers = chain law premises
        val (constructors,holes) = case layers of [] => ([],[law])
          | first::_ => first
        val result = ClosedLawSpine
          {work=expected,frame=frame,graph=graph,scope=scope,
           sources= #sources actual,fact=fact,law=law,premises=premises,
           target=target,constructors=constructors,holes=holes,layers=layers,
           held= !held,
           epoch=Type.type_epoch (),symbols=Term.term_epoch ()}
        val _ = closed_law_spine_guard expected result
      in result end)) handle primary => (W.close expected;raise primary))

  (* Select only a prefix of the already checked actual implication
     shells. No term, cut predicate, endpoint or proof is supplied here. *)
  fun closed_law_spine_prefix_for expected
      (saved as ClosedLawSpine {work,frame,graph,scope,sources,fact,law,
        premises,target,layers,held,epoch,symbols,...}) count =
    ((W.with_step expected (fn () =>
      let
        val _ = closed_law_spine_guard expected saved
        val _ = if count>=0 then () else
          raise ERR "closed_law_spine" "negative actual shell prefix"
        fun append [] tail = (W.spend expected 1;tail)
          | append (node::rest) tail =
              (W.spend expected 2;node :: append rest tail)
        fun take 0 _ = ([],[law])
          | take n [] = raise ERR "closed_law_spine"
              "actual shell prefix exceeds captured law"
          | take n ((constructors,holes)::rest) =
              (W.spend expected 2;
               if n=1 then (constructors,holes) else
                 let val (more,operands) = take (n-1) rest
                 in (append constructors more,append holes operands) end)
        val (constructors,holes) = take count layers
        val _ = closed_law_spine_guard expected saved
      in ClosedLawSpine
        {work=work,frame=frame,graph=graph,scope=scope,sources=sources,
         fact=fact,law=law,premises=premises,target=target,layers=layers,
         constructors=constructors,holes=holes,held=held,
         epoch=epoch,symbols=symbols} end))
     handle primary => (W.close expected;raise primary))

  fun closed_law_spine_data_for expected
      (saved as ClosedLawSpine {law,premises,target,...}) =
    (closed_law_spine_guard expected saved;
     {law=law,premises=premises,target=target})

  datatype source_cut_rule_plan = SourceCutRulePlan of
    {work:W.portfolio,frame:Scope.receipt,receipts:source_realization list,
     frontier:realization_frontier,
     slot_origins:(int * source_origin) list,
     rows:(source_realization * int * int list) list,
     footprint:{raw:IntInf.int,inclusive:IntInf.int,
       leaves:IntInf.int} option ref,used:bool ref}

  fun prepare_source_cut_rule_plan_internal expected law_spines
      {frame,roots,additional_sources,closed_facts,conversions,receipts,
       targets,boolean,congruence} =
    ((List.app (closed_law_spine_guard expected) law_spines;
      List.app (source_realization_guard expected) receipts;
      let
        val data = Scope.description_for expected frame
        val graph = #graph data and scope = #scope data
        val cap = #template_limit (W.semantic_limits expected)
        val ordinary_closed_facts = closed_facts
        val _ = List.app (fn saved as ClosedLawSpine
            {frame=origin,...} =>
          (closed_law_spine_guard expected saved;
           if Portable.pointer_eq (origin,frame) then () else
             raise ERR "closed_law_spine" "different actual Scope receipt"))
          law_spines
        val (frontier,rows,slot_origins) = W.with_step expected (fn () =>
          let
            val _ = source_realization_guards_with_work expected receipts
            (* This frontier visitor has no discovery/policy callbacks.
               Keep all actual Source occurrences, constructor incidence,
               gate traversal and lifetime guards, but share its metadata
               carrier rather than walking Work's scope path per list cell. *)
            val pay=compact_callback_free_payer_with_quantum 1024 expected
            (* Exact structural membership only, never Source occurrence
               authority. Keep every original occurrence in the lists/rows
               below; replace just repeated linear membership scans by
               bounded routing and full node probes on every collision. *)
            fun node_set () =
              (pay 130;Array.array (127,[] : G.node list))
            fun node_bucket node =
              (pay 5;Int.mod (G.node_id node,127))
            fun node_member table node =
              let val index=node_bucket node
                  fun seek [] = (pay 1;false)
                    | seek (old::rest) =
                        (pay 2;node=old orelse seek rest)
              in seek (Array.sub (table,index)) end
            fun node_add table node =
              let val index=node_bucket node val _=pay 4
              in Array.update (table,index,node::Array.sub (table,index)) end
            fun node_index nodes =
              let val table=node_set ()
                  val _=List.app (node_add table) nodes
              in table end
            fun include_laws [] = closed_facts
              | include_laws (ClosedLawSpine {fact,...}::rest) =
                  (pay 2;fact :: include_laws rest)
            val closed_facts = if null law_spines then closed_facts
              else include_laws law_spines
            val _ = List.app (validate_conversion_for expected) conversions
            val _ = List.app
              (validate_conversion graph scope cap) conversions
            val _ = List.app
              (validate_closed_fact graph scope cap) closed_facts
            fun valid node =
              (pay 3;
               if G.scope_visible graph scope (G.node_scope graph node)
                 then () else raise ERR
                      "prepare_source_cut_rule_block"
                   "Source operand outside actual frame";
               ignore (G.view graph node);
               if Type.compare (G.type_of graph node,Type.bool) = EQUAL
                 then node else raise ERR
                   "prepare_source_cut_rule_block"
                   "Source operand is not Boolean")
            val prefix = List.map valid
              (SmtReplaySource.assumption_nodes (#sources data) @
               [SmtReplaySource.denied_goal_node (#sources data)])
            val extras = List.map valid additional_sources
            val _ = pay 1
            val extra_owner = ref ()
            val prefix_count = List.length prefix
            val base_count = prefix_count + List.length extras
            fun original_origins _ [] = []
              | original_origins index (node::rest) =
                  (pay 3;(OriginalPrefixSlot (#sources data,index),
                    node,index)::original_origins (index+1) rest)
            fun extra_origins _ [] = []
              | extra_origins index (node::rest) =
                  (pay 3;(ActualSourceSlot (extra_owner,index),node,index)::
                    extra_origins (index+1) rest)
            val initial = original_origins 0 prefix @
              extra_origins prefix_count extras
            val assigned = ref initial
            val appended = ref ([] : G.node list)
            val next = ref base_count
            fun equal (ActualSourceSlot (a,i),ActualSourceSlot (b,j)) =
                  Portable.pointer_eq (a,b) andalso i=j
              | equal (OriginalPrefixSlot (a,i),OriginalPrefixSlot (b,j)) =
                  Portable.pointer_eq (a,b) andalso i=j
              | equal _ = false
            fun reserve key node =
              let
                fun seek [] = (pay 1;NONE)
                  | seek ((old,actual,index)::rest) =
                      (pay 1;if equal (key,old) then
                         if actual=node then SOME index else
                           raise ERR "prepare_source_cut_rule_block"
                             "shared occurrence changed actual Source node"
                       else seek rest)
              in case seek (!assigned) of SOME index => index
                | NONE =>
                  let val index = !next
                      val _ = pay 5
                      val _ = next := index+1
                      val _ = assigned := (key,node,index):: !assigned
                      val _ = appended := node :: !appended
                  in index end
              end
            fun retain [] = []
              | retain ((receipt as SourceRealization
                  {target,occurrences,origins,graph = held_graph,
                   original_sources,...})::rest) =
                let
                  val _ = source_realization_guard expected receipt
                  val _ = if Portable.pointer_eq (graph,held_graph) andalso
                      Portable.pointer_eq (#sources data,original_sources)
                    then () else raise ERR
                      "prepare_source_cut_rule_block"
                      "different original Source portfolio"
                  val supports = ListPair.mapEq
                    (fn ((_,node),(_,key)) => reserve key (valid node))
                    (occurrences,origins)
                  val _ = valid target
                  val index = !next
                  val _ = pay 3
                  val _ = next := index+1
                  val _ = appended := target :: !appended
                in (receipt,index,supports)::retain rest end
            val rows = retain receipts
            val promoted = List.rev (!appended)
            val sources = prefix @ extras @ promoted
            val slot_origins = List.map (fn (key,_,index) =>
              (pay 2;(index,key))) (!assigned)
            (* Derive constructor authority from the SAME actual receipt.
               The application spine is concrete; argument holes are the
               exact recorded nodes, not arbitrary caller cut metadata. *)
            val spine_paths = ref ([] : G.closure_child list)
            fun node_spine target =
              let
                fun hold node =
                  (pay 3;spine_paths := G.closure_root graph scope node ::
                    !spine_paths)
                fun walk node =
                  let val _ = hold node
                  in case G.view graph node of G.Application (a,b) =>
                    let val _ = hold b
                        val (operators,arguments) = walk a
                    in (node::operators,b::arguments) end
                  | G.Constant _ => ([node],[])
                  | G.Variable _ => ([node],[])
                  | _ => ([],[node]) end
              in walk target end
            fun receipt_spine (receipt as SourceRealization {target,...}) =
              (source_realization_guard expected receipt;node_spine target)
            fun arguments node operands =
              (pay 2;ignore (G.closure_root graph scope node);
               case G.view graph node of G.Application (operator,operand) =>
                   arguments operator (operand::operands)
                 | G.Constant _ =>
                     SOME (G.representative graph node,operands)
                 | _ => NONE)
            (* This is exactly the concrete Boolean gate grammar used by
               the checked Boolean assembler, not semantic atom guessing. *)
            fun gate node = case arguments node [] of NONE => NONE
              | SOME (head,operands) =>
                let val arity = List.length operands
                    fun constant wanted = Term.same_const head wanted
                    val connective =
                      (arity=0 andalso (constant boolSyntax.T orelse
                        constant boolSyntax.F)) orelse
                      (arity=1 andalso constant boolSyntax.negation) orelse
                      (arity=2 andalso (constant boolSyntax.conjunction
                        orelse constant boolSyntax.disjunction orelse
                        constant boolSyntax.implication orelse
                        constant boolSyntax.equality)) orelse
                      (arity=3 andalso constant boolSyntax.conditional)
                    fun boolean node =
                      (pay 1;Type.compare
                        (G.type_of graph node,Type.bool)=EQUAL)
                in if connective andalso List.all boolean operands
                  then SOME operands else NONE end
            val gate_done = ref ([] : G.node list)
            fun seen node [] = (pay 1;false)
              | seen node (old::rest) =
                  (pay 1;node=old orelse seen node rest)
            fun gates node =
              let val _ = pay 2
                  val _ = ignore (G.closure_root graph scope node)
              in if seen node (!gate_done) then [] else
                (pay 2;gate_done := node :: !gate_done;
                 case gate node of NONE => [([],[node])]
                 | SOME operands => node_spine node ::
                     List.concat (List.map gates operands)) end
            val actual_targets = List.map valid targets
            val target_anchors = if boolean then [] else
              List.map (fn node => node_spine node) actual_targets
            val relation_roots = actual_targets @
              List.map (fn SourceRealization {target,...} => target) receipts
            fun equation node = case arguments node [] of
                SOME (head,[left,right]) =>
                  if Term.same_const head boolSyntax.equality then
                    SOME (left,right) else NONE
              | _ => NONE
            val known_pairs = List.mapPartial equation
              (List.map (fn SourceRealization {target,...} => target) receipts)
            val pairs_done = ref ([] : (G.node * G.node) list)
            fun same_pair (left,right) (a,b) =
              (left=a andalso right=b) orelse (left=b andalso right=a)
            fun proved pair = List.exists (fn old =>
              (pay 1;same_pair pair old)) known_pairs
            fun pair (left,right) =
              let val _ = pay 4
                  val _ = ignore (G.closure_root graph scope left)
                  val _ = ignore (G.closure_root graph scope right)
              in if left=right orelse proved (left,right) orelse
                  List.exists (fn old =>
                    (pay 1;same_pair (left,right) old)) (!pairs_done) then []
                else
                  (pay 2;pairs_done := (left,right) :: !pairs_done;
                   case (G.view graph left,G.view graph right) of
                     (G.Application (f,x),G.Application (g,y)) =>
                       ([left,right],[f,x,g,y]) :: (pair (f,g) @ pair (x,y))
                   | _ => []) end
            val congruence_spines = if congruence then List.concat
              (List.map (fn node => case equation node of
                 SOME operands => pair operands | NONE => []) actual_targets)
              else []
            val spines = List.map receipt_spine receipts @
              (if boolean then List.concat (List.map gates relation_roots)
               else []) @
              List.map node_spine (List.filter (fn node =>
                Option.isSome (equation node)) relation_roots) @
              target_anchors @ congruence_spines
            val constructor_roots = List.concat (List.map #1 spines) @
              List.concat (List.map (fn ClosedLawSpine {constructors,...} =>
                constructors) law_spines)
            val cut_targets = List.concat (List.map #2 spines) @
              List.concat (List.map (fn ClosedLawSpine {holes,...} => holes)
                law_spines)
            (* Original and independent ordinary demands dominate the cuts.
               Only receipt target slots may omit their constructor forest. *)
            val facts = List.map (fn fact => (pay 1;closed_node fact))
              ordinary_closed_facts
            val conversion_roots = List.concat (List.map (fn conversion =>
              (pay 3;[conversion_source conversion,
                conversion_target conversion])) conversions)
            val support_roots = List.concat (List.map
              (fn SourceRealization {occurrences,...} =>
                List.map (fn (_,node) => (pay 1;node)) occurrences) receipts)
            val ordinary_roots = prefix @ extras @ support_roots @ facts @
              conversion_roots @ roots
            (* Independent ordinary demand means the WHOLE App forest.
               A law's shell roots must not propagate that same permission
               into its holes. Precompute the former before visiting cuts,
               so even a hole reached first cannot hide an ordinary child. *)
            fun ordinary_closure () =
              let
                val _ = pay 1
                val table = ref (R.empty_int () : G.node list R.int_map)
                val result = ref ([]:G.node list)
                fun member _ [] = (pay 1;false)
                  | member node (old::rest) =
                      (pay 1;node=old orelse member node rest)
                fun walk [] = pay 1
                  | walk (node::rest) =
                    let
                      val _ = pay 3
                      val _ = if G.scope_visible graph scope
                          (G.node_scope graph node) then () else
                        raise ERR "prepare_source_cut_rule_block"
                          "ordinary demand escaped actual frame"
                      val key = G.node_id node
                      val current = !table
                      val query = W.legacy_plan_lookup_int expected (current,key)
                      val bucket = case R.int_lookup_value (current,query) of
                          NONE => [] | SOME held => held
                    in if member node bucket then walk rest else
                      let
                        val insertion = W.legacy_plan_insert_int expected (current,key)
                        val _ = pay 4
                        val _ = table := R.finish_int
                          (current,insertion,node::bucket)
                        val _ = result := node :: !result
                      in case G.view graph node of
                          G.Application (left,right) =>
                            (pay 2;walk (left::right::rest))
                        | _ => walk rest
                      end
                    end
                val _ = walk ordinary_roots
              in !result end
              handle R.Limit => W.abort_work_limit expected
            val demanded = (if null law_spines then ordinary_roots
              else ordinary_closure ()) @ constructor_roots
            val demand_index=node_index demanded
            val cut_index=node_index cut_targets
            val seen_index=node_set ()
            val seen = ref ([] : G.node list)
            val atoms = ref ([] : G.node list)
            fun visit [] = ()
              | visit (node::rest) =
                (pay 1;if node_member seen_index node then visit rest else
                 let
                   val _ = pay 2
                   val _ = seen := node :: !seen
                   val _ = node_add seen_index node
                   val _ = if G.scope_visible graph scope
                       (G.node_scope graph node) then () else
                     raise ERR "prepare_source_cut_rule_block"
                       "node escaped frame"
                   val cut = node_member cut_index node andalso
                     not (node_member demand_index node)
                   val children = if cut then
                       (pay 2;atoms := node :: !atoms;[]) else
                     case G.view graph node of
                       G.Application (a,b) => [a,b] | _ => []
                 in visit children;visit rest end)
            val _ = visit (cut_targets @ demanded)
            fun reverse [] answer = answer
              | reverse (node::rest) answer =
                  (pay 2;reverse rest (node::answer))
            val reachable = reverse (!seen) []
            val held = List.concat (List.map
              (fn ClosedLawSpine {held,...} => held) law_spines) @
              !spine_paths @ List.map (fn node =>
              (pay 2;G.closure_root graph scope node)) reachable
            val frontier = RealizationFrontier
              {work = expected,graph = graph,scope = scope,frame = frame,
               template_limit = cap,epoch = Type.type_epoch (),
               symbols = Term.term_epoch (),roots = roots,sources = sources,
               closed_facts = closed_facts,conversions = conversions,
               reachable = reachable,atoms = reverse (!atoms) [],
               held = held,retained_sources = NONE}
            val _ = source_realization_guards_with_work expected receipts
            val _ = frontier_guard expected frontier
          in (frontier,rows,slot_origins) end)
      in SourceCutRulePlan {work=expected,frame=frame,receipts=receipts,
        frontier=frontier,slot_origins=slot_origins,rows=rows,
        footprint=ref NONE,used=ref false} end)
     handle primary => (W.close expected;raise primary))

  fun prepare_source_cut_rule_plan expected request =
    prepare_source_cut_rule_plan_internal expected [] request

  fun prepare_source_cut_rule_law_plan expected
      {frame,roots,additional_sources,closed_facts,conversions,receipts,
       targets,boolean,congruence,laws} =
    prepare_source_cut_rule_plan_internal expected laws
      {frame=frame,roots=roots,additional_sources=additional_sources,
       closed_facts=closed_facts,conversions=conversions,receipts=receipts,
       targets=targets,boolean=boolean,congruence=congruence}

  (* A borrowed frontier contains no native placeholders or proof effect.
     These counts are the exact compact leaf syntax later made by freeze,
     not an admission for an expanded Source or a caller-selected atom. *)
  fun source_cut_rule_plan_guard expected
      (SourceCutRulePlan {work,frame,receipts,frontier,...}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "source_cut_rule_plan" "different original Work";
      source_realization_guards_with_work expected receipts;
      ignore (Scope.description_for expected frame);
      frontier_guard expected frontier)
     handle primary => (W.close expected;raise primary))

  fun realization_frontier_footprint_internal expected frontier =
    let
      val _ = frontier_guard expected frontier
      val RealizationFrontier {graph,sources,closed_facts,
        conversions,reachable,atoms,...} = frontier
      fun count [] total = (W.spend expected 1;total)
        | count (_::rest) total =
            (W.spend expected 2;count rest (total+1))
      fun atom _ [] = (W.spend expected 1;false)
        | atom node (held::rest) =
            (W.spend expected 1;
             node=held orelse atom node rest)
      fun definitions [] leaves syntax =
            (W.spend expected 1;(leaves,syntax))
        | definitions (node::rest) leaves syntax =
            (W.spend expected 2;
             if atom node atoms then definitions rest leaves syntax
             else case G.view graph node of
               G.Application _ =>
                 definitions rest (leaves+1) (syntax+7)
             | G.Constant _ =>
                 definitions rest (leaves+1) (syntax+5)
             | _ => definitions rest leaves syntax)
      val sources = count sources (0:IntInf.int)
      val facts = count closed_facts (0:IntInf.int)
      val conversions = count conversions (0:IntInf.int)
      val (leaves,syntax) = definitions reachable
        (sources+facts+conversions) (sources+facts+5*conversions)
      val raw = if leaves=0 then 1 else syntax+3*(leaves-1)
      val result = {raw=raw,inclusive=raw,leaves=leaves}
    in result end

  fun realization_frontier_footprint_for expected frontier =
    ((W.with_step expected (fn () =>
        realization_frontier_footprint_internal expected frontier))
     handle primary => (W.close expected;raise primary))

  fun source_cut_rule_footprint_for expected
      (saved as SourceCutRulePlan {frontier,footprint,...}) =
    ((W.with_step expected (fn () =>
      let
        val _ = source_cut_rule_plan_guard expected saved
      in case !footprint of SOME result => result
        | NONE =>
          let
            val result = realization_frontier_footprint_internal
              expected frontier
            val _ = source_cut_rule_plan_guard expected saved
            val _ = footprint := SOME result
          in result end
      end)) handle primary => (W.close expected;raise primary))

  fun freeze_source_cut_rule_plan_internal expected checked
      (saved as SourceCutRulePlan
        {frame,receipts,frontier,slot_origins,rows,used,...}) =
    ((let
        val _ = if checked then
            let val actual = source_cut_rule_footprint_for expected saved
                val cap = IntInf.fromInt
                  (#template_limit (W.semantic_limits expected))
            in if #raw actual<=cap andalso #inclusive actual<=cap then ()
              else raise ERR "freeze_source_cut_rule_plan"
                "compact context exceeds template bound" end
          else ()
        val tables = W.with_step expected (fn () =>
          (source_realization_guards_with_work expected receipts;
           if checked then
             (source_cut_rule_plan_guard expected saved;
              if !used then raise ERR "freeze_source_cut_rule_plan"
                "plan already used" else used := true)
           else ();
           prepare_owned_realization_tables expected frontier))
        val block = W.with_step expected (fn () =>
          (source_realization_guards_with_work expected receipts;
           freeze_owned_needed_realization_tables_plan expected tables))
        val result = SourceCutBlock {work = expected,block = block,
          frame = frame,receipts = receipts,slot_origins = slot_origins,
          rows = rows}
        val _ = source_cut_block_guard expected result
      in result end)
     handle primary => (W.close expected;raise primary))

  fun freeze_source_cut_rule_plan expected plan =
    freeze_source_cut_rule_plan_internal expected true plan

  (* The established entry retains its exact preparation/freeze programme.
     The new bounded consumer separately pays its prospective footprint. *)
  fun prepare_source_cut_rule_block expected request =
    freeze_source_cut_rule_plan_internal expected false
      (prepare_source_cut_rule_plan expected request)


  fun source_cut_edge_for expected
      (value as SourceCutBlock {block,rows,...}) receipt =
    ((source_cut_block_guard expected value;
      W.with_step expected (fn () =>
      let
        val _ = source_cut_block_guard_with_work expected value
        val row = case List.find (fn (held,_,_) =>
            Portable.pointer_eq (held,receipt)) rows of SOME row => row
          | NONE => raise ERR "source_cut_edge_for"
              "receipt was not reserved in this exact block"
        val (SourceRealization {target,...},index,_) = row
        val supports = List.concat (List.map
          (fn (SourceRealization {target = other,...},_,slots) =>
            if target = other then slots else []) rows)
        val edge = source block index
        val Block {template_limit,...} = block
        (* Keep each genuine support dependency even if the kernel theorem
           merges pointer-identical Hyp. Quote named future rules first. *)
        fun retain (slot,result) =
          let
            val support = source block slot
            val left = Thm.concl (theorem block result)
            val right = Thm.concl (theorem block support)
            val _ = owned_sparse_projection_quote expected template_limit
              (Vector.fromList [left,right])
            fun size count term = case count template_limit term of
                SOME value => value
              | NONE => raise ERR "source_cut_edge_for"
                  "named support exceeds original cap"
            val raw = 3 + size SmtReplayImport.bounded_raw_size left +
              size SmtReplayImport.bounded_raw_size right
            val inclusive = 3 +
              size SmtReplayImport.bounded_binder_size left +
              size SmtReplayImport.bounded_binder_size right
            val _ = if raw <= template_limit andalso
                inclusive <= template_limit then () else
              raise ERR "source_cut_edge_for"
                "future support conjunction exceeds original cap"
            val _ = W.spend expected raw
            val _ = W.spend expected inclusive
            val future = boolSyntax.mk_conj (left,right)
            val _ = owned_sparse_projection_quote expected template_limit
              (Vector.fromList [future])
            val joined = compose block
              (fn [a,b] => SmtReplayRuleObservation.CONJ a b
                | _ => raise ERR "source_cut_edge_for" "internal arity")
              [result,support]
          in compose block
            (fn [proof] => SmtReplayRuleObservation.CONJUNCT1 proof
              | _ => raise ERR "source_cut_edge_for" "internal arity")
            [joined] end
        val result = List.foldl retain edge supports
        val _ = source_cut_block_guard_with_work expected value
      in result end))
     handle primary => (W.close expected;raise primary))

  fun realize_source_cut_receipt expected
      (value as SourceCutBlock {block,receipts,rows,slot_origins,...})
      target edge =
    let
      val _ = source_cut_block_guard expected value
      val Block {graph,scope,leaves,nodes,template_limit,owned_frame,
                       leaf_index,owned_names,...} = block
    in ((validate_block_for expected block;
      W.with_step expected (fn () =>
      let
        val _ = source_cut_block_guard_with_work expected value
        val frame = case owned_frame of SOME (_,frame) => frame
          | NONE => raise ERR "realize_source_cut_receipt" "unowned block"
        val data = Scope.description_for expected frame
        val _ = if Option.isSome leaf_index then () else
          raise ERR "realize_source_cut_receipt"
            "actual sparse dependency metadata required"
        val names = case owned_names of SOME names => names
          | NONE => raise ERR "realize_source_cut_receipt"
              "missing authentic named vocabulary"
        val proof = theorem block edge
        val target_name = name block target
        val terms = Thm.concl proof :: Thm.hyp proof
        val _ = fixed_guard_retained_operands expected names
          template_limit terms
        val _ = owned_sparse_projection_quote expected template_limit
          (Vector.fromList terms)
        val indices = needed_leaves block edge
        val _ = List.app (fn _ => W.spend expected 1) indices
        val selected_terms = Vector.fromList (List.map (fn index =>
          (W.spend expected 1;leaf_term (name block)
            (Vector.sub (leaves,index)))) indices)
        val active_tree = make_tree 0 (Vector.length selected_terms)
        val active_context = tree_term selected_terms active_tree
        fun raw term = case SmtReplayImport.bounded_raw_size
            template_limit term of SOME count => count
          | NONE => raise ERR "realize_source_cut_receipt"
              "actual named operand exceeds original raw cap"
        fun inclusive term = case SmtReplayImport.bounded_binder_size
            template_limit term of SOME count => count
          | NONE => raise ERR "realize_source_cut_receipt"
              "actual named operand exceeds original binder cap"
        val raw_law = 3 + raw active_context + raw target_name
        val inc_law = 3 + inclusive active_context + inclusive target_name
        val _ = if raw_law <= template_limit andalso
            inc_law <= template_limit then () else
          raise ERR "realize_source_cut_receipt"
            "prospective actual DISCH law exceeds original cap"
        val _ = W.spend expected raw_law
        val _ = W.spend expected inc_law
        val _ = owned_sparse_projection_quote expected template_limit
          (Vector.fromList [active_context,target_name])
        val source_frame as RetainedSourceFrame
            {original_slots,...} = retained_source_frame_for expected block []
        val needed = needed_source_occurrences block edge
        fun member slot = List.exists (fn actual =>
          (W.spend expected 1;slot = actual)) needed
        fun support (_,index,slots) = if not (member index) then () else
          if List.all member slots then () else
            raise ERR "realize_source_cut_receipt"
              "authentic Source support was not carried by the edge"
        val _ = List.app support rows
        fun discharged slot = List.exists (fn (_,index,_) =>
          (W.spend expected 1;slot = index)) rows
        val needed = List.filter (fn slot => not (discharged slot)) needed
        val occurrences = List.map (fn index =>
          (W.spend expected 1;(index,List.nth (original_slots,index)))) needed
        val held = table_foldl (fn (_, (node,_),rest) =>
          (W.spend expected 2;G.closure_root graph scope node :: rest)) [] nodes
        val facts = Vector.foldr
          (fn (ClosedWitness fact,rest) => fact::rest | (_,rest) => rest)
          [] leaves
        val conversions = Vector.foldr
          (fn (ConversionWitness plan,rest) => plan::rest | (_,rest) => rest)
          [] leaves
        val _ = List.app (validate_conversion_for expected) conversions
        val _ = retained_source_guard expected source_frame
        fun supply (index,_) = case List.find (fn (_,slot,_) =>
            slot = index) rows of NONE => NONE
          | SOME (receipt,_,_) =>
              SOME (source_realization_theorem_for expected receipt)
        val _ = source_cut_block_guard_with_work expected value
        val compact_cuts = List.map (fn (receipt,index,_) =>
          (index,leaf_term (name block) (Vector.sub (leaves,index)),
           receipt)) rows
        val prepared = prepare_source_cut_internal block NONE target edge
          (SOME supply) NONE
        val _ = source_realization_guards_with_work expected receipts
        val epoch=Type.type_epoch () val symbols=Term.term_epoch ()
        fun make result = SourceRealization
          {work = expected,source_frame = source_frame,graph = graph,
           root = #root data,scope = scope,frame = frame,
           original_sources = #sources data,target = target,
           occurrences = occurrences,
           origins = List.map (fn (index,_) =>
             case List.find (fn (slot,_) => slot=index) slot_origins of
               SOME (_,key) => (index,key)
             | NONE => raise ERR "realize_source_cut_receipt"
                 "missing genuine support occurrence origin") occurrences,
           theorem = result,
           compact = SourceCompact {block = block,edge = edge,
             target_name = target_name,proof = proof,needed = indices,
             names = List.map #2 (table_list nodes),extra_leaves = [],
             cuts = compact_cuts,closed = SOME (#assembly prepared)},
           held = held,
           facts = facts,conversions = conversions,
           template_limit = template_limit,parents = receipts,
           epoch = epoch,symbols = symbols}
        val finish=preflight_source_realization expected make
          (#endpoint prepared,#hypotheses prepared)
        val result= #run prepared ()
      in finish result end))
     handle primary => (W.close expected;raise primary)) end


  (* A retained closure borrows the same compact operands at many rule
     ports. Keep only immutable geometry, with exact pointer probes on every
     hit. In particular, a hit is NOT a future native-work allowance: quote
     below pays both complete portfolios afresh, including every repeated
     annotation. Bottom-up App composition avoids walking borrowed children
     again as the balanced context is projected and lifted. *)
  type retained_geometry={raw:int,inc:int,ann:int}
  fun retained_sparse_quoter work limit =
    let
      val pay=compact_callback_free_payer_with_quantum 4096 work
      type geometry=retained_geometry
      val _=pay 130
      val rows=Array.array (127,[] : (Term.term * geometry) list)
      val _=pay 4
      val hot=ref ([] : (Term.term * geometry) list)
      (* Only route the pointer probe. One borrowed operand distinguishes
         ordinary named equations; do not repeatedly sample BOTH App
         branches. Collisions always receive full exact-pointer probes. *)
      fun code term =
        (pay 2;if Term.is_var term then
           let val _=pay 24
               val name= #1 (Term.dest_var term)
               val size=String.size name
               fun byte n=if size<n then 0w0 else
                 Word.fromInt (Char.ord (String.sub (name,size-n)))
           in Word.+ (Word.fromInt size,
                Word.+ (Word.* (byte 1,0w37),byte 2)) end
         else (pay 2;if Term.is_const term then
           (pay 6;Word.fromInt (KernelSig.epoch_of
             (#Name (Term.dest_thy_constid term))))
         else (pay 1;0w19)))
      fun bucket term =
        let val _=pay 4
            val sample=if Term.is_comb term then
              let val _=pay 6 val (left,right)=Term.dest_comb term
              in if Term.is_comb left then
                   (pay 3;#2 (Term.dest_comb left)) else right end
              else term
            val value=code sample val _=pay 4
        in Word.toInt (Word.mod (value,0w127)) end
      fun find _ [] = (pay 1;NONE)
        | find term ((held,value)::rest) =
            (pay 3;if Portable.pointer_eq (term,held) then SOME value
             else find term rest)
      fun bounded ({raw,inc,...}:geometry) =
        (pay 4;if raw<=limit andalso inc<=limit then () else
          raise ERR "owned_sparse_projection"
            "compact leaf exceeds original binder cap")
      val _=pay 5
      val type_geometry=ref ([] : (Type.hol_type * int) list)
      val type_count=ref 0
      fun type_hit _ [] = (pay 1;NONE)
        | type_hit ty ((held,n)::rest) =
            (pay 3;if Portable.pointer_eq (ty,held) then SOME n
             else type_hit ty rest)
      fun types ty =
        (pay 3;if Portable.pointer_eq (ty,Type.bool) then 1
         else case type_hit ty (!type_geometry) of SOME n=>n
         | NONE=>
           let val _=pay 5
               val n=if Type.is_vartype ty then 1 else
                 let val args= #2 (Type.dest_type ty)
                 in List.foldl (fn (arg,n)=>
                   let val count=types arg val _=pay 3
                   in n+count end) 1 args end
               val _=pay 2
               val _=if !type_count<4 then
                   (pay 7;type_geometry:=(ty,n):: !type_geometry;
                    type_count:= !type_count+1) else ()
           in n end)
      (* Cold roots need one annotation walk, NOT a hashed lookup and two
         more size walks at every subtree. Only roots that are actually
         borrowed by a rule enter the geometry table. *)
      fun annotations term =
        let val _=pay 8
            val own=types (Term.type_of term)
        in if Term.is_comb term then
             let val _=pay 6 val (a,b)=Term.dest_comb term
                 val left=annotations a val right=annotations b
                 val _=pay 3
             in own+left+right end
           else if Term.is_abs term then
             let val _=pay 8 val (binder,body)=Term.dest_abs term
                 val left=annotations binder val right=annotations body
                 val _=pay 3
             in own+left+right end
           else (pay 2;own)
        end
      fun metric term =
        (pay 2;case find term (!hot) of SOME value=>value | NONE=>
        let val index=bucket term val _=pay 2
        in case find term (Array.sub (rows,index)) of SOME value=>value
          | NONE=>
            let
              (* The original raw-before-annotation/binder admission on a
                 cold operand is unchanged. Cached child geometry was
                 measured from those exact immutable children. *)
              val _=pay 2
              val raw=case SmtReplayImport.bounded_raw_size limit term of
                  SOME n=>n | NONE=>raise ERR "owned_sparse_projection"
                    "compact leaf exceeds original raw cap"
              val inc=case SmtReplayImport.bounded_binder_size limit term of
                  SOME n=>n | NONE=>raise ERR "owned_sparse_projection"
                    "compact leaf exceeds original binder cap"
              val ann=annotations term val _=pay 4
              val value={raw=raw,inc=inc,ann=ann}
              val _=pay 5
              val _=Array.update (rows,index,
                (term,value)::Array.sub (rows,index))
            in value end
        end)
      fun application term (a:geometry) (b:geometry) : geometry =
        let val _=pay 14
            val own=types (Term.type_of term)
            val value={raw=1+ #raw a+ #raw b,inc=1+ #inc a+ #inc b,
              ann=own+ #ann a+ #ann b}
            val _=bounded value
        in value end
      fun binary make (left,right) =
        let val a=metric left val b=metric right val _=pay 12
            val term=make (left,right)
            val (partial,_)=Term.dest_comb term
            val (head,_)=Term.dest_comb partial
            val c=metric head
            val value=application term (application partial c a) b
            val index=bucket term val _=pay 5
            val _=Array.update (rows,index,
              (term,value)::Array.sub (rows,index))
        in term end
      val conjunction_metric=metric boolSyntax.conjunction
      fun conjunction (left,a) (right,b) =
        let val _=pay 10
            val term=boolSyntax.mk_conj (left,right)
            val partial= #1 (Term.dest_comb term)
            val value=application term
              (application partial conjunction_metric a) b
        in (term,value) end
      (* A binary kernel constructor allocates another pair of Apps around
         the SAME operands. Prepay the output inspection and publication,
         then authenticate those children before borrowing the forecast's
         geometry. No post-native spend or native credit is introduced. *)
      fun binary_result_known forecast value =
        let val index=bucket forecast
            val _=pay 48
            val (partial,right)=Term.dest_comb forecast
            val (head,left)=Term.dest_comb partial
        in fn actual=>
          let val (partial,r)=Term.dest_comb actual
              val (h,l)=Term.dest_comb partial
              val _=if Portable.pointer_eq (left,l) andalso
                  Portable.pointer_eq (right,r) andalso
                  Term.same_const head h then () else
                raise ERR "discharge_source_receipt_with_work"
                  "binary constructor operands changed"
          in Array.update (rows,index,
               (actual,value)::Array.sub (rows,index)) end
        end
      fun binary_result forecast =
        binary_result_known forecast (metric forecast)
      fun publish term value =
        let val index=bucket term val _=pay 5
        in Array.update (rows,index,
             (term,value)::Array.sub (rows,index)) end
      (* Assembly's annotation scalar includes variable-name bytes, hence
         is an upper bound for this unweighted annotation forest. Raw and
         inclusive geometry are exact. This is data about its actual closed
         law, retained with that law, never native-work/admission credit. *)
      fun remember term (raw,inc,ann) =
        let val value={raw=raw,inc=inc,ann=ann}
            val _=bounded value val index=bucket term val _=pay 5
        in Array.update (rows,index,
             (term,value)::Array.sub (rows,index)) end
      fun retain terms =
        let val values=List.map (fn term=>(term,metric term)) terms
            val _=pay 3
        in hot:=values end
      fun quote_metrics values =
        let fun add (m:geometry,(raw,inc,total)) =
              (pay 12;(Int.max (raw,#raw m),Int.max (inc,#inc m),
                total+2*(#raw m+ #inc m+ #inc m+ #ann m)))
            val (raw,inc,total)=List.foldl add (0,0,0) values
            val _=pay 5
            val _=if raw<=limit andalso inc<=limit then () else
              raise ERR "owned_sparse_projection"
                "compact leaf exceeds original binder cap"
            (* Exactly the old two raw, two inclusive, two syntax and two
               full annotation forests. Arithmetic replaces repeated walks,
               never any port or occurrence in the prospective portfolio. *)
        in pay total end
      fun quote terms=quote_metrics (List.map metric terms)
    in {quote=quote,metric=metric,quote_metrics=quote_metrics,pay=pay,
        retain=retain,binary=binary,binary_result=binary_result,
        remember=remember,conjunction=conjunction,publish=publish,
        binary_result_known=binary_result_known} end

  (* DISCH executes on the retained named proof. An incoming cut is replaced
     by its genuine scoped implication BEFORE that proof is discharged; a
     later raw cut therefore cannot reintroduce the local hypothesis. *)
  fun discharge_source_receipt_with_work expected incoming hypothesis =
    let
      val _ = source_realization_guard expected incoming
      val completed = ref
        ([] : (source_realization * source_realization) list)
      fun find _ [] = (W.spend expected 1;NONE)
        | find receipt ((old,result)::rest) =
            (W.spend expected 1;
             if Portable.pointer_eq (receipt,old) then SOME result
             else find receipt rest)
      fun close (receipt as SourceRealization
          {work,source_frame,graph,root,scope,frame,original_sources,target,
           occurrences,origins,theorem,compact,held,facts,conversions,
           template_limit,parents,epoch,symbols}) =
        let
          (* Every incoming lifetime and owner precedes an exact receipt hit.
             This cache lives only inside this callback-free transaction. *)
          val _ = source_realization_guard expected receipt
          val hit = W.with_step expected (fn () =>
            (W.spend expected 1;find receipt (!completed)))
        in case hit of SOME result => result | NONE =>
          let
            val SourceCompact {block = block as Block
                {leaves,nodes,owned_frame,...},edge,proof,target_name,
                needed,names,extra_leaves,cuts,closed=retained_assembly,...} =
              compact
            val original_proof=proof
            val _ = W.with_step expected (fn () =>
              (W.spend expected 1;
               ignore (G.closure_root graph scope hypothesis)))
            fun used term = List.exists (fn old =>
              (W.spend expected 1;Term.aconv old term))
              (Thm.hyp proof)
            val (quoter,selected_cuts) = W.with_step expected (fn () =>
              let val quoter=retained_sparse_quoter expected template_limit
                  val _=(#quote quoter) (Thm.concl proof :: Thm.hyp proof)
                  val selected=List.filter (fn (_,term,_) =>
                    (W.spend expected 1;used term)) cuts
              in (quoter,selected) end)
            val closed = List.map (fn (index,term,parent) =>
              (index,term,close parent)) selected_cuts
            val result = W.with_step expected (fn () =>
            let
              val _ = source_realization_guards_with_work expected
                (receipt :: List.map #3 closed)
              val _ = W.spend expected 1
              val (hyp_name,names) = case List.find
                  (fn (node,_) => node = hypothesis) names of
                  SOME (_,variable) => (variable,names)
                | NONE =>
                    let
                      val plan = W.legacy_plan_placeholders expected graph scope
                        {nodes = [hypothesis]}
                      val _ = pay expected
                        (G.placeholder_plan_guard_cost plan)
                      val minted = G.mint_placeholder_terms graph scope plan
                      val variable = case minted of [(node,variable)] =>
                          if node = hypothesis then variable else
                            raise ERR "discharge_source_receipt_with_work"
                              "different authentic hypothesis name"
                        | _ => raise ERR
                            "discharge_source_receipt_with_work"
                            "missing authentic hypothesis name"
                    in (variable,(hypothesis,variable)::names) end
              val quote= #quote quoter
              val payer= #pay quoter
              val binary= #binary quoter
              fun assume term =
                (quote [term];SmtReplayRuleObservation.ASSUME term)
              fun implication left right =
                (payer 3;binary boolSyntax.mk_imp (left,right))
              fun discharge antecedent theorem =
                let val result = implication antecedent (Thm.concl theorem)
                    val _ = quote (result :: antecedent ::
                      Thm.concl theorem :: Thm.hyp theorem)
                    val finish=(#binary_result quoter) result
                    val discharged=SmtReplayRuleObservation.DISCH
                      antecedent theorem
                    val _=finish (Thm.concl discharged)
                in discharged end
              fun apply implication argument =
                let val (_,result) = boolSyntax.dest_imp
                      (Thm.concl implication)
                    val _ = quote (result :: Thm.concl implication ::
                      Thm.concl argument ::
                      (Thm.hyp implication @ Thm.hyp argument))
                in SmtReplayRuleObservation.MP implication argument end
              fun replace premise theorem =
                (quote (Thm.concl premise :: Thm.concl theorem ::
                    (Thm.hyp premise @ Thm.hyp theorem));
                 SmtReplayRuleObservation.D_PROVE_HYP premise theorem)
              fun cut ((index,term,parent), (theorem,rows)) =
                let val next = implication hyp_name term
                    val witness = apply (assume next) (assume hyp_name)
                in (replace witness theorem,(index,next,parent)::rows) end
              val (proof,cut_rows)=List.foldl cut (proof,[]) closed
              val proof=discharge hyp_name proof
              val scoped_expression = implication hyp_name target_name
              val _ = W.spend expected 3
              val implication_node = G.constant graph scope
                boolSyntax.implication
              val inner = G.application graph scope
                (implication_node,hypothesis)
              val scoped_target = G.application graph scope (inner,target)
              val constructors = [implication_node,inner,scoped_target]
              val _ = List.app (fn node =>
                (W.spend expected 1;
                 ignore (G.closure_root graph scope node))) constructors
              fun missing node = not (List.exists (fn (old,_) =>
                (payer 1;node=old)) names)
              val missing_nodes = List.filter missing constructors
              val plan = W.legacy_plan_placeholders expected graph scope
                {nodes = missing_nodes}
              val _ = pay expected (G.placeholder_plan_guard_cost plan)
              val minted = G.mint_placeholder_terms graph scope plan
              val names = minted @ names
              fun named node = case List.find
                  (fn (held,_) => held = node) names of
                  SOME (_,variable) => variable
                | NONE => raise ERR "discharge_source_receipt_with_work"
                    "missing retained operand name"
              val defs =
                [Definition (implication_node,boolSyntax.implication),
                 Definition (inner,Term.mk_comb
                   (named implication_node,hyp_name)),
                 Definition (scoped_target,Term.mk_comb
                   (named inner,target_name))]
              val offset = Vector.length leaves + List.length extra_leaves
              val next_indices = List.tabulate (3,fn n => offset+n)
              val extra_leaves = extra_leaves @ defs
              fun leaf index = if index < Vector.length leaves then
                  Vector.sub (leaves,index)
                else List.nth (extra_leaves,index-Vector.length leaves)
              val equations = List.map (fn definition =>
                assume (leaf_term named definition)) defs
              fun equation left right =
                let val (a,_) = boolSyntax.dest_eq (Thm.concl left)
                    val (_,b) = boolSyntax.dest_eq (Thm.concl right)
                    val result = boolSyntax.mk_eq (a,b)
                    val _ = quote (result :: Thm.concl left ::
                      Thm.concl right :: (Thm.hyp left @ Thm.hyp right))
                in SmtReplayRuleObservation.TRANS left right end
              fun argument theorem operand =
                let val (left,right) = boolSyntax.dest_eq (Thm.concl theorem)
                    val result = boolSyntax.mk_eq
                      (Term.mk_comb (left,operand),
                       Term.mk_comb (right,operand))
                    val _ = quote (result :: Thm.concl theorem :: operand ::
                      Thm.hyp theorem)
                in SmtReplayRuleObservation.AP_THM theorem operand end
              val bridge = case equations of [constant,inner,outer] =>
                  equation outer (argument
                    (equation inner (argument constant hyp_name)) target_name)
                | _ => raise ERR "discharge_source_receipt_with_work"
                    "missing authentic implication definitions"
              val (left,right) = boolSyntax.dest_eq (Thm.concl bridge)
              val _ = quote (boolSyntax.mk_eq (right,left) ::
                Thm.concl bridge :: Thm.hyp bridge)
              val reverse = SmtReplayRuleObservation.SYM bridge
              val _=quote (scoped_expression::left::right::
                (Thm.hyp bridge @ Thm.hyp proof))
              val proof=SmtReplayRuleObservation.EQ_MP reverse proof
              val target_name = named scoped_target
              fun row_term index = case List.find
                  (fn (slot,_,_) => slot = index) cut_rows of
                  SOME (_,term,_) => term
                | NONE => leaf_term named (leaf index)
              val model_hyp=Thm.hyp proof
              val _ = quote (target_name :: model_hyp)
              fun selected_rows [] = (payer 1;[])
                | selected_rows (index::rest) =
                    let val term=row_term index val _=payer 2
                        fun find [] = (payer 1;NONE)
                          | find (old::tail) =
                              (payer 2;if Term.aconv old term then SOME old
                               else find tail)
                    in case find model_hyp of NONE=>selected_rows rest
                      | SOME actual=>
                          (index,actual)::selected_rows rest end
              (* Borrow the actual, already authenticated Hyp representative
                 found by the SAME complete row comparison. Reconstructing
                 that named equation again would lose its physical geometry
                 and make every later quote inspect an identical fresh tree. *)
              val selected=selected_rows (needed @ next_indices)
              val indices=List.map #1 selected
              val terms=Vector.fromList (List.map #2 selected)
              val metric= #metric quoter val payer= #pay quoter
              val _=payer (offset+7)
              val positions=Array.array (offset+3,NONE : int option)
              fun position_rows [] _ = ()
                | position_rows (index::rest) n =
                    (payer 7;Array.update (positions,index,SOME n);
                     position_rows rest (n+1))
              val _=position_rows indices 0
              fun position index = (payer 3;Array.sub (positions,index))
              fun local_leaf index =
                let val term=case List.find (fn (slot,_,_)=>
                      (payer 2;slot=index)) cuts of
                        SOME (_,term,_)=>term
                      | NONE=>leaf_term named (leaf index)
                    val _=payer 2
                in Term.aconv term hyp_name end
              fun available index = case position index of
                  SOME _=>true | NONE=>local_leaf index
              fun changed index=List.exists (fn (slot,_,_)=>
                (payer 2;slot=index)) cut_rows
              datatype surgery = Unchanged | ChangedLeaf of bool
                | ChangedSplit of surgery * surgery
              fun adapt old_indices boundary =
                let fun walk Empty = (Empty,Unchanged,[])
                      | walk (Leaf n) =
                          let val _=payer 4
                              val index=Vector.sub (old_indices,n)
                          in case position index of SOME p=>
                               (Leaf p,if changed index then
                                  ChangedLeaf true else Unchanged,[p])
                             | NONE=>(Empty,ChangedLeaf false,[]) end
                      | walk (Split (a,b)) =
                          let val (a,sa,pa)=walk a
                              val (b,sb,pb)=walk b val _=payer 8
                              val s=case (sa,sb) of
                                  (Unchanged,Unchanged)=>Unchanged
                                | _=>ChangedSplit (sa,sb)
                          in (Split (a,b),s,pa @ pb) end
                in walk boundary end
              datatype geometry_tree = Geometry of
                retained_geometry * geometry_tree list
              fun root_geometry (Geometry (m,_))=m
              fun context_term Empty =
                    let val term=boolSyntax.T val m=metric term
                    in (term,Geometry (m,[])) end
                | context_term (Leaf index) =
                    let val term=Vector.sub (terms,index) val m=metric term
                    in (term,Geometry (m,[])) end
                | context_term (Split (a,b)) =
                    let val (left,ga)=context_term a
                        val (right,gb)=context_term b
                        val (term,m)=(#conjunction quoter)
                          (left,root_geometry ga) (right,root_geometry gb)
                    in (term,Geometry (m,[ga,gb])) end
              val ordinary_tree=make_tree 0 (Vector.length terms)
              val candidate=case retained_assembly of
                  SOME (held:compact_assembly)=>
                    if Portable.pointer_eq (#proof held,original_proof) then
                      (case #indices held of SOME old_indices=>
                         if List.all available old_indices then
                           let val (old_tree,surgery,order)=adapt
                                 (Vector.fromList old_indices) (#tree held)
                               val positions=List.map (fn index=>
                                 case position index of SOME n=>n
                                   | NONE=>raise ERR
                                     "discharge_source_receipt_with_work"
                                     "missing scoped definition") next_indices
                               val _=payer (8+List.length order)
                           in if order @ positions =
                               List.tabulate (List.length indices,fn n=>n)
                             then SOME (held,surgery,Split (old_tree,
                               make_tree (List.length order) 3)) else NONE
                           end
                         else NONE
                       | NONE=>NONE)
                    else NONE
                | NONE=>NONE
              (* Preserve the old balanced subtrees, with T holes for the
                 discharged local Source. Only changed paths will need new
                 CONJ rules. A candidate that needs more syntax than the
                 original cap simply uses the established balanced closure. *)
              val (tree,fusion)=case candidate of
                  SOME (held,surgery,tree)=>
                    let val context=tree_term terms tree
                        val _=payer (12*List.length indices+8)
                    in case (SmtReplayImport.bounded_raw_size
                          (template_limit-4) context,
                        SmtReplayImport.bounded_binder_size
                          (template_limit-4) context) of
                        (SOME _,SOME _)=>(tree,SOME (held,surgery))
                      | _=>(ordinary_tree,NONE)
                    end
                | NONE=>(ordinary_tree,NONE)
              val (context,context_geometry)=context_term tree
              val _=(#publish quoter) context (root_geometry context_geometry)
              val prospective_law=implication context target_name
              val _=quote [context,prospective_law]
              val law_geometry=let val m=metric prospective_law
                  val _=payer 4
                in SOME (#raw m,#inc m,#ann m) end
              val _=(#retain quoter) [context,target_name]
              datatype projection_tree = Projection of
                Thm.thm * retained_geometry * projection_tree list
              fun project_held Empty (Geometry (m,_)) theorem =
                    (payer 4;([],Projection (theorem,m,[])))
                | project_held (Leaf _) (Geometry (m,_)) theorem =
                    (payer 5;([theorem],Projection (theorem,m,[])))
                | project_held (Split (a,b)) (Geometry (m,[ga,gb])) theorem =
                    let val _=payer 12
                        val (left,pa)=project_held a ga
                          (SmtReplayRuleObservation.CONJUNCT1 theorem)
                        val (right,pb)=project_held b gb
                          (SmtReplayRuleObservation.CONJUNCT2 theorem)
                    in (left @ right,Projection (theorem,m,[pa,pb])) end
                | project_held _ _ _=raise ERR
                    "discharge_source_receipt_with_work"
                    "projection geometry shape changed"
              val (projections,projection_tree)=
                project_held tree context_geometry (assume context)
              fun ordinary_law () =
                let val lifted=List.foldl (fn (premise,theorem)=>
                      replace premise theorem) proof projections
                in discharge context lifted end
              (* The retained assembly has already closed the SAME proof.
                 Fuse context introduction with its elimination instead of
                 expanding its entire Hyp forest and closing it a second
                 time. Each old leaf is witnessed by a genuine projection
                 (or the local hypothesis); changed cuts use the genuinely
                 scoped projection and MP. No discovery or law is assumed.
                 Receipts with a different compact proof, or an assembly
                 containing unused dependencies, retain the ordinary path. *)
              fun projected index =
                let fun seek [] [] = NONE
                      | seek (slot::rest) (premise::tail) =
                          (payer 3;if slot=index then SOME premise
                           else seek rest tail)
                      | seek _ _ = raise ERR
                          "discharge_source_receipt_with_work"
                          "projection incidence changed"
                in seek indices projections end
              fun fused_law (held:compact_assembly) surgery =
                let
                  fun rebuild Unchanged (Projection (theorem,m,_)) =
                        (theorem,m)
                    | rebuild (ChangedLeaf scoped)
                        (Projection (theorem,_,_)) =
                        let val proof=if scoped then
                              apply theorem (assume hyp_name)
                            else assume hyp_name
                        in (proof,metric (Thm.concl proof)) end
                    | rebuild (ChangedSplit (a,b))
                        (Projection (_,_,[pa,pb])) =
                        let val (left,ma)=rebuild a pa
                            val (right,mb)=rebuild b pb
                            val (result,m)=(#conjunction quoter)
                              (Thm.concl left,ma) (Thm.concl right,mb)
                            val hypotheses=List.map metric
                              (Thm.hyp left @ Thm.hyp right)
                            val _=(#quote_metrics quoter)
                              (m::ma::mb::hypotheses)
                            val finish=(#binary_result_known quoter) result m
                            val joined=SmtReplayRuleObservation.CONJ left right
                            val _=finish (Thm.concl joined)
                        in (joined,m) end
                    | rebuild _ _=raise ERR
                        "discharge_source_receipt_with_work"
                        "retained projection shape changed"
                  val original_projection=case projection_tree of
                      Projection (_,_,[old,_])=>old
                    | _=>raise ERR "discharge_source_receipt_with_work"
                        "missing retained context projection"
                  val (antecedent,_)=rebuild surgery original_projection
                  val _=case #geometry held of SOME geometry=>
                      (#remember quoter) (Thm.concl (#law held)) geometry
                    | NONE=>()
                  val named_proof=apply (#law held) antecedent
                  val scoped_proof=discharge hyp_name named_proof
                  val bridge=List.foldl (fn (index,theorem)=>
                    case projected index of SOME premise=>
                        replace premise theorem
                      | NONE=>raise ERR
                          "discharge_source_receipt_with_work"
                          "missing scoped definition projection")
                    bridge next_indices
                  val (left,right)=boolSyntax.dest_eq (Thm.concl bridge)
                  val _=quote (boolSyntax.mk_eq (right,left)::
                    Thm.concl bridge::Thm.hyp bridge)
                  val reverse=SmtReplayRuleObservation.SYM bridge
                  val _=quote (target_name::Thm.concl reverse::
                    Thm.concl scoped_proof::
                    (Thm.hyp reverse @ Thm.hyp scoped_proof))
                  val result=SmtReplayRuleObservation.EQ_MP
                    reverse scoped_proof
                in discharge context result end
              val law=case fusion of SOME (held,surgery)=>
                    fused_law held surgery
                | NONE=>ordinary_law ()
              val _ = if null (Thm.hyp law) andalso clean law then () else
                raise ERR "discharge_source_receipt_with_work"
                  "retained scoped compact law is not closed"
              val sigma = List.map (fn (node,variable) =>
                (payer 1;
                 {redex = variable,residue = G.representative graph node}))
                names
              (* Residues come only from retained authentic graph names.
                 Generic late substitution/kernel work remains qualified. *)
              val _ = observe_proof graph #inst
              val actual = SmtReplayRuleObservation.INST sigma law
              val (actual_context,_) = boolSyntax.dest_imp (Thm.concl actual)
              val projected = Vector.fromList
                (project tree (SmtReplayRuleObservation.ASSUME actual_context))
              fun witness (position,index) = case List.find
                  (fn (slot,_,_) => slot = index) cut_rows of
                  SOME (_,_,parent) =>
                    source_realization_theorem_for expected parent
                | NONE => case leaf index of
                    Source node => SmtReplayRuleObservation.ASSUME
                      (G.representative graph node)
                  | ClosedWitness fact => closed_proof fact
                  | ConversionWitness conversion =>
                      (validate_conversion_for expected conversion;
                       conversion_proof conversion)
                  | Definition (node,_) =>
                      let val (left,right) = boolSyntax.dest_eq
                            (Thm.concl (Vector.sub (projected,position)))
                          (* New scoped constructor witnesses compare only
                             recorded immediate children, never a whole
                             expanded scoped Source result. Old definition
                             realization is preserved for original leaves. *)
                          val _ = if index < Vector.length leaves then ()
                            else
                              (W.spend expected 7;
                               case G.view graph node of
                                 G.Application (operator,operand) =>
                                   let val (lf,lx) = Term.dest_comb left
                                       val (rf,rx) = Term.dest_comb right
                                       val f = G.representative graph operator
                                       val x = G.representative graph operand
                                   in if Portable.pointer_eq (lf,f) andalso
                                       Portable.pointer_eq (rf,f) andalso
                                       Portable.pointer_eq (lx,x) andalso
                                       Portable.pointer_eq (rx,x) then () else
                                     raise ERR
                                       "discharge_source_receipt_with_work"
                                       "scoped constructor operand changed"
                                   end
                               | G.Constant _ =>
                                   if Term.same_const left
                                       (G.representative graph node) andalso
                                       Term.same_const right
                                       (G.representative graph node) then ()
                                   else raise ERR
                                     "discharge_source_receipt_with_work"
                                     "scoped constructor constant changed"
                               | _ => raise ERR
                                   "discharge_source_receipt_with_work"
                                   "unrecorded scoped constructor")
                      in SmtReplayRuleObservation.ALPHA left right end
              fun enumerate [] _ = []
                | enumerate (index::rest) position =
                    (W.spend expected 1;witness (position,index) ::
                      enumerate rest (position+1))
              val witnesses = Vector.fromList (enumerate indices 0)
              val theorem = SmtReplayRuleObservation.MP actual
                (tree_proof witnesses tree)
              val target = scoped_target
              val _ = if Portable.pointer_eq (Thm.concl theorem,
                  G.representative graph target) andalso clean theorem
                  then () else raise ERR
                    "discharge_source_receipt_with_work"
                    "actual scoped endpoint or tags changed"
              (* Initial producers retain their actual block-owner keys.
                 Recognize an original occurrence only by that SAME private
                 block and its verified complete original S prefix. Parent
                 keys are traced through genuine held receipts, never by a
                 semantic-node or caller-ordinal promotion. *)
              val original_done = ref
                ([] : (source_realization * source_origin * bool) list)
              fun same_key (ActualSourceSlot (a,i),ActualSourceSlot (b,j)) =
                    Portable.pointer_eq (a,b) andalso i=j
                | same_key
                    (OriginalPrefixSlot (a,i),OriginalPrefixSlot (b,j)) =
                    Portable.pointer_eq (a,b) andalso i=j
                | same_key _ = false
              fun original_hit _ _ [] = (W.spend expected 1;NONE)
                | original_hit receipt key ((old,held,value)::rest) =
                    (W.spend expected 1;
                     if Portable.pointer_eq (receipt,old) andalso
                         same_key (key,held) then SOME value
                     else original_hit receipt key rest)
              fun original key (source as SourceRealization
                  {source_frame = RetainedSourceFrame {original_slots,...},
                   compact = SourceCompact {block = Block {owner,...},...},
                   original_sources,parents,...}) =
                let val _ = W.spend expected 1
                    val prefix = SmtReplaySource.assumption_nodes
                      original_sources @
                      [SmtReplaySource.denied_goal_node original_sources]
                    fun same [] _ = true
                      | same _ [] = false
                      | same (node::rest) (old::tail) =
                          (W.spend expected 1;node=old andalso same rest tail)
                    val here = case key of
                        OriginalPrefixSlot (held,index) =>
                          Portable.pointer_eq (held,original_sources)
                            andalso index >= 0 andalso
                            index < List.length prefix
                      | ActualSourceSlot (held,index) =>
                          Portable.pointer_eq (held,owner) andalso
                            index >= 0 andalso index < List.length prefix
                            andalso same prefix original_slots
                in if here then true else
                  case original_hit source key (!original_done) of
                    SOME value => value
                  | NONE =>
                      let val value = List.exists (original key) parents
                          val _ = W.spend expected 2
                          val _ = original_done :=
                            (source,key,value) :: !original_done
                      in value end
                end
              fun keep ((_,node),(_,origin)) = node <> hypothesis orelse
                original origin receipt
              val retained = List.filter keep
                (ListPair.zip (occurrences,origins))
              val result = SourceRealization
                {work = work,source_frame = source_frame,graph = graph,
                 root = root,scope = scope,frame = frame,
                 original_sources = original_sources,target = target,
                 occurrences = List.map #1 retained,
                 origins = List.map #2 retained,theorem = theorem,
                 compact = SourceCompact {block = block,edge = edge,
                   proof = proof,target_name = target_name,needed = indices,
                   names = names,extra_leaves = extra_leaves,cuts = cut_rows,
                   closed = SOME {proof=proof,indices=SOME indices,tree=tree,
                     context=context,projections=Vector.fromList projections,
                     law=law,geometry=law_geometry}},
                 held = List.map (G.closure_root graph scope) constructors @
                   (G.closure_root graph scope hypothesis :: held),
                 facts = facts,conversions = conversions,
                 template_limit = template_limit,
                 parents = receipt :: List.map #3 closed,
                 epoch = epoch,symbols = symbols}
              val _ = source_realization_guards_with_work expected [result]
              val _ = W.spend expected 2
              val _ = completed := (receipt,result) :: !completed
            in result end)
          in result end
        end
    in close incoming end
    handle primary => (W.close expected;raise primary)

  (* Private constructor DATA. A binding event retains the PRE-abstraction
     body input, not a pointer to a hidden native abstraction child. *)
  datatype nc_origin = NCAtom of Term.term
    | NCBlockRow of Term.term * block * int
    | NCBlockContext of Term.term * block
    | NCVariableHyp of Term.term * Thm.thm * Thm.thm * Thm.thm *
        (Term.term*nc_origin)list*(Term.term*Term.term*nc_origin)list*
        (Term.term*Term.term*nc_origin)list
    | NCApplication of Term.term * nc_origin * nc_origin
    | NCAbstraction of Term.term * Term.term * nc_origin
    | NCEquality of Term.term * nc_origin * nc_origin
    | NCForall of Term.term * Term.term * nc_origin
    | NCSelected of Term.term * nc_origin
    | NCEqtEffect of Term.term * nc_origin * Term.term
    | NCImplication of Term.term * nc_origin * nc_origin
    | NCConjCloseEffect of Term.term*nc_origin*nc_origin*Term.term
    | NCDeferred
  type nc_log = (Term.term * nc_origin) list ref
  type nc_proof =
    {proof:Thm.thm,target:Term.term,conclusion:nc_origin,
     hyp:(Term.term * nc_origin) list,events:int}
  fun nc_known NCDeferred=false | nc_known _=true
  fun nc_seed term=
    if Term.is_var term orelse Term.is_const term then NCAtom term
    else NCDeferred
  fun nc_lookup [] term=nc_seed term
    | nc_lookup((actual,value)::rest)term=
        if Portable.pointer_eq(actual,term)then value
        else nc_lookup rest term
  fun nc_hold (log:nc_log) value term=
    (log:=(term,value):: !log;term)
  fun nc_atom log term=nc_hold log(nc_seed term)term
  fun nc_application (log:nc_log) operator operand term=
    let val left=nc_lookup(!log)operator
        val right=nc_lookup(!log)operand
        val value=if nc_known left andalso nc_known right then
          NCApplication(term,left,right)else NCDeferred
    in nc_hold log value term end
  fun nc_equality (log:nc_log) left right term=
    let val a=nc_lookup(!log)left val b=nc_lookup(!log)right
        val value=if nc_known a andalso nc_known b then
          NCEquality(term,a,b)else NCDeferred
    in nc_hold log value term end
  fun nc_binding forall (log:nc_log) variables id body term=
    let val value=nc_lookup(!log)body
        val binder=List.find(fn(old,_)=>old=id)variables
        val result=case binder of SOME(_,actual)=>
              if Term.is_var actual andalso nc_known value then
                if forall then NCForall(term,actual,value)
                else NCAbstraction(term,actual,value)
              else NCDeferred
          | NONE=>NCDeferred
    in nc_hold log result term end
  (* Fixed Source instruction groups; cached at module bootstrap. These
     are logical bookkeeping units, not machine/private-kernel prices. *)
  val nc_consume_fee=IntInf.fromInt(length
    ["consume entry","allowance pattern","work projection",
     "remaining projection","first guard call","first guard entry",
     "first phase projection","first phase read","first phase branch",
     "first guard projection","first owned guard invocation",
     "first Type getter","first Type projection","first Type compare",
     "first andalso branch","first Term getter","first Term projection",
     "first Term compare","first epoch branch","first guard return",
     "amount nonnegative comparison","amount andalso branch",
     "remaining read","amount bound comparison","amount branch",
     "remaining arithmetic read","remaining subtraction",
     "remaining write","consume sequence","last guard call",
     "last guard entry","last phase projection","last phase read",
     "last phase branch","last guard projection",
     "last owned guard invocation","last Type getter",
     "last Type projection","last Type compare","last andalso branch",
     "last Term getter","last Term projection","last Term compare",
     "last epoch branch","last guard return","consume return"])
  val nc_event_fee=nc_consume_fee+IntInf.fromInt(length
    ["helper call","pair input","left projection","right projection",
     "case dispatch","origin read","known branch","known return",
     "second known branch","second known return","combine branch",
     "origin allocation","origin term field","left origin field",
     "right origin field","result call","log read","event pair",
     "event list cell","log write","result sequence","result pair",
     "term projection","origin projection","emit return",
     "allowance projection","counter read","amount check",
     "counter arithmetic","counter write","entry guard","exit guard"])
  val nc_seed_fee=nc_consume_fee+IntInf.fromInt(length
    ["seed call","is_var call","VAR match","VAR return",
     "orelse branch","is_const call","CONST match","CONST return",
     "seed branch","atom allocation","term field","seed return",
     "allowance projection","counter read","amount check",
     "counter arithmetic","counter write","entry guard","exit guard"])
  val nc_find_fee=IntInf.fromInt(length
    ["find call","list match","pair projection","id projection",
     "id compare","branch","tail projection","loop return"])
  val nc_snapshot_fee=nc_consume_fee+IntInf.fromInt(length
    ["snapshot call","proof projection","concl call","concl match",
     "concl return","hyp call","hypset match","list traversal entry",
     "preserve branch","conclusion lookup call","record publication",
     "proof field","target field","conclusion field","hyp field",
     "events field","allowance projection","counter read",
     "amount check","counter arithmetic","counter write",
     "entry guard","exit guard","snapshot return"])
  val nc_lookup_fee=IntInf.fromInt(length
    ["lookup call","list match","pair pattern","pointer compare",
     "branch","tail projection","loop call","loop return"])
  val nc_hyp_fee=IntInf.fromInt(length
    ["set get call","set stack case","node case","node projection",
     "left projection","right projection","stack push",
     "stack list cell","stack branch","set callback",
     "set loop call","set loop return","public hyp list cell",
     "map call","map list case","actual projection","lookup call",
     "hyp pair","hyp list cell","map loop call","map loop return",
     "first shadow entry",
     "first shadow case","first shadow left field",
     "first shadow right field","first shadow branch",
     "first shadow callback","first shadow tail","first shadow return",
     "second shadow entry","second shadow case","second shadow left",
     "second shadow right","second shadow branch","second shadow tail",
     "second shadow push","second shadow node","second shadow pair",
     "second shadow cell","second shadow return","sentinel case",
     "sentinel tail","sentinel return"])
  val nc_length_fee=IntInf.fromInt(length
    ["length call","list case","tail projection","count addition",
     "loop call","loop return"])
  val nc_allowance_fee=nc_consume_fee+IntInf.fromInt(length
    ["creation call","same Work field","guard closure","Type epoch",
     "Term epoch","epoch field","symbols field","remaining arithmetic",
     "remaining ref","phase ref","owner field","guard field",
     "remaining field","phase field","events field","binder field","Hyp field",
     "record publication","creation return","close call",
     "entry guard","counter read","counter zero write","phase write",
     "exit guard","close return"])
  val nc_log_fee=nc_consume_fee+IntInf.fromInt(length
    ["log allocation","empty list","log ref","log publication",
     "entry guard","exit guard"])
  val nc_model_fee=length
    ["model call","events projection","binder projection",
     "Hyp projection","sign checks","sign branch","event product",
     "seed product","binder product","event addition","Hyp addition",
     "lookup product","lookup addition","Hyp product","length product",
     "total addition","total return","guard call","limit getter",
     "audit getter","charged projection","remaining conversion",
     "remaining subtraction","limit compare","limit branch",
     "amount conversion","spend call","guard return",
     "epoch getter","symbol getter","creation branch","model return"]
  val nc_walk_fee=length
    ["loop call","list case","cell projection","tuple projection",
     "cached Raw match","Raw projection","bound addition","max compare",
     "max branch","count addition","tail projection","loop return"]
  val nc_card_fee=length
    ["getter call","proof projection","hypset call","hypset match",
     "set return","cardinality call","cardinality projection",
     "cardinality return"]
  datatype nc_allowance=NCAllowance of
    {work:W.portfolio,guard:unit->unit,remaining:IntInf.int ref,
     open_phase:bool ref,epoch:int,symbols:int,
     events:IntInf.int,binders:IntInf.int,
     hypotheses:IntInf.int}
  fun nc_allowance_guard(NCAllowance
      {work,guard,open_phase,epoch,symbols,...})=
    (if !open_phase then ()else raise ERR "constructor_capture" "consumed";
     guard();
     if Type.type_epoch()=epoch andalso Term.term_epoch()=symbols then ()
     else(W.close work;raise ERR "constructor_capture" "epoch changed"))
  fun nc_take(value as NCAllowance{work,remaining,...})amount=
    (nc_allowance_guard value;
     if amount>=0 andalso amount<= !remaining then
       remaining:= !remaining-amount
     else(W.close work;raise ERR "constructor_capture"
       "private capture programme exceeded");
     nc_allowance_guard value)
  fun nc_close_allowance(value as NCAllowance
      {remaining,open_phase,...})=
    (nc_allowance_guard value;remaining:=0;open_phase:=false)
  (* Model arithmetic is prepaid separately before evaluating this model.
     H and E are private producer upper bounds, never caller fees or caps. *)
  fun nc_capture_total events binders hypotheses=
    nc_allowance_fee+nc_log_fee+events*(nc_event_fee+2*nc_seed_fee+
      binders*nc_find_fee)+nc_snapshot_fee+
      (hypotheses+1)*(events*nc_lookup_fee+nc_seed_fee)+
      hypotheses*nc_hyp_fee+events*nc_length_fee
  fun nc_prepare_allowance work guard events binders hypotheses=
    let
      val _=guard()val _=W.spend work nc_model_fee
      val _=if events>=0 andalso binders>=0 andalso hypotheses>=0 then ()
        else raise ERR "constructor_capture" "negative producer model"
      val total=nc_capture_total events binders hypotheses
      val _=guard()
      val remaining=IntInf.fromInt(W.work_limit work)-
        IntInf.fromInt(#charged(W.audit work))
      val _=if total<=remaining then ()else
        (W.close work;raise ERR "constructor_capture"
          "original Work cannot reserve capture programme")
      val _=W.spend work(IntInf.toInt total)
      val _=guard()
      val result=NCAllowance{work=work,guard=guard,
        remaining=ref(total-nc_allowance_fee),open_phase=ref true,
        epoch=Type.type_epoch(),symbols=Term.term_epoch(),
        events=events,binders=binders,hypotheses=hypotheses}
    in result end
  (* Private only: amounts are derived by owned producer programmes.
     No Work API token, caller fee, proof or Ready authority is issued. *)
  val nc_aux_consume_fee=nc_consume_fee
  val nc_joint_fee=length
    ["entry","guard call","model call","auxiliary argument",
     "nonnegative check","subtotal addition","remaining getter",
     "remaining subtraction","combined comparison","refusal branch",
     "capture payer","auxiliary payer","capture record","aux record",
     "aux work field","aux guard field","aux remaining ref",
     "aux phase ref","aux epoch field","aux symbol field",
     "tuple construction","publication","aux close entry",
     "aux close guard","aux remaining clear","aux phase clear",
     "aux close return","return"]
  datatype nc_aux_allowance=NCAuxAllowance of
    {work:W.portfolio,guard:unit->unit,remaining:IntInf.int ref,
     open_phase:bool ref,epoch:int,symbols:int}
  fun nc_aux_guard(NCAuxAllowance
      {work,guard,open_phase,epoch,symbols,...})=
    (if !open_phase then ()else raise ERR "constructor_capture" "consumed";
     guard();
     if Type.type_epoch()=epoch andalso Term.term_epoch()=symbols then ()else
       (W.close work;raise ERR "constructor_capture" "epoch changed"))
  fun nc_take_aux(value as NCAuxAllowance{work,remaining,...})amount=
    (nc_aux_guard value;
     if amount>=0 andalso amount<= !remaining then
       remaining:= !remaining-amount
     else(W.close work;raise ERR "constructor_capture"
       "private auxiliary capture programme exceeded");
     nc_aux_guard value)
  fun nc_close_aux(value as NCAuxAllowance{remaining,open_phase,...})=
    (nc_aux_guard value;remaining:=0;open_phase:=false)
  fun nc_prepare_combined_allowance work guard events binders hypotheses
      auxiliary=
    let val _=guard()val _=W.spend work(nc_model_fee+nc_joint_fee)
        val _=if events>=0 andalso binders>=0 andalso hypotheses>=0
            andalso auxiliary>=0 then ()else raise ERR "constructor_capture"
          "negative producer model"
        val capture=nc_capture_total events binders hypotheses
        val total=capture+auxiliary
        val _=guard()
        val available=IntInf.fromInt(W.work_limit work)-
          IntInf.fromInt(#charged(W.audit work))
        val _=if total<=available then ()else
          (W.close work;raise ERR "constructor_capture"
            "original Work cannot reserve capture programme")
        (* Keep both real subtotal debits; no refund or old credit. *)
        val _=W.spend work(IntInf.toInt capture)
        val _=W.spend work(IntInf.toInt auxiliary)
        val _=guard()
        val epoch=Type.type_epoch()val symbols=Term.term_epoch()
        val first=NCAllowance{work=work,guard=guard,
          remaining=ref(capture-nc_allowance_fee),open_phase=ref true,
          epoch=epoch,symbols=symbols,events=events,binders=binders,
          hypotheses=hypotheses}
        val second=NCAuxAllowance{work=work,guard=guard,
          remaining=ref auxiliary,open_phase=ref true,
          epoch=epoch,symbols=symbols}
    in(first,second)end

  fun nc_head budget term=(nc_take budget nc_seed_fee;nc_seed term)
  fun nc_publish log value term=(nc_hold log value term;(term,value))
  fun nc_atom_result budget log term=
    (nc_take budget(nc_event_fee+nc_seed_fee);
     nc_publish log(nc_seed term)term)
  fun nc_application_result budget log (_,left) (_,right) term=
    let val _=nc_take budget nc_event_fee
        val value=if nc_known left andalso nc_known right then
          NCApplication(term,left,right)else NCDeferred
    in nc_publish log value term end
  fun nc_equality_result budget log (_,left) (_,right) term=
    let val _=nc_take budget nc_event_fee
        val value=if nc_known left andalso nc_known right then
          NCEquality(term,left,right)else NCDeferred
    in nc_publish log value term end
  fun nc_binding_result forall
      (budget as NCAllowance{binders,...})log variables id (_,value) term=
    let val _=nc_take budget(nc_event_fee+nc_seed_fee+
              binders*nc_find_fee)
        val binder=List.find(fn(old,_)=>old=id)variables
        val result=case binder of SOME(_,actual)=>
              if Term.is_var actual andalso nc_known value then
                if forall then NCForall(term,actual,value)
                else NCAbstraction(term,actual,value)
              else NCDeferred
          | NONE=>NCDeferred
    in nc_publish log result term end
  (* No native transformation is inferred from a predicted forest. Only
     direct actual emitter pointer hits or genuine public atoms can hit. *)
  fun nc_snapshot (log:nc_log) preserve_target proof : nc_proof=
    let val target=Thm.concl proof
        val hyp=List.map(fn actual=>(actual,nc_lookup(!log)actual))
          (Thm.hyp proof)
        val conclusion=if preserve_target then nc_lookup(!log)target
          else NCDeferred
    in {proof=proof,target=target,conclusion=conclusion,hyp=hyp,
      events=length(!log)}end

  (* Actual constructor transport, separate from historical capture flags.
     Block rows/context are the private freeze constructor results; the
     variable INST relation retains actual operands, never an sr_tree cast. *)
  val nt_caller_capture_fee=length
    ["caller group entry","SourceRealization dispatch","graph field",
     "target field","representative call","target argument","graph argument",
     "prefix call","prefix Work argument","prefix guard closure",
     "prefix source argument","prefix proof argument","prefix graph argument",
     "prefix target argument","prefix clause argument","binding publication"]
  val nt_prefix_entry_fee=length
    ["prefix entry","work argument","guard argument","source argument",
     "proof argument","graph argument","target argument","clause argument",
     "meter allocation","source pattern","compact projection",
     "compact pattern","block projection","owned origins call",
     "graph origin call","input Hyp call","hypotheses call"]
  val nt_prefix_record_fee=length
    ["prefix record","input field","Hyp field","clause field",
