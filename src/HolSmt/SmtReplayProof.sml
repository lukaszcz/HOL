  datatype source_conditional_post_metadata=SourceConditionalPostMetadata of
    {work:W.portfolio,completed:source_predicate_conditional_completed,
     condition_variables:Term.term list,equation_variables:Term.term list,
     hypothesis_variables:Term.term list,unknown:G.node list,
     native_hypothesis_variables:Term.term list,types:Type.hol_type list,
     reason:string option}
  fun prepare_source_conditional_post_metadata expected completed=
    sr_fail expected(fn()=>W.with_step expected(fn()=>
    let val cd=source_predicate_conditional_completed_for expected completed
        val evidence= #evidence cd val d=sce_data expected evidence
        val frame= #frame d val sd=Scope.description_for expected frame
        val graph= #graph sd
        val cap= #template_limit(W.semantic_limits expected)
        val output= #output_limit(W.semantic_limits expected)
        exception NotCovered of string
        fun live()=(ignore(source_predicate_conditional_completed_for
          expected completed);Scope.validate_lifetime_for expected frame)
        fun tick n=(live();W.spend expected n)
        fun guarded action=(live();let val value=action()in live();value end)
        val policies=ref([]:Type.hol_type list)
        fun type_walk ty=
          let fun pending []=()
                | pending([]::rest)=pending rest
                | pending((current::args)::rest)=
                    (tick 12;policies:=current:: !policies;
                     if Type.is_vartype current then
                       (tick(String.size(Type.dest_vartype current)+1);
                        pending(args::rest))
                     else let val {Thy,Tyop,Args}=guarded(fn()=>
                                Type.dest_thy_type current)
                              val _=tick(String.size Thy+String.size Tyop+2)
                          in pending(Args::args::rest)end)
          in pending[[ty]]end
        fun member term values=List.exists(fn old=>
          (tick 2;Term.term_eq term old))values
        fun add term values=if member term values then values else
          (tick 2;term::values)
        fun union values result=List.foldl(fn(term,all)=>add term all)
          result values
        fun actual_name term=
          (type_walk(Term.type_of term);
           if Term.is_var term then tick(String.size(#1(Term.dest_var term))+1)
           else if Term.is_const term then
             let val {Thy,Name,...}=Term.dest_thy_const term
             in tick(String.size Thy+String.size Name+2)end else ())
        fun no_abs limit term=
          let fun pending [] total=()
                | pending(current::rest)total=
                    (tick 8;if total>=limit then raise NotCovered
                       "post-conditional syntax bound"
                     else if Term.is_abs current then raise NotCovered
                       "unassociated post-conditional binder"
                     else if Term.is_comb current then
                       let val(a,b)=guarded(fn()=>Term.dest_comb current)
                       in pending(a::b::rest)(total+1)end
                     else pending rest(total+1))
          in pending[term]0 end
        fun native_free term=
          let fun pending [] values=values
                | pending(current::rest)values=
                    (tick 8;actual_name current;
                     if Term.is_var current then
                       pending rest(add current values)
                     else if Term.is_comb current then
                       let val(a,b)=guarded(fn()=>Term.dest_comb current)
                       in pending(a::b::rest)values end
                     else if Term.is_abs current then raise NotCovered
                       "unassociated post-conditional binder"
                     else pending rest values)
          in no_abs output term;pending[term][]end
        val roots=ref([]:G.node list)val unknown=ref([]:G.node list)
        fun node_add store node=
          if List.exists(fn old=>(tick 2;old=node))(!store)then ()else
            (tick 2;store:=node:: !store)
        fun variables node=
          case guarded(fn()=>G.free_variable_nodes graph node)of
            NONE=>(node_add unknown node;[])
          | SOME nodes=>List.map(fn value=>
              let val term=guarded(fn()=>G.representative graph value)
              in if Term.is_var term then(actual_name term;term)else
                raise NotCovered "Source FV origin is not a typed variable"
              end)nodes
        fun forest_free tree=
          let fun bound_member id values=
                (tick 1;case values of []=>false
                 | held::rest=>(tick 1;if id=held then true
                     else bound_member id rest))
              fun pending work values=
                (tick 1;case work of []=>values
                 | frame::rest=>
                   (tick 1;let val(bound,forest)=frame
                               val _=tick 6
                    in case #shape(sr_data forest)of
                       SRAtom term=>pending rest
                         (if Term.is_var term then add term values
                          else values)
                     | SRBound(id,_)=>
                         if bound_member id bound then pending rest values
                         else raise NotCovered "free lexical binder ID"
                     | SRApp(a,b)=>(tick 12;
                         pending((bound,a)::(bound,b)::rest)values)
                     | SRLam(id,_,body)=>(tick 9;
                         pending((id::bound,body)::rest)values)
                     | _=>raise NotCovered "unresolved actual Hyp forest"
                    end))
              val _=tick 6
          in pending[([],tree)][]end
        fun inherited(parent as SourceRealization
            {graph=held,occurrences,theorem,...})=
          (source_realization_guard expected parent;
           if Portable.pointer_eq(held,graph)then ()else raise NotCovered
             "foreign authentic cut graph";
           List.app(fn hyp=>
             let val selected=List.filter(fn(_,node)=>
                   (tick 2;Portable.pointer_eq(hyp,
                      G.representative graph node)))occurrences
             in if null selected then raise NotCovered
                  "cut Hyp lacks authentic Source occurrence"
                else List.app(node_add roots o #2)selected end)
             (Thm.hyp theorem))
        fun witness(SCEWitness(recipe as SourceRuleRecipe
            {base=SourceCompact{block=Block{leaves,...},cuts,
                               extra_leaves,...},...},index))=
          (validate_source_rule_for expected recipe;
           case List.find(fn(slot,_,_)=>slot=index)cuts of
             SOME(_,_,parent)=>inherited parent
           | NONE=>case (if index<Vector.length leaves then
                 Vector.sub(leaves,index)else
                 List.nth(extra_leaves,index-Vector.length leaves))of
               Source node=>node_add roots node
             | Definition _=>()
             | ClosedWitness fact=>
                 (validate_closed_fact graph(#scope sd)cap fact;
                  if null(Thm.hyp(closed_proof fact))then ()else
                    raise NotCovered "closed row gained actual Hyp")
             | ConversionWitness conversion=>
                 (validate_conversion_for expected conversion;
                  if null(Thm.hyp(conversion_proof conversion))then ()else
                    raise NotCovered "conversion row gained actual Hyp"))
        fun compute()=
          let val target= #target d
              val _=no_abs output target
              val(condition,equation)=case boolSyntax.is_imp_only target of
                true=>guarded(fn()=>boolSyntax.dest_imp_only target)
              | false=>raise NotCovered "conditional implication required"
              val condition_vars=native_free condition
              val equation_vars=native_free equation
              val forests=sce_admitted_hyp_rows_inside expected evidence
              (* Require complete authentic initial-Hyp lineage FIRST.
                 Unknown binders never enter the shared row matcher. *)
              val _=List.app(fn(_,owned)=>case owned of SOME _=>() | NONE=>
                raise NotCovered "current Hyp has no owned forest")forests
              val programme=case sce_admitted_row_programme_inside
                  expected evidence of SOME value=>value | NONE=>
                    raise NotCovered "current rows lack admitted programme"
              val {plan,fresh,admission,rows}=programme
              val service=case sr_admitted_forest_programme expected
                  plan fresh admission(List.map #1 forests)of
                SOME value=>value | NONE=>raise NotCovered
                  "row programme admission unavailable"
              val count=length rows
              fun direct hyp=List.filter(fn(value,_)=>
                (tick 2;Portable.pointer_eq(hyp,value)))rows
              fun matching hyp=case #matches service hyp of NONE=>
                    raise NotCovered "row programme matching unavailable"
                | SOME matches=>
                    if List.exists(fn(index,_)=>index=count)matches then
                      List.map #2 rows
                    else List.map(fn(index,_)=>
                      if index>=0 andalso index<count then
                        #2(List.nth(rows,index))else raise NotCovered
                          "admitted row index changed")matches
              fun each(hyp,owned,(semantic,native))=
                let val forest=case owned of SOME tree=>tree | NONE=>
                      raise NotCovered "current Hyp has no owned forest"
                    val native=union(forest_free forest)native
                    val pointers=direct hyp
                    val held=if not(null pointers)then List.map #2 pointers
                      else matching hyp
                in if null held then raise NotCovered
                     "actual Hyp lacks admitted semantic row witness"
                   else(List.app witness held;(semantic,native))end
              val(local_free,native)=List.foldl(fn((hyp,owned),all)=>
                each(hyp,owned,all))([],[])forests
              val semantic=List.foldl(fn(node,all)=>
                union(variables node)all)local_free(List.rev(!roots))
              val _=live()
          in(condition_vars,equation_vars,semantic,List.rev(!unknown),
             native,NONE)end
        val(condition,equation,semantic,unknown,native,reason)=
          compute()handle NotCovered why=>([],[],[],[],[],SOME why)
        val _=tick 12 val _=live()
    in SourceConditionalPostMetadata{work=expected,completed=completed,
      condition_variables=condition,equation_variables=equation,
      hypothesis_variables=semantic,unknown=unknown,
      native_hypothesis_variables=native,types=List.rev(!policies),
      reason=reason}end))
  fun source_conditional_post_metadata_for expected
      (SourceConditionalPostMetadata{work,completed,condition_variables,
        equation_variables,hypothesis_variables,unknown,
        native_hypothesis_variables,types,reason})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work)then ()else raise ERR
         "conditional_post_metadata" "foreign expected Work";
       ignore(source_predicate_conditional_completed_for expected completed);
       {condition_variables=condition_variables,
        equation_variables=equation_variables,
        hypothesis_variables=hypothesis_variables,unknown=unknown,
        native_hypothesis_variables=native_hypothesis_variables,
        types=types,reason=reason}))

  (* Optional post-completion refinement. Only genuine ancestor recipes
     supply ORIGINAL pre-SPEC clause syntax; exposed FV DATA is no input. *)
  fun prepare_source_conditional_post_metadata_refined expected completed=
    sr_fail expected(fn()=>
    let val original=prepare_source_conditional_post_metadata
          expected completed
        val base=source_conditional_post_metadata_for expected original
    in if Option.isSome(#reason base)orelse null(#unknown base)then original
       else W.with_step expected(fn()=>
    let val cd=source_predicate_conditional_completed_for expected completed
        val evidence= #evidence cd val frame= #frame cd
        val sd=Scope.description_for expected frame
        val graph= #graph sd val scope= #scope sd
        val sources=W.original_sources expected
        val _=if Portable.pointer_eq(sources,#sources sd)then ()else
          raise ERR "source_clause_refinement" "different Original Sources"
        fun live()=ignore(source_predicate_conditional_completed_for
          expected completed)
        fun tick n=(live();W.spend expected n)
        fun guarded action=(live();let val value=action()in live();value end)
        val _=tick 4
        val revision=G.validation_revision graph scope
        val roots=SmtReplaySource.assumption_nodes sources @
          [SmtReplaySource.denied_goal_node sources]
        val policies=ref([]:Type.hol_type list)
        fun profile ty=
          let fun pending work=
                (tick 1;case work of []=>()
                 | []::rest=>pending rest
                 | (ty::args)::rest=>
                   (tick 12;tick 4;policies:=ty:: !policies;
                    if Type.is_vartype ty then
                      (tick(String.size(Type.dest_vartype ty)+1);
                       pending(args::rest))
                    else let val{Thy,Tyop,Args}=guarded(fn()=>
                               Type.dest_thy_type ty)
                             val _=tick(String.size Thy+String.size Tyop+2)
                         in pending(Args::args::rest)end))
          in pending[[ty]]end
        fun actual term=
          (tick 4;if Term.is_var term andalso Term.uptodate_term term then ()
           else raise ERR "source_clause_refinement"
             "owned clause FV is not an actual typed variable";
           profile(Term.type_of term);
           tick(String.size(#1(Term.dest_var term))+1))
        fun equal a b=(tick 2;Term.term_eq a b)
        fun member term values=
          (tick 1;case values of []=>false | head::rest=>
            if equal term head then true else member term rest)
        fun add term values=if member term values then values else
          (tick 3;term::values)
        fun union values result=List.foldl(fn(term,all)=>
          (tick 2;add term all))result values
        fun same left right=
          List.all(fn term=>member term right)left andalso
          List.all(fn term=>member term left)right
        fun reverse values result=
          (tick 1;case values of []=>result | head::rest=>
            (tick 3;reverse rest(head::result)))
        exception Unavailable
        fun free forest=
          let fun bound id values=
                (tick 1;case values of []=>false | held::rest=>
                  (tick 1;if id=held then true else bound id rest))
              fun pending work values=
                (tick 1;case work of []=>values | (lexical,tree)::rest=>
                  (tick 6;case #shape(sr_data tree)of
                     SRAtom term=>
                       if Term.is_var term then
                         (actual term;pending rest(add term values))
                       else if Term.is_const term then pending rest values
                       else raise Unavailable
                   | SRBound(id,_)=>if bound id lexical then
                       pending rest values else raise Unavailable
                   | SRApp(a,b)=>(tick 12;
                       pending((lexical,a)::(lexical,b)::rest)values)
                   | SRLam(id,_,body)=>(tick 9;
                       pending((id::lexical,body)::rest)values)
                   | _=>raise Unavailable))
              val _=tick 6
          in pending[([],forest)][]end
        fun known recipe values=
          (tick 1;case values of []=>false | held::rest=>
            (tick 2;if Portable.pointer_eq(recipe,held)then true
             else known recipe rest))
        fun lineage value recipes=
          (sce_guard expected value;tick 4;case value of
             SCELeaf recipe=>
               (validate_source_rule_for expected recipe;
                if known recipe recipes then recipes else
                  (tick 3;recipe::recipes))
           | SCEProjected{value,...}=>lineage value recipes
           | SCEApplied{parents,...}=>List.foldl
               (fn(parent,all)=>lineage parent all)recipes parents)
        val recipes=reverse(lineage evidence[])[]
        fun root_at index values=
          (tick 2;case values of []=>NONE | node::rest=>
            if index=0 then SOME node else
              if index<0 then NONE else root_at(index-1)rest)
        fun original_rows occurrences origins=
          let fun run left right result=
                (tick 3;case(left,right)of
                   ([],[])=>reverse result[]
                 | ((slot,node)::rest,(other,origin)::more)=>
                     if slot<>other then raise ERR
                       "source_clause_refinement" "actual origins changed"
                     else(case origin of OriginalPrefixSlot(held,index)=>
                       (tick 6;if not(Portable.pointer_eq(held,sources))then
                          raise ERR "source_clause_refinement"
                            "foreign Original occurrence"
                        else(case root_at index roots of
                          NONE=>raise ERR "source_clause_refinement"
                            "Original occurrence index changed"
                        | SOME actual=>if actual<>node then raise ERR
                            "source_clause_refinement"
                            "Original occurrence root changed"
                          else(tick 6;
                            run rest more((index,node)::result))))
                      | ActualSourceSlot _=>run rest more result)
                 | _=>raise ERR "source_clause_refinement"
                     "actual occurrence alignment changed")
          in run occurrences origins[]end
        fun candidate(recipe as SourceRuleRecipe
            {plan=plan as SourceRulePlan{source,hyp_forecast,
               hyp_admission=(clause,delta),...},hyp_universe,...})=
          let val _=validate_source_rule_for expected recipe
              val SourceRealization{graph=held,root,frame=source_frame,
                original_sources,target,occurrences,origins,theorem,...}=
                  source
              val _=tick 12
              val _=if Portable.pointer_eq(graph,held)andalso
                  root= #root sd andalso
                  Portable.pointer_eq(sources,original_sources)then ()else
                raise ERR "source_clause_refinement"
                  "foreign genuine ancestor Source"
              val current=Scope.description_for expected source_frame
              val _=if Portable.pointer_eq(#graph current,graph)andalso
                  #root current= #root sd andalso
                  Portable.pointer_eq(#sources current,sources)then ()else
                raise ERR "source_clause_refinement"
                  "ancestor frame Original Sources changed"
              val representative=guarded(fn()=>G.representative graph target)
              val _=tick 2
              val _=if Portable.pointer_eq(Thm.concl theorem,representative)
                then ()else raise ERR "source_clause_refinement"
                  "original target physical endpoint changed"
              val aliases=original_rows occurrences origins
              val(initial,fresh)=hyp_universe
              val service=sr_admitted_forest_programme expected plan fresh
                (SRHypForestAdmission{trees=hyp_forecast,clause=clause,
                  delta=delta})(Thm.hyp initial)
              val variables=case service of NONE=>NONE | SOME _=>
                (SOME(free clause)handle Unavailable=>NONE)
              val _=validate_source_rule_for expected recipe
              val _=tick 12
          in {recipe=recipe,target=target,representative=representative,
              aliases=aliases,variables=variables}end
        val candidates=List.map candidate recipes
        fun aliases_for root aliases=
          List.filter(fn(_,node)=>(tick 2;node=root))aliases
        fun candidate_for root node
            {recipe,target,representative,aliases,variables}=
          (validate_source_rule_for expected recipe;tick 6;
           if target=node then
             let val actual=G.representative graph node
                 val _=tick 2
             in if Portable.pointer_eq(actual,representative)then
                  SOME variables else raise ERR "source_clause_refinement"
                    "admitted subtree representative changed"end
           else NONE)
        fun matching root node=
          let val matches=List.mapPartial(candidate_for root node)candidates
              fun agree [] answer unsupported=
                    (tick 2;if unsupported then NONE else answer)
                | agree(NONE::rest)answer unsupported=
                    (tick 4;agree rest answer true)
                | agree(SOME values::rest)NONE unsupported=
                    (tick 4;agree rest(SOME values)unsupported)
                | agree(SOME values::rest)(SOME previous)unsupported=
                    (tick 2;
                     if same values previous then
                       (tick 4;agree rest(SOME previous)unsupported)
                     else raise ERR "source_clause_refinement"
                       "admitted target aliases disagree")
          in if null matches then NONE else
               SOME(agree matches NONE false)end
        fun root_member node=
          List.exists(fn held=>(tick 2;node=held))roots
        fun root_variables root=
          if not(root_member root)then NONE else
          let fun seen node values=List.exists(fn held=>
                    (tick 2;node=held))values
              fun walk work visited result=
                (tick 1;case work of []=>SOME result | node::rest=>
                  if seen node visited then walk rest visited result else
                  let val _=tick 6
                      val _=if G.scope_visible graph scope
                          (G.node_scope graph node)then ()else raise ERR
                        "source_clause_refinement"
                        "Original graph node escaped actual frame"
                      val visited=node::visited
                  in case matching root node of
                      SOME NONE=>NONE
                    | SOME(SOME values)=>
                        walk rest visited(union values result)
                    | NONE=>case guarded(fn()=>G.view graph node)of
                        G.Application(left,right)=>(tick 6;
                          walk(left::right::rest)visited result)
                      | G.Variable _=>
                          let val term=G.representative graph node
                              val _=actual term
                          in walk rest visited(add term result)end
                      | G.Constant _=>walk rest visited result
                      | _=>NONE
                  end)
          in walk[root][][]end
        fun refine(root,(variables,unknown))=
          case root_variables root of
            NONE=>(variables,root::unknown)
          | SOME values=>(union values variables,unknown)
        val(variables,unknown)=List.foldl refine
          (#hypothesis_variables base,[])(#unknown base)
        fun append values tail=List.foldl(fn(value,all)=>
          (tick 3;value::all))tail(reverse values[])
        val types=append(#types base)(reverse(!policies)[])
        val _=List.app(fn{recipe,...}=>
          validate_source_rule_for expected recipe)candidates
        val _=tick 6
        val _=if G.validation_revision graph scope=revision then ()else
          raise ERR "source_clause_refinement"
            "Original clause refinement interval changed"
        val _=live()
    in SourceConditionalPostMetadata{work=expected,completed=completed,
      condition_variables= #condition_variables base,
      equation_variables= #equation_variables base,
      hypothesis_variables=variables,unknown=reverse unknown[],
      native_hypothesis_variables= #native_hypothesis_variables base,
      types=types,reason= #reason base}end)
    end)

  (* Pure completed-derived DATA. No future proof quotation or execution. *)
  datatype source_conditional_scalar_decision = ConditionalIdentity
    | ConditionalSingleton of Term.term | ConditionalNotCovered of string
  datatype source_conditional_native_portfolio =
    SourceConditionalNativePortfolio of
    {work:W.portfolio,completed:source_predicate_conditional_completed,
     metadata:source_conditional_post_metadata,
     evidence:source_condition_evidence,
     frame:Scope.receipt,proof:Thm.thm,target:Term.term,hyp:Term.term list,
     forests:(Term.term * sr_tree) list,conclusion:sr_tree option,
     decision:source_conditional_scalar_decision,complete:bool,
     raw:IntInf.int,inclusive:IntInf.int,annotations:IntInf.int}
  fun source_conditional_native_portfolio_guard expected
      (SourceConditionalNativePortfolio
        {work,completed,metadata,evidence,frame,proof,target,hyp,...})=
    (if Portable.pointer_eq(expected,work)then ()else raise ERR
       "conditional_native_portfolio" "foreign expected Work";
     let val cd=source_predicate_conditional_completed_for expected completed
         val _=ignore(source_conditional_post_metadata_for expected metadata)
         val d=sce_data expected evidence
         fun same [] []=true
           | same(a::left)(b::right)=
               Portable.pointer_eq(a,b)andalso same left right
           | same _ _=false
     in if Portable.pointer_eq(#evidence cd,evidence)andalso
         Portable.pointer_eq(#frame cd,frame)andalso
         Portable.pointer_eq(#frame d,frame)andalso
         Portable.pointer_eq(#proof d,proof)andalso
         Portable.pointer_eq(#target d,target)andalso
         Portable.pointer_eq(Thm.concl proof,target)andalso
         same hyp(Thm.hyp proof)then ()else raise ERR
       "conditional_native_portfolio" "actual current compact proof changed"
     end)
  fun source_conditional_native_portfolio_for expected
      (value as SourceConditionalNativePortfolio
        {target,hyp,decision,complete,raw,inclusive,annotations,...})=
    sr_fail expected(fn()=>
      (source_conditional_native_portfolio_guard expected value;
       {statement=target,decision=decision,complete=complete,
        hypotheses=length hyp,raw=raw,inclusive=inclusive,
        annotations=annotations}))
  fun prepare_source_conditional_native_portfolio expected completed=
    sr_fail expected(fn()=>
    let val _=ignore(source_predicate_conditional_completed_for
          expected completed)
        val metadata=prepare_source_conditional_post_metadata_refined
          expected completed
        val md=source_conditional_post_metadata_for expected metadata
    in W.with_step expected(fn()=>
    let val cd=source_predicate_conditional_completed_for expected completed
        val evidence= #evidence cd val frame= #frame cd
        val d=sce_data expected evidence
        val proof= #proof d val target= #target d val hyp=Thm.hyp proof
        val sd=Scope.description_for expected frame
        val graph= #graph sd val scope= #scope sd
        fun live()=
          (ignore(source_predicate_conditional_completed_for
             expected completed);
           ignore(source_conditional_post_metadata_for expected metadata))
        fun tick n=(live();W.spend expected n)
        fun actual operation=
          (live();let val result=operation()in live();result end)
        val _=tick 8
        val revision=G.validation_revision graph scope
        val output=IntInf.fromInt(#output_limit(W.semantic_limits expected))
        exception NotCovered of string
        fun reverse values result=
          (tick 1;case values of []=>result | value::rest=>
            (tick 3;reverse rest(value::result)))
        fun append values tail=
          List.foldl(fn(value,result)=>(tick 3;value::result))tail
            (reverse values[])
        (* Each annotation occurrence includes its full repeated Type tree.
           No cache, type constructor or policy callback is used here. *)
        fun profile ty=
          let fun pending work result=
                (tick 1;case work of []=>reverse result[]
                 | []::rest=>pending rest result
                 | (ty::args)::rest=>
                   (tick 14;
                    if Type.is_vartype ty then
                      (tick(String.size(Type.dest_vartype ty)+1);
                       pending(args::rest)(SRCaptured ty::result))
                    else let val{Thy,Tyop,Args}=actual(fn()=>
                               Type.dest_thy_type ty)
                             val _=tick(String.size Thy+String.size Tyop+2)
                         in pending(Args::args::rest)
                              (SRCaptured ty::result)end))
          in pending[[ty]][]end
        fun name term=
          (tick 4;
           if not(Term.uptodate_term term)then raise ERR
             "conditional_native_portfolio" "retired actual syntax atom"
           else if Term.is_var term then
             tick(String.size(#1(Term.dest_var term))+1)
           else if Term.is_const term then
             let val{Name,Thy,...}=Term.dest_thy_const term
             in tick(String.size Name+String.size Thy+2)end
           else raise NotCovered "unresolved actual syntax atom")
        datatype build_task=Visit of Term.term | Join of sr_type * sr_type list
        fun target_forest()=
          let fun pending work values visited=
                (tick 1;case work of []=>
                   (case values of [tree]=>tree | _=>raise ERR
                     "conditional_native_portfolio" "target build stack")
                 | Visit term::rest=>
                   let val _=tick 10
                       val visited=visited+1
                       val _=if visited<=output then ()else
                         raise NotCovered "current target exceeds output bound"
                       val _=if Term.is_abs term then raise NotCovered
                         "current target is not binder-free"else ()
                       val ty=actual(fn()=>Term.type_of term)
                       val annotations=profile ty
                   in if Term.is_comb term then
                        let val(left,right)=actual(fn()=>Term.dest_comb term)
                            val _=tick 14
                        in pending(Visit left::Visit right::
                             Join(SRCaptured ty,annotations)::rest)
                             values visited end
                      else let val _=name term val _=tick 12
                               val tree=SRTree{ty=SRCaptured ty,
                                 shape=SRAtom term,raw=1,inc=1,
                                 annotations=annotations}
                           in pending rest(tree::values)visited end
                   end
                 | Join(ty,annotations)::rest=>
                   (case values of right::left::more=>
                     let val _=tick 16
                         val tree=SRTree{ty=ty,shape=SRApp(left,right),
                           raw=1+sr_raw left+sr_raw right,
                           inc=1+sr_inc left+sr_inc right,
                           annotations=append annotations
                             (append(sr_types left)(sr_types right))}
                     in pending rest(tree::more)visited end
                   | _=>raise ERR "conditional_native_portfolio"
                       "target join stack"))
              val _=tick 6
          in pending[Visit target][](0:IntInf.int)end
        fun equal left right=(tick 4;Term.term_eq left right)
        fun member term values=List.exists(fn held=>equal term held)values
        fun sorted term []=(tick 3;[term])
          | sorted term(head::tail)=
              (tick 4;case Term.compare(term,head)of
                 LESS=>(tick 3;term::head::tail)
               | EQUAL=>head::tail
               | GREATER=>(tick 2;head::sorted term tail))
        fun variable term=
          (name term;if Term.is_var term then ()else raise ERR
             "conditional_native_portfolio" "metadata is not a variable";
           ignore(profile(Term.type_of term)))
        fun select()=
          let val candidates=List.filter(fn term=>
                (variable term;
                 not(member term(#equation_variables md))andalso
                 not(member term(#hypothesis_variables md))))
                (#condition_variables md)
              val selected=List.foldl
                (fn(term,all)=>sorted term all)[]candidates
          in case selected of []=>ConditionalIdentity
            | [term]=>if member term(#native_hypothesis_variables md)then
                ConditionalNotCovered "selected variable affects native Hyp"
              else if Lib.can Type.dom_rng(Term.type_of term)then
                ConditionalNotCovered "function-valued singleton"
              else ConditionalSingleton term
            | _=>ConditionalNotCovered "multiple selected variables"end
        (* These are complete matched native-Hyp forests. Definition rows
           remain in this portfolio although their semantic FV is empty. *)
        fun forest_names tree=
          let fun pending work=
                (tick 1;case work of []=>() | tree::rest=>
                  (tick 6;case #shape(sr_data tree)of
                     SRAtom term=>(name term;pending rest)
                   | SRBound(_,term)=>(name term;pending rest)
                   | SRApp(left,right)=>(tick 8;
                       pending(left::right::rest))
                   | SRLam(_,binder,body)=>(tick 8;
                       pending(binder::body::rest))
                   | _=>raise NotCovered "unresolved native Hyp atom"))
          in pending[tree]end
        fun annotation descriptor=
          (tick 6;case descriptor of SRCaptured ty=>
             if Type.is_vartype ty then
               tick(String.size(Type.dest_vartype ty)+1)
             else let val{Thy,Tyop,...}=Type.dest_thy_type ty
                  in tick(String.size Thy+String.size Tyop+2)end
           | SRArrow _=>tick 8)
        fun measure tree=
          let val _=forest_names tree
              val count=List.foldl(fn(ty,total)=>
                (annotation ty;tick 2;total+1))(0:IntInf.int)(sr_types tree)
              val _=tick 4
          in(sr_raw tree,sr_inc tree,count)end
        fun prepare()=
          let val _=case #reason md of NONE=>() | SOME why=>
                raise NotCovered why
              val _=if null(#unknown md)then ()else raise NotCovered
                "post-DISCH Original Hyp FV is unresolved"
              val owned=sce_admitted_hyp_rows_inside expected evidence
              fun require(actual,SOME tree)=(tick 4;(actual,tree))
                | require(_,NONE)=raise NotCovered
                    "current Hyp lacks complete authentic pointer lineage"
              val forests=List.map require owned
              val conclusion=target_forest()
              val(cr,ci,ca)=measure conclusion
              val(raw,inclusive,annotations)=List.foldl
                (fn((_,tree),(r,i,a))=>
                  let val(x,y,z)=measure tree val _=tick 6
                  in(r+x,i+y,a+z)end)(cr,ci,ca)forests
              val decision=select()
          in(forests,SOME conclusion,decision,true,raw,inclusive,annotations)
          end
        val(forests,conclusion,decision,complete,raw,inclusive,annotations)=
          prepare()handle NotCovered why=>
            ([],NONE,ConditionalNotCovered why,false,0,0,0)
        val _=tick 20
        val _=if G.validation_revision graph scope=revision then ()else
          raise ERR "conditional_native_portfolio" "graph interval changed"
        val result=SourceConditionalNativePortfolio
          {work=expected,completed=completed,metadata=metadata,
           evidence=evidence,frame=frame,proof=proof,target=target,hyp=hyp,
           forests=forests,conclusion=conclusion,decision=decision,
           complete=complete,raw=raw,inclusive=inclusive,
           annotations=annotations}
        val _=source_conditional_native_portfolio_guard expected result
    in result end)end)

  (* Future syntax DATA only. These forests are never evidence or Ready. *)
  datatype source_scalar_tag_role = ScalarInputTag | ScalarLibraryTag
    | ScalarEmptyTag | ScalarLibraryInputMerge | ScalarNoTheoremTag
  type source_scalar_metrics =
    {raw:IntInf.int,inclusive:IntInf.int,annotations:IntInf.int}
  type source_scalar_operation =
    {event:string,primitive:string,optional:bool,counts_new_theorem:bool,
     tag:source_scalar_tag_role,result:source_scalar_metrics option,
     operands:source_scalar_metrics,native_hypotheses:int,
     result_hyp:source_scalar_metrics,operand_hyp:source_scalar_metrics}
  datatype source_scalar_syntax_footprint = SourceScalarSyntaxFootprint of
    {work:W.portfolio,held:source_conditional_native_portfolio,
     complete:bool,reason:string option,hypotheses:int,
     operations:source_scalar_operation list,
     programme:(sr_tree option * sr_tree list * bool * bool) list,
     input_tag:Tag.tag,law_tag:Tag.tag}
  fun source_scalar_syntax_footprint_guard expected
      (SourceScalarSyntaxFootprint{work,held,...})=
    (if Portable.pointer_eq(expected,work)then ()else raise ERR
       "scalar_syntax_footprint" "foreign expected Work";
     source_conditional_native_portfolio_guard expected held)
  fun source_scalar_syntax_footprint_for expected
      (value as SourceScalarSyntaxFootprint
        {complete,reason,hypotheses,operations,...})=
    sr_fail expected(fn()=>
      (source_scalar_syntax_footprint_guard expected value;
       {complete=complete,reason=reason,hypotheses=hypotheses,
        operations=operations}))
  fun prepare_source_scalar_syntax_footprint expected completed=
    sr_fail expected(fn()=>
    let
      (* The existing producer owns its action. Never nest it in ours. *)
      val held=prepare_source_conditional_native_portfolio expected completed
    in W.with_step expected(fn()=>
    let
      val _=source_conditional_native_portfolio_guard expected held
      val SourceConditionalNativePortfolio
        {metadata,evidence,proof,hyp,forests,conclusion,decision,
         complete=known,...}=held
      val d=sce_data expected evidence
      val md=source_conditional_post_metadata_for expected metadata
      val law=boolTheory.LEFT_FORALL_IMP_THM
      fun live()=source_conditional_native_portfolio_guard expected held
      fun tick amount=(live();W.spend expected amount)
      fun actual operation=
        (live();let val result=operation()in live();result end)
      exception NotCovered of string
      fun reject why=raise NotCovered why
      fun reverse values result=
        (tick 1;case values of []=>result | value::rest=>
          (tick 3;reverse rest(value::result)))
      fun append values tail=
        List.foldl(fn(value,result)=>(tick 3;value::result))tail
          (reverse values[])
      fun flat descriptor=
        let fun pending work result=
              (tick 1;case work of []=>reverse result[]
               | []::rest=>pending rest result
               | (descriptor::args)::rest=>
                 (tick 10;case descriptor of SRArrow(left,right)=>
                    pending([left,right]::args::rest)(descriptor::result)
                  | SRCaptured ty=>
                    if actual(fn()=>Type.is_vartype ty)then
                      (tick(String.size(actual(fn()=>Type.dest_vartype ty))+1);
                       pending(args::rest)(descriptor::result))
                    else let val{Thy,Tyop,Args}=actual(fn()=>
                               Type.dest_thy_type ty)
                             val _=tick(String.size Thy+String.size Tyop+2)
                             val next=List.map(fn t=>(tick 3;SRCaptured t))Args
                         in pending(next::args::rest)(descriptor::result)end))
        in pending[[descriptor]][]end
      fun node ty shape raw inc children=
        let val annotations=flat ty
            val rest=List.foldr(fn(tree,all)=>
              append(sr_types tree)all)[]children
            val _=tick 14
        in SRTree{ty=ty,shape=shape,raw=raw,inc=inc,
          annotations=append annotations rest}end
      fun atom term ty=node ty(SRAtom term)1 1 []
      fun app left right ty=node ty(SRApp(left,right))
        (1+sr_raw left+sr_raw right)(1+sr_inc left+sr_inc right)[left,right]
      fun lam id binder body=node(SRArrow(sr_type binder,sr_type body))
        (SRLam(id,binder,body))(1+sr_raw body)(2+sr_inc body)[binder,body]
      val bool=SRCaptured Type.bool
      fun eq left right=
        let val domain=sr_type left val partial=SRArrow(domain,bool)
            val head=atom boolSyntax.equality(SRArrow(domain,partial))
        in app(app head left partial)right bool end
      fun imp left right=
        let val partial=SRArrow(bool,bool)
            val head=atom boolSyntax.implication(SRArrow(bool,partial))
        in app(app head left partial)right bool end
      fun quant ctor id binder body=
        let val abstraction=lam id binder body
            val head=atom ctor(SRArrow(sr_type abstraction,bool))
        in app head abstraction bool end
      fun shape tree= #shape(sr_data tree)
      fun binary ctor tree=
        case shape tree of SRApp(left,right)=>
          (case shape left of SRApp(head,argument)=>
            (case shape head of SRAtom term=>
              if actual(fn()=>Term.is_const term andalso
                  Term.same_const term ctor)then(argument,right)
              else reject "unsupported current binary constructor"
             | _=>reject "current constructor lacks native atom")
           | _=>reject "current binary application is incomplete")
         | _=>reject "current clause is not a binary application"
      fun native_atom tree=case shape tree of SRAtom term=>term
        | _=>reject "atomic predicate or selected argument is required"
      fun same_type left right=
        (tick 4;actual(fn()=>Type.compare(left,right))=EQUAL)
      fun same_term left right=(tick 4;actual(fn()=>Term.term_eq left right))
      fun name term=(tick 4;#1(actual(fn()=>Term.dest_var term)))
      fun metrics tree=
        let val count=List.foldl(fn(_,total)=>(tick 2;total+1))
              (0:IntInf.int)(sr_types tree)
            val _=tick 4
        in {raw=sr_raw tree,inclusive=sr_inc tree,annotations=count}
           :source_scalar_metrics end
      val zero={raw=0,inclusive=0,annotations=0}:source_scalar_metrics
      fun plus(a:source_scalar_metrics)(b:source_scalar_metrics)=
        (tick 6;{raw= #raw a+ #raw b,inclusive= #inclusive a+ #inclusive b,
          annotations= #annotations a+ #annotations b}:source_scalar_metrics)
      fun total values=List.foldl(fn(tree,all)=>plus all(metrics tree))
        zero values
      fun future()=
        let
          val _=if known then ()else
            reject "current native portfolio incomplete"
          val v=case decision of ConditionalSingleton term=>term
            | ConditionalNotCovered why=>reject why
            | ConditionalIdentity=>reject "no genuine singleton selected"
          val current=case conclusion of SOME tree=>tree
            | NONE=>reject "current native conclusion forest unavailable"
          val(c,b)=binary boolSyntax.implication current
          val(left_b,right_b)=binary boolSyntax.equality b
          val(f,arg)=case shape c of SRApp pair=>pair
            | _=>reject "condition must be an atomic predicate application"
          val ft=native_atom f val vt=native_atom arg
          val _=if same_term vt v andalso actual(fn()=>Term.is_var v)then ()
            else reject "condition argument differs from genuine scalar"
          val sigma=actual(fn()=>Term.type_of v)
          val _=if Lib.can Type.dom_rng sigma then
            reject "function-valued scalar"else ()
          val _=if actual(fn()=>Term.is_var ft orelse Term.is_const ft)then ()
            else reject "predicate is not a native VAR or CONST"
          val(domain,range)=actual(fn()=>Type.dom_rng(Term.type_of ft))
          (* Equation operands may be compound. Check their captured root
             Types without reopening their native syntax. *)
          fun tree_type tree=case sr_type tree of SRCaptured ty=>ty
            | _=>reject "current target lacks actual captured root Type"
          val _=if same_type domain sigma andalso same_type range Type.bool
              andalso same_type(tree_type left_b)Type.bool
              andalso same_type(tree_type right_b)Type.bool then ()else
            reject "predicate domain or Boolean equality Type differs"
          val statement=actual(fn()=>Thm.concl law)
          val _=if null(actual(fn()=>Thm.hyp law))andalso
              actual(fn()=>Term.uptodate_term statement)then ()else
            reject "fixed law is not the retained closed current object"
          val(p,outer)=actual(fn()=>boolSyntax.dest_forall statement)
          val(q,equation)=actual(fn()=>boolSyntax.dest_forall outer)
          val(lhs,rhs)=actual(fn()=>boolSyntax.dest_eq equation)
          val(lx,lbody)=actual(fn()=>boolSyntax.dest_forall lhs)
          val(lp,lq)=actual(fn()=>boolSyntax.dest_imp_only lbody)
          val(lf,la)=actual(fn()=>Term.dest_comb lp)
          val(re,rq)=actual(fn()=>boolSyntax.dest_imp_only rhs)
          val(rx,rp)=actual(fn()=>boolSyntax.dest_exists re)
          val(rf,ra)=actual(fn()=>Term.dest_comb rp)
          val(alpha,prange)=actual(fn()=>Type.dom_rng(Term.type_of p))
          val _=if List.all(fn term=>(tick 4;
              actual(fn()=>Term.is_var term)))[p,q,lx,rx]andalso
              actual(fn()=>Type.is_vartype alpha)andalso
              same_type prange Type.bool andalso
              same_type(Term.type_of q)Type.bool andalso
              same_type(Term.type_of lx)alpha andalso
              same_type(Term.type_of rx)alpha andalso
              same_term lf p andalso same_term rf p andalso
              same_term la lx andalso same_term ra rx andalso
              same_term lq q andalso same_term rq q then ()else
            reject "fixed public lexical law projections differ"
          val schema_names=List.map name[p,q,lx,rx]
          val _=if List.exists(fn binder=>List.exists
              (fn outer=>(tick 2;name binder=name outer))[p,q])[lx,rx]
            then reject "fixed-law binder stem overlaps P or Q"else ()
          val selected_name=name v
          val _=if List.exists(fn held=>(tick 2;held=selected_name))
              schema_names
            then reject "selected stem collides with fixed-law vocabulary"
            else ()
          (* This audit is whole current syntax; no semantic FV is inferred
             from Definition atoms or from a captured Hyp forest. *)
          fun audit tree=
            let fun pending work=
                  (tick 1;case work of []=>() | tree::rest=>
                    (tick 6;case shape tree of
                       SRAtom term=>
                         (if actual(fn()=>Term.is_var term)then
                            let val stem=name term
                                val placeholder=List.exists
                                  (fn(_,held)=>(tick 4;same_term term held))
                                  (#names d)
                            in if placeholder then reject
                                 "current native VAR is named Source syntax"
                               else if List.exists(fn held=>
                                   (tick 2;held=stem))schema_names then reject
                                 "current stem collides with fixed law"
                               else if stem=selected_name andalso
                                   not(same_term term v)then reject
                                 "typed selected stem collision"else ()end
                          else ();pending rest)
                     | SRApp(left,right)=>(tick 6;
                         pending(left::right::rest))
                     | _=>reject "current syntax is not binder-free"))
            in pending[tree]end
          val _=audit current
          val _=if List.exists(fn term=>same_term term v)
              (#equation_variables md)orelse
              List.exists(fn term=>same_term term v)
              (#native_hypothesis_variables md)then reject
            "selected variable affects equation or actual native Hyp"else ()
          val native_hyp=total(List.map
            (fn(_,tree)=>(tick 3;tree))forests)
          val hyp_count=List.foldl(fn(_,count)=>(tick 2;count+1))0 hyp
          val sigma_ty=SRCaptured sigma val alpha_ty=SRCaptured alpha
          val sv=atom v sigma_ty
          val sw=atom(if name lx=name rx then v else rx)sigma_ty
          val sf=atom ft(SRArrow(sigma_ty,bool))
          val cv=app sf sv bool val cw=app sf sw bool
          val input=imp cv b
          val g=quant boolSyntax.universal 1 sv input
          val ex=quant boolSyntax.existential 2 sw cw val e=imp ex b
          val m=eq g e
          fun schema domain left right=
            let val sp=atom p(SRArrow(domain,bool))val sq=atom q bool
                val sl=atom left domain val sr=atom right domain
                val pc=app sp sl bool val rc=app sp sr bool
                val sg=quant boolSyntax.universal 3 sl(imp pc sq)
                val se=imp(quant boolSyntax.existential 4 sr rc)sq
            in eq sg se end
          val original_schema=schema alpha_ty lx rx
          val typed_schema=schema sigma_ty lx rx
          val aligned_schema=schema sigma_ty v
            (if name lx=name rx then v else rx)
          val outer_q=quant boolSyntax.universal 5(atom q bool)original_schema
          val schema_p=atom p(SRArrow(alpha_ty,bool))
          val schema_q=atom q bool
          val fixed_law=quant boolSyntax.universal 6 schema_p outer_q
          val lambda_left=lam 1 sv input val lambda_right=lam 2 sw cw
          val forall_head=atom boolSyntax.universal
            (SRArrow(sr_type lambda_left,bool))
          val exists_head=atom boolSyntax.existential
            (SRArrow(sr_type lambda_right,bool))
          val partial_imp=SRArrow(bool,bool)
          val ih=atom boolSyntax.implication(SRArrow(bool,partial_imp))
          val ic=app ih cv partial_imp val ie=app ih ex partial_imp
          val eh=atom boolSyntax.equality(SRArrow(bool,partial_imp))
          val eg=app eh g partial_imp
          val output=IntInf.fromInt(#output_limit(W.semantic_limits expected))
          val template=IntInf.fromInt
            (#template_limit(W.semantic_limits expected))
          val rows=ref([]:source_scalar_operation list)
          val programme=ref([]:
            (sr_tree option * sr_tree list * bool * bool) list)
          fun step event primitive optional returns tag result operands h op_h=
            let val rm=Option.map metrics result val om=total operands
                val _=case result of NONE=>() | SOME tree=>
                  let val cap=if h then output else template
                  in if sr_raw tree<=cap andalso sr_inc tree<=cap then ()else
                    reject "future result exceeds original semantic role"end
                val _=tick 24
                val row={event=event,primitive=primitive,optional=optional,
                  counts_new_theorem=returns,tag=tag,result=rm,operands=om,
                  native_hypotheses=if h then hyp_count else 0,
                  result_hyp=if h then native_hyp else zero,
                  operand_hyp=if op_h then native_hyp else zero}
            in rows:=row:: !rows;
               programme:=(result,operands,h,op_h):: !programme end
          fun closed event primitive result operands tag=
            step event primitive false true tag(SOME result)operands
              false false
          val _=closed "constructor_SPEC_ALL_prefix" "Specialize" outer_q
            [schema_p,fixed_law]ScalarLibraryTag
          val _=closed "constructor_SPEC_ALL_last" "SPEC" original_schema
            [schema_q,outer_q]ScalarLibraryTag
          val _=step "input_generalization" "GEN" false true ScalarInputTag
            (SOME g)[sv,input]true true
          val inst=not(same_type alpha sigma)
          val _=step "typed_law" "INST_TYPE" false inst ScalarLibraryTag
            (SOME typed_schema)[original_schema]false false
          val _=step "empty_avoidance_inst" "INST[]" false false
            ScalarLibraryTag(SOME typed_schema)[typed_schema]false false
          val _=closed "whole_law_binder_alignment" "ALPHA"
            (eq typed_schema aligned_schema)[typed_schema,aligned_schema]
            ScalarEmptyTag
          val _=closed "aligned_library_equation" "EQ_MP" aligned_schema
            [eq typed_schema aligned_schema,typed_schema]ScalarLibraryTag
          val _=closed "predicate_consequent_instantiation" "INST" m
            [aligned_schema,sf,b]ScalarLibraryTag
          val _=step "left_nonredex_attempt" "BETA_CONV" false false
            ScalarNoTheoremTag NONE[cv]false false
          val lc=eq cv cv val li=eq ic ic val lb=eq input input
          val ll=eq lambda_left lambda_left val lg=eq g g
          val le=eq eg eg val rc=eq cw cw
          val rl=eq lambda_right lambda_right val re=eq ex ex
          val ri=eq ie ie val rb=eq e e val root=eq m m
          val _=closed "left_try_refl" "REFL" lc[cv]ScalarEmptyTag
          val _=closed "left_lift_imp_head" "AP_TERM" li[lc,ih]ScalarEmptyTag
          val _=closed "left_lift_consequent" "AP_THM" lb[li,b]ScalarEmptyTag
          val _=closed "left_lift_abs" "ABS" ll[lb,sv]ScalarEmptyTag
          val _=closed "left_lift_forall" "AP_TERM" lg[ll,forall_head]
            ScalarEmptyTag
          val _=closed "root_lift_left" "AP_TERM" le[lg,eh]ScalarEmptyTag
          val _=step "right_nonredex_attempt" "BETA_CONV" false false
            ScalarNoTheoremTag NONE[cw]false false
          val _=closed "right_try_refl" "REFL" rc[cw]ScalarEmptyTag
          val _=closed "right_lift_abs" "ABS" rl[rc,sw]ScalarEmptyTag
          val _=closed "right_lift_exists" "AP_TERM" re[rl,exists_head]
            ScalarEmptyTag
          val _=closed "right_lift_imp_head" "AP_TERM" ri[re,ih]ScalarEmptyTag
          val _=closed "right_lift_consequent" "AP_THM" rb[ri,b]ScalarEmptyTag
          val _=closed "root_lift_right" "MK_COMB" root[le,rb]ScalarEmptyTag
          val _=closed "every_conv_identity_tail" "REFL" root[m]ScalarEmptyTag
          val _=closed "every_conv_trans" "TRANS" root[root,root]ScalarEmptyTag
          val _=closed "finish_conv_rule" "EQ_MP" m[root,m]ScalarLibraryTag
          val _=step "optional_rewr_alpha" "ALPHA" true true ScalarEmptyTag
            (SOME(eq g g))[g,g]false false
          val _=step "optional_rewr_trans" "TRANS" true true ScalarLibraryTag
            (SOME m)[eq g g,m]false false
          val _=step "outer_conv_rule" "EQ_MP" false true
            ScalarLibraryInputMerge(SOME e)[m,g]true true
        in(reverse(!rows)[],reverse(!programme)[])end
      val _=tick 8
      val(operations,programme,complete,reason)=
        let val(rows,trees)=future()in(rows,trees,true,NONE)end
        handle NotCovered why=>([],[],false,SOME why)
      val _=tick 16
      val hyp_count=List.foldl(fn(_,count)=>(tick 2;count+1))0 hyp
      val result=SourceScalarSyntaxFootprint
        {work=expected,held=held,complete=complete,reason=reason,
         hypotheses=hyp_count,operations=operations,programme=programme,
         input_tag=Thm.tag proof,law_tag=Thm.tag law}
      val _=source_scalar_syntax_footprint_guard expected result
    in result end)end)

  (* Actual Type DATA only; neither a proof invoice nor a policy Ready. *)
  datatype source_scalar_type_data = SourceScalarTypeData of
    {work:W.portfolio,footprint:source_scalar_syntax_footprint,
     complete:bool,reason:string option,operations:int,ports:int,
     arrows:int,annotations:IntInf.int,types:Type.hol_type list,
     nominal:IntInf.int}
  fun source_scalar_type_data_guard expected
      (SourceScalarTypeData{work,footprint,...})=
    (if Portable.pointer_eq(expected,work)then ()else raise ERR
       "scalar_type_data" "foreign expected Work";
     source_scalar_syntax_footprint_guard expected footprint)
  fun source_scalar_type_data_for expected
      (value as SourceScalarTypeData
        {complete,reason,operations,ports,arrows,annotations,...})=
    ((tables_phase expected "scalar.type.getter.before"(fn()=>"");
      source_scalar_type_data_guard expected value;
      tables_phase expected "scalar.type.getter.after"(fn()=>"");
      {complete=complete,reason=reason,operations=operations,
       ports=ports,arrows=arrows,annotations=annotations})
     handle primary=>(W.close expected;raise primary))
  (* The public fixed constructor is identical in both kernels. Its body
     uses the held fun_tyc and never performs a symbol-table lookup. *)
  fun source_scalar_type_data_arrow pair=Type.--> pair
  fun prepare_source_scalar_type_data expected completed=
    (let val _=tables_phase expected "scalar.type.footprint.before"
          (fn()=>"")
         val footprint=prepare_source_scalar_syntax_footprint
          expected completed
         val _=tables_phase expected "scalar.type.footprint.after"
          (fn()=>"")
    in W.with_step expected(fn()=>
    let
      val _=source_scalar_syntax_footprint_guard expected footprint
      val SourceScalarSyntaxFootprint
        {held,complete,reason,operations=rows,programme,...}=footprint
      val SourceConditionalNativePortfolio{forests,hyp,...}=held
      fun live()=source_scalar_syntax_footprint_guard expected footprint
      (* Collection and compilation below read only private immutable
         forests and build DATA. They cannot call a policy or native rule.
         Bracket those pure segments with the FULL original guard instead
         of recursively validating the completed proof for each list cell.
         Every bookkeeping event still pays SAME live original Work. The
         Type constructor loop retains its before/after guard PER arrow;
         no guard completion, schedule or nominal debit survives a call. *)
      fun tick amount=W.spend expected amount
      fun phase label describe=(live();tables_phase expected label describe)
      fun reverse values result=
        (tick 1;case values of []=>result | value::rest=>
          (tick 3;reverse rest(value::result)))
      val _=tick 4
      val roots=ref([]:sr_type list)
      val ports=ref 0
      fun descriptors values=
        (tick 1;case values of []=>() | value::rest=>
          (tick 5;roots:=value:: !roots;ports:= !ports+1;
           descriptors rest))
      fun tree value=(tick 3;descriptors(sr_types value))
      fun trees values=
        (tick 1;case values of []=>() | value::rest=>
          (tick 3;tree value;trees rest))
      fun hypotheses values=
        (tick 1;case values of []=>() | (_,value)::rest=>
          (tick 3;tree value;hypotheses rest))
      fun count_hyp values count=
        (tick 1;case values of []=>count | _::rest=>
          (tick 2;count_hyp rest(count+1)))
      val hcount=count_hyp hyp 0
      fun collect [] [] count=count
        | collect((row:source_scalar_operation)::rest)
            ((result,operands,result_h,operand_h)::next)count=
          let val _=tick 15
              val retained= #event row="input_generalization"orelse
                #event row="outer_conv_rule"
              val _=if result_h=retained andalso operand_h=retained
                  andalso #native_hypotheses row=
                    (if retained then hcount else 0)then ()else raise ERR
                "scalar_type_data" "private native Hyp role changed"
              val _=case result of NONE=>() | SOME value=>tree value
              val _=if result_h then hypotheses forests else ()
              val _=trees operands
              val _=if operand_h then hypotheses forests else ()
          in collect rest next(count+1)end
        | collect _ _ _=raise ERR "scalar_type_data"
            "private operation/programme cardinality changed"
      val _=phase "scalar.type.collect.before"(fn()=>"")
      val operation_count=if complete then collect rows programme 0 else 0
      val _=phase "scalar.type.collect.after"
        (fn()=>" ports=" ^ Int.toString(!ports))
      val _=if complete andalso operation_count<>28 then raise ERR
        "scalar_type_data" "private finite itinerary changed"else ()
      datatype inspect=Visit of sr_type | Join
      datatype instruction=Held of Type.hol_type | Arrow | Export
      val _=tick 4
      val instructions=ref([]:instruction list)
      val subtotal=ref(3:IntInf.int)
      fun instruction value amount=
        (tick 5;instructions:=value:: !instructions;
         subtotal:= !subtotal+amount)
      fun compile tasks=
        (tick 1;case tasks of []=>()
         | Visit(SRCaptured ty)::rest=>
             (tick 4;instruction(Held ty)4;compile rest)
         | Visit(SRArrow(left,right))::rest=>
             (tick 7;compile(Visit left::Visit right::Join::rest))
         | Join::rest=>(tick 3;instruction Arrow 24;compile rest))
      fun compile_roots values=
        (tick 1;case values of []=>() | value::rest=>
          (tick 4;compile[Visit value];instruction Export 7;
           compile_roots rest))
      val _=phase "scalar.type.compile.before"(fn()=>"")
      val _=compile_roots(reverse(!roots)[])
      val executable=reverse(!instructions)[]
      val _=phase "scalar.type.compile.after"
        (fn()=>" nominal=" ^ IntInf.toString(!subtotal))
      (* No Type constructor is called until this entire fixed schedule's
         new nominal execution group has been paid by SAME original Work.
         Existing guard/payer fees still execute separately and can fail. *)
      val _=live()
      val _=pay expected(!subtotal)
      val _=live()
      fun run [] [] answers arrows=(reverse answers[],arrows)
        | run(Held ty::rest)values answers arrows=
            run rest(ty::values)answers arrows
        | run(Arrow::rest)(right::left::more)answers arrows=
            let val _=live()
                val ty=source_scalar_type_data_arrow(left,right)
                val _=live()
            in run rest(ty::more)answers(arrows+1)end
        | run(Export::rest)[ty]answers arrows=
            run rest[](ty::answers)arrows
        | run _ _ _ _=raise ERR "scalar_type_data"
            "private Type materialization stack changed"
      val _=phase "scalar.type.run.before"(fn()=>"")
      val(types,arrows)=run executable[][]0
      val _=phase "scalar.type.run.after"
        (fn()=>" arrows=" ^ Int.toString arrows)
      val _=tick 12
      val answer=SourceScalarTypeData
        {work=expected,footprint=footprint,complete=complete,reason=reason,
         operations=operation_count,ports= !ports,arrows=arrows,
         annotations=IntInf.fromInt(!ports),types=types,nominal= !subtotal}
      val _=source_scalar_type_data_guard expected answer
    in answer end)end
    handle primary=>(W.close expected;raise primary))
  (* Bounded CLOSURE metadata only. No theorem, invoice or proof Ready. *)
  type scc_metric={raw:IntInf.int,inclusive:IntInf.int,annotations:IntInf.int}
  type scc_data={covered:bool,reason:string option,native_hypotheses:int,
    used_rows:int,support_rows:int,definitions:int,original_roots:int,
    source_occurrences:int,
    body_raw:IntInf.int,body_inclusive:IntInf.int,body_annotations:IntInf.int,
    hypotheses_raw_upper:IntInf.int,hypotheses_inclusive_upper:IntInf.int,
    hypotheses_annotations_upper:IntInf.int,strict_input_bounds:bool,
    input_limit:int,output_limit:int,template_limit:int}
  type source_conditional_closure_data=scc_data
  datatype source_conditional_closure_plan=SourceConditionalClosurePlan of
    {work:W.portfolio,held:source_conditional_native_portfolio,
     graph:G.graph,scope:G.scope,revision:IntInf.int,data:scc_data}
  fun source_conditional_closure_guard expected
      (SourceConditionalClosurePlan{work,held,graph,scope,revision,...})=
    (if Portable.pointer_eq(expected,work)then ()else raise ERR
       "conditional_closure" "foreign expected Work";
     source_conditional_native_portfolio_guard expected held;
     if G.validation_revision graph scope=revision then ()else raise ERR
       "conditional_closure" "graph interval changed")
  (* The immutable DATA record was paid and published during prepare.
     Getter dispatch/bootstrap remains qualified, as for the older DATA. *)
  fun source_conditional_closure_plan_for expected
      (value as SourceConditionalClosurePlan{data,...})=
    sr_fail expected(fn()=>
      (source_conditional_closure_guard expected value;data))
  fun prepare_source_conditional_closure_plan expected completed=
    sr_fail expected(fn()=>
    let val held=prepare_source_conditional_native_portfolio
          expected completed
    in W.with_step expected(fn()=>
    let
      val _=source_conditional_native_portfolio_guard expected held
      val SourceConditionalNativePortfolio
        {evidence,frame,proof,hyp,forests,conclusion,complete,...}=held
      val d=sce_data expected evidence
      val sd=Scope.description_for expected frame
      val graph= #graph sd val scope= #scope sd
      val sources=W.original_sources expected
      val limits=W.semantic_limits expected
      val input_limit= #input_limit limits
      val output_limit= #output_limit limits
      val template_limit= #template_limit limits
      val ceiling=IntInf.fromInt(Int.max(input_limit,
        Int.max(output_limit,template_limit)))
      fun live()=source_conditional_native_portfolio_guard expected held
      fun tick amount=(live();W.spend expected amount)
      fun guarded action=(live();let val answer=action()in live();answer end)
      exception NotCovered of string
      val zero={raw=0,inclusive=0,annotations=0}:scc_metric
      fun add(a:scc_metric,b:scc_metric):scc_metric=
        (tick 6;{raw=IntInf.min(ceiling+1,#raw a+ #raw b),
          inclusive=IntInf.min(ceiling+1,#inclusive a+ #inclusive b),
          annotations= #annotations a+ #annotations b})
      fun bounded cap(metric:scc_metric)=
        (tick 3;#raw metric<=IntInf.fromInt cap andalso
          #inclusive metric<=IntInf.fromInt cap)
      (* Native ANN is the length of the already-flattened export list.
         Captured-only coverage avoids confusing arrow construction work
         with native occurrence counts. The shared factory is unchanged. *)
      fun annotations tree=
        let fun count [] total=(tick 1;total)
              | count(SRCaptured _::rest)total=
                  (tick 3;count rest(total+1))
              | count(SRArrow _::rest)total=raise NotCovered
                  "virtual Type annotations require a separate forecast"
        in count(sr_types tree)(0:IntInf.int)end
      fun forest_metric tree:scc_metric=
        (tick 5;{raw=sr_raw tree,inclusive=sr_inc tree,
          annotations=annotations tree})
      fun type_metric ty=
        let fun walk [] count=(tick 1;count)
              | walk([]::rest)count=(tick 2;walk rest count)
              | walk((ty::args)::rest)count=
                  (tick 12;
                   if Type.is_vartype ty then
                     (tick(String.size(Type.dest_vartype ty)+1);
                      walk(args::rest)(count+1))
                   else let val{Thy,Tyop,Args}=guarded(fn()=>
                              Type.dest_thy_type ty)
                            val _=tick(String.size Thy+String.size Tyop+2)
                        in walk(Args::args::rest)(count+1)end)
        in walk[[ty]](0:IntInf.int)end
      fun reverse [] answer=(tick 1;answer)
        | reverse(x::rest)answer=(tick 3;reverse rest(x::answer))
      fun recipe_member recipe []=(tick 1;false)
        | recipe_member recipe(held::rest)=
            (tick 3;Portable.pointer_eq(recipe,held)orelse
              recipe_member recipe rest)
      fun lineage value recipes=
        (sce_guard expected value;tick 5;case value of
           SCELeaf recipe=>if recipe_member recipe recipes then recipes
             else(tick 2;recipe::recipes)
         | SCEProjected{value,...}=>lineage value recipes
         | SCEApplied{parents,...}=>List.foldl
             (fn(parent,all)=>lineage parent all)recipes parents)
      val recipes=reverse(lineage evidence[])[]
      (* The original whole-clause forest is certified without invoking
         the deferred native matcher. It is not actual-Hyp association. *)
      fun candidate(recipe as SourceRuleRecipe
          {plan=plan as SourceRulePlan{source,hyp_forecast,
             hyp_admission=(clause,delta),...},hyp_universe,...})=
        let val _=validate_source_rule_for expected recipe
            val SourceRealization{graph=owner,root,frame=parent_frame,
              original_sources,target,theorem,...}=source
            val _=tick 12
            val _=if Portable.pointer_eq(graph,owner)andalso
                root= #root sd andalso
                Portable.pointer_eq(sources,original_sources)then ()else
              raise ERR "conditional_closure" "foreign ancestor Source"
            val parent=Scope.description_for expected parent_frame
            val _=if Portable.pointer_eq(#graph parent,graph)andalso
                #root parent= #root sd andalso
                Portable.pointer_eq(#sources parent,sources)then ()else
              raise ERR "conditional_closure" "ancestor frame changed"
            val representative=guarded(fn()=>G.representative graph target)
            val _=if Portable.pointer_eq(Thm.concl theorem,representative)
              then ()else raise ERR "conditional_closure"
                "ancestor physical endpoint changed"
            val(initial,fresh)=hyp_universe
            val certified=sr_admitted_forest_programme expected plan fresh
              (SRHypForestAdmission{trees=hyp_forecast,clause=clause,
                delta=delta})(Thm.hyp initial)
            val metric=case certified of NONE=>NONE
              | SOME _=>SOME(forest_metric clause)
        in (target,metric)end
      (* Keep only guarded identity DATA until an actual required target
         reaches this recipe. No unused clause is eagerly certified. *)
      fun target_of(SourceRuleRecipe
          {plan=SourceRulePlan{source=SourceRealization{target,...},...},...})=
        target
      fun same(a:scc_metric,b:scc_metric)=
        (tick 4;#raw a= #raw b andalso #inclusive a= #inclusive b andalso
          #annotations a= #annotations b)
      fun agreement values=
        let fun run [] value unsupported=(value,unsupported)
              | run(NONE::rest)value _=(tick 2;run rest value true)
              | run(SOME metric::rest)NONE unsupported=
                  (tick 3;run rest(SOME metric)unsupported)
              | run(SOME metric::rest)(SOME first)unsupported=
                  if same(first,metric)then run rest(SOME first)unsupported
                  else raise ERR "conditional_closure"
                    "same-target certified bounds disagree"
            val(value,unsupported)=run values NONE false
        in if unsupported then NONE else value end
      fun target_candidates node=
        let fun collect [] answer=(tick 1;reverse answer [])
              | collect(recipe::rest)answer=
                  (tick 5;if target_of recipe=node then
                    let val(_,metric)=candidate recipe val _=tick 2
                    in collect rest(metric::answer)end
                   else collect rest answer)
        in collect recipes []end
      val _=tick 6
      val memo=ref([]:(G.node*scc_metric)list)
      fun cached node []=(tick 1;NONE)
        | cached node((held,value)::rest)=
            (tick 3;if node=held then SOME value else cached node rest)
      fun store node value=(tick 4;memo:=(node,value):: !memo)
      datatype graph_task=Node of G.node | Combine of G.node*IntInf.int
      fun graph_metric node=
        let fun run [] [value]=value
              | run(Node node::rest)values=
                  (tick 8;case cached node(!memo)of
                     SOME value=>run rest(value::values)
                   | NONE=>
                     let val _=ignore(G.closure_root graph scope node)
                         val aliases=target_candidates node
                     in if not(null aliases)then
                         (case agreement aliases of NONE=>raise NotCovered
                            "matching original clause lacks certificate"
                          | SOME value=>(store node value;
                              run rest(value::values)))
                       else case G.view graph node of
                         G.Application(left,right)=>
                           let val ann=type_metric(G.type_of graph node)
                               val _=tick 8
                           in run(Node left::Node right::
                             Combine(node,ann)::rest)values end
                       | G.Variable _=>
                           let val value={raw=1,inclusive=1,
                                 annotations=type_metric(G.type_of graph node)}
                           in store node value;run rest(value::values)end
                       | G.Constant _=>
                           let val value={raw=1,inclusive=1,
                                 annotations=type_metric(G.type_of graph node)}
                           in store node value;run rest(value::values)end
                       | _=>raise NotCovered "required graph branch is opaque"
                     end)
              | run(Combine(node,ann)::rest)(right::left::values)=
                  let val value=add({raw=1,inclusive=1,annotations=ann},
                        add(left,right))
                  in store node value;run rest(value::values)end
              | run _ _=raise ERR "conditional_closure" "graph metric stack"
        in run[Node node][]end
      val _=tick 8
      val original_nodes=reverse
        (reverse(SmtReplaySource.assumption_nodes sources)
          [SmtReplaySource.denied_goal_node sources])[]
      val required=ref([]:G.node list)
      val occurrences=ref([]:(int*G.node)list)
      val used=ref([]:int list)
      val definitions=ref([]:int list)
      val support=ref([]:(int*sr_tree*sce_witness)list)
      fun count [] total=(tick 1;total)
        | count(_::rest)total=(tick 3;count rest(total+1))
      fun int_add index cell=
        (tick 4;if List.exists(fn old=>(tick 2;old=index))(!cell)then ()else
          (tick 3;cell:=index:: !cell))
      fun source node=
        let fun roots [] _ answer=answer
              | roots(held::rest)index answer=
                  (tick 4;roots rest(index+1)
                    (if node=held then(index,node)::answer else answer))
            val aliases=roots original_nodes 0 []
            val _=if null aliases then raise NotCovered
              "Source row lacks actual Original root"else ()
            val _=List.app(fn pair=>
              (tick 4;if List.exists(fn old=>(tick 2;old=pair))
                (!occurrences)then ()else occurrences:=pair:: !occurrences))
              aliases
        in if List.exists(fn old=>(tick 2;old=node))(!required)then ()else
          (tick 3;required:=node:: !required)end
      fun witness index is_used(SCEWitness(recipe as SourceRuleRecipe
          {base=SourceCompact{block=Block{leaves,...},cuts,extra_leaves,...},
           ...},slot))=
        (validate_source_rule_for expected recipe;tick 6;
         if is_used then int_add index used else ();
         if List.exists(fn(other,_,_)=>(tick 2;other=slot))cuts then
           raise NotCovered "required cut row is not a bounded closure witness"
         else case(if slot<Vector.length leaves then Vector.sub(leaves,slot)
             else List.nth(extra_leaves,slot-Vector.length leaves))of
           Source node=>source node
         | Definition _=>int_add index definitions
         | ClosedWitness fact=>
             (validate_closed_fact graph scope template_limit fact;
              if null(Thm.hyp(closed_proof fact))then ()else raise NotCovered
                "closed witness retained Hyp")
         | ConversionWitness conversion=>
             (validate_conversion_for expected conversion;
              if null(Thm.hyp(conversion_proof conversion))then ()else
                raise NotCovered "conversion witness retained Hyp"))
      fun used_rows()=
        let val programme=case sce_admitted_row_programme_inside
              expected evidence of SOME value=>value | NONE=>
                raise NotCovered "rows lack exact admitted programme"
            val{plan,fresh,admission,rows}=programme
            val service=case sr_admitted_forest_programme expected plan fresh
              admission(List.map #1 forests)of SOME value=>value | NONE=>
                raise NotCovered "row certificate unavailable"
            val count=count rows 0
            fun each(actual,_)=
              let val matches=case #matches service actual of
                    SOME value=>value | NONE=>raise NotCovered
                      "actual Hyp row association unavailable"
                  val _=if List.exists(fn(index,_)=>(tick 2;index=count))
                      matches andalso count<>1 then raise NotCovered
                    "whole context needs retained pre-lifting dependencies"
                  else ()
                  val selected=List.filter(fn(index,_)=>(tick 2;
                    index>=0 andalso index<count))matches
                  val _=if null selected then raise NotCovered
                    "actual Hyp has no genuine row witness"else ()
              in List.app(fn(index,_)=>witness index true
                (#2(List.nth(rows,index))))selected end
            fun all_rows [] _=()
              | all_rows((actual,w)::rest)index=
                  let val _=tick 6
                      val matches=case #matches service actual of
                        SOME values=>values | NONE=>raise NotCovered
                          "support row lacks actual admitted forest"
                      val own=List.filter(fn(held,_)=>(tick 3;held=index))
                        matches
                      val _=if null own then raise NotCovered
                        "support row has no matching row index"else ()
                      val _=witness index false w
                      val _=List.app(fn(_,tree)=>
                        (tick 3;support:=(index,tree,w):: !support))own
                  in all_rows rest(index+1)end
        in List.app each forests;all_rows rows 0 end
      (* Replace only owned native names. ALL same-name graph aliases must
         agree; no literal arbitrary variable is treated as a Source port. *)
      fun realized_metric binders tree=
        let datatype task=Tree of sr_tree*bool | Join of IntInf.int
              | Bind of IntInf.int
            fun run [] [value]=value
              | run(Tree(tree,under)::rest)values=
                  (tick 8;case #shape(sr_data tree)of
                     SRAtom term=>
                       let val names=List.filter(fn(_,variable)=>
                             (tick 3;Term.term_eq term variable))(#names d)
                           val _=if under andalso not(null names)then
                             raise NotCovered
                               "protected native name occurs under binder"
                             else ()
                           val metric=if null names then forest_metric tree
                             else case agreement(List.map(fn(node,_)=>
                               SOME(graph_metric node))names)of
                               SOME value=>value | NONE=>raise NotCovered
                                 "native Source name is unresolved"
                       in run rest(metric::values)end
                   | SRApp(left,right)=>
                       let val child_annotations=annotations left+
                             annotations right
                           val own=annotations tree-child_annotations
                           val _=if own>=0 then ()else raise ERR
                             "conditional_closure" "annotation forest changed"
                       in run(Tree(left,under)::Tree(right,under)::
                         Join own::rest)values end
                   | SRBound _=>if binders then
                       run rest(forest_metric tree::values)
                     else raise NotCovered "closure body contains a binder"
                   | SRLam(_,variable,body)=>if binders then
                       let val own=annotations tree-annotations body
                           val _=if own>=0 then ()else raise ERR
                             "conditional_closure" "binder ANN changed"
                       in run(Tree(body,true)::Bind own::rest)values end
                     else raise NotCovered "closure body contains a binder"
                   | _=>raise NotCovered "closure forest is unsupported")
              | run(Join ann::rest)(right::left::values)=
                  run rest(add({raw=1,inclusive=1,annotations=ann},
                    add(left,right))::values)
              | run(Bind ann::rest)(body::values)=
                  run rest(add({raw=1,inclusive=2,annotations=ann},
                    body)::values)
              | run _ _=raise ERR "conditional_closure" "body metric stack"
        in run[Tree(tree,false)][]end
      val _=tick 4
      val revision=G.validation_revision graph scope
      fun compute()=
        let val _=if complete then ()else raise NotCovered
              "current native portfolio is unresolved"
            val tree=case conclusion of SOME tree=>tree | NONE=>
              raise NotCovered "current body lacks owned forest"
            val _=used_rows()
            (* This forecasts the existing ALL-row support programme.
               It does not grant a selected-row executor or GEN admission. *)
            fun support_metrics [] answer=(tick 1;answer)
              | support_metrics((index,forest,_)::rest)answer=
                  let val metric=realized_metric true forest
                      val _=if bounded template_limit metric then ()else
                        raise NotCovered
                          "realized support row exceeds template bound"
                      val existing=List.find(fn(old,_)=>(tick 3;old=index))
                        answer
                      val _=case existing of NONE=>()|SOME(_,first)=>
                        if same(first,metric)then ()else raise ERR
                          "conditional_closure" "row alias metric disagrees"
                  in case existing of SOME _=>support_metrics rest answer
                     | NONE=>(tick 3;
                         support_metrics rest((index,metric)::answer))end
            val metrics=support_metrics(!support)[]
            fun context []= {raw=1,inclusive=1,annotations=1}:scc_metric
              | context((_,first)::rest)=
                  List.foldl(fn((_,row),all)=>add(
                    {raw=3,inclusive=3,annotations=9},add(row,all)))first rest
            val _=if bounded template_limit(context metrics)then ()else
              raise NotCovered "realized whole context exceeds template bound"
            val body=realized_metric false tree
            val _=if bounded output_limit body then ()else raise NotCovered
              "fully realized body exceeds original output bound"
            val hypotheses=List.map graph_metric(!required)
            val _=if List.all(bounded template_limit)hypotheses then ()else
              raise NotCovered "required Original Hyp exceeds template bound"
            fun sum(a:scc_metric,b:scc_metric):scc_metric=
              (tick 6;{raw= #raw a+ #raw b,
                inclusive= #inclusive a+ #inclusive b,
                annotations= #annotations a+ #annotations b})
            val upper=List.foldl sum zero hypotheses
            val strict=bounded input_limit body andalso
              List.all(bounded input_limit)hypotheses
        in(true,NONE,body,upper,strict)end
      val(covered,reason,body,upper,strict)=compute()handle NotCovered why=>
        (false,SOME why,zero,zero,false)
      val native_count=count hyp 0
      val used_count=count(!used)0
      val support_count=count(#rows d)0
      val definition_count=count(!definitions)0
      val root_count=count(!required)0
      val occurrence_count=count(!occurrences)0
      val _=tick 20
      val data:scc_data=
        {covered=covered,reason=reason,native_hypotheses=native_count,
         used_rows=used_count,support_rows=support_count,
         definitions=definition_count,
         original_roots=root_count,
         source_occurrences=occurrence_count,body_raw= #raw body,
         body_inclusive= #inclusive body,body_annotations= #annotations body,
         hypotheses_raw_upper= #raw upper,
         hypotheses_inclusive_upper= #inclusive upper,
         hypotheses_annotations_upper= #annotations upper,
         strict_input_bounds=strict,input_limit=input_limit,
         output_limit=output_limit,template_limit=template_limit}
      val _=tick 9
      val value=SourceConditionalClosurePlan
        {work=expected,held=held,graph=graph,scope=scope,revision=revision,
         data=data}
      val _=source_conditional_closure_guard expected value
    in value end)end)

  datatype source_conditional_constructor_origins =
    SourceConditionalConstructorOrigins of
    {work:W.portfolio,completed:source_predicate_conditional_completed,
     evidence:source_condition_evidence,incoming:source_condition_evidence,
     current:nc_proof,initial:nc_proof,epoch:int,symbols:int,
     complete:bool,known:int,unresolved:int}
  fun nc_same_hyp [] []=true
    | nc_same_hyp((actual,_)::rest)(term::terms)=
        Portable.pointer_eq(actual,term)andalso nc_same_hyp rest terms
    | nc_same_hyp _ _=false
  fun nc_current_for expected evidence (value:nc_proof)=
    let val data=sce_data expected evidence
    in if Portable.pointer_eq(#proof data,#proof value)andalso
        Portable.pointer_eq(#target data,#target value)andalso
        Portable.pointer_eq(Thm.concl(#proof value),#target value)andalso
        nc_same_hyp(#hyp value)(Thm.hyp(#proof value))then value
      else raise ERR "constructor_origins" "actual proof or Hyp changed"
    end
  fun source_conditional_constructor_origins_guard expected
      (SourceConditionalConstructorOrigins
        {work,completed,evidence,incoming,current,initial,epoch,symbols,...})=
    (if Portable.pointer_eq(expected,work)then ()else raise ERR
       "constructor_origins" "foreign expected Work";
     let val cd=source_predicate_conditional_completed_for expected completed
         val SourcePredicateConditionalCompleted
               {parent=SourcePredicateConditionalPlan
                 {raw=SCRClausePlan{evidence=actual,...},...},...}=completed
     in if Portable.pointer_eq(#evidence cd,evidence)andalso
           Portable.pointer_eq(actual,incoming)andalso
           epoch=Type.type_epoch()andalso symbols=Term.term_epoch()then ()
         else raise ERR "constructor_origins" "completion ancestry changed";
        ignore(nc_current_for expected evidence current);
        ignore(nc_current_for expected incoming initial)
     end)
  fun prepare_source_conditional_constructor_origins expected
      (completed as SourcePredicateConditionalCompleted{work,...})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work)then ()else raise ERR
         "constructor_origins" "foreign expected Work";
       W.with_step expected(fn()=>
       let
         fun live()=ignore(source_predicate_conditional_completed_for
           expected completed)
         fun tick amount=(live();W.spend expected amount)
         fun actual operation=
           (live();let val value=operation()in live();value end)
         val cd=source_predicate_conditional_completed_for expected completed
         val evidence= #evidence cd
         val SourcePredicateConditionalCompleted
               {parent=SourcePredicateConditionalPlan
                 {raw=SCRClausePlan{evidence=incoming,...},...},...}=completed
         fun stored evidence=
           (tick 6;case evidence of
               SCELeaf(SourceRuleRecipe{constructor_origins,...})=>
                 constructor_origins
             | SCEApplied{constructor_origins,...}=>constructor_origins
             | SCEProjected{value,...}=>stored value)
         (* Existing producer sidecars are immutable actual native outputs.
            An unsupported producer can only acquire atom seeds here. *)
         fun capture evidence=
           (tick 8;case stored evidence of
               SOME value=>nc_current_for expected evidence value
             | NONE=>
               let val data=sce_data expected evidence
                   val proof= #proof data val target= #target data
                   val _=tick 6
                   val hypotheses=actual(fn()=>Thm.hyp proof)
                   fun seed term=(tick 8;actual(fn()=>nc_seed term))
                   fun rows [] result=(tick 2;List.rev result)
                     | rows(term::rest)result=
                       let val value=seed term val _=tick 4
                       in rows rest((term,value)::result)end
                   val hyp=rows hypotheses[]
                   val conclusion=seed target val _=tick 8
               in {proof=proof,target=target,hyp=hyp,
                   conclusion=conclusion,events=0}:nc_proof end)
         val initial=capture incoming
         val current=capture evidence
         fun count [] known missing=(tick 2;(known,missing))
           | count((_,origin)::rest)known missing=
               (tick 6;if nc_known origin then count rest(known+1)missing
                else count rest known(missing+1))
         val(known,unresolved)=count(#hyp current)0 0
         val complete=nc_known(#conclusion current)andalso unresolved=0
         val _=tick 12
         val result=SourceConditionalConstructorOrigins
           {work=expected,completed=completed,evidence=evidence,
            incoming=incoming,current=current,initial=initial,
            epoch=Type.type_epoch(),symbols=Term.term_epoch(),
            complete=complete,known=known,unresolved=unresolved}
         val _=source_conditional_constructor_origins_guard expected result
       in result end)))
  fun source_conditional_constructor_origins_for expected
      (value as SourceConditionalConstructorOrigins
        {current,initial,complete,known,unresolved,...})=
    sr_fail expected(fn()=>
      (source_conditional_constructor_origins_guard expected value;
       {complete=complete,conclusion_known=nc_known(#conclusion current),
        incoming_conclusion_known=nc_known(#conclusion initial),
        hypotheses=known+unresolved,known_hypotheses=known,
        unresolved_hypotheses=unresolved,
        captured_events= #events current+ #events initial}))

  datatype source_conditional_effect_origins=SourceConditionalEffectOrigins of
    {work:W.portfolio,completed:source_predicate_conditional_completed,
     evidence:source_condition_evidence,current:nc_proof,
     recorded:bool,known:int,unresolved:int,epoch:int,symbols:int}
  fun ne_effect_query_guard expected
      (SourceConditionalEffectOrigins{work,completed,evidence,current,
        epoch,symbols,...})=
    (if Portable.pointer_eq(expected,work)then ()else raise ERR
       "conditional_effect_origins" "foreign expected Work";
     let val actual=source_predicate_conditional_completed_for
           expected completed
     in if Portable.pointer_eq(#evidence actual,evidence)andalso
         epoch=Type.type_epoch()andalso symbols=Term.term_epoch()then ()else
           raise ERR "conditional_effect_origins" "retained context changed";
        ignore(nc_current_for expected evidence current)
     end)
  fun prepare_source_conditional_effect_origins expected
      (completed as SourcePredicateConditionalCompleted{work,...})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work)then ()else raise ERR
         "conditional_effect_origins" "foreign expected Work";
       W.with_step expected(fn()=>let
         val actual=source_predicate_conditional_completed_for
           expected completed
         val evidence= #evidence actual
         fun guard()=ignore(source_predicate_conditional_completed_for
           expected completed)
         val(recorded,stored)=ne_stored expected guard evidence
         val current=case stored of SOME value=>
               nc_current_for expected evidence value
           | NONE=>raise ERR "conditional_effect_origins"
               "producer portfolio unavailable"
         fun count [] known missing=(W.spend expected 2;(known,missing))
           | count((_,origin)::rest)known missing=
               (guard();W.spend expected 6;
                if nc_known origin then count rest(known+1)missing
                else count rest known(missing+1))
         val(known,unresolved)=count(#hyp current)0 0
         val _=W.spend expected 16
         val result=SourceConditionalEffectOrigins{work=expected,
           completed=completed,evidence=evidence,current=current,
           recorded=recorded,known=known,unresolved=unresolved,
           epoch=Type.type_epoch(),symbols=Term.term_epoch()}
         val _=ne_effect_query_guard expected result
       in result end)))
  fun source_conditional_effect_origins_for expected
      (value as SourceConditionalEffectOrigins
        {work,current,recorded,known,unresolved,...})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work)then ()else raise ERR
         "conditional_effect_origins" "foreign expected Work";
       W.with_step expected(fn()=>
         (W.spend expected 16;ne_effect_query_guard expected value;
          {recorded=recorded,complete=nc_known(#conclusion current)andalso
             unresolved=0,conclusion_known=nc_known(#conclusion current),
           hypotheses=known+unresolved,known_hypotheses=known,
           unresolved_hypotheses=unresolved}))))

  (* Optional bounded ALL-row local proof. This is not GEN/HO admission.
     The unchanged realizer remains the sole proof producer. *)
  type scl_data={covered:bool,reason:string option,operations:int,
    support_rows:int,definitions:int,original_roots:int,source_occurrences:int,
    quote:IntInf.int,body_raw:IntInf.int,body_inclusive:IntInf.int,
    body_annotations:IntInf.int,strict_input_bounds:bool}
  type source_conditional_local_plan_data=scl_data
  val scl_match_fee=length
    ["match call","pending dispatch","actual field","model field",
     "allowance read","allowance comparison","allowance write",
     "fresh guard","zero payer","shape dispatch","Type read",
     "Type comparison","node test","atom comparison","comb projection",
     "children projection","pending cons","tail call","empty return",
     "Hyp iterator","Hyp scan","result branch"]
  datatype source_conditional_local_plan=SourceConditionalLocalPlan of
    {work:W.portfolio,closure:source_conditional_closure_plan,
     completed:source_predicate_conditional_completed,
     evidence:source_condition_evidence,proof:Thm.thm,
     rows:(Term.term*sce_witness)list,
     sigma:(G.node*Term.term*sg_tree)list,
     programme:((sg_tree*sg_tree list)*
       (sg_tree*sg_tree list)list)list,
     result:(sg_tree*sg_tree list)option,inspection:IntInf.int,
     roots:(G.node*sg_tree)list,occurrences:(int*G.node)list,
     data:scl_data,used:bool ref}
  datatype source_conditional_local_proof=SourceConditionalLocalProof of
    {work:W.portfolio,plan:source_conditional_local_plan,
     proof:Thm.thm,target:Term.term,hyp:Term.term list}
  fun scl_guard expected
      (SourceConditionalLocalPlan{work,closure,completed,evidence,proof,...})=
    (if Portable.pointer_eq(expected,work)then ()else raise ERR
       "conditional_local_proof" "foreign expected Work";
     source_conditional_closure_guard expected closure;
     let val data=source_predicate_conditional_completed_for
           expected completed
         val actual=sce_data expected evidence
     in if Portable.pointer_eq(#evidence data,evidence)andalso
         Portable.pointer_eq(#proof actual,proof)then ()else raise ERR
           "conditional_local_proof" "completed proof changed"end)
  fun source_conditional_local_plan_for expected
      (value as SourceConditionalLocalPlan{data,...})=
    sr_fail expected(fn()=>(scl_guard expected value;data))
  fun prepare_source_conditional_local_plan expected completed=
    sr_fail expected(fn()=>
    let val closure=prepare_source_conditional_closure_plan expected completed
    in W.with_step expected(fn()=>
    let
      val _=source_conditional_closure_guard expected closure
      val SourceConditionalClosurePlan{held,graph,scope,data=bounded,...}=
        closure
      val SourceConditionalNativePortfolio
        {evidence,proof,forests,conclusion,complete,...}=held
      val current=sce_data expected evidence
      val limits=W.semantic_limits expected
      val cap= #template_limit limits
      val output= #output_limit limits
      val SourcePredicateConditionalCompleted
        {parent=SourcePredicateConditionalPlan
          {raw=SCRClausePlan{check_type,...},...},...}=completed
      fun live()=source_conditional_closure_guard expected closure
      (* Each new written traversal uses its own nominal Source group.
         Actual guards/payers and private kernel work remain additional. *)
      val visit_fee=length["visit call","stack pattern","node pattern",
        "guard call","payer call","tag dispatch","field reads",
        "branch","stack cons","value cons","recursive call","return"]
      val list_fee=length["list call","list dispatch","pair fields",
        "guard call","payer call","comparison","branch","cons",
        "tail call","return"]
      val fixed_fee=length["prepare entry","closure fields","portfolio fields",
        "evidence fields","limits fields","completed fields","counter ref",
        "policy ref","programme ref","roots ref","row ref","sigma ref",
        "source occurrence ref","retained occurrence fields",
        "coverage branch","result tuple","data publication","plan fields",
        "phase ref","final guard","return"]
      fun tick n=(live();W.spend expected n)
      fun visit()=tick visit_fee
      fun each()=tick list_fee
      fun guarded action=(live();let val answer=action()in live();answer end)
      exception NotCovered of string
      val _=tick fixed_fee
      val policies=ref([]:Type.hol_type list)
      val programme=ref([]:((sg_tree*sg_tree list)*
        (sg_tree*sg_tree list)list)list)
      val roots=ref([]:(G.node*sg_tree)list)
      val occurrences=ref([]:(int*G.node)list)
      val rows_held=ref([]:(Term.term*sce_witness)list)
      val sigma_held=ref([]:(G.node*Term.term*sg_tree)list)
      val budget=ref(0:IntInf.int)
      val operations=ref 0
      val definitions=ref 0
      val final_model=ref(NONE:(sg_tree*sg_tree list)option)
      val inspection=ref(0:IntInf.int)
      fun reverse values=
        let fun run [] answer=(each();answer)
              | run(x::rest)answer=(each();run rest(x::answer))
        in run values []end
      fun map f values=
        let fun run [] answer=(each();reverse answer)
              | run(x::rest)answer=(each();run rest(f x::answer))
        in run values []end
      fun app f []=each()
        | app f(x::rest)=(each();f x;app f rest)
      fun size values=
        let fun run [] n=(each();n)
              | run(_::rest)n=(each();run rest(n+1))
        in run values 0 end
      fun append left right=
        let fun run [] answer=(each();answer)
              | run(x::rest)answer=(each();run rest(x::answer))
        in run(reverse left)right end
      fun concat lists=
        let fun run [] answer=(each();answer)
              | run(items::rest)answer=
                  (each();run rest(append items answer))
        in run(reverse lists)[]end
      fun type_scan ty=
        let fun run [] n=(visit();n)
              | run([]::rest)n=(visit();run rest n)
              | run((ty::siblings)::rest)n=
                (visit();policies:=ty:: !policies;
                 if Type.is_vartype ty then
                   (tick(String.size(Type.dest_vartype ty)+1);
                    run(siblings::rest)(n+1))
                 else let val{Thy,Tyop,Args}=Type.dest_thy_type ty
                          val _=tick(String.size Thy+String.size Tyop+2)
                      in run(Args::siblings::rest)(n+1)end)
        in run[[ty]](0:IntInf.int)end
      fun atom term=
        (visit();if Term.is_var term then
           (tick(String.size(#1(Term.dest_var term))+1);SGAtom term)
         else if Term.is_const term then
           let val{Thy,Name,...}=Term.dest_thy_const term
               val _=tick(String.size Thy+String.size Name+2)
           in SGAtom term end
         else raise NotCovered "non-atomic captured leaf")
      (* Origin screening reads only producer DATA; no native child opener.
         Binding relations are intentionally outside this first slice. *)
      fun origin known=
        let fun run []=(visit();())
              | run(value::rest)=
                (visit();case value of
                   NCAtom term=>(ignore(atom term);run rest)
                 | NCApplication(_,a,b)=>run(a::b::rest)
                 | NCEquality(_,a,b)=>run(a::b::rest)
                 | NCImplication(_,a,b)=>run(a::b::rest)
                 | NCSelected(_,parent)=>run(parent::rest)
                 | NCEqtEffect(_,parent,_)=>run(parent::rest)
                 | NCConjCloseEffect(_,a,b,_)=>run(a::b::rest)
                 | NCVariableHyp(_,_,_,_,hyp,first,second)=>
                     (app(fn(_,value)=>run[value])hyp;
                      app(fn(redex,_,value)=>
                        (if Term.is_var redex then ()else raise NotCovered
                           "non-variable origin substitution";run[value]))
                        first;
                      app(fn(redex,_,value)=>
                        (if Term.is_var redex then ()else raise NotCovered
                           "non-variable insertion";run[value]))second;
                      run rest)
                 | NCBlockRow _=>run rest
                 | NCBlockContext _=>run rest
                 | _=>raise NotCovered
                     "binding or unresolved constructor origin")
        in run[known]end
      fun captured_type(SRCaptured ty)=ty
        | captured_type _=raise NotCovered "virtual Type needs materialization"
      fun forest value=
        let datatype task=Tree of sr_tree | Join of Type.hol_type
            fun run [] [answer]=answer
              | run(Tree tree::rest)values=
                (visit();case #shape(sr_data tree)of
                   SRAtom term=>run rest(atom term::values)
                 | SRApp(a,b)=>run(Tree a::Tree b::
                     Join(captured_type(sr_type tree))::rest)values
                 | _=>raise NotCovered "binder or unresolved native forest")
              | run(Join ty::rest)(right::left::values)=
                  (visit();run rest(SGApp(ty,left,right)::values))
              | run _ _=raise ERR "conditional_local_proof"
                  "private native forest stack"
        in run[Tree value][]end
      fun tree_model(SGAtom term)=SCEAtom term
        | tree_model(SGApp(ty,a,b))=
            (visit();SCEApp(ty,tree_model a,tree_model b))
        | tree_model _=raise NotCovered "non-captured comparison syntax"
      fun same a b=sce_equal tick(tree_model a)(tree_model b)
      fun insert(tree,values)=
        if List.exists(fn value=>(each();same tree value))values then values
        else append values[tree]
      fun union left right=List.foldl insert left right
      fun without row values=
        List.filter(fn value=>(each();not(same row value)))values
      fun metric value=
        let fun run [] raw inc ann=(visit();(raw,inc,ann))
              | run(tree::rest)raw inc ann=
                let val _=visit()
                    val _=if raw<IntInf.fromInt cap andalso
                        inc<IntInf.fromInt cap then ()else raise NotCovered
                          "operation operand exceeds original template"
                    val annotations=type_scan(sg_type tree)
                in case tree of SGAtom _=>run rest(raw+1)(inc+1)
                     (ann+annotations)
                   | SGApp(_,a,b)=>run(a::b::rest)(raw+1)(inc+1)
                       (ann+annotations)
                   | _=>raise NotCovered "unmaterialized operation syntax"
                end
        in run[value]0 0 0 end
      fun quote values=
        let val amount=List.foldl(fn(tree,total)=>
              let val(r,i,a)=metric tree in total+r+i+a end)
              (1:IntInf.int)values
            val _=visit()
            val _=budget:= !budget+amount
        in if !budget<=remaining expected then ()else raise ERR
          "conditional_local_proof" "prospective all-row Work"end
      fun footprint(c,h)=c::h
      fun event result operands=
        (quote(append(footprint result)(concat(map footprint operands)));
         visit();programme:=(result,operands):: !programme;
         operations:= !operations+1;result)
      fun graph_tree node=
        let val _=visit()
            val _=ignore(G.closure_root graph scope node)
            val _=app(fn kind=>case G.unfolded_nodes graph kind cap node of
                SOME n=>if n<=cap then ()else raise NotCovered
                  "full sigma port exceeds template"
              | NONE=>raise NotCovered "full sigma port is unbounded")
              [G.RawNodes,G.BinderInclusiveNodes]
            val actual=G.representative graph node
            val _=origin(nt_graph_origin(NTPrefix(expected,live))
              graph node actual)
            datatype task=Node of G.node | Join of Type.hol_type
            fun run [] [answer]=answer
              | run(Node node::rest)values=
                (visit();case G.view graph node of
                   G.Variable _=>run rest(atom(G.representative graph node)
                     ::values)
                 | G.Constant _=>run rest(atom(G.representative graph node)
                     ::values)
                 | G.Application(a,b)=>run(Node a::Node b::
                     Join(G.type_of graph node)::rest)values
                 | _=>raise NotCovered "full sigma port lacks bare geometry")
              | run(Join ty::rest)(right::left::values)=
                  (visit();run rest(SGApp(ty,left,right)::values))
              | run _ _=raise ERR "conditional_local_proof"
                  "private graph tree stack"
        in run[Node node][]end
      fun project_models boundary(proof as(c,h))=case boundary of
          Empty=>[] | Leaf _=>[proof]
        | Split(a,b)=>
            let val(left,right)=case c of
                  SGApp(_,SGApp(_,_,left),right)=>(left,right)
                | _=>raise ERR "conditional_local_proof"
                    "private context shape changed"
                val first=event(left,h)[proof]
                val second=event(right,h)[proof]
            in append(project_models a first)(project_models b second) end
      fun proof_tree models=
        let val entries=Vector.fromList models
            fun run Empty=raise NotCovered "empty support bootstrap"
              | run(Leaf index)=Vector.sub(entries,index)
              | run(Split(a,b))=
                  let val left as(l,lh)=run a
                      val right as(r,rh)=run b
                  in event(sg_binary boolSyntax.conjunction l r,
                    union lh rh)[left,right]end
        in run(make_tree 0(Vector.length entries))end
      fun substitute sigma tree=case tree of SGAtom term=>
            let val matches=List.filter(fn(_,redex,_)=>(each();
                  Term.term_eq term redex))sigma
            in case matches of []=>tree | (_,_,first)::rest=>
                (app(fn(_,_,other)=>if same first other then ()else
                  raise ERR "conditional_local_proof"
                    "same-name graph aliases disagree")rest;first)end
        | SGApp(ty,a,b)=>(visit();SGApp(ty,substitute sigma a,
            substitute sigma b))
        | _=>raise NotCovered "protected substitution under binding"
      (* All row slots share this exact private recipe and the SAME factory.
         A bare original Block and both genuinely captured VAR sigmas certify
         each separately rebuilt actual row; no actual-row raw walk occurs. *)
      fun row_recipe rows=
        let val recipe=case rows of (_,SCEWitness(recipe,_))::_=>recipe
              | _=>raise NotCovered "empty row programme"
            val _=validate_source_rule_for expected recipe
            val SourceRuleRecipe{base=SourceCompact{block,proof=input,
                  needed,extra_leaves,cuts,...},hyp_universe=(initial,_),
                  source_effect_origins,...}=recipe
            val _=if null cuts andalso null extra_leaves then ()else
              raise NotCovered
                "cut or extra support requires a separate issuer"
            val _=app(fn(_,value)=>origin value)
              (nt_block_origins(NTPrefix(expected,live))block)
            fun transport(_,NCVariableHyp(_,held,_,actual,hyp,a,b))=
                  if Portable.pointer_eq(held,input)andalso
                      Portable.pointer_eq(actual,initial)then
                    (app(fn(_,value)=>origin value)hyp;
                     app(fn(redex,_,value)=>
                       (if Term.is_var redex then ()else raise NotCovered
                         "row renaming is not variable-only";origin value))a;
                     app(fn(redex,_,value)=>
                       (if Term.is_var redex then ()else raise NotCovered
                         "row insertion is not variable-only";origin value))b;
                     true)else false
              | transport _=false
            val candidates=case source_effect_origins of NONE=>[]
              | SOME value=> #hyp value
            val _=app(fn(_,value)=>origin value)candidates
            val _=if List.exists(fn pair=>(each();transport pair))candidates
              then ()else raise NotCovered
                "rows lack genuine two-INST constructor transport"
            val _=if size needed=size rows then ()else raise ERR
              "conditional_local_proof" "needed support order changed"
        in recipe end
      fun compute()=
        let fun applied value=(visit();case value of
                  SCEProjected{value,...}=>applied value
                | SCEApplied _=>()
                | _=>raise NotCovered
                    "leaf realization needs its separate native itinerary")
            val _=applied evidence
            val _=if #covered bounded andalso complete then ()else
              raise NotCovered "bounded current closure is unavailable"
            val(_,stored)=ne_stored expected live evidence
            val native=case stored of NONE=>raise NotCovered
                "current constructor portfolio unavailable"
              | SOME value=>nc_current_for expected evidence value
            val _=origin(#conclusion native)
            val _=app(fn(_,value)=>origin value)(#hyp native)
            val body=case conclusion of SOME tree=>forest tree
              | NONE=>raise NotCovered "current body forest unavailable"
            val hypothesis_models=map(fn(_,tree)=>forest tree)forests
            val row_programme=case sce_admitted_row_programme_inside
                expected evidence of NONE=>raise NotCovered
                  "exact all-row programme unavailable"
              | SOME value=>value
            val recipe=row_recipe(#rows row_programme)
            val{plan,fresh,admission,rows}=row_programme
            val service=case sr_admitted_forest_programme expected plan fresh
                admission(map #1 forests)of NONE=>raise NotCovered
                  "shared row certification unavailable"
              | SOME value=>value
            val _=rows_held:=rows
            val _=if null rows then raise NotCovered "empty support"else ()
            val sigma=map(fn(node,redex)=>
              (if Term.is_var redex then ()else raise NotCovered
                 "non-variable full sigma redex";
               (node,redex,graph_tree node)))(#names current)
            val _=sigma_held:=sigma
            fun row((actual,SCEWitness(owner,slot)),index)=
              let val _=if Portable.pointer_eq(recipe,owner)then ()else
                    raise NotCovered "mixed row recipe"
                  val matches=case #matches service actual of NONE=>
                      raise NotCovered "actual support forest unavailable"
                    | SOME values=>values
                  val own=List.filter(fn(held,_)=>(each();held=index))matches
                  val first=case own of (_,tree)::_=>forest tree
                    | _=>raise NotCovered "actual support slot unavailable"
                  val _=app(fn(_,tree)=>if same first(forest tree)then ()else
                    raise ERR "conditional_local_proof"
                      "same support slot forests disagree")own
                  val SourceRuleRecipe{base=SourceCompact
                    {block=Block{leaves,...},...},...}=owner
                  val leaf=Vector.sub(leaves,slot)
              in(first,substitute sigma first,leaf)end
            val row_models=map row(ListPair.zip(rows,
              List.tabulate(size rows,fn i=>i)))
            val original_rows=map #1 row_models
            val transformed_rows=map #2 row_models
            val transformed_body=substitute sigma body
            val boundary=make_tree 0(size rows)
            val context=sg_forest original_rows
            val transformed_context=sg_forest transformed_rows
            val initial=(body,hypothesis_models)
            val _=quote(footprint initial)
            val assumption=event(context,[context])[]
            val projections=project_models boundary assumption
            fun replace(premise as(row,ph),current as(c,ch))=
              let val discharged=event
                    (sg_binary boolSyntax.implication row c,
                     without row ch)[current]
              in event(c,union(#2 discharged)ph)[discharged,premise]end
            val lifted=List.foldl replace initial projections
            val law=event(sg_binary boolSyntax.implication context
                (#1 lifted),without context(#2 lifted))[lifted]
            val _=if null(#2 law)then ()else raise NotCovered
              "all-row projections do not close current Hyp"
            val actual=event(sg_binary boolSyntax.implication
              transformed_context transformed_body,[])[law]
            val _=quote(concat(map(fn(_,redex,residue)=>
              [SGAtom redex,residue])sigma))
            val realized_assumption=event
              (transformed_context,[transformed_context])[]
            val _=project_models boundary realized_assumption
            val original_nodes=append(SmtReplaySource.assumption_nodes
              (W.original_sources expected))
                [SmtReplaySource.denied_goal_node(W.original_sources expected)]
            fun backing(_,row,Source node)=
                  let fun aliases [] _ found=(each();found)
                            | aliases(held::rest)index found=
                              (each();if held=node then
                                (if List.exists(fn pair=>(each();
                                    pair=(index,node)))(!occurrences)
                                   then ()else
                                     occurrences:=(index,node):: !occurrences;
                                 aliases rest(index+1)true)
                               else aliases rest(index+1)found)
                      val _=if aliases original_nodes 0 false then ()else
                        raise NotCovered
                          "Source witness is not an actual Original root"
                      val wanted=graph_tree node
                      val _=if same row wanted then ()else raise ERR
                        "conditional_local_proof" "Source row changed"
                      val _=if List.exists(fn(held,tree)=>(each();
                        held=node andalso same wanted tree))(!roots)
                        then ()else roots:=(node,wanted):: !roots
                  in event(row,[row])[]end
              | backing(_,row,Definition _)=
                  let val(a,b)=case row of
                        SGApp(_,SGApp(_,_,a),b)=>(a,b)
                      | _=>raise NotCovered "Definition is not equality"
                      val _=if same a b then ()else raise NotCovered
                        "Definition ALPHA lacks identical bare operands"
                      val _=definitions:= !definitions+1
                      val _=quote[a,b]
                  in event(row,[])[]end
              | backing _=raise NotCovered
                  "closed or conversion witness requires its own import bill"
            val models=map backing row_models
            val support=proof_tree models
            val result=event(transformed_body,#2 support)[actual,support]
            val(raw,inc,ann)=metric(#1 result)
            val _=if raw<=IntInf.fromInt output andalso
                inc<=IntInf.fromInt output then ()else raise NotCovered
                  "realized body exceeds original output bound"
            val hyp_metrics=map metric(#2 result)
            val input=IntInf.fromInt(#input_limit limits)
            val strict=raw<=input andalso inc<=input andalso
              List.all(fn(r,i,_)=>(each();r<=input andalso i<=input))
                hyp_metrics
            val n=IntInf.fromInt(size(#2 result))
            val hraw=List.foldl(fn((r,_,_),all)=>all+r)0 hyp_metrics
            (* C is matched once. ALL actual H and ALL model H are checked
               in both directions, with at most n*n full candidate matches.
               Nil/dispatch tests have a separate conservative prefix. *)
            val bound=raw+2*n*hraw+4*(n+1)*(n+1)+8
            val _=inspection:=bound*IntInf.fromInt scl_match_fee
            val _=final_model:=SOME result
        in(true,NONE,raw,inc,ann,strict)end
      val(covered,reason,raw,inc,ann,strict)=compute()
        handle NotCovered reason=>(false,SOME reason,0,0,0,false)
      val ordered=reverse(!programme)
      val all_policies=reverse(!policies)
      (* The complete SG-class footprint subtotal is reserved before ALL
         callback policies and before any realization proof effect. Existing
         native realizer fees remain additional, with no cached credit. *)
      val _=if covered then
        guarded(fn()=>pay expected(!budget+ !inspection))else ()
      val _=if covered then app(fn ty=>guarded(fn()=>check_type ty))
        all_policies else ()
      val _=tick fixed_fee
      val data:scl_data={covered=covered,reason=reason,
        operations= !operations,support_rows=size(!rows_held),
        definitions= !definitions,original_roots=size(!roots),
        source_occurrences=size(!occurrences),quote= !budget+ !inspection,
        body_raw=raw,body_inclusive=inc,body_annotations=ann,
        strict_input_bounds=covered andalso strict}
      val value=SourceConditionalLocalPlan{work=expected,closure=closure,
        completed=completed,evidence=evidence,proof=proof,rows= !rows_held,
        sigma= !sigma_held,programme=ordered,result= !final_model,
        inspection= !inspection,roots= !roots,
        occurrences= !occurrences,data=data,
        used=ref false}
      val _=scl_guard expected value
    in value end)end)
  fun source_conditional_local_proof_guard expected
      (SourceConditionalLocalProof{work,plan,proof,target,hyp})=
    (if Portable.pointer_eq(expected,work)then ()else raise ERR
       "conditional_local_proof" "foreign expected Work";
     scl_guard expected plan;
     let fun same [] []=true
           | same(a::rest)(b::more)=Portable.pointer_eq(a,b)andalso
               same rest more
           | same _ _=false
     in if Portable.pointer_eq(Thm.concl proof,target)andalso
         same hyp(Thm.hyp proof)andalso clean proof then ()else raise ERR
         "conditional_local_proof" "issued local proof changed"end)
  val scl_issue_entry_fee=length
    ["issue entry","Work action call","plan guard call","payer call",
     "phase read","phase branch","coverage read","coverage branch",
     "phase write","plan guard call","return"]
  val scl_issue_finish_fee=length
    ["finish action call","plan guard call","payer call","closure pattern",
     "graph field","Hyp read","Hyp iterator call","proof record tag",
     "owner field","plan field","proof field","target read","target field",
     "Hyp field","result guard call","result return","action return"]
  val scl_issue_hyp_fee=length
    ["Hyp iterator entry","Hyp list dispatch","Hyp item","Hyp tail",
     "root scan call","root list dispatch","root pair","node projection",
     "representative call","pointer comparison","branch","tail call",
     "owner guard","payer call","return"]
  fun execute_source_conditional_local_plan expected
      (value as SourceConditionalLocalPlan
        {evidence,roots,data,used,result=model,inspection,...})=
    sr_fail expected(fn()=>
    let val _=W.with_step expected(fn()=>
          (scl_guard expected value;
           W.spend expected scl_issue_entry_fee;
           if !used then raise ERR "conditional_local_proof"
             "local plan already consumed"else ();
           if #covered data then ()else raise ERR "conditional_local_proof"
             "local plan is NotCovered";
           used:=true;scl_guard expected value))
        (* This operation enters its OWN original Work action. No recursive
           Busy action, raw theorem adoption or newly stamped SCE occurs. *)
        val proof=realize_source_condition_evidence expected evidence
        val result=W.with_step expected(fn()=>
          let val _=scl_guard expected value
              val _=W.spend expected scl_issue_finish_fee
              val SourceConditionalClosurePlan{graph,...}=
                (case value of SourceConditionalLocalPlan{closure,...}=>
                   closure)
              val hyp=Thm.hyp proof
              val pending=ref inspection
              fun take()=
                (scl_guard expected value;
                 if !pending>=IntInf.fromInt scl_match_fee then
                   pending:= !pending-IntInf.fromInt scl_match_fee
                 else raise ERR "conditional_local_proof"
                   "private issued-shape allowance exhausted";
                 W.spend expected 0)
              fun shape actual wanted=
                let fun run []=(take();true)
                      | run((actual,wanted)::rest)=
                          (take();if Type.compare(Term.type_of actual,
                              sg_type wanted)<>EQUAL then false else
                           case wanted of SGAtom term=>
                               (Term.is_var actual orelse
                                Term.is_const actual)andalso
                               Term.term_eq actual term andalso run rest
                             | SGApp(_,a,b)=>if Term.is_comb actual then
                                 let val(left,right)=Term.dest_comb actual
                                 in run((left,a)::(right,b)::rest)end
                               else false
                             | _=>false)
                in run[(actual,wanted)]end
              val(wanted,wanted_hyp)=case model of SOME result=>result
                | NONE=>raise ERR "conditional_local_proof"
                    "covered plan lost final programme"
              fun actuals [] _=(take();false)
                | actuals(actual::rest)tree=
                    (take();shape actual tree orelse actuals rest tree)
              fun models _ []=(take();false)
                | models actual(tree::rest)=
                    (take();shape actual tree orelse models actual rest)
              fun check_actual []=take()
                | check_actual(actual::rest)=
                    (take();if models actual wanted_hyp then
                       check_actual rest else raise ERR
                         "conditional_local_proof" "actual Hyp model changed")
              fun check_models []=take()
                | check_models(tree::rest)=
                    (take();if actuals hyp tree then check_models rest else
                       raise ERR "conditional_local_proof"
                         "forecast Hyp is absent from actual proof")
              fun count maximum values=
                let fun run [] n=(take();SOME n)
                      | run(_::rest)n=
                          (take();if n=maximum then NONE
                           else run rest(n+1))
                in run values 0 end
              val n=case count(#template_limit(W.semantic_limits expected))
                  wanted_hyp of SOME n=>n
                | NONE=>raise ERR "conditional_local_proof"
                    "forecast Hyp cardinality exceeds template"
              val _=if Option.isSome(count n hyp)andalso
                  shape(Thm.concl proof)wanted then ()else raise ERR
                    "conditional_local_proof" "issued conclusion changed"
              val _=check_actual hyp
              val _=check_models wanted_hyp
              fun paid()=(scl_guard expected value;
                W.spend expected scl_issue_hyp_fee)
              fun member term []=(paid();false)
                | member term((node,_)::rest)=
                    (paid();Portable.pointer_eq(term,
                      G.representative graph node)orelse member term rest)
              fun all []=paid()
                | all(term::rest)=
                    (paid();if member term roots then all rest else
                      raise ERR "conditional_local_proof"
                        "realized Hyp lacks retained actual Original root")
              val _=all hyp
              val result=SourceConditionalLocalProof{work=expected,plan=value,
                proof=proof,target=Thm.concl proof,hyp=hyp}
              val _=source_conditional_local_proof_guard expected result
          in result end)
    in result end)
  fun source_conditional_local_proof_for expected
      (value as SourceConditionalLocalProof{plan,proof,hyp,...})=
    sr_fail expected(fn()=>
      (source_conditional_local_proof_guard expected value;
       let val SourceConditionalLocalPlan{data,...}=plan
       in {closed_definitions= #definitions data,hypotheses=length hyp,
           body_raw= #body_raw data,body_inclusive= #body_inclusive data,
           body_annotations= #body_annotations data,
           strict_input_bounds= #strict_input_bounds data}end))

  (* Experimental distinct opcode. No SCE/SourceRealization is issued. *)
  type bg_metric={raw:IntInf.int,inclusive:IntInf.int,
    types:Type.hol_type list}
  datatype bg_phase=BGPrepared | BGAdmitting | BGAdmitted | BGConsumed
  datatype source_bounded_scalar_gen_plan=SourceBoundedScalarGenPlan of
    {work:W.portfolio,held:source_conditional_native_portfolio,
     current:nc_proof,graph:G.graph,scope:G.scope,revision:IntInf.int,
     alpha:G.discovered_alpha,source:G.source,root:G.node,
     variable:Term.term,original:Term.term,normalized:Term.term,
     normalized_origin:nc_origin,expected:Term.term,
     types:Type.hol_type list,phase:bg_phase ref,subtotal:IntInf.int}
  datatype source_bounded_scalar_gen_result=SourceBoundedScalarGenResult of
    {plan:source_bounded_scalar_gen_plan,proof:Thm.thm,target:Term.term,
     hypotheses:Term.term list,tag:Tag.tag,origin:nc_proof}
  fun bg_tag left right=Tag.dest_tag left=Tag.dest_tag right andalso
    Tag.axioms_of left=Tag.axioms_of right andalso
    Tag.dep_of left=Tag.dep_of right
  fun bg_empty tag=Tag.dest_tag tag=([],[])andalso
    null(Tag.axioms_of tag)andalso Tag.dep_of tag=Dep.empty_dep
  fun bg_guard expected
      (SourceBoundedScalarGenPlan{work,held,current,graph,scope,revision,
        alpha,source,root,original,normalized,...})=
    (if Portable.pointer_eq(expected,work)then ()else raise ERR
       "bounded_scalar_gen" "foreign expected Work";
     source_conditional_native_portfolio_guard expected held;
     let val SourceConditionalNativePortfolio{evidence,...}=held
         val _=ignore(nc_current_for expected evidence current)
         val _=G.validate_discovered_alpha graph scope alpha
         val d=G.discovered_alpha_data graph scope alpha
     in if #original d=root andalso
         Portable.pointer_eq(#original source,original)andalso
         Portable.pointer_eq(#bridge(#source d),#bridge source)andalso
         Portable.pointer_eq(G.representative graph(#node source),
           normalized)andalso
         G.validation_revision graph scope=revision then ()else raise ERR
           "bounded_scalar_gen" "cached Original bridge interval changed"
     end)
  fun source_bounded_scalar_gen_plan_for expected
      (value as SourceBoundedScalarGenPlan
        {held,variable,original,normalized,expected=target,types,
         subtotal,phase,...})=
    sr_fail expected(fn()=>
      (bg_guard expected value;
       if !phase=BGConsumed then raise ERR "bounded_scalar_gen"
         "consumed plan"else ();
       let val SourceConditionalNativePortfolio{target=input,proof,...}=held
       in {variable=variable,input=input,original_hypothesis=original,
         normalized_hypothesis=normalized,statement=target,types=types,
         input_tag=Thm.tag proof,native_calls=10,subtotal=subtotal}end))
  fun prepare_source_bounded_scalar_gen expected
      (completed as SourcePredicateConditionalCompleted{work,...})=
    sr_fail expected(fn()=>
    let val _=if Portable.pointer_eq(expected,work)then ()else raise ERR
          "bounded_scalar_gen" "foreign expected Work"
        val held=prepare_source_conditional_native_portfolio
          expected completed
    in W.with_step expected(fn()=>let
      val SourceConditionalNativePortfolio
        {evidence,frame,proof,target,hyp,forests,conclusion,
         decision,complete,...}=held
      fun live()=source_conditional_native_portfolio_guard expected held
      fun tick amount=(live();W.spend expected amount)
      fun actual action=
        (live();let val value=action()in live();value end)
      fun refuse why=raise ERR "bounded_scalar_gen" why
      val _=tick 12
      val _=if complete then ()else refuse "current syntax is unresolved"
      val variable=case decision of ConditionalSingleton v=>v
        | _=>refuse "authentic singleton is required"
      val original=case hyp of [term]=>term
        | _=>refuse "exactly one surviving Original Hyp is required"
      val sd=Scope.description_for expected frame
      val graph= #graph sd val scope= #scope sd
      val sources=W.original_sources expected
      val _=if Portable.pointer_eq(sources,#sources sd)then ()else
        refuse "different original Source"
      val limits=W.semantic_limits expected
      val cap= #input_limit limits
      val template= #template_limit limits
      val output= #output_limit limits
      fun reverse [] result=(tick 1;result)
        | reverse(x::rest)result=(tick 3;reverse rest(x::result))
      fun append left right=
        List.foldl(fn(x,all)=>(tick 3;x::all))right(reverse left[])
      fun flat descriptors=
        let fun run [] answer=reverse answer[]
              | run(SRCaptured ty::rest)answer=
                  (tick 4;run rest(ty::answer))
              | run _ _=refuse "virtual actual Type annotation"
        in run descriptors[]end
      fun metric tree:bg_metric=
        (tick 5;{raw=sr_raw tree,inclusive=sr_inc tree,
          types=flat(sr_types tree)})
      fun bounded limit({raw,inclusive,...}:bg_metric)=
        (tick 3;raw<=IntInf.fromInt limit andalso
          inclusive<=IntInf.fromInt limit)
      val c=case conclusion of SOME tree=>metric tree
        | NONE=>refuse "current conclusion forest is missing"
      val h=case forests of [(term,tree)]=>
            if Portable.pointer_eq(term,original)then metric tree
            else refuse "actual Hyp association differs"
        | _=>refuse "ALL actual Hyp forests are required"
      val _=if bounded cap c andalso bounded cap h then ()else
        refuse "whole current conclusion/Hyp exceeds original input bound"
      val roots=append(SmtReplaySource.assumption_nodes sources)
        [SmtReplaySource.denied_goal_node sources]
      fun aliases [] result=reverse result[]
        | aliases(node::rest)result=
            (tick 7;if Portable.pointer_eq(
                G.representative graph node,original)then
               aliases rest(node::result)else aliases rest result)
      val root=case aliases roots[]of [node]=>node
        | _=>refuse "single authentic Original occurrence is required"
      val _=tick 10
      val _=case G.view graph root of G.Application(operator,_)=>
          (case G.view graph operator of G.Constant _=>
             if Term.same_const(G.representative graph operator)
                 boolSyntax.universal then ()else
               refuse "Original Hyp is not a direct forall Source"
           | _=>refuse "Original forall operator is not an actual constant")
        | _=>refuse "Original Hyp lacks the admitted forall prefix"
      val(recorded,stored)=ne_stored expected live evidence
      val current=case stored of SOME value=>
            nc_current_for expected evidence value
        | NONE=>refuse "actual producer origin is unavailable"
      val _=if recorded andalso nc_known(#conclusion current)then ()else
        refuse "actual current conclusion lacks constructor origin"
      val _=tick 16
      val(condition,equation)=case Lib.total boolSyntax.dest_imp_only target of
          SOME pair=>pair | NONE=>refuse "current target is not implication"
      val(f,argument)=case Lib.total Term.dest_comb condition of
          SOME pair=>pair | NONE=>refuse "condition is not atomic F(v)"
      val(left,right)=case Lib.total boolSyntax.dest_eq equation of
          SOME pair=>pair | NONE=>refuse "current consequent is not equality"
      val _=if (Term.is_var f orelse Term.is_const f)andalso
          Term.term_eq argument variable andalso
          Type.compare(Term.type_of left,Type.bool)=EQUAL andalso
          Type.compare(Term.type_of right,Type.bool)=EQUAL then ()else
        refuse "current scalar F(v)/Boolean equality grammar differs"
      (* Cache read only. No missing-cache path calls an opener. *)
      val _=tick 12
      val source=actual(fn()=>G.cached_opened_view graph scope root)
      val _=if Portable.pointer_eq(#original source,original)then ()else
        refuse "cached bridge is for a different actual Original Hyp"
      val normalized=G.representative graph(#node source)
      val _=if Portable.pointer_eq(original,normalized)then
        refuse "this opcode requires a nonidentity cached normalization"
        else ()
      val _=tick 12
      val _=case(G.unfolded_nodes graph G.RawNodes cap(#node source),
          G.unfolded_nodes graph G.BinderInclusiveNodes cap(#node source))of
          (SOME raw,SOME inclusive)=>if raw<=cap andalso inclusive<=cap
            then ()else refuse "normalized Hyp exceeds input bound"
        | _=>refuse "normalized Hyp geometry is unavailable"
      (* Read-only authentic constructor paths, bounded by the two retained
         graph geometries. Library/private getter work remains qualified. *)
      val maximum_value=4*IntInf.fromInt cap+4
      val maximum=case Int.maxInt of SOME limit=>
            if maximum_value<=IntInf.fromInt limit then
              IntInf.toInt maximum_value else
              refuse "metadata bound exceeds supported public integer"
        | NONE=>IntInf.toInt maximum_value
      val _=tick 16
      val alpha=actual(fn()=>G.discovered_alpha graph scope maximum root)
      val ad=G.discovered_alpha_data graph scope alpha
      val _=if Portable.pointer_eq(#bridge(#source ad),#bridge source)
        then ()else refuse "different cached alpha proof"
      val revision=G.validation_revision graph scope
      val _=tick 8
      val bridge_tag=Thm.tag(#bridge source)
      val _=if null(Thm.hyp(#bridge source))andalso bg_empty bridge_tag
        then ()else
        refuse "normalization bridge is not fully empty-tag closed"
      val _=tick 8
      val tag=Thm.tag proof
      val _=if bg_tag(Tag.merge tag bridge_tag)tag andalso
          bg_tag(Tag.merge bridge_tag tag)tag then ()else
        refuse "input full Tag is not stable under empty bridge merging"
      fun profile ty=
        let fun run [] answer=reverse answer[]
              | run([]::rest)answer=(tick 2;run rest answer)
              | run((ty::args)::rest)answer=
                  (tick 14;
                   if Type.is_vartype ty then
                     (tick(String.size(Type.dest_vartype ty)+1);
                      run(args::rest)(ty::answer))
                   else let val{Thy,Tyop,Args}=Type.dest_thy_type ty
                            val _=tick(String.size Thy+String.size Tyop+2)
                        in run(Args::args::rest)(ty::answer)end)
        in run[[ty]][]end
      fun equal a b=(tick 4;Term.term_eq a b)
      fun member term values=List.exists(fn old=>equal term old)values
      fun add(own:bg_metric,left:bg_metric,right:bg_metric):bg_metric=
        (tick 8;{raw= #raw own+ #raw left+ #raw right,
          inclusive= #inclusive own+ #inclusive left+ #inclusive right,
          types=append(#types own)(append(#types left)(#types right))})
      datatype bg_task=BGVisit of G.closure_child*Term.term list
        | BGApp of Term.term*Type.hol_type list
        | BGAbs of Term.term*Term.term*Type.hol_type list
      fun normalized_origin()=
        let fun run [] [answer]=answer
              | run(BGVisit(child,bound)::rest)values=
                  let val _=tick 24
                      val node=G.closure_child_node graph scope child
                      val term=G.representative graph node
                      val types=profile(G.type_of graph node)
                  in case G.view graph node of
                    G.Application _=>
                      let val(left,right)=G.closure_application_children
                            graph scope child val _=tick 10
                      in run(BGVisit(left,bound)::BGVisit(right,bound)::
                        BGApp(term,types)::rest)values end
                  | G.AdmittedBinder _=>
                      let val closure=G.closure_child_binder
                            graph scope child
                          val d=G.binder_closure_data graph scope closure
                          val binder= #binder_term d
                          val more=profile(Term.type_of binder)
                          val _=tick 10
                      in run(BGVisit(G.binder_closure_body graph scope
                        closure,binder::bound)::BGAbs(term,binder,
                          append types more)::rest)values end
                  | G.Variable _=>
                      if equal term variable andalso
                          not(member term bound)then
                        refuse "selected VAR occurs in normalized Hyp"
                      else run rest((NCAtom term,
                        {raw=1,inclusive=1,types=types}:bg_metric)::values)
                  | G.Constant _=>run rest((NCAtom term,
                        {raw=1,inclusive=1,types=types}:bg_metric)::values)
                  | _=>refuse "normalized constructor residue is opaque"
                  end
              | run(BGApp(term,types)::rest)
                  ((right,rm)::(left,lm)::values)=
                    run rest((NCApplication(term,left,right),add(
                      {raw=1,inclusive=1,types=types},lm,rm))::values)
              | run(BGAbs(term,binder,types)::rest)((body,bm)::values)=
                  (tick 8;run rest((NCAbstraction(term,binder,body),
                    {raw=1+ #raw bm,inclusive=2+ #inclusive bm,
                     types=append types(#types bm)}:bg_metric)::values))
              | run _ _=refuse "normalized constructor stack differs"
        in run[BGVisit(#annotation ad,[])][]end
      val(normalized_origin,n)=normalized_origin()
      val _=if nc_known normalized_origin andalso bounded cap n then ()else
        refuse "normalized constructor incidence exceeds input bound"
      (* Reserve the actual public Type-constructor group before execution.
         This is a nominal partial programme, not private kernel pricing. *)
      val vty=Term.type_of variable
      val _=tick 9 val abstraction_type=Type.-->(vty,Type.bool)
      val _=tick 9 val universal_type=Type.-->(abstraction_type,Type.bool)
      val _=tick 9 val boolean_arrow=Type.-->(Type.bool,Type.bool)
      val _=tick 9 val binary_type=Type.-->(Type.bool,boolean_arrow)
      val vt=profile vty
      val at=profile abstraction_type val ut=profile universal_type
      val gen:bg_metric={raw= #raw c+3,inclusive= #inclusive c+4,
        types=Type.bool::append ut(append at(append vt(#types c)))}
      val bool_ports=[Type.bool,boolean_arrow,Type.bool,Type.bool,
        binary_type,Type.bool,boolean_arrow,Type.bool,Type.bool]
      fun binary a b=add({raw=3,inclusive=3,types=bool_ports},a,b)
      val forward=binary h n val backward=binary n h
      val discharged=binary h c val closed_gen=binary n gen
      val _=if bounded output gen andalso
          List.all(bounded template)[forward,backward,discharged,closed_gen]
        then ()else refuse "GEN or normalization intermediate exceeds cap"
      fun count [] (total:IntInf.int)=(tick 1;total)
        | count(_::rest)total=(tick 3;count rest(total+1))
      fun weight(m:bg_metric)=
        (tick 5;#raw m+ #inclusive m+count(#types m)(0:IntInf.int))
      fun event result result_h operands operand_h=
        let val _=tick 8
            val all=append(result::result_h)(append operands operand_h)
            val cost=List.foldl(fn(m,total)=>
              (tick 3;total+weight m))(32:IntInf.int)all
            val types=List.foldr(fn(m,tail)=>append(#types m)tail)[]all
        in(cost,types)end
      val programme=[event n[n][][],event backward[][forward][],
        event h[n][backward,n][n],event discharged[][c][h],
        event c[n][discharged,h][n],event gen[n][c][n],
        event h[h][][],event n[h][forward,h][h],
        event closed_gen[][gen][n],event gen[h][closed_gen,n][h]]
      val subtotal=List.foldl(fn((amount,_),total)=>
        (tick 3;total+amount))(0:IntInf.int)programme
        +weight gen
      val types=List.foldr(fn((_,ports),tail)=>append ports tail)[]programme
      val _=pay expected subtotal
      (* Public construction of the exact bounded endpoint is metadata,
         occurs after its own nominal prepayment and before all policies. *)
      val _=tick 16
      val predicted=actual(fn()=>boolSyntax.mk_forall(variable,target))
      val _=tick 20
      val value=SourceBoundedScalarGenPlan{work=expected,held=held,
        current=current,graph=graph,scope=scope,revision=revision,
        alpha=alpha,source=source,root=root,variable=variable,
        original=original,normalized=normalized,
        normalized_origin=normalized_origin,expected=predicted,
        types=types,phase=ref BGPrepared,subtotal=subtotal}
      val _=bg_guard expected value
    in value end)end)
  fun admit_source_bounded_scalar_gen expected
      {plan=plan as SourceBoundedScalarGenPlan{phase,types,...},check_type}=
    sr_fail expected(fn()=>
      (bg_guard expected plan;
       W.with_step expected(fn()=>
         (if !phase=BGPrepared then ()else raise ERR "bounded_scalar_gen"
            "plan is not prepared";
          W.spend expected 4;phase:=BGAdmitting;
          List.app(fn ty=>(bg_guard expected plan;
            W.spend expected 4;check_type ty;bg_guard expected plan))types;
          bg_guard expected plan;W.spend expected 4;phase:=BGAdmitted))))
  fun execute_source_bounded_scalar_gen expected
      (plan as SourceBoundedScalarGenPlan{work,held,current,source,variable,
         original,normalized,expected=predicted,phase,...})=
    sr_fail expected(fn()=>
      (if Portable.pointer_eq(expected,work)then ()else raise ERR
         "bounded_scalar_gen" "foreign expected Work";
       bg_guard expected plan;
       W.with_step expected(fn()=>let
         val _=if !phase=BGAdmitted then ()else raise ERR
           "bounded_scalar_gen" "plan is not admitted"
         val _=W.spend expected 4 val _=phase:=BGConsumed
         fun actual action=(bg_guard expected plan;
           let val answer=action()in bg_guard expected plan;answer end)
         val assume_normal=actual(fn()=>Thm.ASSUME normalized)
         val reverse=actual(fn()=>Thm.SYM(#bridge source))
         val under_normal=actual(fn()=>Thm.EQ_MP reverse assume_normal)
         val discharge_original=actual(fn()=>
           Thm.DISCH original(#proof current))
         val normal=actual(fn()=>Thm.MP discharge_original under_normal)
         val generated=actual(fn()=>Thm.GEN variable normal)
         val assume_original=actual(fn()=>Thm.ASSUME original)
         val under_original=actual(fn()=>
           Thm.EQ_MP(#bridge source)assume_original)
         val discharge_normal=actual(fn()=>Thm.DISCH normalized generated)
         val answer=actual(fn()=>Thm.MP discharge_normal under_original)
         val target=Thm.concl answer val hyp=Thm.hyp answer
         val _=if (case hyp of [term]=>
             Portable.pointer_eq(term,original) | _=>false)andalso
             Term.aconv target predicted andalso
             bg_tag(Thm.tag answer)(Thm.tag(#proof current))then ()else
           raise ERR "bounded_scalar_gen" "exact final C/H/full Tag changed"
         val _=W.spend expected 22
         val origin={proof=answer,target=target,
           conclusion=NCForall(target,variable,#conclusion current),
           hyp= #hyp current,events= #events current}:nc_proof
       in SourceBoundedScalarGenResult{plan=plan,proof=answer,target=target,
         hypotheses=hyp,tag=Thm.tag answer,origin=origin}end)))
  fun source_bounded_scalar_gen_result_for expected
      (SourceBoundedScalarGenResult{plan,proof,target,hypotheses,tag,origin})=
    sr_fail expected(fn()=>
      (bg_guard expected plan;
       if Portable.pointer_eq(Thm.concl proof,target)andalso
           Portable.pointer_eq(#proof origin,proof)andalso
           nc_same_hyp(#hyp origin)hypotheses andalso
           nc_same_hyp(#hyp origin)(Thm.hyp proof)andalso
           Portable.pointer_eq(Thm.tag proof,tag)
         then ()else raise ERR "bounded_scalar_gen" "result ports changed";
       {statement=target,hypotheses=hypotheses,tag=tag,native_calls=10}))

  fun pc_record_closed_program metric_query metric_guard metric_captures
      metric_types from_import graph scope
      {node,theorem,template_limit,check_type} =
    let
      val _ = G.validate_scope graph scope
      val _ = ignore (G.view graph node)
      val _ = if RP.positive template_limit then () else
        raise ERR "record_closed" "nonpositive original template limit"
      val _ = if G.scope_visible graph scope (G.node_scope graph node)
        then () else raise ERR "record_closed" "foreign auxiliary scope"
      val _ = List.app (fn metric =>
        case metric_query graph metric template_limit node of
          SOME count => if RP.allows template_limit count then () else
            raise ERR "record_closed" "auxiliary metric exceeds limit"
        | NONE => raise ERR "record_closed" "unrecorded auxiliary binder")
        [G.RawNodes,G.BinderInclusiveNodes]
      val _ = if List.null (Thm.hyp theorem) andalso clean theorem then ()
        else raise ERR "record_closed" "auxiliary is not clean and closed"
      (* Bound actual type incidences before the caller's type policy.
         G.reachable includes already recorded opened binder bodies. *)
      val reachable = G.reachable graph [node]
      val types = List.map (G.type_of graph) reachable @ metric_types ()
      val count_type=pc_type_counter ()
      val remaining=ref template_limit
      fun type_amount amount=
        if RP.allows (!remaining) amount then
          remaining := RP.remaining (!remaining) amount
        else raise ERR "record_closed" "type portfolio exceeds limit"
      fun type_shape []=()
        | type_shape (ty::rest)=
            (type_amount (count_type ty);type_shape rest)
      val _ = type_shape types
      datatype recipe = Recipe of IntInf.int * IntInf.int * recipe_body
      and recipe_body = Identity of Term.term
        | Anchor of Thm.thm
        | WholeAnchor of Thm.thm * Thm.thm
        | Atom of Term.term * Term.term
        | Application of Term.term * Term.term * recipe * recipe
      val next_recipe=ref (0:IntInf.int)
      fun extra (Recipe (_,amount,_))=amount
      fun mint amount body=
        let val identity= !next_recipe
        in next_recipe := identity+1;Recipe (identity,amount,body) end
      val recipes=ref (Redblackmap.mkDict Int.compare :
        (int,(Term.term * Term.term * recipe) list) Redblackmap.dict)
      fun plan current original =
        let
          (* This live owned projection precedes EVERY memo hit. *)
          val representative=G.representative graph current
          val key=G.node_id current
          val rows=case Redblackmap.peek (!recipes,key) of
              NONE=>[] | SOME held=>held
        in case List.find (fn (term,_,_)=>
            Portable.pointer_eq (original,term)) rows of
            SOME (_,held,result)=>
              if Portable.pointer_eq (representative,held) then
                (type_amount (extra result);result)
              else raise ERR "record_closed" "retained representative changed"
          | NONE=>
              let
                val result=if Portable.pointer_eq
                    (original,representative) then mint 0 (Identity original)
                  else case G.source_anchor graph current of
                    SOME {original=held,bridge,...}=>
                      if Portable.pointer_eq (original,held) then
                        let val (left,right)=
                              boolSyntax.dest_eq (Thm.concl bridge)
                            val _=if List.null (Thm.hyp bridge) andalso
                                clean bridge andalso
                                Portable.pointer_eq (left,held) andalso
                                Portable.pointer_eq
                                  (right,representative) then () else
                              raise ERR "record_closed"
                                "source anchor differs"
                        in mint 0 (Anchor bridge) end
                      else composite current original representative
                  | NONE=>composite current original representative
                val _=recipes := Redblackmap.insert (!recipes,key,
                  (original,representative,result)::rows)
              in result end
        end
      and composite current original representative =
        case G.view graph current of
          G.Application (operator,operand)=>
            if Term.is_comb original then
              let val (f,x)=Term.dest_comb original
                  val left=plan operator f
                  val right=plan operand x
              in mint (extra left+extra right)
                (Application (original,representative,left,right)) end
            else raise ERR "record_closed" "original auxiliary shape differs"
        | G.Constant _=>
            if Term.is_const original then
              let val ty=Term.type_of original
                  val _=type_shape [ty]
              in if Term.same_const original representative andalso
                  Type.compare (ty,G.type_of graph current)=EQUAL then
                    mint (count_type ty) (Atom (original,representative))
                else raise ERR "record_closed" "constant declaration differs"
              end
            else raise ERR "record_closed" "original constant shape differs"
        | G.Variable (G.RigidSource,_)=>
            if Term.is_var original then
              let val (text,ty)=Term.dest_var original
                  val _=type_shape [ty]
              in if text= #1 (Term.dest_var representative) andalso
                  Type.compare (ty,G.type_of graph current)=EQUAL then
                    mint (count_type ty) (Atom (original,representative))
                else raise ERR "record_closed" "rigid source variable differs"
              end
            else raise ERR "record_closed" "original variable shape differs"
        | _=>raise ERR "record_closed" "original auxiliary anchor differs"
      val original = Thm.concl theorem
      val epoch = Type.type_epoch ()
      fun retained_import () =
        let val (imported,opened) =
              G.imported_opened_source graph scope original node
            val first = #bridge imported val second = #bridge opened
            val (a,b) = boolSyntax.dest_eq (Thm.concl first)
            val (c,d) = boolSyntax.dest_eq (Thm.concl second)
        in if Portable.pointer_eq (a,original) andalso
            Portable.pointer_eq
              (b,G.representative graph (#node imported)) andalso
            Portable.pointer_eq (#original opened,b) andalso
            Portable.pointer_eq (b,c) andalso
            Portable.pointer_eq (d,G.representative graph node) andalso
            null (Thm.hyp first) andalso null (Thm.hyp second) andalso
            clean first andalso clean second then (first,second)
          else raise ERR "record_closed" "registered whole bridge differs"
        end
      val held = if from_import then SOME (retained_import ()) else NONE
      fun active () =
        (G.validate_scope graph scope;metric_guard ();
         if from_import then
           (if Type.type_epoch () = epoch then () else
              raise ERR "record_closed" "Type retirement epoch changed";
            List.app (fn current => G.validate_scope graph
              (G.node_scope graph current)) reachable;
            let val (first,second) = retained_import ()
            in case held of SOME (a,b) =>
                 if Portable.pointer_eq (a,first) andalso
                     Portable.pointer_eq (b,second) then () else
                   raise ERR "record_closed" "retained import bridge changed"
               | NONE => raise ERR "record_closed" "missing retained bridge"
            end)
         else ())
      val recipe = case held of SOME pair => mint 0 (WholeAnchor pair)
        | NONE => plan node original
      (* All syntax/metric/type portfolios precede proof bridge operations. *)
      val _ = List.app (fn ty => (active ();check_type ty;active ())) types
      val _ = if Type.compare (G.type_of graph node,Type.bool) = EQUAL
        then () else raise ERR "record_closed" "auxiliary is not Boolean"
      val proofs=ref (Redblackmap.mkDict IntInf.compare :
        (IntInf.int,Thm.thm) Redblackmap.dict)
      fun execute (Recipe (identity,_,body)) =
        case Redblackmap.peek (!proofs,identity) of SOME proof=>proof
        | NONE=>
            let
              val proof=case body of
                  Identity term=>SmtReplayRuleObservation.REFL term
                | Anchor held=>held
                | WholeAnchor (first,second)=>
                    SmtReplayRuleObservation.TRANS first second
                | Atom (original,representative)=>
                    SmtReplayRuleObservation.ALPHA original representative
                | Application (original,representative,f,x)=>
                    let val joined=SmtReplayRuleObservation.MK_COMB
                          (execute f,execute x)
                        val (left,right)=
                          boolSyntax.dest_eq (Thm.concl joined)
                    in SmtReplayRuleObservation.TRANS
                      (SmtReplayRuleObservation.ALPHA original left)
                      (SmtReplayRuleObservation.TRANS joined
                        (SmtReplayRuleObservation.ALPHA right representative))
                    end
              val _=proofs := Redblackmap.insert (!proofs,identity,proof)
            in proof end
      val _ = active ()
      val canonical = SmtReplayRuleObservation.EQ_MP (execute recipe) theorem
      val _ = if Portable.pointer_eq (Thm.concl canonical,
            G.representative graph node) andalso
          List.null (Thm.hyp canonical) andalso clean canonical then ()
        else raise ERR "record_closed" "canonical auxiliary changed"
      val _ = active ()
    in PolicyClosedFact {graph = graph,scope = scope,node = node,
      original = theorem,canonical = canonical,
      template_limit = template_limit,
      metric_captures = metric_captures ()} end

  fun pc_record_closed_internal from_import graph scope request =
    pc_record_closed_program G.unfolded_nodes_with_policy (fn()=>())
      (fn()=>[]) (fn()=>[]) from_import graph scope request
  fun pc_record_closed graph scope args =
    pc_record_closed_internal false graph scope args
  fun pc_record_closed_from_import graph scope args =
    pc_record_closed_internal true graph scope args

  fun pc_record_conversion_program metric_query metric_guard metric_captures
      metric_types typed graph scope
      {source,source_view,target,target_view,theorem,template_limit,
       check_type} =
    let
      val _ = G.validate_opened_view graph scope source source_view
      val _ = G.validate_opened_view graph scope target target_view
      val _ = if RP.positive template_limit then () else
        raise ERR "record_conversion" "nonpositive template limit"
      fun bound metric =
        let val remaining = ref (if RP.allows template_limit 3 then
              RP.remaining template_limit 3 else
                raise ERR "record_conversion" "conversion exceeds cap")
            fun node current =
              case metric_query graph metric template_limit current of
                SOME count => if RP.allows (!remaining) count then
                    remaining := RP.remaining (!remaining) count
                  else raise ERR "record_conversion" "conversion exceeds cap"
              | NONE => raise ERR "record_conversion" "unknown syntax metric"
        in List.app node [#node source_view,#node target_view] end
      val _ = List.app bound [G.RawNodes,G.BinderInclusiveNodes]
      val _ = if null (Thm.hyp theorem) andalso clean theorem then () else
        raise ERR "record_conversion" "conversion is not clean and closed"
      val (left,right) = boolSyntax.dest_eq (Thm.concl theorem)
      val _ = if Portable.pointer_eq (left,G.representative graph source)
          andalso Portable.pointer_eq (right,G.representative graph target)
        then () else raise ERR "record_conversion" "exact endpoints differ"
      val count_type=pc_type_counter ()
      val remaining=ref template_limit
      fun types []=()
        | types (ty::rest)=
            let val amount=count_type ty
            in if RP.allows (!remaining) amount then
                (remaining := RP.remaining (!remaining) amount;types rest)
              else raise ERR "record_conversion" "type cap"
            end
      val reachable = G.reachable graph [#node source_view,#node target_view]
      val portfolio = List.map (fn node =>
        (G.validate_scope graph scope;G.type_of graph node)) reachable @
          metric_types ()
      val _ = types portfolio
      val _ = List.app (fn ty =>
        (G.validate_scope graph scope;metric_guard ();check_type ty;
         G.validate_scope graph scope;metric_guard ())) portfolio
      val _ = if typed then
          (if G.type_id graph source = G.type_id graph target then () else
             raise ERR "record_typed_conversion" "cached endpoint types differ")
        else if Type.compare (G.type_of graph source,Type.bool) = EQUAL
          andalso Type.compare (G.type_of graph target,Type.bool) = EQUAL
        then () else raise ERR "record_conversion" "Boolean endpoints required"
      val _ = G.validate_scope graph scope
      val _ = metric_guard ()
    in PolicyClosedConversion {graph = graph,scope = scope,source = source,
      target = target,source_view = source_view,target_view = target_view,
      theorem = theorem,template_limit = template_limit,
      metric_captures = metric_captures ()} end
  fun pc_record_conversion_internal typed graph scope request =
    pc_record_conversion_program G.unfolded_nodes_with_policy (fn()=>())
      (fn()=>[]) (fn()=>[]) typed graph scope request
  fun pc_record_conversion graph scope request =
    pc_record_conversion_internal false graph scope request
  fun pc_record_typed_conversion graph scope request =
    pc_record_conversion_internal true graph scope request

  (* Narrow only an actual representable finite policy. No Uncapped
     sentinel and no handler around a native proof or supplied policy. *)
  (* This threshold is ONLY the source-pinned precondition of the old
     G metric API, never an interpretation of RP.Uncapped. *)
  val pc_legacy_metric_bound=case Int.maxInt of
      SOME largest=>IntInf.fromInt largest
    | NONE=>1073741823
  fun pc_finite_limit RP.Uncapped=NONE
    | pc_finite_limit (RP.AtMost n)=
        if n>=0 andalso n<pc_legacy_metric_bound
          then SOME (IntInf.toInt n) else NONE
  fun record_closed_with_policy graph scope
      (request as {node,theorem,template_limit,check_type}) =
    case pc_finite_limit template_limit of
      SOME maximum=>record_closed graph scope
        {node=node,theorem=theorem,template_limit=maximum,
         check_type=check_type}
    | NONE=>pc_record_closed graph scope request
  fun record_closed_from_import_with_policy graph scope
      (request as {node,theorem,template_limit,check_type}) =
    case pc_finite_limit template_limit of
      SOME maximum=>record_closed_from_import graph scope
        {node=node,theorem=theorem,template_limit=maximum,
         check_type=check_type}
    | NONE=>pc_record_closed_from_import graph scope request
  fun record_conversion_with_policy graph scope
      (request as {source,source_view,target,target_view,theorem,
                   template_limit,check_type}) =
    case pc_finite_limit template_limit of
      SOME maximum=>record_conversion graph scope
        {source=source,source_view=source_view,target=target,
         target_view=target_view,theorem=theorem,template_limit=maximum,
         check_type=check_type}
    | NONE=>pc_record_conversion graph scope request
  fun record_typed_conversion_with_policy graph scope
      (request as {source,source_view,target,target_view,theorem,
                   template_limit,check_type}) =
    case pc_finite_limit template_limit of
      SOME maximum=>record_typed_conversion graph scope
        {source=source,source_view=source_view,target=target,
         target_view=target_view,theorem=theorem,template_limit=maximum,
         check_type=check_type}
    | NONE=>pc_record_typed_conversion graph scope request
  fun validate_closed_fact_with_policy graph scope maximum
      (fact as PolicyClosedFact _) =
        pc_validate_closed graph scope maximum fact
    | validate_closed_fact_with_policy graph scope maximum
        (fact as PolicyRealizedClosedFact _)=
        pcf_validate graph scope maximum fact
    | validate_closed_fact_with_policy graph scope maximum
        (fact as ClosedFact {graph=owner,...}) =
        if Portable.pointer_eq (graph,owner) then
          let val ClosedFact {template_limit,...}=fact
          in if maximum=RP.from_int template_limit then
              validate_closed_fact graph scope template_limit fact
            else raise ERR "freeze" "closed auxiliary owner or cap differs"
          end
        else raise ERR "freeze" "closed auxiliary owner or cap differs"
  fun validate_conversion_with_policy graph scope maximum
      (conversion as PolicyClosedConversion _) =
        pc_validate_conversion graph scope maximum conversion
    | validate_conversion_with_policy graph scope maximum
        (conversion as PolicyRealizedConversion _)=
        pcr_validate graph scope maximum conversion
    | validate_conversion_with_policy graph scope maximum
        (conversion as ClosedConversion {graph=owner,...}) =
        if Portable.pointer_eq (graph,owner) then
          let val ClosedConversion {template_limit,...}=conversion
          in if maximum=RP.from_int template_limit then
              validate_conversion graph scope template_limit conversion
            else raise ERR "conversion" "owner or original cap differs" end
        else raise ERR "conversion" "owner or original cap differs"
    | validate_conversion_with_policy graph scope maximum
        (conversion as RealizedConversion
          (receipt as Realization {graph=owner,...})) =
        if Portable.pointer_eq (graph,owner) then
          let val Realization {template_limit,...}=receipt
          in if maximum=RP.from_int template_limit then
              validate_conversion graph scope template_limit conversion
            else raise ERR "conversion" "realized owner or cap differs" end
        else raise ERR "conversion" "realized owner or cap differs"

  (* Fixed, callback-free DATA projection. Authenticate the exact Work
     before any receipt backing, then retain the original graph/cap/Scope
     fences. A realized conversion's immutable endpoints require neither a
     second identical backing walk nor two separately guarded getters. No
     validation result or permission escapes to another operation. *)
  fun conversion_endpoints_with_policy_for expected graph scope maximum saved =
    ((let
        val _=validate_conversion_for expected saved
        (* Legacy closed proofs have no Work header of their own. This
           new owned projection must still authenticate and debit its
           requested original portfolio, even for that fallback. *)
        val sources=W.original_sources expected
        val _=W.validate_policy expected graph
          (SmtReplaySource.owning_scope sources) sources
          (W.semantic_policy expected)
        val _=W.spend_guard_policy expected 4
      in case saved of PolicyRealizedConversion
          {graph=owner,scope=frame,source,target,template_limit,...}=>
            let
              val _=if Portable.pointer_eq(graph,owner)then ()else
                raise ERR "conversion" "different graph owner"
              val _=if maximum=template_limit then ()else
                raise ERR "conversion" "different original policy"
              val _=G.validate_scope graph scope
              val _=if G.scope_visible graph scope frame then ()else
                raise ERR "conversion" "realized endpoint escapes actual frame"
            in {source=source,target=target}end
        | _=>
            (validate_conversion_with_policy graph scope maximum saved;
             {source=conversion_source saved,target=conversion_target saved})
      end)handle primary=>(W.close expected;raise primary))

  (* This closure is created only inside the four public producer methods.
     Neither its query, guard nor retained-list producer is caller supplied. *)
  fun pg_metric_collector graph scope profiles =
    let
      val saved=ref ([]:(G.node * G.profiled_metric) list)
      fun query expected metric _ node =
        let
          val _=if Portable.pointer_eq (expected,graph) then () else
            raise ERR "policy_metric" "different graph owner"
          val capture=case List.find (fn (held,_)=>node=held) (!saved) of
              SOME (_,capture)=>capture
            | NONE=>let val capture=G.prepare_profiled_metric graph scope
                    {node=node,profiles=profiles}
                in saved := (node,capture):: !saved;capture end
          val data=G.profiled_metric_data graph scope capture
          val _=if #node data=node then () else
            raise ERR "policy_metric" "different actual node"
        in SOME (case metric of G.RawNodes=> #raw data
              | G.BinderInclusiveNodes=> #inc data) end
      fun captures ()=List.map #2 (List.rev (!saved))
      fun guard ()=pg_metric_guard graph scope (captures ())
      fun types ()=List.concat (List.map (fn capture=>
        #types (G.profiled_metric_data graph scope capture)) (captures ()))
    in (query,guard,captures,types) end
  fun record_closed_with_policy_profiles graph scope
      {node,theorem,template_limit,check_type,profiles} =
    let val(query,guard,captures,types)=pg_metric_collector graph scope profiles
    in pc_record_closed_program query guard captures types false graph scope
      {node=node,theorem=theorem,template_limit=template_limit,
       check_type=check_type} end
  fun record_closed_from_import_with_policy_profiles graph scope
      {node,theorem,template_limit,check_type,profiles} =
    let val(query,guard,captures,types)=pg_metric_collector graph scope profiles
    in pc_record_closed_program query guard captures types true graph scope
      {node=node,theorem=theorem,template_limit=template_limit,
       check_type=check_type} end
  fun record_conversion_with_policy_profiles graph scope
      {source,source_view,target,target_view,theorem,template_limit,
       check_type,profiles} =
    let val(query,guard,captures,types)=pg_metric_collector graph scope profiles
    in pc_record_conversion_program query guard captures types false graph scope
      {source=source,source_view=source_view,target=target,
       target_view=target_view,theorem=theorem,template_limit=template_limit,
       check_type=check_type} end
  fun record_typed_conversion_with_policy_profiles graph scope
      {source,source_view,target,target_view,theorem,template_limit,
       check_type,profiles} =
    let val(query,guard,captures,types)=pg_metric_collector graph scope profiles
    in pc_record_conversion_program query guard captures types true graph scope
      {source=source,source_view=source_view,target=target,
       target_view=target_view,theorem=theorem,template_limit=template_limit,
       check_type=check_type} end

  (* Policy frontiers retain the actual original Source and lexical frame.
     They are not old int-template blocks or a native constructor grant. *)
  datatype policy_realization_frontier = PolicyRealizationFrontier of
    {work:W.portfolio,graph:G.graph,scope:G.scope,frame:Scope.receipt,
     template_limit:RP.limit,epoch:int,symbols:int,original:bool,
     roots:G.node list,sources:G.node list,closed_facts:closed_fact list,
     conversions:closed_conversion list,reachable:G.node list,
     atoms:G.node list,held:G.closure_child list}
  fun pr_frontier_guard expected
      (frontier as PolicyRealizationFrontier {work,...}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "policy_frontier_guard" "different original Work";
      let
        val PolicyRealizationFrontier
          {graph,scope,frame,template_limit,epoch,symbols,
           closed_facts,conversions,held,...}=frontier
        val data=Scope.description_with_policy_for expected frame
        val _=if Portable.pointer_eq (#graph data,graph) andalso
            #scope data=scope andalso
            #template_limit (W.semantic_policy expected)=template_limit
            andalso Type.type_epoch ()=epoch andalso
            Term.term_epoch ()=symbols then () else
          raise ERR "policy_frontier_guard" "original frame changed"
        val _=List.app (validate_conversion_for expected) conversions
        val _=List.app
          (validate_conversion_with_policy graph scope template_limit)
          conversions
        val _=List.app (pcf_for expected) closed_facts
        val _=List.app
          (validate_closed_fact_with_policy graph scope template_limit)
          closed_facts
      in List.app (fn child=>ignore
        (G.closure_child_node graph scope child)) held end)
     handle primary=>(W.close expected;raise primary))
  fun realization_frontier_data_with_policy_for expected
      (frontier as PolicyRealizationFrontier {work,...}) =
    (if Portable.pointer_eq (expected,work) then () else
       (W.close expected;raise ERR "policy_frontier_data"
         "different original Work");
     pr_frontier_guard expected frontier;
     let val PolicyRealizationFrontier
       {graph,scope,roots,sources,reachable,atoms,template_limit,...}=frontier
     in {graph=graph,scope=scope,roots=roots,sources=sources,
       reachable=reachable,atoms=atoms,template_limit=template_limit} end)
  fun pr_prepare_frontier original descendant extra_sources work
      {frame,roots,closed_facts,conversions} =
    ((W.spend_policy work 0;
      let
        val data = Scope.description_with_policy_for work frame
        val graph = #graph data and scope = #scope data
        val cap = #template_limit (W.semantic_policy work)
        fun pay n = W.spend_policy work n
        val _ = List.app (validate_conversion_for work) conversions
        val _ = List.app
          (validate_conversion_with_policy graph scope cap) conversions
        val _=List.app (pcf_for work) closed_facts
        val _ = List.app
          (validate_closed_fact_with_policy graph scope cap) closed_facts
        (* Additional final-replay slots are ordinary block Sources. They
           never become occurrences in the original S portfolio. Each is
           copied and checked in this same genuine root frame before any
           receipt endpoint can act as a cut. *)
        fun extras [] = []
          | extras (node::rest) =
              (pay 3;
               if G.scope_visible graph scope (G.node_scope graph node)
                 then () else raise ERR "prepare_frontier"
                   "additional Source outside original root frame";
               ignore (G.view graph node);
               if not descendant orelse
                   Type.compare (G.type_of graph node,Type.bool)=EQUAL then ()
               else raise ERR "policy_frontier"
                 "additional Source is not Boolean";
               node :: extras rest)
        val extra_sources = if original then extras extra_sources
          else if null extra_sources then [] else
            raise ERR "prepare_frontier" "additional Source needs original S"
        fun original_prefix [] =
              (pay 1;SmtReplaySource.denied_goal_node (#sources data) ::
                extra_sources)
          | original_prefix (node::rest) =
              (pay 2;node :: original_prefix rest)
        val sources = if original then
            if scope = #root data orelse (descendant andalso
                G.scope_visible graph scope (#root data)) then
              original_prefix
                (SmtReplaySource.assumption_nodes (#sources data))
            else raise ERR "prepare_frontier" "original Sources outside root"
          else []
        fun add [] values = values
          | add (node::rest) values = (pay 2;add rest (node::values))
        fun leaves [] cuts legacy = (cuts,legacy)
          | leaves (conversion::rest) cuts legacy =
            (pay 1;case conversion of RealizedConversion (receipt as Realization
                {source,target,...}) =>
                  (validate_realization_for work receipt;
                   leaves rest (source::target::cuts) legacy)
              | saved as PolicyRealizedConversion {source,target,...}=>
                  (pcr_for work saved;
                   leaves rest (source::target::cuts) legacy)
              | _ => leaves rest cuts
                  (conversion_source conversion::conversion_target conversion::
                   legacy))
        val (cuts,legacy) = leaves conversions [] []
        val facts = List.map (fn fact => (pay 1;closed_node fact)) closed_facts
        (* Explicit ordinary roots dominate cuts. A receipt can NEVER hide
           a constructor demanded elsewhere at the same semantic node. *)
        val demanded = add sources (add facts (add legacy roots))
        fun member node [] = false
          | member node (old::rest) =
              (pay 1;node = old orelse member node rest)
        val seen = ref ([] : G.node list) val atoms = ref ([] : G.node list)
        fun visit [] = ()
          | visit (node::rest) =
            (pay 1;if member node (!seen) then visit rest else
             let val _ = pay 2 val _ = seen := node :: !seen
                 val _ = if G.scope_visible graph scope
                       (G.node_scope graph node) then () else
                     raise ERR "prepare_frontier" "node escaped frame"
                 val cut = member node cuts andalso not (member node demanded)
                 val children = if cut then
                     (pay 2;atoms := node :: !atoms;[]) else
                   case G.view graph node of G.Application (a,b) => [a,b]
                     | _ => []
             in visit children;visit rest end)
        val _ = visit (add cuts demanded)
        fun reverse [] answer = answer
          | reverse (node::rest) answer =
              (pay 2;reverse rest (node::answer))
        val reachable = reverse (!seen) [] val atoms = reverse (!atoms) []
        val held = List.map (fn node =>
          (pay 2;G.closure_root graph scope node)) reachable
        val frontier = PolicyRealizationFrontier {work = work,graph = graph,
          scope = scope,frame = frame,template_limit = cap,
          epoch = Type.type_epoch (),symbols = Term.term_epoch (),
          roots = roots,sources = sources,closed_facts = closed_facts,
          conversions = conversions,reachable = reachable,atoms = atoms,
          held = held,original = original}
        val _ = pr_frontier_guard work frontier
      in frontier end)
     handle primary => (W.close work;raise primary))
  (* Like its finite predecessor this helper is called inside SAME action. *)
  fun prepare_realization_frontier_with_policy work request =
    pr_prepare_frontier false false [] work request
  fun prepare_original_realization_frontier_with_policy work
      {roots,closed_facts,conversions} =
    ((let val frame=Scope.root_with_policy work
      in W.with_step work (fn()=>pr_prepare_frontier true false [] work
        {frame=frame,roots=roots,closed_facts=closed_facts,
         conversions=conversions}) end)
     handle primary=>(W.close work;raise primary))
  fun prepare_original_realization_frontier_with_extras_with_policy work
      {roots,additional_sources,closed_facts,conversions} =
    ((let val frame=Scope.root_with_policy work
      in W.with_step work (fn()=>
        pr_prepare_frontier true false additional_sources work
          {frame=frame,roots=roots,closed_facts=closed_facts,
           conversions=conversions}) end)
     handle primary=>(W.close work;raise primary))
  fun prepare_scoped_original_realization_frontier_with_policy work
      {frame,roots,additional_sources,closed_facts,conversions} =
    ((ignore (Scope.description_with_policy_for work frame);
      W.with_step work (fn()=>
        pr_prepare_frontier true true additional_sources work
          {frame=frame,roots=roots,closed_facts=closed_facts,
           conversions=conversions}))
     handle primary=>(W.close work;raise primary))

  (* Exact policy ledger plans retain SAME R opaque plans and finishers.
     Their definition indices stay IntInf until native vector admission. *)
  datatype 'a pr_fixed_plan = PRFixedPlan of
    {work:W.portfolio,base:'a R.int_map,
     listing:'a R.int_batch_listing,used:bool ref}
  fun pr_fixed_plan work inputs key =
    let
      val _=W.spend_policy work 2
      val base=R.empty_int ()
      fun keys []=[]
        | keys (input::rest)=
            (W.spend_policy work 6;key input::keys rest)
      val batch=W.plan_insert_int_batch work (base,keys inputs)
      val listing=W.plan_list_int_batch work batch
      val _=W.spend_policy work 10
    in PRFixedPlan
      {work=work,base=base,listing=listing,used=ref false} end

  datatype pr_fixed_names = PRFixedNames of
    {work:W.portfolio,graph:G.graph,scope:G.scope,frame:Scope.receipt,
     strings:R.string_set,types:(string * Type.hol_type) R.int_map,
     held:G.closure_child list,epoch:int,symbols:int,
     validated_revision:IntInf.int option ref}
  fun pr_names_guard expected (saved as PRFixedNames {work,...}) =
    if not (Portable.pointer_eq (expected,work)) then
      (W.close expected;
       raise ERR "policy_names_guard" "different original Work")
    else ((let
        val PRFixedNames {graph,scope,frame,held,epoch,symbols,
          validated_revision,...}=saved
        val actual=Scope.description_with_policy_for expected frame
        val _=if Portable.pointer_eq (#graph actual,graph) andalso
            #scope actual=scope andalso Type.type_epoch ()=epoch andalso
            Term.term_epoch ()=symbols then () else
          raise ERR "policy_names_guard" "different original frame/epochs"
        val revision=G.validation_revision graph scope
      in if !validated_revision=SOME revision then () else
        (List.app (fn child=>ignore
           (G.closure_child_node graph scope child)) held;
         if G.validation_revision graph scope=revision then
           validated_revision:=SOME revision
         else validated_revision:=NONE) end)
     handle primary=>
       (let val PRFixedNames {validated_revision,...}=saved
        in validated_revision:=NONE end;W.close expected;raise primary))
  fun pr_name_index work name =
    let
      val prefix="__smt_replay_" val width=String.size prefix
      val size=String.size name
      val _=W.spend_policy work
        (IntInf.fromInt width+IntInf.fromInt size+1)
      val _=if String.isPrefix prefix name then () else
        raise ERR "policy_name_index" "not a genuine graph placeholder name"
      val length=size-width
      val _=W.spend_policy work (IntInf.fromInt length+1)
      val tail=String.extract (name,width,NONE)
      val _=W.spend_policy work (IntInf.fromInt length+1)
    in case Int.fromString tail of SOME index=>
        if index>=0 then index else
          raise ERR "policy_name_index" "negative graph placeholder index"
      | NONE=>raise ERR "policy_name_index" "invalid retained name index" end
  fun pr_prepare_names work graph scope frame naming held =
    ((G.validate_placeholder_plan graph scope naming;
      let
        val rows=G.placeholder_plan_bindings naming
        val _=W.spend_policy work 2
        val initial_strings=R.empty_string ()
        val _=W.spend_policy work 2
        val initial_types=R.empty_int ()
        fun prepare [] strings types=(strings,types)
          | prepare ((node,name,ty)::rest) strings types=
              let
                val _=W.spend_policy work 1
                val index=pr_name_index work name
                val insertion=W.plan_insert_string work (strings,name)
                val next_strings=R.finish_string (strings,insertion)
                val slot=W.plan_insert_int work (types,index)
                val _=W.spend_policy work 1
                val next_types=R.finish_int (types,slot,(name,ty))
              in prepare rest next_strings next_types end
        val (strings,types)=prepare rows initial_strings initial_types
        val _=W.spend_policy work 3
        val saved=PRFixedNames {work=work,graph=graph,scope=scope,
          frame=frame,strings=strings,types=types,held=held,
          epoch=Type.type_epoch (),symbols=Term.term_epoch (),
          validated_revision=ref NONE}
        val _=pr_names_guard work saved
      in saved end)
     handle primary=>(W.close work;raise primary))

  datatype policy_realization_tables_plan = PRRealizationTables of
    {work:W.portfolio,frontier:policy_realization_frontier,
     naming:G.placeholder_plan,names:pr_fixed_names,
     nodes:(G.node * Term.term) pr_fixed_plan,
     definitions:int pr_fixed_plan,
     definition_rows:(int * IntInf.int) list,
     source_count:IntInf.int,closed_count:IntInf.int,total_count:IntInf.int,
     used:bool ref}
  fun validate_realization_tables_with_policy expected
      (saved as PRRealizationTables {work,...}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "policy_realization_tables" "different original Work";
      let
        val PRRealizationTables {frontier,naming,names,...}=saved
        val _=pr_frontier_guard expected frontier
        val PolicyRealizationFrontier {graph,scope,...}=frontier
        val _=G.validate_placeholder_plan graph scope naming
      in pr_names_guard expected names end)
     handle primary=>(W.close expected;raise primary))
  fun prepare_owned_realization_tables_with_policy work frontier =
    ((pr_frontier_guard work frontier;W.spend_policy work 0;
      let
        val PolicyRealizationFrontier {graph,scope,frame,roots,sources,
          closed_facts,conversions,reachable,atoms,template_limit,...}=frontier
        fun admit [] count _=count
          | admit (value::rest) count validate=
              (W.spend_policy work 1;
               if RP.allows template_limit (count+1) then
                 (validate value;admit rest (count+1) validate)
               else raise ERR "policy_realization_tables"
                 "closed leaf incidence exceeds original template")
        val closed_count=admit closed_facts (0:IntInf.int)
          (validate_closed_fact_with_policy graph scope template_limit)
        val total_closed=admit conversions closed_count
          (fn conversion=>(validate_conversion_for work conversion;
            validate_conversion_with_policy graph scope template_limit
              conversion))
        fun count_sources [] n=n
          | count_sources (_::rest) n=
              (W.spend_policy work 1;count_sources rest (n+1))
        val source_count=count_sources sources (0:IntInf.int)
        val total_count=source_count+total_closed
        val held=List.map (fn node=>
          (W.spend_policy work 2;G.closure_root graph scope node)) reachable
        val naming=W.plan_placeholders work graph scope {nodes=reachable}
        val names=pr_prepare_names work graph scope frame naming held
        val nodes=pr_fixed_plan work reachable G.node_id
        fun member node []=false
          | member node (old::rest)=
              (W.spend_policy work 1;node=old orelse member node rest)
        fun rows [] _=[]
          | rows (node::rest) index=
              (W.spend_policy work 1;
               if member node atoms then rows rest index
               else case G.view graph node of
                 G.Application _=>
                   (W.spend_policy work 3;
                    (G.node_id node,index)::rows rest (index+1))
               | G.Constant _=>
                   (W.spend_policy work 3;
                    (G.node_id node,index)::rows rest (index+1))
               | _=>rows rest index)
        val definition_rows=rows reachable total_count
        val definitions=pr_fixed_plan work definition_rows #1
        val _=ignore (Scope.description_with_policy_for work frame)
        val _=W.spend_policy work 3
        val result=PRRealizationTables {work=work,frontier=frontier,
          naming=naming,names=names,nodes=nodes,definitions=definitions,
          definition_rows=definition_rows,source_count=source_count,
          closed_count=total_closed,total_count=total_count,used=ref false}
        val _=validate_realization_tables_with_policy work result
      in result end)
     handle primary=>(W.close work;raise primary))
  fun realization_tables_guard_work_with_policy expected
      (saved as PRRealizationTables {work,...}) =
    if Portable.pointer_eq (expected,work) then
      let val PRRealizationTables {naming,...}=saved
      in G.placeholder_plan_guard_cost naming end
    else (W.close expected;raise ERR "policy_realization_tables"
      "different original Work")
  fun realization_tables_data_with_policy_for expected
      (saved as PRRealizationTables {work,...}) =
    (if Portable.pointer_eq (expected,work) then () else
       (W.close expected;raise ERR "policy_realization_tables"
         "different original Work");
     validate_realization_tables_with_policy expected saved;
     let val PRRealizationTables {source_count,closed_count,total_count,
       definition_rows,...}=saved
     in {source_count=source_count,closed_count=closed_count,
       total_count=total_count,definition_rows=definition_rows} end)

  structure PRNativeContract=SmtReplayNativeContract
  datatype pr_native_type = PRActualType of Type.hol_type
    | PRBooleanType | PRArrowType of pr_native_type * pr_native_type
  type pr_native_size =
    {raw:IntInf.int,inc:IntInf.int,ann:IntInf.int,ty:pr_native_type}
  datatype policy_native_freeze_plan = PRNativeFreezePlan of
    {work:W.portfolio,tables:policy_realization_tables_plan,
     contract:PRNativeContract.contract,profiles:G.policy_opaque_profile list,
     captures:(G.scope * G.profiled_metric) list,
     closures:(G.scope * G.binder_closure) list,
     types:pr_native_type list,check_type:Type.hol_type -> unit,
     compact:pr_native_size,actual:pr_native_size option,
     results:(G.node * pr_native_size option) list,
     native_template:int,leaf_count:int,used:bool ref}

  fun pr_native_freeze_guard expected
      (saved as PRNativeFreezePlan {work,...}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "policy_native_freeze" "different original Work";
      let
        val PRNativeFreezePlan
          {tables,contract,captures,closures,...}=saved
        val _=PRNativeContract.validate_for expected contract
        val _=validate_realization_tables_with_policy expected tables
        val PRRealizationTables {frontier,...}=tables
        val PolicyRealizationFrontier {graph,scope,...}=frontier
        val _=List.app (fn (frame,capture)=>ignore
          (G.profiled_metric_data graph frame capture)) captures
      in List.app (fn (frame,closure)=>ignore
        (G.binder_closure_data graph frame closure)) closures end)
     handle primary=>(W.close expected;raise primary))

  (* All shapes here precede every Type/Term payload constructor. The finite
     ceilings are ONLY the genuine retained native caller contract. *)
  fun prepare_native_realization_freeze_with_policy expected
      {tables,contract,profiles,ordinal,check_type} =
    ((let val PRRealizationTables {work,...}=tables
      in if Portable.pointer_eq (expected,work) then () else
        (W.close expected;raise ERR "policy_native_freeze"
          "different original table Work") end;
      let
        val limits=PRNativeContract.for_work expected contract
        val _=validate_realization_tables_with_policy expected tables
        val _=W.spend_policy expected 0
        val PRRealizationTables {used=already_used,...}=tables
        val _=if !already_used then raise ERR "policy_native_freeze"
            "table plan already used" else ()
        val native= #semantic_limits limits
        val native_template= #template_limit native
        val _=if ordinal>=0 then () else
          raise ERR "policy_native_freeze" "negative native freeze ordinal"
        val PRRealizationTables {frontier,definition_rows,total_count,...}=
          tables
        val PolicyRealizationFrontier {graph,scope,reachable,sources,
          roots,closed_facts,conversions,atoms,...}=frontier
        fun charge n=W.spend_policy expected n
        val type_memo=ref ([]:(Type.hol_type * IntInf.int) list)
        fun known_type ty=List.find
          (fn (old,_)=>(charge 1;Portable.pointer_eq (old,ty))) (!type_memo)
        fun type_weight ty=case known_type ty of SOME (_,n)=>n
          | NONE=>
            let
              val _=charge 1
              val n=if Type.is_vartype ty then
                  let val text=Type.dest_vartype ty
                      val width=IntInf.fromInt (String.size text)
                      val _=charge (1+width)
                  in 1+width end
                else
                  let val children= #2 (Type.dest_type ty)
                      fun sum [] amount=amount
                        | sum (child::rest) amount=
                            (charge 1;sum rest (amount+type_weight child))
                  in sum children 1 end
              val _=charge 1
              val _=type_memo:=(ty,n):: !type_memo
            in n end
        val boolean_weight=type_weight Type.bool
        fun type_size (PRActualType ty)=type_weight ty
          | type_size PRBooleanType=boolean_weight
          | type_size (PRArrowType(a,b))=1+type_size a+type_size b
        val generated=ref ([]:pr_native_type list)
        fun generated_type ty=(charge 1;generated:=ty:: !generated;ty)
        fun atom ty:pr_native_size={raw=1,inc=1,ann=type_size ty,ty=ty}
        fun app (a:pr_native_size) (b:pr_native_size) ty:pr_native_size=
          {raw=1+ #raw a+ #raw b,inc=1+ #inc a+ #inc b,
           ann=type_size ty+ #ann a+ #ann b,ty=ty}
        fun equality retain (a:pr_native_size) (b:pr_native_size)=
          let fun keep ty=if retain then generated_type ty else ty
              val partial=keep (PRArrowType(#ty a,PRBooleanType))
              val whole=keep (PRArrowType(#ty a,partial))
          in app (app (atom whole) a partial) b PRBooleanType end
        fun actual_equality (SOME a) (SOME b)=SOME (equality false a b)
          | actual_equality _ _=NONE
        fun actual_app (SOME a) (SOME b) ty=SOME (app a b ty)
          | actual_app _ _ _=NONE
        val conjunction_type=PRArrowType(PRBooleanType,
          PRArrowType(PRBooleanType,PRBooleanType))
        val conjunction_partial=PRArrowType(PRBooleanType,PRBooleanType)
        val conjunction_overhead=type_size conjunction_type+
          type_size conjunction_partial+boolean_weight
        val memo=ref (Redblackmap.mkDict Int.compare)
        val pending=ref (Redblackset.empty Int.compare)
        val captures=ref ([]:(G.scope * G.profiled_metric) list)
        val closures=ref ([]:(G.scope * G.binder_closure) list)
        fun profile frame node []=NONE
          | profile frame node (held::rest)=
              let val _=charge 1
                  val data=G.opaque_profile_data_with_policy graph frame held
              in if #node data=node then SOME data
                 else profile frame node rest end
        fun actual frame node:pr_native_size option=
          let val _=charge 1
              val _=ignore (G.view graph node)
              val key=G.node_id node
          in case Redblackmap.peek (!memo,key) of SOME value=>value
            | NONE=>
              let
                val _=if Redblackset.member (!pending,key) then
                    raise ERR "policy_native_freeze" "cyclic actual graph"
                  else pending:=Redblackset.add (!pending,key)
                val ty=PRActualType (G.type_of graph node)
                val result=case G.view graph node of
                    G.Variable _=>SOME (atom ty)
                  | G.Constant _=>SOME (atom ty)
                  | G.Application(a,b)=>
                      actual_app (actual frame a) (actual frame b) ty
                  | G.AdmittedBinder {binder,body,...}=>
                      let val closure=G.binder_closure graph frame node
                          val data=G.binder_closure_data graph frame closure
                          val _=closures:=(frame,closure):: !closures
                          val b=actual (#body_frame data) body
                          val binder_type=type_weight (G.type_of graph binder)
                      in Option.map (fn (value:pr_native_size)=>
                        {raw=1+ #raw value,inc=2+ #inc value,
                         ann=type_size ty+binder_type+ #ann value,ty=ty}) b
                      end
                  | G.OpaqueRetained=>
                      (case profile frame node profiles of NONE=>NONE
                       | SOME data=>
                        let
                          val capture=G.prepare_profiled_metric graph frame
                            {node=node,profiles=profiles}
                          val _=ignore
                            (G.profiled_metric_data graph frame capture)
                          val _=captures:=(frame,capture):: !captures
                        in SOME {raw= #raw data,inc= #inc data,
                          ann= #ann data+ #type_bytes data,ty=ty} end)
                val _=charge 1
                val _=memo:=Redblackmap.insert (!memo,key,result)
                val _=pending:=Redblackset.delete (!pending,key)
              in result end end
        fun named node=atom (PRActualType (G.type_of graph node))
        fun member node []=false
          | member node (old::rest)=
              (charge 1;node=old orelse member node rest)
        fun add pair (count,cr,ci,ca,expanded)=
          let val (a:pr_native_size,b:pr_native_size option)=pair
              val next=case (expanded,b) of
                  (SOME(ar,ai,aa),SOME value)=>SOME
                    (ar+ #raw value,ai+ #inc value,aa+ #ann value)
                | _=>NONE
          in (count+1,cr+ #raw a,ci+ #inc a,ca+ #ann a,next) end
        fun sources_sizes [] state=state
          | sources_sizes (node::rest) state=
              (charge 1;sources_sizes rest
                (add (named node,actual scope node) state))
        fun facts_sizes [] state=state
          | facts_sizes (fact::rest) state=
              let val _=charge 1 val node=closed_node fact
              in facts_sizes rest (add (named node,actual scope node) state) end
        fun conversions_sizes [] state=state
          | conversions_sizes (conversion::rest) state=
              let val _=charge 1
                  val a=conversion_source conversion
                  val b=conversion_target conversion
              in conversions_sizes rest (add
                (equality true (named a) (named b),
                 actual_equality (actual scope a) (actual scope b)) state) end
        fun definitions_sizes [] state=state
          | definitions_sizes (node::rest) state=
              (charge 1;
               if member node atoms then definitions_sizes rest state
               else case G.view graph node of
                 G.Application(a,b)=>definitions_sizes rest (add
                   (equality true (named node)
                     (app (named a) (named b) (#ty (named node))),
                    actual_equality (actual scope node)
                     (actual_app (actual scope a) (actual scope b)
                       (#ty (named node)))) state)
               | G.Constant _=>definitions_sizes rest (add
                   (equality true (named node)
                      (atom (PRActualType (G.type_of graph node))),
                    actual_equality (actual scope node)
                      (actual scope node)) state)
               | _=>definitions_sizes rest state)
        val sizes=definitions_sizes reachable
          (conversions_sizes conversions (facts_sizes closed_facts
            (sources_sizes sources (0,0,0,0,SOME(0,0,0)))))
        val (leaf_total,cr,ci,ca,actual_sum)=sizes
        val _=if leaf_total<=IntInf.fromInt native_template then () else
          raise ERR "policy_native_freeze" "native leaf incidence exceeds cap"
        (* This narrowing follows the genuine native template admission;
           it supplies actual Vector/tree positions, never policy limits. *)
        val leaf_count=IntInf.toInt leaf_total
        fun context raw inc ann:pr_native_size=
          if leaf_total=0 then atom PRBooleanType else
            {raw=raw+3*(leaf_total-1),inc=inc+3*(leaf_total-1),
             ann=ann+conjunction_overhead*(leaf_total-1),ty=PRBooleanType}
        val compact=context cr ci ca
        val expanded=Option.map (fn (raw,inc,ann)=>context raw inc ann)
          actual_sum
        val _=if leaf_total>1 then
            (ignore (generated_type conjunction_type);
             ignore (generated_type conjunction_partial)) else ()
        fun bound cap label (value:pr_native_size)=
          if #raw value<=IntInf.fromInt cap andalso
              #inc value<=IntInf.fromInt cap then () else
            raise ERR "policy_native_freeze" label
        val _=bound native_template "compact native Context/H exceeds cap"
          compact
        (* Expanded Source residues are retained DATA, not this compact
           ASSUME/projection input. Binder-free INST may preserve large
           shared residues without a blanket unfolded Source cutoff. *)
        val _=List.app (fn node=>
          (charge 1;ignore (actual scope node))) reachable
        val results=List.map (fn node=>
          (charge 1;(node,actual scope node))) roots
        val root_types=List.map (fn node=>
          (charge 1;PRActualType (G.type_of graph node))) reachable
        val types=root_types @ List.rev (!generated)
        fun type_total [] amount arrows=(amount,arrows)
          | type_total (ty::rest) amount arrows=
              let fun count (PRActualType _)=0
                    | count PRBooleanType=0
                    | count (PRArrowType(a,b))=1+count a+count b
              in charge 1;type_total rest
                (amount+type_size ty) (arrows+count ty) end
        val (type_amount,arrow_count)=type_total types 0 0
        val projection_ops=if leaf_total=0 then 1 else 1+2*(leaf_total-1)
        val annotation_amount=type_amount+2*projection_ops* #ann compact
        val _=if annotation_amount<=IntInf.fromInt (#type_work_limit limits)
          then () else raise ERR "policy_native_freeze"
            "actual native Type portfolio exceeds caller cap"
        (* Source kind is immutable, and its actual Type forest is now
           admitted. Refuse before exposing any external Type callback. *)
        val _=List.app (fn node=>
          if Type.compare (G.type_of graph node,Type.bool)=EQUAL then () else
            raise ERR "policy_native_freeze" "source fact is not Boolean")
          sources
        fun weight (value:pr_native_size)= #raw value+ #inc value+ #ann value
        val amount=projection_ops*(1+2*weight compact)+arrow_count
        val entitlement=W.reserve_policy expected
          {role=W.FinalFreeze,ordinal=ordinal,amount=amount}
        val _=W.consume_policy expected entitlement amount
        val result=PRNativeFreezePlan {work=expected,tables=tables,
          contract=contract,profiles=profiles,captures=List.rev (!captures),
          closures=List.rev (!closures),types=types,check_type=check_type,
          compact=compact,actual=expanded,results=results,
          native_template=native_template,
          leaf_count=leaf_count,used=ref false}
        val _=pr_native_freeze_guard expected result
      in result end)
     handle primary=>(W.close expected;raise primary))

  fun native_realization_freeze_data_for expected
      (saved as PRNativeFreezePlan {work,...}) =
    (if Portable.pointer_eq (expected,work) then () else
       (W.close expected;raise ERR "policy_native_freeze"
         "different original Work");
     pr_native_freeze_guard expected saved;
     let
       val PRNativeFreezePlan
         {compact,actual,results,native_template,leaf_count,...}=saved
       fun triple (value:pr_native_size)=
         (#raw value,#inc value,#ann value)
     in {compact_context=triple compact,actual_context=Option.map triple actual,
       actual_results=List.map
         (fn (node,size)=>(node,Option.map triple size)) results,
       native_template=native_template,leaf_count=leaf_count} end)

  (* Only this private finisher mints PolicyFixedTable. Its guard argument
     is supplied below from the SAME genuine native-freeze plan, not a
     public callback or arbitrary table adoption port. *)
  fun pr_finish_native_table expected
      (PRFixedPlan {work,base,listing,used}) inputs payload contract guard =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "policy_native_table" "different original Work";
      W.spend_policy expected 0;
      if !used then raise ERR "policy_native_table" "table plan already used"
        else used:=true;
      let
        val _=guard ()
        val values=List.map payload inputs
        val map=R.finish_int_batch_with_listing (base,listing,values)
        val rows=R.finish_batch_list_int (map,listing)
        val _=guard ()
        (* Five added setup events: payer closure/capture, local binding,
           private store call and the added immutable record field. The
           shared constructor prices its actual empty ref separately. *)
        val _=W.spend_policy expected 5
        val profiles=SmtReplayNamedContext.empty_profile_store_using
          (fn amount=>W.spend_policy expected amount)
      in PolicyFixedTable {work=expected,map=map,rows=rows,contract=contract,
        profiles=profiles,guard=guard} end)
     handle primary=>(W.close expected;raise primary))
  fun freeze_owned_realization_tables_with_policy expected
      (saved as PRNativeFreezePlan {work,...}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "policy_native_freeze" "different original Work";
      pr_native_freeze_guard expected saved;W.spend_policy expected 0;
      let
        val PRNativeFreezePlan {tables,contract,types,check_type,
          native_template,leaf_count,used,...}=saved
        val PRRealizationTables {frontier,naming,names,nodes=node_plan,
          definitions=definition_plan,definition_rows,source_count,
          used=table_used,...}=tables
        val _=if !used orelse !table_used then
            raise ERR "policy_native_freeze" "native plan already used"
          else (used:=true;table_used:=true)
        val PolicyRealizationFrontier {graph,scope,frame,sources,closed_facts,
          conversions,reachable,atoms,...}=frontier
        fun valid ()=pr_native_freeze_guard expected saved
        fun render (PRActualType ty)=ty
          | render PRBooleanType=Type.bool
          | render (PRArrowType(a,b))=
              let val left=render a val right=render b
                  val _=valid ()
                  val ty=Type.-->(left,right)
                  val _=valid ()
              in ty end
        fun policy shape=
          let val _=valid () val ty=render shape val _=valid ()
              val _=check_type ty val _=valid ()
          in () end
        val _=List.app policy types
        val _=valid ()
        val minted=G.mint_placeholder_terms graph scope naming
        val _=valid ()
        val nodes=pr_finish_native_table expected node_plan minted
          (fn pair=>pair) contract valid
        fun named node= #2 (table_find (nodes,G.node_id node))
        fun member node []=false
          | member node (old::rest)=node=old orelse member node rest
        fun definitions node=
          if member node atoms then [] else case G.view graph node of
            G.Application(a,b)=>
              [Definition(node,Term.mk_comb (named a,named b))]
          | G.Constant _=>[Definition(node,G.representative graph node)]
          | _=>[]
        val leaves=Vector.fromList
          (List.map Source sources @ List.map ClosedWitness closed_facts @
           List.map ConversionWitness conversions @
           List.concat (List.map definitions reachable))
        val _=if Vector.length leaves=leaf_count then () else
          raise ERR "policy_native_freeze" "actual native leaf count changed"
        val leaf_terms=Vector.map (leaf_term named) leaves
        val tree=make_tree 0 leaf_count
        val context=tree_term leaf_terms tree
        val _=case SmtReplayImport.bounded_raw_size native_template context of
            SOME _=>() | NONE=>raise ERR "policy_native_freeze"
              "prospective compact context bound changed"
        val _=valid ()
        (* Prepay two cache writes, table dispatch and profile-store
           release call/write before the first projection rule. *)
        val _=W.spend_policy expected 5
        val projections=Vector.fromList
          (project tree (SmtReplayRuleObservation.ASSUME context))
        val _=valid ()
        fun index (_,value)=
          if value>=0 andalso value<IntInf.fromInt leaf_count then
            IntInf.toInt value else raise ERR "policy_native_freeze"
              "native definition position changed"
        val definition_table=pr_finish_native_table expected definition_plan
          definition_rows index contract valid
        val PRFixedNames {strings,types=type_map,held,epoch,symbols,
          validated_revision,...}=names
        (* These exact private R maps came from genuine placeholder rows.
           The old naming guard uses the same policy-aware Scope receipt. *)
        val _=W.spend_policy expected 1
        val name_guard=FixedNames {work=expected,graph=graph,scope=scope,
          frame=frame,strings=SOME strings,types=type_map,held=held,epoch=epoch,
          symbols=symbols,validated_revision=validated_revision}
        val block=Block {owner=ref (),graph=graph,scope=scope,nodes=nodes,
          names=HOLset.empty Term.compare,owned_names=SOME name_guard,
          leaves=leaves,tree=tree,context=context,projections=projections,
          leaf_index=NONE,definitions=definition_table,
          source_count=IntInf.toInt source_count,
          template_limit=native_template,realized=ref false,
          next_dependency=ref 0,primitive_metadata=ref NONE,
          assembly=ref NONE,
          owned_frame=SOME(expected,frame)}
        val _=valid ()
        val _=validate_block_for expected block
      in block end)
     handle primary=>(W.close expected;raise primary))

  (* Later policy rule consumers derive this exact token from the block;
     they must not accept a replacement same-Work native contract. *)
  fun policy_native_block_owner_for expected
      (block as Block {owned_frame,...}) =
    ((case owned_frame of SOME(work,_)=>
        if Portable.pointer_eq (expected,work) then () else
          raise ERR "policy_native_block" "different original Work"
      | NONE=>raise ERR "policy_native_block" "unowned proof block";
      let
        val Block {nodes,graph,scope,...}=block
        val contract=case nodes of
            saved as PolicyFixedTable {work,...}=>
              if Portable.pointer_eq (expected,work) then
                let val PolicyFixedTable {contract,...}=saved in contract end
              else raise ERR "policy_native_block" "different table Work"
          | _=>raise ERR "policy_native_block" "not a policy native block"
        val _=active block
      in {graph=graph,scope=scope,contract=contract} end)
     handle primary=>(W.close expected;raise primary))

  (* Fixed compact rules only; no external theorem callback or budget. *)
  fun pp_pay work amount = W.spend_policy work amount
  fun pp_spend work amount = pp_pay work (IntInf.fromInt amount)
  fun pp_owner work block =
    let val owned=policy_native_block_owner_for work block
        val native=SmtReplayNativeContract.for_work work (#contract owned)
    in (owned,native) end

  (* Like the original finite primitive preparer, debit actual future
     work immediately on SAME cumulative meter. This mints no transferable
     entitlement/credit and assumes no caller/block-local ordinal namespace. *)
  fun pp_future work amount = W.spend_policy work amount

  (* Memo values are unfolded incidence, not distinct-node Type sizes. *)
  fun pp_type_weight work ceiling root =
    SmtReplayNamedContext.type_weight_using (pp_pay work)
      (ERR "policy_primitive") ceiling root

  fun pp_name_member work ceiling
      (names as FixedNames {work=held,strings,types,...}) term =
    let val _=if Portable.pointer_eq (work,held) then () else
          raise ERR "policy_name" "different original Work"
        val _=fixed_names_guard work names
        val (text,ty)=Term.dest_var term
    in case strings of NONE =>
      let fun lookup index =
            let val slot = W.plan_lookup_int work (types,index)
            in R.int_lookup_value (types,slot) end
      in case fixed_suffix_name (pp_pay work) lookup text of
          NONE => false
        | SOME wanted =>
          let val a = pp_type_weight work ceiling ty
              val b = pp_type_weight work ceiling wanted
              val _ = pp_pay work (1+a+b)
          in Type.compare (ty,wanted)=EQUAL end
      end
    | SOME strings =>
      let val query=W.plan_lookup_string work (strings,text)
    in if not (R.string_lookup_value (strings,query)) then false else
      let val prefix="__smt_replay_"
          val _=pp_spend work (String.size text+String.size prefix+1)
          val _=if String.isPrefix prefix text then () else
            raise ERR "policy_name" "not an authentic placeholder spelling"
          val suffix=String.extract (text,String.size prefix,NONE)
          val _=pp_spend work (2*(String.size suffix+1))
          val index=case Int.fromString suffix of SOME n=>
                if n>=0 then n else raise ERR "policy_name" "negative index"
            | NONE=>raise ERR "policy_name" "invalid placeholder index"
          val slot=W.plan_lookup_int work (types,index)
          val (exact,wanted)=case R.int_lookup_value (types,slot) of
              SOME value=>value
            | NONE=>raise ERR "policy_name" "missing authentic typed name"
          val _=pp_spend work (String.size exact+String.size text+1)
          val a=pp_type_weight work ceiling ty
          val b=pp_type_weight work ceiling wanted
          val _=pp_pay work (1+a+b)
      in exact=text andalso Type.compare (ty,wanted)=EQUAL end
      end
    end

  (* This grammar has no binder constructor. Retained graph residues are
     never visited: only actual compact proof/context and named variables. *)
  fun pp_inspector work block
      (native:SmtReplayNativeContract.limits) =
    let val _=ignore(pp_owner work block)
        val _=pp_spend work 12
        val Block {nodes,owned_names,context,...}=block
        val names=case owned_names of SOME value=>value
          | NONE=>raise ERR "policy_primitive" "missing owned names"
        val profiles=case nodes of
            PolicyFixedTable{work=held,profiles,...}=>
              if Portable.pointer_eq(work,held)then profiles else
                raise ERR "policy_primitive" "different profile owner"
          | _=>raise ERR "policy_primitive" "missing policy profile store"
        val cap=IntInf.fromInt (#template_limit (#semantic_limits native))
        val ceiling=IntInf.fromInt (#type_work_limit native)
        (* SAME block/names/Scope before each cache read/publication. The
           shared store then fences its exact cap and Type/Term stamps.
           Future native result/Hyp/Type quotations are unchanged below. *)
        fun guarded_pay amount=
          (fixed_names_guard work names;pp_pay work amount)
        val shared = SmtReplayNamedContext.inspector_with_store
          {pay=guarded_pay,member=pp_name_member work ceiling names,
           guard=fn () => fixed_names_guard work names,
           template_limit= #template_limit (#semantic_limits native),
           type_work_limit= #type_work_limit native,
           error=ERR "policy_primitive"} profiles
        val profile= #profile shared
    in {profile=profile,cap=cap,ceiling=ceiling,names=names,
        common=context} end

  datatype policy_primitive_plan = PolicyPrimitivePlan of
    {work:W.portfolio,block:block,
     contract:SmtReplayNativeContract.contract,recipe:compact_primitive,
     proofs:Thm.thm list,shape:primitive_shape,hypotheses:Term.term list,
     dependencies:dependency list,used:bool ref,epoch:int,symbols:int}

  fun prepare_primitive_with_policy work block recipe premises =
    ((let val (owned,native)=pp_owner work block
          val _=W.spend_policy work 0
          val inspect=pp_inspector work block native
          val profile= #profile inspect
          val proofs=List.map (fn edge=>
            (pp_spend work 2;theorem block edge)) premises
          val hypotheses=common_hypotheses_using (pp_pay work)
            (#common inspect) Thm.hyp
          val _=tables_phase work "policy.primitive.forecast.before"
            (fn()=>"")
          val prepared = SmtReplayNamedContext.prepare_fixed_observed
            Thm.concl hypotheses
            {pay=pp_pay work,guard=fn () => (),
             template_limit= #template_limit (#semantic_limits native),
             type_work_limit= #type_work_limit native,
             error=ERR "policy_primitive"}
            profile (name block) (named_primitive recipe) proofs
          val _=tables_phase work "policy.primitive.forecast.after"
            (fn()=>"")
          val shape= #shape prepared
          val hypotheses= #hypotheses prepared
          val dependencies=List.map
            (fn Edge{dependencies,...}=>dependencies) premises
          val _=fixed_names_guard work (#names inspect)
          val _=active block
      in PolicyPrimitivePlan {work=work,block=block,
          contract= #contract owned,recipe=recipe,proofs=proofs,shape=shape,
          hypotheses=hypotheses,dependencies=dependencies,used=ref false,
          epoch=Type.type_epoch (),symbols=Term.term_epoch ()} end)
     handle primary=>(W.close work;raise primary))

  fun execute_primitive_with_policy expected
      (saved as PolicyPrimitivePlan {work,...}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "policy_primitive" "different original Work";
      let val PolicyPrimitivePlan {block,contract,recipe,proofs,shape,
            hypotheses,dependencies,used,epoch,symbols,...}=saved
          val (owned,_)=pp_owner expected block
          val _=if Portable.pointer_eq (#contract owned,contract) andalso
              epoch=Type.type_epoch () andalso symbols=Term.term_epoch ()
            then () else raise ERR "policy_primitive" "native owner changed"
          val _=W.spend_policy expected 0
          val _=if !used then raise ERR "policy_primitive" "used plan"
            else used:=true
          (* Pay all name/owner queries before the callback-free native
             suffix. Its result still requires the checked shape/Hyp test. *)
          val named=case recipe of ReflexiveName node=>SOME(name block node)
            | ApplyNamedArgument node=>SOME(name block node) | _=>NONE
          fun native_name _=case named of SOME term=>term | NONE=>
            raise ERR "policy_primitive" "unexpected native name query"
          val _=ignore(pp_owner expected block)
          val _=W.require_callback_free_return expected
          val proof=SmtReplayNamedContext.primitive_using
            (fn () => ERR "policy_primitive" "incorrect fixed recipe arity")
            native_name (named_primitive recipe) proofs
          val matches=SmtReplayNamedContext.matches
          val _=if matches shape (Thm.concl proof) andalso clean proof
              andalso List.all (fn term=>List.exists (fn candidate=>
                Portable.pointer_eq(term,candidate)) hypotheses)
                (Thm.hyp proof) then () else
            raise ERR "policy_primitive" "fixed rule result/Hyp changed"
          val _=if epoch=Type.type_epoch() andalso
              symbols=Term.term_epoch() then () else
            raise ERR "policy_primitive" "native lifetime changed"
          val Block {owner,graph,...}=block
          val dependency=new_dependency block (Union dependencies)
      in observe_proof graph #fixed;observe_proof graph #edges;
         Edge {owner=owner,theorem=proof,dependencies=dependency,
           primitive=NONE} end)
     handle primary=>(W.close expected;raise primary))

  (* The old constructor's exact operator-spine proof recipe. Every new
     rule goes through the actual prepared policy rule boundary above. *)
  fun constructor_with_policy expected block node =
    ((let val owned=policy_native_block_owner_for expected block
          val graph= #graph owned
          fun rule opcode inputs=execute_primitive_with_policy expected
            (prepare_primitive_with_policy expected block opcode inputs)
          fun build current=case G.view graph current of
              G.Constant _=>definition block current
            | G.Application(operator,operand)=>
                let val direct=definition block current
                    val parent=build operator
                    val applied=rule (ApplyNamedArgument operand) [parent]
                in rule Transitivity [direct,applied] end
            | _=>rule (ReflexiveName current) []
      in build node end)
     handle primary=>(W.close expected;raise primary))

  datatype policy_closed_named_inst_plan = PolicyClosedNamedInstPlan of
    {work:W.portfolio,block:block,theorem:Thm.thm,
     contract:SmtReplayNativeContract.contract,
     substitution:(Term.term,Term.term) Lib.subst,shape:named_inst_shape,
     oracles:string list,epoch:int,symbols:int,used:bool ref}
  fun prepare_closed_named_inst_with_policy expected block
      {substitution,theorem} =
    ((ignore (pp_owner expected block);W.spend_policy expected 0;active block;
      let
        val Block {owned_names,template_limit,...}=block
        val names = case owned_names of SOME held => held | NONE =>
          raise ERR "policy_closed_inst" "missing owned name plan"
        val _ = fixed_names_guard expected names
        fun spend n = pp_spend expected n
        val (_,native)=pp_owner expected block
        val ceiling=IntInf.fromInt (#type_work_limit native)
        val prepared=SmtReplayNamedContext.prepare_named_inst
          {pay=pp_pay expected,type_weight=pp_type_weight expected ceiling,
           member=pp_name_member expected ceiling names,
           template_limit=template_limit,
           type_work_limit= #type_work_limit native,error=ERR}
          {substitution=substitution,theorem=theorem}
        val shape= #shape prepared val oracles= #oracles prepared
        val _ = fixed_names_guard expected names
        val _ = active block
        val _ = spend 2
      in PolicyClosedNamedInstPlan {work=expected,block=block,theorem=theorem,
        contract= #contract (#1 (pp_owner expected block)),
        substitution=substitution,shape=shape,oracles=oracles,
        epoch=Type.type_epoch (),symbols=Term.term_epoch (),
        used=ref false} end)
     handle primary => (W.close expected;raise primary))

  fun execute_closed_named_inst_with_policy expected
      (saved as PolicyClosedNamedInstPlan {work,...}) =
    ((if Portable.pointer_eq (expected,work) then () else
        raise ERR "policy_closed_inst" "different original Work";
      let val PolicyClosedNamedInstPlan {block,theorem,substitution,
                shape,oracles,epoch,symbols,used,contract,...}=saved
          val (owner,_)=pp_owner expected block
          val _=if Portable.pointer_eq (#contract owner,contract) then () else
        raise ERR "policy_closed_inst" "different native contract"
          val _=W.spend_policy expected 0
          val _=active block
          val _=if !used then raise ERR "policy_closed_inst"
        "schema INST plan already executed" else used := true
        val Block {owner,graph,owned_names,...} = block
        val names = case owned_names of SOME held => held | NONE =>
          raise ERR "policy_closed_inst" "missing owned name plan"
        val _ = fixed_names_guard expected names
        val _ = if Type.type_epoch () = epoch andalso
            Term.term_epoch () = symbols then () else
          raise ERR "policy_closed_inst" "schema epochs changed"
        (* Exact same original variable-only INST. No P.checked, import,
           Hyp lookup, FVL/HOLset query or external proof callback follows. *)
        val _ = fixed_names_guard expected names
        val _ = active block
        val _ = W.require_callback_free_return expected
        val proof = SmtReplayRuleObservation.INST substitution theorem
        val matches=SmtReplayNamedContext.named_inst_matches
        val result_tag = Thm.tag proof
        val _ = if null (Thm.hyp proof) andalso
            null (Tag.axioms_of result_tag) andalso
            #1 (Tag.dest_tag result_tag) = oracles andalso
            matches shape (Thm.concl proof) then () else
          raise ERR "policy_closed_inst" "closed schema result changed"
        val _ = if Type.type_epoch()=epoch andalso
            Term.term_epoch()=symbols then () else
          raise ERR "policy_closed_inst" "native lifetime changed"
        val dependency = new_dependency block (Leaves [])
      in observe_proof graph #edges;
         Edge {owner=owner,theorem=proof,dependencies=dependency,
           primitive=NONE} end)
     handle primary => (W.close expected;raise primary))

  (* A compact law is closed BEFORE simultaneous variable-only INST.
     No realized residue is passed to matching, INST_TYPE or ALPHA. *)
  datatype policy_realization_plan = PolicyRealizationPlan of
    {work:W.portfolio,block:block,
     contract:SmtReplayNativeContract.contract,target:G.node,
     proof:Thm.thm,substitution:(Term.term,Term.term) Lib.subst,
     batch_weight:IntInf.int,epoch:int,symbols:int,used:bool ref}
  datatype policy_source_realization = PolicySourceRealization of
    {work:W.portfolio,block:block,
     contract:SmtReplayNativeContract.contract,target:G.node,
     theorem:Thm.thm,sources:G.node list,epoch:int,symbols:int}

  (* Batch only compact, individually admitted laws. A forest is not a new
     input schema: imposing an aggregate native cap would newly refuse wide
     Source portfolios. Pay its additional shells, closed proof construction
     and projections on the SAME Work instead. No expanded syntax is read. *)
  fun realization_batch_inventory pay profile error law_weights substitutions =
    let
      fun weight term =
        let val (raw,inc,ann)=profile term
        in raw+inc+ann end
      fun compare (a,b) =
        (pay 1;if Portable.pointer_eq(a,b) then EQUAL else
          (pay (weight a+weight b);Term.compare(a,b)))
      val bindings=ref (Redblackmap.mkDict compare)
      fun insert {redex,residue} =
        (pay 3;case Redblackmap.peek (!bindings,redex) of
            SOME held => if Portable.pointer_eq(held,residue) then () else
              raise error "inconsistent private realization substitution"
          | NONE => bindings:=Redblackmap.insert
              (!bindings,redex,residue))
      val _=List.app (List.app insert) substitutions
      val merged=Redblackmap.foldl (fn (redex,residue,rest) =>
        (pay 2;{redex=redex,residue=residue}::rest)) [] (!bindings)
      (* Scalar profiles were already paid and authenticated during each
         component's admission. Reopening every law here is redundant. *)
      val weights=Vector.fromList
        (List.map (fn weight => (pay 2;weight)) law_weights)
      fun forest start count =
        if count=0 then 0 else if count=1 then Vector.sub(weights,start)
        else let val left=count div 2
                 val a=forest start left
                 val b=forest (start+left) (count-left)
                 (* CONJ and both projections, including compact operands,
                    results and Boolean annotations; no expanded walk. *)
                 val _=pay (32+6*(a+b+15))
             in 15+a+b end
      val _=ignore (forest 0 (Vector.length weights))
    in merged end

  fun prepare_realization_with_policy work block target edge =
    ((let val (owner,native)=pp_owner work block
          val Block {graph,scope,context,nodes,leaves,realized,...}=block
          val _=W.spend_policy work 0
          val _=if !realized then raise ERR "policy_realize" "used block"
            else ()
          val proof=theorem block edge
          val wanted=name block target
          val inspect=pp_inspector work block native
          val profile= #profile inspect
          val c=profile context val t=profile wanted
          val _=if Portable.pointer_eq (Thm.concl proof,wanted) andalso
              clean proof andalso List.all (fn term=>
                Portable.pointer_eq(term,context)) (Thm.hyp proof) then ()
            else raise ERR "policy_realize" "not a genuine compact endpoint"
          val raw=3+ #raw c+ #raw t
          val inc=3+ #inc c+ #inc t
          val ann=9+ #ann c+ #ann t
          val _=if raw<= #cap inspect andalso inc<= #cap inspect andalso
              ann<= #ceiling inspect then () else
            raise ERR "policy_realize" "compact closing law exceeds native cap"
          fun substitution (_, (node,variable),rest)=
            let val _=pp_spend work 2
                val actual=G.representative graph node
                val expected= #2 (Term.dest_var variable)
                val wanted=G.type_of graph node
                val a=pp_type_weight work (#ceiling inspect) expected
                val b=pp_type_weight work (#ceiling inspect) wanted
                val _=pp_pay work (1+a+b)
                val _=if Type.compare(expected,wanted)=EQUAL then () else
                  raise ERR "policy_realize" "placeholder Type changed"
            in {redex=variable,residue=actual}::rest end
          val replacements=table_foldl substitution [] nodes
          fun validate (Source node)=
                (ignore (G.representative graph node);())
            | validate (Definition(node,_))=
                (case G.view graph node of G.Constant _=>()
                 | G.Application _=>()
                 | _=>raise ERR "policy_realize" "unsupported definition")
            | validate (ClosedWitness fact)=
                validate_closed_fact_with_policy graph scope
                  (#template_limit (W.semantic_policy work)) fact
            | validate (ConversionWitness conversion)=
                (validate_conversion_for work conversion;
                 validate_conversion_with_policy graph scope
                   (#template_limit (W.semantic_policy work)) conversion)
          val _=Vector.app validate leaves
          val count=IntInf.fromInt (Vector.length leaves)
          (* This is compact closing/projection work. Expanded replacements
             are borrowed existing terms, not a new unfolded result quote. *)
          val amount=5+raw+inc+ann+8*count+count*(count+2)
          val _=pp_future work amount
          val _=ignore (pp_owner work block)
      in PolicyRealizationPlan {work=work,block=block,
          contract= #contract owner,target=target,proof=proof,
          substitution=replacements,batch_weight=raw+inc+ann,
          epoch=Type.type_epoch (),
          symbols=Term.term_epoch (),used=ref false} end)
     handle primary=>(W.close work;raise primary))

  (* Private callback-free native programmes. Resolve ALL payable graph,
     receipt and owner getters before the first native rule, including all
     components of a batch. No Work credit or public guard bypass escapes
     this extent. Kernel rules cannot change the validated owner/frame;
     declaration stamps are still checked at each native boundary. *)
  datatype realization_witness = RealizationSource of Term.term
    | RealizationReflexive of Term.term | RealizationProof of Thm.thm
  fun realization_witness_proof (RealizationSource term) =
        SmtReplayRuleObservation.ASSUME term
    | realization_witness_proof (RealizationReflexive term) =
        SmtReplayRuleObservation.REFL term
    | realization_witness_proof (RealizationProof proof) = proof
  fun realization_stamp_guard epoch symbols () =
    if epoch=Type.type_epoch () andalso symbols=Term.term_epoch () then ()
    else raise ERR "policy_realize" "declaration lifetime changed"

  fun preflight_realization expected
      (saved as PolicyRealizationPlan {work,...}) =
    ((if Portable.pointer_eq(expected,work) then () else
        raise ERR "policy_realize" "different original Work";
      let val PolicyRealizationPlan {block,contract,target,proof,
            substitution,epoch,symbols,used,...}=saved
          val (owner,_)=pp_owner expected block
          val _=W.spend_policy expected 0
          val _=if Portable.pointer_eq(#contract owner,contract) andalso
              epoch=Type.type_epoch () andalso symbols=Term.term_epoch ()
            then () else raise ERR "policy_realize" "native owner changed"
          val Block {graph,scope,context,leaves,tree,realized,...}=block
          val _=if !used orelse !realized then
              raise ERR "policy_realize" "used realization"
            else used:=true
          fun witness leaf=
            (pp_spend expected 6;case leaf of Source node=>
                RealizationSource (G.representative graph node)
              | Definition(node,_)=>
                  RealizationReflexive (G.representative graph node)
              | ClosedWitness fact=>RealizationProof (closed_proof fact)
              | ConversionWitness conversion=>
                  RealizationProof (conversion_proof conversion))
          val witnesses=Vector.map witness leaves
          val sources=Vector.foldr
            (fn(Source node,rest)=>node::rest | (_,rest)=>rest) [] leaves
          val permitted_terms=Vector.foldr
            (fn(RealizationSource term,rest)=>term::rest | (_,rest)=>rest)
            [] witnesses
          val endpoint=G.representative graph target
          val _=ignore (pp_owner expected block)
          val valid=realization_stamp_guard epoch symbols
          fun run instantiated=
            let
              val _=valid ()
              val actual=Vector.map realization_witness_proof witnesses
              val antecedent=tree_proof actual tree
              val result=SmtReplaySimultaneousRealization.apply
                {guard=valid,law=instantiated,witnesses=[antecedent]}
              fun permitted term=List.exists
                (fn held=>Portable.pointer_eq(term,held)) permitted_terms
              val _=if Portable.pointer_eq(Thm.concl result,endpoint) andalso
                  clean result andalso List.all permitted (Thm.hyp result)
                then () else raise ERR "policy_realize"
                  "native endpoint or Source Hyp changed"
            in PolicySourceRealization {work=expected,block=block,
              contract=contract,target=target,theorem=result,sources=sources,
              epoch=epoch,symbols=symbols} end
      in {contexts=[context],proof=proof,substitution=substitution,
          guard=valid,run=run,realized=realized} end)
     handle primary=>(W.close expected;raise primary))

  fun execute_realization_with_policy expected
      (saved as PolicyRealizationPlan {block,...}) =
    ((let val {contexts,proof,substitution,guard,run,...}=
            preflight_realization expected saved
          val _=W.require_callback_free_return expected
          val instantiated=SmtReplaySimultaneousRealization.instantiate
            {guard=guard,error=ERR "policy_realize",contexts=contexts,
             proof=proof,substitution=substitution}
          val result=run instantiated
          val _=retire_block block
      in result end) handle primary=>(W.close expected;raise primary))

  (* Individually admitted plans over ONE private block. All laws close
     before ONE forest INST; only then are their own witnesses applied.
     No receipt, Source proof or native quote is accepted from a caller. *)
  datatype policy_realization_batch = PolicyRealizationBatch of
    {work:W.portfolio,block:block,plans:policy_realization_plan list,
     substitution:(Term.term,Term.term) Lib.subst,used:bool ref}

  fun prepare_realization_batch_with_policy expected block requests =
    ((let
        val _=ignore (pp_owner expected block)
        val _=W.spend_policy expected 3
        fun prepare []=(ignore (pp_owner expected block);[])
          | prepare ((target,edge)::rest)=
              let val _=W.spend_policy expected 2
                  val plan=prepare_realization_with_policy
                    expected block target edge
                  val remaining=prepare rest
                  val _=W.spend_policy expected 1
              in plan::remaining end
        val plans=prepare requests
        val (_,native)=pp_owner expected block
        val inspect=pp_inspector expected block native
        fun profile term=let val p= #profile inspect term
          in (#raw p,#inc p,#ann p) end
        val weights=List.map (fn PolicyRealizationPlan {batch_weight,...} =>
          batch_weight) plans
        val substitution=realization_batch_inventory
          (pp_pay expected) profile (ERR "policy_realize_batch") weights
          (List.map (fn PolicyRealizationPlan {substitution,...} =>
            substitution) plans)
        val _=ignore (pp_owner expected block)
      in PolicyRealizationBatch
        {work=expected,block=block,plans=plans,substitution=substitution,
         used=ref false} end)
     handle primary=>(W.close expected;raise primary))

  fun execute_realization_batch_with_policy expected
      (saved as PolicyRealizationBatch {work,...}) =
    ((if Portable.pointer_eq(expected,work) then () else
        raise ERR "policy_realize_batch" "different original Work";
      let
        val PolicyRealizationBatch {block,plans,substitution,used,...}=saved
        val _=ignore (pp_owner expected block)
        val _=W.spend_policy expected 2
        val Block {realized,...}=block
        val _=if !used orelse !realized then
            raise ERR "policy_realize_batch" "used realization"
          else used:=true
        (* Pay the entire execution envelope BEFORE the first native
           forest operation, not after an already instantiated batch. *)
        fun quote []=W.spend_policy expected 1
          | quote (_::rest)=(W.spend_policy expected 3;quote rest)
        val _=quote plans
        val programmes=List.map (preflight_realization expected) plans
        val components=List.map (fn {contexts,proof,...}=>(contexts,proof))
          programmes
        val valid=realization_stamp_guard
          (Type.type_epoch ()) (Term.term_epoch ())
        val _=ignore (pp_owner expected block)
        val _=W.require_callback_free_return expected
        val laws=SmtReplaySimultaneousRealization.instantiate_batch
          {guard=valid,error=ERR "policy_realize_batch",proofs=components,
           substitution=substitution}
        fun execute [] []=(valid ();[])
          | execute (run::rest) (law::tail)=run law::execute rest tail
          | execute _ _=raise ERR "policy_realize_batch" "component count"
        val results=execute (List.map #run programmes) laws
        (* No requests means retirement of an unused block, not emission
           of a completed realized theorem (and needs no INST). *)
        val _=retire_block block
      in results end)
     handle primary=>(W.close expected;raise primary))

  (* Consuming the compact Block invalidates further edge use, not the
     genuine Scope/contract/path backing retained by the checked result. *)
  (* One callback-free receipt-backing traversal only. A priced portfolio
     retains its exact original guard/debit programme. The slot is local
     to the current thread, never shared across public calls or callbacks. *)
  datatype pr_receipt_guard_context=PRReceiptGuardContext of
    {work:W.portfolio,graph:G.graph,epoch:int,symbols:int,
     revision:IntInf.int ref,
     completed:(block * SmtReplayNativeContract.contract)list ref}
  val pr_receipt_guard_slot:
      pr_receipt_guard_context option ThreadLocal.t=ThreadLocal.new()
  fun pr_receipt_guard_current()=
    case ThreadLocal.get pr_receipt_guard_slot of NONE=>NONE|SOME value=>value

  (* Only genuine callback-free DATA validators establish this extent.
     The private context never encloses prepare/execute, native rules or
     an external callback. Its initial shell is passive: immutable owner
     fences in the original validator still precede activation or debit. *)
  type pr_realized_data =
    {graph:G.graph,root:G.scope,scope:G.scope,
     sources:SmtReplaySource.sources,frame:Scope.receipt,
     equality:G.node,source:G.node,target:G.node,
     template_policy:RP.limit,
     native_contract:SmtReplayNativeContract.contract}
  datatype pr_completed_realized_data=PRCompletedRealizedData of
    {receipt:policy_source_realization,graph:G.graph,scope:G.scope,
     frame:Scope.receipt,contract:SmtReplayNativeContract.contract,
     epoch:int,symbols:int,revision:IntInf.int,data:pr_realized_data}
  datatype pr_pure_validation_context=PRPureValidationContext of
    {work:W.portfolio,backing:pr_receipt_guard_context option ref,
     completed:pr_completed_realized_data list ref}
  val pr_pure_validation_slot:
      pr_pure_validation_context option ThreadLocal.t=ThreadLocal.new()
  fun pr_pure_validation_current()=
    case ThreadLocal.get pr_pure_validation_slot of
      NONE=>NONE|SOME value=>value
  fun pr_with_pure_validation expected action=
    if not(W.ordinary_policy_guard_mode expected)then action()else
      case pr_pure_validation_current()of
        SOME(PRPureValidationContext{work,...})=>
          if Portable.pointer_eq(expected,work)then action()else
            pr_fresh_pure_validation expected action
      | NONE=>pr_fresh_pure_validation expected action
  and pr_fresh_pure_validation expected action=
    let val context=PRPureValidationContext
          {work=expected,backing=ref NONE,completed=ref[]}
    in Portable.genwith_flag
      ({get=pr_pure_validation_current,
        set=fn value=>ThreadLocal.set(pr_pure_validation_slot,value)},
       SOME context)(fn()=>action())()end
  (* These helpers are called only AFTER pp_realized_guard's original
     Work/table/contract/frame/Scope fences. No root is activated when
     establishing the passive context, including on a foreign request. *)
  fun pr_pure_backing expected=
    case pr_pure_validation_current()of
      SOME(PRPureValidationContext{work,backing,...})=>
        if Portable.pointer_eq(expected,work)then
          (case !backing of NONE=>NONE|SOME context=>
            (W.spend_ordinary_guard_policy expected 1;SOME context))
        else NONE
    | NONE=>NONE
  fun pr_keep_pure_backing expected context=
    case pr_pure_validation_current()of
      SOME(PRPureValidationContext{work,backing,...})=>
        if Portable.pointer_eq(expected,work)then
          (W.spend_ordinary_guard_policy expected 1;
           backing:=SOME context)else()
    | NONE=>()
  (* Only comparisons introduced by widening an ALREADY completed old
     context are newly billed. Its first original backing traversal and
     all calls outside this private extent keep the old f5db programme. *)
  fun pr_pay_shared_backing expected context=
    case pr_pure_validation_current()of
      SOME(PRPureValidationContext{work,backing,...})=>
        if Portable.pointer_eq(expected,work)then
          (case !backing of SOME held=>
             if Portable.pointer_eq(context,held)then
               W.spend_ordinary_guard_policy expected 1 else()
           | NONE=>())else()
    | NONE=>()
  fun pr_lookup_realized_data expected receipt graph scope frame contract=
    case pr_pure_validation_current()of
      SOME(PRPureValidationContext{work,completed,...})=>
        if not(Portable.pointer_eq(expected,work))then NONE else
        if null(!completed)then NONE else
          let
            val revision=G.validation_revision graph scope
            fun seek []=
                  (W.spend_ordinary_guard_policy expected 1;NONE)
              | seek(PRCompletedRealizedData
                  {receipt=old,graph=owner,scope=held,frame=requester,
                   contract=native,epoch,symbols,revision=stamp,data}::rest)=
                  (W.spend_ordinary_guard_policy expected 1;
                   if Portable.pointer_eq(receipt,old)andalso
                       Portable.pointer_eq(graph,owner)andalso scope=held
                       andalso Portable.pointer_eq(frame,requester)
                       andalso Portable.pointer_eq(contract,native)
                       andalso epoch=Type.type_epoch()andalso
                       symbols=Term.term_epoch()andalso revision=stamp
                   then SOME data else seek rest)
          in seek(!completed)end
    | NONE=>NONE
  fun pr_keep_realized_data expected receipt
      (data:pr_realized_data)=
    case pr_pure_validation_current()of
      SOME(PRPureValidationContext{work,completed,...})=>
        if Portable.pointer_eq(expected,work)then
          let val revision=G.validation_revision(#graph data)(#scope data)
              val _=W.spend_ordinary_guard_policy expected 1
          in completed:=PRCompletedRealizedData
            {receipt=receipt,graph= #graph data,scope= #scope data,
             frame= #frame data,contract= #native_contract data,
             epoch=Type.type_epoch(),symbols=Term.term_epoch(),
             revision=revision,data=data}:: !completed end
        else()
    | NONE=>()
  fun pr_receipt_guard_completed expected graph scope block contract backing=
    case W.priced_root_scope_path expected of SOME _=>
        (backing();G.validate_scope graph scope)
    | NONE=>
      let
        fun run(context as PRReceiptGuardContext
            {work,graph=owner,epoch,symbols,revision,completed})=
          let
            (* The real pp_realized_guard local Work/table/contract/Scope
               checks have already run, before every lookup/hit. *)
            val _=if Portable.pointer_eq(expected,work)andalso
                Portable.pointer_eq(graph,owner)andalso
                Type.type_epoch()=epoch andalso Term.term_epoch()=symbols
              then ()else raise ERR "policy_receipt_guard"
                "different original context or retired epoch"
            val current=G.validation_revision graph scope
            val _=if !revision=current then ()else
              (completed:=[];revision:=current)
            fun member []=(pr_pay_shared_backing expected context;false)
              | member((old,held)::rest)=
                  (pr_pay_shared_backing expected context;
                   (Portable.pointer_eq(block,old)andalso
                    Portable.pointer_eq(contract,held))orelse member rest)
            val hit=member(!completed)
            (* Never mark a pending or failed receipt as completed. No
               external Type/observer callback runs inside backing. *)
            val _=if hit then ()else backing()
            val _=G.validate_scope graph scope
            val after=G.validation_revision graph scope
            val _=if after=current andalso !revision=current then
                if hit then ()else
                  (pr_pay_shared_backing expected context;
                   completed:=(block,contract):: !completed)
              else(completed:=[];revision:=after)
          in ()end
        val prior=case pr_receipt_guard_current()of
            SOME context=>SOME context
          | NONE=>pr_pure_backing expected
        fun fresh()=
          let
            val context=PRReceiptGuardContext
              {work=expected,graph=graph,epoch=Type.type_epoch(),
               symbols=Term.term_epoch(),
               revision=ref(G.validation_revision graph scope),
               completed=ref[]}
          in Portable.genwith_flag
            ({get=pr_receipt_guard_current,
              set=fn value=>ThreadLocal.set(pr_receipt_guard_slot,value)},
             SOME context)(fn held=>
               (run held;pr_keep_pure_backing expected held))context end
      in case prior of SOME(context as PRReceiptGuardContext
          {work,graph=owner,epoch,symbols,...})=>
           if Portable.pointer_eq(work,expected)andalso
               Portable.pointer_eq(owner,graph)andalso
               Type.type_epoch()=epoch andalso Term.term_epoch()=symbols
             then run context else fresh()
        | NONE=>fresh()
      end

  fun pp_realized_guard expected
      (block as Block {owned_frame,...}) contract =
    (case owned_frame of NONE=>raise ERR "policy_realize" "unowned block"
     | SOME(held,frame)=>
       if not (Portable.pointer_eq(expected,held)) then
         raise ERR "policy_realize" "different original Work"
       else let val Block {nodes,graph,scope,...}=block
                val saved=case nodes of
                    value as PolicyFixedTable {work,...}=>
                      if Portable.pointer_eq(expected,work) then value else
                        raise ERR "policy_realize" "different table Work"
                  | _=>raise ERR "policy_realize" "not a policy table"
                val PolicyFixedTable {contract=original,guard,...}=saved
                val _=if Portable.pointer_eq(contract,original) then () else
                  raise ERR "policy_realize" "different native contract"
                val _=SmtReplayNativeContract.validate_for expected contract
                val data=Scope.description_for expected frame
                val _=if Portable.pointer_eq(#graph data,graph) andalso
                    #scope data=scope then () else
                  raise ERR "policy_realize" "actual frame changed"
            in pr_receipt_guard_completed expected graph scope
                 block contract guard end)

  fun policy_source_realization_theorem_for expected
      (saved as PolicySourceRealization {work,...}) =
    ((if Portable.pointer_eq(expected,work) then () else
        raise ERR "policy_realize" "different original Work";
      let val PolicySourceRealization {block,contract,theorem,
                epoch,symbols,...}=saved
          val _=pp_realized_guard expected block contract
          val _=if epoch=Type.type_epoch () andalso
              symbols=Term.term_epoch () then () else
            raise ERR "policy_realize" "native epochs changed"
      in theorem end)
     handle primary=>(W.close expected;raise primary))

  (* No arbitrary proof callback: every instruction names a fixed rule. *)
  datatype policy_boolean_rule = PolicyImplicationMP | PolicyConjunction
    | PolicyConjunctLeft | PolicyConjunctRight | PolicyNotIntro
    | PolicyNotElim | PolicyEqTrueElim | PolicyEqFalseElim
    | PolicyContradiction of G.node
  fun named_boolean PolicyImplicationMP =
        SmtReplayNamedContext.PolicyImplicationMP
    | named_boolean PolicyConjunction = SmtReplayNamedContext.PolicyConjunction
    | named_boolean PolicyConjunctLeft = SmtReplayNamedContext.PolicyConjunctLeft
    | named_boolean PolicyConjunctRight =
        SmtReplayNamedContext.PolicyConjunctRight
    | named_boolean PolicyNotIntro = SmtReplayNamedContext.PolicyNotIntro
    | named_boolean PolicyNotElim = SmtReplayNamedContext.PolicyNotElim
    | named_boolean PolicyEqTrueElim = SmtReplayNamedContext.PolicyEqTrueElim
    | named_boolean PolicyEqFalseElim = SmtReplayNamedContext.PolicyEqFalseElim
    | named_boolean (PolicyContradiction node) =
        SmtReplayNamedContext.PolicyContradiction node
  datatype pb_shape = datatype SmtReplayNamedContext.boolean_shape
  datatype policy_boolean_plan = PolicyBooleanPlan of
    {work:W.portfolio,block:block,
     contract:SmtReplayNativeContract.contract,opcode:policy_boolean_rule,
     proofs:Thm.thm list,shape:pb_shape,hypotheses:Term.term list,
     dependencies:dependency list,epoch:int,symbols:int,used:bool ref}
  fun prepare_boolean_primitive_with_policy work block opcode premises =
    ((let val (owner,native)=pp_owner work block
          val _=W.spend_policy work 0
          val inspect=pp_inspector work block native
          val profile= #profile inspect
          val proofs=List.map (fn edge=>
            (pp_spend work 2;theorem block edge)) premises
          val hypotheses=common_hypotheses_using (pp_pay work)
            (#common inspect) Thm.hyp
          val prepared=SmtReplayNamedContext.prepare_boolean_observed
            Thm.concl hypotheses
            {pay=pp_pay work,guard=fn()=>(),
             template_limit= #template_limit (#semantic_limits native),
             type_work_limit= #type_work_limit native,
             error=ERR "policy_boolean"}
            profile (name block) (named_boolean opcode) proofs
          val shape= #shape prepared
          val hypotheses= #hypotheses prepared
          val dependencies=List.map
            (fn Edge {dependencies,...}=>dependencies) premises
          val _=ignore(pp_owner work block)
      in PolicyBooleanPlan {work=work,block=block,
          contract= #contract owner,opcode=opcode,proofs=proofs,shape=shape,
          hypotheses=hypotheses,dependencies=dependencies,
          epoch=Type.type_epoch (),symbols=Term.term_epoch (),used=ref false}
      end)
     handle primary=>(W.close work;raise primary))

  fun execute_boolean_primitive_with_policy expected
      (saved as PolicyBooleanPlan {work,...}) =
    ((if Portable.pointer_eq(expected,work) then () else
        raise ERR "policy_boolean" "different original Work";
      let val PolicyBooleanPlan {block,contract,opcode,proofs,shape,
                hypotheses,dependencies,epoch,symbols,used,...}=saved
          val (owner,_)=pp_owner expected block
          val _=W.spend_policy expected 0
          val _=if Portable.pointer_eq(#contract owner,contract) andalso
              epoch=Type.type_epoch () andalso symbols=Term.term_epoch ()
            then () else raise ERR "policy_boolean" "native owner changed"
          val _=if !used then raise ERR "policy_boolean" "used plan"
            else used:=true
          val named=case opcode of PolicyContradiction node=>
              SOME(name block node) | _=>NONE
          fun native_name _=case named of SOME term=>term | NONE=>
            raise ERR "policy_boolean" "unexpected native name query"
          val _=ignore(pp_owner expected block)
          val _=W.require_callback_free_return expected
          val proof=SmtReplayNamedContext.boolean_using
            (fn()=>ERR "policy_boolean" "incorrect fixed rule arity")
            native_name (named_boolean opcode) proofs
          val matches=SmtReplayNamedContext.boolean_matches
          val _=if matches shape(Thm.concl proof) andalso clean proof andalso
              List.all (fn term=>List.exists(fn held=>
                Portable.pointer_eq(term,held)) hypotheses)(Thm.hyp proof)
            then () else raise ERR "policy_boolean" "fixed proof changed"
          val _=if epoch=Type.type_epoch() andalso
              symbols=Term.term_epoch() then () else
            raise ERR "policy_boolean" "native lifetime changed"
          val Block {owner,graph,...}=block
          val dependency=new_dependency block (Union dependencies)
      in observe_proof graph #fixed;observe_proof graph #edges;
         Edge {owner=owner,theorem=proof,dependencies=dependency,
           primitive=NONE} end)
     handle primary=>(W.close expected;raise primary))

  (* Borrowed DATA queries retain actual Block/Work/NC admission. No
     native proof function or caller-supplied bound enters this interface. *)
  fun compact_profile_with_policy work block term =
    ((let val(_,native)=pp_owner work block
          val _=W.spend_policy work 0
          val inspect=pp_inspector work block native
          val result= #profile inspect term
          val _=ignore(pp_owner work block)
      in result end) handle primary=>(W.close work;raise primary))
  fun native_type_weight_with_policy work block ty =
    ((let val(_,native)=pp_owner work block
          val _=W.spend_policy work 0
          val result=pp_type_weight work
            (IntInf.fromInt(#type_work_limit native)) ty
          val _=ignore(pp_owner work block)
      in result end) handle primary=>(W.close work;raise primary))

  fun pg_scoped_metric_collector graph scope profiles =
    let
      val saved=ref ([]:(G.node * G.profiled_metric) list)
      fun query expected metric _ node =
        let
          val _=if Portable.pointer_eq (expected,graph) then () else
            raise ERR "policy_metric" "different graph owner"
          val capture=case List.find (fn (held,_)=>node=held) (!saved) of
              SOME (_,capture)=>capture
            | NONE=>let val capture=G.prepare_scoped_profiled_metric graph scope
                    {node=node,profiles=profiles}
                in saved := (node,capture):: !saved;capture end
          val data=G.profiled_metric_data graph scope capture
          val _=if #node data=node then () else
            raise ERR "policy_metric" "different actual node"
        in SOME (case metric of G.RawNodes=> #raw data
              | G.BinderInclusiveNodes=> #inc data) end
      fun captures ()=List.map #2 (List.rev (!saved))
      fun guard ()=pg_metric_guard graph scope (captures ())
      fun types ()=List.concat (List.map (fn capture=>
        #types (G.profiled_metric_data graph scope capture)) (captures ()))
    in (query,guard,captures,types) end

  (* No profile issuer field selects the requester: the actual graph
     traversal enters only each checked creation's body frame. *)
  fun record_closed_with_policy_scoped_profiles graph scope
      {node,theorem,template_limit,check_type,profiles} =
    let val(query,guard,captures,types)=
          pg_scoped_metric_collector graph scope profiles
    in pc_record_closed_program query guard captures types false graph scope
      {node=node,theorem=theorem,template_limit=template_limit,
       check_type=check_type} end

  (* A private same-production join for a future generated-focus consumer.
     This is not native admission or an arbitrary fact/metric pairing. *)
  datatype scoped_generated_equality = ScopedGeneratedEquality of
    {graph:G.graph,scope:G.scope,maximum:RP.limit,fact:closed_fact,
     source:G.node,target:G.node,metric:G.profiled_metric,
     profiles:G.policy_opaque_profile list}
  fun record_generated_equality_with_policy_scoped_profiles graph scope
      {node,theorem,template_limit,check_type,profiles} =
    let
      val _=G.validate_scope graph scope
      val _=ignore(G.view graph node)
      val(partial,target)=case G.view graph node of G.Application pair=>pair
        | _=>raise ERR "scoped_equality" "not an actual equality application"
      val(head,source)=case G.view graph partial of G.Application pair=>pair
        | _=>raise ERR "scoped_equality" "not an actual equality spine"
      val _=case G.view graph head of G.Constant _=>
          if Term.same_const(G.representative graph head)
              boolSyntax.equality then () else
            raise ERR "scoped_equality" "not the actual equality constructor"
        | _=>raise ERR "scoped_equality" "not an equality constant"
      val metric=G.prepare_scoped_profiled_metric graph scope
        {node=target,profiles=profiles}
      fun target_data ()=
        let val data=G.profiled_metric_data graph scope metric
        in if #node data=target then data else
          raise ERR "scoped_equality" "different actual target capture" end
      val _=ignore(target_data())
      val(query,base_guard,base_captures,types)=
        pg_scoped_metric_collector graph scope profiles
      fun guard ()=(base_guard();ignore(target_data()))
      fun captures ()=base_captures()@[metric]
      val fact=pc_record_closed_program query guard captures types false
        graph scope {node=node,theorem=theorem,template_limit=template_limit,
          check_type=check_type}
      val _=guard()
    in ScopedGeneratedEquality {graph=graph,scope=scope,
      maximum=template_limit,fact=fact,source=source,target=target,
      metric=metric,profiles=profiles} end

  fun scoped_generated_equality_for graph scope maximum
      (saved as ScopedGeneratedEquality {graph=owner,...}) =
    if Portable.pointer_eq(graph,owner) then
      let val ScopedGeneratedEquality {scope=frame,maximum=original,fact,
                source,target,metric,profiles,...}=saved
          val _=if scope=frame andalso maximum=original then () else
            raise ERR "scoped_equality" "different original requester or cap"
          val _=G.validate_scope graph scope
          val _=validate_closed_fact_with_policy graph scope maximum fact
          val data=G.profiled_metric_data graph scope metric
          val _=if #node data=target then () else
            raise ERR "scoped_equality" "different actual target"
      in {fact=fact,source=source,target=target,metric=metric,
          profiles=profiles,raw= #raw data,inclusive= #inc data} end
    else raise ERR "scoped_equality" "different graph owner"

  (* Closed equality evidence from the SAME private realization producer.
     This port never re-records borrowed expanded terms as opened views. *)
  fun policy_source_realization_data_for expected
      (saved as PolicySourceRealization {work,...}) =
    pr_with_pure_validation expected(fn()=>
    ((if Portable.pointer_eq(expected,work) then () else
        raise ERR "policy_conversion" "different original Work";
      let
        val proof=policy_source_realization_theorem_for expected saved
        val PolicySourceRealization {block,contract,target=equality,...}=saved
        val Block {graph,scope,owned_frame,...}=block
        val frame=case owned_frame of SOME(_,frame)=>frame
          | NONE=>raise ERR "policy_conversion" "unowned realization"
        val data=Scope.description_for expected frame
        val _=if Portable.pointer_eq(graph,#graph data) andalso
            scope= #scope data then () else
          raise ERR "policy_conversion" "different actual frame"
        fun acquire()=
          let
        val (partial,target)=case G.view graph equality of
            G.Application pair=>pair
          | _=>raise ERR "policy_conversion" "not an equality application"
        val (head,source)=case G.view graph partial of
            G.Application pair=>pair
          | _=>raise ERR "policy_conversion" "not an equality spine"
        val _=case G.view graph head of G.Constant _=>
            if Term.same_const(G.representative graph head)
                boolSyntax.equality then () else
              raise ERR "policy_conversion" "not the equality constructor"
          | _=>raise ERR "policy_conversion" "not an equality constant"
        val (left,right)=boolSyntax.dest_eq(Thm.concl proof)
        val _=if HOLset.numItems(Thm.hypset proof)=0 andalso clean proof
            andalso Portable.pointer_eq(Thm.concl proof,
              G.representative graph equality)
            andalso Portable.pointer_eq(left,G.representative graph source)
            andalso Portable.pointer_eq(right,G.representative graph target)
          then () else
            raise ERR "policy_conversion" "not a closed canonical equality"
        val maximum= #template_limit(W.semantic_policy expected)
        val _=pp_realized_guard expected block contract
        val answer={graph=graph,root= #root data,scope=scope,
          sources= #sources data,frame=frame,equality=equality,
          source=source,target=target,template_policy=maximum,
          native_contract=contract}
        val _=pr_keep_realized_data expected saved answer
      in answer end
      in case pr_lookup_realized_data expected saved
          graph scope frame contract of
          NONE=>acquire()
        | SOME answer=>
            let val maximum= #template_limit(W.semantic_policy expected)
                val _=if #root answer= #root data andalso
                    Portable.pointer_eq(#sources answer,#sources data)
                    andalso #equality answer=equality andalso
                    #template_policy answer=maximum then ()else
                  raise ERR "policy_conversion" "completed data changed"
                val _=pp_realized_guard expected block contract
            in answer end end)
     handle primary=>(W.close expected;raise primary)))

  fun conversion_from_policy_source_realization_for expected receipt =
    ((let
        val data=policy_source_realization_data_for expected receipt
        val proof=policy_source_realization_theorem_for expected receipt
        fun guard ()=
          ignore(policy_source_realization_data_for expected receipt)
      in PolicyRealizedConversion {work=expected,graph= #graph data,
          scope= #scope data,source= #source data,target= #target data,
          theorem=proof,template_limit= #template_policy data,guard=guard}
      end)
     handle primary=>(W.close expected;raise primary))

  (* Retain actual closed canonical proofs from genuine realization or
     admitted saved-alpha plans. Neither accepts a theorem/node pair. *)
  fun policy_source_realization_closed_fact_for expected receipt =
    ((let
        val data=policy_source_realization_data_for expected receipt
        val proof=policy_source_realization_theorem_for expected receipt
        fun guard ()=
          ignore(policy_source_realization_data_for expected receipt)
      in PolicyRealizedClosedFact {work=expected,graph= #graph data,
          scope= #scope data,node= #equality data,theorem=proof,
          template_limit= #template_policy data,guard=guard} end)
     handle primary=>(W.close expected;raise primary))

  (* Completed clean proofs no longer depend on their consumed derivation
     tables. Retain the genuine output DAG's lexical paths instead. No
     opaque native body is traversed or reconstructed by this exporter. *)
  fun completed_policy_source_realization_closed_fact_for expected
      (receipt as PolicySourceRealization {work,...}) =
    ((if Portable.pointer_eq(expected,work) then () else
        raise ERR "completed_closed" "different original Work";
      let
        val data=policy_source_realization_data_for expected receipt
        val proof=policy_source_realization_theorem_for expected receipt
        val PolicySourceRealization {sources,epoch,symbols,...}=receipt
        val _=if null sources then () else
          raise ERR "completed_closed" "Source-free realization required"
      in if not(W.ordinary_policy_guard_mode expected) then
          policy_source_realization_closed_fact_for expected receipt
        else W.with_step expected (fn()=>
          let
            val graph= #graph data val scope= #scope data
            val frame= #frame data val contract= #native_contract data
            val source_owner= #sources data val root= #root data
            val node= #equality data val source= #source data
            val target= #target data val maximum= #template_policy data
            val canonical=Thm.concl proof
            fun pay()=W.spend_ordinary_guard_policy expected 1
            fun owner()=
              let
                val _=SmtReplayNativeContract.validate_for expected contract
                val actual=Scope.description_with_policy_for expected frame
                val _=pay()
              in if Portable.pointer_eq(#graph actual,graph) andalso
                  #root actual=root andalso #scope actual=scope andalso
                  Portable.pointer_eq(#sources actual,source_owner) andalso
                  #template_limit(#limits actual)=maximum andalso
                  epoch=Type.type_epoch() andalso symbols=Term.term_epoch()
                then () else raise ERR "completed_closed"
                  "actual completed owner or epoch changed" end
            val held=ref([]:(G.scope*G.node*G.closure_child)list)
            val binders=ref([]:(G.scope*G.binder_closure)list)
            fun compare((a,b),(c,d))=
              (pay();case Int.compare(a,c) of
                 EQUAL=>Int.compare(b,d) | order=>order)
            val seen=ref(Redblackset.empty compare)
            fun inventory []=()
              | inventory((caller,current)::rest)=
                let
                  val _=owner()
                  val child=G.closure_root graph caller current
                  val _=pay()
                  val key=(G.scope_id caller,G.node_id current)
                in if Redblackset.member(!seen,key) then inventory rest else
                  let
                    val _=seen:=Redblackset.add(!seen,key)
                    val _=held:=(caller,current,child):: !held
                    val _=pay()
                    val children=case G.view graph current of
                        G.Application(left,right)=>
                          [(caller,left),(caller,right)]
                      | G.AdmittedBinder _=>
                          let val closure=G.closure_child_binder graph caller
                                child
                              val actual=G.binder_closure_data graph caller
                                closure
                              val _=binders:=(caller,closure):: !binders
                          in [(#body_frame actual,#binder actual),
                              (#body_frame actual,#body actual)] end
                      | _=>[]
                  in inventory(children @ rest)end
                end
            val _=inventory[(scope,node),(scope,source),(scope,target)]
            val paths=List.rev(!held) val closures=List.rev(!binders)
            fun guard()=
              ((owner();
                List.app(fn(caller,current,child)=>
                  (pay();if G.closure_child_node graph caller child=current
                    then () else raise ERR "completed_closed"
                      "actual output child changed"))paths;
                List.app(fn(caller,closure)=>
                  (pay();ignore(G.binder_closure_data graph caller closure)))
                  closures;
                pay();
                if HOLset.numItems(Thm.hypset proof)=0 andalso clean proof
                    andalso Portable.pointer_eq(Thm.concl proof,canonical)
                    andalso Portable.pointer_eq(canonical,
                      G.representative graph node) andalso
                    Type.compare(G.type_of graph node,Type.bool)=EQUAL
                  then () else raise ERR "completed_closed"
                    "closed canonical output changed";
                owner())handle primary=>(W.close expected;raise primary))
            val _=guard()
          in PolicyRealizedClosedFact{work=expected,graph=graph,scope=scope,
            node=node,theorem=proof,template_limit=maximum,guard=guard}end)
      end)handle primary=>(W.close expected;raise primary))

  (* Receipt ports supply BOTH endpoints and the authentic requester.
     Caller profiles are genuine opaque DATA, not bounds or permission. *)
  fun policy_source_realization_generated_equality_for expected receipt
      {profiles} =
    ((let
        val data=policy_source_realization_data_for expected receipt
        val graph= #graph data val scope= #scope data
        val maximum= #template_policy data
        val fact=policy_source_realization_closed_fact_for expected receipt
        val metric=G.prepare_scoped_profiled_metric graph scope
          {node= #target data,profiles=profiles}
        val actual=G.profiled_metric_data graph scope metric
        val _=if #node actual= #target data then () else
          raise ERR "generated_receipt" "different actual target capture"
        val _=pcf_for expected fact
        val saved=ScopedGeneratedEquality {graph=graph,scope=scope,
          maximum=maximum,fact=fact,source= #source data,
          target= #target data,metric=metric,profiles=profiles}
        val _=ignore(scoped_generated_equality_for graph scope maximum saved)
      in saved end)
     handle primary=>(W.close expected;raise primary))

  (* The genuine views remain mandatory; a profile does not supply one.
     Only the collector changes. The existing typed recorder is proof-pure. *)
  fun record_typed_conversion_with_policy_scoped_profiles graph scope
      {source,source_view,target,target_view,theorem,template_limit,
       check_type,profiles} =
    let val(query,guard,captures,types)=
          pg_scoped_metric_collector graph scope profiles
    in pc_record_conversion_program query guard captures types true graph scope
      {source=source,source_view=source_view,target=target,
       target_view=target_view,theorem=theorem,template_limit=template_limit,
       check_type=check_type} end

  (* Fixed compact local discharge. Both contexts are authentic same-Work
     Blocks; original Source occurrences are never selected or reordered.
     All proof instructions are modelled before the first callback/rule. *)
  fun discharge_sources_with_policy expected
      (old as Block {graph,scope,nodes,leaves,tree,context,source_count,
        owned_frame,...})
      {indices,body,edge,ordinal,check_type} =
    ((let val(owner,native)=pp_owner expected old
          val contract= #contract owner
      in W.with_step expected (fn()=>
      let
        fun pay n=W.spend_policy expected n
        fun tick ()=pay 1
        fun valid ()=ignore(pp_owner expected old)
        val _=valid ()
        val frame=case owned_frame of SOME(_,saved)=>saved
          | NONE=>raise ERR "policy_local_discharge" "unowned old frame"
        val data=Scope.description_with_policy_for expected frame
        val originals=W.original_sources expected
        val _=if Portable.pointer_eq(#sources data,originals)andalso
            Portable.pointer_eq(#graph data,graph)andalso #scope data=scope
          then ()else raise ERR "policy_local_discharge"
            "different original Source frame"
        val prefix=SmtReplaySource.assumption_nodes originals @
          [SmtReplaySource.denied_goal_node originals]
        val prefix_count=List.length prefix
        fun slots index=if index=source_count then []else
          (pay 2;case Vector.sub(leaves,index)of Source node=>
             node::slots(index+1)|_=>raise ERR "policy_local_discharge"
               "actual Source slot is not a Source")
        val original_slots=slots 0
        val _=if source_count>=prefix_count andalso
            List.take(original_slots,prefix_count)=prefix then ()else
          raise ERR "policy_local_discharge" "original Source prefix changed"
        fun selected index=
          (tick ();if index>=prefix_count andalso index<source_count then
             case Vector.sub(leaves,index)of Source node=>node
               | _=>raise ERR "policy_local_discharge" "not a local Source"
           else raise ERR "policy_local_discharge"
             "only actual extra Source occurrences may be discharged")
        val selected_nodes=List.map selected indices
        fun local_slot index=List.exists(fn wanted=>
          (tick ();wanted=index))indices
        val retained=List.map #2(List.filter(fn(index,_)=>
          not(local_slot index))(ListPair.zip
            (List.tabulate(source_count,Lib.I),original_slots)))
        val extras=List.drop(retained,prefix_count)
        val proof=theorem old edge
        val body_name=name old body
        val _=if Portable.pointer_eq(Thm.concl proof,body_name)andalso
            clean proof andalso List.all(fn hyp=>
              Portable.pointer_eq(hyp,context))(Thm.hyp proof)then ()else
          raise ERR "policy_local_discharge" "incorrect compact body proof"
        val implication=G.constant graph scope boolSyntax.implication
        datatype chain=End of G.node|Implication of G.node*G.node*chain
        fun endpoint(End node)=node
          | endpoint(Implication(node,_,_))=node
        fun discover []=End body
          | discover(node::rest)=
              let val _=pay 3 val tail=discover rest
                  val root=G.application graph scope
                    (G.application graph scope(implication,node),endpoint tail)
              in Implication(root,node,tail)end
        val chain=discover selected_nodes val target=endpoint chain
        val definitions=Vector.foldr
          (fn(Definition(node,_),rest)=>(pay 2;node::rest)
            |(_,rest)=>(tick ();rest))[]leaves
        val facts=Vector.foldr
          (fn(ClosedWitness fact,rest)=>(pay 2;fact::rest)
            |(_,rest)=>(tick ();rest))[]leaves
        val conversions=Vector.foldr
          (fn(ConversionWitness value,rest)=>(pay 2;value::rest)
            |(_,rest)=>(tick ();rest))[]leaves
        (* This is the sole genuine Source producer. It prepends the SAME
           actual ordered originals itself, not a caller supplied prefix. *)
        val frontier=pr_prepare_frontier true true extras expected
          {frame=frame,roots=target::definitions,closed_facts=facts,
           conversions=conversions}
        val tables=prepare_owned_realization_tables_with_policy
          expected frontier
        val freeze=prepare_native_realization_freeze_with_policy expected
          {tables=tables,contract=contract,profiles=[],ordinal=ordinal,
           check_type=check_type}
        val PRNativeFreezePlan {compact=next_size,...}=freeze
        val PRRealizationTables {names=PRFixedNames
          {strings,types,held,epoch,symbols,validated_revision,...},...}=tables
        val _=W.spend_policy expected 1
        val future_names=FixedNames {work=expected,graph=graph,scope=scope,
          frame=frame,strings=SOME strings,types=types,held=held,epoch=epoch,
          symbols=symbols,validated_revision=validated_revision}
        val inspect=pp_inspector expected old native
        val cap= #cap inspect val ceiling= #ceiling inspect
        val bool_weight=pp_type_weight expected ceiling Type.bool
        datatype expression=Held of Term.term|Named of G.node|NextContext
          | App of expression*expression|Equation of expression*expression
          | Imp of expression*expression|Conj of expression*expression
        datatype hypothesis=NextHyp|OldHyp|LocalHyp of G.node
        type model={expression:expression,value:primitive_profile,
          ty:Type.hol_type,hypotheses:hypothesis list}
        fun weight(p:primitive_profile)= #raw p+ #inc p+ #ann p
        val size_memo=ref([]:
          (expression*(primitive_profile*Type.hol_type))list)
        fun profile expr=
          (tick ();case List.find(fn(saved,_)=>
             (tick ();Portable.pointer_eq(expr,saved)))(!size_memo)of
           SOME(_,value)=>value|NONE=>
           let val value=case expr of
            Held term=>(#profile inspect term,Term.type_of term)
          | Named node=>
              let val ty=G.type_of graph node
                  val n=pp_type_weight expected ceiling ty
              in ({raw=1,inc=1,ann=n,ty=n}:primitive_profile,ty)end
          | NextContext=>
              ({raw= #raw next_size,inc= #inc next_size,
                ann= #ann next_size,ty=bool_weight}:primitive_profile,
               Type.bool)
          | App(a,b)=>
              let val(x,ty)=profile a val(y,_)=profile b
                  val range= #2(Type.dom_rng ty)
                  val own=pp_type_weight expected ceiling range
              in ({raw=1+ #raw x+ #raw y,inc=1+ #inc x+ #inc y,
                   ann=own+ #ann x+ #ann y,ty=own}:primitive_profile,
                  range)end
          | Equation(a,b)=>
              let val(x,_)=profile a val(y,_)=profile b
              in ({raw=3+ #raw x+ #raw y,inc=3+ #inc x+ #inc y,
                   ann=6+3* #ty x+ #ann x+ #ann y,
                   ty=bool_weight}:primitive_profile,Type.bool)end
          | Imp(a,b)=>profile(App(App(Held boolSyntax.implication,a),b))
          | Conj(a,b)=>profile(App(App(Held boolSyntax.conjunction,a),b))
               val _=size_memo:=(expr,value):: !size_memo
           in value end)
        fun same_hyp(NextHyp,NextHyp)=true
          | same_hyp(OldHyp,OldHyp)=true
          | same_hyp(LocalHyp a,LocalHyp b)=a=b|same_hyp _=false
        fun union first second=List.foldl(fn(value,values)=>
          if List.exists(fn held=>(tick ();same_hyp(value,held)))values then
            values else value::values)first second
        fun hyp_expr NextHyp=NextContext|hyp_expr OldHyp=Held context
          | hyp_expr(LocalHyp node)=Named node
        fun admit(p:primitive_profile)=
          if #raw p<=cap andalso #inc p<=cap andalso #ann p<=ceiling
            then ()else raise ERR "policy_local_discharge"
              "actual compact native operand/result exceeds caller cap"
        datatype operation=Input of Thm.thm
          | SourceProjection of int|DefinitionProjection of G.node
          | ClosedProjection of closed_fact
          | ConversionProjection of closed_conversion
          | AssumeLocal of G.node|Discharge of expression*int
          | Modus of int*int|Join of int*int|Reflexive of expression
          | Reverse of int|Compose of int*int|EqualityApply of int*int
          | OperatorApply of expression*int|ArgumentApply of int*expression
        val programme=ref([]:(operation*model)list)
        val count=ref 0
        fun emit operation expression hypotheses operands=
          let val(p,ty)=profile expression val _=admit p
              fun add_hyp(hyp,total)=
                let val(v,_)=profile(hyp_expr hyp)val _=admit v
                in total+weight v end
              val _=List.app(fn({value,...}:model)=>admit value)operands
              (* Match the existing fixed primitive's incoming Hyp
                 portfolio: a shared NextHyp is counted once PER premise,
                 before native union or DISCH removes it. ASSUME also
                 introduces a real new Hyp absent from its empty inputs. *)
              val incoming=List.concat(List.map
                (fn(value:model)=>(tick ();#hypotheses value))operands)
              val introduced=List.filter(fn value=>not(List.exists
                (fn held=>(tick ();same_hyp(value,held)))incoming))hypotheses
              val measured=incoming @ introduced
              val total=List.foldl add_hyp(1+weight p)measured
              val _=if total<=ceiling then ()else
                raise ERR "policy_local_discharge"
                  "actual compact result/Hyp/Type portfolio exceeded"
              val amount=IntInf.fromInt(List.length measured)
              val native_rule=case operation of Input _=>false
                | SourceProjection _=>false|DefinitionProjection _=>false
                | ClosedProjection _=>false|ConversionProjection _=>false
                | _=>true
              val _=if native_rule then
                pp_future expected(total+amount*(amount+2)+20)else tick ()
              val model={expression=expression,value=p,ty=ty,
                         hypotheses=hypotheses}:model
              val index= !count val _=count:=index+1
              val _=programme:=(operation,model):: !programme
          in (index,model)end
        fun expr(_,model:model)= #expression model
        fun hyp(_,model:model)= #hypotheses model
        fun id(index,_)=index
        fun models(a: int*model,b: int*model)=[#2 a,#2 b]
        val initial=emit(Input proof)(Held body_name)
          (if null(Thm.hyp proof)then []else[OldHyp])[]
        fun discharge antecedent selected incoming=
          let val remaining=List.filter(fn h=>not(same_hyp(h,selected)))
                (hyp incoming)
          in emit(Discharge(antecedent,id incoming))
            (Imp(antecedent,expr incoming))remaining[#2 incoming]end
        val law=discharge(Held context)OldHyp initial
        fun position index=
          let fun count_before current total=if current=index then total else
                count_before(current+1)
                  (if local_slot current then total else total+1)
          in count_before 0 0 end
        fun witness(index,Source node)=
              if local_slot index then
                emit(AssumeLocal node)(Named node)[LocalHyp node][]
              else emit(SourceProjection(position index))(Named node)
                [NextHyp][]
          | witness(_,Definition(node,rhs))=
              emit(DefinitionProjection node)(Equation(Named node,Held rhs))
                [NextHyp][]
          | witness(_,ClosedWitness fact)=
              emit(ClosedProjection fact)(Named(closed_node fact))[NextHyp][]
          | witness(_,ConversionWitness plan)=
              emit(ConversionProjection plan)
                (Equation(Named(conversion_source plan),
                          Named(conversion_target plan)))[NextHyp][]
        val witnesses=Vector.mapi witness leaves
        fun rebuild Empty=emit(Input boolTheory.TRUTH)(Held boolSyntax.T)[][]
          | rebuild(Leaf index)=Vector.sub(witnesses,index)
          | rebuild(Split(left,right))=
              let val a=rebuild left val b=rebuild right
              in emit(Join(id a,id b))(Conj(expr a,expr b))
                (union(hyp a)(hyp b))(models(a,b))end
        fun mp antecedent consequent a b=
          emit(Modus(id a,id b))consequent(union(hyp a)(hyp b))(models(a,b))
        val rebuilt=rebuild tree
        val fact=mp(Held context)(Held body_name)law rebuilt
        val discharged=List.foldr(fn(node,fact)=>
          discharge(Named node)(LocalHyp node)fact)fact selected_nodes
        fun reverse incoming=case expr incoming of Equation(a,b)=>
              emit(Reverse(id incoming))(Equation(b,a))(hyp incoming)
                [#2 incoming]
          | _=>raise ERR "policy_local_discharge" "bad symmetry model"
        fun compose a b=case(expr a,expr b)of
            (Equation(left,_),Equation(_,right))=>
              emit(Compose(id a,id b))(Equation(left,right))
                (union(hyp a)(hyp b))(models(a,b))
          | _=>raise ERR "policy_local_discharge" "bad transitivity model"
        fun reflexive term=emit(Reflexive term)(Equation(term,term))[][]
        fun constructor node=case G.view graph node of
            G.Constant _=>emit(DefinitionProjection node)
              (Equation(Named node,Held(G.representative graph node)))
              [NextHyp][]
          | G.Application(operator,operand)=>
              let val direct=emit(DefinitionProjection node)
                    (Equation(Named node,App(Named operator,Named operand)))
                    [NextHyp][]
                  val parent=constructor operator
                  val applied=case expr parent of Equation(a,b)=>
                    emit(ArgumentApply(id parent,Named operand))
                      (Equation(App(a,Named operand),App(b,Named operand)))
                      (hyp parent)[#2 parent]
                    | _=>raise ERR "policy_local_discharge" "bad application"
              in compose direct applied end
          | _=>reflexive(Named node)
        fun bridge(End node)=reflexive(Named node)
          | bridge(Implication(node,antecedent,tail))=
              let val a=constructor node val b=bridge tail
                  val operator=App(Held boolSyntax.implication,Named antecedent)
                  val applied=case expr b of Equation(left,right)=>
                      emit(OperatorApply(operator,id b))
                        (Equation(App(operator,left),App(operator,right)))
                        (hyp b)[#2 b]
                    | _=>raise ERR "policy_local_discharge" "bad bridge model"
              in compose a applied end
        val equation=reverse(bridge chain)
        val output=emit(EqualityApply(id equation,id discharged))(Named target)
          (union(hyp equation)(hyp discharged))(models(equation,discharged))
        val _=if List.all(fn h=>same_hyp(h,NextHyp))(hyp output)then ()else
          raise ERR "policy_local_discharge" "local hypothesis survived model"
        (* Check every OLD placeholder against the actual next naming plan
           before its callbacks; no fresh caller names are admitted. *)
        fun check_term term=
          (tick ();if Term.is_var term then
            if pp_name_member expected ceiling future_names term then ()else
              raise ERR "policy_local_discharge" "needed old name is missing"
          else if Term.is_comb term then
            let val(a,b)=Term.dest_comb term in check_term a;check_term b end
          else if Term.is_const term then ()else
            raise ERR "policy_local_discharge" "binder in compact operand")
        val _=check_term context val _=check_term(Thm.concl proof)
        val _=valid ()
        val next=freeze_owned_realization_tables_with_policy expected freeze
        val _=valid ()
        val _=if sources next=retained then ()else
          raise ERR "policy_local_discharge" "retained Source order changed"
        val Block {context=next_context,owner=next_owner,
          leaves=next_leaves,...}=next
        fun render term=case term of Held value=>value
          | Named node=>name next node|NextContext=>next_context
          | App(a,b)=>Term.mk_comb(render a,render b)
          | Equation(a,b)=>boolSyntax.mk_eq(render a,render b)
          | Imp(a,b)=>boolSyntax.mk_imp(render a,render b)
          | Conj(a,b)=>boolSyntax.mk_conj(render a,render b)
        val results=Array.array(!count,boolTheory.TRUTH)
        fun get index=Array.sub(results,index)
        fun execute(index,(operation,model:model))=
          let val _=valid ()val _=ignore(pp_owner expected next)
              val result=case operation of Input proof=>proof
                | SourceProjection n=>theorem next(source next n)
                | DefinitionProjection node=>theorem next(definition next node)
                | ClosedProjection fact=>theorem next(closed next fact)
                | ConversionProjection plan=>theorem next(conversion next plan)
                | AssumeLocal node=>
                    SmtReplayRuleObservation.ASSUME(name next node)
                | Discharge(term,n)=>SmtReplayRuleObservation.DISCH
                    (render term)(get n)
                | Modus(a,b)=>SmtReplayRuleObservation.MP(get a)(get b)
                | Join(a,b)=>SmtReplayRuleObservation.CONJ(get a)(get b)
                | Reflexive term=>SmtReplayRuleObservation.REFL(render term)
                | Reverse n=>SmtReplayRuleObservation.SYM(get n)
                | Compose(a,b)=>SmtReplayRuleObservation.TRANS(get a)(get b)
                | EqualityApply(a,b)=>
                    SmtReplayRuleObservation.EQ_MP(get a)(get b)
                | OperatorApply(term,n)=>SmtReplayRuleObservation.AP_TERM
                    (render term)(get n)
                | ArgumentApply(n,term)=>SmtReplayRuleObservation.AP_THM
                    (get n)(render term)
              val _=if clean result then ()else
                raise ERR "policy_local_discharge"
                  "fixed programme tags changed"
              val _=Array.update(results,index,result)
              val _=valid ()val _=ignore(pp_owner expected next)
          in ()end
        val _=List.app execute(ListPair.zip
          (List.tabulate(!count,Lib.I),List.rev(!programme)))
        val result=get(id output)
        val _=if Portable.pointer_eq(Thm.concl result,name next target)andalso
            List.all(fn hyp=>Portable.pointer_eq(hyp,next_context))
              (Thm.hyp result)then ()else
          raise ERR "policy_local_discharge" "actual compact result/Hyp changed"
        val dependency=new_dependency next
          (Leaves(List.tabulate(Vector.length next_leaves,Lib.I)))
        val _=valid ()val _=ignore(pp_owner expected next)
        val _=retire_block old
      in {block=next,target=target,
        edge=Edge {owner=next_owner,theorem=result,dependencies=dependency,
          primitive=NONE}}end)
      end)
     handle primary=>(W.close expected;raise primary))

  (* Join only genuine compact proofs. Both original prefixes are checked;
     no theorem with surviving original Hyp is reclassified as closed. *)
  fun join_blocks_with_policy expected
      {left={block=left,body=left_body,edge=left_edge},
       right={block=right,body=right_body,edge=right_edge},
       ordinal,check_type} =
    ((let
      fun header(Block{owned_frame,nodes,...})=
        let val frame=case owned_frame of SOME(work,frame)=>
              if Portable.pointer_eq(expected,work)then frame else
                raise ERR "policy_block_join" "different original Work"
            | NONE=>raise ERR "policy_block_join" "unowned proof block"
            val contract=case nodes of PolicyFixedTable{work,contract,...}=>
              if Portable.pointer_eq(expected,work)then contract else
                raise ERR "policy_block_join" "different table Work"
            | _=>raise ERR "policy_block_join" "not a policy native block"
        in(frame,contract)end
      val(left_frame,contract)=header left
      val(right_frame,right_contract)=header right
      val _=if Portable.pointer_eq(contract,right_contract)andalso
          Portable.pointer_eq(left_frame,right_frame)then ()else
        raise ERR "policy_block_join" "different native contract or frame"
      val(owner,native)=pp_owner expected left
      val _=ignore(pp_owner expected right)
    in W.with_step expected(fn()=>
      let
        fun pay n=W.spend_policy expected n
        fun tick()=pay 1
        fun valid()=(ignore(pp_owner expected left);
          ignore(pp_owner expected right))
        val _=valid()
        (* Prepay the final alias check; each block funds one retirement. *)
        val _=pay 1
        val graph= #graph owner val scope= #scope owner
        val originals=W.original_sources expected
        val prefix=SmtReplaySource.assumption_nodes originals @
          [SmtReplaySource.denied_goal_node originals]
        val prefix_count=List.length prefix
        fun source_rows(Block{graph=held,scope=where_,source_count,
            leaves,...})=
          let val _=if Portable.pointer_eq(graph,held)andalso scope=where_
                then ()else raise ERR "policy_block_join"
                  "different actual graph or Scope"
              fun rows index=if index=source_count then []else
                (tick();case Vector.sub(leaves,index)of Source node=>
                  node::rows(index+1)|_=>raise ERR "policy_block_join"
                    "actual Source slot is not a Source")
              val nodes=rows 0
              val _=if source_count>=prefix_count andalso
                  List.take(nodes,prefix_count)=prefix then ()else
                raise ERR "policy_block_join" "original Source prefix changed"
          in nodes end
        val left_sources=source_rows left
        val right_sources=source_rows right
        val left_extra=List.drop(left_sources,prefix_count)
        val left_extra_count=List.length left_extra
        val extras=left_extra @ List.drop(right_sources,prefix_count)
        val data=Scope.description_with_policy_for expected left_frame
        val _=if Portable.pointer_eq(#graph data,graph)andalso
            #scope data=scope andalso
            Portable.pointer_eq(#sources data,originals)then ()else
          raise ERR "policy_block_join" "different original Source frame"
        fun leaves_of(Block{leaves,...})=leaves
        val all_leaves=Vector.concat[leaves_of left,leaves_of right]
        val definitions=Vector.foldr
          (fn(Definition(node,_),rest)=>(tick();node::rest)
            |(_,rest)=>(tick();rest))[]all_leaves
        val facts=Vector.foldr
          (fn(ClosedWitness fact,rest)=>(tick();fact::rest)
            |(_,rest)=>(tick();rest))[]all_leaves
        val conversions=Vector.foldr
          (fn(ConversionWitness value,rest)=>(tick();value::rest)
            |(_,rest)=>(tick();rest))[]all_leaves
        val frontier=pr_prepare_frontier true true extras expected
          {frame=left_frame,roots=left_body::right_body::definitions,
           closed_facts=facts,conversions=conversions}
        val tables=prepare_owned_realization_tables_with_policy
          expected frontier
        val freeze=prepare_native_realization_freeze_with_policy expected
          {tables=tables,contract=contract,profiles=[],ordinal=ordinal,
           check_type=check_type}
        val PRNativeFreezePlan{compact=next_size,...}=freeze
        val PRRealizationTables{names=PRFixedNames
          {strings,types,held,epoch,symbols,validated_revision,...},...}=tables
        val _=W.spend_policy expected 1
        val future_names=FixedNames{work=expected,graph=graph,scope=scope,
          frame=left_frame,strings=SOME strings,types=types,held=held,epoch=epoch,
          symbols=symbols,validated_revision=validated_revision}
        (* This closure is compiled privately from one genuine old Block.
           It accepts no caller instruction or proof-producing callback. *)
        fun prepare old body edge source_index=
          let val Block{context,leaves,tree,...}=old
              val inspect=pp_inspector expected old native
              val cap= #cap inspect val ceiling= #ceiling inspect
              val proof=theorem old edge val old_name=name old body
              val _=if Portable.pointer_eq(Thm.concl proof,old_name)andalso
                  clean proof andalso List.all(fn hyp=>
                    Portable.pointer_eq(hyp,context))(Thm.hyp proof)
                then ()else raise ERR "policy_block_join"
                  "incorrect compact input proof"
              val old_context= #profile inspect context
              val new_context:primitive_profile=
                {raw= #raw next_size,inc= #inc next_size,
                 ann= #ann next_size,ty=1}
              fun named node=
                let val n=pp_type_weight expected ceiling(G.type_of graph node)
                in{raw=1,inc=1,ann=n,ty=n}:primitive_profile end
              fun equation(a:primitive_profile)(b:primitive_profile)=
                {raw=3+ #raw a+ #raw b,inc=3+ #inc a+ #inc b,
                 ann=6+3* #ty a+ #ann a+ #ann b,ty=1}:primitive_profile
              fun binary(a:primitive_profile)(b:primitive_profile)=
                {raw=3+ #raw a+ #raw b,inc=3+ #inc a+ #inc b,
                 ann=9+ #ann a+ #ann b,ty=1}:primitive_profile
              fun weight(p:primitive_profile)= #raw p+ #inc p+ #ann p
              fun admit(p:primitive_profile)=
                if #raw p<=cap andalso #inc p<=cap andalso #ann p<=ceiling
                  then ()else raise ERR "policy_block_join"
                    "compact operand/result exceeds native contract"
              datatype hypothesis=Old|Next
              type model={value:primitive_profile,hyp:hypothesis list}
              datatype operation=Input of Thm.thm|DropContext of int
                | SourceProjection of int|DefinitionProjection of G.node
                | ClosedProjection of closed_fact
                | ConversionProjection of closed_conversion
                | Join of int*int|Modus of int*int|Reflexive of G.node
                | EqualityApply of int*int
              val programme=ref([]:(operation*model)list)
              val count=ref 0
              fun emit operation value hypotheses operands=
                let val _=admit value
                    val _=List.app(fn({value,...}:model)=>admit value)operands
                    val incoming=List.concat(List.map
                      (fn(value:model)=>(tick();#hyp value))operands)
                    val added=List.filter(fn value=>not(List.exists
                      (fn held=>(tick();held=value))incoming))hypotheses
                    val measured=incoming @ added
                    fun add(h,total)=
                      let val p=case h of Old=>old_context|Next=>new_context
                          val _=admit p
                      in total+weight p end
                    val total=List.foldl add(1+weight value)measured
                    val _=if total<=ceiling then ()else
                      raise ERR "policy_block_join"
                        "compact native result/Hyp/Type exceeds contract"
                    val native_rule=case operation of Input _=>false
                      | SourceProjection _=>false|DefinitionProjection _=>false
                      | ClosedProjection _=>false
                      | ConversionProjection _=>false|_=>true
                    val n=IntInf.fromInt(List.length measured)
                    val _=if native_rule then
                        pp_future expected(total+n*(n+2)+20)else tick()
                    val index= !count val _=count:=index+1
                    val model={value=value,hyp=hypotheses}:model
                    val _=programme:=(operation,model):: !programme
                in(index,model)end
              fun id(index,_)=index
              fun value(_,model:model)= #value model
              fun hyps(_,model:model)= #hyp model
              fun union a b=if null(hyps a)andalso null(hyps b)then []
                else[Next]
              fun inputs(a:int*model,b:int*model)=[#2 a,#2 b]
              val initial=emit(Input proof)(#profile inspect old_name)
                (if null(Thm.hyp proof)then []else[Old])[]
              val law=emit(DropContext(id initial))
                (binary old_context(value initial))[][#2 initial]
              fun witness(index,Source node)=
                    emit(SourceProjection(source_index index))(named node)
                      [Next][]
                | witness(_,Definition(node,rhs))=
                    emit(DefinitionProjection node)
                      (equation(named node)(#profile inspect rhs))[Next][]
                | witness(_,ClosedWitness fact)=
                    emit(ClosedProjection fact)(named(closed_node fact))
                      [Next][]
                | witness(_,ConversionWitness plan)=
                    emit(ConversionProjection plan)
                      (equation(named(conversion_source plan))
                        (named(conversion_target plan)))[Next][]
              val witnesses=Vector.mapi witness leaves
              fun rebuild Empty=emit(Input boolTheory.TRUTH)
                    (#profile inspect boolSyntax.T)[][]
                | rebuild(Leaf index)=Vector.sub(witnesses,index)
                | rebuild(Split(left,right))=
                    let val a=rebuild left val b=rebuild right
                    in emit(Join(id a,id b))(binary(value a)(value b))
                      (union a b)(inputs(a,b))end
              val rebuilt=rebuild tree
              val transported=emit(Modus(id law,id rebuilt))(value initial)
                (union law rebuilt)(inputs(law,rebuilt))
              val refl=emit(Reflexive body)
                (equation(named body)(named body))[][]
              val output=emit(EqualityApply(id refl,id transported))
                (named body)(union refl transported)(inputs(refl,transported))
              fun check term=
                (tick();if Term.is_var term then
                   if pp_name_member expected ceiling future_names term
                     then ()else raise ERR "policy_block_join"
                       "needed old placeholder is missing"
                 else if Term.is_comb term then
                   let val(a,b)=Term.dest_comb term in check a;check b end
                 else if Term.is_const term then ()else
                   raise ERR "policy_block_join" "binder in compact operand")
              val _=check context val _=check old_name
              fun execute next=
                let val results=Array.array(!count,boolTheory.TRUTH)
                    fun get index=Array.sub(results,index)
                    fun step(index,(operation,_:model))=
                      let val _=valid()val _=ignore(pp_owner expected next)
                          val result=case operation of Input proof=>proof
                            | DropContext n=>SmtReplayRuleObservation.DISCH
                                context(get n)
                            | SourceProjection n=>theorem next(source next n)
                            | DefinitionProjection n=>
                                theorem next(definition next n)
                            | ClosedProjection fact=>
                                theorem next(closed next fact)
                            | ConversionProjection plan=>
                                theorem next(conversion next plan)
                            | Join(a,b)=>SmtReplayRuleObservation.CONJ
                                (get a)(get b)
                            | Modus(a,b)=>SmtReplayRuleObservation.MP
                                (get a)(get b)
                            | Reflexive node=>SmtReplayRuleObservation.REFL
                                (name next node)
                            | EqualityApply(a,b)=>
                                SmtReplayRuleObservation.EQ_MP(get a)(get b)
                          val _=if clean result then ()else
                            raise ERR "policy_block_join" "proof tags changed"
                          val _=Array.update(results,index,result)
                          val _=valid()val _=ignore(pp_owner expected next)
                      in ()end
                    val _=List.app step(ListPair.zip
                      (List.tabulate(!count,Lib.I),List.rev(!programme)))
                    val result=get(id output)
                    val Block{context=next_context,...}=next
                    val _=if Portable.pointer_eq(Thm.concl result,
                        name next body)andalso List.all(fn hyp=>
                          Portable.pointer_eq(hyp,next_context))(Thm.hyp result)
                      then ()else raise ERR "policy_block_join"
                        "actual compact result/Hyp changed"
                in result end
          in execute end
        val run_left=prepare left left_body left_edge Lib.I
        fun right_index index=if index<prefix_count then index
          else index+left_extra_count
        val run_right=prepare right right_body right_edge right_index
        val _=valid()
        val next=freeze_owned_realization_tables_with_policy expected freeze
        val _=if sources next=prefix @ extras then ()else
          raise ERR "policy_block_join" "combined Source occurrences changed"
        val a=run_left next val b=run_right next
        val Block{owner=next_owner,leaves=next_leaves,...}=next
        fun publish proof=Edge{owner=next_owner,theorem=proof,primitive=NONE,
          dependencies=new_dependency next
            (Leaves(List.tabulate(Vector.length next_leaves,Lib.I)))}
        val a=publish a val b=publish b
        val _=valid()val _=ignore(pp_owner expected next)
        val Block{realized=left_used,...}=left
        val Block{realized=right_used,...}=right
        val _=retire_block left
        val _=if left_used=right_used then () else retire_block right
      in{block=next,left=a,right=b}end)
    end)handle primary=>(W.close expected;raise primary))

  (* A fixed native local law, not replay of an arbitrary worker callback.
     The actual Block grants ownership, never a replacement native budget.
     Its expanded Source hypotheses are not passed to the native programme. *)
  datatype policy_local_specialize_plan = PolicyLocalSpecializePlan of
    {work:W.portfolio,block:block,contract:SmtReplayNativeContract.contract,
     frame:Scope.receipt,graph:G.graph,scope:G.scope,
     sources:SmtReplaySource.sources,source:G.node,target:G.node,
     law:G.node,arguments:Term.term list,expected:Term.term list,
     metrics:(G.node * SmtReplayLocalSpecialize.metric) list,
     ports:(G.node * Term.term) list,epoch:int,symbols:int,
     check_type:Type.hol_type -> unit,types:Type.hol_type list,
     used:bool ref}

  fun prepare_local_specialize_internal work block
      {source,edge,arguments,target,profiles,check_type} =
    ((let
        val (owner,native)=pp_owner work block
        val _=W.spend_policy work 0
        val graph= #graph owner val scope= #scope owner
        val contract= #contract owner
        val Block{owned_frame,...}=block
        val frame=case owned_frame of SOME(_,held)=>held
          | NONE=>raise ERR "policy_local_specialize" "missing actual frame"
        val sources=W.original_sources work
        val metadata=W.semantic_policy work
        val native_limits= #semantic_limits native
        val input=IntInf.fromInt(#input_limit native_limits)
        val output=IntInf.fromInt(#output_limit native_limits)
        val template=IntInf.fromInt(#template_limit native_limits)
        val ceiling=IntInf.fromInt(#type_work_limit native)
        val epoch=Type.type_epoch() val symbols=Term.term_epoch()
        fun fail text=raise ERR "policy_local_specialize" text
        val metrics=ref([]:(G.node * SmtReplayLocalSpecialize.metric)list)
        fun valid()=
          let val(now,_)=pp_owner work block
              val data=Scope.description_with_policy_for work frame
              val _=List.app(fn(node,capture)=>
                let val held=SmtReplayLocalSpecialize.metric_data
                      graph scope capture
                in if #node held=node then ()else fail "metric changed"end)
                  (!metrics)
          in if Portable.pointer_eq(#contract now,contract)andalso
              Portable.pointer_eq(#sources data,sources)andalso
              Portable.pointer_eq(#graph data,graph)andalso
              #scope data=scope andalso Type.type_epoch()=epoch andalso
              Term.term_epoch()=symbols then ()else fail "owner changed"end
        fun tick()=(valid();pp_spend work 1)
        val ports=ref([]:(G.node * Term.term)list)
        fun actual node=
          let val _=tick()
              val _=if G.scope_visible graph scope(G.node_scope graph node)
                then ()else fail "invisible actual argument"
              val term=G.representative graph node
              val _=ports:=(node,term):: !ports
          in term end
        val original=actual source
        val supplied=case target of NONE=>
              (if scope=G.root_scope graph then NONE else
                fail "inferred specialization needs actual Root scope")
          | SOME node=>SOME(node,actual node)
        val args=List.map actual arguments
        val _=if List.null args then fail "empty specialization programme"
          else ()
        val _=case edge of NONE=>ignore(name block source)
          | SOME actual_edge=>
              let val proof=theorem block actual_edge
              in if Portable.pointer_eq(Thm.concl proof,name block source)
                  andalso clean proof then ()else
                fail "incorrect premise edge"end
        (* Geometry and repeated annotation incidence are acquired from
           genuine owned graph syntax/profiles BEFORE opening Term binders.
           A profile issuer never substitutes for this actual requester. *)
        val annotation_count=pc_type_counter()
        val graph_memo=ref([]:
          ((G.scope * G.node) * primitive_profile)list)
        fun graph_shape requester node=
          let
            val _=tick()
            fun find []=NONE
              | find(((frame,current),p)::rest)=
                  (tick();if frame=requester andalso current=node then
                     SOME p else find rest)
            fun opaque()=
              let fun seek []=fail "opaque local operand lacks profile"
                    | seek(p::rest)=
                        (tick();case G.opaque_profile_for_node_with_policy
                          graph requester node p of NONE=>seek rest
                        | SOME data=>data)
              in seek profiles end
          in case find(!graph_memo)of SOME p=>p|NONE=>
            let
              val _=if G.scope_visible graph requester
                  (G.node_scope graph node)then ()else
                fail "invisible actual geometry node"
              val own=annotation_count(G.type_of graph node)
              val _=pp_pay work(1+own)
              val p:primitive_profile=case G.view graph node of
                  G.OpaqueRetained=>
                    let val data=opaque()
                    in if #ty data=own then
                      {raw= #raw data,inc= #inc data,
                       ann= #ann data,ty=own}else
                      fail "actual opaque Type differs"end
                | G.Application(a,b)=>
                    let val x=graph_shape requester a
                        val y=graph_shape requester b
                    in {raw=1+ #raw x+ #raw y,inc=1+ #inc x+ #inc y,
                        ann=own+ #ann x+ #ann y,ty=own}end
                | G.AdmittedBinder _=>
                    let val closure=G.binder_closure graph requester node
                        val data=G.binder_closure_data graph requester closure
                        val body=graph_shape(#body_frame data)(#body data)
                        val binder=annotation_count
                          (G.type_of graph(#binder data))
                        val _=pp_pay work(1+binder)
                    in {raw=1+ #raw body,inc=2+ #inc body,
                        ann=own+binder+ #ann body,ty=own}end
                | _=>{raw=1,inc=1,ann=own,ty=own}
              val _=if #ann p<=ceiling then ()else
                fail "actual local annotations exceed caller Type cap"
              val _=graph_memo:=((requester,node),p):: !graph_memo
            in p end
          end
        (* Only actual local operands are admitted, not the Source prefix.
           Public Type getters retain before_ALL_Type=false. *)
        fun geometry node cap policy=
          let val _=valid()
              val capture=SmtReplayLocalSpecialize.prepare_metric graph scope
                {node=node,profiles=profiles}
              val data=SmtReplayLocalSpecialize.metric_data graph scope capture
              val _=if #node data=node andalso #raw data<=cap andalso
                  #inc data<=cap andalso RP.allows policy(#raw data)andalso
                  RP.allows policy(#inc data)then ()else
                fail "actual local geometry exceeds caller cap"
              val _=metrics:=(node,capture):: !metrics
              val p=graph_shape scope node
              val _=if #raw p= #raw data andalso #inc p= #inc data andalso
                  1+ #raw p+ #inc p+ #ann p<=ceiling then ()else
                fail "actual local geometry/Type portfolio differs"
              val _=valid()
          in ()end
        val _=geometry source input(#input_limit metadata)
        val _=List.app(fn node=>geometry node input
          (#input_limit metadata))arguments
        val _=case supplied of NONE=>()|SOME(node,_)=>
          geometry node output(#output_limit metadata)
        val type_ports=ref([]:Type.hol_type list)
        val profile=SmtReplayLocalSpecialize.native_profile
          {tick=tick,type_weight=pp_type_weight work ceiling,
           type_seen=fn ty=>type_ports:=ty:: !type_ports,
           input=input,output=output,template=template,ceiling=ceiling,
           error=ERR "policy_local_specialize"}
        fun weight(p:primitive_profile)= #raw p+ #inc p+ #ann p
        fun bounded role cap policy(p:primitive_profile)=
          if #raw p<=cap andalso #inc p<=cap andalso
              RP.allows policy(#raw p)andalso RP.allows policy(#inc p)
              andalso #ann p<=ceiling then ()else fail role
        fun in_bound p=bounded "native local input exceeds caller cap"
          input(#input_limit metadata)p
        fun out_bound p=bounded "native local output exceeds caller cap"
          output(#output_limit metadata)p
        fun law_bound p=
          (out_bound p;bounded "native local law exceeds template cap"
            template(#template_limit metadata)p)
        val first=profile original val _=in_bound first
        val declared=case supplied of NONE=>NONE|SOME(node,term)=>
          let val p=profile term val _=out_bound p
          in SOME(node,term,p)end
        val arg_profiles=List.map profile args
        val _=List.app in_bound arg_profiles
        val total=ref(0:IntInf.int)
        fun charge result inputs hypotheses=
          let val n=List.foldl(fn(p,n)=>n+weight p)
                (1+weight result)(inputs @ hypotheses)
              val _=if n<=ceiling then ()else
                fail "local native input/result/Hyp/Type portfolio exceeded"
              val _=total:= !total+n+20
          in ()end
        val _=charge first [] [first]
        val specialize=SmtReplayLocalSpecialize.forecast
          {profile=profile,tick=tick,pay=pp_pay work,in_bound=in_bound,
           out_bound=out_bound,charge=charge,first=first,
           variable_compare=Term.var_compare,
           error=ERR "policy_local_specialize"}
        (* Only the actual prospectively admitted substitution result enters
           this builder. Lexical frames own Bound identities; a raw Term
           pointer is not a graph binding or a caller-supplied profile. *)
        fun inferred_target predicted =
          let
            val _=if scope=G.root_scope graph then ()else
              fail "inferred specialization needs actual Root scope"
            val created=ref([]:G.scope list)
            val built=ref([]:((G.scope * Term.term) * G.node)list)
            fun live()=
              (valid();List.app(G.validate_scope graph)(!created))
            fun step()=(live();tick();live())
            fun find _ []=NONE
              | find(requester,term)(((where_,old),node)::rest)=
                  (step();if requester=where_ andalso
                     Portable.pointer_eq(term,old)then SOME node
                   else find(requester,term)rest)
            fun pay_portfolio result inputs extra message=
              let
                val amount=List.foldl(fn(p,n)=>n+weight p)
                  (1+weight result+extra)inputs
                val _=if extra>=0 andalso amount<=ceiling then ()else
                  fail message
                val _=pp_pay work amount
                val _=live()
              in ()end
            fun quote term inputs extra=
              let val p=profile term
                  val _=out_bound p
                  val ps=List.map profile inputs
                  val _=List.app in_bound ps
                  val _=pay_portfolio p ps extra
                    "inferred metadata Type portfolio exceeds cap"
              in ()end
            fun child parent bindings=
              let val _=step()
                  val next=G.new_scope graph parent bindings
                  val _=created:=next:: !created
                  val _=live()
              in next end
            fun same_shape(a:primitive_profile,b:primitive_profile)=
              #raw a= #raw b andalso #inc a= #inc b andalso
              #ann a= #ann b andalso #ty a= #ty b
            (* The result was already measured after admitted substitution.
               Quote this actual additional dest_abs BEFORE its native body
               copy. Its projection preserves structure/Types under alpha
               naming; the measured return is checked independently. *)
            fun open_result term=
              let
                val p=profile term val _=in_bound p val _=out_bound p
                val(domain,range)=Type.dom_rng(Term.type_of term)
                val domain_weight=pp_type_weight work ceiling domain
                val range_weight=pp_type_weight work ceiling range
                val vp:primitive_profile=
                  {raw=1,inc=1,ann=domain_weight,ty=domain_weight}
                val bp:primitive_profile=
                  {raw= #raw p-1,inc= #inc p-2,
                   ann= #ann p- #ty p-domain_weight,ty=range_weight}
                val _=if #raw bp>=1 andalso #inc bp>=1 andalso
                    #ann bp>=range_weight then ()else
                  fail "inferred Abs projection differs"
                val _=out_bound vp val _=out_bound bp
                val _=pay_portfolio bp[p,vp]
                  (#ty p+domain_weight+range_weight)
                  "inferred Abs opening Type portfolio exceeds cap"
                val _=live()
                val(variable,body)=Term.dest_abs term
                val _=live()
                val actual_variable=profile variable
                val actual_body=profile body
                val _=if same_shape(vp,actual_variable)andalso
                    same_shape(bp,actual_body)then ()else
                  fail "inferred Abs projection changed native geometry"
              in(variable,body)end
            (* Fresh names must also avoid genuine native free variables
               which are still hidden inside the admitted result syntax.
               Register them at THIS lexical requester before fresh choice.
               This additional native FV operation has its own prior quote;
               it is not first opaque acquisition or a profile issuer. *)
            fun reserve_free requester term=
              let
                val p=profile term val _=in_bound p val _=out_bound p
                val _=pay_portfolio p [] (2* #raw p+ #ann p)
                  "inferred Abs FV portfolio exceeds cap"
                val _=live()
                val variables=Term.free_vars term
                val _=live()
                fun reserve variable=
                  let val vp=profile variable
                      val _=in_bound vp
                      val _=if Term.is_var variable then ()else
                        fail "inferred Abs FV is not an actual variable"
                      val _=quote variable[variable](2* #ty vp)
                      val _=G.validate_scope graph requester
                      val _=ignore(G.resolve_variable graph requester variable)
                      val _=live()
                  in ()end
              in List.app reserve variables end
            fun build requester term=
              let val _=live() val _=G.validate_scope graph requester
              in case find(requester,term)(!built)of SOME node=>
                   (G.validate_scope graph requester;live();node)
                | NONE=>
                  let
                    val _=step()
                    val node=if Term.is_comb term then
                        let val(a,b)=Term.dest_comb term
                            val left=build requester a
                            val right=build requester b
                            val _=quote term
                              [G.representative graph left,
                               G.representative graph right]0
                        in G.application graph requester(left,right)end
                      else if Term.is_var term then
                        (quote term []0;
                         G.resolve_variable graph requester term)
                      else if Term.is_const term then
                        (quote term []0;G.constant graph requester term)
                      else if Term.is_abs term then
                        let
                          val _=reserve_free requester term
                          val(variable,body)=open_result term
                          val vp=profile variable
                          (* Actual fresh-variable construction and its
                             Type interning precede no unquoted native call.
                             The lexical key stays the original variable. *)
                          val _=quote variable [] (2* #ty vp)
                          val binder_frame=child requester []
                          val binder=G.fresh_bound_variable graph
                            binder_frame variable
                          val _=live()
                          val actual_binder=G.representative graph binder
                          val _=if same_shape(vp,profile actual_binder)
                            then ()else fail "fresh Bound geometry changed"
                          val _=quote actual_binder [actual_binder]
                            (2* #ty vp)
                          val body_frame=child binder_frame[(variable,binder)]
                          val body_node=build body_frame body
                          val actual_body=G.representative graph body_node
                          val bp=profile actual_body
                          val result=profile term
                          (* Term.mk_abs and Type.mk_type(fun) use actual
                             binder/body operands. This is output authority,
                             never a whole-result template ceiling. *)
                          val _=quote term[actual_binder,actual_body]
                            (1+ #ty vp+ #ty bp+ #ty result)
                          val _=live()
                          val abstraction=G.recorded_abstraction_with_policy
                            graph requester(RP.AtMost output)
                            {binder=binder,body=body_node,body_frame=body_frame}
                          val _=live()
                          val capture=G.binder_closure graph requester
                            abstraction
                          val actual=G.binder_closure_data graph requester
                            capture
                          val _=if #binder actual=binder andalso
                              #body actual=body_node andalso
                              #body_frame actual=body_frame andalso
                              #declaring_scope actual=requester then ()else
                            fail "inferred recorded binder lineage changed"
                        in abstraction end
                      else fail "unknown inferred result syntax"
                    val _=live()
                    val _=built:=((requester,term),node):: !built
                  in node end
              end
            val node=build scope predicted
            val term=actual node
            (* This genuine scoped metric persistently captures every new
               recorded closure/body frame before callbacks or native rules.
               The existing plan/final fact retain it in metrics. *)
            val _=geometry node output(#output_limit metadata)
            val final=profile term
            val _=out_bound final
            val _=live()
          in(node,term,final)end
        val(predicted,steps)=specialize original args arg_profiles
        val(target,target_term,final)=case declared of
            SOME held=>held|NONE=>inferred_target predicted
        val _=pp_pay work(1+weight(profile predicted)+weight final)
        val _=if Term.aconv predicted target_term then ()else
          fail "declared target is not the actual specialization"
        val {law=law_p,equation=equation_p}=
          SmtReplayLocalSpecialize.close_forecast
            {out_bound=out_bound,law_bound=law_bound,charge=charge}
            {first=first,final=final}
        val implication=G.constant graph scope boolSyntax.implication
        val law=G.application graph scope
          (G.application graph scope(implication,source),target)
        val _=ports:=(law,G.representative graph law):: !ports
        val _=ignore(profile(G.representative graph law))
        val types=List.rev(!type_ports)
        val callback_weight=SmtReplayLocalSpecialize.callback_forest
          {visit=fn()=>(),type_weight=pp_type_weight work ceiling,
           ceiling=ceiling,error=ERR "policy_local_specialize"}types
        val _=pp_future work(!total+callback_weight)
        val _=valid()
      in PolicyLocalSpecializePlan{work=work,block=block,contract=contract,
          frame=frame,graph=graph,scope=scope,sources=sources,
          source=source,target=target,law=law,arguments=args,expected=steps,
          metrics= !metrics,
          ports= !ports,epoch=epoch,symbols=symbols,check_type=check_type,
          types=types,used=ref false}end)
     handle primary=>(W.close work;raise primary))

  fun execute_local_specialize_with_policy expected
      (saved as PolicyLocalSpecializePlan{work,...}) =
    ((if Portable.pointer_eq(expected,work)then ()else
        raise ERR "policy_local_specialize" "different original Work";
      let
        val PolicyLocalSpecializePlan{block,contract,frame,graph,scope,
          sources,source,target,law,arguments,expected=steps,ports,
          metrics,
          epoch,symbols,check_type,types,used,...}=saved
        val _=W.spend_policy work 3
        val metric_guard=SmtReplayLocalSpecialize.metric_cache_guard
          {metrics=metrics,work=work,graph=graph,scope=scope,
           error=ERR "policy_local_specialize"}
        fun stable()=
          let val _=SmtReplayNativeContract.validate_for work contract
              (* A supplied receipt can run callbacks. Keep NC and Scope
                 on EVERY call, before the callback-free metric cache. *)
              val data=Scope.description_with_policy_for work frame
              val _=metric_guard()
          in if Portable.pointer_eq(#sources data,sources)andalso
              Portable.pointer_eq(#graph data,graph)andalso #scope data=scope
              andalso Type.type_epoch()=epoch andalso
              Term.term_epoch()=symbols andalso
              List.all(fn(node,term)=>
                G.scope_visible graph scope(G.node_scope graph node)andalso
                Portable.pointer_eq(G.representative graph node,term))ports
            then ()else raise ERR "policy_local_specialize"
              "actual local law owner changed"end
        fun active()=
          (stable();let val(now,_)=pp_owner work block
           in if Portable.pointer_eq(#contract now,contract)then ()else
             raise ERR "policy_local_specialize" "different native contract"
           end)
        val _=active() val _=W.spend_policy work 0
        val _=if !used then raise ERR "policy_local_specialize" "used plan"
          else used:=true
        fun policy ty=(active();check_type ty;active())
        val _=List.app policy types
        fun call action=
          (active();let val result=action()val _=active()
           in if clean result then result else
             raise ERR "policy_local_specialize" "native proof tag changed"
           end)
        val original=G.representative graph source
        val {proof,canonical}=SmtReplayLocalSpecialize.run
          {original=original,arguments=arguments,steps=steps,
           canonical=fn()=>G.representative graph law,call=call,
           error=ERR "policy_local_specialize"}
        val _=if List.null(Thm.hyp proof)andalso
            Portable.pointer_eq(Thm.concl proof,canonical)then ()else
          raise ERR "policy_local_specialize" "not a closed canonical law"
        (* The closed law survives consumption of the authorizing Block.
           Its actual Scope/Source/NC/epochs/graph ports remain guarded. *)
        fun guard()=
          (stable();if clean proof andalso List.null(Thm.hyp proof)andalso
              Portable.pointer_eq(Thm.concl proof,canonical)then ()else
            raise ERR "policy_local_specialize" "closed law changed")
          handle primary=>(W.close work;raise primary)
        val _=guard()
      in PolicyRealizedClosedFact{work=work,graph=graph,scope=scope,
          node=law,theorem=proof,
          template_limit= #template_limit(W.semantic_policy work),
          guard=guard}end)
     handle primary=>(W.close expected;raise primary))

  (* Revocation only: this does not create a realization or any theorem.
     The opaque policy owner and retained NC are checked before mutation;
     no replacement contract, integer Work projection or credit is used. *)
  fun retire_policy_block_for expected block =
    ((let val _=ignore(pp_owner expected block)
      in retire_block block end)
     handle primary=>(W.close expected;raise primary))

  (* Actual receipt ownership remains in this P specialization. *)
  type policy_source_close_plan=SmtReplayGoalClose.plan
  fun prepare_source_close_with_policy work
      (receipt as PolicySourceRealization{work=held,...})
      {profiles,check_type} =
    ((if Portable.pointer_eq(work,held)then ()else
        raise ERR "policy_source_close" "different original Work";
      let
        val proof=policy_source_realization_theorem_for work receipt
        val PolicySourceRealization{block,contract,...}=receipt
        val _=W.spend_policy work 0
        val native=SmtReplayNativeContract.for_work work contract
        val sources=W.original_sources work
        val graph=SmtReplaySource.owning_graph sources
        val scope=SmtReplaySource.owning_scope sources
        val Block{graph=actual,scope=current,owned_frame,...}=block
        val frame=case owned_frame of SOME(_,value)=>value
          | NONE=>raise ERR "policy_source_close" "unowned realization"
        val _=if Portable.pointer_eq(graph,actual)andalso scope=current
          then ()else raise ERR "policy_source_close"
            "realized contradiction is outside original Source frame"
      in SmtReplayGoalClose.prepare
        {work=work,contract=contract,native=native,sources=sources,
         graph=graph,scope=scope,frame=frame,proof=proof,
         guard=fn()=>ignore
           (policy_source_realization_theorem_for work receipt),
         profiles=profiles,check_type=check_type,
         error=ERR "policy_source_close",type_weight=pp_type_weight work,
         counter=pc_type_counter}end)
     handle primary=>(W.close work;raise primary))
  val execute_source_close_with_policy=SmtReplayGoalClose.execute

  (* The caller supplies only an actual owned frame and genuine closed fact.
     The checked fact, not detached endpoints/theorem, supplies the cut. *)
  fun conversion_from_closed_fact_with_policy_for expected {frame,fact}=
    ((let
        (* A realization fact carries a Work owner: compare its immutable
           header BEFORE activating its receipt or the supplied frame. *)
        fun work_header()=case fact of
            PolicyRealizedClosedFact{work,...}=>
              if Portable.pointer_eq(expected,work)then ()else
                raise ERR "closed_fact_conversion" "different original Work"
          | _=>()
        fun fact_header graph scope=
          let val(owner,held)=case fact of
                  ClosedFact{graph,scope,...}=>(graph,scope)
                | PolicyClosedFact{graph,scope,...}=>(graph,scope)
                | PolicyRealizedClosedFact{graph,scope,...}=>(graph,scope)
          in if Portable.pointer_eq(graph,owner)andalso scope=held then ()else
            raise ERR "closed_fact_conversion"
              "different exact closed fact graph or frame"end
        fun context()=
          let val _=work_header()
              val sources=W.original_sources expected
              val graph=SmtReplaySource.owning_graph sources
              (* The graph header also precedes Scope/fact backing. *)
              val owner=case fact of ClosedFact{graph,...}=>graph
                | PolicyClosedFact{graph,...}=>graph
                | PolicyRealizedClosedFact{graph,...}=>graph
              val _=if Portable.pointer_eq(graph,owner)then ()else
                raise ERR "closed_fact_conversion" "different original graph"
              val data=Scope.description_with_policy_for expected frame
              val _=if Portable.pointer_eq(#graph data,graph)andalso
                  Portable.pointer_eq(#sources data,sources)then ()else
                raise ERR "closed_fact_conversion" "different original Source"
              val _=fact_header graph(#scope data)
          in data end
        val data=context()
        val graph= #graph data val scope= #scope data
        val maximum= #template_limit(W.semantic_policy expected)
        val types=Type.type_epoch()val symbols=Term.term_epoch()
        fun validate()=
          let val current=context()
              val _=if #root current= #root data andalso
                  #scope current=scope andalso Type.type_epoch()=types andalso
                  Term.term_epoch()=symbols then ()else
                raise ERR "closed_fact_conversion" "frame or epoch changed"
              val _=pcf_for expected fact
              val _=validate_closed_fact_with_policy
                graph scope maximum fact
          in ()end
        (* This is duplicate-getter factoring, not a guard cache. The
           authentic fact guard may run an external observer: call it
           afresh, BEFORE the original first cap check, on EVERY use.
           Only the realized constructor has immutable sealed payload. *)
        fun realized_payload()=
          let
            val current=context()
            val _=if #root current= #root data andalso
                #scope current=scope andalso Type.type_epoch()=types andalso
                Term.term_epoch()=symbols then ()else
              raise ERR "closed_fact_conversion" "frame or epoch changed"
            val _=pcf_for expected fact
            (* Fixed own-metadata envelope: realized dispatch/header and
               graph/cap branches, post-observer root/scope/epoch checks,
               sealed pair projection and retained node/proof comparisons.
               Work/Scope/graph validators retain their own accounting.
               Quote before projection; no payer or observer follows it. *)
            val _=W.spend_guard_policy expected 32
            val PolicyRealizedClosedFact
              {graph=owner,scope=held,template_limit,...}=fact
            val _=if Portable.pointer_eq(graph,owner)then ()else
              raise ERR "freeze" "different graph owner"
            val _=if maximum=template_limit then ()else
              raise ERR "freeze" "different original policy"
            val _=G.validate_scope graph scope
            val _=if G.scope_visible graph scope held then ()else
              raise ERR "freeze" "closed fact escapes actual frame"
            (* NEVER reuse the pre-observer context. In particular, Scope
               retirement and Type/Term mutations must fail before either
               payload read, even when the fact's observer returns (). *)
            val fresh=context()
            val _=if #root fresh= #root data andalso
                #scope fresh=scope andalso Type.type_epoch()=types andalso
                Term.term_epoch()=symbols then ()else
              raise ERR "closed_fact_conversion" "frame or epoch changed"
            val PolicyRealizedClosedFact{node,theorem,...}=fact
          in (node,theorem)end
        val equality=case fact of PolicyRealizedClosedFact _=>
              #1(realized_payload())
          | _=>(validate();closed_node fact)
        val(partial,target)=case G.view graph equality of
            G.Application pair=>pair
          | _=>raise ERR "closed_fact_conversion" "fact is not equality"
        val(head,source)=case G.view graph partial of
            G.Application pair=>pair
          | _=>raise ERR "closed_fact_conversion" "fact is not equality"
        val constant=G.representative graph head
        val _=if Term.is_const constant andalso
            Term.same_const constant boolSyntax.equality andalso
            G.type_id graph source=G.type_id graph target then ()else
          raise ERR "closed_fact_conversion" "fact is not typed equality"
        (* The realized suffix since realized_payload is fixed inspection
           only: no external callback separates these sealed reads. *)
        val proof=case fact of PolicyRealizedClosedFact{theorem,...}=>theorem
          | _=>closed_proof fact
        val(left,right)=boolSyntax.dest_eq(Thm.concl proof)
        val _=if HOLset.numItems(Thm.hypset proof)=0 andalso
            clean proof andalso
            Portable.pointer_eq(Thm.concl proof,
              G.representative graph equality)andalso
            Portable.pointer_eq(left,G.representative graph source)andalso
            Portable.pointer_eq(right,G.representative graph target)then ()else
          raise ERR "closed_fact_conversion" "canonical equality differs"
        fun guard()=case fact of PolicyRealizedClosedFact _=>
            let val(node,theorem)=realized_payload()
            in if equality=node andalso Portable.pointer_eq(proof,theorem)
              then ()else
                raise ERR "closed_fact_conversion" "retained fact changed"
            end
          | _=>pr_with_pure_validation expected(fn()=>
              (validate();
               if equality=closed_node fact andalso
                   Portable.pointer_eq(proof,closed_proof fact)then ()else
                 raise ERR "closed_fact_conversion" "retained fact changed"))
        val _=guard()
      in PolicyRealizedConversion{work=expected,graph=graph,scope=scope,
          source=source,target=target,theorem=proof,template_limit=maximum,
          guard=guard}end)
     handle primary=>(W.close expected;raise primary))

  (* This opaque lineage witness is minted from a genuine checked fact,
     never from a caller conversion, endpoint pair or proposed cut flag. *)
  datatype policy_closed_fact_cut=PolicyClosedFactCut of
    {work:W.portfolio,frame:Scope.receipt,fact:closed_fact,
     conversion:closed_conversion}
  fun closed_fact_cut_with_policy_for expected(request as {frame,fact})=
    let val conversion=conversion_from_closed_fact_with_policy_for
          expected request
    in PolicyClosedFactCut{work=expected,frame=frame,fact=fact,
      conversion=conversion}end
  fun closed_fact_cut_data_with_policy_for expected
      (PolicyClosedFactCut{work,frame,fact,conversion})=
    pr_with_pure_validation expected(fn()=>
    ((if Portable.pointer_eq(expected,work)then ()else
        raise ERR "closed_fact_cut" "different original Work";
      let val _=validate_conversion_for expected conversion
          val data=Scope.description_with_policy_for expected frame
          val graph= #graph data val scope= #scope data
          val maximum= #template_limit(W.semantic_policy expected)
          val _=pcf_for expected fact
          val _=validate_closed_fact_with_policy graph scope maximum fact
          val _=validate_conversion_with_policy graph scope maximum conversion
          val equality=closed_node fact
          val(partial,target)=case G.view graph equality of
              G.Application pair=>pair
            | _=>raise ERR "closed_fact_cut" "lost actual equality"
          val(_,source)=case G.view graph partial of
              G.Application pair=>pair
            | _=>raise ERR "closed_fact_cut" "lost actual equality"
          val _=if source=conversion_source conversion andalso
              target=conversion_target conversion andalso
              Portable.pointer_eq(closed_proof fact,
                conversion_proof conversion)then ()else
            raise ERR "closed_fact_cut" "different actual fact/conversion"
      in {frame=frame,graph=graph,root= #root data,scope=scope,
          sources= #sources data,conversion=conversion,equality=equality,
          source=source,target=target}end)
     handle primary=>(W.close expected;raise primary)))

  (* The private common programme keeps the original edge authentication in
     its SOME branch. The source-only branch authenticates the actual Block
     name and derives a closed law; it never proves that source assertion. *)
  fun prepare_local_specialize_with_policy work block
      {premise={node=source,edge},arguments,target,profiles,check_type} =
    prepare_local_specialize_internal work block
      {source=source,edge=SOME edge,arguments=arguments,
       target=SOME target,profiles=profiles,check_type=check_type}

  fun prepare_local_specialize_schema_with_policy work block
      {source,arguments,target,profiles,check_type} =
    prepare_local_specialize_internal work block
      {source=source,edge=NONE,arguments=arguments,
       target=SOME target,profiles=profiles,check_type=check_type}

  (* Persistent origins are DATA from genuine Block producers. A local
     occurrence is never identified only by its graph node or a caller ID. *)
  datatype policy_scope_slot=PolicyScopeSlot of
    {work:W.portfolio,origin:source_origin,node:G.node,guard:unit -> unit}
  datatype policy_scope_layout=PolicyScopeLayout of
    {work:W.portfolio,block:block,contract:SmtReplayNativeContract.contract,
     graph:G.graph,scope:G.scope,frame:Scope.receipt,
     sources:SmtReplaySource.sources,slots:policy_scope_slot list,
     epoch:int,symbols:int}

  fun ps_origin_equal(OriginalPrefixSlot(a,i),OriginalPrefixSlot(b,j))=
        Portable.pointer_eq(a,b)andalso i=j
    | ps_origin_equal(ActualSourceSlot(a,i),ActualSourceSlot(b,j))=
        Portable.pointer_eq(a,b)andalso i=j
    | ps_origin_equal _=false
  fun ps_slot_header expected(PolicyScopeSlot{work,...})=
    if Portable.pointer_eq(expected,work)then ()else
      raise ERR "policy_scope_layout" "different original Work"
  fun ps_slot_data expected(saved as PolicyScopeSlot{node,origin,guard,...})=
    (ps_slot_header expected saved;guard();{node=node,origin=origin})
  fun ps_layout_header expected(PolicyScopeLayout{work,...})=
    if Portable.pointer_eq(expected,work)then ()else
      raise ERR "policy_scope_layout" "different original Work"
  fun ps_layout_stable expected
      (saved as PolicyScopeLayout{block,contract,graph,scope,frame,sources,
        slots,epoch,symbols,...})=
    (ps_layout_header expected saved;
     pp_realized_guard expected block contract;
     let val Block{owned_names,...}=block
     in case owned_names of SOME names=>fixed_names_guard expected names
       | NONE=>raise ERR "policy_scope_layout" "missing genuine old names"
     end;
     let val data=Scope.description_with_policy_for expected frame
     in if Portable.pointer_eq(#graph data,graph)andalso #scope data=scope
         andalso Portable.pointer_eq(#sources data,sources)andalso
         Portable.pointer_eq(W.original_sources expected,sources)andalso
         Type.type_epoch()=epoch andalso Term.term_epoch()=symbols then ()
       else raise ERR "policy_scope_layout" "actual Source frame changed"
     end;
     List.app(fn slot=>ignore(ps_slot_data expected slot))slots)
  fun ps_layout_active expected
      (saved as PolicyScopeLayout{block,contract,slots,...})=
    (ps_layout_stable expected saved;
     let val(owner,_)=pp_owner expected block
         val actual=sources block
         val nodes=List.map(fn slot=> #node(ps_slot_data expected slot))slots
     in if Portable.pointer_eq(#contract owner,contract)andalso actual=nodes
       then ()else raise ERR "policy_scope_layout"
         "layout is not the actual current Block Source portfolio"end)

  fun ps_slot_from_block expected block contract origin index node=
    let val Block{leaves,source_count,...}=block
        fun guard()=
          (pp_realized_guard expected block contract;
           if index>=0 andalso index<source_count then
             case Vector.sub(leaves,index)of Source current=>
               if current=node then ()else raise ERR "policy_scope_layout"
                 "actual Source occurrence changed"
             | _=>raise ERR "policy_scope_layout" "not an actual Source slot"
           else raise ERR "policy_scope_layout" "actual Source slot absent")
        val _=guard()
    in PolicyScopeSlot{work=expected,origin=origin,node=node,guard=guard}end

  (* This factory cannot reset origins of already existing local Sources.
     Every later append/continuation uses the actual producer below. *)
  fun initial_scope_layout_with_policy_for expected block=
    ((let val(owner,_)=pp_owner expected block
          val contract= #contract owner
          val Block{owned_frame,...}=block
          val frame=case owned_frame of SOME(_,saved)=>saved
            | NONE=>raise ERR "policy_scope_layout" "unowned initial Block"
          val data=Scope.description_with_policy_for expected frame
          val originals=W.original_sources expected
          val prefix=SmtReplaySource.assumption_nodes originals @
            [SmtReplaySource.denied_goal_node originals]
          val _=if sources block=prefix then ()else
            raise ERR "policy_scope_layout"
              "initial layout requires original prefix and zero locals"
          val slots=Lib.mapi(fn index=>fn node=>
            ps_slot_from_block expected block contract
              (OriginalPrefixSlot(originals,index))index node)prefix
          val layout=PolicyScopeLayout{work=expected,block=block,
            contract=contract,graph= #graph data,scope= #scope data,
            frame=frame,sources=originals,slots=slots,
            epoch=Type.type_epoch(),symbols=Term.term_epoch()}
          val _=ps_layout_active expected layout
      in layout end)handle primary=>(W.close expected;raise primary))

  fun scope_layout_sources_with_policy_for expected
      (saved as PolicyScopeLayout{slots,...})=
    ((ps_layout_stable expected saved;
      List.map(fn slot=>(#node(ps_slot_data expected slot),slot))slots)
     handle primary=>(W.close expected;raise primary))
  fun same_scope_slot_with_policy_for expected first second=
    ((ps_slot_header expected first;ps_slot_header expected second;
      let val a=ps_slot_data expected first
          val b=ps_slot_data expected second
      in ps_origin_equal(#origin a,#origin b)end)
     handle primary=>(W.close expected;raise primary))

  fun rebuild_scope_layout_with_policy expected
      (saved as PolicyScopeLayout{block=old,contract,graph,scope,frame,
        sources=originals,slots,epoch,symbols,...})
      {append,roots,closed_facts,conversions,ordinal,check_type}=
    ((ps_layout_header expected saved;
      W.with_step expected(fn()=>
      let
        fun valid()=ps_layout_active expected saved
        val _=valid()
        val prefix=SmtReplaySource.assumption_nodes originals @
          [SmtReplaySource.denied_goal_node originals]
        val old_nodes=List.map(fn slot=>
          (pp_spend expected 1;#node(ps_slot_data expected slot)))slots
        val count=List.length prefix
        val _=if List.take(old_nodes,count)=prefix then ()else
          raise ERR "policy_scope_layout" "original Source prefix changed"
        fun admit node=
          (valid();pp_spend expected 3;
           if G.scope_visible graph scope(G.node_scope graph node)andalso
               Type.compare(G.type_of graph node,Type.bool)=EQUAL then ()else
             raise ERR "policy_scope_layout"
               "new local is not visible Boolean";
           ignore(G.view graph node))
        val _=List.app admit append
        val extra=List.drop(old_nodes,count) @ append
        val frontier=pr_prepare_frontier true true extra expected
          {frame=frame,roots=roots,closed_facts=closed_facts,
           conversions=conversions}
        val tables=prepare_owned_realization_tables_with_policy
          expected frontier
        fun policy ty=(valid();check_type ty;valid())
        val plan=prepare_native_realization_freeze_with_policy expected
          {tables=tables,contract=contract,profiles=[],ordinal=ordinal,
           check_type=policy}
        val _=valid()
        val next=freeze_owned_realization_tables_with_policy expected plan
        val _=valid()
        val next_nodes=sources next
        val _=if next_nodes=old_nodes @ append then ()else
          raise ERR "policy_scope_layout" "producer Source occurrences differ"
        val Block{owner=next_owner,...}=next
        (* No arbitrary next Block is supplied. These tokens are issued
           only for this exact successful frontier/freeze publication. *)
        val appended=Lib.mapi(fn offset=>fn node=>
          let val index=List.length old_nodes+offset
          in ps_slot_from_block expected next contract
            (ActualSourceSlot(next_owner,index))index node end)append
        val continued=PolicyScopeLayout{work=expected,block=next,
          contract=contract,graph=graph,scope=scope,frame=frame,
          sources=originals,slots=slots @ appended,epoch=epoch,symbols=symbols}
        val _=ps_layout_active expected continued val _=valid()
      in {block=next,layout=continued,appended=appended}end))
     handle primary=>(W.close expected;raise primary))

  (* The recipe is recorded by the actual constructor producer. Replay
     never invents a node/antecedent pairing from a caller's target. *)
  datatype ps_scope_chain=PSBody of G.node
    | PSImplication of G.node * G.node * ps_scope_chain
  fun ps_chain_node(PSBody node)=node
    | ps_chain_node(PSImplication(node,_,_))=node

  datatype policy_scope_snapshot=PolicyScopeSnapshot of
    {work:W.portfolio,identity:unit ref,layout:policy_scope_layout,
     indices:int list,selected:policy_scope_slot list,
     retained:policy_scope_slot list,leaves:leaf vector,tree:boundary,
     context:Term.term,laws:(G.node * Term.term * Thm.thm) vector,
     outputs:(ps_scope_chain * int) list,guard:unit -> unit}

  fun ps_leaf_guard expected graph scope maximum leaf=
    case leaf of Source node=>ignore(G.view graph node)
    | Definition(node,_)=>ignore(G.view graph node)
    | ClosedWitness fact=>
        (pcf_for expected fact;
         validate_closed_fact_with_policy graph scope maximum fact)
    | ConversionWitness conversion=>
        (validate_conversion_for expected conversion;
         validate_conversion_with_policy graph scope maximum conversion)

  fun ps_snapshot_header expected(PolicyScopeSnapshot{work,...})=
    if Portable.pointer_eq(expected,work)then ()else
      raise ERR "policy_scope_snapshot" "different original Work"
  fun ps_snapshot_stable expected
      (saved as PolicyScopeSnapshot{guard,...})=
    (ps_snapshot_header expected saved;guard())

  (* The factory owns its action. A snapshot is published only after actual
     fixed DISCH has closed a genuine named proof and all its Hyp ports. *)
  fun capture_scope_snapshot_with_policy expected
      (layout as PolicyScopeLayout{block,contract,graph,scope,frame,
        sources=originals,slots,...}){indices,outputs,check_type}=
    ((ps_layout_header expected layout;
      W.with_step expected(fn()=>
      let
        val _=ps_layout_active expected layout
        val Block{context,leaves,tree,...}=block
        val native=SmtReplayNativeContract.for_work expected contract
        val maximum= #template_limit(W.semantic_policy expected)
        val prefix=SmtReplaySource.assumption_nodes originals @
          [SmtReplaySource.denied_goal_node originals]
        val count=List.length slots val prefix_count=List.length prefix
        fun fail message=raise ERR "policy_scope_snapshot" message
        fun tick()=(ps_layout_active expected layout;pp_spend expected 1)
        fun selected index=
          (tick();if index>=prefix_count andalso index<count then
             List.nth(slots,index)else
               fail "only actual extra Source occurrences may be selected")
        val selected_slots=List.map selected indices
        fun is_selected index=
          List.exists(fn saved=>(tick();saved=index))indices
        val retained=List.map #2(List.filter(fn(index,_)=>
          not(is_selected index))(ListPair.zip
            (List.tabulate(count,Lib.I),slots)))
        val _=if List.null outputs then fail "empty snapshot output batch"
          else ()
        fun stable_backing()=
          (ps_layout_stable expected layout;
           Vector.app(ps_leaf_guard expected graph scope maximum)leaves)
        fun valid()=
          (ps_layout_active expected layout;stable_backing())
        val inspect=pp_inspector expected block native
        val profile= #profile inspect val cap= #cap inspect
        val ceiling= #ceiling inspect
        val context_p=profile context
        fun weight(p:primitive_profile)= #raw p+ #inc p+ #ann p
        fun admit(p:primitive_profile)=
          if #raw p<=cap andalso #inc p<=cap andalso #ann p<=ceiling then ()
          else fail "actual compact snapshot operand exceeds caller cap"
        val _=admit context_p
        val _=if ceiling>=5 then ()else
          fail "fixed implication Type exceeds caller cap"
        val implication_type=Term.type_of boolSyntax.implication
        val partial_type= #2(Type.dom_rng implication_type)
        val _=if pp_type_weight expected ceiling implication_type=5 andalso
            pp_type_weight expected ceiling partial_type=3 then ()else
          fail "actual fixed implication Type differs"
        val types=ref[partial_type,implication_type]
        val type_seen=ref([]:Term.term list)
        fun collect term=
          if List.exists(fn old=>(tick();Portable.pointer_eq(term,old)))
              (!type_seen)then ()else
          let val _=tick()val _=type_seen:=term:: !type_seen
              val _=types:=Term.type_of term:: !types
          in if Term.is_comb term then
               let val(a,b)=Term.dest_comb term in collect a;collect b end
             else if Term.is_var term orelse Term.is_const term then ()else
               fail "binder inside compact snapshot syntax"end
        val _=collect context
        (* The same actual proof/body pair closes once, even if it is
           requested by several output rows. Each incoming edge is checked
           before this sharing decision; no foreign edge can hit the memo. *)
        val instructions=ref([]:(G.node * Term.term * Thm.thm)list)
        val instruction_count=ref 0
        val total=ref(0:IntInf.int)
        fun find _ _ [] _=NONE
          | find body proof((node,_,held)::rest)index=
              (tick();if body=node andalso Portable.pointer_eq(proof,held)
               then SOME index else find body proof rest(index+1))
        val implication=G.constant graph scope boolSyntax.implication
        fun target body=List.foldr(fn(slot,tail)=>
          let val node= #node(ps_slot_data expected slot)
              val _=pp_spend expected 3
              val parent=G.application graph scope
                (G.application graph scope(implication,node),
                 ps_chain_node tail)
          in PSImplication(parent,node,tail)end)
            (PSBody body)selected_slots
        fun output{body,edge}=
          let val _=valid()val _=pp_spend expected 2
              val name=name block body val proof=theorem block edge
              val hypotheses=Thm.hyp proof
              val _=if Portable.pointer_eq(Thm.concl proof,name)andalso
                  clean proof andalso List.all(fn hyp=>
                    Portable.pointer_eq(hyp,context))hypotheses then ()else
                fail "snapshot needs an actual same-Block named body edge"
              val _=if Type.compare(G.type_of graph body,Type.bool)=EQUAL
                then ()else fail "snapshot body is not Boolean"
              val node=target body
          in case find body proof(!instructions)0 of SOME index=>(node,index)
            | NONE=>
              let val body_p=profile name val _=admit body_p
                  val law_p:primitive_profile=
                    {raw=3+ #raw context_p+ #raw body_p,
                     inc=3+ #inc context_p+ #inc body_p,
                     ann=9+ #ann context_p+ #ann body_p,ty=1}
                  val _=admit law_p
                  val amount=List.foldl(fn(_,n)=>n+weight context_p)
                    (1+weight law_p+weight context_p+weight body_p)hypotheses
                  val _=if amount<=ceiling then ()else
                    fail "snapshot native operand/Hyp/Type exceeds caller cap"
                  val _=collect name
                  val index= !instruction_count
                  val _=instruction_count:=index+1
                  val _=instructions:= !instructions @ [(body,name,proof)]
                  val _=total:= !total+amount+20
              in (node,index)end
          end
        val rows=List.map output outputs
        val forest=List.rev(!types)
        val callback_work=List.foldl(fn(ty,n)=>
          n+pp_type_weight expected ceiling ty)0 forest
        val _=if callback_work<=ceiling then ()else
          fail "snapshot actual Type callback forest exceeds caller cap"
        val _=pp_future expected(!total+callback_work)
        val _=valid()
        val _=List.app(fn ty=>(valid();check_type ty;valid()))forest
        fun close(body,name,proof)=
          let val _=valid()
              val law=SmtReplayRuleObservation.DISCH context proof
              val _=valid()
              val(a,b)=boolSyntax.dest_imp(Thm.concl law)
              val _=if clean law andalso List.null(Thm.hyp law)andalso
                  Portable.pointer_eq(a,context)andalso
                  Portable.pointer_eq(b,name)then ()else
                fail "native snapshot did not close the exact Context/body"
          in(body,name,law)end
        val laws=Vector.fromList(List.map close(!instructions))
        (* From here ordinary Block consumption is permitted. The actual
           closed law and all backing capabilities remain live obligations. *)
        fun guard()=
          (stable_backing();Vector.app(fn(_,name,law)=>
             let val(a,b)=boolSyntax.dest_imp(Thm.concl law)
             in if clean law andalso List.null(Thm.hyp law)andalso
                 Portable.pointer_eq(a,context)andalso
                 Portable.pointer_eq(b,name)then ()else
               fail "persistent closed snapshot changed"end)laws)
        val _=guard()
      in PolicyScopeSnapshot{work=expected,identity=ref(),layout=layout,
          indices=indices,selected=selected_slots,retained=retained,
          leaves=leaves,tree=tree,context=context,laws=laws,
          outputs=rows,guard=guard}end))
     handle primary=>(W.close expected;raise primary))

  datatype policy_scope_replay_plan=PolicyScopeReplayPlan of
    {work:W.portfolio,used:bool ref,guard:unit -> unit,
     run:unit -> {block:block,layout:policy_scope_layout,
       outputs:{snapshot:policy_scope_snapshot,
         targets:(G.node * edge)list}list}}

  (* The only successor producer below removes genuine private origins.
     No public continuation can adopt an unrelated caller-created Block. *)
  fun prepare_scope_replay_batch_with_policy expected
      (layout as PolicyScopeLayout{block=old,contract,graph,scope,frame,
        sources=originals,slots,epoch,symbols,...})
      {snapshots,ordinal,check_type}=
    ((ps_layout_header expected layout;
      List.app(ps_snapshot_header expected)snapshots;
      W.with_step expected(fn()=>
      let
        fun fail text=raise ERR "policy_scope_replay" text
        fun tick()=pp_spend expected 1
        fun valid()=
          (ps_layout_active expected layout;
           List.app(ps_snapshot_stable expected)snapshots)
        val _=if List.null snapshots then fail "empty snapshot batch"else()
        fun identity(PolicyScopeSnapshot{identity,...})=identity
        fun same_snapshot(a,b)=
          Portable.pointer_eq(identity a,identity b)
        val unique=List.foldl(fn(saved,held)=>
          if List.exists(fn other=>(tick();same_snapshot(saved,other)))held
          then held else held @ [saved])[]snapshots
        fun data(PolicyScopeSnapshot{layout=saved,...})=saved
        fun check_owner saved=
          let val PolicyScopeLayout{contract=held,graph=g,scope=r,
                frame=f,sources=s,epoch=e,symbols=t,...}=data saved
          in if Portable.pointer_eq(contract,held)andalso
              Portable.pointer_eq(graph,g)andalso scope=r andalso
              Portable.pointer_eq(frame,f)andalso
              Portable.pointer_eq(originals,s)andalso epoch=e andalso
              symbols=t then ()else
            fail "snapshot has another actual frame/Source/NC"end
        val _=List.app check_owner unique
        (* All supplied Work headers and immutable owner associations are
           fenced before any borrowed snapshot/frame guard can run. *)
        val _=valid()
        val native=SmtReplayNativeContract.for_work expected contract
        val ceiling=IntInf.fromInt(#type_work_limit native)
        val cap=IntInf.fromInt
          (#template_limit(#semantic_limits native))
        fun origin slot= #origin(ps_slot_data expected slot)
        fun same_slot(a,b)=ps_origin_equal(origin a,origin b)
        val selected=List.concat(List.map
          (fn PolicyScopeSnapshot{selected,...}=>selected)unique)
        fun removed slot=List.exists(fn held=>
          (tick();same_slot(slot,held)))selected
        val retained=List.filter(fn slot=>not(removed slot))slots
        fun prefix [] _=true
          | prefix _ []=false
          | prefix(a::rest)(b::tail)=
              (tick();same_slot(a,b)andalso prefix rest tail)
        (* A snapshot may be replayed after its own selected occurrences
           disappeared, or beneath later new locals. Its retained outer
           occurrences cannot disappear or be replaced by equal nodes. *)
        val _=List.app(fn PolicyScopeSnapshot{retained=needed,...}=>
          if prefix needed retained then ()else
            fail "retained Source origins are not the successor prefix")
          unique
        val next_nodes=List.map(fn slot=> #node
          (ps_slot_data expected slot))retained
        val original_nodes=SmtReplaySource.assumption_nodes originals @
          [SmtReplaySource.denied_goal_node originals]
        val original_count=List.length original_nodes
        val _=if List.length next_nodes>=original_count andalso
            List.take(next_nodes,original_count)=original_nodes then ()else
          fail "original ordered Source prefix changed"
        val definitions=ref([]:G.node list)
        val facts=ref([]:closed_fact list)
        val conversions=ref([]:closed_conversion list)
        fun add_node node=if List.exists(fn old=>(tick();node=old))
            (!definitions)then ()else definitions:= !definitions @ [node]
        fun add_fact fact=if List.exists(fn old=>
            (tick();Portable.pointer_eq(fact,old)))(!facts)then ()else
          facts:= !facts @ [fact]
        fun add_conversion conversion=if List.exists(fn old=>
            (tick();Portable.pointer_eq(conversion,old)))(!conversions)
          then ()else conversions:= !conversions @ [conversion]
        fun gather leaf=(tick();case leaf of
            Definition(node,_)=>add_node node
          | ClosedWitness fact=>add_fact fact
          | ConversionWitness conversion=>add_conversion conversion
          | Source _=>())
        val Block{leaves=current_leaves,...}=old
        val _=Vector.app gather current_leaves
        val _=List.app(fn PolicyScopeSnapshot{leaves,...}=>
          Vector.app gather leaves)unique
        val roots=List.concat(List.map
          (fn PolicyScopeSnapshot{outputs,...}=>
            List.map(fn(chain,_)=>(tick();ps_chain_node chain))outputs)unique)
        val frontier=pr_prepare_frontier true true
          (List.drop(next_nodes,original_count))expected
          {frame=frame,roots=roots @ !definitions,
           closed_facts= !facts,conversions= !conversions}
        val tables=prepare_owned_realization_tables_with_policy
          expected frontier
        fun checked ty=(valid();check_type ty;valid())
        val freeze=prepare_native_realization_freeze_with_policy expected
          {tables=tables,contract=contract,profiles=[],ordinal=ordinal,
           check_type=checked}
        val PRNativeFreezePlan{compact=next_size,...}=freeze
        val PRRealizationTables{names=PRFixedNames
          {strings,types,held,epoch=names_epoch,symbols=names_symbols,
           validated_revision,...},...}=tables
        val _=W.spend_policy expected 1
        val future_names=FixedNames{work=expected,graph=graph,scope=scope,
          frame=frame,strings=SOME strings,types=types,held=held,
          epoch=names_epoch,symbols=names_symbols,
          validated_revision=validated_revision}
        datatype expression=Held of Term.term|Named of G.node|NextContext
          | App of expression*expression|Equation of expression*expression
          | Imp of expression*expression|Conj of expression*expression
        datatype hypothesis=NextHyp|LocalHyp of G.node
        type model={expression:expression,value:primitive_profile,
          ty:Type.hol_type,hypotheses:hypothesis list}
        val callback_types=ref([]:pr_native_type list)
        fun retain_type ty=(callback_types:=ty:: !callback_types;ty)
        fun own_type ty=
          (ignore(retain_type(PRActualType ty));
           pp_type_weight expected ceiling ty)
        val held_memo=ref([]:(Term.term * primitive_profile)list)
        fun held_known term []=NONE
          | held_known term((old,value)::rest)=
              (tick();if Portable.pointer_eq(term,old)then SOME value
               else held_known term rest)
        (* These are already captured compact constructor terms, not raw
           expanded Source syntax. Every variable is rejoined to the exact
           authentic future naming plan before native freeze/callbacks. *)
        fun held_profile term=case held_known term(!held_memo)of
            SOME value=>value
          | NONE=>
            let val _=tick()val own=own_type(Term.type_of term)
                val value:primitive_profile=if Term.is_comb term then
                    let val(a,b)=Term.dest_comb term
                        val x=held_profile a val y=held_profile b
                    in {raw=1+ #raw x+ #raw y,inc=1+ #inc x+ #inc y,
                      ann=own+ #ann x+ #ann y,ty=own}end
                  else if Term.is_var term then
                    if pp_name_member expected ceiling future_names term
                    then {raw=1,inc=1,ann=own,ty=own}else
                      fail "needed old name is not in actual next plan"
                  else if Term.is_const term then
                    {raw=1,inc=1,ann=own,ty=own}else
                    fail "binder inside compact snapshot law"
                val _=held_memo:=(term,value):: !held_memo
            in value end
        val size_memo=ref([]:
          (expression*(primitive_profile*Type.hol_type))list)
        fun profile expression=
          (tick();case List.find(fn(saved,_)=>
             (tick();Portable.pointer_eq(expression,saved)))(!size_memo)of
           SOME(_,value)=>value|NONE=>
           let val value=case expression of
                Held term=>(held_profile term,Term.type_of term)
              | Named node=>
                  let val ty=G.type_of graph node val n=own_type ty
                  in ({raw=1,inc=1,ann=n,ty=n}:primitive_profile,ty)end
              | NextContext=>
                  ({raw= #raw next_size,inc= #inc next_size,
                    ann= #ann next_size,ty=own_type Type.bool}
                    :primitive_profile,Type.bool)
              | App(a,b)=>
                  let val(x,ty)=profile a val(y,_)=profile b
                      val range= #2(Type.dom_rng ty)
                      val own=own_type range
                  in ({raw=1+ #raw x+ #raw y,inc=1+ #inc x+ #inc y,
                    ann=own+ #ann x+ #ann y,ty=own}:primitive_profile,
                    range)end
              | Equation(a,b)=>
                  let val(x,ty)=profile a val(y,_)=profile b
                      val partial=PRArrowType
                        (PRActualType ty,PRBooleanType)
                      val _=ignore(retain_type partial)
                      val _=ignore(retain_type
                        (PRArrowType(PRActualType ty,partial)))
                      val own=own_type Type.bool
                  in ({raw=3+ #raw x+ #raw y,inc=3+ #inc x+ #inc y,
                    ann=6+3* #ty x+ #ann x+ #ann y,ty=own}
                    :primitive_profile,Type.bool)end
              | Imp(a,b)=>profile
                  (App(App(Held boolSyntax.implication,a),b))
              | Conj(a,b)=>profile
                  (App(App(Held boolSyntax.conjunction,a),b))
               val _=size_memo:=(expression,value):: !size_memo
           in value end)
        fun weight(p:primitive_profile)= #raw p+ #inc p+ #ann p
        fun admit(p:primitive_profile)=
          if #raw p<=cap andalso #inc p<=cap andalso #ann p<=ceiling
          then ()else fail "actual compact operand/result exceeds caller cap"
        fun same_hyp(NextHyp,NextHyp)=true
          | same_hyp(LocalHyp a,LocalHyp b)=a=b|same_hyp _=false
        fun union first second=List.foldl(fn(value,values)=>
          if List.exists(fn old=>(tick();same_hyp(value,old)))values
          then values else value::values)first second
        fun hyp_expression NextHyp=NextContext
          | hyp_expression(LocalHyp node)=Named node
        datatype operation=Input of Thm.thm
          | SourceProjection of int|DefinitionProjection of G.node
          | ClosedProjection of closed_fact
          | ConversionProjection of closed_conversion
          | AssumeLocal of G.node|Discharge of expression*int
          | Modus of int*int|Join of int*int|Reflexive of expression
          | Reverse of int|Compose of int*int|EqualityApply of int*int
          | OperatorApply of expression*int|ArgumentApply of int*expression
        val programme=ref([]:(operation*model)list)
        val count=ref 0
        fun emit operation expression hypotheses operands=
          let val(p,ty)=profile expression val _=admit p
              val incoming=List.concat(List.map
                (fn(value:model)=>(tick();#hypotheses value))operands)
              val introduced=List.filter(fn hyp=>not(List.exists
                (fn old=>(tick();same_hyp(hyp,old)))incoming))hypotheses
              val measured=incoming @ introduced
              fun add_hyp(hyp,total)=
                let val(value,_)=profile(hyp_expression hyp)
                    val _=admit value
                in total+weight value end
              val inputs=List.foldl(fn(value:model,total)=>
                (admit(#value value);total+weight(#value value)))0 operands
              val amount=List.foldl add_hyp(1+weight p+inputs)measured
              val _=if amount<=ceiling then ()else
                fail "actual repeated operands/Hyp/Type exceed caller cap"
              val native_rule=case operation of Input _=>false
                | SourceProjection _=>false|DefinitionProjection _=>false
                | ClosedProjection _=>false|ConversionProjection _=>false
                | _=>true
              val width=IntInf.fromInt(List.length measured)
              val _=if native_rule then pp_future expected
                  (amount+width*(width+2)+20)else tick()
              val value={expression=expression,value=p,ty=ty,
                hypotheses=hypotheses}:model
              val index= !count val _=count:=index+1
              val _=programme:=(operation,value):: !programme
          in(index,value)end
        fun expr(_,value:model)= #expression value
        fun hyp(_,value:model)= #hypotheses value
        fun id(index,_)=index
        fun models(a:int*model,b:int*model)=[#2 a,#2 b]
        fun discharge antecedent selected incoming=
          emit(Discharge(antecedent,id incoming))
            (Imp(antecedent,expr incoming))
            (List.filter(fn held=>not(same_hyp(held,selected)))(hyp incoming))
            [#2 incoming]
        fun reverse incoming=case expr incoming of Equation(a,b)=>
              emit(Reverse(id incoming))(Equation(b,a))(hyp incoming)
                [#2 incoming]
          | _=>fail "incorrect symmetry model"
        fun compose a b=case(expr a,expr b)of
            (Equation(left,_),Equation(_,right))=>
              emit(Compose(id a,id b))(Equation(left,right))
                (union(hyp a)(hyp b))(models(a,b))
          | _=>fail "incorrect transitivity model"
        fun reflexive term=emit(Reflexive term)(Equation(term,term))[][]
        val constructors=ref([]:(G.node*(int*model))list)
        fun constructor node=case List.find(fn(old,_)=>
            (tick();old=node))(!constructors)of SOME(_,proof)=>proof
          | NONE=>
            let val proof=case G.view graph node of
                  G.Constant _=>emit(DefinitionProjection node)
                    (Equation(Named node,Held(G.representative graph node)))
                    [NextHyp][]
                | G.Application(operator,operand)=>
                    let val direct=emit(DefinitionProjection node)
                          (Equation(Named node,
                            App(Named operator,Named operand)))[NextHyp][]
                        val parent=constructor operator
                        val applied=case expr parent of Equation(a,b)=>
                            emit(ArgumentApply(id parent,Named operand))
                              (Equation(App(a,Named operand),
                                App(b,Named operand)))(hyp parent)[#2 parent]
                          | _=>fail "incorrect constructor model"
                    in compose direct applied end
                | _=>reflexive(Named node)
                val _=constructors:=(node,proof):: !constructors
            in proof end
        fun bridge(PSBody node)=reflexive(Named node)
          | bridge(PSImplication(node,antecedent,tail))=
              let val a=constructor node val b=bridge tail
                  val operator=App(Held boolSyntax.implication,
                    Named antecedent)
                  val applied=case expr b of Equation(left,right)=>
                      emit(OperatorApply(operator,id b))
                        (Equation(App(operator,left),App(operator,right)))
                        (hyp b)[#2 b]
                    | _=>fail "incorrect implication bridge model"
              in compose a applied end
        fun chain_body(PSBody node)=node
          | chain_body(PSImplication(_,_,tail))=chain_body tail
        fun position wanted=
          let fun find [] _=fail "retained Source occurrence absent"
                | find(slot::rest)index=if same_slot(wanted,slot)then index
                    else(tick();find rest(index+1))
          in find retained 0 end
        fun snapshot(saved as PolicyScopeSnapshot{layout=prior,selected,
              leaves,tree,context,laws,outputs,...})=
          let val PolicyScopeLayout{slots=prior_slots,...}=prior
              fun is_selected slot=List.exists(fn selected=>
                (tick();same_slot(slot,selected)))selected
              fun witness(index,Source node)=
                    let val slot=List.nth(prior_slots,index)
                    in if is_selected slot then
                        emit(AssumeLocal node)(Named node)[LocalHyp node][]
                      else emit(SourceProjection(position slot))(Named node)
                        [NextHyp][]end
                | witness(_,Definition(node,rhs))=
                    emit(DefinitionProjection node)
                      (Equation(Named node,Held rhs))[NextHyp][]
                | witness(_,ClosedWitness fact)=emit(ClosedProjection fact)
                    (Named(closed_node fact))[NextHyp][]
                | witness(_,ConversionWitness conversion)=
                    emit(ConversionProjection conversion)
                      (Equation(Named(conversion_source conversion),
                        Named(conversion_target conversion)))[NextHyp][]
              val witnesses=Vector.mapi witness leaves
              fun rebuild Empty=emit(Input boolTheory.TRUTH)
                    (Held boolSyntax.T)[][]
                | rebuild(Leaf index)=Vector.sub(witnesses,index)
                | rebuild(Split(left,right))=
                    let val a=rebuild left val b=rebuild right
                    in emit(Join(id a,id b))(Conj(expr a,expr b))
                      (union(hyp a)(hyp b))(models(a,b))end
              val rebuilt=rebuild tree
              val results=Vector.mapi(fn(index,(body,body_name,proof))=>
                let val law=emit(Input proof)
                      (Imp(Held context,Held body_name))[][]
                    val fact=emit(Modus(id law,id rebuilt))
                      (Held body_name)(hyp rebuilt)(models(law,rebuilt))
                    val discharged=List.foldr(fn(slot,incoming)=>
                      let val node= #node(ps_slot_data expected slot)
                      in discharge(Named node)(LocalHyp node)incoming end)
                      fact selected
                    val chain=case List.find(fn(_,held)=>held=index)outputs of
                        SOME(chain,_)=>chain
                      | NONE=>fail "snapshot instruction has no output"
                    val target=ps_chain_node chain
                    val equation=reverse(bridge chain)
                    val result=emit(EqualityApply(id equation,id discharged))
                      (Named target)
                      (union(hyp equation)(hyp discharged))
                      (models(equation,discharged))
                    val _=if List.all(fn held=>same_hyp(held,NextHyp))
                        (hyp result)then ()else
                      fail "selected local survived compact replay"
                    val _=if body=chain_body chain then ()else
                      fail "incorrect retained body"
                in result end)laws
          in(saved,List.map(fn(chain,index)=>
            (ps_chain_node chain,id(Vector.sub(results,index))))outputs)end
        val compiled=List.map snapshot unique
        fun compiled_for saved=case List.find(fn(other,_)=>
              (tick();same_snapshot(saved,other)))compiled of
            SOME(_,outputs)=>outputs|NONE=>fail "missing actual snapshot"
        val rows=List.map(fn saved=>(saved,compiled_for saved))snapshots
        fun type_size(PRActualType ty)=pp_type_weight expected ceiling ty
          | type_size PRBooleanType=pp_type_weight expected ceiling Type.bool
          | type_size(PRArrowType(a,b))=1+type_size a+type_size b
        fun arrows(PRArrowType(a,b)):IntInf.int=1+arrows a+arrows b
          | arrows _=0
        val forest=List.rev(!callback_types)
        val callback_work=List.foldl(fn(ty,total)=>total+type_size ty)0 forest
        val arrow_work=List.foldl(fn(ty,total)=>total+arrows ty)0 forest
        val _=if callback_work<=ceiling then ()else
          fail "actual compact Type callback forest exceeds caller cap"
        val _=pp_future expected(callback_work+arrow_work)
        val _=valid()
        fun run()=
          let
            fun render_type(PRActualType ty)=ty
              | render_type PRBooleanType=Type.bool
              | render_type(PRArrowType(a,b))=
                  let val left=render_type a val right=render_type b
                      val _=valid()
                      val ty=Type.-->(left,right)
                      val _=valid()
                  in ty end
            val _=List.app(fn shape=>
              (valid();checked(render_type shape);valid()))forest
            val next=freeze_owned_realization_tables_with_policy
              expected freeze
            val _=valid()
            val Block{context=next_context,owner=next_owner,
              leaves=next_leaves,...}=next
            val _=if sources next=next_nodes then ()else
              fail "genuine successor Source order changed"
            val continued=PolicyScopeLayout{work=expected,block=next,
              contract=contract,graph=graph,scope=scope,frame=frame,
              sources=originals,slots=retained,epoch=epoch,symbols=symbols}
            fun both()=(valid();ps_layout_active expected continued)
            fun render(Held term)=term|render(Named node)=name next node
              | render NextContext=next_context
              | render(App(a,b))=Term.mk_comb(render a,render b)
              | render(Equation(a,b))=boolSyntax.mk_eq(render a,render b)
              | render(Imp(a,b))=boolSyntax.mk_imp(render a,render b)
              | render(Conj(a,b))=boolSyntax.mk_conj(render a,render b)
            val results=Array.array(!count,boolTheory.TRUTH)
            fun get index=Array.sub(results,index)
            fun execute(index,(operation,value:model))=
              let val _=both()
                  val result=case operation of Input proof=>proof
                    | SourceProjection n=>theorem next(source next n)
                    | DefinitionProjection node=>
                        theorem next(definition next node)
                    | ClosedProjection fact=>theorem next(closed next fact)
                    | ConversionProjection saved_conversion=>
                        theorem next(conversion next saved_conversion)
                    | AssumeLocal node=>
                        SmtReplayRuleObservation.ASSUME(name next node)
                    | Discharge(term,n)=>SmtReplayRuleObservation.DISCH
                        (render term)(get n)
                    | Modus(a,b)=>SmtReplayRuleObservation.MP(get a)(get b)
                    | Join(a,b)=>SmtReplayRuleObservation.CONJ(get a)(get b)
                    | Reflexive term=>
                        SmtReplayRuleObservation.REFL(render term)
                    | Reverse n=>SmtReplayRuleObservation.SYM(get n)
                    | Compose(a,b)=>
                        SmtReplayRuleObservation.TRANS(get a)(get b)
                    | EqualityApply(a,b)=>
                        SmtReplayRuleObservation.EQ_MP(get a)(get b)
                    | OperatorApply(term,n)=>
                        SmtReplayRuleObservation.AP_TERM(render term)(get n)
                    | ArgumentApply(n,term)=>
                        SmtReplayRuleObservation.AP_THM(get n)(render term)
                  val _=if clean result then ()else
                    fail "fixed replay programme tags changed"
                  val _=Array.update(results,index,result)
                  val _=both()
              in ()end
            val _=List.app execute(ListPair.zip
              (List.tabulate(!count,Lib.I),List.rev(!programme)))
            val dependency=new_dependency next
              (Leaves(List.tabulate(Vector.length next_leaves,Lib.I)))
            fun output(node,index)=
              let val result=get index
                  val _=if Portable.pointer_eq(Thm.concl result,
                      name next node)andalso List.all(fn hyp=>
                      Portable.pointer_eq(hyp,next_context))(Thm.hyp result)
                    then ()else fail "actual named replay result/Hyp changed"
              in(node,Edge{owner=next_owner,theorem=result,
                dependencies=dependency,primitive=NONE})end
            val published=List.map(fn(saved,outputs)=>
              {snapshot=saved,targets=List.map output outputs})rows
            val _=both()
            (* The real successor and every output already exist. No
               callback separates old retirement and new publication. *)
            val _=retire_policy_block_for expected old
          in {block=next,layout=continued,outputs=published}end
      in PolicyScopeReplayPlan
        {work=expected,used=ref false,guard=valid,run=run}end))
     handle primary=>(W.close expected;raise primary))

  fun execute_scope_replay_batch_with_policy expected
      (saved as PolicyScopeReplayPlan{work,...})=
    ((if Portable.pointer_eq(expected,work)then ()else
        raise ERR "policy_scope_replay" "different original Work";
      W.with_step expected(fn()=>
        let val PolicyScopeReplayPlan{used,guard,run,...}=saved
            val _=guard()
            val _=if !used then
                raise ERR "policy_scope_replay" "used replay batch plan"
              else used:=true
        in run()end))
     handle primary=>(W.close expected;raise primary))

  (* This plan contains only a programme built here from genuine saved
     alpha/capture owners. No caller theorem, node pair or run callback. *)
  datatype policy_alpha_leaf_plan = PolicyAlphaLeafPlan of
    {work:W.portfolio,used:bool ref,guard:unit->unit,
     run:unit->closed_fact}

  fun prepare_alpha_leaf_with_policy work
      {frame,alpha,capture,native_contract,check_type} =
    ((W.with_step work (fn () =>
      let
        val native=SmtReplayNativeContract.for_work work native_contract
        val data=Scope.description_with_policy_for work frame
        val graph= #graph data val scope= #scope data
        val sources= #sources data val root= #root data
        val policy=W.semantic_policy work
        val epoch=Type.type_epoch() val symbols=Term.term_epoch()
        fun tick()=W.spend_policy work 1
        fun fail text=raise ERR "policy_alpha_leaf" text
        val joined=G.alpha_metric_data_with_policy graph scope alpha capture
        val original= #original joined
        val source= #source joined
        val rich= #node source
        val bridge= #bridge source
        val _=case (G.view graph original,G.view graph rich) of
            (G.OpaqueRetained,G.AdmittedBinder _)=>()
          | _=>fail "requires a genuinely opened binder leaf"
        val origin=G.opened_binder_origin graph scope original source
        val raw_term=G.representative graph original
        val rich_term=G.representative graph rich
        val old_equality=Thm.concl bridge
        val(old_left,old_right)=boolSyntax.dest_eq old_equality
        val _=if Portable.pointer_eq(old_left,raw_term) andalso
            Portable.pointer_eq(old_right,rich_term) andalso
            Portable.pointer_eq(#original source,raw_term) andalso
            HOLset.numItems(Thm.hypset bridge)=0 andalso clean bridge
          then () else fail "not the exact closed registered bridge"
        val paths=ref ([]:G.closure_child list)
        val closures=ref ([]:G.binder_closure list)
        fun guard()=
          let
            val _=SmtReplayNativeContract.validate_for work native_contract
            val now=Scope.description_with_policy_for work frame
            val _=if Portable.pointer_eq(graph,#graph now) andalso
                Portable.pointer_eq(sources,#sources now) andalso
                root= #root now andalso scope= #scope now andalso
                Type.type_epoch()=epoch andalso Term.term_epoch()=symbols
              then () else fail "original owner or epoch changed"
            val _=W.validate_policy work graph root sources policy
            val current=G.alpha_metric_data_with_policy
              graph scope alpha capture
            val actual= #source current
            val _=ignore(G.binder_origin_data graph scope origin)
            val _=List.app (fn child=>ignore
              (G.closure_child_node graph scope child)) (!paths)
            val _=List.app (fn closure=>ignore
              (G.binder_closure_data graph scope closure)) (!closures)
          in if original= #original current andalso rich= #node actual
              andalso Portable.pointer_eq(bridge,#bridge actual)
              andalso Portable.pointer_eq(raw_term,#original actual)
            then () else fail "saved alpha pairing changed" end
        val _=guard()
        val limits= #semantic_limits native
        val input=IntInf.fromInt(#input_limit limits)
        val output=IntInf.fromInt(#output_limit limits)
        val ceiling=IntInf.fromInt(#type_work_limit native)
        val eraw=3+2* #raw joined val einc=3+2* #inc joined
        val nraw=3+2*eraw val ninc=3+2*einc
        (* ALPHA: E,E -> N. EQ_MP: N,E -> E. Empty Hyp in both.
           Neither equality payload is a template consumer. *)
        val _=if eraw<=input andalso einc<=input andalso
            nraw<=input andalso ninc<=input then () else
          fail "actual equality inputs exceed native input limit"
        val _=if eraw<=output andalso einc<=output andalso
            nraw<=output andalso ninc<=output then () else
          fail "actual equality results exceed native output limit"
        fun allows maximum=RP.allows maximum eraw andalso
          RP.allows maximum einc andalso RP.allows maximum nraw andalso
          RP.allows maximum ninc
        val _=if allows(#input_limit policy) then () else
          fail "actual equality inputs exceed Work input policy"
        val _=if allows(#output_limit policy) then () else
          fail "actual equality results exceed Work output policy"
        val type_memo=ref ([]:(Type.hol_type * IntInf.int) list)
        fun type_known _ []=NONE
          | type_known ty ((held,n)::rest)=
              (tick();if Portable.pointer_eq(ty,held) then SOME n
               else type_known ty rest)
        fun type_weight ty=case type_known ty (!type_memo) of
            SOME n=>n
          | NONE=>let
              val _=tick()
              val n=if Type.is_vartype ty then
                  let val bytes=String.size(Type.dest_vartype ty)
                      val _=W.spend_policy work (IntInf.fromInt bytes)
                  in 1+IntInf.fromInt bytes end
                else List.foldl (fn(child,total)=>total+type_weight child) 1
                  (#2(Type.dest_type ty))
              val _=if n<=ceiling then () else
                fail "actual Type incidence exceeds native Type limit"
              val _=type_memo:=(ty,n):: !type_memo
            in n end
        val typed=ref ([]:Type.hol_type list)
        fun retain_type ty=(typed:=ty:: !typed;type_weight ty)
        val memo=ref ([]:(G.node * G.scope * primitive_profile) list)
        fun known _ _ []=NONE
          | known node effective ((old,held,p)::rest)=
              (tick();if node=old andalso effective=held then SOME p
               else known node effective rest)
        fun profile child=
          let val node=G.closure_child_node graph scope child
              val effective=G.closure_child_scope graph scope child
              val _=paths:=child:: !paths
          in case known node effective (!memo) of SOME p=>p | NONE=>
            let
              val _=tick()
              val own=retain_type(G.type_of graph node)
              val p:primitive_profile=case G.view graph node of
                  G.Application _=>
                    let val(a,b)=G.closure_application_children
                          graph scope child
                        val x=profile a val y=profile b
                    in {raw=1+ #raw x+ #raw y,inc=1+ #inc x+ #inc y,
                      ann=own+ #ann x+ #ann y,ty=own} end
                | G.AdmittedBinder _=>
                    let val closure=G.closure_child_binder graph scope child
                        val held=G.binder_closure_data graph scope closure
                        val _=closures:=closure:: !closures
                        val binder=retain_type
                          (G.type_of graph (#binder held))
                        val body=profile
                          (G.binder_closure_body graph scope closure)
                    in {raw=1+ #raw body,inc=2+ #inc body,
                      ann=own+binder+ #ann body,ty=own} end
                | G.OpaqueRetained=>
                    fail "residual opaque annotation capture unsupported"
                | _=>{raw=1,inc=1,ann=own,ty=own}
              val _=if #ann p<=ceiling then () else
                fail "rich annotations exceed native Type limit"
              val _=memo:=(node,effective,p):: !memo
            in p end
          end
        val rich_profile=profile (#annotation joined)
        val _=if #raw rich_profile= #raw joined andalso
            #inc rich_profile= #inc joined andalso
            List.null(#types joined) then () else
          fail "rich geometry or recorded-only capture differs"
        (* First indexed binder admission recursively preserves every term
           constructor and Type annotation; only term binder names change.
           Its saved recipe transports ANN to raw_term, not a raw Abs walk.
           The actual registered bridge and indexed origin remain guarded. *)
        val domain= #ty rich_profile
        val eann=6+3*domain+2* #ann rich_profile
        val nann=9+2*eann
        val(partial,_)=Term.dest_comb old_equality
        val(eq_head,_)=Term.dest_comb partial
        val source_ports=List.map Term.type_of
          [old_equality,partial,eq_head]
        val _=if List.map type_weight source_ports=
            [1,domain+2,2*domain+3] then () else
          fail "actual equality Type ports differ"
        (* Borrow actual fixed Boolean equality ports. No SPEC/CONJUNCT,
           Type constructor, function Type builder or fresh term needed. *)
        val(negated,_)=boolSyntax.dest_conj
          (Thm.concl boolTheory.BOOL_EQ_DISTINCT)
        val(_,bool_equality)=Term.dest_comb negated
        val(bool_partial,_)=Term.dest_comb bool_equality
        val(bool_head,_)=Term.dest_comb bool_partial
        val bool_ports=List.map Term.type_of
          [bool_equality,bool_partial,bool_head]
        val _=if List.map type_weight bool_ports=[1,3,5] then () else
          fail "actual fixed Boolean equality Type ports differ"
        (* Include all three NEW canonical shell ports prospectively,
           using the SAME borrowed Type ports before graph publication. *)
        val prefix=List.rev(!typed) @ source_ports @ source_ports @ bool_ports
        val callback_weight=List.foldl
          (fn(ty,total)=>total+type_weight ty) 0 prefix
        val repeated=4*eann+2*nann
        (* The two actual Term.mk_comb publications consume H,X -> L,
           then L,X -> E. G.constant borrows H; it constructs no Term. *)
        val head_weight=2+(2*domain+3)
        val partial_weight=(2+ #raw rich_profile)+
          (2+ #inc rich_profile)+(3*domain+5+ #ann rich_profile)
        val leaf_weight= #raw rich_profile+ #inc rich_profile+
          #ann rich_profile
        val publication=head_weight+2*partial_weight+2*leaf_weight+
          (eraw+einc+eann)
        val portfolio=4*(eraw+einc)+2*(nraw+ninc)+repeated+
          publication+callback_weight
        val _=if portfolio<=ceiling then () else
          fail "actual repeated native/Type portfolio exceeds local limit"
        (* Same direct prepaid Work discipline as fixed policy primitives;
           no entitlement, new credit, private ordinal or full-cost claim. *)
        val _=pp_future work (portfolio+40)
        val _=guard()
        (* These are term-building metadata operations, not G.equality.
           The latter is a native proof operation and is deliberately absent.
           All prospective operand/result/Type checks above precede these. *)
        val head=G.constant graph scope eq_head
        val left=G.application graph scope (head,original)
        val equality=G.application graph scope (left,rich)
        val canonical=G.representative graph equality
        val canonical_ports=List.map (G.type_of graph)
          [equality,left,head]
        val _=if List.map type_weight canonical_ports=
            [1,domain+2,2*domain+3] then () else
          fail "published equality Type ports differ"
        val callbacks=List.rev(!typed) @ source_ports @ canonical_ports @
          bool_ports
        val maximum= #template_limit policy
        fun run()=
          let
            fun checked ty=(guard();check_type ty;guard())
            val _=List.app checked callbacks
            val _=guard()
            val alignment=SmtReplayRuleObservation.ALPHA
              old_equality canonical
            val _=guard()
            val proof=SmtReplayRuleObservation.EQ_MP alignment bridge
            val _=guard()
            val(a,b)=boolSyntax.dest_eq(Thm.concl proof)
            val _=if HOLset.numItems(Thm.hypset proof)=0 andalso clean proof
                andalso Portable.pointer_eq(Thm.concl proof,canonical)
                andalso Portable.pointer_eq(a,raw_term) andalso
                Portable.pointer_eq(b,rich_term) then () else
              fail "native canonical alpha result differs"
            fun held_guard()=
              (guard();if Portable.pointer_eq(canonical,
                  G.representative graph equality) then () else
                fail "canonical equality changed")
              handle primary=>(W.close work;raise primary)
          in PolicyRealizedClosedFact {work=work,graph=graph,scope=scope,
            node=equality,theorem=proof,template_limit=maximum,
            guard=held_guard} end
        val _=guard()
      in PolicyAlphaLeafPlan
        {work=work,used=ref false,guard=guard,run=run} end))
     handle primary=>(W.close work;raise primary))

  fun execute_alpha_leaf_with_policy expected
      (saved as PolicyAlphaLeafPlan {work,...}) =
    ((if Portable.pointer_eq(expected,work) then () else
        raise ERR "policy_alpha_leaf" "different original Work";
      W.with_step expected (fn () =>
        let val PolicyAlphaLeafPlan {used,guard,run,...}=saved
            val _=guard()
            val _=if !used then
                raise ERR "policy_alpha_leaf" "used alpha leaf plan"
              else used:=true
        in run() end))
     handle primary=>(W.close expected;raise primary))

  (* The actual packet receiver supplies the same-Block premise, never an
     inferred node association. Only the admitted substitution fold can
     produce this plan's target and its closed conditional law. *)
  fun prepare_inferred_local_specialize_with_policy work block
      {premise={node=source,edge},arguments,profiles,check_type} =
    prepare_local_specialize_internal work block
      {source=source,edge=SOME edge,arguments=arguments,target=NONE,
       profiles=profiles,check_type=check_type}

  (* DATA only. Every node/constructor association is checked again by the
     native planner against its actual current Block's graph and frame. *)
  datatype policy_clause_tree = PolicyClauseFalse of G.node
    | PolicyClauseLiteral of
        {node:G.node,atom:G.node,negative:bool}
    | PolicyClauseOr of
        {node:G.node,left:policy_clause_tree,right:policy_clause_tree}

  (* Ordered compact resolution. This planner consumes genuine named edges,
     never a theorem callback or a worker-supplied substitution. The entire
     fixed native programme is quoted before its first external callback. *)
  datatype policy_unit_resolution_plan = PolicyUnitResolutionPlan of
    {work:W.portfolio,block:block,
     contract:SmtReplayNativeContract.contract,epoch:int,symbols:int,
     plan:dependency SmtReplayNamedClause.plan,
     check_type:Type.hol_type->unit,used:bool ref}

  fun pr_prepare_resolution_with_fallbacks work block
      {premises,target,target_expanded,fallbacks,check_type}=
    ((let
        val (owner,native)=pp_owner work block
        val graph= #graph owner val scope= #scope owner
        val contract= #contract owner
        val Block{context,owned_frame,...}=block
        val frame=case owned_frame of SOME(_,held)=>held
          | NONE=>raise ERR "policy_unit_resolution" "missing actual frame"
        val epoch=Type.type_epoch() val symbols=Term.term_epoch()
        val metadata=W.semantic_policy work
        val finite= #semantic_limits native
        (* All terms below are authentic same-Block compact names/schema
           and Context/Hyp payloads. No expanded Source opening, native
           substitution or instantiated-original payload is consumed here.
           Their actual role is template, independently capped by Work. *)
        val template=IntInf.fromInt(#template_limit finite)
        val ceiling=IntInf.fromInt(#type_work_limit native)
        fun fail text=raise ERR "policy_unit_resolution" text
        fun tick()=pp_spend work 1
        fun valid()=
          let val(current,_)=pp_owner work block
              val held=Scope.description_with_policy_for work frame
          in if Portable.pointer_eq(#contract current,contract)andalso
              Portable.pointer_eq(#graph held,graph)andalso
              #scope held=scope andalso Type.type_epoch()=epoch andalso
              Term.term_epoch()=symbols then ()else fail "owner changed"end
        val _=valid()
        val inspect=pp_inspector work block native
        val profile= #profile inspect
        fun named node=
          (tick();G.validate_scope graph(G.node_scope graph node);
           if G.scope_visible graph scope(G.node_scope graph node)then ()
           else fail "actual clause node escapes requester";
           name block node)
        fun constant wanted node=
          (tick();case G.view graph node of G.Constant _=>
             Term.same_const(G.representative graph node)wanted
           | _=>false)
        fun operator wanted arity node=
          let fun walk current arguments=
                (ignore(named current);case G.view graph current of
                    G.Application(a,b)=>walk a(b::arguments)
                  | G.Constant _=>
                      if Term.same_const(G.representative graph current)
                          wanted andalso List.length arguments=arity
                        then arguments else fail "actual operator changed"
                  | _=>fail "missing actual constructor spine")
          in walk node []end
        fun tree_view (PolicyClauseFalse node)=
              SmtReplayNamedClause.ClauseFalse node
          | tree_view (PolicyClauseLiteral entry)=
              SmtReplayNamedClause.ClauseLiteral entry
          | tree_view (PolicyClauseOr entry)=
              SmtReplayNamedClause.ClauseOr entry
        fun node_view node=case G.view graph node of
            G.Constant _=>SmtReplayNamedClause.NodeConstant
          | G.Application pair=>SmtReplayNamedClause.NodeApplication pair
          | _=>SmtReplayNamedClause.NodeAtom
        fun dependency (Edge{dependencies,...})=dependencies
        val operations :
            (G.node,policy_clause_tree,edge,dependency)
              SmtReplayNamedClause.operations =
          {guard=valid,tick=tick,pay=pp_pay work,future=pp_future work,
           profile=profile,type_weight=pp_type_weight work ceiling,
           template=template,metadata_template= #template_limit metadata,
           ceiling=ceiling,hypothesis=fn held=>
             Portable.pointer_eq(held,context),
           error=ERR "policy_unit_resolution",
           tree_view=tree_view,node_view=node_view,same_node=op =,
           named=named,constant=constant,constant_term=G.representative graph,
           operator=operator,theorem=theorem block,definition=definition block,
           dependency=dependency}
        val plan=SmtReplayNamedClause.prepare operations
          {premises=premises,target=target,target_expanded=target_expanded,
           fallbacks=fallbacks}
    in PolicyUnitResolutionPlan{work=work,block=block,contract=contract,
      epoch=epoch,symbols=symbols,plan=plan,check_type=check_type,
      used=ref false}end)
    handle primary=>(W.close work;raise primary))

  fun prepare_unit_resolution_with_policy work block
      {premises,target,target_expanded,check_type}=
    pr_prepare_resolution_with_fallbacks work block
      {premises=premises,target=target,target_expanded=target_expanded,
       fallbacks=[],check_type=check_type}
  fun prepare_raw_unit_resolution_with_policy work block request=
    pr_prepare_resolution_with_fallbacks work block request

  fun execute_unit_resolution_with_policy expected
      (saved as PolicyUnitResolutionPlan{work,...})=
    ((if Portable.pointer_eq(expected,work)then ()else
        raise ERR "policy_unit_resolution" "different original Work";
      let val PolicyUnitResolutionPlan{block,contract,epoch,symbols,
            plan,check_type,used,...}
            =saved
          fun valid()=
            let val(owner,_)=pp_owner expected block
            in if Portable.pointer_eq(#contract owner,contract)andalso
                Type.type_epoch()=epoch andalso Term.term_epoch()=symbols
              then ()else raise ERR "policy_unit_resolution"
                "actual native owner changed"end
          val _=valid()
          val _=if !used then raise ERR "policy_unit_resolution" "used plan"
            else used:=true
          val {theorem=result,dependencies}=SmtReplayNamedClause.execute
            {guard=valid,check_type=check_type,
             error=ERR "policy_unit_resolution"} plan
          val Block{owner,graph,...}=block
          val dependency=new_dependency block(Union dependencies)
      in observe_proof graph #fixed;observe_proof graph #edges;
        Edge{owner=owner,theorem=result,dependencies=dependency,
          primitive=NONE}end)
    handle primary=>(W.close expected;raise primary))

  fun validate_closed_fact_in_scope_with_policy_for expected {frame,fact} =
    ((case fact of PolicyRealizedClosedFact {work,...} =>
        if Portable.pointer_eq (expected,work) then () else
          raise ERR "closed_fact_scope" "different original Work"
      | _ => ();
      let
        val actual = Scope.description_with_policy_for expected frame
        val (graph,scope) = case fact of
            ClosedFact {graph,scope,...} => (graph,scope)
          | PolicyClosedFact {graph,scope,...} => (graph,scope)
          | PolicyRealizedClosedFact {graph,scope,...} => (graph,scope)
        val _ = if Portable.pointer_eq (#graph actual,graph) andalso
            #scope actual=scope then () else
          raise ERR "closed_fact_scope" "different exact closed fact frame"
        val _ = pcf_for expected fact
        val _ = validate_closed_fact_with_policy graph scope
          (#template_limit (#limits actual)) fact
        val _ = ignore (Scope.description_with_policy_for expected frame)
      in () end)
     handle primary => (W.close expected;raise primary))

  fun scoped_generated_equality_with_policy_for expected
      {frame,equality=saved as ScopedGeneratedEquality
         {graph,scope,maximum,fact,...}} =
    ((let
      (* The private realized fact's passive Work header is checked before
         either its metric/backing or the held equality's scope activates. *)
      val _ = validate_closed_fact_in_scope_with_policy_for expected
        {frame=frame,fact=fact}
      val actual = Scope.description_with_policy_for expected frame
      val _ = if Portable.pointer_eq (#graph actual,graph) andalso
          #scope actual=scope then () else
        raise ERR "scoped_generated_equality" "different exact equality frame"
      val result = scoped_generated_equality_for graph scope maximum saved
      val _ = validate_closed_fact_in_scope_with_policy_for expected
        {frame=frame,fact= #fact result}
    in result end)
     handle primary => (W.close expected;raise primary))

  (* DRAFT private owner layer; no old block/edge constructor is changed.
     The factory/finalizer below must be completed and reviewed before
     these types or functions enter the public signature. *)
  structure PSN=SmtReplayNamedContext
  structure PSNC=SmtReplayNativeContract
  datatype policy_sparse_block=PolicySparseBlock of
    {work:W.portfolio,owner:unit ref,frontier:policy_realization_frontier,
     contract:PSNC.contract,named:G.node PSN.block,
     original_nodes:G.node vector,closed_facts:closed_fact vector,
     conversions:closed_conversion vector,
     actual_formals:Term.term vector,definitions:(int,int)Redblackmap.dict,
     nodes:(G.node * Term.term) list,guard:unit -> unit,
     active:bool ref,realized:bool ref}
  datatype policy_sparse_edge=PolicySparseEdge of
    {owner:unit ref,edge:PSN.edge}
  fun ps_guard expected(saved as PolicySparseBlock{work,...})=
    (
      (if Portable.pointer_eq(expected,work)then ()else
         raise ERR "policy_sparse_owner" "different original Work";
       let val PolicySparseBlock{guard,active,realized,...}=saved
           val _=W.spend_policy expected 5
           val _=guard()
       in if !active andalso not(!realized)then ()else
         raise ERR "policy_sparse_owner" "consumed sparse owner"end))
    handle primary=>(W.close expected;raise primary)
  fun policy_sparse_owner_for expected(saved as PolicySparseBlock{work,...})=
    (
      let val _=ps_guard expected saved
          val PolicySparseBlock{frontier,contract,...}=saved
          val PolicyRealizationFrontier{graph,scope,...}=frontier
          val _=W.spend_policy expected 4
      in {graph=graph,scope=scope,contract=contract}end)
    handle primary=>(W.close expected;raise primary)
  fun ps_native expected block edge=
    let val _=ps_guard expected block
        val PolicySparseBlock{owner,...}=block
        val PolicySparseEdge{owner=held,edge=native}=edge
        val _=W.spend_policy expected 2
    in if Portable.pointer_eq(owner,held)then native else
      raise ERR "policy_sparse_edge" "different sparse edge owner"end
  fun policy_sparse_sources_for expected block=
    ((let val _=ps_guard expected block
          val PolicySparseBlock{frontier,...}=block
          val PolicyRealizationFrontier{sources,...}=frontier
          val _=W.spend_policy expected 1
      in sources end)
     handle primary=>(W.close expected;raise primary))
  fun policy_sparse_name_for expected block node=
    (
      let val _=ps_guard expected block
          val PolicySparseBlock{named,...}=block
      in PSN.name named node end)
    handle primary=>(W.close expected;raise primary)
  fun policy_sparse_theorem_for expected block edge=
    (
      let val actual=ps_native expected block edge
          val PolicySparseBlock{named,...}=block
      in PSN.theorem named actual end)
    handle primary=>(W.close expected;raise primary)
  fun policy_sparse_source_for expected block index=
    (
      let val _=ps_guard expected block
          val PolicySparseBlock{owner,named,original_nodes,...}=block
