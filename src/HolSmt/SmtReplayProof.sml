      in PolicySparseEdge{owner=owner,edge=edge}end)
    handle primary=>(W.close expected;raise primary)
  fun policy_sparse_constructor_for expected block node=
    (
      let val _=ps_guard expected block
          val PolicySparseBlock{owner,named,...}=block
          val _=W.spend_policy expected 3
          val edge=PSN.constructor named node
      in PolicySparseEdge{owner=owner,edge=edge}end)
    handle primary=>(W.close expected;raise primary)
  fun policy_sparse_primitive_for expected block recipe edges=
    (
      let val _=ps_guard expected block
          val PolicySparseBlock{owner,named,...}=block
          val _=W.spend_policy expected 1
          fun inputs []=(W.spend_policy expected 1;[])
            | inputs(edge::rest)=
                (W.spend_policy expected 2;
                 ps_native expected block edge::inputs rest)
          val actual=inputs edges
          (* Private wrapper fields/constructor are paid BEFORE the shared
             native programme, never charged after a kernel rule. *)
          val _=W.spend_policy expected 4
          val edge=PSN.derive named(named_primitive recipe)actual
      in PolicySparseEdge{owner=owner,edge=edge}end)
    handle primary=>(W.close expected;raise primary)
  fun policy_sparse_boolean_for expected block opcode edges=
    (
      let val _=ps_guard expected block
          val PolicySparseBlock{owner,named,...}=block
          val _=W.spend_policy expected 1
          fun inputs []=(W.spend_policy expected 1;[])
            | inputs(edge::rest)=
                (W.spend_policy expected 2;
                 ps_native expected block edge::inputs rest)
          val actual=inputs edges
          val _=W.spend_policy expected 4
          val edge=PSN.derive_boolean named(named_boolean opcode)actual
      in PolicySparseEdge{owner=owner,edge=edge}end)
    handle primary=>(W.close expected;raise primary)
  fun policy_sparse_closed_for expected block fact=
    (
      let val _=ps_guard expected block
          val PolicySparseBlock{owner,named,original_nodes,closed_facts,...}=
            block
          val count=Vector.length closed_facts
          val _=W.spend_policy expected 1
          fun seek index=
            if index=count then raise ERR "policy_sparse_closed"
                "closed witness was not reserved in this owner"
            else
              (W.spend_policy expected 3;
               if Portable.pointer_eq(fact,Vector.sub(closed_facts,index))
                 then index else seek(index+1))
          val selected=seek 0
          val index=Vector.length original_nodes+selected
          val _=W.spend_policy expected 3
          val edge=PSN.source named index
      in PolicySparseEdge{owner=owner,edge=edge}end)
    handle primary=>(W.close expected;raise primary)
  fun policy_sparse_conversion_for expected block conversion=
    (
      let val _=ps_guard expected block
          val PolicySparseBlock
            {owner,named,original_nodes,closed_facts,conversions,...}=block
          val count=Vector.length conversions
          val _=W.spend_policy expected 1
          fun seek index=
            if index=count then raise ERR "policy_sparse_conversion"
                "conversion was not reserved in this owner"
            else
              (W.spend_policy expected 3;
               if Portable.pointer_eq(conversion,Vector.sub(conversions,index))
                 then index else seek(index+1))
          val selected=seek 0
          val index=Vector.length original_nodes+
            Vector.length closed_facts+selected
          val _=W.spend_policy expected 3
          val edge=PSN.source named index
      in PolicySparseEdge{owner=owner,edge=edge}end)
    handle primary=>(W.close expected;raise primary)

  (* DRAFT factory over the agreed shared formal freeze plan. No public
     Source role list or theorem callback enters this private constructor.
     Requires reviewed composition of prepare_freeze_with_formals. *)
  datatype policy_sparse_freeze_plan=PolicySparseFreezePlan of
    {work:W.portfolio,frontier:policy_realization_frontier,
     contract:PSNC.contract,plan:G.node PSN.freeze_plan,
     original_nodes:G.node vector,closed_facts:closed_fact vector,
     conversions:closed_conversion vector,
     definitions:(int,int)Redblackmap.dict,
     nodes:(G.node * Term.term)list,types:pr_native_type list,
     check_type:Type.hol_type -> unit,guard:unit -> unit,
     active:bool ref,realized:bool ref,used:bool ref}
  fun prepare_policy_sparse_freeze expected
      {tables,contract,check_type}=
    (
    let
      val PRRealizationTables{work,...}=tables
      val _=if Portable.pointer_eq(expected,work)then ()else
        raise ERR "policy_sparse_freeze" "different original table Work"
      val native=PSNC.for_work expected contract
      val _=validate_realization_tables_with_policy expected tables
      val PRRealizationTables{frontier,naming,nodes=node_plan,used,...}=tables
      val _=if !used then raise ERR "policy_sparse_freeze"
          "table plan already used"else ()
      val PolicyRealizationFrontier{graph,scope,frame,original,sources,
        closed_facts,conversions,reachable,atoms,...}=frontier
      (* Twenty-six retained local visitors, two epoch reads, and the
         conversion to the actual native Type ceiling. Other allocations
         are quoted at their construction sites below. *)
      val _=W.spend_policy expected 29
      val epoch=Type.type_epoch()val symbols=Term.term_epoch()
      fun backing()=
        (pr_frontier_guard expected frontier;
         PSNC.validate_for expected contract;
         W.spend_policy expected 6;
         if Type.type_epoch()=epoch andalso Term.term_epoch()=symbols
           then ()else raise ERR "policy_sparse_guard"
             "declaration lifetime changed")
      fun pay amount=(backing();W.spend_policy expected amount)
      fun append [] tail=(backing();tail)
        | append(value::rest)tail=(pay 2;value::append rest tail)
      fun map action []=(backing();[])
        | map action(value::rest)=(pay 2;action value::map action rest)
      val data=Scope.description_with_policy_for expected frame
      val genuine=if original then
          append(SmtReplaySource.assumption_nodes(#sources data))
            [SmtReplaySource.denied_goal_node(#sources data)]
        else []
      fun exact [] []=backing()
        | exact(wanted::rest)(held::tail)=
            (pay 2;if wanted=held then exact rest tail else
               raise ERR "policy_sparse_sources"
                 "original Source occurrence changed")
        | exact _ _=raise ERR "policy_sparse_sources"
            "arbitrary additional Source requires a genuine witness port"
      val _=exact genuine sources
      (* This factory can only adopt the actual immutable original S
         prefix. A scoped parent/local witness needs its separate genuine
         receipt intake; arbitrary frontier extras are not adopted here. *)
      val ceiling=IntInf.fromInt(#type_work_limit native)
      val _=pay 1
      val type_error=ERR "policy_sparse_type"
      fun type_work ty=PSN.type_weight_using pay type_error ceiling ty
      fun quote_names []=backing()
        | quote_names((_,text,ty)::rest)=
            let val size=type_work ty
                val _=pay(2+IntInf.fromInt(String.size text)+size)
            in quote_names rest end
      val _=quote_names(G.placeholder_plan_bindings naming)
      val _=pay 2
      val _=used:=true
      val minted=G.mint_placeholder_terms graph scope naming
      val _=pay 1
      val node_table=pr_finish_native_table expected node_plan minted
        (fn pair=>pair)contract backing
      fun named node=
        (backing();pay 3;ignore(G.type_of graph node);
         #2(table_find(node_table,G.node_id node)))
      fun member _ []=(backing();false)
        | member node(held::rest)=
            (pay 2;node=held orelse member node rest)
      fun view node=
        (backing();pay 1;
         if member node atoms then(pay 1;PSN.Atom)else
           (pay 2;case G.view graph node of
               G.Constant _=>
                 (pay 2;PSN.Constant(G.representative graph node))
             | G.Application pair=>(pay 1;PSN.Application pair)
             | _=>(pay 1;PSN.Atom)))
      (* Empty Type list/ref and the two owner state refs. *)
      val _=pay 4
      val types=ref([]:pr_native_type list)
      fun capture_plan ty=(pay 2;types:=ty:: !types)
      fun capture ty=(pay 1;capture_plan(PRActualType ty))
      val active=ref true val realized=ref false
      fun live()=
        (backing();W.spend_policy expected 5;
         if !active andalso not(!realized)then ()else
           raise ERR "policy_sparse_freeze" "consumed sparse owner")
      (* Eight fields, record and three actual callback/partial values. *)
      val _=pay 12
      val operations:G.node PSN.operations=
        {guard=live,spend=W.spend_policy expected,key=G.node_id,
         type_of=fn node=>(live();G.type_of graph node),view=view,
         name=named,check_type=capture,
         native_limits=fn()=>(live();PSNC.for_work expected contract)}
      val closed_nodes=map closed_node closed_facts
      val source_nodes=append sources closed_nodes
      fun conversion_shape conversion=
        (pay 3;PSN.EqualitySyntax
          (PSN.HeldSyntax(named(conversion_source conversion)),
           PSN.HeldSyntax(named(conversion_target conversion))))
      val formals=map conversion_shape conversions
      val _=pay 5
      val plan=PSN.prepare_freeze_with_formals operations
        {nodes=reachable,sources=source_nodes,formals=formals,
         template_limit= #template_limit(#semantic_limits native)}
      val layout=PSN.freeze_layout plan
      (* The layout contains the exact prospective native hypotheses.
         Complete generated Type incidence through the SAME expression
         walker; the external callback itself is execute-only below. *)
      fun owned_name term []=(live();false)
        | owned_name term((_,held)::rest)=
            (pay 2;Portable.pointer_eq(term,held)orelse
              owned_name term rest)
      (* Six fields/record, actual membership closure and ERR partial. *)
      val _=pay 9
      val admitted:PSN.admission=
        {pay=pay,member=fn term=>owned_name term minted,guard=live,
         template_limit= #template_limit(#semantic_limits native),
         type_work_limit= #type_work_limit native,
         error=ERR "policy_sparse_shape"}
      (* The shared cache prices actual lookup/hash/publication work.
         Its ref constructor prices itself; eleven outer inspector setup
         events are separate from the admission record above. *)
      val profiles=PSN.empty_profile_store_using pay
      val _=pay 11
      val inspector=PSN.inspector_with_store admitted profiles
      fun leaf_profile term=
        (capture(Term.type_of term);#profile inspector term)
      fun observe shape=pay(case shape of PSN.HeldSyntax _=>2
        | PSN.ApplicationSyntax _=>7|PSN.EqualitySyntax _=>8)
      fun recorded_type ty=(capture ty;type_work ty)
      fun same_type left right=
        let val a=type_work left val b=type_work right
            val _=pay(1+a+b)
        in Type.compare(left,right)=EQUAL end
      (* The common scalar describer never constructs arrow Types.
         Retain the actual generated equality constant/partial Types as
         expression DATA, then render them only after the complete layout
         has passed every geometry/annotation bound. *)
      fun type_forest shape=
        (pay 2;case shape of
            PSN.HeldSyntax term=>Term.type_of term
          | PSN.ApplicationSyntax(a,b)=>
              let val function_type=type_forest a
                  val _=type_forest b
                  val(_,range)=Type.dom_rng function_type
              in range end
          | PSN.EqualitySyntax(a,b)=>
              let val ty=type_forest a val _=type_forest b
                  val _=pay 4
                  val partial=PRArrowType(PRActualType ty,PRBooleanType)
                  val whole=PRArrowType(PRActualType ty,partial)
                  val _=capture_plan whole val _=capture_plan partial
              in Type.bool end)
      fun admitted_leaf(p:PSN.profile)=
        let val limits= #semantic_limits native
            fun fits bound=
              let val _=pay 2 val limit=IntInf.fromInt bound
              in(pay 2;#raw p<=limit)andalso(pay 2;#inc p<=limit)end
            val _=pay 2
        in if fits(#input_limit limits)andalso
            fits(#output_limit limits)then ()else
          raise ERR "policy_sparse_freeze"
            "actual compact ASSUME input/result exceeds native cap"end
      fun scan []=backing()
        | scan(shape::rest)=
            (pay 1;let val(p,_)=PSN.describe_shape observe leaf_profile
                recorded_type same_type shape
              in admitted_leaf p;ignore(type_forest shape);scan rest end)
      val _=scan(#shapes layout)
      (* Compact closing laws use the existing native Bool implication
         constant. These actual fixed Type ports belong to this upfront
         forest, not a late per-output callback after proof effects. *)
      val _=pay 3
      val implication_type=Term.type_of boolSyntax.implication
      val(_,implication_partial)=Type.dom_rng implication_type
      val _=capture implication_type val _=capture implication_partial
      fun vector values=
        let val _=pay 1
            fun count [] total=(backing();total)
              | count(_::rest)total=(pay 1;count rest(total+1))
            val _=pay(1+IntInf.fromInt(count values 0))
        in Vector.fromList values end
      fun reverse [] result=(backing();result)
        | reverse(value::rest)result=(pay 2;reverse rest(value::result))
      val _=pay 1
      val saved_types=reverse(!types)[]
      fun forest_weight(PRActualType ty)=type_work ty
        | forest_weight PRBooleanType=(pay 1;type_work Type.bool)
        | forest_weight(PRArrowType(a,b))=
            (pay 3;1+forest_weight a+forest_weight b)
      fun forest_total [] amount=(backing();amount)
        | forest_total(ty::rest)amount=
            (pay 2;forest_total rest(amount+forest_weight ty))
      val _=if forest_total saved_types 0<=ceiling then ()else
        raise ERR "policy_sparse_freeze"
          "actual Type callback forest exceeds cap"
      (* Fifteen immutable fields, constructor and private once ref.
         All three vectors use the paid visitor above. *)
      val _=pay 17
      val _=live()
    in PolicySparseFreezePlan{work=expected,frontier=frontier,
      contract=contract,plan=plan,original_nodes=vector sources,
      closed_facts=vector closed_facts,conversions=vector conversions,
      definitions= #definitions layout,nodes=minted,types=saved_types,
      check_type=check_type,guard=backing,active=active,realized=realized,
      used=ref false}end)
    handle primary=>(W.close expected;raise primary)
  fun execute_policy_sparse_freeze expected
      (saved as PolicySparseFreezePlan{work,...})=
    (
      (if Portable.pointer_eq(expected,work)then ()else
         raise ERR "policy_sparse_freeze" "different original Work";
       let val PolicySparseFreezePlan{frontier,contract,plan,original_nodes,
             closed_facts,conversions,definitions,nodes,types,check_type,
             guard,active,realized,used,...}=saved
           val _=guard()
           val _=W.spend_policy expected 2
           val _=if !used then raise ERR "policy_sparse_freeze"
               "used sparse freeze"else used:=true
           (* Three retained render/callback/count visitors. Once-state
              access/write is the preceding two-event debit. *)
           val _=W.spend_policy expected 3
           fun render(PRActualType ty)=ty
             | render PRBooleanType=Type.bool
             | render(PRArrowType(a,b))=
                 let val _=guard() val _=W.spend_policy expected 3
                     val left=render a val right=render b
                     val ty=Type.-->(left,right) val _=guard()
                 in ty end
           fun callbacks []=guard()
             | callbacks(plan::rest)=
                 let val _=guard() val _=W.spend_policy expected 1
                     val ty=render plan val _=check_type ty
                     val _=guard()
                 in callbacks rest end
           val _=callbacks types
           val terms=PSN.materialize_freeze plan
           fun count [] total=(guard();total)
             | count(_::rest)total=
                 (guard();W.spend_policy expected 1;count rest(total+1))
           val _=W.spend_policy expected 1
           val total=count terms 0
           (* Wrapper fields/ref and actual Vector allocation are paid
              before the first native ASSUME, never after execution. *)
           val _=W.spend_policy expected(18+IntInf.fromInt total)
           val actual_formals=Vector.fromList terms
           val owner=ref()
           val named=PSN.execute_freeze plan
       in PolicySparseBlock{work=expected,owner=owner,frontier=frontier,
         contract=contract,named=named,original_nodes=original_nodes,
         closed_facts=closed_facts,conversions=conversions,
         actual_formals=actual_formals,definitions=definitions,
         nodes=nodes,guard=guard,active=active,realized=realized}end))
    handle primary=>(W.close expected;raise primary)

  (* The lower opaque plan is prepared by the SAME N.closed admission and
     executed by its SAME single-INST worker. This private wrapper adds
     expected Work/owner checks and never imports an open theorem edge. *)
  datatype policy_sparse_named_inst_plan=PolicySparseNamedInstPlan of
    {work:W.portfolio,block:policy_sparse_block,
     plan:G.node PSN.closed_inst_plan}
  fun prepare_policy_sparse_named_inst expected block request=
    ((let val _=ps_guard expected block
          val PolicySparseBlock{named,...}=block
          (* Three wrapper fields and constructor, before native work. *)
          val _=W.spend_policy expected 4
          val plan=PSN.prepare_closed_inst named request
      in PolicySparseNamedInstPlan{work=expected,block=block,plan=plan}end)
     handle primary=>(W.close expected;raise primary))
  fun execute_policy_sparse_named_inst expected
      (saved as PolicySparseNamedInstPlan{work,...})=
    ((if Portable.pointer_eq(expected,work)then ()else
        raise ERR "policy_sparse_inst" "different original Work";
      let val PolicySparseNamedInstPlan{block,plan,...}=saved
          val _=ps_guard expected block
          val PolicySparseBlock{owner,...}=block
          val _=W.spend_policy expected 3
          val edge=PSN.execute_closed_inst plan
      in PolicySparseEdge{owner=owner,edge=edge}end)
     handle primary=>(W.close expected;raise primary))

  (* MOVING DRAFT: the private witness inventory and effect schedule below
     are not exposed until its complete invoice and shared client ports
     have been reviewed. No old P realization constructor is modified. *)
  datatype policy_sparse_witness =
      PSOriginalWitness of int * G.node
    | PSClosedWitness of closed_fact
    | PSConversionWitness of closed_conversion
    | PSDefinitionWitness of G.node
  datatype policy_sparse_realization_plan=PolicySparseRealizationPlan of
    {work:W.portfolio,block:policy_sparse_block,target:G.node,
     proof:Thm.thm,contexts:Term.term list,
     witnesses:policy_sparse_witness list,occurrences:int list,
     substitution:(Term.term,Term.term)Lib.subst,used:bool ref,
     batch_weight:IntInf.int,epoch:int,symbols:int}
  datatype policy_sparse_result=PolicySparseResult of
    {work:W.portfolio,frontier:policy_realization_frontier,
     contract:PSNC.contract,target:G.node,theorem:Thm.thm,
     occurrences:int list,guard:unit -> unit,epoch:int,symbols:int}

  fun prepare_policy_sparse_realization expected block {target,edge}=
    (
    let
      val actual=ps_native expected block edge
      val PolicySparseBlock{named,frontier,contract,original_nodes,
        closed_facts,conversions,actual_formals,definitions,nodes,...}=block
      val PolicyRealizationFrontier{graph,scope,...}=frontier
      (* Twenty-six local visitors (the comparator is quoted separately),
         two ceiling conversions, one four-field zero profile, and the
         empty binding-list/ref. Actual traversal work is paid below. *)
      val _=W.spend_policy expected 35
      fun valid()=ps_guard expected block
      fun pay amount=(valid();W.spend_policy expected amount)
      val native=PSNC.for_work expected contract
      val _=pay 8
      val semantic= #semantic_limits native
      val cap=IntInf.fromInt(Int.min(#template_limit semantic,
        Int.min(#input_limit semantic,#output_limit semantic)))
      val ceiling=IntInf.fromInt(#type_work_limit native)
      val proof=PSN.theorem named actual
      val wanted=PSN.name named target
      val _=pay 4
      val _=if Portable.pointer_eq(Thm.concl proof,wanted)andalso
          PSN.clean proof then ()else
        raise ERR "policy_sparse_realize" "not a genuine compact endpoint"
      val contexts=Thm.hyp proof
      val dependencies=PSN.dependencies named actual
      val originals=Vector.length original_nodes
      val closed_count=Vector.length closed_facts
      val conversions_count=Vector.length conversions
      val definition_start=originals+closed_count+conversions_count
      val row_count=Vector.length actual_formals
      fun profile term=(valid();PSN.compact_profile named term)
      fun weight(p:PSN.profile)=
        (pay 5;#raw p+ #inc p+ #ann p)
      fun add(a:PSN.profile)(b:PSN.profile):PSN.profile=
        (pay 14;{raw= #raw a+ #raw b,inc= #inc a+ #inc b,
         ann= #ann a+ #ann b,ty=1})
      val zero:PSN.profile={raw=0,inc=0,ann=0,ty=1}
      fun implication(a:PSN.profile)(b:PSN.profile):PSN.profile=
        (pay 17;{raw=3+ #raw a+ #raw b,inc=3+ #inc a+ #inc b,
         ann=9+ #ann a+ #ann b,ty=1})
      fun admitted(p:PSN.profile)=
        if (pay 2;#raw p<=cap)andalso(pay 2;#inc p<=cap)andalso
            (pay 2;#ann p<=ceiling)
        then ()else raise ERR "policy_sparse_realize"
          "compact closing law exceeds actual native contract"
      fun copy []=(valid();[])
        | copy(value::rest)=(pay 2;value::copy rest)
      fun reverse [] result=(valid();result)
        | reverse(value::rest)result=
            (pay 2;reverse rest(value::result))
      fun row index=
        (pay 3;if index>=0 andalso index<row_count then
           Vector.sub(actual_formals,index)else
           raise ERR "policy_sparse_realize"
             "private dependency index changed")
      fun supported term []=(valid();[])
        | supported term(index::rest)=
            let val held=row index val _=pay 2
            in if Portable.pointer_eq(term,held)then
              index::supported term rest else supported term rest end
      fun definition_node selected []=raise ERR "policy_sparse_realize"
            "missing genuine constructor witness"
        | definition_node selected((node,_)::rest)=
            let val _=pay 3
                val index=Redblackmap.peek(definitions,G.node_id node)
            in case index of SOME index=>
                if index=selected then node else
                  definition_node selected rest
              | NONE=>definition_node selected rest end
      fun witness index=
        if index<originals then
          (pay 3;PSOriginalWitness(index,Vector.sub(original_nodes,index)))
        else if index<originals+closed_count then
          (pay 3;PSClosedWitness(Vector.sub(closed_facts,index-originals)))
        else if index<definition_start then
          (pay 3;PSConversionWitness(Vector.sub(conversions,
            index-originals-closed_count)))
        else (pay 1;PSDefinitionWitness(definition_node index nodes))
      (* Every actual Hyp needs a private row supported by this exact
         checked edge. Slot KIND is authenticated before any original
         grouping. A CLOSED/current/formal same-Hyp row grants no Source.
         The final immutable receipt follows original prefix order, not
         the native Hyp set's lexical order. *)
      val _=pay 3
      fun source_compare(a,b)=(pay 1;Int.compare(a,b))
      val selected_sources=ref(Redblackset.empty source_compare)
      fun selected []=(valid();[])
        | selected(term::rest)=
            let val _=pay 2 val _=ignore(profile term)
                val indices=supported term dependencies
                val first=case indices of index::_=>index
                  | []=>raise ERR "policy_sparse_realize"
                      "native hypothesis has no authentic supported row"
                val chosen=witness first
                val _=case chosen of PSOriginalWitness(_,node)=>
                    (ignore(G.type_of graph node);pay 2;
                     selected_sources:=Redblackset.add
                       (!selected_sources,G.node_id node))
                  | _=>()
            in chosen::selected rest end
      val witnesses=selected contexts
      fun original_groups index=
        if index=originals then(valid();[])else
          let val _=pay 4
              val node=Vector.sub(original_nodes,index)
              val _=ignore(G.type_of graph node)
              val key=G.node_id node
          in if Redblackset.member(!selected_sources,key)then
              (pay 1;index::original_groups(index+1))else
              original_groups(index+1)end
      (* Selecting Original0 expands Original1 too if the SAME genuine
         original G node was duplicated. It never expands a merely equal
         CLOSED, Current or temporary port into original occurrences. *)
      val occurrences=original_groups 0
      val saved_contexts=copy contexts
      (* Only compact syntax is traversed. Expanded graph representatives
         are borrowed AFTER a genuine typed name match, never traversed by
         this matcher and never relabelled as Source permissions. *)
      val bindings=ref([]:(Term.term * G.node)list)
      fun binding variable []=raise ERR "policy_sparse_realize"
            "compact variable is not an authentic owned name"
        | binding variable((node,held)::rest)=
            let val _=pay 3
                val a=Term.dest_var variable val b=Term.dest_var held
                val _=pay(1+IntInf.fromInt(String.size(#1 a))+
                  IntInf.fromInt(String.size(#1 b)))
                val wa=PSN.native_type_weight named(#2 a)
                val wb=PSN.native_type_weight named(#2 b)
                val _=pay(1+wa+wb)
            in if Term.compare(variable,held)=EQUAL then node
              else binding variable rest end
      fun remembered _ []=(valid();false)
        | remembered term((old,_)::rest)=
            (pay 2;Portable.pointer_eq(term,old)orelse remembered term rest)
      fun remembered_node _ []=(valid();false)
        | remembered_node node((_,held)::rest)=
            (pay 2;node=held orelse remembered_node node rest)
      fun collect term=
        let val _=pay 2
        in if Term.is_var term then
          if remembered term(!bindings)then ()else
            let val node=binding term nodes
            in if remembered_node node(!bindings)then ()else
              (pay 3;bindings:=(term,node):: !bindings)end
          else if Term.is_comb term then
            let val _=pay 2 val(a,b)=Term.dest_comb term
            in collect a;collect b end
          else if Term.is_const term then ()else
            raise ERR "policy_sparse_realize" "noncompact realization syntax"
        end
      fun collect_contexts []=valid()
        | collect_contexts(term::rest)=
            (pay 1;collect term;collect_contexts rest)
      val target_profile=profile wanted
      val _=admitted target_profile
      val _=collect wanted
      val _=collect_contexts contexts
      fun replacements []=(valid();[])
        | replacements((variable,node)::rest)=
            let val _=pay 4
                val ty=G.type_of graph node
                val a=PSN.native_type_weight named(Term.type_of variable)
                val b=PSN.native_type_weight named ty
                val _=pay(1+a+b)
                val _=if Type.compare(Term.type_of variable,ty)=EQUAL
                  then ()else raise ERR "policy_sparse_realize"
                    "authentic placeholder Type changed"
                val residue=G.representative graph node
                val _=pay 4
            in {redex=variable,residue=residue}::replacements rest end
      val substitution=replacements(!bindings)
      fun profiles []=(valid();[])
        | profiles(term::rest)=(pay 2;profile term::profiles rest)
      val context_profiles=profiles contexts
      fun sum [] result=(valid();result)
        | sum(value::rest)result=(pay 2;sum rest(add result value))
      val context_total=sum context_profiles zero
      (* Tail-first DISCH is exactly SimultaneousRealization.instantiate.
         Forecast every actual compact input/result/Hyp incidence for the
         entire closing chain before the first closing native operation. *)
      fun closing [] current _ amount annotations=
            (pay 4;(current,amount,annotations))
        | closing(value::rest)current remaining amount annotations=
            let val next=implication value current val _=admitted next
                val _=pay 14
                val rest_hyp:PSN.profile=
                  {raw= #raw remaining- #raw value,
                   inc= #inc remaining- #inc value,
                   ann= #ann remaining- #ann value,ty=1}
                val _=pay 14
                val step=1+weight value+weight current+weight remaining+
                  weight next+weight rest_hyp
                val type_step= #ann value+ #ann current+ #ann remaining+
                  #ann next+ #ann rest_hyp
                val _=pay 2
            in closing rest next rest_hyp(amount+step)
              (annotations+type_step)end
      val (law,closing_amount,closing_annotations)=
        closing(reverse context_profiles [])target_profile context_total 0 0
      val _=admitted law
      fun count [] total=(valid();total)
        | count(_::rest)total=(pay 1;count rest(total+1))
      val _=pay 2
      val source_count=IntInf.fromInt(count contexts 0)
      val replace_count=IntInf.fromInt(count substitution 0)
      fun applications [] [] current _ amount annotations=
            (pay 3;(amount,annotations))
        | applications(value::rest)(witness::tail)current carried
            amount annotations=
            let val _=pay 17
                val next:PSN.profile=
                  {raw= #raw current-3- #raw value,
                   inc= #inc current-3- #inc value,
                   ann= #ann current-9- #ann value,ty=1}
                val _=pay 1
                val extra=case witness of PSOriginalWitness _=>value
                  | _=>zero
                val after=add carried extra
                val _=pay 17
                val step=1+weight current+weight carried+weight value+
                  weight extra+weight next+weight after
                val type_step= #ann current+ #ann carried+ #ann value+
                  #ann extra+ #ann next+ #ann after
                val _=pay 2
            in applications rest tail next after(amount+step)
              (annotations+type_step)end
        | applications _ _ _ _ _ _=raise ERR "policy_sparse_realize"
            "private witness programme changed"
      val (application_amount,application_annotations)=
        applications context_profiles witnesses law zero 0 0
      (* This retains the existing compact substitution/Source-adoption
         convention: immutable expanded residues are borrowed, not walked
         or ALPHA'd. Every actual compact closing/native MP incidence is
         still forecast; no wide Source conjunction is constructed. *)
      val _=pay 16
      val future=closing_amount+1+2*weight law+application_amount+
        8*source_count+source_count*(source_count+2)+replace_count
      val annotations=closing_annotations+2* #ann law+
        application_annotations
      val _=if annotations<=ceiling then ()else
        raise ERR "policy_sparse_realize" "closing native Type work exceeded"
      val _=pay future
      (* Include the retained scalar batch profile and its arithmetic. *)
      val _=pay 19
      val result=PolicySparseRealizationPlan{work=expected,block=block,
        target=target,proof=proof,contexts=saved_contexts,witnesses=witnesses,
        occurrences=occurrences,substitution=substitution,
        batch_weight= #raw law+ #inc law+ #ann law,used=ref false,
        epoch=Type.type_epoch(),symbols=Term.term_epoch()}
      val _=valid()
    in result end)
    handle primary=>(W.close expected;raise primary)
  fun preflight_policy_sparse_realization prepaid consume expected
      (saved as PolicySparseRealizationPlan{work,...})=
    (
      (if Portable.pointer_eq(expected,work)then ()else
         raise ERR "policy_sparse_realize" "different original Work";
       let
         val PolicySparseRealizationPlan{block,target,proof,contexts,
           witnesses,occurrences,substitution,used,epoch,symbols,...}=saved
         val _=ps_guard expected block
         val PolicySparseBlock{frontier,contract,realized,...}=block
         val PolicyRealizationFrontier{graph,...}=frontier
         (* Exact new execution envelope is quoted before the first
            native operation. The batch path leaves consumption private. *)
         val _=if prepaid then ()else
           W.spend_policy expected(if consume then 37 else 36)
         val _=if Type.type_epoch()=epoch andalso
             Term.term_epoch()=symbols then ()else
           raise ERR "policy_sparse_realize" "declaration lifetime changed"
         val _=if !used then raise ERR "policy_sparse_realize"
             "used sparse realization"else used:=true
         fun witness selected=
           (W.spend_policy expected 6;case selected of
               PSOriginalWitness(_,node)=>
                 RealizationSource(G.representative graph node)
             | PSClosedWitness fact=>RealizationProof(closed_proof fact)
             | PSConversionWitness conversion=>
                 RealizationProof(conversion_proof conversion)
             | PSDefinitionWitness node=>
                 RealizationReflexive(G.representative graph node))
         val captured=List.map witness witnesses
         val endpoint=G.representative graph target
         val _=ps_guard expected block
         val valid=realization_stamp_guard epoch symbols
         fun stable()=
           (pr_frontier_guard expected frontier;
            PSNC.validate_for expected contract;
            W.spend_policy expected 6;
            if Type.type_epoch()=epoch andalso Term.term_epoch()=symbols
              then ()else raise ERR "policy_sparse_result"
                "declaration lifetime changed")
         fun run instantiated=
           let
             val _=valid()
             val actual=List.map realization_witness_proof captured
             val result=SmtReplaySimultaneousRealization.apply
               {guard=valid,law=instantiated,witnesses=actual}
             fun permitted term=List.exists
               (fn RealizationSource held=>Portable.pointer_eq(term,held)
                 | _=>false) captured
             val _=if Portable.pointer_eq(Thm.concl result,endpoint)andalso
                 PSN.clean result andalso List.all permitted(Thm.hyp result)
               then ()else raise ERR "policy_sparse_realize"
                 "native endpoint or original Source Hyp changed"
             val _=if consume then realized:=true else ()
           in PolicySparseResult{work=expected,frontier=frontier,
             contract=contract,target=target,theorem=result,
             occurrences=occurrences,guard=stable,epoch=epoch,symbols=symbols}
           end
       in {contexts=contexts,proof=proof,substitution=substitution,
           guard=valid,run=run} end))
    handle primary=>(W.close expected;raise primary)
  fun execute_policy_sparse_realization expected plan=
    ((let val {contexts,proof,substitution,guard,run}=
            preflight_policy_sparse_realization false true expected plan
          val _=W.require_callback_free_return expected
          val instantiated=SmtReplaySimultaneousRealization.instantiate
            {guard=guard,error=ERR "policy_sparse_realize",contexts=contexts,
             proof=proof,substitution=substitution}
      in run instantiated end)
     handle primary=>(W.close expected;raise primary))

  datatype policy_sparse_realization_batch=PolicySparseRealizationBatch of
    {work:W.portfolio,block:policy_sparse_block,
     plans:policy_sparse_realization_plan list,
     substitution:(Term.term,Term.term) Lib.subst,used:bool ref}
  fun prepare_policy_sparse_realization_batch expected block requests=
    ((let
        val _=ps_guard expected block
        (* Visitor closure and four fields/envelope/ref. *)
        val _=W.spend_policy expected 7
        fun prepare []=(ps_guard expected block;[])
          | prepare(request::rest)=
              let val _=W.spend_policy expected 2
                  val plan=prepare_policy_sparse_realization
                    expected block request
              in plan::prepare rest end
        val plans=prepare requests
        val PolicySparseBlock {named,...}=block
        fun profile term=let val p=PSN.compact_profile named term
          in (#raw p,#inc p,#ann p) end
        val weights=List.map
          (fn PolicySparseRealizationPlan {batch_weight,...} =>
            batch_weight) plans
        val substitution=realization_batch_inventory
          (W.spend_policy expected) profile (ERR "policy_sparse_batch")
          weights (List.map
            (fn PolicySparseRealizationPlan {substitution,...} =>
              substitution) plans)
        val _=ps_guard expected block
      in PolicySparseRealizationBatch{work=expected,block=block,
        plans=plans,substitution=substitution,used=ref false}end)
     handle primary=>(W.close expected;raise primary))
  fun execute_policy_sparse_realization_batch expected
      (saved as PolicySparseRealizationBatch{work,...})=
    ((if Portable.pointer_eq(expected,work)then ()else
        raise ERR "policy_sparse_batch" "different original Work";
      let
        val PolicySparseRealizationBatch
          {block,plans,substitution,used,...}=saved
        val _=ps_guard expected block
        val PolicySparseBlock{realized,...}=block
        (* Once state, two visitor closures and actual output list cells
           are quoted before the first closing native operation. *)
        val _=W.spend_policy expected 5
        val _=if !used orelse !realized then
            raise ERR "policy_sparse_batch" "used batch"
          else used:=true
        fun quote []=ps_guard expected block
          | quote(_::rest)=
              (W.spend_policy expected 38;quote rest)
        val _=quote plans
        val programmes=List.map
          (preflight_policy_sparse_realization true false expected) plans
        val components=List.map (fn {contexts,proof,...}=>(contexts,proof))
          programmes
        val valid=realization_stamp_guard
          (Type.type_epoch()) (Term.term_epoch())
        val _=ps_guard expected block
        val _=W.require_callback_free_return expected
        val laws=SmtReplaySimultaneousRealization.instantiate_batch
          {guard=valid,error=ERR "policy_sparse_batch",proofs=components,
           substitution=substitution}
        fun execute [] []=(valid ();[])
          | execute(run::rest)(law::tail)=run law::execute rest tail
          | execute _ _=raise ERR "policy_sparse_batch" "component count"
        val result=execute (List.map #run programmes) laws
        (* Empty batches retire unused backing without realizing a result. *)
        val _=realized:=true
      in result end)
     handle primary=>(W.close expected;raise primary))
  fun policy_sparse_result_for expected
      (saved as PolicySparseResult{work,...})=
    (
      (if Portable.pointer_eq(expected,work)then ()else
         raise ERR "policy_sparse_result" "different original Work";
       let val PolicySparseResult{guard,theorem,target,occurrences,...}=saved
           val _=guard() val _=W.spend_policy expected 4
       in {theorem=theorem,target=target,
         original_occurrences=occurrences}end))
    handle primary=>(W.close expected;raise primary)


  (* Explicit genuine profile intake for the sparse source backend. The
     profile's counts are DATA only; no bound or Source right is derived.
     This wrapper runs in the caller's existing original Work action. *)
  fun prepare_policy_sparse_freeze_with_profiles expected
      {tables,contract,profiles,check_type}=
    ((let val PRRealizationTables{work,...}=tables
      in if Portable.pointer_eq(expected,work)then ()else
        raise ERR "policy_sparse_profiles" "different original table Work"end;
      let
        val _=validate_realization_tables_with_policy expected tables
        val PRRealizationTables{frontier,...}=tables
        val PolicyRealizationFrontier{graph,scope,...}=frontier
        (* Three retained visitors and two entry declaration reads. *)
        val _=W.spend_policy expected 5
        val epoch=Type.type_epoch()val symbols=Term.term_epoch()
        fun valid()=
          (pr_frontier_guard expected frontier;
           PSNC.validate_for expected contract;
           W.spend_policy expected 6;
           if Type.type_epoch()=epoch andalso Term.term_epoch()=symbols
             then ()else raise ERR "policy_sparse_profiles"
               "declaration lifetime changed")
        fun pay amount=(valid();W.spend_policy expected amount)
        fun visit []=valid()
          | visit(profile::rest)=
              let
                (* List/control2; actual public profile header/frame/
                   pointer/lifetime observations11, seven fields/record8.
                   The genuine retained profile guard runs unchanged. *)
                val _=pay 21
                val _=ignore(G.opaque_profile_data_with_policy
                  graph scope profile)
                val _=valid()
              in visit rest end
        val _=visit profiles
        (* Three actual request fields and its record, before any names,
           external Type callbacks or native ASSUMEs can be constructed. *)
        val _=pay 4
      in prepare_policy_sparse_freeze expected
        {tables=tables,contract=contract,check_type=check_type}end)
     handle primary=>(W.close expected;raise primary))

  (* Only an already checked sparse result can mint this parent witness.
     Its actual result guard stays live; no caller syntax or theorem is
     accepted and no parser occurrence identity is invented here. *)
  datatype policy_sparse_parent_source=PolicySparseParentSource of
    policy_sparse_result
  fun record_policy_sparse_parent_source expected
      (saved as PolicySparseResult{work,...})=
    ((if Portable.pointer_eq(expected,work)then ()else
        raise ERR "policy_sparse_parent_source" "different original Work";
      let val PolicySparseResult{guard,...}=saved
          val _=guard()
          (* Original Work header comparison/branch2 and token envelope1. *)
          val _=W.spend_policy expected 3
      in PolicySparseParentSource saved end)
     handle primary=>(W.close expected;raise primary))
  fun policy_sparse_parent_source_for expected
      (PolicySparseParentSource(saved as PolicySparseResult{work,...}))=
    ((if Portable.pointer_eq(expected,work)then ()else
        raise ERR "policy_sparse_parent_source" "different original Work";
      let
        val PolicySparseResult{guard,frontier,contract,target,theorem,
          occurrences,...}=saved
        val _=guard()
        (* Header2, original Source getter1, eight fields and record9.
           The Source getter and retained guard pay their own live work. *)
        val _=W.spend_policy expected 12
        val sources=W.original_sources expected
        val PolicyRealizationFrontier{graph,scope,frame,...}=frontier
      in {graph=graph,scope=scope,frame=frame,sources=sources,
        contract=contract,target=target,theorem=theorem,
        original_occurrences=occurrences}end)
     handle primary=>(W.close expected;raise primary))

end
