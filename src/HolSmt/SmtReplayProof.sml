  val nt_prepare_entry_fee=length
    ["prepare entry","work argument","guard argument","allowance argument",
     "prefix argument","substitutions argument","insertion argument",
     "log argument","prefix pattern","meter allocation",
     "sigma helper setup","first sigma call","second sigma call"]
