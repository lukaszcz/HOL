+// Suppress only lexical whitespace. Strings, quoted symbols and comments
+// retain their contents, including the newline terminating a comment.
+class compact_smt_stream : public std::streambuf {
+    std::ostream& m_out;
+    enum class mode { plain, quoted, string, comment };
+    mode m_mode = mode::plain;
+    bool m_quoted_escape = false;
+    bool m_pending = false;
+    char m_previous = 0;
+    static bool space(char c) {
+        return c == ' ' || c == '\n' || c == '\r' || c == '\t' ||
+               c == '\f' || c == '\v';
+    }
+    static bool paren(char c) { return c == '(' || c == ')'; }
+protected:
+    int_type overflow(int_type value) override {
+        if (traits_type::eq_int_type(value, traits_type::eof()))
+            return traits_type::not_eof(value);
+        char c = traits_type::to_char_type(value);
+        if (m_mode == mode::plain) {
+            if (space(c)) { m_pending = true; return value; }
+            if (m_pending && m_previous && !paren(m_previous) && !paren(c))
+                m_out.put(' ');
+            m_pending = false;
+            if (c == '|') m_mode = mode::quoted;
+            else if (c == '"') m_mode = mode::string;
+            else if (c == ';') m_mode = mode::comment;
+        }
+        else if (m_mode == mode::quoted) {
+            if (m_quoted_escape) m_quoted_escape = false;
+            else if (c == '\\') m_quoted_escape = true;
+            else if (c == '|') m_mode = mode::plain;
+        }
+        else if ((m_mode == mode::string && c == '"') ||
+                 (m_mode == mode::comment && (c == '\n' || c == '\r')))
+            m_mode = mode::plain;
+        m_out.put(c);
+        m_previous = c;
+        return m_out ? value : traits_type::eof();
+    }
+public:
+    explicit compact_smt_stream(std::ostream& out) : m_out(out) {}
+};
 
