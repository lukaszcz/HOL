+// The first native printer pass retains symbol tokens and reference counts,
+// never the legacy certificate text. The second pass uses the same AST and
+// original let/scoping schedule. Printed names are presentation only.
+class ast_smt_pp_compact_names : public std::streambuf {
+    struct entry {
+        char prefix;
+        uint64_t count;
+        std::string name;
+    };
+    std::map<unsigned, entry> m_entries;
+    std::set<std::string> m_reserved;
+    enum class mode { bare, quoted, string, comment };
+    mode m_mode = mode::bare;
+    std::string m_token;
+    bool m_quoted_escape = false;
+    bool m_collecting = true;
+
+    static bool space(char c) {
+        return c == ' ' || c == '\n' || c == '\r' || c == '\t' ||
+               c == '\f' || c == '\v';
+    }
+
+    void finish_token() {
+        if (!m_token.empty()) m_reserved.insert(m_token);
+        m_token.clear();
+    }
+
+    static std::string suffix(uint64_t i) {
+        static char const alphabet[] =
+            "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
+        std::string result;
+        for (;;) {
+            result.push_back(alphabet[i % 52]);
+            if (i < 52) break;
+            i = i / 52 - 1;
+        }
+        std::reverse(result.begin(), result.end());
+        return result;
+    }
+
+protected:
+    int_type overflow(int_type value) override {
+        if (traits_type::eq_int_type(value, traits_type::eof()))
+            return traits_type::not_eof(value);
+        char c = traits_type::to_char_type(value);
+        if (m_mode == mode::comment) {
+            if (c == '\n' || c == '\r') m_mode = mode::bare;
+        }
+        else if (m_mode == mode::string) {
+            // Doubled quotes close and immediately reopen a string; neither
+            // segment can contribute an identifier to the reservation set.
+            if (c == '"') m_mode = mode::bare;
+        }
+        else if (m_mode == mode::quoted) {
+            if (m_quoted_escape) {
+                m_token.push_back(c);
+                m_quoted_escape = false;
+            }
+            else if (c == '\\') m_quoted_escape = true;
+            else if (c == '|') { finish_token(); m_mode = mode::bare; }
+            else m_token.push_back(c);
+        }
+        else if (space(c) || c == '(' || c == ')') finish_token();
+        else if (c == ';') { finish_token(); m_mode = mode::comment; }
+        else if (c == '"') { finish_token(); m_mode = mode::string; }
+        else if (c == '|') { finish_token(); m_mode = mode::quoted; }
+        else m_token.push_back(c);
+        return value;
+    }
+
+public:
+    void print(std::ostream& out, expr* n, char prefix) {
+        if (m_collecting) {
+            auto result = m_entries.emplace(n->get_id(), entry{prefix, 0, {}});
+            if (result.first->second.prefix != prefix)
+                throw std::logic_error("proof printer reused a typed node id");
+            ++result.first->second.count;
+            out << prefix << 'x' << n->get_id();
+        }
+        else out << m_entries.at(n->get_id()).name;
+    }
+
+    void allocate() {
+        finish_token();
+        std::vector<unsigned> ordered;
+        for (auto const& item : m_entries) ordered.push_back(item.first);
+        std::sort(ordered.begin(), ordered.end(), [&](unsigned a, unsigned b) {
+            auto ac = m_entries.at(a).count, bc = m_entries.at(b).count;
+            return ac != bc ? ac > bc : a < b;
+        });
+        std::map<char, uint64_t> next;
+        for (unsigned id : ordered) {
+            entry& e = m_entries.at(id);
+            do {
+                e.name = std::string(1, e.prefix) + suffix(next[e.prefix]++);
+            } while (m_reserved.count(e.name));
+            m_reserved.insert(e.name);
+        }
+        m_collecting = false;
+    }
+};
