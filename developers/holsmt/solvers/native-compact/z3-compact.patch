+static void tst_proof_closure_sort() {
+    ast_manager m(PGM_ENABLED);
+    m.register_plugin(symbol("array"), alloc(array_decl_plugin));
+    sort* b = m.mk_bool_sort();
+    sort_ref fake_proof(m.mk_uninterpreted_sort(symbol("Proof")), m);
+    proof_ref proof(m.mk_asserted(m.mk_true()), m);
+    sort* domains[1] = { b };
+    symbol names[1] = { symbol("x") };
+    expr_ref inner(m.mk_lambda(1, domains, names, proof.get()), m);
+    expr_ref outer(m.mk_lambda(1, domains, names, inner.get()), m);
+    array_util arrays(m);
+    sort_ref semantic(arrays.mk_array_sort(b, b), m);
+    sort_ref fake_closure(arrays.mk_array_sort(b, fake_proof), m);
+
+    ENSURE(is_proof_closure_sort(m, inner->get_sort()));
+    ENSURE(is_proof_closure_sort(m, outer->get_sort()));
+    ENSURE(!is_proof_closure_sort(m, proof->get_sort()));
+    ENSURE(!is_proof_closure_sort(m, semantic.get()));
+    ENSURE(!is_proof_closure_sort(m, fake_closure.get()));
+}
