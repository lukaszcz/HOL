+ *
+ * Black box testing of compact complete-certificate names.
+ */
+
+#include <ios>
+#include <ostream>
+#include <sstream>
+#include <streambuf>
+
+#include "printer/compact_names.h"
+#include "test.h"
+
+namespace cvc5::internal {
+namespace test {
+
+using printer::CompactNames;
+using printer::CompactPrintStream;
+
+class TestPrinterBlackCompactNames : public TestInternal
+{
+};
+
+class FailingBuffer : public std::streambuf
+{
+ protected:
+  int_type overflow(int_type) override { return traits_type::eof(); }
+};
+
+class FailingCompactBuffer : public CompactPrintStream
+{
+ public:
+  explicit FailingCompactBuffer(CompactNames& names)
+      : CompactPrintStream(names)
+  {
+  }
+
+ protected:
+  int_type overflow(int_type) override { return traits_type::eof(); }
+};
+
+TEST_F(TestPrinterBlackCompactNames, lexical_compaction)
+{
+  EXPECT_EQ(CompactPrintStream::compact(" (f  x)\n(g y) "), "(f x)(g y)");
+  EXPECT_EQ(CompactPrintStream::compact("(|a b;()| \"c d\")"),
+            "(|a b;()| \"c d\")");
+  EXPECT_EQ(CompactPrintStream::compact("; keep  comment\n(f x)"),
+            "; keep  comment\n(f x)");
+}
+
+TEST_F(TestPrinterBlackCompactNames, scalar_profit_exact_boundary)
+{
+  const std::string rational = "(/ (- 1) 2)";
+  EXPECT_EQ(CompactPrintStream::compact(rational), "(/(- 1)2)");
+  EXPECT_FALSE(CompactNames::strictlyProfitable(rational, "@aaaa", 6));
+  EXPECT_TRUE(CompactNames::strictlyProfitable(rational, "@aaaa", 7));
+}
+
+TEST_F(TestPrinterBlackCompactNames, allocation_is_transactional)
+{
+  CompactNames names;
+  auto& rejected = names.entries[{'l', 1}];
+  rejected.count = 2;
+  rejected.literal = "12345";
+  names.entries[{'p', 2}].count = 1;
+  names.allocate();
+  EXPECT_TRUE(rejected.name.empty());
+  EXPECT_EQ(names.entries.at(CompactNames::Key{'p', 2}).name, "@a");
+}
+
+TEST_F(TestPrinterBlackCompactNames, reserved_names_are_skipped)
+{
+  CompactNames names;
+  names.reserved.insert("@a");
+  names.entries[{'p', 1}].count = 1;
+  names.allocate();
+  EXPECT_EQ(names.entries.at(CompactNames::Key{'p', 1}).name, "@b");
+}
+
+TEST_F(TestPrinterBlackCompactNames, counting_failure_throws)
+{
+  CompactNames names;
+  FailingCompactBuffer buffer(names);
+  std::ostream output(&buffer);
+  output.exceptions(std::ios::badbit | std::ios::failbit);
+  EXPECT_THROW(output << "proof", std::ios_base::failure);
+  EXPECT_TRUE(names.entries.empty());
+}
