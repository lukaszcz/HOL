+/******************************************************************************
+ * Native, two-pass identifier allocation for complete certificate printing.
+ * This prototype is opt-in and retains the printer's proof and scope schedule.
+ *****************************************************************************/
+#ifndef CVC5__PRINTER__COMPACT_NAMES_H
+#define CVC5__PRINTER__COMPACT_NAMES_H
+
+#include <algorithm>
+#include <functional>
+#include <map>
+#include <ostream>
+#include <set>
+#include <sstream>
+#include <stdexcept>
+#include <streambuf>
+#include <string>
+#include <vector>
+
+#include "expr/node.h"
+#include "printer/compact_reserved.h"
+
+namespace cvc5::internal::printer {
+
+class CompactNames
+{
+ public:
+  using Key = std::pair<char, uint64_t>;
+  struct Entry
+  {
+    uint64_t count = 0;
+    std::string name;
+    std::string literal;
+    Node keep;
+  };
+  std::map<Key, Entry> entries;
+  std::set<std::string> reserved;
+  bool collecting = true;
+
+  explicit CompactNames(bool reserveSignatures = true)
+  {
+    if (reserveSignatures)
+    {
+      reserved.insert(std::begin(compactReservedNames),
+                      std::end(compactReservedNames));
+    }
+  }
+
+  static std::string suffix(uint64_t i)
+  {
+    static const char alphabet[] =
+        "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+    std::string result;
+    for (;;)
+    {
+      result.push_back(alphabet[i % 62]);
+      if (i < 62) break;
+      i = i / 62 - 1;
+    }
+    std::reverse(result.begin(), result.end());
+    return result;
+  }
+
+  static bool strictlyProfitable(const std::string& literal,
+                                 const std::string& name,
+                                 uint64_t count);
+  void allocate();
+};
+
+/** The first pass retains distinct names/literals and counts, never proof text.
+ * The final pass emits only lexical whitespace suppression. Identifier changes
+ * are requested by the typed native printer, never inferred from token spelling.
+ */
+class CompactPrintStream : public std::streambuf
+{
+  CompactNames& d_names;
+  std::ostream* d_out;
+  enum class Mode { plain, quoted, string, comment };
+  Mode d_mode = Mode::plain;
+  std::string d_token;
+  bool d_pending = false;
+  char d_previous = 0;
+
+  static bool space(char c)
+  {
+    return c == ' ' || c == '\n' || c == '\r' || c == '\t'
+           || c == '\f' || c == '\v';
+  }
+  static bool paren(char c) { return c == '(' || c == ')'; }
+  void finishToken()
+  {
+    if (!d_token.empty()) d_names.reserved.insert(d_token);
+    d_token.clear();
+  }
+
+ protected:
+  int_type overflow(int_type value) override
+  {
+    if (traits_type::eq_int_type(value, traits_type::eof()))
+      return traits_type::not_eof(value);
+    char c = traits_type::to_char_type(value);
+    if (d_names.collecting)
+    {
+      if (d_mode == Mode::comment)
+      {
+        if (c == '\n' || c == '\r') d_mode = Mode::plain;
+      }
+      else if (d_mode == Mode::string)
+      {
+        if (c == '"') d_mode = Mode::plain;
+      }
+      else if (d_mode == Mode::quoted)
+      {
+        if (c == '|') { finishToken(); d_mode = Mode::plain; }
+        else d_token.push_back(c);
+      }
+      else if (space(c) || paren(c)) finishToken();
+      else if (c == ';') { finishToken(); d_mode = Mode::comment; }
+      else if (c == '"') { finishToken(); d_mode = Mode::string; }
+      else if (c == '|') { finishToken(); d_mode = Mode::quoted; }
+      else d_token.push_back(c);
+      return value;
+    }
+    if (d_mode == Mode::plain)
+    {
+      if (space(c)) { d_pending = true; return value; }
+      if (d_pending && d_previous && !paren(d_previous) && !paren(c))
+        d_out->put(' ');
+      d_pending = false;
+      if (c == '|') d_mode = Mode::quoted;
+      else if (c == '"') d_mode = Mode::string;
+      else if (c == ';') d_mode = Mode::comment;
+    }
+    else if ((d_mode == Mode::quoted && c == '|')
+             || (d_mode == Mode::string && c == '"')
+             || (d_mode == Mode::comment && (c == '\n' || c == '\r')))
+      d_mode = Mode::plain;
+    d_out->put(c);
+    d_previous = c;
+    return *d_out ? value : traits_type::eof();
+  }
+
+ public:
+  CompactPrintStream(CompactNames& names, std::ostream* out = nullptr)
+      : d_names(names), d_out(out) {}
+  void finish() { finishToken(); }
+
+  /** Return exactly the bytes emitted by this stream's lexical compactor. */
+  static std::string compact(const std::string& text)
+  {
+    CompactNames names(false);
+    names.collecting = false;
+    std::ostringstream destination;
+    CompactPrintStream buffer(names, &destination);
+    std::ostream output(&buffer);
+    output.exceptions(std::ios::badbit | std::ios::failbit);
+    output << text;
+    output.flush();
+    if (!output) throw std::ios_base::failure("compact proof output failed");
+    return destination.str();
+  }
+
+  static CompactPrintStream* get(std::ostream& out)
+  {
+    return dynamic_cast<CompactPrintStream*>(out.rdbuf());
+  }
+  static void reference(std::ostream& out, char category, uint64_t id)
+  {
+    CompactPrintStream* self = get(out);
+    if (!self) { out << '@' << category << id; return; }
+    CompactNames::Key key{category, id};
+    if (self->d_names.collecting)
+    {
+      ++self->d_names.entries[key].count;
+      out << '@' << category << id;
+    }
+    else out << self->d_names.entries.at(key).name;
+  }
+
+  static bool eligible(TNode n)
+  {
+    // These scalar constants are closed and their syntax needs no declaration.
+    switch (n.getKind())
+    {
+      case Kind::CONST_BOOLEAN:
+      case Kind::CONST_INTEGER:
+      case Kind::CONST_RATIONAL:
+      case Kind::CONST_STRING:
+      case Kind::CONST_BITVECTOR:
+      case Kind::CONST_FLOATINGPOINT:
+      case Kind::CONST_ROUNDINGMODE: return true;
+      default: return false;
+    }
+  }
+
+  bool literal(std::ostream& out, TNode n,
+               const std::function<void(std::ostream&)>& render)
+  {
+    if (!eligible(n)) return false;
+    CompactNames::Key key{'l', n.getId()};
+    if (d_names.collecting)
+    {
+      auto& entry = d_names.entries[key];
+      if (entry.count++ == 0)
+      {
+        std::ostringstream native;
+        native.copyfmt(out);
+        render(native);
+        entry.literal = native.str();
+        entry.keep = n;
+      }
+      out << entry.literal;
+      return true;
+    }
+    const auto& entry = d_names.entries.at(key);
+    if (entry.name.empty()) return false;
+    out << entry.name;
+    return true;
+  }
+
+  void definitions(std::ostream& out)
+  {
+    for (const auto& item : d_names.entries)
+      if (item.first.first == 'l' && !item.second.name.empty())
+        out << "(define " << item.second.name << " () "
+            << item.second.literal << ")\n";
+  }
+};
+
+inline void CompactNames::allocate()
+{
+  std::vector<Key> order;
+  for (const auto& item : entries) order.push_back(item.first);
+  std::sort(order.begin(), order.end(), [&](const Key& a, const Key& b) {
+    auto ac = entries.at(a).count, bc = entries.at(b).count;
+    return ac != bc ? ac > bc : a < b;
+  });
+  uint64_t next = 0;
+  for (const Key& key : order)
+  {
+    Entry& e = entries.at(key);
+    if (key.first == 'l' && (e.literal.size() <= 2 || e.count <= 1))
+      continue;
+    while (reserved.count("@" + suffix(next))) ++next;
+    const std::string name = "@" + suffix(next);
+    if (key.first == 'l'
+        && !strictlyProfitable(e.literal, name, e.count))
+      continue;
+    e.name = name;
+    reserved.insert(name);
+    ++next;
+  }
+  collecting = false;
+}
+
+inline bool CompactNames::strictlyProfitable(const std::string& rawLiteral,
+                                             const std::string& name,
+                                             uint64_t count)
+{
+  const std::string literal = CompactPrintStream::compact(rawLiteral);
+  const std::string definition = CompactPrintStream::compact(
+      "(define " + name + " () " + rawLiteral + ")\n");
+  // Compare every compact inline token against every compact reference and
+  // the complete emitted definition. Division avoids multiplication overflow
+  // while retaining the strict-saving boundary.
+  return literal.size() > name.size()
+         && count > definition.size() / (literal.size() - name.size());
+}
+
+}  // namespace cvc5::internal::printer
+#endif
