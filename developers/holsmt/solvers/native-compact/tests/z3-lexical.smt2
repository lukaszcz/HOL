(set-option :produce-proofs true)
(set-logic QF_UF)
(declare-sort pt 0)
(declare-fun refl (pt) pt)
(declare-fun asserted (pt) Bool)
(declare-fun hypothesis () pt)
(declare-fun |quoted symbol;()| () pt)
(assert (= hypothesis |quoted symbol;()|))
(assert (asserted (refl hypothesis)))
(assert (not (asserted (refl |quoted symbol;()|))))
(check-sat)
(get-proof)
